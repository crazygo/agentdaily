kground-color: #f6ffed;\n            border-color: #b7eb8f;\n        }\n\n        .quote {\n            font-style: italic;\n            color: #828282;\n            font-size: 11px;\n            margin: 4px 0;\n            padding-left: 12px;\n            border-left: 2px solid #d4d4d4;\n        }\n\n        .quote-source {\n            font-size: 10px;\n            color: #ff6600;\n        }\n\n        .link {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .link:hover {\n            text-decoration: underline;\n        }\n\n        .link-arrow {\n            color: #828282;\n            font-size: 10px;\n        }\n\n        footer {\n            text-align: center;\n            padding: 15px;\n            color: #828282;\n            font-size: 11px;\n            border-top: 1px solid #d4d4d4;\n            margin-top: 20px;\n        }\n\n        footer a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        footer a:hover {\n            color: #000000;\n        }\n\n        .empty-state {\n            color: #828282;\n            font-style: italic;\n            text-align: center;\n            padding: 20px;\n        }\n\n        .highlight {\n            background-color: #fff7e6;\n            padding: 0 2px;\n        }\n\n        .tag-list {\n            margin-top: 4px;\n        }\n\n        .product-link {\n            color: #000000;\n            font-weight: bold;\n            text-decoration: none;\n        }\n\n        .product-link:hover {\n            color: #ff6600;\n            text-decoration: underline;\n        }\n\n        .update-date {\n            font-size: 11px;\n            color: #ff6600;\n            font-weight: bold;\n        }\n\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            section {\n                page-break-inside: avoid;\n            }\n\n            .three-column-layout {\n                grid-template-columns: 1fr;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agentic Coding Research Report</h1>\n            <div class=\"date\">June 18, 2026</div>\n        </header>\n\n        <main class=\"three-column-layout\">\n            <!-- New Products Section -->\n            <section class=\"new-products\">\n                <h2>New Products</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/products/vexi\" class=\"product-link\">VEXI</a>\n                    </div>\n                    <div class=\"item-description\">\n                        An open-source AI coding agent for developers who prefer the terminal. Features BYOK (Bring Your Own Key) approach, multi-provider support (OpenAI, Anthropic, others), multilingual capabilities, and privacy-friendly workflow.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge\">AI coding CLI</span>\n                        <span class=\"badge\">Product Hunt</span>\n                        <span class=\"badge\">Open Source</span>\n                        <span class=\"badge\">Released: 2026-06-12</span>\n                    </div>\n                    <div class=\"quote\">\"Open-source terminal-first agents are where a lot of real developer workflow will shake out.\"</div>\n                    <div class=\"quote\">\"85 upvotes on Product Hunt with #21 Day Rank\"</div>\n                </div>\n\n            </section>\n\n            <!-- Whitelist Updates Section -->\n            <section class=\"whitelist-updates\">\n                <h2>Product Updates</h2>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-18</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://cursor.com/changelog\" class=\"product-link\">Cursor: Automations, Cloud Environment, and Cloud Subagents</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Cursor released multiple updates: Improvements to Cursor Automations for automating repetitive tasks; Cloud Environment Setup and Cloud Subagents in Agents Window; Bugbot improvements (3x faster, 22% cheaper, finds 10% more bugs). Also introduced SDK with Custom Tools, Stores, and Auto-Review capabilities.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge feature\">Feature</span>\n                        <span class=\"badge\">Automation</span>\n                        <span class=\"badge\">Cloud</span>\n                    </div>\n                    <div class=\"quote\">\"The latency between error detection and correction is collapsing to zero.\"</div>\n                    <div class=\"quote-source\">- LinkedIn</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-18</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://news.ycombinator.com/item?id=48196867\" class=\"product-link\">Gemini CLI: Shutdown on June 18, 2026</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Google announced that Gemini CLI will stop working on June 18, 2026 for all user tiers (free, Pro, and Ultra). The shutdown also affects Gemini Code Assist IDE extensions. Google is positioning Antigravity CLI as the successor.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge announcement\">Announcement</span>\n                        <span class=\"badge negative\">Shutdown</span>\n                        <span class=\"badge\">Google</span>\n                    </div>\n                    <div class=\"quote\">\"Welcome to the Google graveyard, Gemini CLI.\"</div>\n                    <div class=\"quote-source\">- Hacker News</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-12</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://support.claude.com/en/articles/12138966-release-notes\" class=\"product-link\">Claude: Fable 5 and Mythos 5 Suspension</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Anthropic suspended access to Claude Fable 5 and Claude Mythos 5 models worldwide following a US export-control directive citing security concerns and a jailbreak vulnerability. Earlier on June 9, Claude had launched Fable 5 as a Mythos-class model made safe for general use.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge announcement\">Announcement</span>\n                        <span class=\"badge negative\">Export Control</span>\n                        <span class=\"badge\">Security</span>\n                    </div>\n                    <div class=\"quote\">\"A very dangerous signal to the rest of the AI industry\"</div>\n                    <div class=\"quote-source\">- Instagram</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-10</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://docs.devin.ai/release-notes/overview\" class=\"product-link\">Devin: Session Folders, Members Tab Rename, and MCP Integrations</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Devin introduced Session Folders for organizing sessions into named folders via drag-and-drop. Added !ultra and !fast mid-session toggles for Slack integration. Renamed 'Users' tab to 'Members' for clarity. Custom OAuth for Marketplace MCP servers.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge feature\">Feature</span>\n                        <span class=\"badge\">Organization</span>\n                        <span class=\"badge\">MCP</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-01</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/2026-06-01-updates-to-github-copilot-billing-and-plans/\" class=\"product-link\">GitHub Copilot: Usage-Based Billing Transition</a>\n                    </div>\n                    <div class=\"item-description\">\n                        GitHub Copilot moved from request-based billing to usage-based billing on June 1, 2026. New system uses GitHub AI Credits instead of flat-rate pricing. Each Copilot plan has monthly AI Credit allotments. Copilot code review now consumes GitHub Actions minutes in addition to AI Credits.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge announcement\">Announcement</span>\n                        <span class=\"badge negative\">Pricing</span>\n                        <span class=\"badge\">Billing</span>\n                    </div>\n                    <div class=\"quote\">\"Represents significant cost increases described as '10-22x cost increase'\"</div>\n                    <div class=\"quote-source\">- Reddit</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-11</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://developers.openai.com/codex/changelog\" class=\"product-link\">Codex CLI: Record & Replay and SSH Deep Links</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Codex CLI received June 2026 updates including Record & Replay feature, performance improvements, and bug fixes. Added new deep links to manage SSH connections. Includes remote executors using authenticated, end-to-end encrypted Noise relay channels.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge feature\">Feature</span>\n                        <span class=\"badge\">SSH</span>\n                        <span class=\"badge\">Security</span>\n                    </div>\n                </div>\n\n            </section>\n\n            <!-- Technical Insights Section -->\n            <section class=\"technical-insights\">\n                <h2>Technical Insights</h2>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-17</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">GLM-5.2: Most powerful open weights LLM</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Chinese AI lab Z.ai released GLM-5.2, a 753B parameter Mixture of Experts model with 1 million token context window under MIT license.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"badge\">LLMs</span>\n                        <span class=\"badge\">Open Weights</span>\n                    </div>\n                    <div class=\"quote-source\">Simon Willison</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-17</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Economics of code production turned upside down</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Charity Majors reflects on how AI made code generation effectively free and instant, changing from treasured, reusable code to disposable and regenerable lines of code practically overnight.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge opinion\">Opinion</span>\n                        <span class=\"badge\">Economics</span>\n                        <span class=\"badge\">AI</span>\n                    </div>\n                    <div class=\"quote-source\">Charity Majors</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-16</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Coding models fix bugs - Fable 5 controversy</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Katie Moussouris confirms that the 'jailbreak' that got Claude Fable 5 banned was simply asking the model to 'fix this code' with known security vulnerabilities.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge opinion\">Opinion</span>\n                        <span class=\"badge\">Security</span>\n                        <span class=\"badge\">Claude</span>\n                    </div>\n                    <div class=\"quote-source\">Katie Moussouris</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-16</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Datasette 1.0a34 with row editing tools</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Simon Willison releases Datasette 1.0a34 featuring tools to insert, edit, and delete rows within the Datasette interface. The feature was inspired by Datasette Agent.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"badge\">Python</span>\n                        <span class=\"badge\">SQLite</span>\n                    </div>\n                    <div class=\"quote-source\">Simon Willison</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-15</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Datasette Agent 0.3a0 with write SQL</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Release of datasette-agent 0.3a0 featuring execute_write_sql tool that requests user approval before writing to databases.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"badge\">AI Tools</span>\n                        <span class=\"badge\">LLM</span>\n                    </div>\n                    <div class=\"quote-source\">Simon Willison</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-14</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Why AI hasn't replaced software engineers</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Arvind Narayanan and Sayash Kapoor argue that AI job loss fears are overblown even in software engineering. The real bottlenecks are deciding what to build, verifying deliveries, and deep human understanding.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge opinion\">Opinion</span>\n                        <span class=\"badge\">Careers</span>\n                        <span class=\"badge\">AI</span>\n                    </div>\n                    <div class=\"quote-source\">Arvind Narayanan</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-13</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">US government suspends Fable 5 and Mythos 5</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Anthropic announces that the US government issued an export control directive to suspend access to Fable 5 and Mythos 5 over concerns about a 'jailbreak' technique.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"badge negative\">Export Control</span>\n                        <span class=\"badge\">Claude</span>\n                    </div>\n                    <div class=\"quote-source\">Simon Willison / Anthropic</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-13</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Publishing WASM wheels to PyPI</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Simon Willison writes about publishing WebAssembly wheels to Python Package Index for use with Pyodide, enabling Python code to run in browser environments.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge tutorial\">Tutorial</span>\n                        <span class=\"badge\">Python</span>\n                        <span class=\"badge\">WebAssembly</span>\n                    </div>\n                    <div class=\"quote-source\">Simon Willison</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-12</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">OpenAI WebRTC Audio with document context</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Simon Willison builds an updated OpenAI WebRTC tool featuring GPT-Realtime-2 model and document context support, enabling audio conversations about specific documents in the browser.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"badge\">Audio</span>\n                        <span class=\"badge\">WebRTC</span>\n                    </div>\n                    <div class=\"quote-source\">Simon Willison</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-11</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Claude Fable is relentlessly proactive</a>\n                    </div>\n                    <div class=\"item-description\">\n                        After two days of experience with Claude Fable 5, Simon describes it as 'relentlessly proactive' - knowing many tricks and deploying them creatively to reach goals.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge opinion\">Opinion</span>\n                        <span class=\"badge\">Claude</span>\n                        <span class=\"badge positive\">AI Agent</span>\n                    </div>\n                    <div class=\"quote-source\">Simon Willison</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-11</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Anthropic walks back invisible safeguards</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Anthropic apologizes and makes visible the safeguards for frontier LLM development in Fable 5 after widespread outrage from the research community about invisible prompt modifications.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge opinion\">Opinion</span>\n                        <span class=\"badge\">Claude</span>\n                        <span class=\"badge\">AI Ethics</span>\n                    </div>\n                    <div class=\"quote-source\">Simon Willison / Anthropic</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-date\">2026-06-11</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Datasette 1.0a33 with JSON extras</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Release of Datasette 1.0a33 extending the ?_extra= pattern to cover queries and rows, documented and demonstrated with a custom API explorer built by Claude Fable 5 and GPT-5.5.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"badge\">Datasette</span>\n                        <span class=\"badge\">API</span>\n                    </div>\n                    <div class=\"quote-source\">Simon Willison</div>\n                </div>\n\n            </section>\n        </main>\n\n        <footer>\n            <p>\n                <a href=\"#\">About</a> |\n                <a href=\"#\">Archive</a> |\n                <a href=\"#\">Subscribe</a> |\n                <a href=\"#\">GitHub</a>\n            </p>\n            <p style=\"margin-top: 10px;\">\n                Report generated by Agent Code Daily - Powered by Claude Agent SDK\n            </p>\n            <p style=\"margin-top: 5px; color: #828282;\">\n                Last updated: June 18, 2026\n            </p>\n        </footer>\n    </div>\n</body>\n</html>"
}

