7→            text-decoration: underline;\n   188→        }\n   189→\n   190→        .link-arrow {\n   191→            color: #828282;\n   192→            font-size: 10px;\n   193→        }\n   194→\n   195→        footer {\n   196→            text-align: center;\n   197→            padding: 15px;\n   198→            color: #828282;\n   199→            font-size: 11px;\n   200→            border-top: 1px solid #d4d4d4;\n   201→            margin-top: 20px;\n   202→        }\n   203→\n   204→        footer a {\n   205→            color: #828282;\n   206→            text-decoration: none;\n   207→        }\n   208→\n   209→        footer a:hover {\n   210→            color: #000000;\n   211→        }\n   212→\n   213→        .empty-state {\n   214→            color: #828282;\n   215→            font-style: italic;\n   216→            text-align: center;\n   217→            padding: 20px;\n   218→        }\n   219→\n   220→        .highlight {\n   221→            background-color: #fff7e6;\n   222→            padding: 0 2px;\n   223→        }\n   224→\n   225→        .tag-list {\n   226→            margin-top: 4px;\n   227→        }\n   228→\n   229→        .product-link {\n   230→            color: #000000;\n   231→            font-weight: bold;\n   232→            text-decoration: none;\n   233→        }\n   234→\n   235→        .product-link:hover {\n   236→            color: #ff6600;\n   237→            text-decoration: underline;\n   238→        }\n   239→\n   240→        .update-date {\n   241→            font-size: 11px;\n   242→            color: #ff6600;\n   243→            font-weight: bold;\n   244→        }\n   245→\n   246→        @media print {\n   247→            body {\n   248→                background-color: #ffffff;\n   249→            }\n   250→\n   251→            section {\n   252→                page-break-inside: avoid;\n   253→            }\n   254→\n   255→            .three-column-layout {\n   256→                grid-template-columns: 1fr;\n   257→            }\n   258→        }\n   259→    </style>\n   260→</head>\n   261→<body>\n   262→    <div class=\"container\">\n   263→        <header>\n   264→            <h1>Agentic Coding Research Report</h1>\n   265→            <div class=\"date\">June 18, 2026</div>\n   266→        </header>\n   267→\n   268→        <main class=\"three-column-layout\">\n   269→            <!-- New Products Section -->\n   270→            <section class=\"new-products\">\n   271→                <h2>New Products</h2>\n   272→\n   273→                <div class=\"item\">\n   274→                    <div class=\"item-title\">\n   275→                        <a href=\"https://www.producthunt.com/products/vexi\" class=\"product-link\">VEXI</a>\n   276→                    </div>\n   277→                    <div class=\"item-description\">\n   278→                        An open-source AI coding agent for developers who prefer the terminal. Features BYOK (Bring Your Own Key) approach, multi-provider support (OpenAI, Anthropic, others), multilingual capabilities, and privacy-friendly workflow.\n   279→                    </div>\n   280→                    <div class=\"item-meta\">\n   281→                        <span class=\"badge\">AI coding CLI</span>\n   282→                        <span class=\"badge\">Product Hunt</span>\n   283→                        <span class=\"badge\">Open Source</span>\n   284→                        <span class=\"badge\">Released: 2026-06-12</span>\n   285→                    </div>\n   286→                    <div class=\"quote\">\"Open-source terminal-first agents are where a lot of real developer workflow will shake out.\"</div>\n   287→                    <div class=\"quote\">\"85 upvotes on Product Hunt with #21 Day Rank\"</div>\n   288→                </div>\n   289→\n   290→            </section>\n   291→\n   292→            <!-- Whitelist Updates Section -->\n   293→            <section class=\"whitelist-updates\">\n   294→                <h2>Product Updates</h2>\n   295→\n   296→                <div class=\"item\">\n   297→                    <div class=\"update-date\">2026-06-18</div>\n   298→                    <div class=\"item-title\">\n   299→                        <a href=\"https://cursor.com/changelog\" class=\"product-link\">Cursor: Automations, Cloud Environment, and Cloud Subagents</a>\n   300→                    </div>\n   301→                    <div class=\"item-description\">\n   302→                        Cursor released multiple updates: Improvements to Cursor Automations for automating repetitive tasks; Cloud Environment Setup and Cloud Subagents in Agents Window; Bugbot improvements (3x faster, 22% cheaper, finds 10% more bugs). Also introduced SDK with Custom Tools, Stores, and Auto-Review capabilities.\n   303→                    </div>\n   304→                    <div class=\"item-meta\">\n   305→                        <span class=\"badge feature\">Feature</span>\n   306→                        <span class=\"badge\">Automation</span>\n   307→                        <span class=\"badge\">Cloud</span>\n   308→                    </div>\n   309→                    <div class=\"quote\">\"The latency between error detection and correction is collapsing to zero.\"</div>\n   310→                    <div class=\"quote-source\">- LinkedIn</div>\n   311→                </div>\n   312→\n   313→                <div class=\"item\">\n   314→                    <div class=\"update-date\">2026-06-18</div>\n   315→                    <div class=\"item-title\">\n   316→                        <a href=\"https://news.ycombinator.com/item?id=48196867\" class=\"product-link\">Gemini CLI: Shutdown on June 18, 2026</a>\n   317→                    </div>\n   318→                    <div class=\"item-description\">\n   319→                        Google announced that Gemini CLI will stop working on June 18, 2026 for all user tiers (free, Pro, and Ultra). The shutdown also affects Gemini Code Assist IDE extensions. Google is positioning Antigravity CLI as the successor.\n   320→                    </div>\n   321→                    <div class=\"item-meta\">\n   322→                        <span class=\"badge announcement\">Announcement</span>\n   323→                        <span class=\"badge negative\">Shutdown</span>\n   324→                        <span class=\"badge\">Google</span>\n   325→                    </div>\n   326→                    <div class=\"quote\">\"Welcome to the Google graveyard, Gemini CLI.\"</div>\n   327→                    <div class=\"quote-source\">- Hacker News</div>\n   328→                </div>\n   329→\n   330→                <div class=\"item\">\n   331→                    <div class=\"update-date\">2026-06-12</div>\n   332→                    <div class=\"item-title\">\n   333→                        <a href=\"https://support.claude.com/en/articles/12138966-release-notes\" class=\"product-link\">Claude: Fable 5 and Mythos 5 Suspension</a>\n   334→                    </div>\n   335→                    <div class=\"item-description\">\n   336→                        Anthropic suspended access to Claude Fable 5 and Claude Mythos 5 models worldwide following a US export-control directive citing security concerns and a jailbreak vulnerability. Earlier on June 9, Claude had launched Fable 5 as a Mythos-class model made safe for general use.\n   337→                    </div>\n   338→                    <div class=\"item-meta\">\n   339→                        <span class=\"badge announcement\">Announcement</span>\n   340→                        <span class=\"badge negative\">Export Control</span>\n   341→                        <span class=\"badge\">Security</span>\n   342→                    </div>\n   343→                    <div class=\"quote\">\"A very dangerous signal to the rest of the AI industry\"</div>\n   344→                    <div class=\"quote-source\">- Instagram</div>\n   345→                </div>\n   346→\n   347→                <div class=\"item\">\n   348→                    <div class=\"update-date\">2026-06-10</div>\n   349→                    <div class=\"item-title\">\n   350→                        <a href=\"https://docs.devin.ai/release-notes/overview\" class=\"product-link\">Devin: Session Folders, Members Tab Rename, and MCP Integrations</a>\n   351→                    </div>\n   352→                    <div class=\"item-description\">\n   353→                        Devin introduced Session Folders for organizing sessions into named folders via drag-and-drop. Added !ultra and !fast mid-session toggles for Slack integration. Renamed 'Users' tab to 'Members' for clarity. Custom OAuth for Marketplace MCP servers.\n   354→                    </div>\n   355→                    <div class=\"item-meta\">\n   356→                        <span class=\"badge feature\">Feature</span>\n   357→                        <span class=\"badge\">Organization</span>\n   358→                        <span class=\"badge\">MCP</span>\n   359→                    </div>\n   360→                </div>\n   361→\n   362→                <div class=\"item\">\n   363→                    <div class=\"update-date\">2026-06-01</div>\n   364→                    <div class=\"item-title\">\n   365→                        <a href=\"https://github.blog/changelog/2026-06-01-updates-to-github-copilot-billing-and-plans/\" class=\"product-link\">GitHub Copilot: Usage-Based Billing Transition</a>\n   366→                    </div>\n   367→                    <div class=\"item-description\">\n   368→                        GitHub Copilot moved from request-based billing to usage-based billing on June 1, 2026. New system uses GitHub AI Credits instead of flat-rate pricing. Each Copilot plan has monthly AI Credit allotments. Copilot code review now consumes GitHub Actions minutes in addition to AI Credits.\n   369→                    </div>\n   370→                    <div class=\"item-meta\">\n   371→                        <span class=\"badge announcement\">Announcement</span>\n   372→                        <span class=\"badge negative\">Pricing</span>\n   373→                        <span class=\"badge\">Billing</span>\n   374→                    </div>\n   375→                    <div class=\"quote\">\"Represents significant cost increases described as '10-22x cost increase'\"</div>\n   376→                    <div class=\"quote-source\">- Reddit</div>\n   377→                </div>\n   378→\n   379→                <div class=\"item\">\n   380→                    <div class=\"update-date\">2026-06-11</div>\n   381→                    <div class=\"item-title\">\n   382→                        <a href=\"https://developers.openai.com/codex/changelog\" class=\"product-link\">Codex CLI: Record & Replay and SSH Deep Links</a>\n   383→                    </div>\n   384→                    <div class=\"item-description\">\n   385→                        Codex CLI received June 2026 updates including Record & Replay feature, performance improvements, and bug fixes. Added new deep links to manage SSH connections. Includes remote executors using authenticated, end-to-end encrypted Noise relay channels.\n   386→                    </div>\n   387→                    <div class=\"item-meta\">\n   388→                        <span class=\"badge feature\">Feature</span>\n   389→                        <span class=\"badge\">SSH</span>\n   390→                        <span class=\"badge\">Security</span>\n   391→                    </div>\n   392→                </div>\n   393→\n   394→            </section>\n   395→\n   396→            <!-- Technical Insights Section -->\n   397→            <section class=\"technical-insights\">\n   398→                <h2>Technical Insights</h2>\n   399→\n   400→                <div class=\"item\">\n   401→                    <div class=\"update-date\">2026-06-17</div>\n   402→                    <div class=\"item-title\">\n   403→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">GLM-5.2: Most powerful open weights LLM</a>\n   404→                    </div>\n   405→                    <div class=\"item-description\">\n   406→                        Chinese AI lab Z.ai released GLM-5.2, a 753B parameter Mixture of Experts model with 1 million token context window under MIT license.\n   407→                    </div>\n   408→                    <div class=\"item-meta\">\n   409→                        <span class=\"badge technical\">Technical</span>\n   410→                        <span class=\"badge\">LLMs</span>\n   411→                        <span class=\"badge\">Open Weights</span>\n   412→                    </div>\n   413→                    <div class=\"quote-source\">Simon Willison</div>\n   414→                </div>\n   415→\n   416→                <div class=\"item\">\n   417→                    <div class=\"update-date\">2026-06-17</div>\n   418→                    <div class=\"item-title\">\n   419→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Economics of code production turned upside down</a>\n   420→                    </div>\n   421→                    <div class=\"item-description\">\n   422→                        Charity Majors reflects on how AI made code generation effectively free and instant, changing from treasured, reusable code to disposable and regenerable lines of code practically overnight.\n   423→                    </div>\n   424→                    <div class=\"item-meta\">\n   425→                        <span class=\"badge opinion\">Opinion</span>\n   426→                        <span class=\"badge\">Economics</span>\n   427→                        <span class=\"badge\">AI</span>\n   428→                    </div>\n   429→                    <div class=\"quote-source\">Charity Majors</div>\n   430→                </div>\n   431→\n   432→                <div class=\"item\">\n   433→                    <div class=\"update-date\">2026-06-16</div>\n   434→                    <div class=\"item-title\">\n   435→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Coding models fix bugs - Fable 5 controversy</a>\n   436→                    </div>\n   437→                    <div class=\"item-description\">\n   438→                        Katie Moussouris confirms that the 'jailbreak' that got Claude Fable 5 banned was simply asking the model to 'fix this code' with known security vulnerabilities.\n   439→                    </div>\n   440→                    <div class=\"item-meta\">\n   441→                        <span class=\"badge opinion\">Opinion</span>\n   442→                        <span class=\"badge\">Security</span>\n   443→                        <span class=\"badge\">Claude</span>\n   444→                    </div>\n   445→                    <div class=\"quote-source\">Katie Moussouris</div>\n   446→                </div>\n   447→\n   448→                <div class=\"item\">\n   449→                    <div class=\"update-date\">2026-06-16</div>\n   450→                    <div class=\"item-title\">\n   451→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Datasette 1.0a34 with row editing tools</a>\n   452→                    </div>\n   453→                    <div class=\"item-description\">\n   454→                        Simon Willison releases Datasette 1.0a34 featuring tools to insert, edit, and delete rows within the Datasette interface. The feature was inspired by Datasette Agent.\n   455→                    </div>\n   456→                    <div class=\"item-meta\">\n   457→                        <span class=\"badge technical\">Technical</span>\n   458→                        <span class=\"badge\">Python</span>\n   459→                        <span class=\"badge\">SQLite</span>\n   460→                    </div>\n   461→                    <div class=\"quote-source\">Simon Willison</div>\n   462→                </div>\n   463→\n   464→                <div class=\"item\">\n   465→                    <div class=\"update-date\">2026-06-15</div>\n   466→                    <div class=\"item-title\">\n   467→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Datasette Agent 0.3a0 with write SQL</a>\n   468→                    </div>\n   469→                    <div class=\"item-description\">\n   470→                        Release of datasette-agent 0.3a0 featuring execute_write_sql tool that requests user approval before writing to databases.\n   471→                    </div>\n   472→                    <div class=\"item-meta\">\n   473→                        <span class=\"badge technical\">Technical</span>\n   474→                        <span class=\"badge\">AI Tools</span>\n   475→                        <span class=\"badge\">LLM</span>\n   476→                    </div>\n   477→                    <div class=\"quote-source\">Simon Willison</div>\n   478→                </div>\n   479→\n   480→                <div class=\"item\">\n   481→                    <div class=\"update-date\">2026-06-14</div>\n   482→                    <div class=\"item-title\">\n   483→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Why AI hasn't replaced software engineers</a>\n   484→                    </div>\n   485→                    <div class=\"item-description\">\n   486→                        Arvind Narayanan and Sayash Kapoor argue that AI job loss fears are overblown even in software engineering. The real bottlenecks are deciding what to build, verifying deliveries, and deep human understanding.\n   487→                    </div>\n   488→                    <div class=\"item-meta\">\n   489→                        <span class=\"badge opinion\">Opinion</span>\n   490→                        <span class=\"badge\">Careers</span>\n   491→                        <span class=\"badge\">AI</span>\n   492→                    </div>\n   493→                    <div class=\"quote-source\">Arvind Narayanan</div>\n   494→                </div>\n   495→\n   496→                <div class=\"item\">\n   497→                    <div class=\"update-date\">2026-06-13</div>\n   498→                    <div class=\"item-title\">\n   499→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">US government suspends Fable 5 and Mythos 5</a>\n   500→                    </div>\n   501→                    <div class=\"item-description\">\n   502→                        Anthropic announces that the US government issued an export control directive to suspend access to Fable 5 and Mythos 5 over concerns about a 'jailbreak' technique.\n   503→                    </div>\n   504→                    <div class=\"item-meta\">\n   505→                        <span class=\"badge technical\">Technical</span>\n   506→                        <span class=\"badge negative\">Export Control</span>\n   507→                        <span class=\"badge\">Claude</span>\n   508→                    </div>\n   509→                    <div class=\"quote-source\">Simon Willison / Anthropic</div>\n   510→                </div>\n   511→\n   512→                <div class=\"item\">\n   513→                    <div class=\"update-date\">2026-06-13</div>\n   514→                    <div class=\"item-title\">\n   515→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Publishing WASM wheels to PyPI</a>\n   516→                    </div>\n   517→                    <div class=\"item-description\">\n   518→                        Simon Willison writes about publishing WebAssembly wheels to Python Package Index for use with Pyodide, enabling Python code to run in browser environments.\n   519→                    </div>\n   520→                    <div class=\"item-meta\">\n   521→                        <span class=\"badge tutorial\">Tutorial</span>\n   522→                        <span class=\"badge\">Python</span>\n   523→                        <span class=\"badge\">WebAssembly</span>\n   524→                    </div>\n   525→                    <div class=\"quote-source\">Simon Willison</div>\n   526→                </div>\n   527→\n   528→                <div class=\"item\">\n   529→                    <div class=\"update-date\">2026-06-12</div>\n   530→                    <div class=\"item-title\">\n   531→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">OpenAI WebRTC Audio with document context</a>\n   532→                    </div>\n   533→                    <div class=\"item-description\">\n   534→                        Simon Willison builds an updated OpenAI WebRTC tool featuring GPT-Realtime-2 model and document context support, enabling audio conversations about specific documents in the browser.\n   535→                    </div>\n   536→                    <div class=\"item-meta\">\n   537→                        <span class=\"badge technical\">Technical</span>\n   538→                        <span class=\"badge\">Audio</span>\n   539→                        <span class=\"badge\">WebRTC</span>\n   540→                    </div>\n   541→                    <div class=\"quote-source\">Simon Willison</div>\n   542→                </div>\n   543→\n   544→                <div class=\"item\">\n   545→                    <div class=\"update-date\">2026-06-11</div>\n   546→                    <div class=\"item-title\">\n   547→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Claude Fable is relentlessly proactive</a>\n   548→                    </div>\n   549→                    <div class=\"item-description\">\n   550→                        After two days of experience with Claude Fable 5, Simon describes it as 'relentlessly proactive' - knowing many tricks and deploying them creatively to reach goals.\n   551→                    </div>\n   552→                    <div class=\"item-meta\">\n   553→                        <span class=\"badge opinion\">Opinion</span>\n   554→                        <span class=\"badge\">Claude</span>\n   555→                        <span class=\"badge positive\">AI Agent</span>\n   556→                    </div>\n   557→                    <div class=\"quote-source\">Simon Willison</div>\n   558→                </div>\n   559→\n   560→                <div class=\"item\">\n   561→                    <div class=\"update-date\">2026-06-11</div>\n   562→                    <div class=\"item-title\">\n   563→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Anthropic walks back invisible safeguards</a>\n   564→                    </div>\n   565→                    <div class=\"item-description\">\n   566→                        Anthropic apologizes and makes visible the safeguards for frontier LLM development in Fable 5 after widespread outrage from the research community about invisible prompt modifications.\n   567→                    </div>\n   568→                    <div class=\"item-meta\">\n   569→                        <span class=\"badge opinion\">Opinion</span>\n   570→                        <span class=\"badge\">Claude</span>\n   571→                        <span class=\"badge\">AI Ethics</span>\n   572→                    </div>\n   573→                    <div class=\"quote-source\">Simon Willison / Anthropic</div>\n   574→                </div>\n   575→\n   576→                <div class=\"item\">\n   577→                    <div class=\"update-date\">2026-06-11</div>\n   578→                    <div class=\"item-title\">\n   579→                        <a href=\"https://simonwillison.net/\" class=\"product-link\">Datasette 1.0a33 with JSON extras</a>\n   580→                    </div>\n   581→                    <div class=\"item-description\">\n   582→                        Release of Datasette 1.0a33 extending the ?_extra= pattern to cover queries and rows, documented and demonstrated with a custom API explorer built by Claude Fable 5 and GPT-5.5.\n   583→                    </div>\n   584→                    <div class=\"item-meta\">\n   585→                        <span class=\"badge technical\">Technical</span>\n   586→                        <span class=\"badge\">Datasette</span>\n   587→                        <span class=\"badge\">API</span>\n   588→                    </div>\n   589→                    <div class=\"quote-source\">Simon Willison</div>\n   590→                </div>\n   591→\n   592→            </section>\n   593→        </main>\n   594→\n   595→        <footer>\n   596→            <p>\n   597→                <a href=\"#\">About</a> |\n   598→                <a href=\"#\">Archive</a> |\n   599→                <a href=\"#\">Subscribe</a> |\n   600→                <a href=\"#\">GitHub</a>\n   601→            </p>\n   602→            <p style=\"margin-top: 10px;\">\n   603→                Report generated by Agent Code Daily - Powered by Claude Agent SDK\n   604→            </p>\n   605→            <p style=\"margin-top: 5px; color: #828282;\">\n   606→                Last updated: June 18, 2026\n   607→            </p>\n   608→        </footer>\n   609→    </div>\n   610→</body>\n   611→</html>"
      }
    ]
