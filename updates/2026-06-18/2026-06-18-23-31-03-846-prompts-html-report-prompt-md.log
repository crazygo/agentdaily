      "content": "[\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor Automations, Cloud Environment, and Cloud Subagents\",\n    \"description\": \"Cursor released multiple updates in June 2026: Jun 18 - Improvements to Cursor Automations for automating repetitive tasks; Jun 17 - Cloud Environment Setup and Cloud Subagents in Agents Window; Jun 10 - Bugbot improvements (3x faster, 22% cheaper, finds 10% more bugs). Also introduced SDK with Custom Tools, Stores, and Auto-Review capabilities.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-06-18\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The latency between error detection and correction is collapsing to zero. Moving from code review to state verification\",\n        \"source\": \"LinkedIn\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Game-changing features for automated PR reviews\",\n        \"source\": \"YouTube\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Gemini CLI Shutdown on June 18, 2026\",\n    \"description\": \"Google announced that Gemini CLI will stop working on June 18, 2026 for all user tiers (free, Pro, and Ultra). The shutdown also affects Gemini Code Assist IDE extensions. Google is positioning Antigravity CLI as the successor with enhanced multi-agent workflows and faster asynchronous operations.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://news.ycombinator.com/item?id=48196867\",\n    \"date\": \"2026-06-18\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Welcome to the Google graveyard, Gemini CLI. Not that it will be missed much\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Using it was the worst experience\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"It's not an IDE, it's a way to run agents\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"How is Gemini CLI still so far behind?\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Terrible UI/UX experience and quality of responses being unusable\",\n        \"source\": \"Google AI Developers Forum\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"The team reads every piece of feedback and takes input very seriously\",\n        \"source\": \"GitHub\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"June 2026 Update: Record & Replay and SSH Deep Links\",\n    \"description\": \"Codex CLI received June 2026 updates including Record & Replay feature, performance improvements, and bug fixes. Added new deep links to manage SSH connections. Includes remote executors using authenticated, end-to-end encrypted Noise relay channels with hook trust bypass persistence fixes.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-06-11\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Claude Fable 5 and Mythos 5 Suspension\",\n    \"description\": \"On June 12, 2026, Anthropic suspended access to Claude Fable 5 and Claude Mythos 5 models worldwide following a US export-control directive citing security concerns and a jailbreak vulnerability. Earlier on June 9, Claude had launched Fable 5 as a Mythos-class model made safe for general use. Enterprise plans also gained admin permission management with custom roles on June 2.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://support.claude.com/en/articles/12138966-release-notes\",\n    \"date\": \"2026-06-12\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"These models were incremental improvements, not doomsday devices\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"A very dangerous signal to the rest of the AI industry\",\n        \"source\": \"Instagram\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Users expressed being pretty upset about the suspension\",\n        \"source\": \"Twitter/X\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Fable 5 is included on Pro, Max, Team, and Enterprise plans at no extra cost through June 22\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Fable 5 outperforms Mythos in most tasks where guardrails don't interfere\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Session Folders, Members Tab Rename, and MCP Integrations\",\n    \"description\": \"Devin introduced Session Folders for organizing sessions into named folders via drag-and-drop. Added !ultra and !fast mid-session toggles for Slack integration. Renamed 'Users' tab to 'Members' for clarity. Custom OAuth for Marketplace MCP servers, improved Markdown file preview in Worklog, and Devin Review pending PR cancellations on new commits.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-06-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Usage-Based Billing Transition on June 1, 2026\",\n    \"description\": \"GitHub Copilot moved from request-based billing to usage-based billing on June 1, 2026. New system uses GitHub AI Credits instead of flat-rate pricing. Each Copilot plan has monthly AI Credit allotments. Copilot code review now consumes GitHub Actions minutes in addition to AI Credits. User-level budget controls and Copilot Max upgrade now available.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/2026-06-01-updates-to-github-copilot-billing-and-plans/\",\n    \"date\": \"2026-06-01\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Represents significant cost increases described as '10-22x cost increase' by some users\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  }\n]\n",
