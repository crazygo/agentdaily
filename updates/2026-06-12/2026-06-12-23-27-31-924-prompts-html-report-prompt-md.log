olor: #ffffff;\n   124→            border: 1px solid #d4d4d4;\n   125→            border-radius: 2px;\n   126→            overflow: hidden;\n   127→        }\n   128→\n   129→        .section-header {\n   130→            background-color: #ff6600;\n   131→            padding: 10px 12px;\n   132→            border-bottom: 1px solid #d4d4d4;\n   133→        }\n   134→\n   135→        .section-header h2 {\n   136→            font-family: Arial, Helvetica, sans-serif;\n   137→            font-size: 14px;\n   138→            font-weight: bold;\n   139→            color: #000000;\n   140→        }\n   141→\n   142→        .section-header .count {\n   143→            float: right;\n   144→            font-size: 12px;\n   145→            opacity: 0.7;\n   146→        }\n   147→\n   148→        .section-content {\n   149→            padding: 12px;\n   150→        }\n   151→\n   152→        /* Item Styles */\n   153→        .item {\n   154→            padding: 10px 0;\n   155→            border-bottom: 1px solid #eeeeee;\n   156→        }\n   157→\n   158→        .item:last-child {\n   159→            border-bottom: none;\n   160→        }\n   161→\n   162→        .item-title {\n   163→            font-size: 14px;\n   164→            font-weight: 600;\n   165→            margin-bottom: 4px;\n   166→        }\n   167→\n   168→        .item-title a {\n   169→            color: #000000;\n   170→            text-decoration: none;\n   171→        }\n   172→\n   173→        .item-title a:hover {\n   174→            text-decoration: underline;\n   175→        }\n   176→\n   177→        .item-title a:visited {\n   178→            color: #828282;\n   179→        }\n   180→\n   181→        .item-description {\n   182→            font-size: 13px;\n   183→            color: #000000;\n   184→            line-height: 1.4;\n   185→            margin-bottom: 6px;\n   186→        }\n   187→\n   188→        .item-meta {\n   189→            font-size: 11px;\n   190→            color: #828282;\n