    "originalFile": "[\n  {\n    \"name\": \"AgentMemory\",\n    \"url\": \"https://www.producthunt.com/products/agent-memory-dev\",\n    \"description\": \"Persistent memory layer for AI coding agents (Claude Code, Codex, Cursor, Windsurf, etc.) that captures, compresses, and indexes agent sessions to provide cross-session context. Reduces token usage by 92% while maintaining searchable memory across coding sessions.\",\n    \"release_date\": \"2026-05-16\",\n    \"category\": \"code agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"The cross-session forgetting problem is real - every AI coding session starts from zero\",\n      \"Up to 95% fewer tokens per session, 200x more tool calls before hitting context limits\",\n      \"Gets 95.2% R@5 and 98.6% R@10 on LongMemEval-S retrieval suite\",\n      \"100% open source, free to run locally, no external database required\",\n      \"Persistent memory across sessions is one of those things that sounds like a dev tool problem but actually changes how useful AI agents are in practice\"\n    ]\n  },\n  {\n    \"name\": \"Raindrop Workshop\",\n    \"url\": \"https://raindrop.ai/workshop\",\n    \"description\": \"Open-source, local debugger for AI agents that streams every token and tool call for debugging. First dedicated local debugging tool specifically designed for AI agents with MCP-native integration and one-command installation.\",\n    \"release_date\": \"2026-05-14\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Hit 200 GitHub stars on the first day of launch\",\n      \"First dedicated local debugging tool specifically designed for AI agents\",\n      \"MCP-native with one-command installation\",\n      \"Debug AI agents locally without relying on cloud-based dashboards\"\n    ]\n  },\n  {\n    \"name\": \"Cline SDK\",\n    \"url\": \"https://www.producthunt.com/products/cline-sdk\",\n    \"description\": \"Plugin-based open-source runtime for building coding agents. Allows developers to create custom AI coding agents with a modular, extensible architecture.\",\n    \"release_date\": \"2026-05-15\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Build coding agents with a plugin-based open-source runtime\",\n      \"Open-source runtime for building custom coding agents\"\n    ]\n  },\n  {\n    \"name\": \"OpenHuman\",\n    \"url\": \"https://github.com/tinyhumansai/openhuman\",\n    \"description\": \"Open-source AI agent/harness with persistent memory across sessions. Local-first, privacy-first with 118+ integrations (Gmail, Slack, Notion, GitHub). Features a Memory Tree system that canonicalizes context and includes a built-in code sandbox. Reached #1 Product Hunt and #1 GitHub trending with 12,086+ stars.\",\n    \"release_date\": \"2026-05-15\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\", \"GitHub Trending\"],\n    \"community_quotes\": [\n      \"8000+ GitHub stars, 5000+ users in first 7 days\",\n      \"Reached #1 on Product Hunt daily leaderboard May 15, 2026\",\n      \"Two-minute setup, no config files, simple GUI anyone can use\",\n      \"118+ integrations including GitHub with built-in code sandbox\",\n      \"12,086 stars, 1,694 stars today on GitHub\"\n    ]\n  },\n  {\n    \"name\": \"OpenClaw OS\",\n    \"url\": \"https://www.producthunt.com/products/openclaw-os\",\n    \"description\": \"Turns one-off AI chat sessions into persistent, reusable applications. Open-source tool that converts ephemeral AI agent interactions into usable apps for developers.\",\n    \"release_date\": \"2026-05-14\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Turns one-off chats into persistent apps\",\n      \"Open source tool for converting ephemeral AI sessions into reusable applications\"\n    ]\n  },\n  {\n    \"name\": \"agent-skills\",\n    \"url\": \"https://github.com/tech-leads-club/agent-skills\",\n    \"description\": \"Secure, validated skill registry for professional AI coding agents. Extends Antigravity, Claude Code, Cursor, Copilot and more with validated, secure skills. Currently trending on GitHub with 3,245+ stars.\",\n    \"release_date\": \"2026-05-10\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub Trending\"],\n    \"community_quotes\": [\n      \"The secure, validated skill registry for professional AI coding agents\",\n      \"3,245 stars on GitHub\",\n      \"Extend Antigravity, Claude Code, Cursor, Copilot and more with absolute confidence\"\n    ]\n  },\n  {\n    \"name\": \"codegraph\",\n    \"url\": \"https://github.com/colbymchenry/codegraph\",\n    \"description\": \"Pre-indexed code knowledge graph for Claude Code that reduces token usage and tool calls. Provides 100% local code understanding with pre-indexed knowledge. Currently #17 on GitHub trending with 3,053+ stars and 860 stars today.\",\n    \"release_date\": \"2026-05-12\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub Trending\"],\n    \"community_quotes\": [\n      \"Pre-indexed code knowledge graph for Claude Code — fewer tokens, fewer tool calls, 100% local\",\n      \"3,053 stars on GitHub, 860 stars today\",\n      \"Helps Claude Code understand codebases more efficiently\"\n    ]\n  }\n]\n"
