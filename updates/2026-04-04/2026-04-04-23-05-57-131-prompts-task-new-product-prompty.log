    "content": "[\n  {\n    \"name\": \"Codineer\",\n    \"url\": \"https://github.com/andeya/codineer\",\n    \"description\": \"Your local AI coding agent — one binary, zero cloud lock-in. Built in safe Rust, ships as a single binary with no daemon and no cloud dependency. Reads workspace, understands project context, and helps write, refactor, debug, and ship code from the command line.\",\n    \"release_date\": \"2026-04-03\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Memocore\",\n    \"url\": \"https://github.com/Fengsh0923/Memocore\",\n    \"description\": \"Agent Universal Memory Layer with persistent, self-healing memory. Built on Graphiti + Neo4j with Claude Code hook integration. Features three loops — Write (conversation → LLM extraction → structured entities → Neo4j), Recall (query → vector search → LLM rerank → inject), Dream (periodic dedup, conflict resolution, stale pruning).\",\n    \"release_date\": \"2026-04-03\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Kin Code\",\n    \"url\": \"https://github.com/LocalKinAI/kin-code\",\n    \"description\": \"Lightweight AI coding assistant for your terminal written in Go. Single 10MB binary with zero dependencies. Features MCP support, Soul files for custom AI personas, 10 built-in tools, and Claude login (no API key needed with Free/Pro/Max accounts).\",\n    \"release_date\": \"2026-04-02\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Custom Agents\",\n    \"url\": \"https://github.com/iabhisekbosepm/custom_agent\",\n    \"description\": \"Terminal-based AI coding assistant running entirely on your machine with 5 specialized agents (explorer, coder, reviewer, documenter, architect), 35+ built-in tools, and support for any OpenAI-compatible API. Like Claude Code but you own it.\",\n    \"release_date\": \"2026-04-02\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Daniel\",\n    \"url\": \"https://github.com/mitja-kurath/daniel\",\n    \"description\": \"The proactive AI software engineer that lives in your terminal. Navigates directories, executes commands, fixes bugs across multiple files, and manages development lifecycle autonomously.\",\n    \"release_date\": \"2026-04-02\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"MultiCode\",\n    \"url\": \"https://github.com/cry-nix/MultiCode\",\n    \"description\": \"Terminal AI coding buddy that reads files, edits code, and runs commands. Free and open-source alternative to Claude Code working with any model via OpenRouter. Sees every file read, edit, and command before execution with autonomous step-by-step processing.\",\n    \"release_date\": \"2026-04-02\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"memforge\",\n    \"url\": \"https://github.com/prithvi-45/memforge\",\n    \"description\": \"Persistent memory MCP server for AI coding agents. Install once, your agents never forget. Works with Claude Code, Cursor, Copilot, Windsurf, Aider. Features automatic context loading, decision tracking with reasoning, failure memory, auto-generated rules from patterns, semantic search, web dashboard, and team mode.\",\n    \"release_date\": \"2026-04-02\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"OxShell\",\n    \"url\": \"https://github.com/MauricioPerera/oxshell\",\n    \"description\": \"AI coding assistant for the terminal powered by Cloudflare Workers AI and minimemory, built in Rust. Can read files, write code, run commands, search codebases, execute declarative workflows, and orchestrate multiple agents through natural language.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Free Claude Code\",\n    \"url\": \"https://github.com/albertgd/free-claude-code\",\n    \"description\": \"AI coding assistant for the terminal that works exactly like Claude Code but connects to Groq (free tier), OpenAI, or Google Gemini instead of Anthropic's API. Supports 14+ free models on Groq with generous rate limits.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Kempa AI Devbox\",\n    \"url\": \"https://github.com/kepinski85/kempa-ai-devbox\",\n    \"description\": \"A self-hosted AI learning and building environment designed for Raspberry Pi, featuring multi-agent workflow for teaching programming and collaborating on projects. Educational IDE environment for learning and building with AI assistance.\",\n    \"release_date\": \"2026-03-31\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Danucode\",\n    \"url\": \"https://github.com/zabarich/danucode\",\n    \"description\": \"The simplest agent shell for your own models. Backend-agnostic terminal coding agent supporting Ollama, llama.cpp, vLLM, or any OpenAI-compatible endpoint with minimal configuration and maximum flexibility.\",\n    \"release_date\": \"2026-03-29\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Trust\",\n    \"url\": \"https://github.com/luminexo/trust\",\n    \"description\": \"A shared terminal environment for pair programming with AI agents. Built with Rust, it provides a terminal-based IDE environment for collaborative AI-assisted programming.\",\n    \"release_date\": \"2026-03-28\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"CodeForge\",\n    \"url\": \"https://github.com/Swofty-Developments/CodeForge\",\n    \"description\": \"An AI code editor that wraps Claude Code and Codex into a native desktop application with multi-thread sessions, an embedded browser, and a sleek dark UI. Supports running multiple Claude Code/Codex conversations in parallel tabs.\",\n    \"release_date\": \"2026-03-27\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Anvil\",\n    \"url\": \"https://github.com/zdenham/anvil\",\n    \"description\": \"A desktop IDE designed specifically for parallel agent work. It enables isolated worktrees for parallel development without merge conflicts, provides first-class spec support with phase tracking and plan execution, and includes a full IDE environment.\",\n    \"release_date\": \"2026-03-25\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Orager\",\n    \"url\": \"https://github.com/JayCodesX/orager\",\n    \"description\": \"Production-grade AI agent runtime and CLI built as the runtime behind Paperclip agents. Features multi-turn tool-calling, persistent memory (3-layer SQLite), multimodal input, multi-agent orchestration, and multi-model routing.\",\n    \"release_date\": \"2026-03-24\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Yode\",\n    \"url\": \"https://github.com/anYuJia/yode\",\n    \"description\": \"Open-source AI coding agent for your terminal built in Rust. Reads, edits, searches, and runs commands from a single conversation with multi-provider support, streaming responses, and automatic context summarization.\",\n    \"release_date\": \"2026-03-23\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"continuum\",\n    \"url\": \"https://github.com/zackbrooks84/continuum\",\n    \"description\": \"Async task queue + persistent memory for AI agents that remembers everything, runs tasks while you sleep, and picks up exactly where you left off. Works with Claude Code Remote Control and Claude.ai web with 35+ MCP tools featuring background daemon with structured checkpoints.\",\n    \"release_date\": \"2026-03-23\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"KCode\",\n    \"url\": \"https://github.com/AstrolexisAI/KCode\",\n    \"description\": \"AI-powered coding assistant for the terminal that runs 100% local on your GPU. Features hardware-aware setup wizard, multi-GPU inference via llama.cpp RPC, 46 built-in tools, 152+ slash commands, and local RAG engine.\",\n    \"release_date\": \"2026-03-22\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Forge\",\n    \"url\": \"https://github.com/tn3wman/forge\",\n    \"description\": \"An agentic development environment that integrates Git client, GitHub dashboard, and AI agent workspace in one native desktop app. Runs multiple coding agents simultaneously with full PTY sessions and tool call approval workflows.\",\n    \"release_date\": \"2026-03-21\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Clean Sweep Cortex\",\n    \"url\": \"https://github.com/nitkr/clean-sweep-cortex\",\n    \"description\": \"A terminal-based AI coding agent specifically designed to help with cleaning WordPress malwares. Combines code analysis with security-focused workflows for identifying and removing malicious code.\",\n    \"release_date\": \"2026-03-29\",\n    \"category\": \"workflow-specific tool\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"RewindAI\",\n    \"url\": \"https://github.com/nickleodoen/RewindAI\",\n    \"description\": \"VS Code extension that gives AI coding agents version-controlled memory. Chat, commit, checkout — the agent remembers. Powered by Neo4j knowledge graph and RocketRide AI pipelines with git-integrated context storage where commits carry AI conversation context.\",\n    \"release_date\": \"2026-03-30\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"openclaw-workspace-version-control\",\n    \"url\": \"https://github.com/ExuberantWitness/openclaw-workspace-version-control\",\n    \"description\": \"OpenClaw workspace version control - Safe memory management and rollback for AI agents with version-controlled memory system.\",\n    \"release_date\": \"2026-03-29\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Zenith Terminal Buddy\",\n    \"url\": \"https://github.com/AmanTShekar/zenith-terminal-buddy\",\n    \"description\": \"An interactive AI-powered pet mascot for VS Code that monitors terminal output to automatically catch and explain errors before you even have to ask. Makes AI assistance fun with a Tamagotchi-like companion supporting Claude, Gemini, and Groq APIs.\",\n    \"release_date\": \"2026-03-30\",\n    \"category\": \"IDE-integrated tool\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Codebase Autocomplete Plugin\",\n    \"url\": \"https://github.com/Rabba-Meghana/codebase-autocomplete-plugin\",\n    \"description\": \"Codebase-aware AI autocomplete plugin for JetBrains IDEs using RAG (Retrieval-Augmented Generation), Groq, and ChromaDB. Provides intelligent code suggestions based on your entire codebase context.\",\n    \"release_date\": \"2026-03-30\",\n    \"category\": \"IDE-integrated tool\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Waifu Code\",\n    \"url\": \"https://github.com/Peter08091996/waifu-code\",\n    \"description\": \"Open-source anime-style AI terminal coding assistant. Brings a unique aesthetic to terminal-based AI coding assistance.\",\n    \"release_date\": \"2026-04-02\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Claude Code Nix\",\n    \"url\": \"https://github.com/tienedev/claude-code-nix\",\n    \"description\": \"Nix flake for Claude Code providing AI coding assistant in your terminal with auto-updated daily builds and reproducible Nix-based installation.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Camel Code\",\n    \"url\": \"https://github.com/pookieclaw/camel-code\",\n    \"description\": \"Terminal AI coding assistant written in OCaml combining functional programming robustness with modern AI capabilities for a unique 'two humps, zero runtime' approach.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Mini Codex\",\n    \"url\": \"https://github.com/0x94t3z/mini-codex\",\n    \"description\": \"Terminal coding assistant with workspace-scoped file tools and multi-provider support (Gemini, OpenAI, OpenRouter, xAI). Lightweight alternative for AI-assisted coding.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  }\n]\n",
