      "content": "[\n  {\n    \"name\": \"Codineer\",\n    \"url\": \"https://github.com/andeya/codineer\",\n    \"description\": \"Your local AI coding agent — one binary, zero cloud lock-in. Built in safe Rust, ships as a single binary with no daemon and no cloud dependency. Reads workspace, understands project context, and helps write, refactor, debug, and ship code from the command line.\",\n    \"release_date\": \"2026-04-03\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Memocore\",\n    \"url\": \"https://github.com/Fengsh0923/Memocore\",\n    \"description\": \"Agent Universal Memory Layer with persistent, self-healing memory. Built on Graphiti + Neo4j with Claude Code hook integration. Features three loops — Write (conversation → LLM extraction → structured entities → Neo4j), Recall (query → vector search → LLM rerank → inject), Dream (periodic dedup, conflict resolution, stale pruning).\",\n    \"release_date\": \"2026-04-03\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"MemOS\",\n    \"url\": \"https://github.com/Frankshen923/MemOS\",\n    \"description\": \"Agent Universal Memory Layer with persistent, self-healing memory built on Graphiti + Neo4j and Claude Code hooks. Identical architecture to Memocore with automatic extraction, recall, and Dream consolidation.\",\n    \"release_date\": \"2026-04-03\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Secure-Local-First-AI-Agent-Runtime-with-Memory-Policy-Enforcement\",\n    \"url\": \"https://github.com/FoulSpark/Secure-Local-First-AI-Agent-Runtime-with-Memory-Policy-Enforcement\",\n    \"description\": \"Production-oriented, local-first AI agent runtime with sandboxed code execution, capability-based security, and policy-driven risk gating. Maintains full auditabili