        "content": "     1→[\n     2→  {\n     3→    \"productName\": \"Claude Code\",\n     4→    \"title\": \"Memory in Claude Cowork and Editable Topics\",\n     5→    \"description\": \"Memory in Claude Cowork now works across chat and Cowork in the cloud. Individual entries can be listed under Topics in Settings with editable/deletable entries. Sensitive topics setting introduced to control what stays in memory.\",\n     6→    \"updateType\": \"feature\",\n     7→    \"url\": \"https://support.claude.com/en/articles/12138966-release-notes\",\n     8→    \"date\": \"2026-08-25\",\n     9→    \"community_feedback\": [\n    10→      {\n    11→        \"quote\": \"Users discussing memory issues and migration solutions with Claude-Mem as a solution for persistent memory\",\n    12→        \"source\": \"Facebook Community\",\n    13→        \"sentiment\": \"neutral\"\n    14→      },\n    15→      {\n    16→        \"quote\": \"Comprehensive memory management uses background agent to review coding session transcripts and identify patterns\",\n    17→        \"source\": \"Hacker News\",\n    18→        \"sentiment\": \"positive\"\n    19→      }\n    20→    ]\n    21→  },\n    22→  {\n    23→    \"productName\": \"Codex CLI\",\n    24→    \"title\": \"Browser Extensions and Cloud Sign-in\",\n    25→    \"description\": \"Expanded browser extension support to Microsoft Edge, Brave, Opera, and Vivaldi. Introduced Site tools (WebMCP) allowing ChatGPT Work and Codex to use tools provided by websites in desktop app's built-in browser. Cloud browser sign-in for eligible plans.\",\n    26→    \"updateType\": \"feature\",\n    27→    \"url\": \"https://learn.chatgpt.com/docs/changelog\",\n    28→    \"date\": \"2026-08-25\",\n    29→    \"community_feedback\": []\n    30→  },\n    31→  {\n    32→    \"productName\": \"Codex CLI\",\n    33→    \"title\": \"Scheduled Tasks from Events\",\n    34→    \"description\": \"ChatGPT scheduled tasks can now run when events occur in Gma