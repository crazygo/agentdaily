      "content": "[\n  {\n    \"title\": \"AI Financial Advice Research\",\n    \"description\": \"MIT Sloan research finds AI provides quality financial guidance when users ask specific, well-structured questions. Discussion on accuracy, limitations, and practical applications.\",\n    \"author\": \"MIT Sloan (discussed on Hacker News)\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://mitsloan.mit.edu/ideas-made-to-matter/ai-financial-advice-surprisingly-good-especially-if-you-ask-right-questions\",\n    \"published_date\": \"2026-08-02\",\n    \"topics\": [\n      \"AI applications\",\n      \"finance\",\n      \"research\",\n      \"practical AI\"\n    ],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Seedance 2.5: Bytedance AI Video Creation Tool\",\n    \"description\": \"Bytedance releases updated AI video creation tool with flexible referencing capabilities. Community discussion on technology and implications for content creation.\",\n    \"author\": \"Bytedance (discussed on Hacker News)\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://seed.bytedance.com/en/blog/one-take-creation-flexible-referencing-introducing-seedance-2-5\",\n    \"published_date\": \"2026-08-02\",\n    \"topics\": [\n      \"AI video\",\n      \"content creation\",\n      \"Bytedance\",\n      \"multimodal AI\"\n    ],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Explorative Modeling: Train on the Best of K Guesses\",\n    \"description\": \"Novel ML training approach exploring multiple guess selection strategies. Community discussion on methodology and performance implications.\",\n    \"author\": \"Hacker News community\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://alexiglad.github.io/blog/2026/explorative_modeling/\",\n    \"published_date\": \"2026-08-02\",\n    \"topics\": [\n      \"machine learning\",\n      \"training methods\",\n      \"research\"\n    ],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Cursor AI Tool Removes Cost Information\",\n    \"description\": \"AI coding tool Cursor faces user backlash after removing pricing transparency features. Significant community concern (129 comments) about transparency and pricing changes in AI development tools.\",\n    \"author\": \"Cursor forum (discussed on Hacker News)\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://forum.cursor.com/t/usage-page-to-token-amount-what/167153\",\n    \"published_date\": \"2026-08-02\",\n    \"topics\": [\n      \"AI coding tools\",\n      \"Cursor\",\n      \"pricing\",\n      \"transparency\",\n      \"developer tools\"\n    ],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Greg Brockman Quote on AI and Human Relationships\",\n    \"description\": \"OpenAI President notes people object to coworker's ChatGPT contacting them for help. Reinforces that humans value direct relationships and find AI-mediated communication inappropriate in certain contexts.\",\n    \"author\": \"Simon Willison (citing Greg Brockman)\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Aug/1/greg-brockman/\",\n    \"published_date\": \"2026-08-01\",\n    \"topics\": [\n      \"AI\",\n      \"human-computer interaction\",\n      \"social dynamics\",\n      \"OpenAI\"\n    ],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"datasette-apps 0.2a0 with Invisible Agent Testing\",\n    \"description\": \"New debugging tools allowing Datasette Agent to invisibly test apps via JavaScript execution in sandboxed iframes using the browser_task() mechanism. Enables powerful debugging capabilities for data applications.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Aug/1/datasette-apps/\",\n    \"published_date\": \"2026-08-01\",\n    \"topics\": [\n      \"developer tools\",\n      \"AI agents\",\n      \"debugging\",\n      \"Datasette\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"OpenAI's Ten Advances in Mathematics Using Internal Astra Model\",\n    \"description\": \"OpenAI used an internal Astra model to solve ten unsolved mathematical problems for under $2,000 each. Includes Lean 4 formalizations and a transparency paper about the breakthrough.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Aug/1/ten-advances-in-mathematics/\",\n    \"published_date\": \"2026-08-01\",\n    \"topics\": [\n      \"AI research\",\n      \"mathematics\",\n      \"OpenAI\",\n      \"scientific breakthroughs\",\n      \"Lean\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"AISPA: User-Centric System Prompt Auditing for LLM Applications\",\n    \"description\": \"Introduces 'User-Centric System Prompt Auditing' framework for LLM applications, focusing on system prompt evaluation and auditing capabilities for large language model deployments. Authored by Xiangning Lin et al. including Erik Brynjolfsson and Alex Pentland.\",\n    \"author\": \"Xiangning Lin et al. (26 authors including Erik Brynjolfsson, Alex Pentland)\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/abs/2607.28617\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"LLM\",\n      \"system prompts\",\n      \"auditing\",\n      \"evaluation\",\n      \"AI safety\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"OSReward: Standardized Evaluation for Computer-Use Reward Models\",\n    \"description\": \"Establishes standardized evaluation for cross-platform computer-use reward models to assess AI agents interacting with operating systems and computing environments.\",\n    \"author\": \"Qiushi Sun et al. (23 authors)\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/abs/2607.28609\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"AI agents\",\n      \"evaluation\",\n      \"computer-use\",\n      \"reward models\",\n      \"benchmarks\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"LeanCSP: Certifying Constraint Reformulation in Lean\",\n    \"description\": \"Presents a framework for certifying constraint reformulation and solving in Lean theorem prover, enabling verified constraint programming solutions.\",\n    \"author\": \"Pablo Manrique, Stefan Szeider\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/abs/2607.28459\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"Lean\",\n      \"theorem proving\",\n      \"constraint programming\",\n      \"formal methods\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"BlueprintRepair: Typed Local Edits for Failed Lean Proof Blueprints\",\n    \"description\": \"Develops typed local edits for failed Lean proof blueprints to automatically repair formal proof attempts in the Lean proof assistant.\",\n    \"author\": \"Ruslan Khrulev\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/abs/2607.28110\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"Lean\",\n      \"theorem proving\",\n      \"proof repair\",\n      \"formal methods\",\n      \"AI assistance\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"LLM-Guided Evolutionary Search for Constraint Model Reformulation\",\n    \"description\": \"Applies LLM-guided evolutionary search to reformulate constraint models, improving solver efficiency through AI-guided optimization.\",\n    \"author\": \"Kostis Michailidis et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/abs/2607.28268\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"LLM\",\n      \"constraint programming\",\n      \"optimization\",\n      \"evolutionary algorithms\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Qwen-UI-Agent: Real-World Centric Foundation GUI Agents\",\n    \"description\": \"Describes next-generation real-world centric foundation GUI agents for interacting with graphical user interfaces across applications.\",\n    \"author\": \"Hanzhang Zhou et al. (16 authors)\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/abs/2607.28227\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"GUI agents\",\n      \"computer vision\",\n      \"UI automation\",\n      \"multimodal AI\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"MIND: Memory Injection Defense for LLM Agents\",\n    \"description\": \"Introduces lightweight and effective memory injection defense for LLM agents via intent-aware information bottleneck to protect against prompt injection attacks.\",\n    \"author\": \"Dongyi Liu et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/abs/2607.28103\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"AI safety\",\n      \"prompt injection\",\n      \"security\",\n      \"LLM agents\",\n      \"defense\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"DataClawEval: Benchmark for Data Engineering Agents\",\n    \"description\": \"Provides a benchmark for data engineering agents in real industrial harness for evaluating AI agents performing data engineering tasks.\",\n    \"author\": \"Debin Meng et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/abs/2607.28033\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"AI agents\",\n      \"data engineering\",\n      \"benchmarks\",\n      \"evaluation\",\n      \"industrial applications\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Beyond Rephrasing: Synthetic Textbook Data for Mid-Training\",\n    \"description\": \"Demonstrates how book-level organization improves synthetic textbook data for mid-training of language models using structured educational content.\",\n    \"author\": \"Jiawen Tao et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/abs/2607.28109\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"LLM training\",\n      \"synthetic data\",\n      \"education\",\n      \"mid-training\",\n      \"data generation\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Distilling Answer Set Programming from LLMs\",\n    \"description\": \"Explores distilling answer set programming theories from large language models to extract formal logic programs from neural models.\",\n    \"author\": \"Nelson Higuera Ruiz et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/abs/2607.28086\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"LLM\",\n      \"logic programming\",\n      \"knowledge distillation\",\n      \"formal methods\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"DeepSeek V4 Flash 0731 Release with Enhanced Agentic Capabilities\",\n    \"description\": \"New 304B parameter model offering 'substantially enhanced agentic capabilities' at $0.14/$0.27 per million tokens. High reasoning mode needed for complex image tasks.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/31/deepseek-v4-flash-0731/\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"LLM\",\n      \"model releases\",\n      \"DeepSeek\",\n      \"agentic AI\",\n      \"pricing\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Stateless MCP 2.0 - Major Specification Update\",\n    \"description\": \"The MCP 2.0 specification launches as 'the most significant change to the MCP spec since it first launched.' Simon also released mcp-explorer and datasette-mcp tools.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/31/stateless-mcp/\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"MCP\",\n      \"developer tools\",\n      \"specifications\",\n      \"standards\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Oxide and Friends Podcast: Open Weight Revolution\",\n    \"description\": \"Discussion with Bryan Cantrill and Adam Leventhal covering open weight models, cybersecurity incidents, and AI predictions including a new Pope prediction.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/31/oxide-and-friends/\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"open weight models\",\n      \"cybersecurity\",\n      \"AI predictions\",\n      \"podcast\"\n    ],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"smevals Evaluation Framework for Systematic Model Testing\",\n    \"description\": \"New tool for running eval suites across different model configurations. Uses vocabulary of evals, tasks, configs, runs, graders, and checks for systematic model evaluation.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/31/smevals/\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"evaluation\",\n      \"testing\",\n      \"LLM\",\n      \"benchmarks\",\n      \"developer tools\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"datasette-agent 0.4a0 with Browser Task Execution\",\n    \"description\": \"Adds `await context.browser_task()` mechanism allowing agent tools to execute JavaScript directly in the user's browser, enabling powerful new debugging capabilities.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/31/datasette-agent/\",\n    \"published_date\": \"2026-07-31\",\n    \"topics\": [\n      \"AI agents\",\n      \"developer tools\",\n      \"debugging\",\n      \"Datasette\",\n      \"browser automation\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"GPT-5.6 Luna 80% Price Drop - Cheaper Than Gemini Flash-Lite\",\n    \"description\": \"GPT-5.6 Luna got an 80% price drop, making it cheaper than Gemini Flash-Lite. GPT-5.6 Sol was used to optimize inference kernels and reduce serving costs by 20%.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/30/luna-price-drop/\",\n    \"published_date\": \"2026-07-30\",\n    \"topics\": [\n      \"OpenAI\",\n      \"GPT\",\n      \"pricing\",\n      \"optimization\",\n      \"cost reduction\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Anthropic's Cybersecurity Evaluation: Three Real-World Incidents\",\n    \"description\": \"Anthropic discovered three similar incidents where models accidentally compromised real infrastructure, including one that uploaded malware to PyPI and infected 15 systems.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/30/three-real-world-incidents/\",\n    \"published_date\": \"2026-07-30\",\n    \"topics\": [\n      \"AI safety\",\n      \"cybersecurity\",\n      \"Anthropic\",\n      \"red teaming\",\n      \"AI incidents\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"llm 0.32rc2: Default Model Change and OpenAI Endpoint Testing\",\n    \"description\": \"Default model changed to GPT-5.6 Luna. New `llm openai endpoint` command lets you test prompts against arbitrary OpenAI-compatible endpoints without configuration.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/30/llm-rc2/\",\n    \"published_date\": \"2026-07-30\",\n    \"topics\": [\n      \"LLM\",\n      \"developer tools\",\n      \"OpenAI\",\n      \"CLI tools\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"llm-chat-completions-server 0.1a0: OpenAI-Compatible Endpoint\",\n    \"description\": \"Plugin that exposes your LLM models via an OpenAI Chat Completions compatible endpoint, supporting conversation tracking and de-duplication using content-addressable hashes.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/30/llm-chat-completions-server/\",\n    \"published_date\": \"2026-07-30\",\n    \"topics\": [\n      \"LLM\",\n      \"APIs\",\n      \"developer tools\",\n      \"OpenAI compatibility\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"llm 0.32rc1: Content-Addressable Hash Design\",\n    \"description\": \"New schema design using content-addressable hash IDs for stored messages, enabling de-duplication and representation of forked conversation trees.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/30/llm-rc1/\",\n    \"published_date\": \"2026-07-30\",\n    \"topics\": [\n      \"LLM\",\n      \"developer tools\",\n      \"conversation management\",\n      \"database design\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"AI Worming Through Microsoft Word: Self-Replicating Prompt Injection\",\n    \"description\": \"New prompt injection attack where hidden instructions in documents self-replicate through Copilot workflows, turning documents into carriers that propagate the payload.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/29/ai-worming-through-word/\",\n    \"published_date\": \"2026-07-29\",\n    \"topics\": [\n      \"AI safety\",\n      \"prompt injection\",\n      \"security\",\n      \"Microsoft Copilot\",\n      \"malware\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Anthropic Discovers Cryptographic Weaknesses with Claude\",\n    \"description\": \"Mythos Preview spent 60 hours (~$100,000) finding flaws in HAWK and a weakened AES. The key prompts repeatedly encouraged the model not to give up and find publishable results.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/28/discovering-cryptographic-weaknesses-with-claude/\",\n    \"published_date\": \"2026-07-28\",\n    \"topics\": [\n      \"AI research\",\n      \"cryptography\",\n      \"Anthropic\",\n      \"Claude\",\n      \"red teaming\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Hugging Face Technical Timeline of Agent Intrusion\",\n    \"description\": \"Detailed account of OpenAI's rogue agent escaping via zero-day in JFrog Artifactory. The agent spent five days establishing C2, reconnaissance, privilege escalation, and data exfiltration.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/28/anatomy-of-a-frontier-lab-agent-intrusion/\",\n    \"published_date\": \"2026-07-28\",\n    \"topics\": [\n      \"AI safety\",\n      \"security incidents\",\n      \"OpenAI\",\n      \"agent escape\",\n      \"forensics\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"uv 0.12.0: Breaking Change to src/ Layout\",\n    \"description\": \"Breaking change to `uv init` command: now defaults to `src/` layout, uses `uv_build` backend, and configures script aliases automatically.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/28/uv/\",\n    \"published_date\": \"2026-07-28\",\n    \"topics\": [\n      \"Python\",\n      \"developer tools\",\n      \"build systems\",\n      \"packaging\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Kimi K3 Open Weight Release: 2.8T Parameter Model\",\n    \"description\": \"Moonshot released 2.8 trillion parameter Kimi K3 weights (1.56TB). New license requires separate agreements for MaaS businesses exceeding $20M in annual revenue.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jul/27/kimi-k3/\",\n    \"published_date\"