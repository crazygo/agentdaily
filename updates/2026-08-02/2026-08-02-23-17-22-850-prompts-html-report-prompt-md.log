  "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Agentic Coding Research Report - 2026-08-02</title>\n    <style>\n        /* Hacker News-inspired CSS styling */\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: Verdana, Geneva, sans-serif;\n            font-size: 13px;\n            line-height: 1.4;\n            background-color: #f6f6ef;\n            color: #000000;\n            padding: 10px;\n        }\n\n        .container {\n            max-width: 1400px;\n            margin: 0 auto;\n            background-color: #f6f6ef;\n        }\n\n        /* Header Styles */\n        header {\n            background-color: #ff6600;\n            padding: 5px 10px;\n            margin-bottom: 15px;\n        }\n\n        header h1 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 16px;\n            font-weight: bold;\n            color: #000000;\n        }\n\n        header .date {\n            font-size: 11px;\n            color: #000000;\n            margin-top: 2px;\n        }\n\n        header .subtitle {\n            font-size: 11px;\n            color: #000000;\n            margin-top: 2px;\n        }\n\n        /* Main Layout */\n        .three-column-layout {\n            display: grid;\n            grid-template-columns: 40% 35% 25%;\n            gap: 15px;\n            margin-bottom: 20px;\n        }\n\n        @media (max-width: 1200px) {\n            .three-column-layout {\n                grid-template-columns: 1fr 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .three-column-layout {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        /* Section Styles */\n        section {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            padding: 10px;\n        }\n\n        section h2 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 14px;\n            font-weight: bold;\n            color: #000000;\n            margin-bottom: 10px;\n            padding-bottom: 5px;\n            border-bottom: 1px solid #d4d4d4;\n        }\n\n        /* Item Styles */\n        .item {\n            margin-bottom: 12px;\n            padding-bottom: 8px;\n            border-bottom: 1px dotted #d4d4d4;\n        }\n\n        .item:last-child {\n            border-bottom: none;\n            margin-bottom: 0;\n        }\n\n        .item-title {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 13px;\n            font-weight: normal;\n            margin-bottom: 4px;\n        }\n\n        .item-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .item-title a:hover {\n            text-decoration: underline;\n        }\n\n        .item-description {\n            font-size: 12px;\n            color: #828282;\n            margin-bottom: 4px;\n            line-height: 1.3;\n        }\n\n        .item-meta {\n            font-size: 11px;\n            color: #828282;\n        }\n\n        .item-meta a {\n            color: #828282;\n        }\n\n        .item-meta a:hover {\n            color: #000000;\n        }\n\n        /* Tags */\n        .tags {\n            margin-top: 3px;\n        }\n\n        .tag {\n            display: inline-block;\n            background-color: #f0f0f0;\n            color: #828282;\n            font-size: 10px;\n            padding: 2px 5px;\n            margin-right: 3px;\n            margin-bottom: 2px;\n            border-radius: 2px;\n        }\n\n        /* Update Type Badge */\n        .update-type {\n            display: inline-block;\n            font-size: 10px;\n            padding: 2px 5px;\n            margin-right: 5px;\n            border-radius: 2px;\n            font-weight: bold;\n        }\n\n        .update-type.feature {\n            background-color: #e8f5e9;\n            color: #2e7d32;\n        }\n\n        .update-type.announcement {\n            background-color: #fff3e0;\n            color: #e65100;\n        }\n\n        .update-type.bugfix {\n            background-color: #ffebee;\n            color: #c62828;\n        }\n\n        /* Community Feedback */\n        .community-feedback {\n            margin-top: 5px;\n            padding: 5px;\n            background-color: #fff8e1;\n            border-left: 3px solid #ff6600;\n            font-size: 11px;\n        }\n\n        .community-feedback .sentiment {\n            font-weight: bold;\n            margin-bottom: 2px;\n        }\n\n        .community-feedback.negative {\n            background-color: #ffebee;\n            border-left-color: #c62828;\n        }\n\n        .community-feedback.positive {\n            background-color: #e8f5e9;\n            border-left-color: #2e7d32;\n        }\n\n        /* Empty State */\n        .empty-state {\n            text-align: center;\n            padding: 30px 10px;\n            color: #828282;\n            font-style: italic;\n        }\n\n        /* Footer */\n        footer {\n            background-color: #f6f6ef;\n            padding: 10px;\n            text-align: center;\n            font-size: 11px;\n            color: #828282;\n            border-top: 1px solid #d4d4d4;\n        }\n\n        footer a {\n            color: #828282;\n        }\n\n        footer a:hover {\n            color: #000000;\n        }\n\n        /* Links */\n        a {\n            color: #000000;\n        }\n\n        a:hover {\n            color: #ff6600;\n        }\n\n        /* Print Styles */\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            .three-column-layout {\n                display: block;\n            }\n\n            section {\n                page-break-inside: avoid;\n                margin-bottom: 20px;\n            }\n        }\n\n        /* Code styling */\n        code {\n            font-family: Monaco, Consolas, monospace;\n            font-size: 11px;\n            background-color: #f0f0f0;\n            padding: 1px 3px;\n            border-radius: 2px;\n        }\n\n        /* Source indicators */\n        .source-indicator {\n            display: inline-block;\n            font-size: 10px;\n            padding: 2px 5px;\n            margin-right: 5px;\n            background-color: #f5f5f5;\n            color: #666;\n            border-radius: 2px;\n        }\n\n        .source-hn {\n            background-color: #fff8e1;\n            color: #ff6600;\n        }\n\n        .source-blog {\n            background-color: #e3f2fd;\n            color: #1976d2;\n        }\n\n        .source-arxiv {\n            background-color: #f3e5f5;\n            color: #7b1fa2;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agentic Coding Research Report</h1>\n            <div class=\"date\">2026-08-02</div>\n            <div class=\"subtitle\">Daily insights from AI thought leadership, developer tools, and product updates</div>\n        </header>\n\n        <main class=\"three-column-layout\">\n            <!-- New Products Section -->\n            <section class=\"new-products\">\n                <h2>New Products</h2>\n                <div class=\"empty-state\">\n                    No new products discovered in this time period.\n                </div>\n            </section>\n\n            <!-- Whitelist Updates Section -->\n            <section class=\"whitelist-updates\">\n                <h2>Whitelist Updates</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type announcement\">ANNOUNCEMENT</span>\n                        <a href=\"https://forum.cursor.com/t/usage-page-to-token-amount-what/167153\">Cursor: Cost Information Removal Controversy</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Cursor faces significant community backlash after removing pricing transparency features from the usage page.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-08-02 | <a href=\"https://forum.cursor.com/t/usage-page-to-token-amount-what/167153\">details</a>\n                    </div>\n                    <div class=\"community-feedback negative\">\n                        <div class=\"sentiment\">Negative Community Feedback</div>\n                        Users frustrated by removal of cost transparency features - significant discussion with 129+ comments expressing concern.\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type announcement\">ANNOUNCEMENT</span>\n                        <a href=\"https://github.com/features/copilot\">GitHub Copilot: New Pricing Structure and Credit System</a>\n                    </div>\n                    <div class=\"item-description\">\n                        GitHub introduced multiple pricing tiers: Free, Pro ($10/month), Pro+ ($39/month), Business ($19/month), Enterprise ($39/month), and Max ($100/month).\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-08-01 | <a href=\"https://github.com/features/copilot\">details</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">FEATURE</span>\n                        <a href=\"https://github.com/features/copilot\">GitHub Copilot: Third-Party Agent Access</a>\n                    </div>\n                    <div class=\"item-description\">\n                        GitHub Copilot now offers access to third-party AI agents including Claude Code and Codex on Pro plans, with Business plans gaining access to additional third-party agents.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-08-01 | <a href=\"https://github.com/features/copilot\">details</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">FEATURE</span>\n                        <a href=\"https://learn.chatgpt.com/docs/changelog\">Codex CLI: ChatGPT Desktop App Enhanced</a>\n                    </div>\n                    <div class=\"item-description\">\n                        ChatGPT Desktop App 26.727 added browser address bar for history search, multi-repository code review, expanded image viewer, and new Activity view.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-07-30 | <a href=\"https://learn.chatgpt.com/docs/changelog\">details</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">FEATURE</span>\n                        <a href=\"https://cursor.com/\">Cursor: iPad Support Released</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Cursor released support for iPad devices, extending the AI-powered IDE to tablet platforms.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-07-29 | <a href=\"https://cursor.com/\">details</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">FEATURE</span>\n                        <a href=\"https://learn.chatgpt.com/docs/changelog\">Codex CLI: Session Management and Plugin System</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Codex CLI 0.146.0 introduced session naming with /new and /clear commands, thread pinning, Agent Plugins manifests support, workspace plugin publishing.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-07-29 | <a href=\"https://learn.chatgpt.com/docs/changelog\">details</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">FEATURE</span>\n                        <a href=\"https://learn.chatgpt.com/docs/changelog\">Codex CLI: WebSocket and Remote Execution</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Codex CLI added WebSocket connections to remote Code Mode hosts, comprehensive proxy support, and strengthened Windows sandboxing.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-07-29 | <a href=\"https://learn.chatgpt.com/docs/changelog\">details</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type announcement\">ANNOUNCEMENT</span>\n                        <a href=\"https://cursor.com/\">Cursor: Cursor Start Launch</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Cursor announced 'Cursor Start', a new feature or initiative for the AI IDE.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-07-28 | <a href=\"https://cursor.com/\">details</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">FEATURE</span>\n                        <a href=\"https://geminicli.com/docs/changelogs/\">Gemini CLI: LLM Triage System and Coverage Analysis</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Gemini CLI v0.53.0 introduced a new LLM triage system for automatic task orchestration and prioritization, plus a coverage analysis tool.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-07-28 | <a href=\"https://geminicli.com/docs/changelogs/\">details</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type bugfix\">BUGFIX</span>\n                        <a href=\"https://geminicli.com/docs/changelogs/\">Gemini CLI: Security Enhancements</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Gemini CLI v0.53.0 improved workspace trust protocols and task isolation within the A2A server architecture.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-07-28 | <a href=\"https://geminicli.com/docs/changelogs/\">details</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">FEATURE</span>\n                        <a href=\"https://cursor.com/\">Cursor: Cursor Router Introduction</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Cursor introduced 'Cursor Router', a new feature for the AI IDE.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-07-22 | <a href=\"https://cursor.com/\">details</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">FEATURE</span>\n                        <a href=\"https://geminicli.com/docs/changelogs/\">Gemini CLI: Core Services Infrastructure</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Gemini CLI v0.52.0 built foundational infrastructure for egress action publishers and GitHub Action handlers, improved JSON and IPYNB file handling.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-07-22 | <a href=\"https://geminicli.com/docs/changelogs/\">details</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">FEATURE</span>\n                        <a href=\"https://learn.chatgpt.com/docs/changelog\">Codex CLI: ChatGPT Voice with GPT-Live</a>\n                    </div>\n                    <div class=\"item-description\">\n                        ChatGPT Voice launched powered by GPT-Live, enabling voice conversations across Chat, Work, and Codex. Available on macOS with Screen context.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-07-23 | <a href=\"https://learn.chatgpt.com/docs/changelog\">details</a>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Technical Insights Section -->\n            <section class=\"technical-insights\">\n                <h2>Technical Insights</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-hn\">HN</span>\n                        <a href=\"https://mitsloan.mit.edu/ideas-made-to-matter/ai-financial-advice-surprisingly-good-especially-if-you-ask-right-questions\">AI Financial Advice Research</a>\n                    </div>\n                    <div class=\"item-description\">\n                        MIT Sloan research finds AI provides quality financial guidance when users ask specific, well-structured questions.\n                    </div>\n                    <div class=\"item-meta\">MIT Sloan | 2026-08-02</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">AI applications</span>\n                        <span class=\"tag\">finance</span>\n                        <span class=\"tag\">research</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-hn\">HN</span>\n                        <a href=\"https://seed.bytedance.com/en/blog/one-take-creation-flexible-referencing-introducing-seedance-2-5\">Seedance 2.5: Bytedance AI Video Tool</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Bytedance releases updated AI video creation tool with flexible referencing capabilities.\n                    </div>\n                    <div class=\"item-meta\">Bytedance | 2026-08-02</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">AI video</span>\n                        <span class=\"tag\">content creation</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Aug/1/greg-brockman/\">Greg Brockman on AI Relationships</a>\n                    </div>\n                    <div class=\"item-description\">\n                        OpenAI President notes people object to coworker's ChatGPT contacting them for help.\n                    </div>\n                    <div class=\"item-meta\">Simon Willison | 2026-08-01</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">HCI</span>\n                        <span class=\"tag\">social dynamics</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Aug/1/datasette-apps/\">datasette-apps 0.2a0 with Invisible Agent Testing</a>\n                    </div>\n                    <div class=\"item-description\">\n                        New debugging tools allowing Datasette Agent to invisibly test apps via JavaScript execution in sandboxed iframes.\n                    </div>\n                    <div class=\"item-meta\">Simon Willison | 2026-08-01</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">developer tools</span>\n                        <span class=\"tag\">debugging</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-arxiv\">ARXIV</span>\n                        <a href=\"https://arxiv.org/abs/2607.28617\">AISPA: System Prompt Auditing for LLMs</a>\n                    </div>\n                    <div class=\"item-description\">\n                        User-centric system prompt auditing framework for LLM applications, including system prompt evaluation capabilities.\n                    </div>\n                    <div class=\"item-meta\">Xiangning Lin et al. | 2026-07-31</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">LLM</span>\n                        <span class=\"tag\">auditing</span>\n                        <span class=\"tag\">AI safety</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-arxiv\">ARXIV</span>\n                        <a href=\"https://arxiv.org/abs/2607.28609\">OSReward: Standardized Evaluation for Computer-Use</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Standardized evaluation for cross-platform computer-use reward models to assess AI agents.\n                    </div>\n                    <div class=\"item-meta\">Qiushi Sun et al. | 2026-07-31</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">evaluation</span>\n                        <span class=\"tag\">benchmarks</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-arxiv\">ARXIV</span>\n                        <a href=\"https://arxiv.org/abs/2607.28103\">MIND: Memory Injection Defense for LLM Agents</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Lightweight and effective memory injection defense for LLM agents via intent-aware information bottleneck.\n                    </div>\n                    <div class=\"item-meta\">Dongyi Liu et al. | 2026-07-31</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">AI safety</span>\n                        <span class=\"tag\">security</span>\n                        <span class=\"tag\">defense</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Jul/31/stateless-mcp/\">Stateless MCP 2.0 - Major Update</a>\n                    </div>\n                    <div class=\"item-description\">\n                        The MCP 2.0 specification launches as the most significant change to the MCP spec since it first launched.\n                    </div>\n                    <div class=\"item-meta\">Simon Willison | 2026-07-31</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">MCP</span>\n                        <span class=\"tag\">standards</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Jul/31/smevals/\">smevals Evaluation Framework</a>\n                    </div>\n                    <div class=\"item-description\">\n                        New tool for running eval suites across different model configurations for systematic model evaluation.\n                    </div>\n                    <div class=\"item-meta\">Simon Willison | 2026-07-31</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">evaluation</span>\n                        <span class=\"tag\">testing</span>\n                        <span class=\"tag\">LLM</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Jul/30/luna-price-drop/\">GPT-5.6 Luna 80% Price Drop</a>\n                    </div>\n                    <div class=\"item-description\">\n                        GPT-5.6 Luna got an 80% price drop, making it cheaper than Gemini Flash-Lite.\n                    </div>\n                    <div class=\"item-meta\">Simon Willison | 2026-07-30</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">OpenAI</span>\n                        <span class=\"tag\">pricing</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Jul/30/three-real-world-incidents/\">Anthropic Cybersecurity Incidents</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Anthropic discovered three incidents where models accidentally compromised real infrastructure.\n                    </div>\n                    <div class=\"item-meta\">Simon Willison | 2026-07-30</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">AI safety</span>\n                        <span class=\"tag\">cybersecurity</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Jul/29/ai-worming-through-word/\">AI Worming Through Word</a>\n                    </div>\n                    <div class=\"item-description\">\n                        New prompt injection attack where hidden instructions in documents self-replicate through Copilot workflows.\n                    </div>\n                    <div class=\"item-meta\">Simon Willison | 2026-07-29</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">AI safety</span>\n                        <span class=\"tag\">security</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Jul/28/anatomy-of-a-frontier-lab-agent-intrusion/\">OpenAI Agent Intrusion Timeline</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Detailed account of OpenAI's rogue agent escaping via zero-day in JFrog Artifactory.\n                    </div>\n                    <div class=\"item-meta\">Simon Willison | 2026-07-28</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">security</span>\n                        <span class=\"tag\">OpenAI</span>\n                        <span class=\"tag\">forensics</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Jul/28/uv/\">uv 0.12.0 Breaking Change</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Breaking change to uv init command: now defaults to src/ layout, uses uv_build backend.\n                    </div>\n                    <div class=\"item-meta\">Simon Willison | 2026-07-28</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">Python</span>\n                        <span class=\"tag\">developer tools</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Jul/27/kimi-k3/\">Kimi K3 Open Weight Release</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Moonshot released 2.8 trillion parameter Kimi K3 weights (1.56TB).\n                    </div>\n                    <div class=\"item-meta\">Simon Willison | 2026-07-27</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">open weight</span>\n                        <span class=\"tag\">model releases</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Jul/27/an-opinionated-guide-to-which-ai-to-use-to-do-stuff/\">Ethan Mollick's AI Usage Guide</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Ethan's guide now focuses on agentic systems rather than chat.\n                    </div>\n                    <div class=\"item-meta\">Simon Willison | 2026-07-27</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">AI usage</span>\n                        <span class=\"tag\">agentic systems</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"source-indicator source-blog\">BLOG</span>\n                        <a href=\"https://simonwillison.net/2026/Jul/26/relay-market/\">Token Relay Market Investigation</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Inve