      "content": "[\n  {\n    \"title\": \"AI Financial Advice Research\",\n    \"description\": \"MIT Sloan research finds AI provides quality financial guidance when users ask specific, well-structured questions. Discussion on accuracy, limitations, and practical applications.\",\n    \"author\": \"MIT Sloan (discussed on Hacker News)\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://mitsloan.mit.edu/ideas-made-to-matter/ai-financial-advice-surprisingly-good-especially-if-you-ask-right-questions\",\n    \"published_date\": \"2026-08-02\",\n    \"topics\": [\"AI applications\", \"finance\", \"research\", \"practical AI\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Seedance 2.5: Bytedance AI Video Creation Tool\",\n    \"description\": \"Bytedance releases updated AI video creation tool with flexible referencing capabilities. Community discussion on technology and implications for content creation.\",\n    \"author\": \"Bytedance (discussed on Hacker News)\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://seed.bytedance.com/en/blog/one-take-creation-flexible-referencing-introducing-seedance-2-5\",\n    \"published_date\": \"2026-08-02\",\n    \"topics\": [\"AI video\", \"content creation\", \"Bytedance\", \"multimodal AI\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Explorative Modeling: Train on the Best of K Guesses\",\n    \"description\": \"Novel ML training approach exploring multiple guess selection strategies. Community discussion on methodology and performance implications.\",\n    \"author\": \"Hacker News community\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://alexiglad.github.io/blog/2026/explorative_modeling/\",\n    \"published_date\": \"2026-08-02\",\n    \"topics\": [\"machine learning\", \"training methods\", \"research\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Cursor AI Tool Removes Cost Information\",\n    \"description\": \"AI coding tool Cursor faces user 