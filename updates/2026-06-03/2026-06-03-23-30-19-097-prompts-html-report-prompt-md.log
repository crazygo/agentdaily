    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Agent Code Daily - 2026-06-03</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: Verdana, Geneva, sans-serif;\n            font-size: 13px;\n            line-height: 1.5;\n            background-color: #f6f6ef;\n            color: #000000;\n        }\n\n        .container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 10px;\n        }\n\n        header {\n            background-color: #ff6600;\n            padding: 5px 10px;\n            margin-bottom: 15px;\n        }\n\n        header h1 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 16px;\n            font-weight: bold;\n            color: #000000;\n        }\n\n        header .date {\n            font-size: 12px;\n            color: #000000;\n            margin-top: 2px;\n        }\n\n        .three-column-layout {\n            display: grid;\n            grid-template-columns: 40% 35% 25%;\n            gap: 15px;\n            margin-bottom: 20px;\n        }\n\n        @media (max-width: 1024px) {\n            .three-column-layout {\n                grid-template-columns: 1fr 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .three-column-layout {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        .column {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            padding: 12px;\n        }\n\n        .column-header {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 14px;\n            font-weight: bold;\n            color: #000000;\n            border-bottom: 1px solid #ff6600;\n            padding-bottom: 8px;\n            margin-bottom: 12px;\n        }\n\n        .item {\n            margin-bottom: 15px;\n            padding-bottom: 12px;\n            border-bottom: 1px dotted #d4d4d4;\n        }\n\n        .item:last-child {\n            border-bottom: none;\n            margin-bottom: 0;\n            padding-bottom: 0;\n        }\n\n        .item-title {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 13px;\n            font-weight: bold;\n            margin-bottom: 4px;\n        }\n\n        .item-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .item-title a:hover {\n            text-decoration: underline;\n        }\n\n        .item-title a:visited {\n            color: #828282;\n        }\n\n        .item-description {\n            color: #828282;\n            font-size: 12px;\n            line-height: 1.4;\n            margin-bottom: 4px;\n        }\n\n        .item-meta {\n            font-size: 11px;\n            color: #828282;\n        }\n\n        .item-meta .tag {\n            display: inline-block;\n            background-color: #f6f6ef;\n            padding: 2px 6px;\n            margin-right: 5px;\n            border: 1px solid #d4d4d4;\n            font-size: 10px;\n        }\n\n        .item-meta .source {\n            color: #828282;\n        }\n\n        .item-meta .date {\n            color: #828282;\n        }\n\n        .item-meta a {\n            color: #ff6600;\n            text-decoration: none;\n        }\n\n        .item-meta a:hover {\n            text-decoration: underline;\n        }\n\n        .update-type {\n            display: inline-block;\n            font-size: 10px;\n            padding: 2px 6px;\n            margin-right: 5px;\n            border-radius: 2px;\n            text-transform: uppercase;\n            font-weight: bold;\n        }\n\n        .update-type.feature {\n            background-color: #e8f5e9;\n            color: #2e7d32;\n        }\n\n        .update-type.release {\n            background-color: #e3f2fd;\n            color: #1565c0;\n        }\n\n        .update-type.announcement {\n            background-color: #fff3e0;\n            color: #e65100;\n        }\n\n        .community-quote {\n            font-style: italic;\n            color: #828282;\n            font-size: 11px;\n            margin-top: 4px;\n            padding: 4px 8px;\n            background-color: #f6f6ef;\n            border-left: 2px solid #ff6600;\n        }\n\n        .empty-state {\n            color: #828282;\n            font-style: italic;\n            text-align: center;\n            padding: 20px;\n        }\n\n        footer {\n            background-color: #f6f6ef;\n            border-top: 1px solid #d4d4d4;\n            padding: 10px;\n            text-align: center;\n            font-size: 11px;\n            color: #828282;\n        }\n\n        footer a {\n            color: #ff6600;\n            text-decoration: none;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n        }\n\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            .column {\n                border: 1px solid #000000;\n                page-break-inside: avoid;\n            }\n\n            .item {\n                page-break-inside: avoid;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agent Code Daily</h1>\n            <div class=\"date\">2026-06-03</div>\n        </header>\n\n        <main class=\"three-column-layout\">\n            <section class=\"column new-products\">\n                <div class=\"column-header\">New Products</div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/narelabs/sharrowkin-ide\" target=\"_blank\">Sharrowkin IDE</a>\n                    </div>\n                    <div class=\"item-description\">\n                        AI IDE with persistent memory featuring local-first architecture and bring-your-own-model support for privacy-conscious developers.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI IDE</span>\n                        <span class=\"source\">GitHub</span>\n                        <span class=\"date\">2026-05-31</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/OperonAgent/Operon\" target=\"_blank\">Operon</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Advanced autonomous AI Terminal Cockpit combining features from OpenClaw and Hermes Agent for autonomous task execution and terminal-based workflow management.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI coding CLI</span>\n                        <span class=\"source\">GitHub</span>\n                        <span class=\"date\">2026-05-30</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/raaaaap/mimo-code\" target=\"_blank\">Mimo Code</a>\n                    </div>\n                    <div class=\"item-description\">\n                        CLI coding agent powered by the MiMo large language model for autonomous code editing and development tasks from the terminal.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI coding CLI</span>\n                        <span class=\"source\">GitHub</span>\n                        <span class=\"date\">2026-05-29</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/manan45/Cantus\" target=\"_blank\">Cantus</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Claude-first, local-first desktop coding environment for macOS built with Tauri 2, featuring Monaco editor, integrated terminal with Claude Code CLI, git staging, resumable sessions, and SQLite-backed memory store.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI IDE</span>\n                        <span class=\"source\">GitHub</span>\n                        <span class=\"date\">2026-05-28</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/IvanWng97/pixtuoid\" target=\"_blank\">Pixtuoid</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Terminal pixel-art office for AI coding agents that visualizes Claude Code sessions as animated pixel-art coworkers working in a virtual office environment.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI coding CLI</span>\n                        <span class=\"source\">GitHub</span>\n                        <span class=\"date\">2026-05-21</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/hongmaple0820/maple-os\" target=\"_blank\">MapleOS</a>\n                    </div>\n                    <div class=\"item-description\">\n                        AI Operating System for individuals and teams featuring multi-agent collaboration, workflow automation orchestration, local-first architecture with privacy focus, and Rust-based runtime.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI IDE</span>\n                        <span class=\"source\">GitHub</span>\n                        <span class=\"date\">2026-05-21</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/Tartarus-AI/tartarusai-cli\" target=\"_blank\">TartarusAI CLI</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Uncensored AI coding agent that runs in your terminal with 256K context window, featuring crypto-only billing and designed to complete coding tasks without refusal.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI coding CLI</span>\n                        <span class=\"source\">GitHub</span>\n                        <span class=\"date\">2026-05-20</span>\n                    </div>\n                </div>\n            </section>\n\n            <section class=\"column whitelist-updates\">\n                <div class=\"column-header\">Whitelist Updates</div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://cursor.com/changelog/enterprise-organizations\" target=\"_blank\">Cursor: Organizations for Cursor Enterprise</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Enterprise customers can now manage multiple Cursor teams from one place, with different security, governance, budget, and feature controls for each.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span class=\"date\">2026-06-03</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://devin.ai/desktop\" target=\"_blank\">Devin: Devin Desktop GA Release</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Devin Desktop is now generally available, allowing developers to manage fleets of local and cloud agents from one surface.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type release\">Release</span>\n                        <span class=\"date\">2026-06-03</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://devin.ai/desktop\" target=\"_blank\">Windsurf: Windsurf is now Devin Desktop</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Windsurf has been rebranded to Devin Desktop, maintaining the IDE features users love while adding more capabilities.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type announcement\">Announcement</span>\n                        <span class=\"date\">2026-06-03</span>\n                    </div>\n                    <div class=\"community-quote\">\"What? Devin is still alive? Is the same devin from 2 years ago?\" - HN</div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://cursor.com/changelog/auto-review\" target=\"_blank\">Cursor: Auto-review Run Mode (v3.6)</a>\n                    </div>\n                    <div class=\"item-description\">\n                        New auto-review run mode that allows Cursor to work for longer with fewer approval prompts and safer execution.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span class=\"date\">2026-05-29</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://cursor.com/changelog/shared-canvases\" target=\"_blank\">Cursor: Shared Canvases and /loop Skill (v3.5)</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Introduced Shared Canvases feature and the /loop skill for local long-running agents with recurring tasks.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span class=\"date\">2026-05-20</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://cursor.com/changelog/05-20-26\" target=\"_blank\">Cursor: Cursor Automations Improvements (v3.5)</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Cursor Automations is now available in the Agents Window with ability to configure automations with multiple attached repos.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span class=\"date\">2026-05-20</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://cursor.com/changelog/05-19-26\" target=\"_blank\">Cursor: Cursor in Jira Integration</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Cursor is now available as an integration in Jira. Requires Cursor admin access and Jira Commercial Cloud with Rovo enabled.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span class=\"date\">2026-05-19</span>\n                    </div>\n                </div>\n            </section>\n\n            <section class=\"column technical-insights\">\n                <div class=\"column-header\">Technical Insights</div>\n                <div class=\"empty-state\">No insights gathered for this report.</div>\n            </section>\n        </main>\n\n        <footer>\n            <p>Report generated by <a href=\"#\">Agent Code Daily</a> - Powered by Claude Agent SDK</p>\n        </footer>\n    </div>\n</body>\n</html>",
