us: 2px;\n            font-size: 11px;\n            color: #828282;\n            border: 1px solid #d4d4d4;\n        }\n\n        .source-tag {\n            color: #828282;\n        }\n\n        .source-tag a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        .source-tag a:hover {\n            color: #ff6600;\n        }\n\n        .release-date {\n            color: #828282;\n        }\n\n        .empty-state {\n            text-align: center;\n            padding: 30px 10px;\n            color: #828282;\n            font-style: italic;\n        }\n\n        .empty-state .icon {\n            font-size: 24px;\n            margin-bottom: 10px;\n        }\n\n        footer {\n            margin-top: 20px;\n            padding: 15px;\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            border-radius: 2px;\n            text-align: center;\n            color: #828282;\n            font-size: 12px;\n        }\n\n        footer a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        footer a:hover {\n            color: #ff6600;\n        }\n\n        /* Print styles */\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n            .section {\n                page-break-inside: avoid;\n            }\n        }\n\n        /* Scrollbar styling */\n        ::-webkit-scrollbar {\n            width: 8px;\n        }\n\n        ::-webkit-scrollbar-track {\n            background: #f6f6ef;\n        }\n\n        ::-webkit-scrollbar-thumb {\n            background: #d4d4d4;\n            border-radius: 4px;\n        }\n\n        ::-webkit-scrollbar-thumb:hover {\n            background: #ff6600;\n        }\n\n        .stats-bar {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            border-radius: 2px;\n            padding: 10px;\n            margin-bottom: 15px;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            font-size: 12px;\n        }\n\n        .stats-bar .stat-item {\n            display: flex;\n            align-items: center;\n            gap: 5px;\n            color: #828282;\n        }\n\n        .stats-bar .stat-number {\n            font-weight: bold;\n            color: #ff6600;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>\n                <span>🤖</span>\n                <span>Agentic Coding Research Report</span>\n                <span class=\"date\">| June 2, 2026</span>\n            </h1>\n        </header>\n\n        <div class=\"stats-bar\">\n            <div class=\"stat-item\">\n                <span>Total Products:</span>\n                <span class=\"stat-number\">31</span>\n            </div>\n            <div class=\"stat-item\">\n                <span>Period:</span>\n                <span class=\"stat-number\">May 20 - June 1, 2026</span>\n            </div>\n            <div class=\"stat-item\">\n                <span>Generated:</span>\n                <span class=\"stat-number\">2026-06-02</span>\n            </div>\n        </div>\n\n        <main class=\"three-column-layout\">\n            <!-- New Products Section -->\n            <section class=\"new-products\">\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span>New Products</span>\n                        <span class=\"count\">31</span>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/wait4xx/AI-CLI\" target=\"_blank\" rel=\"noopener\">AI-CLI</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Run Terminal or AI coding assistants (Claude Code, Aider, etc.) on your phone/tablet — a responsive web IDE with terminal, split-pane editor, file browser, and real-time collaboration\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">AI IDE</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/wait4xx/AI-CLI\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-06-01</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/KangarooKi/Ultracode\" target=\"_blank\" rel=\"noopener\">Ultracode</a>\n                        </div>\n                        <div class=\"product-description\">\n                            UltraCode is a local AI-assisted coding CLI inspired by Claude Code. It runs agentic coding workflows in your workspace with OpenAI-compatible models, function-calling tools, task planning, memory, permissions, hooks, background commands, MCP integration, and subagent support.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">AI coding CLI</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/KangarooKi/Ultracode\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-31</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/rextanka/zero-cost-cline\" target=\"_blank\" rel=\"noopener\">zero-cost-cline</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Guide to 100% local, private LLM code generation on Apple Silicon. Optimized for 24GB+ Macs, uses Ollama + Cline to build a disciplined, free agentic workflow.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">open-source AI coding agent</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/rextanka/zero-cost-cline\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-31</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/zixingtangmouren/mech-code\" target=\"_blank\" rel=\"noopener\">mech-code</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Mech-Code is an AI-powered coding agent designed to be the ultimate mechanical partner for developers. It seamlessly integrates into your workflow to automate complex tasks, refactor legacy code, and provide intelligent context-aware suggestions.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">code agent</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/zixingtangmouren/mech-code\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-30</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/XWJDream/MimoAgent\" target=\"_blank\" rel=\"noopener\">MimoAgent</a>\n                        </div>\n                        <div class=\"product-description\">\n                            AI-powered coding assistant desktop app based on Xiaomi MiMo. Supports code generation, debugging, refactoring, project analysis, MCP tools and TTS.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">AI IDE</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/XWJDream/MimoAgent\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-30</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/Fafoooo/arbella\" target=\"_blank\" rel=\"noopener\">arbella</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Sync AI coding tool setups across machines.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">workflow agent</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/Fafoooo/arbella\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-30</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/vikingmute/review-forge\" target=\"_blank\" rel=\"noopener\">review-forge</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Agent Skill for structured, auditable code review workflows\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">workflow agent</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/vikingmute/review-forge\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-29</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/oleg-koval/ai-refactor-playbook-runner\" target=\"_blank\" rel=\"noopener\">ai-refactor-playbook-runner</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Markdown-driven AI refactor playbook runner with CLI and local web UI\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">refactoring tool</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/oleg-koval/ai-refactor-playbook-runner\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-29</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/open-gsd/gsd-browser\" target=\"_blank\" rel=\"noopener\">gsd-browser</a>\n                        </div>\n                        <div class=\"product-description\">\n                            A fast, native browser automation CLI built from the ground up for AI agents, powered by Chrome DevTools Protocol. 63 commands covering navigation, interaction, screenshots, accessibility, network mocking, visual diffing, test generation, and more.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">test generation</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/open-gsd/gsd-browser\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-29</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/salmanashraf/mobile-agency\" target=\"_blank\" rel=\"noopener\">mobile-agency</a>\n                        </div>\n                        <div class=\"product-description\">\n                            A curated collection of AI-powered skills, agents, prompts, and workflows for Android, iOS, Flutter, React Native, Unity, and Unreal developers.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">workflow agent</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/salmanashraf/mobile-agency\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-29</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/manan45/Cantus\" target=\"_blank\" rel=\"noopener\">Cantus</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Cantus is a Claude-first, local-first desktop coding environment for macOS (Apple Silicon). A native Tauri 2 app pairs a Monaco editor, an integrated terminal running the Claude Code CLI in a backend PTY, per-hunk and per-line git staging, resumable Claude sessions, a .claude workflow task runner, and a local SQLite-backed learned-memory store.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">AI IDE</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/manan45/Cantus\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-28</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/forkadarshp/MPort\" target=\"_blank\" rel=\"noopener\">MPort</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Migrate LLM apps between models safely — then benchmark old vs. new to prove the upgrade. Agent skill for behavior-preserving migrations + a runnable eval harness.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">migration tool</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/forkadarshp/MPort\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-28</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/Ashut90/pdf-tutor\" target=\"_blank\" rel=\"noopener\">pdf-tutor</a>\n                        </div>\n                        <div class=\"product-description\">\n                            A local-first, hybrid AI study assistant that refactors technical documentation into VARK learning tracks and automated Anki flashcards.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">workflow agent</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/Ashut90/pdf-tutor\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-28</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/Harkirat1462/claude-code-cli\" target=\"_blank\" rel=\"noopener\">claude-code-cli</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Claude Code CLI install guide — Agentic coding system with terminal assistant, codebase git workflows, multi-file editing, MCP protocol support, subagents, and CI/CD integration\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">AI coding CLI</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/Harkirat1462/claude-code-cli\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-27</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/iam-veeramalla/AI-DevOps-Kubernetes-Agent\" target=\"_blank\" rel=\"noopener\">AI-DevOps-Kubernetes-Agent</a>\n                        </div>\n                        <div class=\"product-description\">\n                            AI DevOps Kubernetes Agent for automation and management\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">DevOps agent</span>\n                            <span class=\"source-tag\"><a href=\"https://github.com/iam-veeramalla/AI-DevOps-Kubernetes-Agent\" target=\"_blank\" rel=\"noopener\">GitHub</a></span>\n                            <span class=\"release-date\">📅 2026-05-26</span>\n                        </div>\n                    </div>\n\n                </div>\n            </section>\n\n            <!-- Whitelist Updates Section -->\n            <section class=\"whitelist-updates\">\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span>Whitelist Updates</span>\n                        <span class=\"count\">0</span>\n                    </div>\n                    <div class=\"empty-state\">\n                        <div class=\"icon\">📭</div>\n                        <div>No updates found for tracked products</div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Technical Insights Section -->\n            <section class=\"technical-insights\">\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span>Technical Insights</span>\n                        <span class=\"count\">0</span>\n                    </div>\n                    <div class=\"empty-state\">\n                        <div class=\"icon\">💭</div>\n                        <div>No new insights gathered</div>\n                    </div>\n                </div>\n            </section>\n        </main>\n\n        <!-- Additional Products (Continued) -->\n        <div style=\"margin-top: 15px;\">\n            <div class=\"section\">\n                <div class=\"section-header\">\n                    <span>More New Products (Continued)</span>\n                    <span class=\"count\">16</span>\n                </div>\n\n                <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 15px;\">\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/franklioxygen/agent-workflows\" target=\"_blank\" rel=\"noopener\">agent-workflows</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Engineering workflows for AI coding agents or flesh engineers. It helps absorb silent base-model quality drift.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">workflow agent</span>\n                            <span class=\"release-date\">📅 2026-05-26</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/HuckleR2003/hck-GPT\" target=\"_blank\" rel=\"noopener\">hck-GPT</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Local AI diagnostic assistant for Windows PC monitoring. 76 intents, hybrid rule and LLM engine, bilingual PL/EN, context time-windowing, anti-hallucination fallback, and time-travel debugging.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">debugging tool</span>\n                            <span class=\"release-date\">📅 2026-05-26</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/SynapCores/synapcores-agent\" target=\"_blank\" rel=\"noopener\">synapcores-agent</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Framework-free AI support agent where SynapCores is the brain — memory, RAG, tool routing, generation in one database. Browser chat widget + live Brain debug sidebar.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">code agent</span>\n                            <span class=\"release-date\">📅 2026-05-26</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/rdianbianhua/AICapture\" target=\"_blank\" rel=\"noopener\">AICapture</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Desktop network capture, protocol inspection, request debugging, and MCP tool integration app.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">workflow agent</span>\n                            <span class=\"release-date\">📅 2026-05-25</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/ericfly02/realbrain\" target=\"_blank\" rel=\"noopener\">realbrain</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Local-first operating memory, evidence graph, global workspace, and safe consolidation for AI agents\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">code agent</span>\n                            <span class=\"release-date\">📅 2026-05-25</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/magicmadeint/wipedown\" target=\"_blank\" rel=\"noopener\">wipedown</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Zero-Trust Semantic Scraper & Firewall Proxy for AI Coding Agents. Intercepts and neutralizes web-scraped prompt injections locally before they hit your terminal window.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">AI coding CLI</span>\n                            <span class=\"release-date\">📅 2026-05-25</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/DanielLetto2020/LiteEditorAI\" target=\"_blank\" rel=\"noopener\">LiteEditorAI</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Lightweight editor for the AI agent era: terminal in center, code/tree/git nearby. Chat with models via OpenRouter (BYOK), multi-tabs, 6 themes. Linux + Windows.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">AI IDE</span>\n                            <span class=\"release-date\">📅 2026-05-26</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/MADHURIMAPANIGRAHI/LinkIDE\" target=\"_blank\" rel=\"noopener\">LinkIDE</a>\n                        </div>\n                        <div class=\"product-description\">\n                            A production-grade, multi-server collaborative IDE featuring zero-collision real-time sync via WebSockets, an inline AI assistant powered by Gemini streams, and automated user session management via NextAuth and MongoDB Atlas.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">AI IDE</span>\n                            <span class=\"release-date\">📅 2026-05-26</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/Daaaaave/agentic-workspace-core\" target=\"_blank\" rel=\"noopener\">agentic-workspace-core</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Portable repository-native foundation for agent memory, skills, handoffs, and knowledge workflows.\n                        </div>\n                        <div class=\"product-meta\">\n                            <span class=\"category-tag\">code agent</span>\n                            <span class=\"release-date\">📅 2026-05-23</span>\n                        </div>\n                    </div>\n\n                    <div class=\"product-item\">\n                        <div class=\"product-name\">\n                            <a href=\"https://github.com/Abid109/Apex-IDE-26\" target=\"_blank\" rel=\"noopener\">Apex Architect IDE</a>\n                        </div>\n                        <div class=\"product-description\">\n                            Apex Architect IDE is a multi-language, web-based development environment featuring a built-in code editor, live web prev