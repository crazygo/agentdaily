  "content": "[\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Version 3.2.16: Security Review, SDK for Programmatic Agents, Canvas, Multitasking\",\n    \"description\": \"April 29, 2026 release introduces Security Review beta for teams/enterprise with Security Reviewer and Vulnerability Scanner agents. Launches Cursor SDK for building programmatic agents with TypeScript. Adds Canvas for interactive visualizations, multitasking with async sub-agents, improved worktrees, and multi-root workspace support.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-29\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 2.1.32: Bug Fixes & Improvements\",\n    \"description\": \"April 29, 2026 release fixes crashes when switching Cascade conversations, authentication issues preventing Devin Cloud sessions from starting, and agent question response delivery problems.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-04-29\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 2.1.29: Devin for Terminal & Devin Agent in Windsurf\",\n    \"description\": \"April 28, 2026 release introduces Devin for Terminal - a CLI agent optimized for interactive work with full codebase access. Includes seamless handoff to Devin cloud, multi-model support (Opus 4.7, GPT-5.5, SWE-1.6), and Rust-based performance. Adds Devin Local agent in Windsurf, up to 30% more token-efficient than Cascade.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-04-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Week 17: Ultrareview Public Preview, Session Recaps, Custom Themes\",\n    \"description\": \"Claude Code Week 17 release introduces /ultrareview public research preview for cloud-based bug-hunting agents, session recaps showing activity while terminal was unfocused, custom themes system, and a redesigned web experience with sessions sidebar and drag-and-drop layout.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://releasebot.io/updates/anthropic/claude-code\",\n    \"date\": \"2026-04-27\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"GPT-5.5 Available\",\n    \"description\": \"April 24, 2026 announcement: GPT-5.5 model is now available in Windsurf.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-04-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Week 16: Opus 4.7 Default, xhigh Effort, Cloud Routines, Native CLI Binaries\",\n    \"description\": \"Claude Opus 4.7 becomes default on Max and Team Premium tiers with new 'xhigh' effort level. Also introduces cloud routines for automated agents, /ultrareview parallel code review, /usage tracking, and migration to native CLI binaries for improved performance.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://releasebot.io/updates/anthropic/claude-code\",\n    \"date\": \"2026-04-20\",\n    \"community_feedback\": []\n  }\n]\n"
