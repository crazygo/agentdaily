  "old_string": "[\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Enterprise Features and MCP Connectors\",\n    \"description\": \"Added session folders, !ultra and !fast Slack commands, enterprise snapshot build schedules, and 48+ new MCP connectors including Miro, Mixpanel, Honeycomb, Postman. Classic environment setup deprecated in favor of declarative configuration.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/2026\",\n    \"date\": \"2026-06-30\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Week 26 Updates - MCP Commands and Shell Mode Improvements\",\n    \"description\": \"Added MCP login/logout commands for shell-based authentication, shell mode improvements with automatic responses to command output, /rewind command to resume conversations from before /clear, and improved background subagent permission prompts.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-06-26\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Serious performance degradation and quality regressions reported by users\",\n        \"source\": \"Community feedback\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Can no longer in good conscience recommend Claude Code\",\n        \"source\": \"Community feedback\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Version 3.9 - Major Platform Update with Mobile App\",\n    \"description\": \"Cursor Mobile App for iOS in public beta, custom plugins/skills/MCP integration with new Customize page, enhanced Cursor Automations with /automate skill and GitHub triggers, cloud environment setup with snapshot support, and Bugbot performance improvements (3x faster, 22% cheaper, finds 10% more bugs).\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-06-22\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Windsurf/Devin Desktop Bug Fixes and Enhancements\",\n    \"description\": \"Enhanced in-IDE search functionality and new Mac icons, updated bundled Devin Local agent to version 2026.5.26. Cognition rebranded Windsurf into Devin Desktop as a multi-agent command center with Agent Client Protocol (ACP) support.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-06-18\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Acquired by Cursor\",\n    \"description\": \"Continue.dev was acquired by Cursor. Website displays notice stating Continue has been acquired by Cursor with commitment to ensuring developers are amplified, not automated.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://www.continue.dev/\",\n    \"date\": \"2026-06-18\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Version 2.0.0 - Major Stable Release\",\n    \"description\": \"Major stable release of Continue VS Code extension, marking significant version upgrade from v1.x to v2.0.0.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/continuedev/continue/releases/tag/v2.0.0-vscode\",\n    \"date\": \"2026-06-19\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Version 2.1.0 - Pre-release\",\n    \"description\": \"Pre-release version as follow-up to major v2.0.0 release.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/continuedev/continue/releases/\",\n    \"date\": \"2026-06-19\",\n    \"community_feedback\": []\n  }\n]",
