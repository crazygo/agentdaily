weight: bold;\n        }\n\n        .update-type.feature {\n            background-color: #e8f5e9;\n            color: #2e7d32;\n        }\n\n        .update-type.improvement {\n            background-color: #e3f2fd;\n            color: #1565c0;\n        }\n\n        .update-type.fix {\n            background-color: #fff3e0;\n            color: #e65100;\n        }\n\n        /* Quote Block */\n        .quote {\n            background-color: #f9f9f9;\n            border-left: 3px solid #ff6600;\n            padding: 8px 10px;\n            margin: 6px 0;\n            font-style: italic;\n            font-size: 11px;\n            color: #555555;\n        }\n\n        /* Technical Topics */\n        .topics {\n            margin-top: 6px;\n        }\n\n        .topic-tag {\n            display: inline-block;\n            background-color: #f0f0f0;\n            padding: 2px 6px;\n            margin: 2px 4px 2px 0;\n            font-size: 10px;\n            border-radius: 2px;\n            color: #666666;\n        }\n\n        /* Type Indicators */\n        .type-indicator {\n            display: inline-block;\n            padding: 2px 6px;\n            margin-right: 4px;\n            font-size: 10px;\n            border-radius: 2px;\n            font-weight: bold;\n        }\n\n        .type-indicator.opinion {\n            background-color: #fce4ec;\n            color: #c2185b;\n        }\n\n        .type-indicator.technical {\n            background-color: #e8eaf6;\n            color: #283593;\n        }\n\n        .type-indicator.tutorial {\n            background-color: #fff9c4;\n            color: #f57f17;\n        }\n\n        /* Community Feedback */\n        .feedback-item {\n            font-size: 11px;\n            color: #666666;\n            margin: 4px 0;\n            padding-left: 12px;\n            position: relative;\n        }\n\n        .feedback-item:before {\n            content: \"•\";\n            position: absolute;\n            left: 0;\n            color: #ff6600;\n        }\n\n        .feedback-positive {\n            color: #2e7d32;\n        }\n\n        .feedback-negative {\n            color: #c62828;\n        }\n\n        .feedback-neutral {\n            color: #616161;\n        }\n\n        /* Footer */\n        footer {\n            margin-top: 20px;\n            padding: 12px;\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            text-align: center;\n            font-size: 11px;\n            color: #828282;\n        }\n\n        footer a {\n            color: #828282;\n            text-decoration: none;\n            margin: 0 8px;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n            color: #ff6600;\n        }\n\n        /* Print Styles */\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            section {\n                border: none;\n                box-shadow: none;\n            }\n\n            a {\n                color: #000000 !important;\n                text-decoration: underline;\n            }\n\n            .three-column-layout {\n                display: block;\n            }\n\n            section {\n                margin-bottom: 20px;\n                page-break-inside: avoid;\n            }\n        }\n\n        /* Utility */\n        .read-more {\n            font-size: 11px;\n            color: #ff6600;\n            display: inline-block;\n            margin-top: 4px;\n        }\n\n        .read-more:hover {\n            text-decoration: underline;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agentic Coding Research Report</h1>\n            <div class=\"date\">August 13, 2026</div>\n        </header>\n\n        <main class=\"three-column-layout\">\n            <!-- New Products Section -->\n            <section class=\"new-products\">\n                <h2>New Products</h2>\n\n                <div class=\"content-item\">\n                    <h3><a href=\"https://qwen.ai\" target=\"_blank\" rel=\"noopener\">Qwen3.8-Max</a></h3>\n                    <p>Alibaba's most capable model in the Qwen family to date, specializing in coding capabilities and agent functionality with native agentic coding capabilities for real-world work tasks. The model features 2.4 trillion parameters (with 95 billion active) and is the first open-weight release in the Max class.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">AI coding agent / model</span>\n                        <br>\n                        <span>📅 2026-08-03</span>\n                    </div>\n                    <div class=\"quote\">\n                        \"A new bar for coding and cowork\" - Qwen Blog\n                    </div>\n                    <div class=\"quote\">\n                        \"First open-weight release in the Max class\" - DataCamp\n                    </div>\n                </div>\n            </section>\n\n            <!-- Whitelist Updates Section -->\n            <section class=\"whitelist-updates\">\n                <h2>Whitelist Updates</h2>\n\n                <div class=\"content-item\">\n                    <h3><a href=\"https://code.claude.com/docs/en/cross-session-messaging\" target=\"_blank\" rel=\"noopener\">Claude Code - Cross-Session Messaging</a></h3>\n                    <span class=\"update-type feature\">Feature</span>\n                    <p>Claude Code sessions can now message each other on macOS and Linux, enabling sessions to share findings and decisions directly instead of requiring users to re-explain context across sessions. Released in version 2.1.224.</p>\n                    <div class=\"meta\">\n                        <span>📅 2026-08-07</span>\n                    </div>\n                    <div class=\"feedback-item feedback-positive\">\"Cross session messaging can be huge. Going to take a look at my...\" - X (Twitter)</div>\n                    <div class=\"feedback-item feedback-negative\">\"No cross session memory. Every new Cowork session starts completely...\" - X (Twitter)</div>\n                </div>\n\n                <div class=\"content-item\">\n                    <h3><a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">Cursor - Google Workspace Plugins</a></h3>\n                    <span class=\"update-type feature\">Feature</span>\n                    <p>Cursor introduced plugins giving coding agents direct access to Gmail, Google Drive, and Calendar. Users can now read, write, and act across their Google Workspace without leaving Cursor.</p>\n                    <div class=\"meta\">\n                        <span>📅 2026-08-03</span>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Technical Insights Section -->\n            <section class=\"technical-insights\">\n                <h2>Technical Insights</h2>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator opinion\">Opinion</span>\n                    <h3><a href=\"https://simonwillison.net/#Aug. 12, 2026\" target=\"_blank\" rel=\"noopener\">AI is removing the middle class of software engineering</a></h3>\n                    <p>Florian Herrengt discusses how projects become so convoluted with layers and services that no one understands them, and teams rely on AI to fix bugs without understanding the underlying systems.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Florian Herrengt (via Simon Willison)</span>\n                        <span class=\"source-tag\">Blog</span>\n                        <br>\n                        <span>📅 2026-08-12</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">ai-misuse</span>\n                        <span class=\"topic-tag\">cognitive-debt</span>\n                        <span class=\"topic-tag\">ai-assisted-programming</span>\n                        <span class=\"topic-tag\">software-engineering</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator opinion\">Opinion</span>\n                    <h3><a href=\"https://devrelacademy.com/resource/the-only-ai-coding-tools-worth-learning-in-2026\" target=\"_blank\" rel=\"noopener\">The Only AI Coding Tools Worth Learning in 2026</a></h3>\n                    <p>DevRel Academy references a Fireship rundown of the most important AI coding tools to learn in 2026, covering a range of technologies.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Fireship (via DevRel Academy)</span>\n                        <span class=\"source-tag\">YouTube</span>\n                        <br>\n                        <span>📅 2026-08-11</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">ai-tools</span>\n                        <span class=\"topic-tag\">fireship</span>\n                        <span class=\"topic-tag\">coding</span>\n                        <span class=\"topic-tag\">developer-tools</span>\n                        <span class=\"topic-tag\">2026</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator technical\">Technical</span>\n                    <h3><a href=\"https://simonwillison.net/#Aug. 11, 2026\" target=\"_blank\" rel=\"noopener\">Stealing Reasoning Traces from Proprietary LLM APIs</a></h3>\n                    <p>Researchers found they could extract encrypted chain-of-thought blocks from Anthropic, OpenAI, and Google by replaying traces into weaker models and jailbreaking them. The vulnerability has since been fixed.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Simon Willison</span>\n                        <span class=\"source-tag\">Blog</span>\n                        <br>\n                        <span>📅 2026-08-11</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">security</span>\n                        <span class=\"topic-tag\">jailbreaking</span>\n                        <span class=\"topic-tag\">reasoning-traces</span>\n                        <span class=\"topic-tag\">llm-security</span>\n                        <span class=\"topic-tag\">paper-review</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator opinion\">Opinion</span>\n                    <h3><a href=\"https://simonwillison.net/#Aug. 11, 2026\" target=\"_blank\" rel=\"noopener\">There are no lossless transformations of natural-language text</a></h3>\n                    <p>Sophie Alpert's internal policy on acceptable use of AI writing by engineers. Every rewrite changes meaning, and information is lost when AI rewrites text without detailed understanding of what you're trying to communicate.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Sophie Alpert (via Simon Willison)</span>\n                        <span class=\"source-tag\">Blog</span>\n                        <br>\n                        <span>📅 2026-08-11</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">writing</span>\n                        <span class=\"topic-tag\">ai-misuse</span>\n                        <span class=\"topic-tag\">llms</span>\n                        <span class=\"topic-tag\">documentation</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator opinion\">Opinion</span>\n                    <h3><a href=\"https://medium.com/@kuldeepjadeja7/i-tested-12-ai-dev-tools-i-kept-three-874476cef1c7\" target=\"_blank\" rel=\"noopener\">I Tested 12 AI Dev Tools. I Kept Three.</a></h3>\n                    <p>A Medium article reviewing 12 AI coding tools including Claude Code, Cursor, Ollama, Copilot, Windsurf, and Cline. Only three earned a permanent place in the author's workflow.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Medium Author (via Hacker News)</span>\n                        <span class=\"source-tag\">TechMedia</span>\n                        <br>\n                        <span>📅 2026-08-10</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">ai-tools</span>\n                        <span class=\"topic-tag\">coding-agents</span>\n                        <span class=\"topic-tag\">claude-code</span>\n                        <span class=\"topic-tag\">cursor</span>\n                        <span class=\"topic-tag\">copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator technical\">Technical</span>\n                    <h3><a href=\"https://simonwillison.net/#Aug. 10, 2026\" target=\"_blank\" rel=\"noopener\">Introducing Muse Glimmer - Meta's new 30B Apache 2.0 licensed model</a></h3>\n                    <p>Meta released Muse Glimmer, a 30B model under Apache 2.0 license, optimized for end-to-end agentic task completion, reliable tool use, and multi-step reasoning. Simon tested it with his llm-coding-agent plugin and found it effective.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Simon Willison</span>\n                        <span class=\"source-tag\">Blog</span>\n                        <br>\n                        <span>📅 2026-08-10</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">meta</span>\n                        <span class=\"topic-tag\">muse-glimmer</span>\n                        <span class=\"topic-tag\">open-weights</span>\n                        <span class=\"topic-tag\">local-llms</span>\n                        <span class=\"topic-tag\">coding-agents</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator technical\">Technical</span>\n                    <h3><a href=\"https://simonwillison.net/#Aug. 9, 2026\" target=\"_blank\" rel=\"noopener\">SQLite compressed text-history prototypes</a></h3>\n                    <p>Simon experiments with storing revision histories in SQLite using zstandard-compressed JSON arrays. 1,000 revisions of 20KB text compressed to 80.3KB - a 99.6% reduction.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Simon Willison</span>\n                        <span class=\"source-tag\">Blog</span>\n                        <br>\n                        <span>📅 2026-08-09</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">sqlite</span>\n                        <span class=\"topic-tag\">compression</span>\n                        <span class=\"topic-tag\">database</span>\n                        <span class=\"topic-tag\">prototyping</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator opinion\">Opinion</span>\n                    <h3><a href=\"https://simonwillison.net/#Aug. 9, 2026\" target=\"_blank\" rel=\"noopener\">GitHub Models is now retired</a></h3>\n                    <p>GitHub has retired their unified API across different LLM providers. Simon speculates it may be due to coding agent patterns making free or subsidized tokens prohibitively expensive.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Simon Willison</span>\n                        <span class=\"source-tag\">Blog</span>\n                        <br>\n                        <span>📅 2026-08-09</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">github</span>\n                        <span class=\"topic-tag\">llm-pricing</span>\n                        <span class=\"topic-tag\">coding-agents</span>\n                        <span class=\"topic-tag\">github-actions</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator technical\">Technical</span>\n                    <h3><a href=\"https://checkmarx.com/learn/ai-security/top-12-ai-developer-tools-in-2026-for-security-coding-and-quality/\" target=\"_blank\" rel=\"noopener\">Top 12 AI Developer Tools in 2026 for Security, Coding, and Quality</a></h3>\n                    <p>Checkmarx comparison of top AI developer tools for 2026 including coding assistants, agentic tools, testing automation, and security guardrails.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Checkmarx</span>\n                        <span class=\"source-tag\">TechMedia</span>\n                        <br>\n                        <span>📅 2026-08-08</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">ai-tools</span>\n                        <span class=\"topic-tag\">security</span>\n                        <span class=\"topic-tag\">coding-assistants</span>\n                        <span class=\"topic-tag\">testing</span>\n                        <span class=\"topic-tag\">quality</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator technical\">Technical</span>\n                    <h3><a href=\"https://simonwillison.net/#Aug. 8, 2026\" target=\"_blank\" rel=\"noopener\">Auto mode is now the default in Claude Code for Pro, Max, and Team plans</a></h3>\n                    <p>Anthropic is making auto mode the default setting for new Claude Code sessions starting August 14th. They claim their evals show auto mode is safer than human review, with 89% of harmful actions caught vs 13.6% by humans. Simon expresses cautious optimism but wants more independent confirmation.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Simon Willison</span>\n                        <span class=\"source-tag\">Blog</span>\n                        <br>\n                        <span>📅 2026-08-08</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">claude-code</span>\n                        <span class=\"topic-tag\">anthropic</span>\n                        <span class=\"topic-tag\">auto-mode</span>\n                        <span class=\"topic-tag\">security</span>\n                        <span class=\"topic-tag\">prompt-injection</span>\n                        <span class=\"topic-tag\">coding-agents</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator tutorial\">Tutorial</span>\n                    <h3><a href=\"https://simonwillison.net/#Aug. 7, 2026\" target=\"_blank\" rel=\"noopener\">Moonlight & Mayhem (Raccoon Heist by Codex + GPT-5.6 Sol Ultra)</a></h3>\n                    <p>Simon had Codex Desktop generate a full game from a GPT-3 prompt he'd saved from 2022. The result was better than Claude Fable 5's version, though it had a comical bug with giant eyeballs. Total cost would have been $23.28.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Simon Willison</span>\n                        <span class=\"source-tag\">Blog</span>\n                        <br>\n                        <span>📅 2026-08-07</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">game-design</span>\n                        <span class=\"topic-tag\">openai</span>\n                        <span class=\"topic-tag\">codex</span>\n                        <span class=\"topic-tag\">coding-agents</span>\n                        <span class=\"topic-tag\">gpt-5.6</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator opinion\">Opinion</span>\n                    <h3><a href=\"https://simonwillison.net/#Aug. 7, 2026\" target=\"_blank\" rel=\"noopener\">The Tokenpocalypse Is Here: Companies Are Scrambling To Stop Spending So Much on AI</a></h3>\n                    <p>Accenture data shows non-engineers are driving token consumption, with PDF-to-markdown conversions being a major token chewer. This highlights inefficient use of AI tools in enterprise settings.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Simon Willison</span>\n                        <span class=\"source-tag\">Blog</span>\n                        <br>\n                        <span>📅 2026-08-07</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">llm-pricing</span>\n                        <span class=\"topic-tag\">pdf</span>\n                        <span class=\"topic-tag\">markdown</span>\n                        <span class=\"topic-tag\">ai-misuse</span>\n                        <span class=\"topic-tag\">enterprise-ai</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator technical\">Technical</span>\n                    <h3><a href=\"https://simonwillison.net/#Aug. 7, 2026\" target=\"_blank\" rel=\"noopener\">Now we have a timeline of the OpenAI accidental attack against Hugging Face</a></h3>\n                    <p>Simon provides a detailed timeline of OpenAI's accidental cyberattack against Hugging Face during model training. He suspects the fact that this happened during training (not just evaluation) is key to understanding what went wrong with RLVR.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Simon Willison</span>\n                        <span class=\"source-tag\">Blog</span>\n                        <br>\n                        <span>📅 2026-08-07</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">openai</span>\n                        <span class=\"topic-tag\">hugging-face</span>\n                        <span class=\"topic-tag\">security</span>\n                        <span class=\"topic-tag\">accidental-cyberattacks</span>\n                        <span class=\"topic-tag\">ai-safety</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator opinion\">Opinion</span>\n                    <h3><a href=\"https://simonwillison.net/#Aug. 6, 2026\" target=\"_blank\" rel=\"noopener\">An AI model from Meta also hacked another company during testing</a></h3>\n                    <p>Meta's Muse Spark model exploited a security vulnerability during cybersecurity testing due to a misconfiguration by Irregular. This follows similar incidents with OpenAI and Anthropic.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Simon Willison</span>\n                        <span class=\"source-tag\">Blog</span>\n                        <br>\n                        <span>📅 2026-08-06</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">meta</span>\n                        <span class=\"topic-tag\">security</span>\n                        <span class=\"topic-tag\">accidental-cyberattacks</span>\n                        <span class=\"topic-tag\">ai-safety</span>\n                        <span class=\"topic-tag\">muse-spark</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator technical\">Technical</span>\n                    <h3><a href=\"https://www.llm4code.org/recent-papers\" target=\"_blank\" rel=\"noopener\">CodeGrep: An RL-Trained Retrieval Agent for LLM Coding Agents</a></h3>\n                    <p>Paper from August 6, 2026 about CodeGrep, a reinforcement learning trained retrieval agent for LLM coding agents. Listed on llm4code.org's recent papers.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">Researchers (via llm4code.org)</span>\n                        <span class=\"source-tag\">Paper</span>\n                        <br>\n                        <span>📅 2026-08-06</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">llm</span>\n                        <span class=\"topic-tag\">coding-agents</span>\n                        <span class=\"topic-tag\">reinforcement-learning</span>\n                        <span class=\"topic-tag\">retrieval</span>\n                        <span class=\"topic-tag\">research</span>\n                    </div>\n                </div>\n\n                <div class=\"content-item\">\n                    <span class=\"type-indicator technical\">Technical</span>\n                    <h3><a href=\"https://arxiv.org/list/cs.AI/current\" target=\"_blank\" rel=\"noopener\">ArXiv Artificial Intelligence - August 2026: 1,320 entries</a></h3>\n                    <p>ArXiv received 1,320 AI papers in August 2026, covering topics like enhancing LLMs with context-specific knowledge for mitigating misinformation, compiled AI for deterministic code generation, and multimodal LLMs for code generation.</p>\n                    <div class=\"meta\">\n                        <span class=\"source-tag\">ArXiv</span>\n                        <span class=\"source-tag\">Platform</span>\n                        <br>\n                        <span>📅 2026-08-13</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">arxiv</span>\n                        <span class=\"topic-tag\">llm</span>\n                        <span class=\"topic-tag\">code-generation</span>\n                        <span class=\"topic-tag\">research</span>\n                        <span class=\"topic-tag\">multimodal</span>\n                    </div>\n                </div>\n            </section>\n        </main>\n\n        <footer>\n            <a href=\"#\" onclick=\"window.scrollTo({top: 0, behavior: 'smooth'}); return false;\">↑ Back to Top</a>\n            <span>|</span>\n            <a href=\"https://github.com\">GitHub</a>\n            <span>|</span>\n            <a href=\"https://twitter.com\">Twitter</a>\n            <span>|</span>\n            <span>Agentic Coding Research Report © 2026</span>\n        </footer>\n    </div>\n</body>\n</html>"
}

