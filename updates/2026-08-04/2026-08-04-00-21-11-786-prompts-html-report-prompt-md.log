t {\n                grid-template-columns: 1fr 1fr;\n            }\n\n            .technical-insights {\n                grid-column: 1 / -1;\n                border-top: 1px solid #d4d4d4;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .main-content {\n                grid-template-columns: 1fr;\n            }\n\n            .column {\n                border-right: none;\n                border-bottom: 1px solid #d4d4d4;\n            }\n\n            .column:last-child {\n                border-bottom: none;\n            }\n\n            .technical-insights {\n                border-top: none;\n            }\n        }\n\n        /* Print Styles */\n        @media print {\n            body {\n                background-color: #ffffff;\n                padding: 0;\n            }\n\n            .container {\n                border: none;\n            }\n\n            .column {\n                break-inside: avoid;\n            }\n\n            .item {\n                break-inside: avoid;\n            }\n        }\n\n        /* Hover Effects */\n        .item:hover {\n            background-color: #fafafa;\n        }\n\n        .item-title a {\n            transition: color 0.2s ease;\n        }\n\n        .item-title a:visited {\n            color: #828282;\n        }\n\n        .category:hover {\n            background-color: #e0e0e0;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <div class=\"header-content\">\n                <h1>🤖 Agentic Coding Research Report</h1>\n                <span class=\"date\">2026-08-04</span>\n            </div>\n        </header>\n\n        <main class=\"main-content\">\n            <!-- New Products Section (40%) -->\n            <section class=\"new-products column\">\n                <h2 class=\"section-header\">New Products</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <