    "originalFile": "[\n  {\n    \"name\": \"sigbound\",\n    \"url\": \"https://github.com/surya-koritala/sigbound\",\n    \"description\": \"Run AI coding agents in parallel on one git repo and safely auto-merge their work — only changes that build and pass tests land. On top of plain git; bring your own model.\",\n    \"release_date\": \"2026-07-21\",\n    \"category\": \"workflow orchestration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"compass\",\n    \"url\": \"https://github.com/crabbuild/compass\",\n    \"description\": \"Native, local-first knowledge graph engine for code and project artifacts—inspired by Graphify, built in Rust.\",\n    \"release_date\": \"2026-07-22\",\n    \"category\": \"workspace memory\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"approving\",\n    \"url\": \"https://github.com/cocofhu/approving\",\n    \"description\": \"Open-source, self-hostable platform for turning coding agents into visual, reviewable, and recoverable delivery workflows. Agents run in real Docker sandboxes, exchange structured artifacts, and pause for human approval.\",\n    \"release_date\": \"2026-07-24\",\n    \"category\": \"workflow orchestration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"cursor-bridge\",\n    \"url\": \"https://github.com/hkc5/cursor-bridge\",\n    \"description\": \"Claude Code that runs on your Cursor subscription. One Rust binary, zero config.\",\n    \"release_date\": \"2026-07-26\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"ywcrew\",\n    \"url\": \"https://github.com/yuwen-cool/ywcrew\",\n    \"description\": \"让AI智能体们组成一个团队：在任意宿主里把任务派给本地订阅的 Claude Code / Codex / Grok / Kimi / Antigravity，并行、不打断对话、全走已有订阅。\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"workflow orchestration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"codian\",\n    \"url\": \"https://github.com/BCS1037/codian\",\n    \"description\": \"Open-source Obsidian plugin for local coding agents\",\n    \"release_date\": \"2026-07-23\",\n    \"category\": \"IDE integration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"pi-agent-desktop\",\n    \"url\": \"https://github.com/abcwyc/pi-agent-desktop\",\n    \"description\": \"Pi — A cross-platform AI coding agent, bringing the Claude Code experience to your desktop. No environment setup, no terminal commands.\",\n    \"release_date\": \"2026-07-22\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Drift\",\n    \"url\": \"https://github.com/kylepelham/Drift\",\n    \"description\": \"Desktop AI coding agent for Windows, powered by the OpenCode engine\",\n    \"release_date\": \"2026-07-24\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"claude-sessions-dashboard\",\n    \"url\": \"https://github.com/wannabemrrobot/claude-sessions-dashboard\",\n    \"description\": \"A live, local dashboard to browse, search, resume & manage every Claude Code session on your machine — full conversation transcripts, artifacts view, and usage stats. Pure Python stdlib, no dependencies.\",\n    \"release_date\": \"2026-07-24\",\n    \"category\": \"workspace memory\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"MindFlock\",\n    \"url\": \"https://github.com/MindFlock/MindFlock\",\n    \"description\": \"Run a flock of AI coding agents, each in its own git worktree, started by your ticket queue, merged by you. Integrates with Jira, Linear, GitHub Issues, Shortcut, Asana.\",\n    \"release_date\": \"2026-07-24\",\n    \"category\": \"workflow orchestration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"pi2.nvim\",\n    \"url\": \"https://github.com/zgs225/pi2.nvim\",\n    \"description\": \"Use the pi coding agent (pi.dev) without leaving Neovim — π², a heavily extended fork of alex35mil/pi.nvim\",\n    \"release_date\": \"2026-07-26\",\n    \"category\": \"IDE integration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"multiplayer-ai\",\n    \"url\": \"https://github.com/godfaddaai/multiplayer-ai\",\n    \"description\": \"Make Codex and Claude Code sessions multiplayer from the terminal.\",\n    \"release_date\": \"2026-08-02\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"harnt.nvim\",\n    \"url\": \"https://github.com/PieterPel/harnt.nvim\",\n    \"description\": \"Drive any native-TUI coding agent in Neovim at full fidelity via reverse-MCP.\",\n    \"release_date\": \"2026-07-24\",\n    \"category\": \"IDE integration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"agentacct\",\n    \"url\": \"https://github.com/mikehasa/agentacct\",\n    \"description\": \"See what your coding agents did and what it cost. Breaks each task down into work steps — tools used, files changed, tests run, time and tokens spent. Local-first dashboard for Claude Code, Codex, OpenCode.\",\n    \"release_date\": \"2026-07-24\",\n    \"category\": \"workflow orchestration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"LongHorizon-Harness\",\n    \"url\": \"https://github.com/AMAP-ML/LongHorizon-Harness\",\n    \"description\": \"The long-horizon computer-use harness. Run AI agents across desktop apps and the CLI for extended periods while preserving task state and making reliable progress on complex workflows. Integrates with Claude Code / Codex / OpenClaw.\",\n    \"release_date\": \"2026-08-04\",\n    \"category\": \"workflow orchestration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Vigla\",\n    \"url\": \"https://github.com/Kilbex/Vigla\",\n    \"description\": \"Open-source mission control for coding agents. Run cross-vendor workers in isolated worktrees, audit every submission, and revert an entire mission.\",\n    \"release_date\": \"2026-07-21\",\n    \"category\": \"workflow orchestration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Trajex\",\n    \"url\": \"https://github.com/wutongyuonce/Trajex\",\n    \"description\": \"数万行散落的 Claude Code、Codex 与 Pi JSONL 会话，索引至同一个 SQLite 中：Agent 可通过 CLI 实现毫秒级查询，用户可通过 App 直观浏览\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"workspace memory\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"cairn-git-client-app\",\n    \"url\": \"https://github.com/carterztbjfisher3942/cairn-git-client-app\",\n    \"description\": \"Cairn v0.6.39 is a cross-platform desktop Git client combining repository administration, terminal-based work, and AI coding-agent workflows in one application.\",\n    \"release_date\": \"2026-08-01\",\n    \"category\": \"workflow orchestration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"ops-engineering-skills\",\n    \"url\": \"https://github.com/selvarajmurugesan90/ops-engineering-skills\",\n    \"description\": \"Open-source, cross-agent Agent Skills for DevOps, DevSecOps, Cloud, Kubernetes/platform engineering, CI/CD tooling. Use in Claude Code, GitHub Copilot, OpenAI Codex, Cursor and Gemini CLI.\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"workflow orchestration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"grok-build-desktop\",\n    \"url\": \"https://github.com/Jane-o-O-o-O/grok-build-desktop\",\n    \"description\": \"Grok B