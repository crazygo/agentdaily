ub\"],\n    63→    \"community_quotes\": []\n    64→  },\n    65→  {\n    66→    \"name\": \"Terminator\",\n    67→    \"url\": \"https://github.com/iris-networks/terminator\",\n    68→    \"description\": \"A completely free opensource alternative to manus, openhands and cua. Multi-agent AI platform for code execution, research, and browser automation with standalone binary deployment.\",\n    69→    \"release_date\": \"2025-07-27\",\n    70→    \"category\": \"code agent\",\n    71→    \"sources\": [\"GitHub\"],\n    72→    \"community_quotes\": []\n    73→  },\n    74→  {\n    75→    \"name\": \"Deadend CLI\",\n    76→    \"url\": \"https://github.com/straylabs-ai/deadend-cli\",\n    77→    \"description\": \"Agentic pentest tooling achieving 81% on XBOW's benchmark in full black-box. Completely self-hosted with support for every model available on LiteLLM (Ollama, Anthropic, OpenAI, etc.). Autonomous web application penetration testing agent using feedback-driven iteration.\",\n    78→    \"release_date\": \"2025-07-22\",\n    79→    \"category\": \"code agent\",\n    80→    \"sources\": [\"GitHub\"],\n    81→    \"community_quotes\": []\n    82→  },\n    83→  {\n    84→    \"name\": \"Hcom\",\n    85→    \"url\": \"https://github.com/aannoo/hcom\",\n    86→    \"description\": \"CLI tool that enables AI coding agents to communicate, watch, and spawn each other across terminals. Single Rust binary with no background services. Supports Claude Code, Gemini CLI, Codex CLI, Antigravity CLI, Cursor CLI, OpenCode, Kilo, Pi, Kimi, and Copilot CLI.\",\n    87→    \"release_date\": \"2025-07-21\",\n    88→    \"category\": \"AI coding CLI\",\n    89→    \"sources\": [\"GitHub\"],\n    90→    \"community_quotes\": []\n    91→  },\n    92→  {\n    93→    \"name\": \"CC-Switch\",\n    94→    \"url\": \"https://github.com/farion1231/cc-switch\",\n    95→    \"description\": \"A cross-platform desktop All-in-One assistant for Claude Code, Codex, OpenCode, OpenClaw, Grok Build