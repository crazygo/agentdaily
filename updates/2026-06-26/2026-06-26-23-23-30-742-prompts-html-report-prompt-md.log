n            background-color: #f0f0f0;\n            color: #555555;\n            padding: 1px 5px;\n            font-size: 10px;\n            border-radius: 2px;\n        }\n\n        /* Footer */\n        footer {\n            background-color: #ffffff;\n            border-top: 1px solid #d4d4d4;\n            padding: 15px 0;\n            margin-top: 20px;\n        }\n\n        .footer-content {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            font-size: 12px;\n            color: #828282;\n        }\n\n        .footer-links {\n            display: flex;\n            gap: 15px;\n        }\n\n        .footer-links a {\n            color: #828282;\n        }\n\n        .footer-links a:hover {\n            color: #ff6600;\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1200px) {\n            .three-column-layout {\n                grid-template-columns: 45% 55%;\n            }\n\n            .technical-insights {\n                grid-column: 1 / -1;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .three-column-layout {\n                grid-template-columns: 1fr;\n                gap: 15px;\n            }\n\n            .header-content {\n                flex-direction: column;\n                gap: 10px;\n                text-align: center;\n            }\n\n            .nav-links {\n                justify-content: center;\n            }\n\n            .section {\n                padding: 12px;\n            }\n        }\n\n        /* Print Styles */\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            .section {\n                break-inside: avoid;\n                page-break-inside: avoid;\n            }\n\n            footer {\n                position: fixed;\n                bottom: 0;\n            }\n\n            a {\n                text-decoration: none;\n                color: #000000;\n            }\n        }\n\n        /* Hover Effects */\n        .item {\n            transition: background-color 0.15s ease;\n            border-radius: 2px;\n            padding-left: 10px;\n            margin-left: -10px;\n        }\n\n        .item:hover {\n            background-color: #f5f5f5;\n        }\n\n        /* Scrollbar Styling */\n        ::-webkit-scrollbar {\n            width: 8px;\n        }\n\n        ::-webkit-scrollbar-track {\n            background: #f1f1f1;\n        }\n\n        ::-webkit-scrollbar-thumb {\n            background: #888;\n            border-radius: 4px;\n        }\n\n        ::-webkit-scrollbar-thumb:hover {\n            background: #555;\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <div class=\"container\">\n            <div class=\"header-content\">\n                <div class=\"logo\">AgentDaily</div>\n                <nav class=\"nav-links\">\n                    <a href=\"#new\">new</a>\n                    <a href=\"#updates\">updates</a>\n                    <a href=\"#insights\">insights</a>\n                    <a href=\"#about\">about</a>\n                </nav>\n                <div style=\"font-size: 13px; font-weight: 600;\">2026-06-26</div>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"container\">\n        <div class=\"three-column-layout\">\n            <!-- New Products Section -->\n            <section class=\"section new-products\" id=\"new\">\n                <div class=\"section-header\">\n                    <h2 class=\"section-title\">New Products</h2>\n                    <span class=\"section-count\">4 items</span>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/leaderboard/daily/2026/6/24\" class=\"accent-link\" target=\"_blank\">Tencent EdgeOne Makers</a>\n                    </div>\n                    <div