rgin-right: 5px;\n            font-size: 8pt;\n            font-weight: bold;\n            border-radius: 2px;\n        }\n\n        .update-type.feature {\n            background-color: #ffebeb;\n            color: #cc0000;\n        }\n\n        .update-type.bugfix {\n            background-color: #e8f5e9;\n            color: #2e7d32;\n        }\n\n        .update-type.announcement {\n            background-color: #fff3e0;\n            color: #e65100;\n        }\n\n        .update-type.release {\n            background-color: #e3f2fd;\n            color: #1565c0;\n        }\n\n        /* Community Feedback */\n        .feedback {\n            margin-top: 5px;\n            padding: 5px;\n            background-color: #f6f6ef;\n            font-size: 8pt;\n            border-left: 2px solid #ff6600;\n        }\n\n        .feedback-quote {\n            font-style: italic;\n            color: #000000;\n        }\n\n        .feedback-source {\n            color: #828282;\n            margin-top: 2px;\n        }\n\n        /* Insight Types */\n        .insight-type {\n            display: inline-block;\n            padding: 2px 5px;\n            margin-right: 5px;\n            font-size: 8pt;\n            font-weight: bold;\n        }\n\n        .insight-type.technical {\n            background-color: #e3f2fd;\n            color: #1565c0;\n        }\n\n        .insight-type.opinion {\n            background-color: #fff3e0;\n            color: #e65100;\n        }\n\n        .insight-type.tutorial {\n            background-color: #e8f5e9;\n            color: #2e7d32;\n        }\n\n        .insight-type.discussion {\n            background-color: #f3e5f5;\n            color: #7b1fa2;\n        }\n\n        .topic {\n            display: inline-block;\n            background-color: #f6f6ef;\n            color: #828282;\n            padding: 2px 5px;\n            margin: 2px 2px 0 0;\n            font-size: 8pt;\n            border: 1px solid #d4d4d4;\n        }\n\n        /* 