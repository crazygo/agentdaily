l Insights Column (25%) -->\n            <section class=\"column\" id=\"technical-insights\">\n                <h2 class=\"column-header\">Technical Insights</h2>\n                <div class=\"no-data\">\n                    <div class=\"no-data-icon\">💡</div>\n                    <div class=\"no-data-text\">\n                        <strong>No insights available</strong><br>\n                        No technical insights were collected<br>\n                        in the last 7 days as of 2026-04-05.\n                    </div>\n                </div>\n            </section>\n        </main>\n\n        <footer>\n            <p>\n                Generated on 2026-04-05 ·\n                <a href=\"#\">About</a> ·\n                <a href=\"#\">Archive</a> ·\n                <a href=\"#\">RSS Feed</a>\n            </p>\n            <p style=\"margin-top: 5px;\">\n                Tracking AI coding agents, IDEs, and developer tools\n            </p>\n        </footer>\n    </div>\n</body>\n</html>"
