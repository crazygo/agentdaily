      "content": "[\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Claude Opus 4.8 Integration\",\n    \"description\": \"Claude Opus 4.8 was integrated into GitHub Copilot, marking a significant model update to the Claude family of AI models available in Copilot.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Version 0.134.0\",\n    \"description\": \"Added search across local conversation history, made --profile the primary profile selector, improved MCP setup with per-server environment targeting, made connector tool schemas more reliable, and let read-only MCP tools run concurrently.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-05-26\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Memory Improvements\",\n    \"description\": \"Enhanced Copilot Memory functionality with improved controls for data deletion, better scoping options, and new management features specifically for the Copilot CLI.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-26\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Version 0.133.0\",\n    \"description\": \"Goals now enabled by default with dedicated storage, codex remote-control runs as foreground command, permission profiles gained list APIs and inheritance, plugin discovery improvements, and extensions can observe more lifecycle events.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-05-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Version 0.43.0\",\n    \"description\": \"Surgical Code Edits with improved edit tool preference, Session Export and Import for portability, and Adaptive Token Estimation for more accurate content size estimation.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-05-22\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor 3.5 - Multi-Repo Automations\",\n    \"description\": \"Major update bringing team collaboration features including multi-repository automations and shared canvases for team artifact access.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-05-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor in Jira Integration\",\n    \"description\": \"Cursor is now available in Jira. Assign work items to Cursor or mention @Cursor in comments to kick off cloud agents.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-05-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Auto Model Selection in VS Code\",\n    \"description\": \"Enhanced auto model selection capability that routes users to the most appropriate model based on their specific coding task within VS Code.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Semantic Issue Search\",\n    \"description\": \"Introduced semantic search capabilities in Copilot Chat, allowing users to find and navigate issues more intelligently using natural language queries.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Version 0.132.0\",\n    \"description\": \"Python SDK now supports first-class authentication, Python turn APIs easier to use for text-only workflows, codex exec resume accepts --output-schema, TUI startup is faster, and remote executor registration can use standard Codex auth.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-05-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Version 0.131.0\",\n    \"description\": \"TUI now offers richer session controls and display, @ mentions search files/directories/plugins/skills in one picker, plugin workflows gained marketplace CLI commands, and remote workflows support daemon-managed codex remote-control.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-05-18\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Composer 2.5\",\n    \"description\": \"A substantial improvement in intelligence and behavior over Composer 2, better at sustained work on long-running tasks and follows complex instructions more reliably.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-05-18\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Composer 2.5 is my new default. It is fast, accurate, and actually cheap\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"around 80% of their work now uses Composer 2.5\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Composer 2.5 is still nowhere near SOTA models\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 2.3.9\",\n    \"description\": \"Fixed availability issues with swe-check model, improved terminal processing performance, restored conversation sharing, and repaired path resolution for Devin local agent on WSL.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-05-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"May 2026 Platform Updates\",\n    \"description\": \"Major platform updates including Platform Default Settings, Slack Channel Override, MCP OAuth Resource Parameter, Custom RRULE Schedule Input, GitLab Interactive PR Review, PR Review Status API, In-App Support Dialog, and many more enterprise features and improvements.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/2026\",\n    \"date\": \"2026-05-15\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Where did Devin go? What does it say about the future of AI dev tools?\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Devin's code quality was poor and it took longer than a human developer\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Devin is unusable for those without deep knowledge of the codebase\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Version 0.86.0\",\n    \"description\": \"Added support for all GPT-5 models, Grok-4, gemini-2.5-flash-lite-preview-06-17, and openrouter/moonshotai/kimi-k2 model. Improved /clear and /undo commands, fixed settings replacement and analytics.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/Aider-AI/aider/releases\",\n    \"date\": \"2026-05-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Version 0.42.0\",\n    \"description\": \"Auto Memory Inbox with new inbox flow and canonical-patch contract, Gemma 4 models enabled by default, and Voice Mode Enhancements with wave animations and privacy/compliance UX warnings.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-05-12\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 2.2.17 - Claude Opus 4.7 Fast Mode\",\n    \"description\": \"Claude Opus 4.7 (fast mode) is now available in Windsurf.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-05-12\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Agent View\",\n    \"description\": \"The `claude agents` command opens one screen for every Claude Code session, showing what's running, what's blocked on you, and what's done.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-05-11\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"A 500k line codebase for an agent CLI proves one thing: making a probabilistic LLM behave deterministically is a massive state-management nightmare\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Claude Code and the Great Productivity Panic of 2026 - people running 6-7 agents simultaneously\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"/goal Command\",\n    \"description\": \"The `/goal` feature keeps Claude working across turns until a completion condition holds, providing persistent goal tracking throughout sessions.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-05-11\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Fast Mode on Opus 4.7\",\n    \"description\": \"Fast mode now runs on Opus 4.7 by default, offering improved performance for accelerated execution of Claude Code tasks.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-05-11\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Rewind Menu - Summarize Feature\",\n    \"description\": \"The Rewind menu can now compress earlier context with 'Summarize up to here' feature, providing better context management.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-05-11\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 2.1.32 - Devin Review & Agent Command Center\",\n    \"description\": \"All Windsurf IDE users now have access to Devin Review and Quick Review. Added Agent Command Center with list display option, improved sessions sidebar sorting and filtering.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  }\n]\n",
