>\n</head>\n<body>\n    <header>\n        <div class=\"container\">\n            <h1>Agentic Coding Research Report</h1>\n            <div class=\"header-nav\">\n                <a href=\"#new-products\">New Products</a>\n                <a href=\"#whitelist-updates\">Updates</a>\n                <a href=\"#technical-insights\">Insights</a>\n                <span style=\"color: #828282;\">| 2026-05-28</span>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"container\">\n        <div class=\"three-column-layout\">\n            <!-- New Products Section -->\n            <section class=\"new-products\" id=\"new-products\">\n                <h2>New Products (35)</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/memdex\" target=\"_blank\">Memdex</a>\n                        <span class=\"category\">workspace memory</span>\n                    </div>\n                    <div class=\"item-description\">Turn every AI conversation into reusable local memory for persistent context.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-23</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/google-antigravity-cli\" target=\"_blank\">Google Antigravity CLI</a>\n                        <span class=\"category\">AI coding CLI</span>\n                    </div>\n                    <div class=\"item-description\">Run coding agents directly from your terminal with CLI interface.</div>\n                    <div class=\"community-quote\">\"The SSH workflow is a game changer - I can now work on remote servers seamlessly\"</div>\n                    <div class=\"community-quote\">\"Finally a CLI tool that doesn't try to be everything - focused on terminal workflows\"</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-23</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/vibedock\" target=\"_blank\">Vibedock</a>\n                        <span class=\"category\">IDE integration</span>\n                    </div>\n                    <div class=\"item-description\">Toggle Claude Code MCP servers from your menu bar for IDE integration.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-23</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/testsprite\" target=\"_blank\">TestSprite 3.0</a>\n                        <span class=\"category\">testing tool</span>\n                    </div>\n                    <div class=\"item-description\">Fleet of parallel AI agents that test your app in minutes.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-22</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/buildpipe\" target=\"_blank\">buildpipe</a>\n                        <span class=\"category\">orchestration agent</span>\n                    </div>\n                    <div class=\"item-description\">Compose, run and automate multi-step AI developer workflows.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-22</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/shuffle-design-cli\" target=\"_blank\">Shuffle Design CLI</a>\n                        <span class=\"category\">AI coding CLI</span>\n                    </div>\n                    <div class=\"item-description\">Multi-AI CLI for building and redesigning websites.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-22</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/google-antigravity-2\" target=\"_blank\">Google Antigravity 2.0</a>\n                        <span class=\"category\">orchestration agent</span>\n                    </div>\n                    <div class=\"item-description\">Orchestrate multi-agent workflows from a desktop app.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-21</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/instavm\" target=\"_blank\">InstaVM</a>\n                        <span class=\"category\">agent infrastructure</span>\n                    </div>\n                    <div class=\"item-description\">Instant computers for AI agents to run workflows and tasks.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-21</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/allihat\" target=\"_blank\">AlliHat</a>\n                        <span class=\"category\">IDE integration</span>\n                    </div>\n                    <div class=\"item-description\">Claude AI integrated in your Safari sidebar for browser-based coding.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-21</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/novi-notes\" target=\"_blank\">Novi Notes 1.1</a>\n                        <span class=\"category\">workspace memory</span>\n                    </div>\n                    <div class=\"item-description\">Local AI memory layer for your Mac for persistent workspace context.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-21</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/slideshot\" target=\"_blank\">Slideshot</a>\n                        <span class=\"category\">workflow agent</span>\n                    </div>\n                    <div class=\"item-description\">Product demo videos recorded by your AI agent automatically.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-21</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/emdash\" target=\"_blank\">Emdash</a>\n                        <span class=\"category\">agent management</span>\n                    </div>\n                    <div class=\"item-description\">One app that manages every coding agent with open-source integration.</div>\n                    <div class=\"community-quote\">\"Running parallel agents on isolated worktrees is brilliant for testing features\"</div>\n                    <div class=\"community-quote\">\"SSH support makes remote development seamless\"</div>\n                    <div class=\"community-quote\">\"Finally a unified interface for all my coding agents\"</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-20</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/runtime\" target=\"_blank\">Runtime</a>\n                        <span class=\"category\">open-source coding agent</span>\n                    </div>\n                    <div class=\"item-description\">Sandboxed coding agents for everyone on your team with Slack integration.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-20</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/re-gent\" target=\"_blank\">Re_gent</a>\n                        <span class=\"category\">agent infrastructure</span>\n                    </div>\n                    <div class=\"item-description\">Version Control for AI agent activity to track changes and rollbacks.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-20</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/viberia\" target=\"_blank\">Viberia</a>\n                        <span class=\"category\">orchestration agent</span>\n                    </div>\n                    <div class=\"item-description\">Command AI agents like you're playing Civilization with orchestration controls.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-20</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/glia\" target=\"_blank\">Glia</a>\n                        <span class=\"category\">workspace memory</span>\n                    </div>\n                    <div class=\"item-description\">Local-first AI memory bridge between browser chats and IDEs.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-20</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/contextberg\" target=\"_blank\">Contextberg</a>\n                        <span class=\"category\">workspace memory</span>\n                    </div>\n                    <div class=\"item-description\">Turn your work into AI agent memory, served over MCP protocol.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-20</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/shioricode\" target=\"_blank\">ShioriCode</a>\n                        <span class=\"category\">open-source coding agent</span>\n                    </div>\n                    <div class=\"item-description\">Open-source alternative to Codex & Claude Code for AI-assisted development.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-19</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/drizz\" target=\"_blank\">Drizz</a>\n                        <span class=\"category\">testing tool</span>\n                    </div>\n                    <div class=\"item-description\">Mobile tests that write, run, and fix themselves autonomously.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">Product Hunt</span> · <span class=\"published-date\">2026-05-19</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/ctrlops\" target=\"_blank\">CtrlOps</a>\n                        <span class=\"category\">orchestration agent</span>\n                    </div>\n                    