      "content": "[\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.132 Released\",\n    \"description\": \"Claude Code v2.1.132 released with multiple bug fixes and improvements including session ID environment variable, alternate screen opt-out, improved SIGINT handling, terminal fixes for various IDEs (Cursor, VS Code, JetBrains), and MCP server error handling improvements.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases/tag/v2.1.132\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"I'm using both claude code (opus-4.7) and codex (gpt-5.5). The agents are perfectly capable of delivering most features hands free these days, but the code quality is still miserable without another few rounds of prompt.\",\n        \"source\": \"Hacker News - How to improve code quality of Claude Code (May 2026)\",\n        \"sentiment\": \"mixed\"\n      },\n      {\n        \"quote\": \"staying human-in-the-loop, more upfront prompt effort, more/better instructions, starting to look at agent teams/workflows\",\n        \"source\": \"Hacker News - How to improve code quality of Claude Code (May 2026)\",\n        \"sentiment\": \"constructive\"\n      },\n      {\n        \"quote\": \"Claude Code refuses requests or charges extra if your commits mention OpenClaw - users experiencing billing issues when certain keywords appear in their codebase\",\n        \"source\": \"Hacker News - Claude Code billing/keyword filtering discussion (May 2026)\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"I upgraded to 2.1.32 just to try Opus 4.6, but after upgrading it has been full of issues. /compact is not working at all. It asks me to go back to a previous message, and when I do that and run /compact, it just gets stuck at 0 tokens. In general it also feels much slower.\",\n        \"source\": \"Reddit - r/ClaudeCode (May 2026)\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"I am also not sure if this is a Claude Code version issue or a model issue, but I am noticing that Opus 4.6 consumes a lot more of my 5-hour usage limit compared to what I normally see.\",\n        \"source\": \"Reddit - r/ClaudeCode (May 2026)\",\n        \"sentiment\": \"mixed\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Context Usage Breakdown\",\n    \"description\": \"Cursor 3.3 introduces context usage breakdown feature allowing developers to see detailed stats about their agent's context consumption across rules, skills, MCPs, and subagents to diagnose issues and optimize setup.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog/05-06-26\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Enterprise-Managed Plugins in GitHub Copilot CLI Public Preview\",\n    \"description\": \"GitHub Copilot CLI introduces enterprise-managed plugins in public preview, allowing organizations to control and manage CLI plugin access and configuration for their teams.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/2026-05-06-enterprise-managed-plugins-in-github-copilot-cli-are-now-in-public-preview\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 2.2.17 - Devin Review & Quick Review Integration\",\n    \"description\": \"Windsurf IDE v2.2.17 released with Devin Review and Quick Review now available to all users, Agent Command Center improvements with list display, better session sorting/filtering, and Windows update bug fixes.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://codeium.com/changelog\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Main Branch Updates - Claude 4.5/4.6 and GPT-5 Support\",\n    \"description\": \"Aider main branch adds support for Claude 4.5/4.6 models with updated aliases, expanded Gemini model support (2.5 Flash, Flash-Lite, Gemini 3 preview), DeepSeek Reasoner model, and new OpenAI GPT-5.1/5.2/5.3/5.4 models across providers.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://aider.chat/HISTORY.html\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Version 1.3.38 - Config File Support & Workspace Filtering\",\n    \"description\": \"Continue v1.3.38 introduces .continue/configs support, workspace directory session history filtering, config.yaml existence checks, and multiple dependency updates including happy-dom and handlebars.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/continuedev/continue/releases\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Model Controls, Spend Management, and Usage Analytics\",\n    \"description\": \"Cursor releases enterprise admin updates including granular model access controls at provider/model level, updated spend management, and enhanced usage analytics with option to block new providers by default.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog/05-04-26\",\n    \"date\": \"2026-05-04\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Version 0.128.0 - Goals, Plugins, Multi-Agent V2 Improvements\",\n    \"description\": \"Codex CLI 0.128.0 released with persisted /goal workflows, configurable TUI keymaps, plan-mode nudges, expanded permission profiles with sandbox controls, improved plugin workflows with marketplace installation, remote bundle caching, and MultiAgentV2 configuration enhancements including thread caps and wait-time controls.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-04-30\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Sensitive Toggle for Secrets & Multi-Edit Merging\",\n    \"description\": \"Devin release April 24, 2026 introduces sensitive toggle for secrets (masked/visible), merged multi-edits in progress tab showing combined diffs, session category/subcategory in v3 API, and wide markdown tables in chat.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-04-24\",\n    \"community_feedback\": []\n  }\n]\n",
