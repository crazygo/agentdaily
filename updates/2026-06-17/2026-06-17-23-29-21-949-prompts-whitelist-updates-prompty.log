    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-06-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Canvas Design Mode and Context Usage Report\",\n    \"description\": \"June 2026: Introduced Design Mode for faster canvas editing, new context usage report showing interactive breakdown of token usage, and Organizations management for Enterprise customers with multi-team support.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-06-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Usage-Based Billing Transition\",\n    \"description\": \"June 1, 2026: GitHub Copilot completed transition to usage-based billing where every suggestion, chat completion, and code review consumes credits. May updates included Visual Studio enhancements and agentic workflows with cloud agent sessions.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.com/features/copilot/whats-new\",\n    \"date\": \"2026-06-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Users Tab Renamed to Members and Devin Review\",\n    \"description\": \"June 10, 2026: Org membership page tab renamed to 'Members' for clarity. New Devin Review feature for pending PRs, with auto-cancel on new commits. Also includes large paste auto-attach as files, user mentions rendered as styled links, and official Figma MCP integration.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-06-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"v0.86.2 Stable Release and Model Support\",\n    \"description\": \"June 2026: Latest stable release v0.86.2 with last repository push on May 22, 2026. Added DeepSeek Reasoner model and expanded Gemini model support. Aider writes 70-80% of its own code in each release.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://aider.chat/\",\n    \"date\": \"2026-06-09\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Codex CLI 0.140.0 Released\",\n    \"description\": \"June 15, 2026: Added /usage views for daily, weekly, and cumulative account token activity. /goal now preserves oversized text and image attachments. Added permanent session deletion through codex delete, /import for Claude Code migration, and managed Amazon Bedrock API-key authentication.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-06-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Codex CLI 0.139.0 Released\",\n    \"description\": \"June 9, 2026: Code mode can now call standalone web search directly. Tool and connector input schemas preserve oneOf and allOf. Plugin marketplace automation more informative with JSON output. Improved image edits using exact file paths and safer automatic edits in acceptEdits mode.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-06-09\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Codex CLI usage limits decreased by 4x or more\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Codex has been much better than Gemini CLI for me so far\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Big update incoming with improvements for large repositories\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Gemini CLI Shutdown Announcement\",\n    \"description\": \"June 18, 2026: Google is shutting down Gemini CLI for free, Pro, and Ultra users. A migration guide has been published for builders. Latest release v0.45.0 included routing optimizations and bypassed classifiers for specific tool responses.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-06-18\",\n    \"community_feedback\": []\n  }\n]\n",
