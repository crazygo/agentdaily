  "content": "[\n  {\n    \"name\": \"JetBrains Air\",\n    \"url\": \"https://www.jetbrains.com/air/\",\n    \"description\": \"An agentic development environment (ADE) for delegating coding tasks to multiple AI agents and running them concurrently. Built on JetBrains' 26 years of IDE experience, Air focuses on agent orchestration without replacing existing development workflows. Supports Codex, Claude Agent, Gemini CLI, and Junie out of the box with BYOK pricing.\",\n    \"release_date\": \"2026-03-09\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"JetBrains Blog\"],\n    \"community_quotes\": [\n      \"JetBrains Air represents a new wave of dev tooling built on 26 years of experience\",\n      \"Air handles agent-powered development while your IDE handles the rest\",\n      \"The project is built on the technology foundation of JetBrains' previously abandoned Fleet IDE project\",\n      \"Air supports the Agent Client Protocol (ACP) and will soon add support for other agents available via ACP through the ACP Agent Registry\"\n    ]\n  },\n  {\n    \"name\": \"Junie CLI\",\n    \"url\": \"https://www.jetbrains.com/junie/\",\n    \"description\": \"An LLM-agnostic standalone AI coding agent that works from terminal, any IDE, CI/CD, and GitHub/GitLab. Supports OpenAI, Anthropic, Google, and Grok models with BYOK pricing. Features Real-time Prompting, Codebase Intelligence, Easy MCP Configuration, and Next-task Prediction. One-click migration from other agents like Claude Code and Codex.\",\n    \"release_date\": \"2026-03-09\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"JetBrains Blog\"],\n    \"community_quotes\": [\n      \"One of the best coding agents I've tried with great test-first development support\",\n      \"The terminal interface is clean and functional with less ANSI fanfare and less UI complexity\",\n      \"LLM-agnostic nature allows developers to choose their preferred models\",\n      \"Mixed feelings from the community about the Air and Junie CLI launches\",\n      \"Junie CLI changes the game for developers - can install right from Zed with ACP support\"\n    ]\n  }\n]\n"
}

