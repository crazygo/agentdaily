          line-height: 1.4;\n        }\n\n        .insight-meta {\n            font-size: 10px;\n            color: #828282;\n        }\n\n        .insight-topics {\n            margin-top: 5px;\n        }\n\n        /* Footer Styles */\n        footer {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            padding: 10px;\n            text-align: center;\n            font-size: 11px;\n            color: #828282;\n        }\n\n        footer a {\n            color: #828282;\n            text-decoration: none;\n            margin: 0 8px;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n        }\n\n        /* Print Styles */\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            section {\n                page-break-inside: avoid;\n            }\n\n            .item, .update-item, .insight-item {\n                page-break-inside: avoid;\n            }\n        }\n\n        /* Source Indicators */\n        .source-indicator {\n            font-size: 10px;\n            color: #ff6600;\n            font-weight: bold;\n            text-transform: uppercase;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agentic Coding Research Report</h1>\n            <div class=\"date\">May 20, 2026</div>\n        </header>\n\n        <main class=\"three-column-layout\">\n            <!-- Left Column: New Products -->\n            <section class=\"new-products\">\n                <h2>New Products</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/products/agentrail\" target=\"_blank\">AgentRail</a></div>\n                    <div class=\"item-description\">A local control plane for AI coding agents - provides routing, supervising, and auditing multi-agent work across repos and CI.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-indicator\">Product Hunt</span>\n                        <span class=\"tag\">workflow orchestration</span>\n                        <span class=\"tag\">2026-05-19</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://prave.app\" target=\"_blank\">Prave</a></div>\n                    <div class=\"item-description\">The missing management layer for AI Agent Skills - enables authoring once and deploying skills across Claude, Codex, Cursor, Gemini, Cline, and Amp.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-indicator\">Hacker News</span>\n                        <span class=\"tag\">workflow orchestration</span>\n                        <span class=\"tag\">MCP integration</span>\n                        <span class=\"tag\">2026-05-19</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/products/polygram\" target=\"_blank\">Polygram</a></div>\n                    <div class=\"item-description\">AI-native design and coding app to build mobile & web apps - combines planning, design, code generation, live preview, and GitHub sync.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-indicator\">Product Hunt</span>\n                        <span class=\"tag\">AI IDE</span>\n                        <span class=\"tag\">2026-05-17</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/products/pixcode\" target=\"_blank\">Pixcode</a></div>\n                    <div class=\"item-description\">A self-hosted control room for AI coding agents - enables orchestration and controlled execution of agents across development workflows.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-indicator\">Product Hunt</span>\n                        <span class=\"tag\">open-source</span>\n                        <span class=\"tag\">self-hostable</span>\n                        <span class=\"tag\">2026-05-16</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://github.com/navikt/cplt\" target=\"_blank\">Cplt</a></div>\n                    <div class=\"item-description\">macOS Seatbelt sandbox wrapper for AI coding agents - runs agents inside Apple's kernel-level sandbox to prevent unauthorized access to credentials and secrets.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-indicator\">Hacker News</span>\n                        <span class=\"tag\">security</span>\n                        <span class=\"tag\">open-source</span>\n                        <span class=\"tag\">2026-05-19</span>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Middle Column: Whitelist Updates -->\n            <section class=\"whitelist-updates\">\n                <h2>Whitelist Updates</h2>\n\n                <div class=\"update-item\">\n                    <div class=\"update-title\"><a href=\"https://github.com/anthropics/claude-code/releases\" target=\"_blank\">Agent View and Background Sessions</a></div>\n                    <div class=\"update-product\">Claude Code v2.1.144</div>\n                    <div class=\"update-description\">Agent view (`claude agents`) for managing all sessions, `/goal` command for continuous work until completion, and background session improvements.</div>\n                    <div class=\"update-meta\">2026-05-19</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-title\"><a href=\"https://cursor.com/changelog\" target=\"_blank\">Composer 2.5 and Cloud Agent Environments</a></div>\n                    <div class=\"update-product\">Cursor</div>\n                    <div class=\"update-description\">Significant improvements in intelligence and behavior, better handling of long-running tasks, and cloud agent development environments with multi-repository support.</div>\n                    <div class=\"update-meta\">2026-05-19</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-title\"><a href=\"https://developers.openai.com/codex/changelog\" target=\"_blank\">Enhanced TUI and Plugin Workflows</a></div>\n                    <div class=\"update-product\">Codex CLI v0.131.0</div>\n                    <div class=\"update-description\">Richer TUI session controls with data-driven service-tier commands, enhanced plugin workflows with marketplace CLI commands, and remote workflow improvements.</div>\n                    <div class=\"update-meta\">2026-05-18</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-title\"><a href=\"https://windsurf.com/changelog\" target=\"_blank\">Bug Fixes and Performance Improvements</a></div>\n                    <div class=\"update-product\">Windsurf v2.3.9</div>\n                    <div class=\"update-description\">Fixed availability issues with swe-check model, improved terminal processing performance, and restored conversation sharing.</div>\n                    <div class=\"update-meta\">2026-05-17</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-title\"><a href=\"https://code.claude.com/docs/en/whats-new\" target=\"_blank\">Weekly Digest Week 20</a></div>\n                    <div class=\"update-product\">Claude Code v2.1.139–v2.1.142</div>\n                    <div class=\"update-description\">Agent view, `/goal` command, fast mode on Opus 4.7, Rewind menu with context compression, and plugin enhancements including zip archive and URL loading.</div>\n                    <div class=\"update-meta\">2026-05-15</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-title\"><a href=\"https://cursor.com/changelog\" target=\"_blank\">Microsoft Teams Integration</a></div>\n                    <div class=\"update-product\">Cursor</div>\n                    <div class=\"update-description\">@Cursor mentions in Microsoft Teams to delegate tasks to cloud agents. Bugbot supports customizable effort levels for PR reviews.</div>\n                    <div class=\"update-meta\">2026-05-15</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-title\"><a href=\"https://developers.openai.com/codex/changelog\" target=\"_blank\">ChatGPT Mobile Integration</a></div>\n                    <div class=\"update-product\">Codex CLI</div>\n                    <div class=\"update-description\">Codex can now be used from the ChatGPT mobile app by connecting it to a Mac running the Codex app.</div>\n                    <div class=\"update-meta\">2026-05-14</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-title\"><a href=\"https://windsurf.com/changelog\" target=\"_blank\">Claude Opus 4.7 Fast Mode</a></div>\n                    <div class=\"update-product\">Windsurf</div>\n                    <div class=\"update-description\">Claude Opus 4.7 (fast mode) now available with full intelligence but ~2.5x higher output speeds.</div>\n                    <div class=\"update-meta\">2026-05-12</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-title\"><a href=\"https://developers.openai.com/codex/changelog\" target=\"_blank\">Codex for Chrome Extension</a></div>\n                    <div class=\"update-product\">Codex CLI</div>\n                    <div class=\"update-description\">New Chrome extension with improved ability to work with apps and websites in the browser, working in parallel across tabs.</div>\n                    <div class=\"update-meta\">2026-05-07</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-title\"><a href=\"https://windsurf.com/changelog\" target=\"_blank\">Devin Review and Agent Command Center</a></div>\n                    <div class=\"update-product\">Windsurf</div>\n                    <div class=\"update-description\">All users now have access to Devin Review and Quick Review. Agent Command Center improvements include list display option and performance improvements.</div>\n                    <div class=\"update-meta\">2026-05-06</div>\n                </div>\n            </section>\n\n            <!-- Right Column: Technical Insights -->\n            <section class=\"technical-insights\">\n                <h2>Technical Insights</h2>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/\" target=\"_blank\">PyCon US 2026 Lightning Talk</a></div>\n                    <div class=\"insight-author\">Simon Willison</div>\n                    <div class=\"insight-description\">Annotated slides covering LLM predictions and AI-assisted programming topics.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"source-indicator\">Blog</span>\n                        2026-05-18\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">PyCon</span>\n                        <span class=\"tag\">LLM</span>\n                        <span class=\"tag\">AI-assisted programming</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://www.youtube.com/watch?v=all-in-on-ai-coding-with-llms\" target=\"_blank\">All in on AI: Coding with LLMs</a></div>\n                    <div class=\"insight-author\">Simon Willison</div>\n                    <div class=\"insight-description\">Demonstrating 'vibe-coding' with Claude Code and evolving AI-assisted programming workflow.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"source-indicator\">YouTube</span>\n                        2026-05-17\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">vibe coding</span>\n                        <span class=\"tag\">Claude Code</span>\n                        <span class=\"tag\">AI workflow</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://www.instagram.com/reel/DVWzGW2kU0A/\" target=\"_blank\">Three Types of Programmers in 2026</a></div>\n                    <div class=\"insight-author\">Andrej Karpathy</div>\n                    <div class=\"insight-description\">Context window management is the key skill. \"What's in the context window is your lever over the interpreter.\"</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"source-indicator\">Twitter</span>\n                        2026-05-16\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">context window</span>\n                        <span class=\"tag\">LLM programming</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://travis.media/blog/software-3-0-ai-changing-programming-karpathy/\" target=\"_blank\">Software 3.0</a></div>\n                    <div class=\"insight-author\">Andrej Karpathy</div>\n                    <div class=\"insight-description\">A new programming layer built around prompts rather than traditional code - a fundamental shift in programming.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"source-indicator\">Blog</span>\n                        2026-05-15\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">Software 3.0</span>\n                        <span class=\"tag\">prompt engineering</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://www.instagram.com/reel/DPWODifgHZj/\" target=\"_blank\">Vibe Coding is the Future</a></div>\n                    <div class=\"insight-author\">Amjad Masad</div>\n                    <div class=\"insight-description\">Why 'vibe coding' is not just a trend but the future of programming and the post-coding AI era.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"source-indicator\">Podcast</span>\n                        2026-05-15\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">vibe coding</span>\n                        <span class=\"tag\">future of programming</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://www.techcrunch.com/replit-series-d-2026\" target=\"_blank\">Replit Raises $400M Series D</a></div>\n                    <div class=\"insight-author\">Amjad Masad / Replit</div>\n                    <div class=\"insight-description\">$9B valuation, democratizing software creation with AI coding tools. Grown to 34M users.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"source-indicator\">TechMedia</span>\n                        2026-05-13\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">funding</span>\n                        <span class=\"tag\">AI coding tools</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://dev.to/jasonguo/karpathys-claude-code-field-notes-real-experience-and-deep-reflections-on-the-ai-programming-era-4e2f\" target=\"_blank\">Karpathy's Dramatic Shift in Workflow</a></div>\n                    <div class=\"insight-author\">Jason Guo / Andrej Karpathy</div>\n                    <div class=\"insight-description\">Dramatic shift \"in just a few weeks\" from 80% manual+autocomplete to much more AI-assisted approach.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"source-indicator\">Blog</span>\n                        2026-05-14\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">Claude Code</span>\n                        <span class=\"tag\">workflow</span>\n                    </div>\n                </div>\n            </section>\n        </main>\n\n        <footer>\n            <a href=\"#\">Archive</a>\n            <a href=\"#\">About</a>\n            <a href=\"#\">RSS Feed</a>\n            <a href=\"#\">GitHub</a>\n            <span style=\"margin-left: 20px;\">© 2026 Agentic Coding Research</span>\n        </footer>\n    </div>\n</body>\n</html>\n"
}

