rgba(0,0,0,0.35); margin: 0 5px; }\n\n  .issue-line {\n    max-width: 1560px;\n    margin: 0 auto;\n    background: #ffffff;\n    border-bottom: 1px solid var(--border);\n    padding: 5px 14px;\n    font-size: 11px;\n    color: var(--muted);\n    display: flex;\n    flex-wrap: wrap;\n    gap: 4px 14px;\n    justify-content: space-between;\n  }\n  .issue-line strong { color: #444; font-weight: bold; }\n  .issue-line .stat b { color: var(--text); }\n\n  /* ---------- Layout ---------- */\n  main.layout {\n    display: grid;\n    grid-template-columns: 40fr 35fr 25fr;\n    max-width: 1560px;\n    margin: 0 auto;\n    width: 100%;\n    padding: 0 14px 26px;\n  }\n  section.col {\n    min-width: 0;\n    padding-bottom: 30px;\n  }\n  section.col + section.col { border-left: 1px solid var(--border); }\n\n  .col-head {\n    position: sticky;\n    top: 0;\n    z-index: 10;\n    background: var(--head-bg);\n    border-bottom: 2px solid var(--accent);\n    margin: 0 -14px 4px;\n    padding: 7px 14px;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 11.5px;\n    font-weight: bold;\n    letter-spacing: 1.2px;\n    text-transform: uppercase;\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n  }\n  .col-head .count {\n    color: var(--muted);\n    letter-spacing: 0;\n    text-transform: none;\n    font-family: Verdana, Geneva, sans-serif;\n    font-size: 11px;\n    font-weight: normal;\n  }\n  .col-sub {\n    margin: 6px 0 2px;\n    font-size: 10.5px;\n    color: var(--muted);\n  }\n\n  ol.storylist {\n    list-style: none;\n    counter-reset: item;\n    margin: 0;\n    padding: 0;\n  }\n  li.story {\n    counter-increment: item;\n    border-bottom: 1px solid var(--border);\n    padding: 9px 0 10px;\n    display: flex;\n    gap: 8px;\n    transition: background-color 120ms ease;\n  }\n  li.story:last-child { border-bottom: none; }\n  li.story:hover { background: rgba(255, 102, 0, 0.05); }\n  li.story::before {\n    content: counte