  "command": "python3 -c \"\nfrom html.parser import HTMLParser\nimport re\n\nclass Validator(HTMLParser):\n    VOID = {'meta','link','br','hr','img','input','area','base','col','embed','source','track','wbr'}\n    def __init__(self):\n        super().__init__(convert_charrefs=False)\n        self.stack = []\n        self.errors = []\n    def handle_starttag(self, tag, attrs):\n        if tag not in self.VOID:\n            self.stack.append((tag, self.getpos()))\n    def handle_endtag(self, tag):\n        if tag in self.VOID: return\n        if not self.stack:\n            self.errors.append(f'Unmatched close tag </{tag}> at {self.getpos()}')\n            return\n        open_tag, pos = self.stack.pop()\n        if open_tag != tag:\n            self.errors.append(f'Mismatch: <{open_tag}> opened {pos}, closed by </{tag}> at {self.getpos()}')\n\nhtml = open('index.html', encoding='utf-8').read()\nv = Validator()\nv.feed(html)\nv.close()\nif v.errors:\n    print('ERRORS:')\n    for e in v.errors[:20]: print(' ', e)\nelif v.stack:\n    print('UNCLOSED:', [(t,p) for t,p in v.stack])\nelse:\n    print('HTML structure OK — all tags balanced')\n\n# Content counts\nprint('new-product stories:', len(re.findall(r'id=\\\"new-products\\\".*?id=\\\"whitelist\\\"', html, re.S)[0].split('<li class=\\\"story\\\">'))-1)\nprint('whitelist stories:', len(re.findall(r'id=\\\"whitelist\\\".*?id=\\\"insights\\\"', html, re.S)[0].split('<li class=\\\"story\\\">'))-1)\nprint('insight stories:', len(re.findall(r'id=\\\"insights\\\".*?</main>', html, re.S)[0].split('<li class=\\\"story\\\">'))-1)\nprint('total hrefs:', len(re.findall(r'href=\\\"http', html)))\nprint('clamped descs:', len(re.findall(r'clamp-3', html))-1)  # -1 for CSS rule mention\n\"\n",
  "description": "Validate HTML tag balance and count content items"
}

