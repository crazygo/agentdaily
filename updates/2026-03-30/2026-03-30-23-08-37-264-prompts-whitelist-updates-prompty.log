\t\t\t\t\t<button id=\"header-blog__gallery-nav-buttons-next\">next</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div> --> </div> </div> </div><div id=\"blog-post-list\"> <div class=\"o-container\"> <div id=\"blog-post-list__wrapper\" class=\"o-grid\"> <div id=\"blog-post-list__filter-desktop\"> <ul id=\"blog-post-list__filter-list\"> <li class=\"blog-post-list__filter-list-item\"><a href=\"/blog/1\" class=\"no-link\">all -49-</a></li> <li class=\"blog-post-list__filter-list-item\" data-id=\"Product Updates\"><a href=\"/blog/Product Updates/1\" class=\"no-link\">Product Updates</a></li><li class=\"blog-post-list__filter-list-item\" data-id=\"Research\"><a href=\"/blog/Research/1\" class=\"no-link\">Research</a></li><li class=\"blog-post-list__filter-list-item\" data-id=\"Tutorials\"><a href=\"/blog/Tutorials/1\" class=\"no-link\">Tutorials</a></li><li class=\"blog-post-list__filter-list-item\" data-id=\"Announcements\"><a href=\"/blog/Announcements/1\" class=\"no-link\">Announcements</a></li><li class=\"blog-post-list__filter-list-item\" data-id=\"Customer Story\"><a href=\"/blog/Customer Story/1\" class=\"no-link\">Customer Story</a></li> </ul> </div> <div id=\"blog-post-list__filter-mobile\"> <span>+</span> <span>Filter by:</span> <span>+</span> <select id=\"blog-post-list__filter-select\"> <option value=\"/blog/1\">all -20-</option> <option value=\"/blog/Product Updates/1\">Product Updates</option><option value=\"/blog/Research/1\">Research</option><option value=\"/blog/Tutorials/1\">Tutorials</option><option value=\"/blog/Announcements/1\">Announcements</option><option value=\"/blog/Customer Story/1\">Customer Story</option> </select> </div> <div id=\"blog-post-list__list-wrapper\"> <ul id=\"blog-post-list__list\" data-theme=\"light\"> <li class=\"blog-post-list__list-item\"> <a class=\"o-blog-preview\" href=\"/blog/devin-can-now-schedule-devins\"> <div class=\"o-blog-preview__inner\"> <div class=\"o-blog-preview__content\"> <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-date\">March 20, 2026 <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-author\">The Cognition Team</span> <!-- {isCommunityPost && <span class=\"o-blog-preview__caption\">Community</span>} --> </span></span>  </span> <span> <span class=\"o-blog-preview__description\"> <h3 class=\"o-blog-preview__title\">Devin can now Schedule Devins</h3> <p class=\"o-blog-preview__intro\">Devin can now schedule its own recurring sessions. Run a task once, and if it goes well, tell Devin to keep doing it. It maintains state between runs, so each session picks up where the last one left off.</p> </span> </span> </div> </div> </a> </li><li class=\"blog-post-list__list-item\"> <a class=\"o-blog-preview\" href=\"/blog/devin-can-now-manage-devins\"> <div class=\"o-blog-preview__inner\"> <div class=\"o-blog-preview__content\"> <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-date\">March 19, 2026 <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-author\">The Cognition Team</span> <!-- {isCommunityPost && <span class=\"o-blog-preview__caption\">Community</span>} --> </span></span>  </span> <span> <span class=\"o-blog-preview__description\"> <h3 class=\"o-blog-preview__title\">Devin can now Manage Devins</h3> <p class=\"o-blog-preview__intro\">Devin can now break down large tasks and delegate them to a team of managed Devins, with each running in its own isolated VM in parallel.</p> </span> </span> </div> </div> </a> </li><li class=\"blog-post-list__list-item\"> <a class=\"o-blog-preview\" href=\"/blog/swe-1-6-preview\"> <div class=\"o-blog-preview__inner\"> <div class=\"o-blog-preview__content\"> <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-date\">March 1, 2026 <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-author\">Carlo Baronio, Ben Pan, Sam Lee, Eric Lu, Steven Cao, Rohan Choudhury, Adam Zweiger, Ray Wang, Gary Chang, Silas Alberti</span> <!-- {isCommunityPost && <span class=\"o-blog-preview__caption\">Community</span>} --> </span></span>  </span> <span> <span class=\"o-blog-preview__description\"> <h3 class=\"o-blog-preview__title\">An Early Preview of SWE-1.6 and Research Update</h3> <p class=\"o-blog-preview__intro\">We are sharing an early preview of our ongoing SWE-1.6 training run.</p> </span> </span> </div> </div> </a> </li><li class=\"blog-post-list__list-item\"> <a class=\"o-blog-preview\" href=\"/blog/how-cognition-uses-devin-to-build-devin\"> <div class=\"o-blog-preview__inner\"> <div class=\"o-blog-preview__content\"> <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-date\">February 27, 2026 <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-author\">The Cognition Team</span> <!-- {isCommunityPost && <span class=\"o-blog-preview__caption\">Community</span>} --> </span></span>  </span> <span> <span class=\"o-blog-preview__description\"> <h3 class=\"o-blog-preview__title\">How Cognition Uses Devin to Build Devin</h3> <p class=\"o-blog-preview__intro\">Devin is a cloud agent platform for engineering teams. You work with it like a teammate — give it tasks, review its PRs, and let it handle your backlog. Here&#39;s how we use it to build Devin itself.</p> </span> </span> </div> </div> </a> </li><li class=\"blog-post-list__list-item\"> <a class=\"o-blog-preview\" href=\"/blog/cognition-for-government\"> <div class=\"o-blog-preview__inner\"> <div class=\"o-blog-preview__content\"> <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-date\">February 25, 2026 <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-author\">The Cognition Team</span> <!-- {isCommunityPost && <span class=\"o-blog-preview__caption\">Community</span>} --> </span></span>  </span> <span> <span class=\"o-blog-preview__description\"> <h3 class=\"o-blog-preview__title\">Introducing Cognition for Government</h3> <p class=\"o-blog-preview__intro\">Today, we launch Cognition for Government to modernize America’s critical infrastructure with AI software engineering.</p> </span> </span> </div> </div> </a> </li><li class=\"blog-post-list__list-item\"> <a class=\"o-blog-preview\" href=\"/blog/introducing-devin-2-2\"> <div class=\"o-blog-preview__inner\"> <div class=\"o-blog-preview__content\"> <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-date\">February 24, 2026 <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-author\">The Cognition Team</span> <!-- {isCommunityPost && <span class=\"o-blog-preview__caption\">Community</span>} --> </span></span>  </span> <span> <span class=\"o-blog-preview__description\"> <h3 class=\"o-blog-preview__title\">Introducing Devin 2.2</h3> <p class=\"o-blog-preview__intro\">Today we’re releasing Devin 2.2, the most important update to Devin since launch.</p> </span> </span> </div> </div> </a> </li><li class=\"blog-post-list__list-item\"> <a class=\"o-blog-preview\" href=\"/blog/closing-the-agent-loop-devin-autofixes-review-comments\"> <div class=\"o-blog-preview__inner\"> <div class=\"o-blog-preview__content\"> <span class=\"o-blog-preview__meta\"> <span class=\"o-blog-preview__meta-date\">February 10, 2026 <span class=\"o-blog-preview__meta\"> <span class=\"\n\n... [7 lines truncated] ...",
