      "content": "[\n  {\n    \"name\": \"Cursor Origin\",\n    \"url\": \"https://cursor.com/changelog/origin-code-hosting\",\n    \"description\": \"Agent-native code hosting platform built into Cursor: cloud Git repositories, pull requests, code review and GitHub sync designed for high-volume AI coding agent workflows. Early beta began rolling out to all paid plans in mid-August 2026, debuting during a major GitHub outage which amplified attention.\",\n    \"release_date\": \"2026-08-17\",\n    \"category\": \"agent-native code hosting / dev workflow platform\",\n    \"sources\": [\"Cursor changelog\", \"VentureBeat\", \"YourStory\"],\n    \"community_quotes\": [\n      \"Commentators highlighted the launch landing the same week as a major GitHub outage, exposing the risk of centralized code hosting\"\n    ]\n  },\n  {\n    \"name\": \"Proliferate\",\n    \"url\": \"https://github.com/proliferate-ai/proliferate\",\n    \"description\": \"Open-source (AGPL-3.0), self-hostable AI IDE from a YC S25 founder that runs multiple coding agents (Claude Code, Codex, OpenCode, Cursor, Grok) in one interface, with parent agents spawning subagents and reusable Workflows with human approval gates. Uses each agent's own harness, subscriptions and auth.\",\n    \"release_date\": \"2026-08-21\",\n    \"category\": \"self-hosted AI IDE / multi-agent harness\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": [\n      \"The open-source route makes a lot of sense here. So excited!\",\n      \"ooo, nice Workflows feature you got there.\",\n      \"It was frustrating to set up and the docs confusing\"\n    ]\n  },\n  {\n    \"name\": \"HarnessRouter\",\n    \"url\": \"https://github.com/harnessrouter/harnessrouter\",\n    \"description\": \"Unified API layer for running coding-agent harnesses (Codex, Claude Code, Hermes) as a product backend - 'LiteLLM for harnesses rather than models'. Ships as a Docker image and proposes a Unified Harness Protocol for task execution, event streaming and session management.\",\n    \"release_date\": \"2026-08-17\",\n    \"category\": \"AI coding CLI infra / harness router\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": [\n      \"Think of it as OpenRouter, but for different agent harnesses, not models\",\n      \"I'm still unclear why I need to route across multiple agent harnesses vs just sticking with one\",\n      \"How does this handle harness-specific features without becoming a lowest-common-denominator API?\"\n    ]\n  },\n  {\n    \"name\": \"Huzzah\",\n    \"url\": \"https://news.ycombinator.com/item?id=49378768\",\n    \"description\": \"Experimental code editor by Daniel Vaughn offering a new paradigm for AI-assisted coding: developers write brief declarative pseudocode that stays as the persistent source of truth, and Huzzah generates and maintains the real code from it, acting as both prompt and documentation.\",\n    \"release_date\": \"2026-08-20\",\n    \"category\": \"AI IDE (experimental editor)\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"VS Code Agent Host\",\n    \"url\": \"https://code.visualstudio.com/blogs/2026/08/26/agent-host-architecture\",\n    \"description\": \"New VS Code Agent Host architecture for persistent, portable agent sessions inside the editor, with full MCP spec support and the ability to command GitHub's coding agent directly from VS Code.\",\n    \"release_date\": \"2026-08-26\",\n    \"category\": \"IDE-integrated agent runtime (VS Code)\",\n    \"sources\": [\"VS Code blog\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Opslane\",\n    \"url\": \"https://news.ycombinator.com/item?id=49466704\",\n    \"description\": \"Agent that watches real user sessions, finds the bugs that matter, and fixes them - an autonomous debugging agent wired directly into production session data.\",\n    \"release_date\": \"2026-08-27\",\n    \"category\": \"AI debugging agent\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Devx\",\n    \"url\": \"https://github.com/apvcode/Termux-Dev\",\n    \"description\": \"Autonomous AI coding agent built to run on Android Termux and desktop, letting developers run a repo-aware coding agent directly from their phone.\",\n    \"release_date\": \"2026-08-26\",\n    \"category\": \"code agent (mobile/terminal)\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Zuse\",\n    \"url\": \"https://zuse.sh\",\n    \"description\": \"Open-source desktop workspace for running and managing coding agents (Claude Code, Codex, Cursor, Gemini, Grok, OpenCode, Kiro) across real Git repositories. Tasks run in isolated Git worktrees with persistent sessions, diff inspection and PR review before merging, using your existing agent subscriptions.\",\n    \"release_date\": \"2026-08-23\",\n    \"category\": \"agent orchestration desktop app (open source)\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Polign\",\n    \"url\": \"https://news.ycombinator.com/item?id=49450816\",\n    \"description\": \"Lightweight, stateless agent-memory database combining vector search and BM25 over the user's own S3/GCS storage, with typed facts, structured queries and cold-storage caching for long-lived agent memory across sessions.\",\n    \"release_date\": \"2026-08-26\",\n    \"category\": \"agent memory infrastructure\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Knowl\",\n    \"url\": \"https://news.ycombinator.com/item?id=49465138\",\n    \"description\": \"Agent memory with write-time supersession: automatically prunes and supersedes stale project memory (built after the author's CLAUDE.md hit 1000 lines), scoring 0.90 on the MAB memory benchmark.\",\n    \"release_date\": \"2026-08-27\",\n    \"category\": \"coding-agent project memory\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Proval\",\n    \"url\": \"https://github.com/seoes/proval\",\n    \"description\": \"Self-hosted AI code review agent that reviews pull requests on GitLab, Forgejo and GitHub from your own infrastructure.\",\n    \"release_date\": \"2026-08-27\",\n    \"category\": \"self-hosted code review agent\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Contextual\",\n    \"url\": \"https://news.ycombinator.com/item?id=49460693\",\n    \"description\": \"Local codebase memory for AI coding agents: indexes and remembers project context so agents recall it across sessions without sending code to the cloud.\",\n    \"release_date\": \"2026-08-27\",\n    \"category\": \"coding-agent project memory\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Neoswarm\",\n    \"url\": \"https://neoswarm.dev/\",\n    \"description\": \"Neovim-based environment for controlling AI coding agents from inside the editor: agent sessions, orchestration and review without leaving Neovim.\",\n    \"release_date\": \"2026-08-26\",\n    \"category\": \"IDE-integrated agent control (Neovim)\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"TheGitAI\",\n    \"url\": \"https://thegit.ai\",\n    \"description\": \"Model-agnostic coding agent for your terminal that works with any LLM provider.\",\n    \"release_date\": \"2026-08-25\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Oynix\",\n    \"url\": \"https://oynix.dev\",\n    \"description\": \"Local tool that makes your coding agent aware of your whole codebase by indexing it on-device, no cloud needed.\",\n    \"release_date\": \"2026-08-25\",\n    \"category\": \"agent context/memory tooling\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Slopp