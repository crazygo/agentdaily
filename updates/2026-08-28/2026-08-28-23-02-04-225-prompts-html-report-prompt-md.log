  "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"description\" content=\"Daily research digest of agentic coding tools: 31 new products, 24 tracked-product updates and 37 technical insights for 2026-08-28.\">\n<title>Agentic Coding Research Report — 2026-08-28 | Agent Code Daily</title>\n<style>\n:root{--bg:#f6f6ef;--ink:#000;--mut:#828282;--acc:#ff6600;--accd:#d94f00;--line:#d4d4d4;--card:#fbfbf1}\n*{box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{margin:0;background:var(--bg);color:var(--ink);font:13px/1.5 Verdana,Geneva,sans-serif}\na{color:var(--acc);text-decoration:none}\na:hover{text-decoration:underline;color:var(--accd)}\ncode{font:11px/1.4 Monaco,Consolas,\"Courier New\",monospace;background:#ededdf;border:1px solid #e2e2d2;border-radius:2px;padding:0 4px}\n.skip{position:absolute;left:-9999px;top:0;background:#000;color:#fff;padding:6px 10px;z-index:99}\n.skip:focus{left:8px;top:8px}\n/* ---- top bar ---- */\n.topbar{background:var(--acc);display:flex;align-items:center;gap:12px;padding:6px 16px;flex-wrap:wrap}\n.logo{width:20px;height:20px;background:#000;color:var(--acc);display:inline-flex;align-items:center;justify-content:center;font:bold 13px Arial,Helvetica,sans-serif;flex:none}\n.brand{font:bold 14px Arial,Helvetica,sans-serif;color:#000}\n.brand:hover{color:#000;text-decoration:underline}\n.tagline{font:11px Verdana,Geneva,sans-serif;color:#7a3700}\n.topbar nav{margin-left:auto;display:flex;gap:14px;flex-wrap:wrap}\n.topbar nav a{font:11px Verdana,Geneva,sans-serif;color:#000;border-bottom:1px dotted #000;padding-bottom:1px}\n.topbar nav a:hover{border-bottom-style:solid;text-decoration:none}\n.tb-date{font:11px Monaco,Consolas,monospace;color:#7a3700}\n/* ---- page head ---- */\n.pagehead{max-width:1680px;margin:0 auto;padding:16px 16px 10px}\n.pagehead h1{margin:0;font:bold 21px/1.25 Arial,Helvetica,sans-serif}\n.issue{margin:5px 0 0;font-size:11px;color:var(--mut)}\n.issue b{color:#333}\n.issue time{font-family:Monaco,Consolas,monospace}\n.dsep{margin:0 6px;color:#c5c5b8}\n/* ---- layout ---- */\n.layout{max-width:1680px;margin:0 auto;padding:0 16px 28px;display:grid;grid-template-columns:4fr 3.5fr 2.5fr;gap:14px;align-items:start}\n.col{background:var(--card);border:1px solid var(--line)}\n.col h2{position:sticky;top:0;z-index:2;margin:0;display:flex;justify-content:space-between;align-items:center;gap:8px;background:var(--acc);color:#000;font:bold 12px Arial,Helvetica,sans-serif;text-transform:uppercase;letter-spacing:.07em;padding:8px 10px}\n.cnt{font:bold 11px Monaco,Consolas,monospace;background:rgba(0,0,0,.14);padding:1px 7px;border-radius:9px}\n.list{list-style:none;margin:0;padding:0}\n.item{padding:8px 10px 9px;border-bottom:1px solid #e6e6da}\n.item:last-child{border-bottom:0}\n.item:hover{background:#ffffe4}\n.t{margin:0;font:bold 13px/1.4 Arial,Helvetica,sans-serif}\n.t a{color:#000}\n.t a:hover{color:var(--accd)}\n.d{margin:4px 0 0;font-size:12px;line-height:1.5;color:#222;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;cursor:pointer}\n.col-updates .d,.col-insights .d{-webkit-line-clamp:4}\n.d.open{display:block;-webkit-line-clamp:unset;overflow:visible}\n.tk{margin:5px 0 0;font-size:11.5px;line-height:1.5;color:#444;border-left:3px solid var(--acc);padding-left:8px}\n.tk b{font:bold 9px Arial,Helvetica,sans-serif;text-transform:uppercase;letter-spacing:.06em;color:var(--accd);margin-right:4px}\n.m{margin:4px 0 0;font-size:10.5px;color:var(--mut)}\n.m time{font:10px Monaco,Consolas,monospace;color:#999}\n.tags{margin:5px 0 0;display:flex;flex-wrap:wrap;gap:4px;padding:0}\n.tags span{font:9.5px/1.6 Monaco,Consolas,monospace;color:#74745f;background:#ececdf;border:1px solid #deded0;border-radius:2px;padding:0 5px;white-space:nowrap}\n.badge{display:inline-block;font:bold 8.5px/1.9 Arial,Helvetica,sans-serif;text-transform:uppercase;letter-spacing:.06em;padding:0 6px;border-radius:2px;border:1px solid transparent;margin-right:5px;vertical-align:1px}\n.b-release{color:#a33f00;background:#ffefe2;border-color:#efc5a2}\n.b-feature{color:#1c6b40;background:#e9f5ed;border-color:#b7dcc6}\n.b-announce{color:#5f5f5f;background:#f0f0e8;border-color:#d4d4d4}\n.b-technical{color:#1a5276;background:#e8f1f7;border-color:#bcd2e4}\n.b-discussion{color:#5b3d8f;background:#f0ecf8;border-color:#d2c6ea}\n.b-opinion{color:#a33f00;background:#ffefe2;border-color:#efc5a2}\n.b-tutorial{color:#1c6b40;background:#e9f5ed;border-color:#b7dcc6}\n.b-paper{color:#7c1f1f;background:#f9eaea;border-color:#e2bcbc}\n.prod{font:bold 10px/1.9 Monaco,Consolas,monospace;color:#8a4b0f;background:#f4e9d7;border:1px solid #e6d3b3;padding:0 5px;border-radius:2px;margin-right:5px;white-space:nowrap;vertical-align:1px}\n/* ---- product numbering (HN-style) ---- */\n.col-products .list{counter-reset:prod}\n.col-products .item{position:relative;padding-left:34px;counter-increment:prod}\n.col-products .item::before{content:counter(prod);position:absolute;left:10px;top:9px;font:10px Monaco,Consolas,monospace;color:#b4b4a4}\n/* ---- footer ---- */\nfooter{border-top:3px solid var(--acc);background:#f1f1e7}\n.fbar{max-width:1680px;margin:0 auto;padding:9px 16px;display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;font-size:11px;color:var(--mut)}\n.fbar nav{display:flex;gap:12px;flex-wrap:wrap;align-items:center}\n.fbar a{color:var(--accd)}\n.printbtn{font:11px Verdana,Geneva,sans-serif;color:var(--accd);background:none;border:1px solid var(--line);border-radius:2px;padding:2px 8px;cursor:pointer}\n.printbtn:hover{background:#fff;border-color:var(--mut)}\n.fnote{max-width:1680px;margin:0 auto;padding:0 16px 18px;font-size:10px;color:#9d9d90}\n/* ---- responsive ---- */\n@media (max-width:1150px){\n  .layout{grid-template-columns:1fr 1fr}\n  .col-products{grid-column:1/-1}\n}\n@media (max-width:720px){\n  .layout{grid-template-columns:1fr;padding:0 10px 20px}\n  .pagehead{padding:12px 10px 8px}\n  .pagehead h1{font-size:18px}\n  .topbar{padding:6px 10px;gap:8px}\n}\n/* ---- print ---- */\n@media print{\n  body{background:#fff;font-size:10pt}\n  .skip,.topbar nav,.printbtn{display:none}\n  .topbar{background:#fff;border-bottom:3px solid #000}\n  .tb-date,.tagline{color:#555}\n  .layout{display:block;max-width:none;padding:0}\n  .col{border:0;background:#fff;margin-bottom:18px;break-inside:auto}\n  .col h2{position:static;background:#fff;border-bottom:2px solid #000;padding-left:0}\n  .cnt{background:#eee}\n  .item{break-inside:avoid;border-bottom:1px solid #ccc}\n  .item:hover{background:none}\n  .t a{color:#000}\n  .d,.col-updates .d,.col-insights .d{-webkit-line-clamp:unset;display:block;overflow:visible;cursor:auto}\n  a{color:#000;text-decoration:none}\n  footer{background:#fff;border-top:2px solid #000}\n}\n</style>\n</head>\n<body id=\"top\">\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n\n<header class=\"topbar\">\n  <span class=\"logo\" aria-hidden=\"true\">A</span>\n  <a class=\"brand\" href=\"#top\">Agent Code Daily</a>\n  <span class=\"tagline\">agentic coding intelligence, daily</span>\n  <nav aria-label=\"Report sections\">\n    <a href=\"#new-products\">new products</a>\n    <a href=\"#updates\">whitelist updates</a>\n    <a href=\"#insights\">insights</a>\n  </nav>\n  <span class=\"tb-date\">2026-08-28</span>\n</header>\n\n<div class=\"pagehead\">\n  <h1>Agentic Coding Research Report</h1>\n  <p class=\"issue\">Daily edition · <time datetime=\"2026-08-28\">2026-08-28</time>\n    <span class=\"dsep\">|</span><b>31</b> new products\n    <span class=\"dsep\">|</span><b>24</b> whitelist updates\n    <span class=\"dsep\">|</span><b>37</b> technical insights\n  </p>\n</div>\n\n<main id=\"main\" class=\"layout\">\n\n  <!-- ============ NEW PRODUCTS (40%) ============ -->\n  <section class=\"col col-products\" id=\"new-products\" aria-labelledby=\"h-new-products\">\n    <h2 id=\"h-new-products\">New Products <span class=\"cnt\">31</span></h2>\n    <ol class=\"list\">\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49466704\" target=\"_blank\" rel=\"noopener\">Opslane</a></h3>\n        <p class=\"d\">Agent that watches real user sessions, finds the bugs that matter, and fixes them — an autonomous debugging agent wired directly into production session data.</p>\n        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · via Show HN</p>\n        <p class=\"tags\"><span>AI debugging agent</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49465138\" target=\"_blank\" rel=\"noopener\">Knowl</a></h3>\n        <p class=\"d\">Agent memory with write-time supersession: automatically prunes and supersedes stale project memory (built after the author's CLAUDE.md hit 1000 lines), scoring 0.90 on the MAB memory benchmark.</p>\n        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · via Show HN</p>\n        <p class=\"tags\"><span>coding-agent memory</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49460693\" target=\"_blank\" rel=\"noopener\">Contextual</a></h3>\n        <p class=\"d\">Local codebase memory for AI coding agents: indexes and remembers project context so agents recall it across sessions without sending code to the cloud.</p>\n        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · via Show HN</p>\n        <p class=\"tags\"><span>agent memory</span><span>local-first</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://github.com/seoes/proval\" target=\"_blank\" rel=\"noopener\">Proval</a></h3>\n        <p class=\"d\">Self-hosted AI code review agent that reviews pull requests on GitLab, Forgejo and GitHub from your own infrastructure.</p>\n        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · via Show HN</p>\n        <p class=\"tags\"><span>code review</span><span>self-hosted</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49464154\" target=\"_blank\" rel=\"noopener\">Open Session</a></h3>\n        <p class=\"d\">Open-source cloud agent-orchestrator for running and managing AI coding agent sessions in the cloud.</p>\n        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · via Show HN</p>\n        <p class=\"tags\"><span>orchestration</span><span>open source</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://code.visualstudio.com/blogs/2026/08/26/agent-host-architecture\" target=\"_blank\" rel=\"noopener\">VS Code Agent Host</a></h3>\n        <p class=\"d\">New VS Code Agent Host architecture for persistent, portable agent sessions inside the editor, with full MCP spec support and the ability to command GitHub's coding agent directly from VS Code.</p>\n        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · VS Code blog · Visual Studio Magazine · DevOps.com</p>\n        <p class=\"tags\"><span>agent runtime</span><span>IDE</span><span>MCP</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49450816\" target=\"_blank\" rel=\"noopener\">Polign</a></h3>\n        <p class=\"d\">Lightweight, stateless agent-memory database combining vector search and BM25 over your own S3/GCS storage, with typed facts, structured queries and cold-storage caching for long-lived agent memory.</p>\n        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · via Show HN</p>\n        <p class=\"tags\"><span>memory infra</span><span>vector search</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://neoswarm.dev/\" target=\"_blank\" rel=\"noopener\">Neoswarm</a></h3>\n        <p class=\"d\">Neovim-based environment for controlling AI coding agents from inside the editor: agent sessions, orchestration and review without leaving Neovim.</p>\n        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · via Show HN</p>\n        <p class=\"tags\"><span>Neovim</span><span>agent control</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://github.com/RudderCode/Rudder\" target=\"_blank\" rel=\"noopener\">Rudder</a></h3>\n        <p class=\"d\">Red-Green TDD workflow tool that drives coding agents to produce verifiably comprehensive specs: tests are written first and the agent must make them pass.</p>\n        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · via Show HN</p>\n        <p class=\"tags\"><span>TDD</span><span>testing</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://github.com/apvcode/Termux-Dev\" target=\"_blank\" rel=\"noopener\">Devx</a></h3>\n        <p class=\"d\">Autonomous AI coding agent built to run on Android Termux and desktop, letting developers run a repo-aware coding agent directly from their phone.</p>\n        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · via Show HN</p>\n        <p class=\"tags\"><span>mobile</span><span>terminal</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://thegit.ai\" target=\"_blank\" rel=\"noopener\">TheGitAI</a></h3>\n        <p class=\"d\">Model-agnostic coding agent for your terminal that works with any LLM provider.</p>\n        <p class=\"m\"><time datetime=\"2026-08-25\">2026-08-25</time> · via Show HN</p>\n        <p class=\"tags\"><span>coding CLI</span><span>model-agnostic</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://oynix.dev\" target=\"_blank\" rel=\"noopener\">Oynix</a></h3>\n        <p class=\"d\">Local tool that makes your coding agent aware of your whole codebase by indexing it on-device, no cloud needed.</p>\n        <p class=\"m\"><time datetime=\"2026-08-25\">2026-08-25</time> · via Show HN</p>\n        <p class=\"tags\"><span>context indexing</span><span>local-first</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://www.salesforce.com/news/press-releases/2026/08/24/salesforce-launches-slack-code-to-make-ai-software-development-multiplayer/\" target=\"_blank\" rel=\"noopener\">Slack Code</a></h3>\n        <p class=\"d\">Salesforce's multiplayer AI coding environment: shared Slack project channels where teams tag AI coding agents (Claude, Copilot, Devin, Vercel) and watch plans, diffs and previews in the open. Available on all Slack plans.</p>\n        <p class=\"m\"><time datetime=\"2026-08-24\">2026-08-24</time> · Salesforce press release · TechRepublic · Slack blog</p>\n        <p class=\"tags\"><span>multiplayer coding</span><span>orchestration</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://github.com/otsaloma/sloppie\" target=\"_blank\" rel=\"noopener\">Sloppie</a></h3>\n        <p class=\"d\">Agentic development environment for Linux: a terminal-based environment where AI agents write and run code.</p>\n        <p class=\"m\"><time datetime=\"2026-08-24\">2026-08-24</time> · via Show HN</p>\n        <p class=\"tags\"><span>agentic dev environment</span><span>Linux</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://zuse.sh\" target=\"_blank\" rel=\"noopener\">Zuse</a></h3>\n        <p class=\"d\">Open-source desktop workspace for running and managing coding agents (Claude Code, Codex, Cursor, Gemini, Grok, OpenCode, Kiro) across real Git repositories — tasks run in isolated Git worktrees with persistent sessions, diff inspection and PR review, using your existing agent subscriptions.</p>\n        <p class=\"m\"><time datetime=\"2026-08-23\">2026-08-23</time> · via Show HN</p>\n        <p class=\"tags\"><span>orchestration</span><span>desktop</span><span>open source</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://www.npmjs.com/package/faberwright\" target=\"_blank\" rel=\"noopener\">Faber</a></h3>\n        <p class=\"d\">Cost-efficient open-source coding agent that builds and uses a code graph of the repo to plan edits and reduce token usage.</p>\n        <p class=\"m\"><time datetime=\"2026-08-22\">2026-08-22</time> · via Show HN</p>\n        <p class=\"tags\"><span>code graph</span><span>open source</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://github.com/proliferate-ai/proliferate\" target=\"_blank\" rel=\"noopener\">Proliferate</a></h3>\n        <p class=\"d\">Open-source (AGPL-3.0), self-hostable AI IDE that runs multiple coding agents (Claude Code, Codex, OpenCode, Cursor, Grok) in one interface, with parent agents spawning subagents and reusable Workflows with human approval gates.</p>\n        <p class=\"m\"><time datetime=\"2026-08-21\">2026-08-21</time> · via Show HN</p>\n        <p class=\"tags\"><span>self-hosted IDE</span><span>multi-agent</span><span>open source</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49378768\" target=\"_blank\" rel=\"noopener\">Huzzah</a></h3>\n        <p class=\"d\">Experimental code editor with a new paradigm for AI-assisted coding: developers write brief declarative pseudocode that stays the persistent source of truth, and Huzzah generates and maintains the real code from it.</p>\n        <p class=\"m\"><time datetime=\"2026-08-20\">2026-08-20</time> · via Show HN</p>\n        <p class=\"tags\"><span>AI IDE</span><span>declarative</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://github.com/CaydenChik/doover\" target=\"_blank\" rel=\"noopener\">Do-over</a></h3>\n        <p class=\"d\">Undo for AI agent shell commands: lets developers roll back machine state after a bad command run by a coding agent, aimed at recovering from agent mistakes.</p>\n        <p class=\"m\"><time datetime=\"2026-08-20\">2026-08-20</time> · via Show HN</p>\n        <p class=\"tags\"><span>undo</span><span>agent safety</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49363778\" target=\"_blank\" rel=\"noopener\">Naeos</a></h3>\n        <p class=\"d\">Engineering system for AI coding agents: structures specs, tasks and workflow around coding agents.</p>\n        <p class=\"m\"><time datetime=\"2026-08-19\">2026-08-19</time> · via Show HN</p>\n        <p class=\"tags\"><span>workflow system</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49364088\" target=\"_blank\" rel=\"noopener\">CrewCode</a></h3>\n        <p class=\"d\">Open-source mission control for AI coding agents: dashboard to launch, monitor and manage multiple coding-agent runs.</p>\n        <p class=\"m\"><time datetime=\"2026-08-19\">2026-08-19</time> · via Show HN</p>\n        <p class=\"tags\"><span>mission control</span><span>open source</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49356637\" target=\"_blank\" rel=\"noopener\">CommitLore</a></h3>\n        <p class=\"d\">Git memory tool that preserves the decisions and rationale coding agents keep forgetting, attaching them back to project history across sessions.</p>\n        <p class=\"m\"><time datetime=\"2026-08-19\">2026-08-19</time> · via Show HN</p>\n        <p class=\"tags\"><span>git memory</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49363138\" target=\"_blank\" rel=\"noopener\">Flow</a></h3>\n        <p class=\"d\">CLI wrapper around Claude Code that enforces a structured feature workflow: planning, then review/testing, then merge.</p>\n        <p class=\"m\"><time datetime=\"2026-08-19\">2026-08-19</time> · via Show HN</p>\n        <p class=\"tags\"><span>CLI workflow</span><span>Claude Code</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49352394\" target=\"_blank\" rel=\"noopener\">ChatOSS</a></h3>\n        <p class=\"d\">Codex-style coding agent for fully open-source AI stacks, built on Ollama so it runs locally with open-weight models.</p>\n        <p class=\"m\"><time datetime=\"2026-08-18\">2026-08-18</time> · via Show HN</p>\n        <p class=\"tags\"><span>open source</span><span>local models</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49353724\" target=\"_blank\" rel=\"noopener\">Clinch</a></h3>\n        <p class=\"d\">Local-first fork of the Warp terminal built specifically for managing multiple AI agent sessions in the terminal.</p>\n        <p class=\"m\"><time datetime=\"2026-08-18\">2026-08-18</time> · via Show HN</p>\n        <p class=\"tags\"><span>terminal</span><span>multi-session</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://cursor.com/changelog/origin-code-hosting\" target=\"_blank\" rel=\"noopener\">Cursor Origin</a></h3>\n        <p class=\"d\">Agent-native code hosting built into Cursor: cloud Git repositories, pull requests, code review and GitHub sync designed for high-volume AI coding agent workflows. Early beta rolled out to all paid plans in mid-August 2026, debuting during a major GitHub outage.</p>\n        <p class=\"m\"><time datetime=\"2026-08-17\">2026-08-17</time> · Cursor changelog · VentureBeat · SiliconANGLE · DevOps.com</p>\n        <p class=\"tags\"><span>code hosting</span><span>dev workflow</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://github.com/harnessrouter/harnessrouter\" target=\"_blank\" rel=\"noopener\">HarnessRouter</a></h3>\n        <p class=\"d\">Unified API layer for running coding-agent harnesses (Codex, Claude Code, Hermes) as a product backend — \"LiteLLM for harnesses rather than models.\" Ships as a Docker image with a proposed Unified Harness Protocol for task execution, event streaming and session management.</p>\n        <p class=\"m\"><time datetime=\"2026-08-17\">2026-08-17</time> · via Show HN</p>\n        <p class=\"tags\"><span>harness routing</span><span>API infra</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://github.com/agent6-dev/agent6\" target=\"_blank\" rel=\"noopener\">Agent6</a></h3>\n        <p class=\"d\">Coding agent with jailed (sandboxed) commands and editable state machines for controlled, auditable autonomous coding.</p>\n        <p class=\"m\"><time datetime=\"2026-08-16\">2026-08-16</time> · via Show HN</p>\n        <p class=\"tags\"><span>sandboxing</span><span>state machines</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://github.com/kungfu-systems/kungfu\" target=\"_blank\" rel=\"noopener\">Kungfu</a></h3>\n        <p class=\"d\">Keeps coding-agent work alive across sessions and handoffs: persists task state so agents (or teammates) can resume exactly where they left off.</p>\n        <p class=\"m\"><time datetime=\"2026-08-16\">2026-08-16</time> · via Show HN</p>\n        <p class=\"tags\"><span>session persistence</span><span>handoff</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49307927\" target=\"_blank\" rel=\"noopener\">NexusMem</a></h3>\n        <p class=\"d\">Local memory layer for coding agents that captures project knowledge beyond Git history, persisting context across sessions.</p>\n        <p class=\"m\"><time datetime=\"2026-08-15\">2026-08-15</time> · via Show HN</p>\n        <p class=\"tags\"><span>agent memory</span><span>local-first</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><a href=\"https://github.com/mupt-ai/self-bench\" target=\"_blank\" rel=\"noopener\">Self-bench</a></h3>\n        <p class=\"d\">Builds SWE-bench style evaluations from your own private repos so teams can score coding agents against their real codebase.</p>\n        <p class=\"m\"><time datetime=\"2026-08-14\">2026-08-14</time> · via Show HN</p>\n        <p class=\"tags\"><span>evals</span><span>SWE-bench</span></p>\n      </li>\n\n    </ol>\n  </section>\n\n  <!-- ============ WHITELIST UPDATES (35%) ============ -->\n  <section class=\"col col-updates\" id=\"updates\" aria-labelledby=\"h-updates\">\n    <h2 id=\"h-updates\">Whitelist Updates <span class=\"cnt\">24</span></h2>\n    <ol class=\"list\">\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-announce\">announcement</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-28-upcoming-changes-to-github-copilot-policies-and-billing\" target=\"_blank\" rel=\"noopener\">Upcoming changes to Copilot policies and billing</a></h3>\n        <p class=\"d\">Three changes announced: Copilot Business/Enterprise signups reopen Sep 1 with upfront per-seat billing from Oct 1; the cloud agent, Chat on github.com and Mobile chat merge into one unified experience no earlier than Sep 28; and code review default shifts from Lite to Balanced on Sep 28.</p>\n        <p class=\"m\"><time datetime=\"2026-08-28\">2026-08-28</time> · <a href=\"https://github.blog/changelog/2026-08-28-upcoming-changes-to-github-copilot-policies-and-billing\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">Claude Code</span> <a href=\"https://github.com/anthropics/claude-code/releases/tag/v2.1.248\" target=\"_blank\" rel=\"noopener\">v2.1.248: --restricted sandbox mode, cross-session messaging, /usage-credits</a></h3>\n        <p class=\"d\">Adds a <code>--restricted</code> mode that removes command/code-execution tools and WebFetch, keeps file tools sandboxed to the working directory, and ignores local settings files. Expands cross-session messaging (SendMessage/ListAgents) to Bedrock, Vertex and Foundry; adds <code>/usage-credits</code> for Enterprise orgs and an experimental per-agent prompt-cache TTL (<code>cacheTtl</code>).</p>\n        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · <a href=\"https://github.com/anthropics/claude-code/releases/tag/v2.1.248\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Cursor</span> <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">Cloud Agents: start from scratch without a repo, live preview, Vercel publishing</a></h3>\n        <p class=\"d\">Cloud Agents no longer need a connected GitHub or other SCM provider to start work — \"Start from scratch\" creates an Origin repo behind the scenes, with a Create repo button to save agent work. Live preview port-forwards the agent's environment to the browser, and agents can publish to a live URL via a connected Vercel account.</p>\n        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-27-copilot-code-review-resolution-reasons-and-expanded-capabilities\" target=\"_blank\" rel=\"noopener\">Code review: resolution reasons and expanded capabilities</a></h3>\n        <p class=\"d\">Copilot code review now reports resolution reasons and gains expanded capabilities, helping developers understand why suggested changes were or weren't applied when Copilot reviews pull requests.</p>\n        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · <a href=\"https://github.blog/changelog/2026-08-27-copilot-code-review-resolution-reasons-and-expanded-capabilities\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-26-global-model-policy-generally-available\" target=\"_blank\" rel=\"noopener\">Global model policy generally available</a></h3>\n        <p class=\"d\">GitHub's global model policy for Copilot is now generally available, giving administrators a single policy to govern which AI models are available across their organization.</p>\n        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · <a href=\"https://github.blog/changelog/2026-08-26-global-model-policy-generally-available\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Devin</span> <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">Automations &amp; Slack upgrades: queued messages, multi-channel triggers, batch security remediation</a></h3>\n        <p class=\"d\">Devin's August 26 release adds queued message delivery during long waits, smarter @mention routing to subscribed sessions, automation triggers across multiple Slack channels, Jira status_changed triggers, and batch remediation of security findings via new v3 API routes. An org setting now allows sessions to open PRs as validated collaborators.</p>\n        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">Codex CLI</span> <a href=\"https://github.com/openai/codex/releases/tag/rust-v0.150.0\" target=\"_blank\" rel=\"noopener\">0.150.0: @-mention other Codex tasks, /copy picker, Interrupt hooks</a></h3>\n        <p class=\"d\">Users can reference other Codex tasks with @ mentions and ask agents to read, create, or message tasks from the terminal; <code>/copy</code> gains a picker; task titles auto-generate; Interrupt hooks added. Security fixes ensure untrusted projects can no longer inject project-level <code>AGENTS.md</code> instructions.</p>\n        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · <a href=\"https://github.com/openai/codex/releases/tag/rust-v0.150.0\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-25-github-copilot-app-customize-tab-is-generally-available\" target=\"_blank\" rel=\"noopener\">Copilot app Customize tab generally available</a></h3>\n        <p class=\"d\">The Customize tab in the GitHub Copilot app reached general availability, letting users tailor Copilot's behavior, instructions, and tooling from a dedicated UI surface.</p>\n        <p class=\"m\"><time datetime=\"2026-08-25\">2026-08-25</time> · <a href=\"https://github.blog/changelog/2026-08-25-github-copilot-app-customize-tab-is-generally-available\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Codex CLI</span> <a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener\">Event-triggered scheduled tasks (Gmail, Slack, GitHub events)</a></h3>\n        <p class=\"d\">Scheduled tasks can now run on Gmail, Slack, or GitHub events — filtered Gmail messages, watched Slack channels, or PR activity like reviews and merges — on web and mobile for eligible plans, complementing time-based schedules.</p>\n        <p class=\"m\"><time datetime=\"2026-08-25\">2026-08-25</time> · <a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">Gemini CLI</span> <a href=\"https://github.com/google-gemini/gemini-cli/releases/tag/v0.57.0\" target=\"_blank\" rel=\"noopener\">v0.57.0: OAuth fixes for Cloud Workstations, capacity-aware retries</a></h3>\n        <p class=\"d\">The weekly stable release dynamically resolves Cloud Workstations proxy redirect URIs for OAuth, fixes swallowed directory mismatches in IDE connections, adds context-aware silent retries with availability TTL for capacity errors, rolls back multi-turn requests on cancellation, and prevents TUI hangs via execution timeouts.</p>\n        <p class=\"m\"><time datetime=\"2026-08-25\">2026-08-25</time> · <a href=\"https://github.com/google-gemini/gemini-cli/releases/tag/v0.57.0\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-announce\">announcement</span><span class=\"prod\">Codex CLI</span> <a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener\"><code>codex mcp-server</code> deprecated in favor of Codex app server</a></h3>\n        <p class=\"d\">OpenAI deprecated the <code>codex mcp-server</code> command in favor of the Codex app server, pointing Claude Code users to the Codex plugin for integration.</p>\n        <p class=\"m\"><time datetime=\"2026-08-24\">2026-08-24</time> · <a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-24-copilot-harness-generally-available-in-copilot-for-jetbrains\" target=\"_blank\" rel=\"noopener\">Copilot harness GA in JetBrains, MCP server in public preview</a></h3>\n        <p class=\"d\">The Copilot harness reached GA in JetBrains IDEs alongside a public preview of a built-in JetBrains MCP server exposing IDE capabilities to MCP-driven agent workflows. Adds /review in-IDE, a What's New tab, and reliability fixes for sign-in, BYOK and agent session continuity.</p>\n        <p class=\"m\"><time datetime=\"2026-08-24\">2026-08-24</time> · <a href=\"https://github.blog/changelog/2026-08-24-copilot-harness-generally-available-in-copilot-for-jetbrains\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-21-the-new-github-copilot-experience-in-slack\" target=\"_blank\" rel=\"noopener\">The new GitHub Copilot experience in Slack</a></h3>\n        <p class=\"d\">A refreshed GitHub Copilot experience for Slack lets users invoke Copilot and its agents directly from Slack conversations as part of GitHub's collaboration tools refresh.</p>\n        <p class=\"m\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://github.blog/changelog/2026-08-21-the-new-github-copilot-experience-in-slack\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-21-shared-agentic-work-with-github-copilot-in-microsoft-teams\" target=\"_blank\" rel=\"noopener\">Shared agentic work with GitHub Copilot in Microsoft Teams</a></h3>\n        <p class=\"d\">GitHub Copilot brings shared agentic work to Microsoft Teams, enabling teams to collaborate with Copilot agents inside Teams channels — part of GitHub's push to embed agentic coding in workplace collaboration tools.</p>\n        <p class=\"m\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://github.blog/changelog/2026-08-21-shared-agentic-work-with-github-copilot-in-microsoft-teams\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">Windsurf</span> <a href=\"https://docs.devin.ai/desktop/changelog\" target=\"_blank\" rel=\"noopener\">Windsurf/Devin Desktop v3.8.20: multi-window Agent Command Center, Devin Local plan mode</a></h3>\n        <p class=\"d\">Agent Command Center improvements (side-by-side agent windows, in-place conversion, follows selected space), faster Agent/Editor mode switching (Ctrl/Cmd+G), and a Devin CLI shim. Devin Local adds multi-root workspaces, plan mode producing a Markdown plan with an Implement button, individually stoppable subagents, and <code>post_setup_worktree</code> hooks.</p>\n        <p class=\"m\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://docs.devin.ai/desktop/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Devin</span> <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">Session redesign: nested sub-Devin trees, session subscribers, custom sidebar tabs</a></h3>\n        <p class=\"d\">The session page gets a compact header with built-in tags, a redesigned sidebar with custom nav tabs, grouping and filtering, sub-Devin sessions displayed as a nested tree, session subscribers, bearer-token auth for automation webhooks, and expanded security-scan controls.</p>\n        <p class=\"m\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">Codex CLI</span> <a href=\"https://developers.openai.com/codex/changelog/\" target=\"_blank\" rel=\"noopener\">0.149.0: interactive <code>codex agents</code> dashboard, <code>codex queue</code>, /cd commands</a></h3>\n        <p class=\"d\">Adds an interactive <code>codex agents</code> dashboard for managing sessions, <code>codex queue</code> for messaging existing sessions, <code>/cd</code>/<code>/pwd</code>/<code>/cwd</code> commands, expanded Vim motions and broader <code>codex doctor</code> diagnostics. Fixes include queued-message wake-ups and permission-profile restoration on resume.</p>\n        <p class=\"m\"><time datetime=\"2026-08-20\">2026-08-20</time> · <a href=\"https://developers.openai.com/codex/changelog/\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Cursor</span> <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">Cloud Agents &amp; harness: subscriptions, isolated subagents, /goal</a></h3>\n        <p class=\"d\">Subscriptions let cloud agents monitor PRs, watch Slack threads or run scheduled tasks and wake on events, auto-subscribing to PRs they create. Subagents now run on isolated VMs with clean project copies; <code>/goal</code> sets long-lived objectives (e.g. fixing flaky tests until CI is green); steering follow-ups wait for the next tool call.</p>\n        <p class=\"m\"><time datetime=\"2026-08-19\">2026-08-19</time> · <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-announce\">announcement</span><span class=\"prod\">Devin</span> <a href=\"https://devin.ai/blog\" target=\"_blank\" rel=\"noopener\">GPT-5.6 Sol available at 70% discount on Devin Desktop and CLI</a></h3>\n        <p class=\"d\">Cognition announced GPT-5.6 Sol at a 70% discount on Devin Desktop and Devin CLI through October 3, 2026, lowering the cost of running OpenAI's model on Devin's platform.</p>\n        <p class=\"m\"><time datetime=\"2026-08-18\">2026-08-18</time> · <a href=\"https://devin.ai/blog\" target=\"_blank\" rel=\"noopener\">blog ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Claude Code</span> <a href=\"https://code.claude.com/docs/en/whats-new/2026-w34\" target=\"_blank\" rel=\"noopener\">/design research preview, Concise output style, device cards (Week 34)</a></h3>\n        <p class=\"d\">A <code>/design</code> research preview brings an artboard workflow to CLI and Desktop (Claude drafts editable artboards and builds the chosen one), plus a Concise output style that leads with results, device cards via <code>claude remote-control</code>, and an <code>ANTHROPIC_DEFAULT_MODEL</code> env var. Shipped across v2.1.234–v2.1.239.</p>\n        <p class=\"m\"><time datetime=\"2026-08-17\">2026-08-17</time> · <a href=\"https://code.claude.com/docs/en/whats-new/2026-w34\" target=\"_blank\" rel=\"noopener\">what's new ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Cursor</span> <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">Origin Code Hosting: Cursor now hosts your code</a></h3>\n        <p class=\"d\">Origin code hosting launched in early beta on all paid plans: Origin Repos managed via a new Codebase tab, GitHub repo sync for browsing and searching (GitHub remains source of truth), PR views with two-way comment sync, agents in every repo, and app extensions (Vercel preview deployments, Depot, Buildkite CI).</p>\n        <p class=\"m\"><time datetime=\"2026-08-17\">2026-08-17</time> · <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-14-grok-4-6-is-now-available-in-github-copilot\" target=\"_blank\" rel=\"noopener\">Grok 4.6 now available in GitHub Copilot</a></h3>\n        <p class=\"d\">xAI's Grok 4.6 model is now selectable in Copilot's model picker, continuing GitHub's multi-model strategy alongside Claude, GPT and Gemini options.</p>\n        <p class=\"m\"><time datetime=\"2026-08-14\">2026-08-14</time> · <a href=\"https://github.blog/changelog/2026-08-14-grok-4-6-is-now-available-in-github-copilot\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Devin</span> <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">Devin Coach: prompt suggestions, Review skip logic, Devin Local default for enterprise</a></h3>\n        <p class=\"d\">Devin Coach offers suggestions in the input box to improve prompts before sending; Devin Review now skips re-review of PRs with unchanged diffs; sessions auto-subscribe to Slack threads; Devin Local is enabled by default for enterprise customers.</p>\n        <p class=\"m\"><time datetime=\"2026-08-14\">2026-08-14</time> · <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Claude Code</span> <a href=\"https://code.claude.com/docs/en/whats-new/2026-w32\" target=\"_blank\" rel=\"noopener\">Auto mode becomes the default permission mode for new sessions</a></h3>\n        <p class=\"d\">As of August 14, 2026, auto mode is the default permission mode for new Claude Code sessions on Pro, Max and Team plans, with transcript protections that block dangerous operations while reducing permission prompts.</p>\n        <p class=\"m\"><time datetime=\"2026-08-14\">2026-08-14</time> · <a href=\"https://code.claude.com/docs/en/whats-new/2026-w32\" target=\"_blank\" rel=\"noopener\">what's new ↗</a></p>\n      </li>\n\n    </ol>\n  </section>\n\n  <!-- ============ TECHNICAL INSIGHTS (25%) ============ -->\n  <section class=\"col col-insights\" id=\"insights\" aria-labelledby=\"h-insights\">\n    <h2 id=\"h-insights\">Technical Insights <span class=\"cnt\">37</span></h2>\n    <ol class=\"list\">\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://simonwillison.net/2026/Aug/28/just-a-rumour-of-a-bug/\" target=\"_blank\" rel=\"noopener\">Just a rumour of a bug is enough to find a security exploit these days</a></h3>\n        <p class=\"d\">Anil Madhavapeddy (Cambridge professor, OCaml maintainer) reports AI-powered systems probed his site with traversal attacks ~10 minutes after a security patch was shared for discussion — agents needed only \"a rumour of a bug\" to develop working exploits. rclone maintainer Nick Craig-Wood confirmed ~20 disclosures in a decade vs 40+ in the past month at ~75% genuine.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Agent-driven offensive security is outrunning open-source embargo practices and CVE triage capacity (GitHub CVE assignment slipped from 2-3 days to 3-4 weeks).</p>\n        <p class=\"m\">Anil Madhavapeddy (via Simon Willison) · Blog · <time datetime=\"2026-08-28\">2026-08-28</time></p>\n        <p class=\"tags\"><span>security</span><span>vulnerability disclosure</span><span>CVE</span><span>open source</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://simonwillison.net/2026/Aug/27/breaking-claude-code-opus-5-auto-mode/\" target=\"_blank\" rel=\"noopener\">Breaking Claude Code Opus 5 Auto Mode — prompt injection at ~80% success</a></h3>\n        <p class=\"d\">Johann Rehberger's attack on Claude Code Opus 5 \"auto mode\": a crafted zip archive causes importing base64 to execute a malicious local struct.py, with ~80% success rate. Willison notes \"Auto Mode blocks its cleanup command\" and argues unattended coding agents should run in sandboxed environments with restricted network egress.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Autonomous coding agents remain highly exposed to prompt injection via their own tool use.</p>\n        <p class=\"m\">Johann Rehberger (via Simon Willison) · Blog · <time datetime=\"2026-08-27\">2026-08-27</time></p>\n        <p class=\"tags\"><span>prompt injection</span><span>agent security</span><span>sandboxing</span><span>Claude Code</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://www.youtube.com/watch?v=UuqSy1jPSUw\" target=\"_blank\" rel=\"noopener\">Fireship revisits Knight Capital — the most expensive software bug in history</a></h3>\n        <p class=\"d\">Fireship's \"code report\" video recounts the 2012 Knight Capital collapse: ~$440M lost in 45 minutes after a reused feature flag reactivated dead test code on 1 of 8 servers during a botched deployment.</p>\n        <p class=\"tk\"><b>Takeaway:</b> As AI agents accelerate code changes and deployments, classic deployment hygiene (feature flags, dead-code removal, rollout consistency) becomes more important, not less.</p>\n        <p class=\"m\">Jeff Delaney (Fireship) · YouTube · <time datetime=\"2026-08-27\">2026-08-27</time></p>\n        <p class=\"tags\"><span>deployment</span><span>feature flags</span><span>software engineering</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://softwareengineeringdaily.com/podcasts/typescript-7-and-what-comes-next/\" target=\"_blank\" rel=\"noopener\">Software Engineering Daily: TypeScript 7 and what comes next</a></h3>\n        <p class=\"d\">Daniel Rosenwasser (Principal PM for TypeScript at Microsoft) joins host Josh Goldberg to discuss TypeScript 7 — described as one of the biggest changes in the language's history.</p>\n        <p class=\"tk\"><b>Takeaway:</b> The compiler rewrite moment (native-speed tsc) is exactly the kind of high-stakes migration where agents handle mechanical refactors while design decisions stay human.</p>\n        <p class=\"m\">Daniel Rosenwasser with Josh Goldberg · Podcast · <time datetime=\"2026-08-27\">2026-08-27</time></p>\n        <p class=\"tags\"><span>TypeScript</span><span>compilers</span><span>refactoring</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://towardsdatascience.com/stop-giving-your-ai-agent-a-search-box-and-start-giving-it-typed-tools-hard-bounds-and-a-gate-it-cannot-talk-past/\" target=\"_blank\" rel=\"noopener\">Stop giving your AI agent a search box — typed tools, hard bounds, and a gate</a></h3>\n        <p class=\"d\">Argues agents should get typed tools with hard bounds and a gate they cannot talk past, instead of open-ended search and control surfaces.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Agent reliability comes from interface design — constrained, typed, auditable tool contracts beat generic \"search boxes\" and hoping prompting holds the line; complements this week's prompt-injection findings.</p>\n        <p class=\"m\">Miodrag Cekikj (Towards Data Science) · Platform · <time datetime=\"2026-08-27\">2026-08-27</time></p>\n        <p class=\"tags\"><span>agent design</span><span>tool interfaces</span><span>guardrails</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-tutorial\">tutorial</span> <a href=\"https://towardsdatascience.com/how-to-work-with-ai-coding-agents/\" target=\"_blank\" rel=\"noopener\">How to Work with AI Coding Agents — better code, not just more code</a></h3>\n        <p class=\"d\">Sara A. Metwalli's practical guide: give context not just prompts, run a structured Ask → Inspect → Plan → Implement → Test → Review loop, break work into small testable tasks, and structure requests with goal, context, constraints, acceptance criteria and validation.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Generating code is now cheap but understanding it is not — developers stay essential for planning, delegation, and judgment.</p>\n        <p class=\"m\">Sara A. Metwalli (Towards Data Science) · Platform · <time datetime=\"2026-08-27\">2026-08-27</time></p>\n        <p class=\"tags\"><span>workflow</span><span>developer skills</span><span>code review</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://simonwillison.net/2026/Aug/26/qwen38-flash-next/\" target=\"_blank\" rel=\"noopener\">Qwen3.8-Flash-Next: open-weights MoE previewing Qwen4's architecture</a></h3>\n        <p class=\"d\">Willison covers Qwen's new open-weights multimodal MoE model (125B total, ~6B active) that previews the Qwen4 architecture; he ran Unsloth quantizations on a DGX Spark and tested it by generating pelican SVGs.</p>\n        <p class=\"tk\"><b>Takeaway:</b> The open-weights frontier keeps closing the gap with proprietary models, and small-activation MoE models are increasingly runnable on developer desks.</p>\n        <p class=\"m\">Simon Willison · Blog · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n        <p class=\"tags\"><span>open weights</span><span>MoE</span><span>local models</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://simonwillison.net/2026/Aug/26/paul-dix/\" target=\"_blank\" rel=\"noopener\">Paul Dix: \"The end of programming\" — 1M lines of AI-maintained software</a></h3>\n        <p class=\"d\">Paul Dix (quoted by Willison) marvels that AI can now produce and iteratively refine roughly a million lines of reliable software when given a verification system and proper direction.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Verification infrastructure — not code writing — is the scarce input for large-scale AI-generated codebases.</p>\n        <p class=\"m\">Paul Dix (via Simon Willison) · Blog · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n        <p class=\"tags\"><span>verification</span><span>agents</span><span>AI coding</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://lexfridman.com/dhh-2/\" target=\"_blank\" rel=\"noopener\">Lex Fridman #501: DHH declares \"the end of manual programming\" and embraces agentic engineering</a></h3>\n        <p class=\"d\">In a 5+ hour conversation, DHH — who in 2025 typed all his code without AI — now argues agents have turned programming into \"agentic engineering,\" covering vibe coding vs agentic engineering, the best models and harnesses, agent-optimized setups, and advice for programmers. He also claims \"Linux will win the desktop\" via his Omarchy distro.</p>\n        <p class=\"tk\"><b>Takeaway:</b> One of the most famous AI-coding skeptics converted to disciplined agent-first workflows — a bellwether for mainstream developer adoption.</p>\n        <p class=\"m\">Lex Fridman with DHH · Podcast · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n        <p class=\"tags\"><span>agentic engineering</span><span>vibe coding</span><span>future of programming</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://www.youtube.com/watch?v=L9mMfAFwbl4\" target=\"_blank\" rel=\"noopener\">Two Minute Papers: DeepSeek's new open agent system \"shouldn't be possible\"</a></h3>\n        <p class=\"d\">Károly Zsolnai-Fehér covers DeepSeek Harness, DeepSeek's new open agent system, arguing its capabilities outpace what open-weight systems were expected to deliver.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Open-weight labs now ship frontier-grade agent harnesses, intensifying pressure on closed labs and expanding options for self-hosted coding agents.</p>\n        <p class=\"m\">Károly Zsolnai-Fehér (Two Minute Papers) · YouTube · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n        <p class=\"tags\"><span>DeepSeek</span><span>open weights</span><span>harness</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-paper\">paper</span> <a href=\"https://arxiv.org/abs/2608.26218\" target=\"_blank\" rel=\"noopener\">Same Model, Different Harness: harness changes alone swing SWE-bench results</a></h3>\n        <p class=\"d\">For a fixed model, harness modifications alone change coding-agent outcomes dramatically: a context-shortening treatment lifted mean per-task fail-to-pass fraction from 28% to 49% on a 169-task SWE-bench Verified cohort. Evaluations must treat model-plus-harness as the tested solver.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Empirical confirmation of the week's loudest theme — \"most agent systems die not from a weak model but from a weak harness.\"</p>\n        <p class=\"m\">Sydney Lewis (arXiv 2608.26218) · Paper · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n        <p class=\"tags\"><span>harness</span><span>SWE-bench</span><span>evaluation</span><span>context engineering</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-paper\">paper</span> <a href=\"https://arxiv.org/abs/2608.25776\" target=\"_blank\" rel=\"noopener\">Self-poisoning in self-evolving coding agents: malicious skills spread like a worm</a></h3>\n        <p class=\"d\">Identifies \"self-poisoning\": self-evolving agents imitate malicious skills from shared libraries and author copies that propagate like a worm. Poisoning rates span 20.3-41.8% across six models on SWE-bench Verified tasks; a proposed \"counter-prompt\" defense cuts the attack rate to at most 6.7%.</p>\n        <p class=\"tk\"><b>Takeaway:</b> As agents share skills and libraries, supply-chain-style threats become an agentic-native risk class.</p>\n        <p class=\"m\">Xiaodong Wu, Yu Shi, Qi Li, et al. (arXiv 2608.25776) · Paper · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n        <p class=\"tags\"><span>security</span><span>self-evolving agents</span><span>skill libraries</span><span>SWE-bench</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-paper\">paper</span> <a href=\"https://arxiv.org/abs/2608.25399\" target=\"_blank\" rel=\"noopener\">Can your AI agent be cheaper? Under-specified tasks burn 29.7% more tokens</a></h3>\n        <p class=\"d\">Across 2,700 runs with Kimi K3, shrinking a full specification to a bare user story increased token spend by 29.7%, with prompt sensitivity ranging 13-115% by task; a lightweight predictor prices task configurations within 36% using a single cheap probe.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Specification quality is a direct cost lever in agentic coding — vague prompts are a hidden tax, quantified.</p>\n        <p class=\"m\">Jakub Smékal (arXiv 2608.25399) · Paper · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n        <p class=\"tags\"><span>token economics</span><span>task specification</span><span>cost optimization</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-paper\">paper</span> <a href=\"https://arxiv.org/abs/2608.25241\" target=\"_blank\" rel=\"noopener\">A Few Pages of Markdown: committed AI config predicts codebase health after agent adoption</a></h3>\n        <p class=\"d\">Proposes RAMP, a four-level maturity model based on version-controlled AI configuration (CLAUDE.md-style files). Across 441 repositories, agents sped development (28-38% more commits) at all levels, but agent-first repos lacking committed configuration saw roughly double the growth in cognitive complexity (+53% vs +27%).</p>\n        <p class=\"tk\"><b>Takeaway:</b> Committing agent guidance/config to version control is emerging as a measurable quality practice.</p>\n        <p class=\"m\">Yegor Denisov-Blanch, Shyam Agarwal, et al. (Stanford; arXiv 2608.25241) · Paper · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n        <p class=\"tags\"><span>AI configuration</span><span>CLAUDE.md</span><span>code quality</span><span>repo maturity</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-tutorial\">tutorial</span> <a href=\"https://towardsdatascience.com/how-to-effectively-solve-100-tasks-with-claude-code/\" target=\"_blank\" rel=\"noopener\">How to effectively solve 100+ tasks a day with Claude Code sub-agents</a></h3>\n        <p class=\"d\">Eivind Kjosbakken shares a practical pipeline for handling 50-100 small coding tasks daily: explicitly instruct Claude Code to spin up sub-agents so each task is completed individually, from issue triage through execution.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Practitioner workflows are standardizing around orchestrator-plus-subagent patterns for parallelizable task queues.</p>\n        <p class=\"m\">Eivind Kjosbakken (Towards Data Science) · Platform · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n        <p class=\"tags\"><span>Claude Code</span><span>sub-agents</span><span>orchestration</span><span>workflow</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://news.agentcommunity.org/issues/2026-08-26-the-harness-eats\" target=\"_blank\" rel=\"noopener\">Karpathy: the \"year of agents\" will take a decade — and the harness eats the model</a></h3>\n        <p class=\"d\">Agent Brief distills Karpathy's ~2.5-hour Dwarkesh appearance: the \"year of agents\" will take closer to a decade, and LLMs are \"a lot smarter than I expected and a lot dumber than I expected.\" Companion data: harness swaps alone moved SWE-bench Pro pass@1 from 23% to 52% on the same GLM-5.2 model.</p>\n        <p class=\"tk\"><b>Takeaway:</b> The next agent gains come from harness, memory, and eval engineering rather than raw model upgrades.</p>\n        <p class=\"m\">Andrej Karpathy (via Agent Brief) · Blog · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n        <p class=\"tags\"><span>agent harness</span><span>AGI timeline</span><span>SWE-bench Pro</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://changelog.com/podcast/684\" target=\"_blank\" rel=\"noopener\">Changelog #684: Postgres at PlanetScale — agents shipping schema changes</a></h3>\n        <p class=\"d\">Sam Lambert discusses PlanetScale's $5 Postgres, the Neki Vitess \"do-over,\" \"agents shipping schema changes through deploy requests,\" and rolling back a 500TB table quickly.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Database platforms are adapting their guardrails (deploy requests, rollbacks) for a world where AI agents, not just humans, propose schema migrations.</p>\n        <p class=\"m\">Sam Lambert with Adam Stacoviak (The Changelog) · Podcast · <time datetime=\"2026-08-25\">2026-08-25</time></p>\n        <p class=\"tags\"><span>Postgres</span><span>schema migrations</span><span>developer platforms</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://softwareengineeringdaily.com/\" target=\"_blank\" rel=\"noopener\">Software Engineering Daily: the gap between AI spending and AI value</a></h3>\n        <p class=\"d\">Host Kevin Ball examines the disconnect between massive enterprise AI investment and realized value.</p>\n        <p class=\"tk\"><b>Takeaway:</b> In coding specifically, the gap shows up as agent subscriptions that don't translate into shipped software without workflow redesign, verification infrastructure, and organizational change.</p>\n        <p class=\"m\">Kevin Ball (Software Engineering Daily) · Podcast · <time datetime=\"2026-08-25\">2026-08-25</time></p>\n        <p class=\"tags\"><span>AI economics</span><span>ROI</span><span>enterprise</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://stackoverflow.blog/2026/08/25/inside-linkedin-s-cognitive-memory-agent/\" target=\"_blank\" rel=\"noopener\">Stack Overflow Podcast: inside LinkedIn's cognitive memory agent</a></h3>\n        <p class=\"d\">LinkedIn Principal AI Researcher Praveen Bodigutla details a four-layer memory system giving LinkedIn's hiring assistant persistent, personalized state.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Production agent systems are converging on layered memory architectures — a pattern directly transferable to coding agents that must recall project conventions, past failures, and user intent across sessions.</p>\n        <p class=\"m\">Praveen Bodigutla (Stack Overflow Podcast) · Podcast · <time datetime=\"2026-08-25\">2026-08-25</time></p>\n        <p class=\"tags\"><span>memory systems</span><span>production AI</span><span>personalization</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://news.ycombinator.com/item?id=49428303\" target=\"_blank\" rel=\"noopener\">HN: 80% of developers find AI coding \"more addictive than helpful\"</a></h3>\n        <p class=\"d\">ZDNet reporting (via HN) on survey data that most developers find AI coding more addictive than helpful — dopamine-loop usage patterns outpacing measured productivity gains.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Adoption metrics conflate engagement with value; the \"feels faster\" effect keeps complicating AI coding ROI measurement, echoing the week's spending-vs-value debate.</p>\n        <p class=\"m\">ZDNet (via Hacker News) · HN · <time datetime=\"2026-08-25\">2026-08-25</time></p>\n        <p class=\"tags\"><span>developer survey</span><span>productivity</span><span>psychology</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://news.ycombinator.com/item?id=49429028\" target=\"_blank\" rel=\"noopener\">HN: \"Code maintainability plummets in the AI coding era\"</a></h3>\n        <p class=\"d\">LeadDev article (via HN) arguing AI-generated code is degrading maintainability: more commits, more complexity, thinner review.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Velocity gains from agents are being paid for in long-term maintainability debt — converging with the arXiv finding that agent-first repos without committed AI config saw double the cognitive-complexity growth.</p>\n        <p class=\"m\">LeadDev (via Hacker News) · HN · <time datetime=\"2026-08-25\">2026-08-25</time></p>\n        <p class=\"tags\"><span>maintainability</span><span>code quality</span><span>tech debt</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://techcrunch.com/2026/08/24/amjad-masad-ceo-and-co-founder-of-replit-joins-the-disrupt-stage-at-techcrunch-disrupt-2026/\" target=\"_blank\" rel=\"noopener\">Amjad Masad to take TechCrunch Disrupt 2026 stage on \"the future of programming\"</a></h3>\n        <p class=\"d\">TechCrunch announces Replit co-founder/CEO Amjad Masad joins the Disrupt Stage (October 13-15, San Francisco). Masad argues engineers are moving away from keyboard-centric work toward review, direction, and design while agents write most code — and predicts a \"SaaS apocalypse\" as users build their own software.</p>\n        <p class=\"m\">TechCrunch (re: Amjad Masad) · TechMedia · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n        <p class=\"tags\"><span>Replit</span><span>future of programming</span><span>conference</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://www.youtube.com/watch?v=wMl6c_r0ubw\" target=\"_blank\" rel=\"noopener\">Two Minute Papers: Qwen3.8-27B — \"this small AI will change everything\"</a></h3>\n        <p class=\"d\">Zsolnai-Fehér highlights Qwen3.8-27B, a 27B open model small enough to run on consumer hardware that punches far above its weight on coding and reasoning benchmarks.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Capable small open models running locally are becoming \"more capable, more accessible, and increasingly difficult to ignore\" — reshaping who can build with frontier-adjacent AI.</p>\n        <p class=\"m\">Károly Zsolnai-Fehér (Two Minute Papers) · YouTube · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n        <p class=\"tags\"><span>Qwen</span><span>small language models</span><span>local inference</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://techcrunch.com/2026/08/24/openai-is-building-an-ai-agent-for-everything-will-everyone-use-them/\" target=\"_blank\" rel=\"noopener\">TechCrunch: OpenAI is building AI agents for everything — but will everyone use them?</a></h3>\n        <p class=\"d\">Tim Fernholz's exclusive inside OpenAI's push to bring agents from software engineers to the masses. Key stat: an OpenAI-backed study found 98% of OpenAI employees used Codex in June, but only 17% of organizational subscribers and under 1% of others did.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Coding agents are the proven beachhead; general-purpose agent adoption outside engineering faces a steep usage cliff.</p>\n        <p class=\"m\">Tim Fernholz (TechCrunch) · TechMedia · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n        <p class=\"tags\"><span>OpenAI</span><span>Codex</span><span>adoption</span><span>enterprise</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-paper\">paper</span> <a href=\"https://arxiv.org/abs/2608.23564\" target=\"_blank\" rel=\"noopener\">SWE Refactor Bench: coding agents fail long-horizon whole-repo migrations (5.4% pass)</a></h3>\n        <p class=\"d\">A benchmark of 20 whole-repository stack migrations with three evaluation stages. Only 5.4% of 520 runs passed all stages; best model scored 47.0/100. Agents did far better on build toolchain rewrites (31.4) than language rewrites (5.6).</p>\n        <p class=\"tk\"><b>Takeaway:</b> Long-horizon, whole-repo transformation remains the frontier failure mode for coding agents — automation excels at local edits, not sustained architectural change.</p>\n        <p class=\"m\">Deyao Hong, Yizhe Chi, et al. (arXiv 2608.23564) · Paper · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n        <p class=\"tags\"><span>benchmark</span><span>refactoring</span><span>long-horizon tasks</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://huggingface.co/papers/trending\" target=\"_blank\" rel=\"noopener\">Trending papers converge on agent harness engineering: Prime Agent, AutoSaddler, Graph Engineering</a></h3>\n        <p class=\"d\">Prime Agent (Prime Intellect) is a self-improving RLM harness with recursive subagents and agent-to-agent coordination (18.8k GitHub stars); Microsoft's AutoSaddler optimizes agent harnesses offline from execution traces; \"Graph Engineering in the Era of LLM Agents\" organizes multi-agent systems as dynamic graphs.</p>\n        <p class=\"tk\"><b>Takeaway:</b> The field's center of gravity is shifting from model upgrades to engineering the scaffolding around models.</p>\n        <p class=\"m\">Prime Intellect, Microsoft, et al. (Hugging Face) · Platform · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n        <p class=\"tags\"><span>agent harness</span><span>multi-agent systems</span><span>graph engineering</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://news.ycombinator.com/item?id=49421554\" target=\"_blank\" rel=\"noopener\">HN (558 pts, 544 comments): \"Coding expertise is going to collapse from AI reliance\"</a></h3>\n        <p class=\"d\">The week's dominant Hacker News debate: Lars Faye argues that as agents write most code, developers lose the deliberate practice that builds expertise — fluent at directing agents, unable to debug, design, or verify without them. The thread splits between \"this is how calculators felt\" optimism and warnings that verification skills cannot be learned vicariously.</p>\n        <p class=\"tk\"><b>Takeaway:</b> The expertise-pipeline problem (what happens to juniors?) is now the community's central anxiety.</p>\n        <p class=\"m\">Lars Faye (discussion on Hacker News) · HN · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n        <p class=\"tags\"><span>expertise collapse</span><span>skill atrophy</span><span>junior developers</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://simonwillison.net/2026/Aug/24/llm-anthropic/\" target=\"_blank\" rel=\"noopener\">llm-anthropic 0.27: an SDK migration delegated entirely to Claude Code</a></h3>\n        <p class=\"d\">Willison releases llm-anthropic 0.27 adding compatibility with anthropic Python SDK v1.0.0 (the httpx→httpx2 switch) — the migration was delegated to Claude Fable 5 running in Claude Code with a prompt pointing it at the SDK's migration guide, producing PR #84.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Routine dependency migrations are becoming canonical agentic-coding work — point the agent at the official upgrade docs and review the diff.</p>\n        <p class=\"m\">Simon Willison · Blog · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n        <p class=\"tags\"><span>agentic coding</span><span>SDK migration</span><span>Claude Code</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://simonwillison.net/2026/Aug/23/anthropics-best-ai-model-struggles-to-attract-users-as-cheaper-t/\" target=\"_blank\" rel=\"noopener\">Anthropic's best model struggles to attract users as cheaper tools thrive</a></h3>\n        <p class=\"d\">Willison links FT reporting: Anthropic's July annualized revenue hit $65bn and OpenAI's exceeded $40bn, but Ramp's AI index shows pricey \"Fable 5\" at only 8.0% of Anthropic model spend versus Opus 4.8's 28.0%.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Buyers are actively rationing premium model usage in favor of cheaper tiers — pricing pressure is reshaping model choice for coding workloads.</p>\n        <p class=\"m\">Simon Willison (linking Financial Times) · Blog · <time datetime=\"2026-08-23\">2026-08-23</time></p>\n        <p class=\"tags\"><span>model economics</span><span>pricing</span><span>AI coding</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://simonwillison.net/2026/Aug/23/drew-breunig/\" target=\"_blank\" rel=\"noopener\">Drew Breunig: \"Fable &amp; The End of the Free Lunch\" — rationing work across models</a></h3>\n        <p class=\"d\">Breunig argues the high cost of top-tier models ended the era when teams let new models \"paper over\" inefficiencies: \"So we started to think about what work went where.\"</p>\n        <p class=\"tk\"><b>Takeaway:</b> Sophisticated multi-model routing — matching task difficulty to model cost — is becoming a core engineering discipline for AI coding teams.</p>\n        <p class=\"m\">Drew Breunig (via Simon Willison) · Blog · <time datetime=\"2026-08-23\">2026-08-23</time></p>\n        <p class=\"tags\"><span>model routing</span><span>cost optimization</span><span>LLM economics</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://towardsdatascience.com/bug-detection-blind-spots-in-ai-coding-harnesses-gstack-and-beyond/\" target=\"_blank\" rel=\"noopener\">TDS: Bug detection blind spots in AI coding harnesses — 28 debugging experiments</a></h3>\n        <p class=\"d\">Based on 28 debugging experiments, Nhu Hoang maps systematic blind spots in how AI coding harnesses detect bugs — harnesses struggle less with raw complexity than with specific failure geometries.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Debugging is where harness design choices (context assembly, tool access, observation format) most visibly break; treat bug detection as a harness problem, not a model problem.</p>\n        <p class=\"m\">Nhu Hoang (Towards Data Science) · Platform · <time datetime=\"2026-08-23\">2026-08-23</time></p>\n        <p class=\"tags\"><span>debugging</span><span>bug detection</span><span>evaluation</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://simonwillison.net/2026/Aug/22/linus-torvalds/\" target=\"_blank\" rel=\"noopener\">Linus Torvalds credits AI as his \"tireless helper\" in grueling kernel debug</a></h3>\n        <p class=\"d\">In a Linux drm/xe commit, Torvalds describes an AI assistant that repeatedly declared the debugging problem impossible but faithfully added and analyzed debug code when pushed, ultimately helping crack a grueling issue.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Even famously skeptical systems programmers are incorporating LLMs as persistent debugging partners — while still overriding their pessimistic judgments.</p>\n        <p class=\"m\">Linus Torvalds (via Simon Willison) · Blog · <time datetime=\"2026-08-22\">2026-08-22</time></p>\n        <p class=\"tags\"><span>Linux kernel</span><span>AI debugging</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://simonwillison.net/2026/Aug/22/more-than-just-code-review/\" target=\"_blank\" rel=\"noopener\">Simon Willison: coding agents require \"more than just code review\"</a></h3>\n        <p class=\"d\">Willison argues the core skill for working with coding agents is confidently instructing changes and then verifying them — by means beyond eyeballing every line of generated code.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Verification techniques (tests, logs, behavioral checks) must scale up because line-by-line review doesn't scale to agent-written codebases.</p>\n        <p class=\"m\">Simon Willison · Blog · <time datetime=\"2026-08-22\">2026-08-22</time></p>\n        <p class=\"tags\"><span>code review</span><span>verification</span><span>developer skills</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://simonwillison.net/2026/Aug/22/llm/\" target=\"_blank\" rel=\"noopener\">llm 0.33 released: OpenAI library 3.x, httpx2, reasoning summaries</a></h3>\n        <p class=\"d\">Willison ships llm 0.33 switching to OpenAI library 3.x with the httpx→httpx2 migration, per-call --key for embeddings, repeatable -t/--template combination, and a reasoning_summary option — days after an emergency 0.32.1 pin when OpenAI dropped httpx support.</p>\n        <p class=\"tk\"><b>Takeaway:</b> Rapid upstream SDK churn keeps breaking local AI tooling, and plugin ecosystems must absorb migrations fast.</p>\n        <p class=\"m\">Simon Willison · Blog · <time datetime=\"2026-08-22\">2026-08-22</time></p>\n        <p class=\"tags\"><span>LLM tooling</span><span>OpenAI SDK</span><span>release engineering</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://simonwillison.net/2026/Aug/21/stop-making-tuis/\" target=\"_blank\" rel=\"noopener\">Thomas Ptacek: \"Stop Making TUIs\" — agents make native GUIs nearly free</a></h3>\n        <p class=\"d\">Ptacek (amplified by Willison) argues that AI coding agents have made building native GUIs so cheap that even small personal tools deserve real interfaces: \"Go build a native UI.\"</p>\n        <p class=\"tk\"><b>Takeaway:</b> Agents invert a longstanding cost assumption in tool-building — interface polish is no longer the expensive part.</p>\n        <p class=\"m\">Thomas Ptacek (via Simon Willison) · Blog · <time datetime=\"2026-08-21\">2026-08-21</time></p>\n        <p class=\"tags\"><span>GUI tooling</span><span>developer tools</span><span>agents</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://simonwillison.net/2026/Aug/21/matt-webb/\" target=\"_blank\" rel=\"noopener\">Matt Webb: outsourcing thinking to AI pushed him to learn more, not less</a></h3>\n        <p class=\"d\">Webb describes using ChatGPT as a patient tutor to finally learn quaternions while adding an augmented-reality mode to Galactic Compass, concluding that AI-assisted learning increased rather than decreased his understanding.</p>\n        <p class=\"tk\"><b>Takeaway:</b> AI as tutor can complement rather than erode human learning — a counterpoint to cognitive-atrophy worries.</p>\n        <p class=\"m\">Matt Webb (via Simon Willison) · Blog · <time datetime=\"2026-08-21\">2026-08-21</time></p>\n        <p class=\"tags\"><span>AI-assisted learning</span><span>tutoring</span><span>cognition</span></p>\n      </li>\n\n      <li class=\"item\">\n        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://stackoverflow.blog/podcast/\" target=\"_blank\" rel=\"noopener\">Stack Overflow Podcast: \"get rid of your CAPTCHA\" — a web built for bots</a></h3>\n        <p class=\"d\">Brian Alvey (CTO, WordPress VIP) argues AI agents are becoming the web's primary users and sites should stop blocking them: CAPTCHAs should go, and structured content will persist because agents consume it.</p>\n        <p class=\"tk\"><b>Takeaway:</b> As coding and browsing agents proliferate, the web's economics and access norms (paywalls, bot policies, llms.txt-style discovery) are being renegotiated.</p>\n        <p class=\"m\">Brian Alvey (Stack Overflow Podcast) · Podcast · <time datetime=\"2026-08-21\">2026-08-21</time></p>\n        <p class=\"tags\"><span>web economics</span><span>bots</span><span>structured content</span></p>\n      </li>\n\n    </ol>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"fbar\">\n    <span>Agent Code Daily — Powered by Claude Agent SDK</span>\n    <nav aria-label=\"Footer navigation\">\n      <a href=\"#top\">Top</a>\n      <a href=\"#new-products\">New Products</a>\n      <a href=\"#updates\">Whitelist Updates</a>\n      <a href=\"#insights\">Technical Insights</a>\n      <button class=\"printbtn\" type=\"button\" onclick=\"window.print()\">Print</button>\n    </nav>\n  </div>\n  <p class=\"fnote\">Compiled 2026-08-28 from Show HN, vendor changelogs, arXiv preprints, podcasts and community discussion. Dates in YYYY-MM-DD. External links open in a new tab. Click any description to expand truncated text.</p>\n</footer>\n\n<script>\n(function () {\n  document.querySelectorAll('.d').forEach(function (el) {\n    el.setAttribute('title', 'Click to expand / collapse');\n    el.addEventListener('click', function () {\n      el.classList.toggle('open');\n    });\n  });\n})();\n</script>\n\n</body>\n</html>\n"
}

