          "+.badge{display:inline-block;font:bold 8.5px/1.9 Arial,Helvetica,sans-serif;text-transform:uppercase;letter-spacing:.06em;padding:0 6px;border-radius:2px;border:1px solid transparent;margin-right:5px;vertical-align:1px}",
