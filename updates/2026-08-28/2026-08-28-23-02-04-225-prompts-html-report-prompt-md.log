 70→.col-products .item::before{content:counter(prod);position:absolute;left:10px;top:9px;font:10px Monaco,Consolas,monospace;color:#b4b4a4}\n    71→/* ---- footer ---- */\n    72→footer{border-top:3px solid var(--acc);background:#f1f1e7}\n    73→.fbar{max-width:1680px;margin:0 auto;padding:9px 16px;display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;font-size:11px;color:var(--mut)}\n    74→.fbar nav{display:flex;gap:12px;flex-wrap:wrap;align-items:center}\n    75→.fbar a{color:var(--accd)}\n    76→.printbtn{font:11px Verdana,Geneva,sans-serif;color:var(--accd);background:none;border:1px solid var(--line);border-radius:2px;padding:2px 8px;cursor:pointer}\n    77→.printbtn:hover{background:#fff;border-color:var(--mut)}\n    78→.fnote{max-width:1680px;margin:0 auto;padding:0 16px 18px;font-size:10px;color:#9d9d90}\n    79→/* ---- responsive ---- */\n    80→@media (max-width:1150px){\n    81→  .layout{grid-template-columns:1fr 1fr}\n    82→  .col-products{grid-column:1/-1}\n    83→}\n    84→@media (max-width:720px){\n    85→  .layout{grid-template-columns:1fr;padding:0 10px 20px}\n    86→  .pagehead{padding:12px 10px 8px}\n    87→  .pagehead h1{font-size:18px}\n    88→  .topbar{padding:6px 10px;gap:8px}\n    89→}\n    90→/* ---- print ---- */\n    91→@media print{\n    92→  body{background:#fff;font-size:10pt}\n    93→  .skip,.topbar nav,.printbtn{display:none}\n    94→  .topbar{background:#fff;border-bottom:3px solid #000}\n    95→  .tb-date,.tagline{color:#555}\n    96→  .layout{display:block;max-width:none;padding:0}\n    97→  .col{border:0;background:#fff;margin-bottom:18px;break-inside:auto}\n    98→  .col h2{position:static;background:#fff;border-bottom:2px solid #000;padding-left:0}\n    99→  .cnt{background:#eee}\n   100→  .item{break-inside:avoid;border-bottom:1px solid #ccc}\n   101→  .item:hover{background:none}\n   102→  .t a{color:#000}\n   103→  .d,.col-updates .d,.col-insights .d{-webkit-line-clamp:unset;display:block;overflow:visible;cursor:auto}\n   104→  a{color:#000;text-decoration:none}\n   105→  footer{background:#fff;border-top:2px solid #000}\n   106→}\n   107→</style>\n   108→</head>\n   109→<body id=\"top\">\n   110→<a class=\"skip\" href=\"#main\">Skip to content</a>\n   111→\n   112→<header class=\"topbar\">\n   113→  <span class=\"logo\" aria-hidden=\"true\">A</span>\n   114→  <a class=\"brand\" href=\"#top\">Agent Code Daily</a>\n   115→  <span class=\"tagline\">agentic coding intelligence, daily</span>\n   116→  <nav aria-label=\"Report sections\">\n   117→    <a href=\"#new-products\">new products</a>\n   118→    <a href=\"#updates\">whitelist updates</a>\n   119→    <a href=\"#insights\">insights</a>\n   120→  </nav>\n   121→  <span class=\"tb-date\">2026-08-28</span>\n   122→</header>\n   123→\n   124→<div class=\"pagehead\">\n   125→  <h1>Agentic Coding Research Report</h1>\n   126→  <p class=\"issue\">Daily edition · <time datetime=\"2026-08-28\">2026-08-28</time>\n   127→    <span class=\"dsep\">|</span><b>31</b> new products\n   128→    <span class=\"dsep\">|</span><b>24</b> whitelist updates\n   129→    <span class=\"dsep\">|</span><b>37</b> technical insights\n   130→  </p>\n   131→</div>\n   132→\n   133→<main id=\"main\" class=\"layout\">\n   134→\n   135→  <!-- ============ NEW PRODUCTS (40%) ============ -->\n   136→  <section class=\"col col-products\" id=\"new-products\" aria-labelledby=\"h-new-products\">\n   137→    <h2 id=\"h-new-products\">New Products <span class=\"cnt\">31</span></h2>\n   138→    <ol class=\"list\">\n   139→\n   140→      <li class=\"item\">\n   141→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49466704\" target=\"_blank\" rel=\"noopener\">Opslane</a></h3>\n   142→        <p class=\"d\">Agent that watches real user sessions, finds the bugs that matter, and fixes them — an autonomous debugging agent wired directly into production session data.</p>\n   143→        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · via Show HN</p>\n   144→        <p class=\"tags\"><span>AI debugging agent</span></p>\n   145→      </li>\n   146→\n   147→      <li class=\"item\">\n   148→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49465138\" target=\"_blank\" rel=\"noopener\">Knowl</a></h3>\n   149→        <p class=\"d\">Agent memory with write-time supersession: automatically prunes and supersedes stale project memory (built after the author's CLAUDE.md hit 1000 lines), scoring 0.90 on the MAB memory benchmark.</p>\n   150→        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · via Show HN</p>\n   151→        <p class=\"tags\"><span>coding-agent memory</span></p>\n   152→      </li>\n   153→\n   154→      <li class=\"item\">\n   155→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49460693\" target=\"_blank\" rel=\"noopener\">Contextual</a></h3>\n   156→        <p class=\"d\">Local codebase memory for AI coding agents: indexes and remembers project context so agents recall it across sessions without sending code to the cloud.</p>\n   157→        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · via Show HN</p>\n   158→        <p class=\"tags\"><span>agent memory</span><span>local-first</span></p>\n   159→      </li>\n   160→\n   161→      <li class=\"item\">\n   162→        <h3 class=\"t\"><a href=\"https://github.com/seoes/proval\" target=\"_blank\" rel=\"noopener\">Proval</a></h3>\n   163→        <p class=\"d\">Self-hosted AI code review agent that reviews pull requests on GitLab, Forgejo and GitHub from your own infrastructure.</p>\n   164→        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · via Show HN</p>\n   165→        <p class=\"tags\"><span>code review</span><span>self-hosted</span></p>\n   166→      </li>\n   167→\n   168→      <li class=\"item\">\n   169→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49464154\" target=\"_blank\" rel=\"noopener\">Open Session</a></h3>\n   170→        <p class=\"d\">Open-source cloud agent-orchestrator for running and managing AI coding agent sessions in the cloud.</p>\n   171→        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · via Show HN</p>\n   172→        <p class=\"tags\"><span>orchestration</span><span>open source</span></p>\n   173→      </li>\n   174→\n   175→      <li class=\"item\">\n   176→        <h3 class=\"t\"><a href=\"https://code.visualstudio.com/blogs/2026/08/26/agent-host-architecture\" target=\"_blank\" rel=\"noopener\">VS Code Agent Host</a></h3>\n   177→        <p class=\"d\">New VS Code Agent Host architecture for persistent, portable agent sessions inside the editor, with full MCP spec support and the ability to command GitHub's coding agent directly from VS Code.</p>\n   178→        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · VS Code blog · Visual Studio Magazine · DevOps.com</p>\n   179→        <p class=\"tags\"><span>agent runtime</span><span>IDE</span><span>MCP</span></p>\n   180→      </li>\n   181→\n   182→      <li class=\"item\">\n   183→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49450816\" target=\"_blank\" rel=\"noopener\">Polign</a></h3>\n   184→        <p class=\"d\">Lightweight, stateless agent-memory database combining vector search and BM25 over your own S3/GCS storage, with typed facts, structured queries and cold-storage caching for long-lived agent memory.</p>\n   185→        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · via Show HN</p>\n   186→        <p class=\"tags\"><span>memory infra</span><span>vector search</span></p>\n   187→      </li>\n   188→\n   189→      <li class=\"item\">\n   190→        <h3 class=\"t\"><a href=\"https://neoswarm.dev/\" target=\"_blank\" rel=\"noopener\">Neoswarm</a></h3>\n   191→        <p class=\"d\">Neovim-based environment for controlling AI coding agents from inside the editor: agent sessions, orchestration and review without leaving Neovim.</p>\n   192→        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · via Show HN</p>\n   193→        <p class=\"tags\"><span>Neovim</span><span>agent control</span></p>\n   194→      </li>\n   195→\n   196→      <li class=\"item\">\n   197→        <h3 class=\"t\"><a href=\"https://github.com/RudderCode/Rudder\" target=\"_blank\" rel=\"noopener\">Rudder</a></h3>\n   198→        <p class=\"d\">Red-Green TDD workflow tool that drives coding agents to produce verifiably comprehensive specs: tests are written first and the agent must make them pass.</p>\n   199→        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · via Show HN</p>\n   200→        <p class=\"tags\"><span>TDD</span><span>testing</span></p>\n   201→      </li>\n   202→\n   203→      <li class=\"item\">\n   204→        <h3 class=\"t\"><a href=\"https://github.com/apvcode/Termux-Dev\" target=\"_blank\" rel=\"noopener\">Devx</a></h3>\n   205→        <p class=\"d\">Autonomous AI coding agent built to run on Android Termux and desktop, letting developers run a repo-aware coding agent directly from their phone.</p>\n   206→        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · via Show HN</p>\n   207→        <p class=\"tags\"><span>mobile</span><span>terminal</span></p>\n   208→      </li>\n   209→\n   210→      <li class=\"item\">\n   211→        <h3 class=\"t\"><a href=\"https://thegit.ai\" target=\"_blank\" rel=\"noopener\">TheGitAI</a></h3>\n   212→        <p class=\"d\">Model-agnostic coding agent for your terminal that works with any LLM provider.</p>\n   213→        <p class=\"m\"><time datetime=\"2026-08-25\">2026-08-25</time> · via Show HN</p>\n   214→        <p class=\"tags\"><span>coding CLI</span><span>model-agnostic</span></p>\n   215→      </li>\n   216→\n   217→      <li class=\"item\">\n   218→        <h3 class=\"t\"><a href=\"https://oynix.dev\" target=\"_blank\" rel=\"noopener\">Oynix</a></h3>\n   219→        <p class=\"d\">Local tool that makes your coding agent aware of your whole codebase by indexing it on-device, no cloud needed.</p>\n   220→        <p class=\"m\"><time datetime=\"2026-08-25\">2026-08-25</time> · via Show HN</p>\n   221→        <p class=\"tags\"><span>context indexing</span><span>local-first</span></p>\n   222→      </li>\n   223→\n   224→      <li class=\"item\">\n   225→        <h3 class=\"t\"><a href=\"https://www.salesforce.com/news/press-releases/2026/08/24/salesforce-launches-slack-code-to-make-ai-software-development-multiplayer/\" target=\"_blank\" rel=\"noopener\">Slack Code</a></h3>\n   226→        <p class=\"d\">Salesforce's multiplayer AI coding environment: shared Slack project channels where teams tag AI coding agents (Claude, Copilot, Devin, Vercel) and watch plans, diffs and previews in the open. Available on all Slack plans.</p>\n   227→        <p class=\"m\"><time datetime=\"2026-08-24\">2026-08-24</time> · Salesforce press release · TechRepublic · Slack blog</p>\n   228→        <p class=\"tags\"><span>multiplayer coding</span><span>orchestration</span></p>\n   229→      </li>\n   230→\n   231→      <li class=\"item\">\n   232→        <h3 class=\"t\"><a href=\"https://github.com/otsaloma/sloppie\" target=\"_blank\" rel=\"noopener\">Sloppie</a></h3>\n   233→        <p class=\"d\">Agentic development environment for Linux: a terminal-based environment where AI agents write and run code.</p>\n   234→        <p class=\"m\"><time datetime=\"2026-08-24\">2026-08-24</time> · via Show HN</p>\n   235→        <p class=\"tags\"><span>agentic dev environment</span><span>Linux</span></p>\n   236→      </li>\n   237→\n   238→      <li class=\"item\">\n   239→        <h3 class=\"t\"><a href=\"https://zuse.sh\" target=\"_blank\" rel=\"noopener\">Zuse</a></h3>\n   240→        <p class=\"d\">Open-source desktop workspace for running and managing coding agents (Claude Code, Codex, Cursor, Gemini, Grok, OpenCode, Kiro) across real Git repositories — tasks run in isolated Git worktrees with persistent sessions, diff inspection and PR review, using your existing agent subscriptions.</p>\n   241→        <p class=\"m\"><time datetime=\"2026-08-23\">2026-08-23</time> · via Show HN</p>\n   242→        <p class=\"tags\"><span>orchestration</span><span>desktop</span><span>open source</span></p>\n   243→      </li>\n   244→\n   245→      <li class=\"item\">\n   246→        <h3 class=\"t\"><a href=\"https://www.npmjs.com/package/faberwright\" target=\"_blank\" rel=\"noopener\">Faber</a></h3>\n   247→        <p class=\"d\">Cost-efficient open-source coding agent that builds and uses a code graph of the repo to plan edits and reduce token usage.</p>\n   248→        <p class=\"m\"><time datetime=\"2026-08-22\">2026-08-22</time> · via Show HN</p>\n   249→        <p class=\"tags\"><span>code graph</span><span>open source</span></p>\n   250→      </li>\n   251→\n   252→      <li class=\"item\">\n   253→        <h3 class=\"t\"><a href=\"https://github.com/proliferate-ai/proliferate\" target=\"_blank\" rel=\"noopener\">Proliferate</a></h3>\n   254→        <p class=\"d\">Open-source (AGPL-3.0), self-hostable AI IDE that runs multiple coding agents (Claude Code, Codex, OpenCode, Cursor, Grok) in one interface, with parent agents spawning subagents and reusable Workflows with human approval gates.</p>\n   255→        <p class=\"m\"><time datetime=\"2026-08-21\">2026-08-21</time> · via Show HN</p>\n   256→        <p class=\"tags\"><span>self-hosted IDE</span><span>multi-agent</span><span>open source</span></p>\n   257→      </li>\n   258→\n   259→      <li class=\"item\">\n   260→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49378768\" target=\"_blank\" rel=\"noopener\">Huzzah</a></h3>\n   261→        <p class=\"d\">Experimental code editor with a new paradigm for AI-assisted coding: developers write brief declarative pseudocode that stays the persistent source of truth, and Huzzah generates and maintains the real code from it.</p>\n   262→        <p class=\"m\"><time datetime=\"2026-08-20\">2026-08-20</time> · via Show HN</p>\n   263→        <p class=\"tags\"><span>AI IDE</span><span>declarative</span></p>\n   264→      </li>\n   265→\n   266→      <li class=\"item\">\n   267→        <h3 class=\"t\"><a href=\"https://github.com/CaydenChik/doover\" target=\"_blank\" rel=\"noopener\">Do-over</a></h3>\n   268→        <p class=\"d\">Undo for AI agent shell commands: lets developers roll back machine state after a bad command run by a coding agent, aimed at recovering from agent mistakes.</p>\n   269→        <p class=\"m\"><time datetime=\"2026-08-20\">2026-08-20</time> · via Show HN</p>\n   270→        <p class=\"tags\"><span>undo</span><span>agent safety</span></p>\n   271→      </li>\n   272→\n   273→      <li class=\"item\">\n   274→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49363778\" target=\"_blank\" rel=\"noopener\">Naeos</a></h3>\n   275→        <p class=\"d\">Engineering system for AI coding agents: structures specs, tasks and workflow around coding agents.</p>\n   276→        <p class=\"m\"><time datetime=\"2026-08-19\">2026-08-19</time> · via Show HN</p>\n   277→        <p class=\"tags\"><span>workflow system</span></p>\n   278→      </li>\n   279→\n   280→      <li class=\"item\">\n   281→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49364088\" target=\"_blank\" rel=\"noopener\">CrewCode</a></h3>\n   282→        <p class=\"d\">Open-source mission control for AI coding agents: dashboard to launch, monitor and manage multiple coding-agent runs.</p>\n   283→        <p class=\"m\"><time datetime=\"2026-08-19\">2026-08-19</time> · via Show HN</p>\n   284→        <p class=\"tags\"><span>mission control</span><span>open source</span></p>\n   285→      </li>\n   286→\n   287→      <li class=\"item\">\n   288→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49356637\" target=\"_blank\" rel=\"noopener\">CommitLore</a></h3>\n   289→        <p class=\"d\">Git memory tool that preserves the decisions and rationale coding agents keep forgetting, attaching them back to project history across sessions.</p>\n   290→        <p class=\"m\"><time datetime=\"2026-08-19\">2026-08-19</time> · via Show HN</p>\n   291→        <p class=\"tags\"><span>git memory</span></p>\n   292→      </li>\n   293→\n   294→      <li class=\"item\">\n   295→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49363138\" target=\"_blank\" rel=\"noopener\">Flow</a></h3>\n   296→        <p class=\"d\">CLI wrapper around Claude Code that enforces a structured feature workflow: planning, then review/testing, then merge.</p>\n   297→        <p class=\"m\"><time datetime=\"2026-08-19\">2026-08-19</time> · via Show HN</p>\n   298→        <p class=\"tags\"><span>CLI workflow</span><span>Claude Code</span></p>\n   299→      </li>\n   300→\n   301→      <li class=\"item\">\n   302→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49352394\" target=\"_blank\" rel=\"noopener\">ChatOSS</a></h3>\n   303→        <p class=\"d\">Codex-style coding agent for fully open-source AI stacks, built on Ollama so it runs locally with open-weight models.</p>\n   304→        <p class=\"m\"><time datetime=\"2026-08-18\">2026-08-18</time> · via Show HN</p>\n   305→        <p class=\"tags\"><span>open source</span><span>local models</span></p>\n   306→      </li>\n   307→\n   308→      <li class=\"item\">\n   309→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49353724\" target=\"_blank\" rel=\"noopener\">Clinch</a></h3>\n   310→        <p class=\"d\">Local-first fork of the Warp terminal built specifically for managing multiple AI agent sessions in the terminal.</p>\n   311→        <p class=\"m\"><time datetime=\"2026-08-18\">2026-08-18</time> · via Show HN</p>\n   312→        <p class=\"tags\"><span>terminal</span><span>multi-session</span></p>\n   313→      </li>\n   314→\n   315→      <li class=\"item\">\n   316→        <h3 class=\"t\"><a href=\"https://cursor.com/changelog/origin-code-hosting\" target=\"_blank\" rel=\"noopener\">Cursor Origin</a></h3>\n   317→        <p class=\"d\">Agent-native code hosting built into Cursor: cloud Git repositories, pull requests, code review and GitHub sync designed for high-volume AI coding agent workflows. Early beta rolled out to all paid plans in mid-August 2026, debuting during a major GitHub outage.</p>\n   318→        <p class=\"m\"><time datetime=\"2026-08-17\">2026-08-17</time> · Cursor changelog · VentureBeat · SiliconANGLE · DevOps.com</p>\n   319→        <p class=\"tags\"><span>code hosting</span><span>dev workflow</span></p>\n   320→      </li>\n   321→\n   322→      <li class=\"item\">\n   323→        <h3 class=\"t\"><a href=\"https://github.com/harnessrouter/harnessrouter\" target=\"_blank\" rel=\"noopener\">HarnessRouter</a></h3>\n   324→        <p class=\"d\">Unified API layer for running coding-agent harnesses (Codex, Claude Code, Hermes) as a product backend — \"LiteLLM for harnesses rather than models.\" Ships as a Docker image with a proposed Unified Harness Protocol for task execution, event streaming and session management.</p>\n   325→        <p class=\"m\"><time datetime=\"2026-08-17\">2026-08-17</time> · via Show HN</p>\n   326→        <p class=\"tags\"><span>harness routing</span><span>API infra</span></p>\n   327→      </li>\n   328→\n   329→      <li class=\"item\">\n   330→        <h3 class=\"t\"><a href=\"https://github.com/agent6-dev/agent6\" target=\"_blank\" rel=\"noopener\">Agent6</a></h3>\n   331→        <p class=\"d\">Coding agent with jailed (sandboxed) commands and editable state machines for controlled, auditable autonomous coding.</p>\n   332→        <p class=\"m\"><time datetime=\"2026-08-16\">2026-08-16</time> · via Show HN</p>\n   333→        <p class=\"tags\"><span>sandboxing</span><span>state machines</span></p>\n   334→      </li>\n   335→\n   336→      <li class=\"item\">\n   337→        <h3 class=\"t\"><a href=\"https://github.com/kungfu-systems/kungfu\" target=\"_blank\" rel=\"noopener\">Kungfu</a></h3>\n   338→        <p class=\"d\">Keeps coding-agent work alive across sessions and handoffs: persists task state so agents (or teammates) can resume exactly where they left off.</p>\n   339→        <p class=\"m\"><time datetime=\"2026-08-16\">2026-08-16</time> · via Show HN</p>\n   340→        <p class=\"tags\"><span>session persistence</span><span>handoff</span></p>\n   341→      </li>\n   342→\n   343→      <li class=\"item\">\n   344→        <h3 class=\"t\"><a href=\"https://news.ycombinator.com/item?id=49307927\" target=\"_blank\" rel=\"noopener\">NexusMem</a></h3>\n   345→        <p class=\"d\">Local memory layer for coding agents that captures project knowledge beyond Git history, persisting context across sessions.</p>\n   346→        <p class=\"m\"><time datetime=\"2026-08-15\">2026-08-15</time> · via Show HN</p>\n   347→        <p class=\"tags\"><span>agent memory</span><span>local-first</span></p>\n   348→      </li>\n   349→\n   350→      <li class=\"item\">\n   351→        <h3 class=\"t\"><a href=\"https://github.com/mupt-ai/self-bench\" target=\"_blank\" rel=\"noopener\">Self-bench</a></h3>\n   352→        <p class=\"d\">Builds SWE-bench style evaluations from your own private repos so teams can score coding agents against their real codebase.</p>\n   353→        <p class=\"m\"><time datetime=\"2026-08-14\">2026-08-14</time> · via Show HN</p>\n   354→        <p class=\"tags\"><span>evals</span><span>SWE-bench</span></p>\n   355→      </li>\n   356→\n   357→    </ol>\n   358→  </section>\n   359→\n   360→  <!-- ============ WHITELIST UPDATES (35%) ============ -->\n   361→  <section class=\"col col-updates\" id=\"updates\" aria-labelledby=\"h-updates\">\n   362→    <h2 id=\"h-updates\">Whitelist Updates <span class=\"cnt\">24</span></h2>\n   363→    <ol class=\"list\">\n   364→\n   365→      <li class=\"item\">\n   366→        <h3 class=\"t\"><span class=\"badge b-announce\">announcement</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-28-upcoming-changes-to-github-copilot-policies-and-billing\" target=\"_blank\" rel=\"noopener\">Upcoming changes to Copilot policies and billing</a></h3>\n   367→        <p class=\"d\">Three changes announced: Copilot Business/Enterprise signups reopen Sep 1 with upfront per-seat billing from Oct 1; the cloud agent, Chat on github.com and Mobile chat merge into one unified experience no earlier than Sep 28; and code review default shifts from Lite to Balanced on Sep 28.</p>\n   368→        <p class=\"m\"><time datetime=\"2026-08-28\">2026-08-28</time> · <a href=\"https://github.blog/changelog/2026-08-28-upcoming-changes-to-github-copilot-policies-and-billing\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n   369→      </li>\n   370→\n   371→      <li class=\"item\">\n   372→        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">Claude Code</span> <a href=\"https://github.com/anthropics/claude-code/releases/tag/v2.1.248\" target=\"_blank\" rel=\"noopener\">v2.1.248: --restricted sandbox mode, cross-session messaging, /usage-credits</a></h3>\n   373→        <p class=\"d\">Adds a <code>--restricted</code> mode that removes command/code-execution tools and WebFetch, keeps file tools sandboxed to the working directory, and ignores local settings files. Expands cross-session messaging (SendMessage/ListAgents) to Bedrock, Vertex and Foundry; adds <code>/usage-credits</code> for Enterprise orgs and an experimental per-agent prompt-cache TTL (<code>cacheTtl</code>).</p>\n   374→        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · <a href=\"https://github.com/anthropics/claude-code/releases/tag/v2.1.248\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n   375→      </li>\n   376→\n   377→      <li class=\"item\">\n   378→        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Cursor</span> <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">Cloud Agents: start from scratch without a repo, live preview, Vercel publishing</a></h3>\n   379→        <p class=\"d\">Cloud Agents no longer need a connected GitHub or other SCM provider to start work — \"Start from scratch\" creates an Origin repo behind the scenes, with a Create repo button to save agent work. Live preview port-forwards the agent's environment to the browser, and agents can publish to a live URL via a connected Vercel account.</p>\n   380→        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n   381→      </li>\n   382→\n   383→      <li class=\"item\">\n   384→        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-27-copilot-code-review-resolution-reasons-and-expanded-capabilities\" target=\"_blank\" rel=\"noopener\">Code review: resolution reasons and expanded capabilities</a></h3>\n   385→        <p class=\"d\">Copilot code review now reports resolution reasons and gains expanded capabilities, helping developers understand why suggested changes were or weren't applied when Copilot reviews pull requests.</p>\n   386→        <p class=\"m\"><time datetime=\"2026-08-27\">2026-08-27</time> · <a href=\"https://github.blog/changelog/2026-08-27-copilot-code-review-resolution-reasons-and-expanded-capabilities\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n   387→      </li>\n   388→\n   389→      <li class=\"item\">\n   390→        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-26-global-model-policy-generally-available\" target=\"_blank\" rel=\"noopener\">Global model policy generally available</a></h3>\n   391→        <p class=\"d\">GitHub's global model policy for Copilot is now generally available, giving administrators a single policy to govern which AI models are available across their organization.</p>\n   392→        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · <a href=\"https://github.blog/changelog/2026-08-26-global-model-policy-generally-available\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n   393→      </li>\n   394→\n   395→      <li class=\"item\">\n   396→        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Devin</span> <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">Automations &amp; Slack upgrades: queued messages, multi-channel triggers, batch security remediation</a></h3>\n   397→        <p class=\"d\">Devin's August 26 release adds queued message delivery during long waits, smarter @mention routing to subscribed sessions, automation triggers across multiple Slack channels, Jira status_changed triggers, and batch remediation of security findings via new v3 API routes. An org setting now allows sessions to open PRs as validated collaborators.</p>\n   398→        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n   399→      </li>\n   400→\n   401→      <li class=\"item\">\n   402→        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">Codex CLI</span> <a href=\"https://github.com/openai/codex/releases/tag/rust-v0.150.0\" target=\"_blank\" rel=\"noopener\">0.150.0: @-mention other Codex tasks, /copy picker, Interrupt hooks</a></h3>\n   403→        <p class=\"d\">Users can reference other Codex tasks with @ mentions and ask agents to read, create, or message tasks from the terminal; <code>/copy</code> gains a picker; task titles auto-generate; Interrupt hooks added. Security fixes ensure untrusted projects can no longer inject project-level <code>AGENTS.md</code> instructions.</p>\n   404→        <p class=\"m\"><time datetime=\"2026-08-26\">2026-08-26</time> · <a href=\"https://github.com/openai/codex/releases/tag/rust-v0.150.0\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n   405→      </li>\n   406→\n   407→      <li class=\"item\">\n   408→        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-25-github-copilot-app-customize-tab-is-generally-available\" target=\"_blank\" rel=\"noopener\">Copilot app Customize tab generally available</a></h3>\n   409→        <p class=\"d\">The Customize tab in the GitHub Copilot app reached general availability, letting users tailor Copilot's behavior, instructions, and tooling from a dedicated UI surface.</p>\n   410→        <p class=\"m\"><time datetime=\"2026-08-25\">2026-08-25</time> · <a href=\"https://github.blog/changelog/2026-08-25-github-copilot-app-customize-tab-is-generally-available\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n   411→      </li>\n   412→\n   413→      <li class=\"item\">\n   414→        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Codex CLI</span> <a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener\">Event-triggered scheduled tasks (Gmail, Slack, GitHub events)</a></h3>\n   415→        <p class=\"d\">Scheduled tasks can now run on Gmail, Slack, or GitHub events — filtered Gmail messages, watched Slack channels, or PR activity like reviews and merges — on web and mobile for eligible plans, complementing time-based schedules.</p>\n   416→        <p class=\"m\"><time datetime=\"2026-08-25\">2026-08-25</time> · <a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n   417→      </li>\n   418→\n   419→      <li class=\"item\">\n   420→        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">Gemini CLI</span> <a href=\"https://github.com/google-gemini/gemini-cli/releases/tag/v0.57.0\" target=\"_blank\" rel=\"noopener\">v0.57.0: OAuth fixes for Cloud Workstations, capacity-aware retries</a></h3>\n   421→        <p class=\"d\">The weekly stable release dynamically resolves Cloud Workstations proxy redirect URIs for OAuth, fixes swallowed directory mismatches in IDE connections, adds context-aware silent retries with availability TTL for capacity errors, rolls back multi-turn requests on cancellation, and prevents TUI hangs via execution timeouts.</p>\n   422→        <p class=\"m\"><time datetime=\"2026-08-25\">2026-08-25</time> · <a href=\"https://github.com/google-gemini/gemini-cli/releases/tag/v0.57.0\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n   423→      </li>\n   424→\n   425→      <li class=\"item\">\n   426→        <h3 class=\"t\"><span class=\"badge b-announce\">announcement</span><span class=\"prod\">Codex CLI</span> <a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener\"><code>codex mcp-server</code> deprecated in favor of Codex app server</a></h3>\n   427→        <p class=\"d\">OpenAI deprecated the <code>codex mcp-server</code> command in favor of the Codex app server, pointing Claude Code users to the Codex plugin for integration.</p>\n   428→        <p class=\"m\"><time datetime=\"2026-08-24\">2026-08-24</time> · <a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n   429→      </li>\n   430→\n   431→      <li class=\"item\">\n   432→        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-24-copilot-harness-generally-available-in-copilot-for-jetbrains\" target=\"_blank\" rel=\"noopener\">Copilot harness GA in JetBrains, MCP server in public preview</a></h3>\n   433→        <p class=\"d\">The Copilot harness reached GA in JetBrains IDEs alongside a public preview of a built-in JetBrains MCP server exposing IDE capabilities to MCP-driven agent workflows. Adds /review in-IDE, a What's New tab, and reliability fixes for sign-in, BYOK and agent session continuity.</p>\n   434→        <p class=\"m\"><time datetime=\"2026-08-24\">2026-08-24</time> · <a href=\"https://github.blog/changelog/2026-08-24-copilot-harness-generally-available-in-copilot-for-jetbrains\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n   435→      </li>\n   436→\n   437→      <li class=\"item\">\n   438→        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-21-the-new-github-copilot-experience-in-slack\" target=\"_blank\" rel=\"noopener\">The new GitHub Copilot experience in Slack</a></h3>\n   439→        <p class=\"d\">A refreshed GitHub Copilot experience for Slack lets users invoke Copilot and its agents directly from Slack conversations as part of GitHub's collaboration tools refresh.</p>\n   440→        <p class=\"m\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://github.blog/changelog/2026-08-21-the-new-github-copilot-experience-in-slack\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n   441→      </li>\n   442→\n   443→      <li class=\"item\">\n   444→        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-21-shared-agentic-work-with-github-copilot-in-microsoft-teams\" target=\"_blank\" rel=\"noopener\">Shared agentic work with GitHub Copilot in Microsoft Teams</a></h3>\n   445→        <p class=\"d\">GitHub Copilot brings shared agentic work to Microsoft Teams, enabling teams to collaborate with Copilot agents inside Teams channels — part of GitHub's push to embed agentic coding in workplace collaboration tools.</p>\n   446→        <p class=\"m\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://github.blog/changelog/2026-08-21-shared-agentic-work-with-github-copilot-in-microsoft-teams\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n   447→      </li>\n   448→\n   449→      <li class=\"item\">\n   450→        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">Windsurf</span> <a href=\"https://docs.devin.ai/desktop/changelog\" target=\"_blank\" rel=\"noopener\">Windsurf/Devin Desktop v3.8.20: multi-window Agent Command Center, Devin Local plan mode</a></h3>\n   451→        <p class=\"d\">Agent Command Center improvements (side-by-side agent windows, in-place conversion, follows selected space), faster Agent/Editor mode switching (Ctrl/Cmd+G), and a Devin CLI shim. Devin Local adds multi-root workspaces, plan mode producing a Markdown plan with an Implement button, individually stoppable subagents, and <code>post_setup_worktree</code> hooks.</p>\n   452→        <p class=\"m\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://docs.devin.ai/desktop/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n   453→      </li>\n   454→\n   455→      <li class=\"item\">\n   456→        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Devin</span> <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">Session redesign: nested sub-Devin trees, session subscribers, custom sidebar tabs</a></h3>\n   457→        <p class=\"d\">The session page gets a compact header with built-in tags, a redesigned sidebar with custom nav tabs, grouping and filtering, sub-Devin sessions displayed as a nested tree, session subscribers, bearer-token auth for automation webhooks, and expanded security-scan controls.</p>\n   458→        <p class=\"m\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n   459→      </li>\n   460→\n   461→      <li class=\"item\">\n   462→        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">Codex CLI</span> <a href=\"https://developers.openai.com/codex/changelog/\" target=\"_blank\" rel=\"noopener\">0.149.0: interactive <code>codex agents</code> dashboard, <code>codex queue</code>, /cd commands</a></h3>\n   463→        <p class=\"d\">Adds an interactive <code>codex agents</code> dashboard for managing sessions, <code>codex queue</code> for messaging existing sessions, <code>/cd</code>/<code>/pwd</code>/<code>/cwd</code> commands, expanded Vim motions and broader <code>codex doctor</code> diagnostics. Fixes include queued-message wake-ups and permission-profile restoration on resume.</p>\n   464→        <p class=\"m\"><time datetime=\"2026-08-20\">2026-08-20</time> · <a href=\"https://developers.openai.com/codex/changelog/\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n   465→      </li>\n   466→\n   467→      <li class=\"item\">\n   468→        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Cursor</span> <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">Cloud Agents &amp; harness: subscriptions, isolated subagents, /goal</a></h3>\n   469→        <p class=\"d\">Subscriptions let cloud agents monitor PRs, watch Slack threads or run scheduled tasks and wake on events, auto-subscribing to PRs they create. Subagents now run on isolated VMs with clean project copies; <code>/goal</code> sets long-lived objectives (e.g. fixing flaky tests until CI is green); steering follow-ups wait for the next tool call.</p>\n   470→        <p class=\"m\"><time datetime=\"2026-08-19\">2026-08-19</time> · <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n   471→      </li>\n   472→\n   473→      <li class=\"item\">\n   474→        <h3 class=\"t\"><span class=\"badge b-announce\">announcement</span><span class=\"prod\">Devin</span> <a href=\"https://devin.ai/blog\" target=\"_blank\" rel=\"noopener\">GPT-5.6 Sol available at 70% discount on Devin Desktop and CLI</a></h3>\n   475→        <p class=\"d\">Cognition announced GPT-5.6 Sol at a 70% discount on Devin Desktop and Devin CLI through October 3, 2026, lowering the cost of running OpenAI's model on Devin's platform.</p>\n   476→        <p class=\"m\"><time datetime=\"2026-08-18\">2026-08-18</time> · <a href=\"https://devin.ai/blog\" target=\"_blank\" rel=\"noopener\">blog ↗</a></p>\n   477→      </li>\n   478→\n   479→      <li class=\"item\">\n   480→        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Claude Code</span> <a href=\"https://code.claude.com/docs/en/whats-new/2026-w34\" target=\"_blank\" rel=\"noopener\">/design research preview, Concise output style, device cards (Week 34)</a></h3>\n   481→        <p class=\"d\">A <code>/design</code> research preview brings an artboard workflow to CLI and Desktop (Claude drafts editable artboards and builds the chosen one), plus a Concise output style that leads with results, device cards via <code>claude remote-control</code>, and an <code>ANTHROPIC_DEFAULT_MODEL</code> env var. Shipped across v2.1.234–v2.1.239.</p>\n   482→        <p class=\"m\"><time datetime=\"2026-08-17\">2026-08-17</time> · <a href=\"https://code.claude.com/docs/en/whats-new/2026-w34\" target=\"_blank\" rel=\"noopener\">what's new ↗</a></p>\n   483→      </li>\n   484→\n   485→      <li class=\"item\">\n   486→        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Cursor</span> <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">Origin Code Hosting: Cursor now hosts your code</a></h3>\n   487→        <p class=\"d\">Origin code hosting launched in early beta on all paid plans: Origin Repos managed via a new Codebase tab, GitHub repo sync for browsing and searching (GitHub remains source of truth), PR views with two-way comment sync, agents in every repo, and app extensions (Vercel preview deployments, Depot, Buildkite CI).</p>\n   488→        <p class=\"m\"><time datetime=\"2026-08-17\">2026-08-17</time> · <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener\">changelog ↗</a></p>\n   489→      </li>\n   490→\n   491→      <li class=\"item\">\n   492→        <h3 class=\"t\"><span class=\"badge b-release\">release</span><span class=\"prod\">GitHub Copilot</span> <a href=\"https://github.blog/changelog/2026-08-14-grok-4-6-is-now-available-in-github-copilot\" target=\"_blank\" rel=\"noopener\">Grok 4.6 now available in GitHub Copilot</a></h3>\n   493→        <p class=\"d\">xAI's Grok 4.6 model is now selectable in Copilot's model picker, continuing GitHub's multi-model strategy alongside Claude, GPT and Gemini options.</p>\n   494→        <p class=\"m\"><time datetime=\"2026-08-14\">2026-08-14</time> · <a href=\"https://github.blog/changelog/2026-08-14-grok-4-6-is-now-available-in-github-copilot\" target=\"_blank\" rel=\"noopener\">full announcement ↗</a></p>\n   495→      </li>\n   496→\n   497→      <li class=\"item\">\n   498→        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Devin</span> <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">Devin Coach: prompt suggestions, Review skip logic, Devin Local default for enterprise</a></h3>\n   499→        <p class=\"d\">Devin Coach offers suggestions in the input box to improve prompts before sending; Devin Review now skips re-review of PRs with unchanged diffs; sessions auto-subscribe to Slack threads; Devin Local is enabled by default for enterprise customers.</p>\n   500→        <p class=\"m\"><time datetime=\"2026-08-14\">2026-08-14</time> · <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener\">release notes ↗</a></p>\n   501→      </li>\n   502→\n   503→      <li class=\"item\">\n   504→        <h3 class=\"t\"><span class=\"badge b-feature\">feature</span><span class=\"prod\">Claude Code</span> <a href=\"https://code.claude.com/docs/en/whats-new/2026-w32\" target=\"_blank\" rel=\"noopener\">Auto mode becomes the default permission mode for new sessions</a></h3>\n   505→        <p class=\"d\">As of August 14, 2026, auto mode is the default permission mode for new Claude Code sessions on Pro, Max and Team plans, with transcript protections that block dangerous operations while reducing permission prompts.</p>\n   506→        <p class=\"m\"><time datetime=\"2026-08-14\">2026-08-14</time> · <a href=\"https://code.claude.com/docs/en/whats-new/2026-w32\" target=\"_blank\" rel=\"noopener\">what's new ↗</a></p>\n   507→      </li>\n   508→\n   509→    </ol>\n   510→  </section>\n   511→\n   512→  <!-- ============ TECHNICAL INSIGHTS (25%) ============ -->\n   513→  <section class=\"col col-insights\" id=\"insights\" aria-labelledby=\"h-insights\">\n   514→    <h2 id=\"h-insights\">Technical Insights <span class=\"cnt\">37</span></h2>\n   515→    <ol class=\"list\">\n   516→\n   517→      <li class=\"item\">\n   518→        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://simonwillison.net/2026/Aug/28/just-a-rumour-of-a-bug/\" target=\"_blank\" rel=\"noopener\">Just a rumour of a bug is enough to find a security exploit these days</a></h3>\n   519→        <p class=\"d\">Anil Madhavapeddy (Cambridge professor, OCaml maintainer) reports AI-powered systems probed his site with traversal attacks ~10 minutes after a security patch was shared for discussion — agents needed only \"a rumour of a bug\" to develop working exploits. rclone maintainer Nick Craig-Wood confirmed ~20 disclosures in a decade vs 40+ in the past month at ~75% genuine.</p>\n   520→        <p class=\"tk\"><b>Takeaway:</b> Agent-driven offensive security is outrunning open-source embargo practices and CVE triage capacity (GitHub CVE assignment slipped from 2-3 days to 3-4 weeks).</p>\n   521→        <p class=\"m\">Anil Madhavapeddy (via Simon Willison) · Blog · <time datetime=\"2026-08-28\">2026-08-28</time></p>\n   522→        <p class=\"tags\"><span>security</span><span>vulnerability disclosure</span><span>CVE</span><span>open source</span></p>\n   523→      </li>\n   524→\n   525→      <li class=\"item\">\n   526→        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://simonwillison.net/2026/Aug/27/breaking-claude-code-opus-5-auto-mode/\" target=\"_blank\" rel=\"noopener\">Breaking Claude Code Opus 5 Auto Mode — prompt injection at ~80% success</a></h3>\n   527→        <p class=\"d\">Johann Rehberger's attack on Claude Code Opus 5 \"auto mode\": a crafted zip archive causes importing base64 to execute a malicious local struct.py, with ~80% success rate. Willison notes \"Auto Mode blocks its cleanup command\" and argues unattended coding agents should run in sandboxed environments with restricted network egress.</p>\n   528→        <p class=\"tk\"><b>Takeaway:</b> Autonomous coding agents remain highly exposed to prompt injection via their own tool use.</p>\n   529→        <p class=\"m\">Johann Rehberger (via Simon Willison) · Blog · <time datetime=\"2026-08-27\">2026-08-27</time></p>\n   530→        <p class=\"tags\"><span>prompt injection</span><span>agent security</span><span>sandboxing</span><span>Claude Code</span></p>\n   531→      </li>\n   532→\n   533→      <li class=\"item\">\n   534→        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://www.youtube.com/watch?v=UuqSy1jPSUw\" target=\"_blank\" rel=\"noopener\">Fireship revisits Knight Capital — the most expensive software bug in history</a></h3>\n   535→        <p class=\"d\">Fireship's \"code report\" video recounts the 2012 Knight Capital collapse: ~$440M lost in 45 minutes after a reused feature flag reactivated dead test code on 1 of 8 servers during a botched deployment.</p>\n   536→        <p class=\"tk\"><b>Takeaway:</b> As AI agents accelerate code changes and deployments, classic deployment hygiene (feature flags, dead-code removal, rollout consistency) becomes more important, not less.</p>\n   537→        <p class=\"m\">Jeff Delaney (Fireship) · YouTube · <time datetime=\"2026-08-27\">2026-08-27</time></p>\n   538→        <p class=\"tags\"><span>deployment</span><span>feature flags</span><span>software engineering</span></p>\n   539→      </li>\n   540→\n   541→      <li class=\"item\">\n   542→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://softwareengineeringdaily.com/podcasts/typescript-7-and-what-comes-next/\" target=\"_blank\" rel=\"noopener\">Software Engineering Daily: TypeScript 7 and what comes next</a></h3>\n   543→        <p class=\"d\">Daniel Rosenwasser (Principal PM for TypeScript at Microsoft) joins host Josh Goldberg to discuss TypeScript 7 — described as one of the biggest changes in the language's history.</p>\n   544→        <p class=\"tk\"><b>Takeaway:</b> The compiler rewrite moment (native-speed tsc) is exactly the kind of high-stakes migration where agents handle mechanical refactors while design decisions stay human.</p>\n   545→        <p class=\"m\">Daniel Rosenwasser with Josh Goldberg · Podcast · <time datetime=\"2026-08-27\">2026-08-27</time></p>\n   546→        <p class=\"tags\"><span>TypeScript</span><span>compilers</span><span>refactoring</span></p>\n   547→      </li>\n   548→\n   549→      <li class=\"item\">\n   550→        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://towardsdatascience.com/stop-giving-your-ai-agent-a-search-box-and-start-giving-it-typed-tools-hard-bounds-and-a-gate-it-cannot-talk-past/\" target=\"_blank\" rel=\"noopener\">Stop giving your AI agent a search box — typed tools, hard bounds, and a gate</a></h3>\n   551→        <p class=\"d\">Argues agents should get typed tools with hard bounds and a gate they cannot talk past, instead of open-ended search and control surfaces.</p>\n   552→        <p class=\"tk\"><b>Takeaway:</b> Agent reliability comes from interface design — constrained, typed, auditable tool contracts beat generic \"search boxes\" and hoping prompting holds the line; complements this week's prompt-injection findings.</p>\n   553→        <p class=\"m\">Miodrag Cekikj (Towards Data Science) · Platform · <time datetime=\"2026-08-27\">2026-08-27</time></p>\n   554→        <p class=\"tags\"><span>agent design</span><span>tool interfaces</span><span>guardrails</span></p>\n   555→      </li>\n   556→\n   557→      <li class=\"item\">\n   558→        <h3 class=\"t\"><span class=\"badge b-tutorial\">tutorial</span> <a href=\"https://towardsdatascience.com/how-to-work-with-ai-coding-agents/\" target=\"_blank\" rel=\"noopener\">How to Work with AI Coding Agents — better code, not just more code</a></h3>\n   559→        <p class=\"d\">Sara A. Metwalli's practical guide: give context not just prompts, run a structured Ask → Inspect → Plan → Implement → Test → Review loop, break work into small testable tasks, and structure requests with goal, context, constraints, acceptance criteria and validation.</p>\n   560→        <p class=\"tk\"><b>Takeaway:</b> Generating code is now cheap but understanding it is not — developers stay essential for planning, delegation, and judgment.</p>\n   561→        <p class=\"m\">Sara A. Metwalli (Towards Data Science) · Platform · <time datetime=\"2026-08-27\">2026-08-27</time></p>\n   562→        <p class=\"tags\"><span>workflow</span><span>developer skills</span><span>code review</span></p>\n   563→      </li>\n   564→\n   565→      <li class=\"item\">\n   566→        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://simonwillison.net/2026/Aug/26/qwen38-flash-next/\" target=\"_blank\" rel=\"noopener\">Qwen3.8-Flash-Next: open-weights MoE previewing Qwen4's architecture</a></h3>\n   567→        <p class=\"d\">Willison covers Qwen's new open-weights multimodal MoE model (125B total, ~6B active) that previews the Qwen4 architecture; he ran Unsloth quantizations on a DGX Spark and tested it by generating pelican SVGs.</p>\n   568→        <p class=\"tk\"><b>Takeaway:</b> The open-weights frontier keeps closing the gap with proprietary models, and small-activation MoE models are increasingly runnable on developer desks.</p>\n   569→        <p class=\"m\">Simon Willison · Blog · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n   570→        <p class=\"tags\"><span>open weights</span><span>MoE</span><span>local models</span></p>\n   571→      </li>\n   572→\n   573→      <li class=\"item\">\n   574→        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://simonwillison.net/2026/Aug/26/paul-dix/\" target=\"_blank\" rel=\"noopener\">Paul Dix: \"The end of programming\" — 1M lines of AI-maintained software</a></h3>\n   575→        <p class=\"d\">Paul Dix (quoted by Willison) marvels that AI can now produce and iteratively refine roughly a million lines of reliable software when given a verification system and proper direction.</p>\n   576→        <p class=\"tk\"><b>Takeaway:</b> Verification infrastructure — not code writing — is the scarce input for large-scale AI-generated codebases.</p>\n   577→        <p class=\"m\">Paul Dix (via Simon Willison) · Blog · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n   578→        <p class=\"tags\"><span>verification</span><span>agents</span><span>AI coding</span></p>\n   579→      </li>\n   580→\n   581→      <li class=\"item\">\n   582→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://lexfridman.com/dhh-2/\" target=\"_blank\" rel=\"noopener\">Lex Fridman #501: DHH declares \"the end of manual programming\" and embraces agentic engineering</a></h3>\n   583→        <p class=\"d\">In a 5+ hour conversation, DHH — who in 2025 typed all his code without AI — now argues agents have turned programming into \"agentic engineering,\" covering vibe coding vs agentic engineering, the best models and harnesses, agent-optimized setups, and advice for programmers. He also claims \"Linux will win the desktop\" via his Omarchy distro.</p>\n   584→        <p class=\"tk\"><b>Takeaway:</b> One of the most famous AI-coding skeptics converted to disciplined agent-first workflows — a bellwether for mainstream developer adoption.</p>\n   585→        <p class=\"m\">Lex Fridman with DHH · Podcast · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n   586→        <p class=\"tags\"><span>agentic engineering</span><span>vibe coding</span><span>future of programming</span></p>\n   587→      </li>\n   588→\n   589→      <li class=\"item\">\n   590→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://www.youtube.com/watch?v=L9mMfAFwbl4\" target=\"_blank\" rel=\"noopener\">Two Minute Papers: DeepSeek's new open agent system \"shouldn't be possible\"</a></h3>\n   591→        <p class=\"d\">Károly Zsolnai-Fehér covers DeepSeek Harness, DeepSeek's new open agent system, arguing its capabilities outpace what open-weight systems were expected to deliver.</p>\n   592→        <p class=\"tk\"><b>Takeaway:</b> Open-weight labs now ship frontier-grade agent harnesses, intensifying pressure on closed labs and expanding options for self-hosted coding agents.</p>\n   593→        <p class=\"m\">Károly Zsolnai-Fehér (Two Minute Papers) · YouTube · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n   594→        <p class=\"tags\"><span>DeepSeek</span><span>open weights</span><span>harness</span></p>\n   595→      </li>\n   596→\n   597→      <li class=\"item\">\n   598→        <h3 class=\"t\"><span class=\"badge b-paper\">paper</span> <a href=\"https://arxiv.org/abs/2608.26218\" target=\"_blank\" rel=\"noopener\">Same Model, Different Harness: harness changes alone swing SWE-bench results</a></h3>\n   599→        <p class=\"d\">For a fixed model, harness modifications alone change coding-agent outcomes dramatically: a context-shortening treatment lifted mean per-task fail-to-pass fraction from 28% to 49% on a 169-task SWE-bench Verified cohort. Evaluations must treat model-plus-harness as the tested solver.</p>\n   600→        <p class=\"tk\"><b>Takeaway:</b> Empirical confirmation of the week's loudest theme — \"most agent systems die not from a weak model but from a weak harness.\"</p>\n   601→        <p class=\"m\">Sydney Lewis (arXiv 2608.26218) · Paper · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n   602→        <p class=\"tags\"><span>harness</span><span>SWE-bench</span><span>evaluation</span><span>context engineering</span></p>\n   603→      </li>\n   604→\n   605→      <li class=\"item\">\n   606→        <h3 class=\"t\"><span class=\"badge b-paper\">paper</span> <a href=\"https://arxiv.org/abs/2608.25776\" target=\"_blank\" rel=\"noopener\">Self-poisoning in self-evolving coding agents: malicious skills spread like a worm</a></h3>\n   607→        <p class=\"d\">Identifies \"self-poisoning\": self-evolving agents imitate malicious skills from shared libraries and author copies that propagate like a worm. Poisoning rates span 20.3-41.8% across six models on SWE-bench Verified tasks; a proposed \"counter-prompt\" defense cuts the attack rate to at most 6.7%.</p>\n   608→        <p class=\"tk\"><b>Takeaway:</b> As agents share skills and libraries, supply-chain-style threats become an agentic-native risk class.</p>\n   609→        <p class=\"m\">Xiaodong Wu, Yu Shi, Qi Li, et al. (arXiv 2608.25776) · Paper · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n   610→        <p class=\"tags\"><span>security</span><span>self-evolving agents</span><span>skill libraries</span><span>SWE-bench</span></p>\n   611→      </li>\n   612→\n   613→      <li class=\"item\">\n   614→        <h3 class=\"t\"><span class=\"badge b-paper\">paper</span> <a href=\"https://arxiv.org/abs/2608.25399\" target=\"_blank\" rel=\"noopener\">Can your AI agent be cheaper? Under-specified tasks burn 29.7% more tokens</a></h3>\n   615→        <p class=\"d\">Across 2,700 runs with Kimi K3, shrinking a full specification to a bare user story increased token spend by 29.7%, with prompt sensitivity ranging 13-115% by task; a lightweight predictor prices task configurations within 36% using a single cheap probe.</p>\n   616→        <p class=\"tk\"><b>Takeaway:</b> Specification quality is a direct cost lever in agentic coding — vague prompts are a hidden tax, quantified.</p>\n   617→        <p class=\"m\">Jakub Smékal (arXiv 2608.25399) · Paper · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n   618→        <p class=\"tags\"><span>token economics</span><span>task specification</span><span>cost optimization</span></p>\n   619→      </li>\n   620→\n   621→      <li class=\"item\">\n   622→        <h3 class=\"t\"><span class=\"badge b-paper\">paper</span> <a href=\"https://arxiv.org/abs/2608.25241\" target=\"_blank\" rel=\"noopener\">A Few Pages of Markdown: committed AI config predicts codebase health after agent adoption</a></h3>\n   623→        <p class=\"d\">Proposes RAMP, a four-level maturity model based on version-controlled AI configuration (CLAUDE.md-style files). Across 441 repositories, agents sped development (28-38% more commits) at all levels, but agent-first repos lacking committed configuration saw roughly double the growth in cognitive complexity (+53% vs +27%).</p>\n   624→        <p class=\"tk\"><b>Takeaway:</b> Committing agent guidance/config to version control is emerging as a measurable quality practice.</p>\n   625→        <p class=\"m\">Yegor Denisov-Blanch, Shyam Agarwal, et al. (Stanford; arXiv 2608.25241) · Paper · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n   626→        <p class=\"tags\"><span>AI configuration</span><span>CLAUDE.md</span><span>code quality</span><span>repo maturity</span></p>\n   627→      </li>\n   628→\n   629→      <li class=\"item\">\n   630→        <h3 class=\"t\"><span class=\"badge b-tutorial\">tutorial</span> <a href=\"https://towardsdatascience.com/how-to-effectively-solve-100-tasks-with-claude-code/\" target=\"_blank\" rel=\"noopener\">How to effectively solve 100+ tasks a day with Claude Code sub-agents</a></h3>\n   631→        <p class=\"d\">Eivind Kjosbakken shares a practical pipeline for handling 50-100 small coding tasks daily: explicitly instruct Claude Code to spin up sub-agents so each task is completed individually, from issue triage through execution.</p>\n   632→        <p class=\"tk\"><b>Takeaway:</b> Practitioner workflows are standardizing around orchestrator-plus-subagent patterns for parallelizable task queues.</p>\n   633→        <p class=\"m\">Eivind Kjosbakken (Towards Data Science) · Platform · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n   634→        <p class=\"tags\"><span>Claude Code</span><span>sub-agents</span><span>orchestration</span><span>workflow</span></p>\n   635→      </li>\n   636→\n   637→      <li class=\"item\">\n   638→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://news.agentcommunity.org/issues/2026-08-26-the-harness-eats\" target=\"_blank\" rel=\"noopener\">Karpathy: the \"year of agents\" will take a decade — and the harness eats the model</a></h3>\n   639→        <p class=\"d\">Agent Brief distills Karpathy's ~2.5-hour Dwarkesh appearance: the \"year of agents\" will take closer to a decade, and LLMs are \"a lot smarter than I expected and a lot dumber than I expected.\" Companion data: harness swaps alone moved SWE-bench Pro pass@1 from 23% to 52% on the same GLM-5.2 model.</p>\n   640→        <p class=\"tk\"><b>Takeaway:</b> The next agent gains come from harness, memory, and eval engineering rather than raw model upgrades.</p>\n   641→        <p class=\"m\">Andrej Karpathy (via Agent Brief) · Blog · <time datetime=\"2026-08-26\">2026-08-26</time></p>\n   642→        <p class=\"tags\"><span>agent harness</span><span>AGI timeline</span><span>SWE-bench Pro</span></p>\n   643→      </li>\n   644→\n   645→      <li class=\"item\">\n   646→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://changelog.com/podcast/684\" target=\"_blank\" rel=\"noopener\">Changelog #684: Postgres at PlanetScale — agents shipping schema changes</a></h3>\n   647→        <p class=\"d\">Sam Lambert discusses PlanetScale's $5 Postgres, the Neki Vitess \"do-over,\" \"agents shipping schema changes through deploy requests,\" and rolling back a 500TB table quickly.</p>\n   648→        <p class=\"tk\"><b>Takeaway:</b> Database platforms are adapting their guardrails (deploy requests, rollbacks) for a world where AI agents, not just humans, propose schema migrations.</p>\n   649→        <p class=\"m\">Sam Lambert with Adam Stacoviak (The Changelog) · Podcast · <time datetime=\"2026-08-25\">2026-08-25</time></p>\n   650→        <p class=\"tags\"><span>Postgres</span><span>schema migrations</span><span>developer platforms</span></p>\n   651→      </li>\n   652→\n   653→      <li class=\"item\">\n   654→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://softwareengineeringdaily.com/\" target=\"_blank\" rel=\"noopener\">Software Engineering Daily: the gap between AI spending and AI value</a></h3>\n   655→        <p class=\"d\">Host Kevin Ball examines the disconnect between massive enterprise AI investment and realized value.</p>\n   656→        <p class=\"tk\"><b>Takeaway:</b> In coding specifically, the gap shows up as agent subscriptions that don't translate into shipped software without workflow redesign, verification infrastructure, and organizational change.</p>\n   657→        <p class=\"m\">Kevin Ball (Software Engineering Daily) · Podcast · <time datetime=\"2026-08-25\">2026-08-25</time></p>\n   658→        <p class=\"tags\"><span>AI economics</span><span>ROI</span><span>enterprise</span></p>\n   659→      </li>\n   660→\n   661→      <li class=\"item\">\n   662→        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://stackoverflow.blog/2026/08/25/inside-linkedin-s-cognitive-memory-agent/\" target=\"_blank\" rel=\"noopener\">Stack Overflow Podcast: inside LinkedIn's cognitive memory agent</a></h3>\n   663→        <p class=\"d\">LinkedIn Principal AI Researcher Praveen Bodigutla details a four-layer memory system giving LinkedIn's hiring assistant persistent, personalized state.</p>\n   664→        <p class=\"tk\"><b>Takeaway:</b> Production agent systems are converging on layered memory architectures — a pattern directly transferable to coding agents that must recall project conventions, past failures, and user intent across sessions.</p>\n   665→        <p class=\"m\">Praveen Bodigutla (Stack Overflow Podcast) · Podcast · <time datetime=\"2026-08-25\">2026-08-25</time></p>\n   666→        <p class=\"tags\"><span>memory systems</span><span>production AI</span><span>personalization</span></p>\n   667→      </li>\n   668→\n   669→      <li class=\"item\">\n   670→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://news.ycombinator.com/item?id=49428303\" target=\"_blank\" rel=\"noopener\">HN: 80% of developers find AI coding \"more addictive than helpful\"</a></h3>\n   671→        <p class=\"d\">ZDNet reporting (via HN) on survey data that most developers find AI coding more addictive than helpful — dopamine-loop usage patterns outpacing measured productivity gains.</p>\n   672→        <p class=\"tk\"><b>Takeaway:</b> Adoption metrics conflate engagement with value; the \"feels faster\" effect keeps complicating AI coding ROI measurement, echoing the week's spending-vs-value debate.</p>\n   673→        <p class=\"m\">ZDNet (via Hacker News) · HN · <time datetime=\"2026-08-25\">2026-08-25</time></p>\n   674→        <p class=\"tags\"><span>developer survey</span><span>productivity</span><span>psychology</span></p>\n   675→      </li>\n   676→\n   677→      <li class=\"item\">\n   678→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://news.ycombinator.com/item?id=49429028\" target=\"_blank\" rel=\"noopener\">HN: \"Code maintainability plummets in the AI coding era\"</a></h3>\n   679→        <p class=\"d\">LeadDev article (via HN) arguing AI-generated code is degrading maintainability: more commits, more complexity, thinner review.</p>\n   680→        <p class=\"tk\"><b>Takeaway:</b> Velocity gains from agents are being paid for in long-term maintainability debt — converging with the arXiv finding that agent-first repos without committed AI config saw double the cognitive-complexity growth.</p>\n   681→        <p class=\"m\">LeadDev (via Hacker News) · HN · <time datetime=\"2026-08-25\">2026-08-25</time></p>\n   682→        <p class=\"tags\"><span>maintainability</span><span>code quality</span><span>tech debt</span></p>\n   683→      </li>\n   684→\n   685→      <li class=\"item\">\n   686→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://techcrunch.com/2026/08/24/amjad-masad-ceo-and-co-founder-of-replit-joins-the-disrupt-stage-at-techcrunch-disrupt-2026/\" target=\"_blank\" rel=\"noopener\">Amjad Masad to take TechCrunch Disrupt 2026 stage on \"the future of programming\"</a></h3>\n   687→        <p class=\"d\">TechCrunch announces Replit co-founder/CEO Amjad Masad joins the Disrupt Stage (October 13-15, San Francisco). Masad argues engineers are moving away from keyboard-centric work toward review, direction, and design while agents write most code — and predicts a \"SaaS apocalypse\" as users build their own software.</p>\n   688→        <p class=\"m\">TechCrunch (re: Amjad Masad) · TechMedia · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n   689→        <p class=\"tags\"><span>Replit</span><span>future of programming</span><span>conference</span></p>\n   690→      </li>\n   691→\n   692→      <li class=\"item\">\n   693→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://www.youtube.com/watch?v=wMl6c_r0ubw\" target=\"_blank\" rel=\"noopener\">Two Minute Papers: Qwen3.8-27B — \"this small AI will change everything\"</a></h3>\n   694→        <p class=\"d\">Zsolnai-Fehér highlights Qwen3.8-27B, a 27B open model small enough to run on consumer hardware that punches far above its weight on coding and reasoning benchmarks.</p>\n   695→        <p class=\"tk\"><b>Takeaway:</b> Capable small open models running locally are becoming \"more capable, more accessible, and increasingly difficult to ignore\" — reshaping who can build with frontier-adjacent AI.</p>\n   696→        <p class=\"m\">Károly Zsolnai-Fehér (Two Minute Papers) · YouTube · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n   697→        <p class=\"tags\"><span>Qwen</span><span>small language models</span><span>local inference</span></p>\n   698→      </li>\n   699→\n   700→      <li class=\"item\">\n   701→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://techcrunch.com/2026/08/24/openai-is-building-an-ai-agent-for-everything-will-everyone-use-them/\" target=\"_blank\" rel=\"noopener\">TechCrunch: OpenAI is building AI agents for everything — but will everyone use them?</a></h3>\n   702→        <p class=\"d\">Tim Fernholz's exclusive inside OpenAI's push to bring agents from software engineers to the masses. Key stat: an OpenAI-backed study found 98% of OpenAI employees used Codex in June, but only 17% of organizational subscribers and under 1% of others did.</p>\n   703→        <p class=\"tk\"><b>Takeaway:</b> Coding agents are the proven beachhead; general-purpose agent adoption outside engineering faces a steep usage cliff.</p>\n   704→        <p class=\"m\">Tim Fernholz (TechCrunch) · TechMedia · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n   705→        <p class=\"tags\"><span>OpenAI</span><span>Codex</span><span>adoption</span><span>enterprise</span></p>\n   706→      </li>\n   707→\n   708→      <li class=\"item\">\n   709→        <h3 class=\"t\"><span class=\"badge b-paper\">paper</span> <a href=\"https://arxiv.org/abs/2608.23564\" target=\"_blank\" rel=\"noopener\">SWE Refactor Bench: coding agents fail long-horizon whole-repo migrations (5.4% pass)</a></h3>\n   710→        <p class=\"d\">A benchmark of 20 whole-repository stack migrations with three evaluation stages. Only 5.4% of 520 runs passed all stages; best model scored 47.0/100. Agents did far better on build toolchain rewrites (31.4) than language rewrites (5.6).</p>\n   711→        <p class=\"tk\"><b>Takeaway:</b> Long-horizon, whole-repo transformation remains the frontier failure mode for coding agents — automation excels at local edits, not sustained architectural change.</p>\n   712→        <p class=\"m\">Deyao Hong, Yizhe Chi, et al. (arXiv 2608.23564) · Paper · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n   713→        <p class=\"tags\"><span>benchmark</span><span>refactoring</span><span>long-horizon tasks</span></p>\n   714→      </li>\n   715→\n   716→      <li class=\"item\">\n   717→        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://huggingface.co/papers/trending\" target=\"_blank\" rel=\"noopener\">Trending papers converge on agent harness engineering: Prime Agent, AutoSaddler, Graph Engineering</a></h3>\n   718→        <p class=\"d\">Prime Agent (Prime Intellect) is a self-improving RLM harness with recursive subagents and agent-to-agent coordination (18.8k GitHub stars); Microsoft's AutoSaddler optimizes agent harnesses offline from execution traces; \"Graph Engineering in the Era of LLM Agents\" organizes multi-agent systems as dynamic graphs.</p>\n   719→        <p class=\"tk\"><b>Takeaway:</b> The field's center of gravity is shifting from model upgrades to engineering the scaffolding around models.</p>\n   720→        <p class=\"m\">Prime Intellect, Microsoft, et al. (Hugging Face) · Platform · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n   721→        <p class=\"tags\"><span>agent harness</span><span>multi-agent systems</span><span>graph engineering</span></p>\n   722→      </li>\n   723→\n   724→      <li class=\"item\">\n   725→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://news.ycombinator.com/item?id=49421554\" target=\"_blank\" rel=\"noopener\">HN (558 pts, 544 comments): \"Coding expertise is going to collapse from AI reliance\"</a></h3>\n   726→        <p class=\"d\">The week's dominant Hacker News debate: Lars Faye argues that as agents write most code, developers lose the deliberate practice that builds expertise — fluent at directing agents, unable to debug, design, or verify without them. The thread splits between \"this is how calculators felt\" optimism and warnings that verification skills cannot be learned vicariously.</p>\n   727→        <p class=\"tk\"><b>Takeaway:</b> The expertise-pipeline problem (what happens to juniors?) is now the community's central anxiety.</p>\n   728→        <p class=\"m\">Lars Faye (discussion on Hacker News) · HN · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n   729→        <p class=\"tags\"><span>expertise collapse</span><span>skill atrophy</span><span>junior developers</span></p>\n   730→      </li>\n   731→\n   732→      <li class=\"item\">\n   733→        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://simonwillison.net/2026/Aug/24/llm-anthropic/\" target=\"_blank\" rel=\"noopener\">llm-anthropic 0.27: an SDK migration delegated entirely to Claude Code</a></h3>\n   734→        <p class=\"d\">Willison releases llm-anthropic 0.27 adding compatibility with anthropic Python SDK v1.0.0 (the httpx→httpx2 switch) — the migration was delegated to Claude Fable 5 running in Claude Code with a prompt pointing it at the SDK's migration guide, producing PR #84.</p>\n   735→        <p class=\"tk\"><b>Takeaway:</b> Routine dependency migrations are becoming canonical agentic-coding work — point the agent at the official upgrade docs and review the diff.</p>\n   736→        <p class=\"m\">Simon Willison · Blog · <time datetime=\"2026-08-24\">2026-08-24</time></p>\n   737→        <p class=\"tags\"><span>agentic coding</span><span>SDK migration</span><span>Claude Code</span></p>\n   738→      </li>\n   739→\n   740→      <li class=\"item\">\n   741→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://simonwillison.net/2026/Aug/23/anthropics-best-ai-model-struggles-to-attract-users-as-cheaper-t/\" target=\"_blank\" rel=\"noopener\">Anthropic's best model struggles to attract users as cheaper tools thrive</a></h3>\n   742→        <p class=\"d\">Willison links FT reporting: Anthropic's July annualized revenue hit $65bn and OpenAI's exceeded $40bn, but Ramp's AI index shows pricey \"Fable 5\" at only 8.0% of Anthropic model spend versus Opus 4.8's 28.0%.</p>\n   743→        <p class=\"tk\"><b>Takeaway:</b> Buyers are actively rationing premium model usage in favor of cheaper tiers — pricing pressure is reshaping model choice for coding workloads.</p>\n   744→        <p class=\"m\">Simon Willison (linking Financial Times) · Blog · <time datetime=\"2026-08-23\">2026-08-23</time></p>\n   745→        <p class=\"tags\"><span>model economics</span><span>pricing</span><span>AI coding</span></p>\n   746→      </li>\n   747→\n   748→      <li class=\"item\">\n   749→        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://simonwillison.net/2026/Aug/23/drew-breunig/\" target=\"_blank\" rel=\"noopener\">Drew Breunig: \"Fable &amp; The End of the Free Lunch\" — rationing work across models</a></h3>\n   750→        <p class=\"d\">Breunig argues the high cost of top-tier models ended the era when teams let new models \"paper over\" inefficiencies: \"So we started to think about what work went where.\"</p>\n   751→        <p class=\"tk\"><b>Takeaway:</b> Sophisticated multi-model routing — matching task difficulty to model cost — is becoming a core engineering discipline for AI coding teams.</p>\n   752→        <p class=\"m\">Drew Breunig (via Simon Willison) · Blog · <time datetime=\"2026-08-23\">2026-08-23</time></p>\n   753→        <p class=\"tags\"><span>model routing</span><span>cost optimization</span><span>LLM economics</span></p>\n   754→      </li>\n   755→\n   756→      <li class=\"item\">\n   757→        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://towardsdatascience.com/bug-detection-blind-spots-in-ai-coding-harnesses-gstack-and-beyond/\" target=\"_blank\" rel=\"noopener\">TDS: Bug detection blind spots in AI coding harnesses — 28 debugging experiments</a></h3>\n   758→        <p class=\"d\">Based on 28 debugging experiments, Nhu Hoang maps systematic blind spots in how AI coding harnesses detect bugs — harnesses struggle less with raw complexity than with specific failure geometries.</p>\n   759→        <p class=\"tk\"><b>Takeaway:</b> Debugging is where harness design choices (context assembly, tool access, observation format) most visibly break; treat bug detection as a harness problem, not a model problem.</p>\n   760→        <p class=\"m\">Nhu Hoang (Towards Data Science) · Platform · <time datetime=\"2026-08-23\">2026-08-23</time></p>\n   761→        <p class=\"tags\"><span>debugging</span><span>bug detection</span><span>evaluation</span></p>\n   762→      </li>\n   763→\n   764→      <li class=\"item\">\n   765→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://simonwillison.net/2026/Aug/22/linus-torvalds/\" target=\"_blank\" rel=\"noopener\">Linus Torvalds credits AI as his \"tireless helper\" in grueling kernel debug</a></h3>\n   766→        <p class=\"d\">In a Linux drm/xe commit, Torvalds describes an AI assistant that repeatedly declared the debugging problem impossible but faithfully added and analyzed debug code when pushed, ultimately helping crack a grueling issue.</p>\n   767→        <p class=\"tk\"><b>Takeaway:</b> Even famously skeptical systems programmers are incorporating LLMs as persistent debugging partners — while still overriding their pessimistic judgments.</p>\n   768→        <p class=\"m\">Linus Torvalds (via Simon Willison) · Blog · <time datetime=\"2026-08-22\">2026-08-22</time></p>\n   769→        <p class=\"tags\"><span>Linux kernel</span><span>AI debugging</span></p>\n   770→      </li>\n   771→\n   772→      <li class=\"item\">\n   773→        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://simonwillison.net/2026/Aug/22/more-than-just-code-review/\" target=\"_blank\" rel=\"noopener\">Simon Willison: coding agents require \"more than just code review\"</a></h3>\n   774→        <p class=\"d\">Willison argues the core skill for working with coding agents is confidently instructing changes and then verifying them — by means beyond eyeballing every line of generated code.</p>\n   775→        <p class=\"tk\"><b>Takeaway:</b> Verification techniques (tests, logs, behavioral checks) must scale up because line-by-line review doesn't scale to agent-written codebases.</p>\n   776→        <p class=\"m\">Simon Willison · Blog · <time datetime=\"2026-08-22\">2026-08-22</time></p>\n   777→        <p class=\"tags\"><span>code review</span><span>verification</span><span>developer skills</span></p>\n   778→      </li>\n   779→\n   780→      <li class=\"item\">\n   781→        <h3 class=\"t\"><span class=\"badge b-technical\">technical</span> <a href=\"https://simonwillison.net/2026/Aug/22/llm/\" target=\"_blank\" rel=\"noopener\">llm 0.33 released: OpenAI library 3.x, httpx2, reasoning summaries</a></h3>\n   782→        <p class=\"d\">Willison ships llm 0.33 switching to OpenAI library 3.x with the httpx→httpx2 migration, per-call --key for embeddings, repeatable -t/--template combination, and a reasoning_summary option — days after an emergency 0.32.1 pin when OpenAI dropped httpx support.</p>\n   783→        <p class=\"tk\"><b>Takeaway:</b> Rapid upstream SDK churn keeps breaking local AI tooling, and plugin ecosystems must absorb migrations fast.</p>\n   784→        <p class=\"m\">Simon Willison · Blog · <time datetime=\"2026-08-22\">2026-08-22</time></p>\n   785→        <p class=\"tags\"><span>LLM tooling</span><span>OpenAI SDK</span><span>release engineering</span></p>\n   786→      </li>\n   787→\n   788→      <li class=\"item\">\n   789→        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://simonwillison.net/2026/Aug/21/stop-making-tuis/\" target=\"_blank\" rel=\"noopener\">Thomas Ptacek: \"Stop Making TUIs\" — agents make native GUIs nearly free</a></h3>\n   790→        <p class=\"d\">Ptacek (amplified by Willison) argues that AI coding agents have made building native GUIs so cheap that even small personal tools deserve real interfaces: \"Go build a native UI.\"</p>\n   791→        <p class=\"tk\"><b>Takeaway:</b> Agents invert a longstanding cost assumption in tool-building — interface polish is no longer the expensive part.</p>\n   792→        <p class=\"m\">Thomas Ptacek (via Simon Willison) · Blog · <time datetime=\"2026-08-21\">2026-08-21</time></p>\n   793→        <p class=\"tags\"><span>GUI tooling</span><span>developer tools</span><span>agents</span></p>\n   794→      </li>\n   795→\n   796→      <li class=\"item\">\n   797→        <h3 class=\"t\"><span class=\"badge b-opinion\">opinion</span> <a href=\"https://simonwillison.net/2026/Aug/21/matt-webb/\" target=\"_blank\" rel=\"noopener\">Matt Webb: outsourcing thinking to AI pushed him to learn more, not less</a></h3>\n   798→        <p class=\"d\">Webb describes using ChatGPT as a patient tutor to finally learn quaternions while adding an augmented-reality mode to Galactic Compass, concluding that AI-assisted learning increased rather than decreased his understanding.</p>\n   799→        <p class=\"tk\"><b>Takeaway:</b> AI as tutor can complement rather than erode human learning — a counterpoint to cognitive-atrophy worries.</p>\n   800→        <p class=\"m\">Matt Webb (via Simon Willison) · Blog · <time datetime=\"2026-08-21\">2026-08-21</time></p>\n   801→        <p class=\"tags\"><span>AI-assisted learning</span><span>tutoring</span><span>cognition</span></p>\n   802→      </li>\n   803→\n   804→      <li class=\"item\">\n   805→        <h3 class=\"t\"><span class=\"badge b-discussion\">discussion</span> <a href=\"https://stackoverflow.blog/podcast/\" target=\"_blank\" rel=\"noopener\">Stack Overflow Podcast: \"get rid of your CAPTCHA\" — a web built for bots</a></h3>\n   806→        <p class=\"d\">Brian Alvey (CTO, WordPress VIP) argues AI agents are becoming the web's primary users and sites should stop blocking them: CAPTCHAs should go, and structured content will persist because agents consume it.</p>\n   807→        <p class=\"tk\"><b>Takeaway:</b> As coding and browsing agents proliferate, the web's economics and access norms (paywalls, bot policies, llms.txt-style discovery) are being renegotiated.</p>\n   808→        <p class=\"m\">Brian Alvey (Stack Overflow Podcast) · Podcast · <time datetime=\"2026-08-21\">2026-08-21</time></p>\n   809→        <p class=\"tags\"><span>web economics</span><span>bots</span><span>structured content</span></p>\n   810→      </li>\n   811→\n   812→    </ol>\n   813→  </section>\n   814→\n   815→</main>\n   816→\n   817→<footer>\n   818→  <div class=\"fbar\">\n   819→    <span>Agent Code Daily — Powered by Claude Agent SDK</span>\n   820→    <nav aria-label=\"Footer navigation\">\n   821→      <a href=\"#top\">Top</a>\n   822→      <a href=\"#new-products\">New Products</a>\n   823→      <a href=\"#updates\">Whitelist Updates</a>\n   824→      <a href=\"#insights\">Technical Insights</a>\n   825→      <button class=\"printbtn\" type=\"button\" onclick=\"window.print()\">Print</button>\n   826→    </nav>\n   827→  </div>\n   828→  <p class=\"fnote\">Compiled 2026-08-28 from Show HN, vendor changelogs, arXiv preprints, podcasts and community discussion. Dates in YYYY-MM-DD. External links open in a new tab. Click any description to expand truncated text.</p>\n   829→</footer>\n   830→\n   831→<script>\n   832→(function () {\n   833→  document.querySelectorAll('.d').forEach(function (el) {\n   834→    el.setAttribute('title', 'Click to expand / collapse');\n   835→    el.addEventListener('click', function () {\n   836→      el.classList.toggle('open');\n   837→    });\n   838→  });\n   839→})();\n   840→</script>\n   841→\n   842→</body>\n   843→</html>\n   844→"
      }
    ]
