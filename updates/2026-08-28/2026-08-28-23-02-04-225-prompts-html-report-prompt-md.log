      "content": "[\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Upcoming changes to GitHub Copilot policies and billing\",\n    \"description\": \"GitHub announced three changes: Copilot Business/Enterprise signups reopen Sep 1 with upfront per-seat billing from Oct 1; the cloud agent, Chat on github.com, and Mobile chat merge into one unified experience no earlier than Sep 28 (opting out loses Copilot on github.com/Mobile); and code review default shifts from Lite to Balanced on Sep 28.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/2026-08-28-upcoming-changes-to-github-copilot-policies-and-billing\",\n    \"date\": \"2026-08-28\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"It forces you to pay at least $20 in tokens per user even for people who use less.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Unclear whether the billing changes apply to enterprises paying via Azure.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"v2.1.248: --restricted sandbox mode, cross-session messaging on Bedrock/Vertex/Foundry, /usage-credits\",\n    \"description\": \"v2.1.248 adds a `--restricted` mode that removes command/code-execution tools and WebFetch, keeps file tools sandboxed to the working directory, and ignores local settings files; expands cross-session messaging (SendMessage/ListAgents) to Bedrock, Vertex, and Foundry; adds /usage-credits for Enterprise orgs to request higher limits; and adds experimental per-agent prompt-cache TTL (cacheTtl).\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases/tag/v2.1.248\",\n    \"date\": \"2026-08-27\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cloud Agents: Start from scratch without a repo, live preview, Vercel publishing\",\n    \"description\": \"Cloud Agents no longer need a connected GitHub or other SCM provider to start work — 'Start from scratch' creates an Origin repo behind the scenes, with a Create repo button to save agent work. Live preview port-forwards the agent's environment to the browser, and agents can publish to a live URL via a connected Vercel account.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-08-27\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"[I] wish [they] keep the Cursor brand and vision of an E2E Developer platform from Origin to Cloud Agents intact.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot code review: Resolution reasons and expanded capabilities\",\n    \"description\": \"Copilot code review now reports resolution reasons and gains expanded capabilities, helping developers understand why suggested changes were or weren't applied when Copilot reviews pull requests.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-08-27-copilot-code-review-resolution-reasons-and-expanded-capabilities\",\n    \"date\": \"2026-08-27\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Global model policy generally available\",\n    \"description\": \"GitHub's global model policy for Copilot is now generally available, giving administrators a single policy to govern which AI models are available across their organization.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-08-26-global-model-policy-generally-available\",\n    \"date\": \"2026-08-26\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Automations and Slack upgrades: queued messages, multi-channel triggers, batch security remediation\",\n    \"description\": \"Devin's August 26 release adds queued message delivery during long waits, smarter @mention routing to subscribed sessions, automation triggers across multiple Slack channels, an 'Improve with Devin' action for iterating on automations, Jira status_changed triggers, batch remediation of security findings via new v3 API routes, and an org setting allowing sessions to open PRs as validated collaborators.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/2026\",\n    \"date\": \"2026-08-26\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Codex CLI 0.150.0: @-mention other Codex tasks, /copy picker, Interrupt hooks\",\n    \"description\": \"Codex CLI 0.150.0 lets users reference other Codex tasks with @ mentions and ask agents to read, create, or message tasks from the terminal; /copy gains a picker for full responses, code blocks, and blockquotes; task titles are auto-generated with /rename suggestions; new Interrupt hooks were added. Security fixes ensure untrusted projects no longer inject project-level AGENTS.md instructions. Patch 0.150.1 (Aug 27) fixes remote compaction image token budgets.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/openai/codex/releases/tag/rust-v0.150.0\",\n    \"date\": \"2026-08-26\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"mid august 2026 codex is good, both cli and desktop app, you get lots of usage on any plan. Codex CLI is pretty bare bones in a bad way.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"PSA: Ultra and subagents will burn your tokens — subagents spawn with the parent model.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Codex CLI 0.150.0 is out! Reference other Codex tasks with @ mentions; agents can read, create, or message tasks from the terminal.\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot app Customize tab is generally available\",\n    \"description\": \"The Customize tab in the GitHub Copilot app reached general availability, letting users tailor Copilot's behavior, instructions, and tooling from a dedicated UI surface.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-08-25-github-copilot-app-customize-tab-is-generally-available\",\n    \"date\": \"2026-08-25\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Event-triggered scheduled tasks for Codex (Gmail, Slack, GitHub events)\",\n    \"description\": \"Scheduled tasks can now run on Gmail, Slack, or GitHub events — e.g. filtered Gmail messages, watched Slack channels, or PR activity like reviews and merges — available on web and mobile for eligible plans, complementing time-based schedules.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://learn.chatgpt.com/docs/changelog\",\n    \"date\": \"2026-08-25\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Gemini CLI v0.57.0: OAuth fixes for Cloud Workstations, capacity-aware retries, IDE connection fixes\",\n    \"description\": \"Gemini CLI's v0.57.0 weekly stable release dynamically resolves Cloud Workstations proxy redirect URIs for OAuth flows, fixes swallowed directory mismatches in IDE connections, adds context-aware silent retries with availability TTL for capacity errors, rolls back entire multi-turn requests on cancellation, prevents indefinite TUI hangs via execution timeouts, and improves evals with tool-call formatting and failure summaries.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/google-gemini/gemini-cli/releases/tag/v0.57.0\",\n    \"date\": \"2026-08-25\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Gemini CLI is updating so fast! A new feature or improvement drops every other day.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Lately Gemini CLI response times have become extremely slow for me, even on Flash. Constant hangs.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"`codex mcp-server` deprecated in favor of Codex app server\",\n    \"description\": \"OpenAI deprecated the `codex mcp-server` command in favor of the Codex app server, pointing Claude Code users to the Codex plugin for integration.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://learn.chatgpt.com/docs/changelog\",\n    \"date\": \"2026-08-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot harness generally available in Copilot for JetBrains\",\n    \"description\": \"The Copilot harness reached GA in JetBrains IDEs alongside a public preview of a built-in JetBrains MCP server exposing IDE capabilities to MCP-driven agent workflows. The release adds /review in-IDE, a What's New tab after plugin updates, model-search/UX improvements, and reliability fixes for sign-in, BYOK, and agent session continuity.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-08-24-copilot-harness-generally-available-in-copilot-for-jetbrains\",\n    \"date\": \"2026-08-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"The new GitHub Copilot experience in Slack\",\n    \"description\": \"A refreshed GitHub Copilot experience for Slack shipped as a release, letting users invoke Copilot and its agents directly from Slack conversations as part of GitHub's collaboration tools refresh.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-08-21-the-new-github-copilot-experience-in-slack\",\n    \"date\": \"2026-08-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Shared agentic work with GitHub Copilot in Microsoft Teams\",\n    \"description\": \"GitHub Copilot brings shared agentic work to Microsoft Teams, enabling teams to collaborate with Copilot agents inside Teams channels — part of GitHub's push to embed agentic coding in workplace collaboration tools.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-08-21-shared-agentic-work-with-github-copilot-in-microsoft-teams\",\n    \"date\": \"2026-08-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Windsurf/Devin Desktop v3.8.20: multi-window Agent Command Center, Devin Local plan mode\",\n    \"description\": \"Windsurf (now Devin Desktop under Cognition) v3.8.20 ships Agent Command Center improvements (follows selected space, in-place conversion, side-by-side agent windows, optional separate window via devin.agentWindow.location), faster Agent/Editor mode switching (Ctrl/Cmd+G), untrusted-workspace trust prompts, and a Devin CLI shim. Devin Local adds multi-root workspaces, plan mode producing a Markdown plan file with an Implement button, individually stoppable subagents, and post_setup_worktree hooks. Devin Cloud improves session filtering and live shell output streaming.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-08-21\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Devin local feels amazing... but the quota burn is brutal.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Hitting daily limits on Devin Local in less than an hour — I assumed it was unlimited.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Session experience redesign: nested sub-Devin trees, session subscribers, custom sidebar tabs\",\n    \"description\": \"Devin redesigned the session page with a compact header with built-in tags, a redesigned sessions sidebar with custom nav tabs/grouping/filtering, sub-Devin sessions displayed as a nested tree, session subscribers (follow and view others' sessions), bearer-token auth for automation webhooks, and expanded security-scan controls (change scan profiles, effort levels, incremental scan v3 endpoints).\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/2026\",\n    \"date\": \"2026-08-21\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Is it true?! Cognition turns Windsurf into Devin Desktop.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"PSA: Devin Desktop Diagnostics will expose your private data.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Codex CLI 0.149.0: interactive `codex agents` dashboard, `codex queue`, /cd commands\",\n    \"description\": \"Codex CLI 0.149.0 adds an interactive `codex agents` dashboard for managing sessions, /cd, /pwd and /cwd commands, `codex queue` for messaging existing sessions, expanded Vim motions, broader `codex doctor` diagnostics, and SDK support for exact config overrides plus max/ultra reasoning effort. Fixes include queued-message wake-ups, permission-profile restoration on resume, and Windows Terminal scrollback history.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://developers.openai.com/codex/changelog/\",\n    \"date\": \"2026-08-20\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Codex won five of the six open-ended design rounds... Codex used nine agents and finished in ~5 hours; Claude Code used 25.\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Impressions two weeks after moving from Claude Code to [Codex]: Claude Code has a more mature plugin system and richer skills frontmatter.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cloud Agents and Cursor Harness improvements: subscriptions, isolated subagents, /goal\",\n    \"description\": \"Cursor's agent harness update adds Subscriptions (cloud agents monitor PRs, watch Slack threads, or run scheduled tasks and wake on events, auto-subscribing to PRs they create), custom modes pinnable in chat, subagents running on isolated VMs with clean project copies, /goal for long-lived objectives (e.g. fixing flaky tests until CI is green), and steering improvements where follow-ups wait for the next tool call.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-08-19\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Cursor is evolving so quickly that it's becoming difficult to keep track of all the updates.\",\n        \"source\": \"Forum\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"The update experience is being actively improved right now.\",\n        \"source\": \"Forum\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"GPT-5.6 Sol available at 70% discount on Devin Desktop and CLI\",\n    \"description\": \"Cognition announced that GPT-5.6 Sol is available at a 70% discount on Devin Desktop and Devin CLI through October 3, 2026, lowering the cost of running OpenAI's model on Devin's platform.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://devin.ai/blog\",\n    \"date\": \"2026-08-18\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"GPT-5.6 Sol is now the most affordable frontier model on Devin Desktop and CLI.\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"I see that there is lack of end to end understanding about Devin, what it actually is, what you get as part of the subscription, what's Devin Desktop etc.\",\n        \"source\": \"X\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"/design research preview, Concise output style, and device cards (Week 34 updates)\",\n    \"description\": \"Claude Code introduced a /design research preview bringing an artboard workflow to CLI and Desktop (Claude drafts editable artboards and builds the chosen one), a built-in Concise output style that leads with results, device cards via `claude remote-control` for starting sessions from a phone, and an ANTHROPIC_DEFAULT_MODEL env var for setting the default starting model. Shipped across v2.1.234–v2.1.239.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w34\",\n    \"date\": \"2026-08-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Origin Code Hosting: Cursor now hosts your code\",\n    \"description\": \"Cursor launched Origin code hosting in early beta on all paid plans: Origin Repos managed via a new Codebase tab, GitHub repo sync for browsing/searching (GitHub remains source of truth), PR views with timelines/checks/diffs and two-way comment sync, agents in every repo, and app extensions (Vercel preview deployments, Depot, Buildkite CI).\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-08-17\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Why not evaluate them on the merits? ... GitHub has so many outages, but dammit, that other one has a terrible name, it's practically unusable\",\n        \"source\": \"HN\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"How about an original and distinguishable name? ... A word that is already used in computer is a bad name.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Cursor is launching a GitHub competitor. Is this a land grab?\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"You can now host your repos in Cursor Origin and deploy to Vercel via Cursor Origin, which is itself hosted on Vercel\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Cursor Origin Has 7 Traps, And One of Them Is Permanent\",\n        \"source\": \"Blog comments\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Cursor Origin + Buildkite problem: repos synced to Origin don't appear in Buildkite — mirrors reportedly block CI apps\",\n        \"source\": \"Forum\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"With the Grok code incident in recent memory I have zero interest in trusting our company's crown jewels with this service.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Cursor timing the Origin launch with a GitHub outage is... something.\",\n        \"source\": \"X\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Grok 4.6 is now available in GitHub Copilot\",\n    \"description\": \"xAI's Grok 4.6 model is now selectable in GitHub Copilot's model picker, continuing GitHub's multi-model strategy alongside Claude, GPT, and Gemini options.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-08-14-grok-4-6-is-now-available-in-github-copilot\",\n    \"date\": \"2026-08-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Devin Coach and August 14 release: prompt suggestions, Devin Review skip logic, Devin Local default for enterprise\",\n    \"description\": \"Devin shipped Devin Coach (suggestions in the input box to improve prompts before sending), Devin Review skipping re-review of PRs with unchanged diffs, session auto-subscription to Slack threads, teams chat polish, and Devin Local enabled by default for enterprise customers.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/2026\",\n    \"date\": \"2026-08-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Auto mode becomes the default permission mode for new Claude Code sessions (effective Aug 14)\",\n    \"description\": \"As of August 14, 2026, auto mode is the default permission mode for new Claude Code sessions on Pro, Max, and Team plans, with transcript protections that block dangerous operations while reducing permission prompts. Announced in the Week 32 notes; community discussion was extensive.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w32\",\n    \"date\": \"2026-08-14\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Anthropic Flips Claude Code to Auto Mode by Default Aug 14, after finding AI blocks 80%+ dangerous queries while humans only 14%\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"there's plenty of 'optimization' around rubberbanding usage limits as well as routing to a different model in the backend. The incentives are too strong.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Effort level is actually controlled entirely by system prompt... so actually this is a valid way to check I think\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Anthropic are really confident in Claude Code's auto mode, to make it the default.\",\n        \"source\": \"Blog comments\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"You can configure auto mode in plain English — the classifier is a separate model that reviews each action.\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Me 5 days ago: Codex's auto mode can't handle basic tasks, never again. Me today, watching Claude Code spin because Anthropic is down.\",\n        \"source\": \"X\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  }\n]",
      "numLines": 389,
      "startLine": 1,
      "totalLines": 389
    }
  }
