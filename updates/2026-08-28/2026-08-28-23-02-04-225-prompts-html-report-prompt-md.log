          "-    if (e.target.closest('a') || e.target.closest('button')) return;",
          "-    var p = e.target.closest('.clamp');",
          "-    if (p) p.classList.toggle('open');",
          "-  });",
          "-  // Expand / collapse all control.",
          "-  var eb = document.getElementById('expand-all');",
          "-  if (eb) {",
          "-    eb.addEventListener('click', function(){",
          "-      var expand = document.body.classList.toggle('all-expanded');",
          "-      document.querySelectorAll('.clamp').forEach(function(c){",
          "-        c.classList.toggle('open', expand);",
          "-      });",
          "-      eb.textContent = expand ? 'collapse all' : 'expand all';",
          "+(function () {",
          "+  document.querySelectorAll('.d').forEach(function (el) {",
          "+    el.setAttribute('title', 'Click to expand / collapse');",
          "+    el.addEventListener('click', function () {",
          "+      el.classList.toggle('open');",
          "     });",
          "-  }",
          "+  });",
          " })();",
          " </script>",
          "+",
          " </body>",
          " </html>"
        ]
      }
    ],
    "originalFile": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"description\" content=\"Daily research digest of agentic coding: 30 new products, 22 tracked product updates, and 33 technical insights for 2026-08-28.\">\n<title>Agentic Coding Research Report — 2026-08-28</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' fill='%23ff6600'/><text x='3' y='12' font-size='11' font-family='Arial' fill='%23ffffff' font-weight='bold'>A</text></svg>\">\n<style>\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\n:root{\n  --bg:#f6f6ef;\n  --text:#000;\n  --muted:#828282;\n  --accent:#ff6600;\n  --accent-dark:#cc4e00;\n  --border:#d4d4d4;\n  --border-lt:#e6e6da;\n  --code-bg:#ebebe0;\n}\nhtml{scroll-behavior:smooth}\nbody{background:var(--bg);color:var(--text);font:13px/1.5 Verdana,Geneva,sans-serif;overflow-wrap:break-word}\na{color:var(--text);text-decoration:none}\na:hover{color:var(--accent);text-decoration:underline}\ncode{font-family:Monaco,Consolas,\"Courier New\",monospace;font-size:.88em;background:var(--code-bg);padding:0 3px;border-radius:2px}\ntime{color:inherit}\n.wrap{max-width:1560px;margin:0 auto;padding:0 12px}\n.skip{position:absolute;left:-9999px;top:0;background:var(--accent);color:#fff;padding:6px 10px;z-index:99;font-size:12px}\n.skip:focus{left:8px;top:8px}\n\n/* ---------- Top bar ---------- */\n.topbar{background:var(--accent)}\n.topbar-in{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:6px 0}\n.brand{font-family:Arial,Helvetica,sans-serif;font-weight:700;font-size:15px;letter-spacing:.2px;white-space:nowrap}\n.brand a{color:#000}\n.brand a:hover{color:#fff;background:transparent;text-decoration:none}\n.brand .logo{display:inline-block;background:#000;color:var(--accent);font-size:12px;padding:1px 5px;margin-right:6px;vertical-align:1px}\n.topnav{display:flex;align-items:center;gap:8px;font-size:12px;flex-wrap:wrap}\n.topnav a{color:#000}\n.topnav a:hover{color:#fff;text-decoration:none}\n.topnav .n{font-weight:700}\n.topnav .sep{color:rgba(0,0,0,.35)}\n.top-date{margin-left:auto;font-size:12px;color:#000;font-family:Arial,Helvetica,sans-serif;white-space:nowrap}\n\n/* ---------- Sub header ---------- */\n.subbar{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;padding:10px 0 8px;border-bottom:2px solid var(--accent)}\n.subbar h1{font-family:Arial,Helvetica,sans-serif;font-size:16px}\n.h1date{color:var(--muted);font-weight:400;font-size:13px;margin-left:6px}\n.tagline{color:var(--muted);font-size:11px;margin-top:3px}\n.subright{text-align:right}\n.stats{font-size:11px;color:var(--muted)}\n.stats b{color:var(--accent-dark)}\n#expand-all{margin-top:5px;font:10.5px Verdana,Geneva,sans-serif;color:#333;background:#eeeee0;border:1px solid var(--border);padding:2px 8px;cursor:pointer;border-radius:2px}\n#expand-all:hover{background:var(--accent);border-color:var(--accent);color:#fff}\n\n/* ---------- Columns ---------- */\nmain.columns{display:grid;grid-template-columns:40fr 35fr 25fr;align-items:start}\n.col{padding:8px 14px 30px;border-left:1px solid var(--border);min-width:0}\n.col:first-child{border-left:none;padding-left:0}\n.col h2{position:sticky;top:0;z-index:5;background:var(--bg);display:flex;align-items:baseline;gap:7px;font-family:Arial,Helvetica,sans-serif;font-size:12.5px;letter-spacing:.6px;text-transform:uppercase;color:var(--accent-dark);padding:10px 0 6px;border-bottom:2px solid var(--accent)}\n.col h2 .count{background:var(--accent);color:#fff;font-size:10px;padding:1px 6px;border-radius:8px}\n.col-note{color:var(--muted);font-size:10.5px;padding:6px 0;border-bottom:1px solid var(--border-lt)}\nol.items{list-style:none}\nli.item{padding:9px 4px 9px 2px;border-bottom:1px solid var(--border-lt)}\nli.item:hover{background:rgba(255,102,0,.045)}\nli.item:last-child{border-bottom:none}\nli.product{display:flex;gap:7px}\n.rank{color:var(--muted);font-size:11.5px;min-width:18px;text-align:right;padding-top:2px;flex-shrink:0}\n.itembody{flex:1;min-width:0}\n\n/* ---------- Item typography ---------- */\n.ttl{font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.35}\n.ttl a:hover{color:var(--accent)}\n.host{color:var(--muted);font-weight:400;font-size:10.5px}\n.meta{margin-top:3px;font-size:10.5px;color:var(--muted)}\n.meta a{color:var(--accent)}\n.updhead{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:2px}\n.prod{font-family:Arial,Helvetica,sans-serif;font-weight:700;font-size:12.5px}\n.ver{font-size:10.5px}\n.badge{display:inline-block;font-family:Arial,Helvetica,sans-serif;font-size:9px;text-transform:uppercase;letter-spacing:.5px;padding:1px 5px;border-radius:2px;border:1px solid;vertical-align:1px}\n.badge.release,.badge.tech{color:#b34d00;background:#ffe8d6;border-color:#f2c9a4}\n.badge.feature,.badge.discussion{color:#5a5a44;background:#ececdd;border-color:#d6d6c2}\n.badge.announcement,.badge.opinion{color:#444;background:transparent;border-color:#bbb}\n.badge.tutorial{color:#3e5c3e;background:#e4ecdd;border-color:#c2d2b4}\n\n/* ---------- Tags ---------- */\n.tagrow{margin-top:4px}\n.tag{display:inline-block;font-family:Arial,Helvetica,sans-serif;font-size:9.5px;color:#666;background:#ececdf;border:1px solid #dcdccb;border-radius:2px;padding:0 4px;margin:2px 4px 0 0}\n.tags{margin-top:4px;font-family:Monaco,Consolas,monospace;font-size:9.5px;color:#9a9a8c}\n\n/* ---------- Body / clamp / takeaway / quotes ---------- */\n.desc{margin-top:4px;font-size:11.8px;color:#2e2e2a}\n.clamp{display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden;cursor:pointer}\n.c2{-webkit-line-clamp:2}.c3{-webkit-line-clamp:3}.c4{-webkit-line-clamp:4}\n.clamp.open{display:block;-webkit-line-clamp:unset}\n.clamp:hover{background:rgba(255,102,0,.05)}\n.takeaway{margin-top:5px;font-size:11.2px;color:#3c3c36;border-left:3px solid var(--accent);padding:1px 0 1px 7px}\n.takeaway b{color:var(--accent-dark);font-family:Arial,Helvetica,sans-serif;font-size:9.5px;text-transform:uppercase;letter-spacing:.5px;margin-right:4px}\n.quotes{margin-top:5px}\n.quote{font-size:10.8px;color:#555;font-style:italic;border-left:2px solid var(--border);padding:1px 0 1px 7px;margin-top:3px}\n.qsrc{color:var(--muted);font-style:normal;font-size:9.8px;white-space:nowrap}\n.sent-pos::before{content:\"▲ \";color:#4e7a44;font-style:normal}\n.sent-neg::before{content:\"▼ \";color:#a34d33;font-style:normal}\n.sent-neu::before{content:\"◆ \";color:var(--muted);font-style:normal}\n\n/* ---------- Footer ---------- */\nfooter{border-top:2px solid var(--accent);background:#efefe4;margin-top:6px}\n.foot-in{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;padding:9px 0;font-size:10.5px;color:var(--muted)}\n.foot-in a{color:var(--accent)}\n.foot-nav{display:flex;gap:8px;align-items:center;flex-wrap:wrap}\n.foot-nav .sep{color:var(--border)}\n\n/* ---------- Responsive ---------- */\n@media (max-width:1200px){\n  main.columns{grid-template-columns:1fr 1fr}\n  .col-products{grid-column:1/-1;border-left:none;padding-left:0}\n  .col-updates{border-left:1px solid var(--border);padding-left:14px}\n}\n@media (max-width:780px){\n  main.columns{grid-template-columns:1fr}\n  .col{border-left:none;padding-left:0}\n  .col:not(:first-child){border-top:1px solid var(--border);margin-top:8px}\n  .top-date{display:none}\n  .subright{text-align:left}\n}\n@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}\n\n/* ---------- Print ---------- */\n@media print{\n  body{background:#fff;font-size:9.5pt}\n  .wrap{max-width:none;padding:0}\n  .topbar{background:none;border-bottom:2px solid #000}\n  .brand a,.topnav a,.top-date{color:#000}\n  .brand .logo{background:#000;color:#fff}\n  #expand-all{display:none}\n  .col h2{position:static;color:#000;border-bottom:1px solid #000}\n  .clamp{display:block!important;-webkit-line-clamp:unset!important;cursor:auto}\n  li.item,.quote,.takeaway{break-inside:avoid}\n  a{color:#000}\n  .meta a,.foot-in a{color:#000}\n  li.item:hover{background:none}\n  footer{background:none;border-top:1px solid #000}\n}\n</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n\n<header class=\"topbar\">\n  <div class=\"wrap topbar-in\">\n    <span class=\"brand\"><a href=\"#top\"><span class=\"logo\">A</span>Agentic Coding Daily</a></span>\n    <nav class=\"topnav\" aria-label=\"Section navigation\">\n      <a href=\"#new-products\">new <span class=\"n\">30</span></a><span class=\"sep\">|</span>\n      <a href=\"#whitelist-updates\">updates <span class=\"n\">22</span></a><span class=\"sep\">|</span>\n      <a href=\"#technical-insights\">insights <span class=\"n\">33</span></a>\n    </nav>\n    <span class=\"top-date\">2026-08-28</span>\n  </div>\n</header>\n\n<div class=\"wrap subbar\" id=\"top\">\n  <div>\n    <h1>Agentic Coding Research Report <span class=\"h1date\">— 2026-08-28</span></h1>\n    <p class=\"tagline\">New tools, product updates and technical signals in agentic coding · coverage 2026-08-14 → 2026-08-27 · tip: click truncated text to expand</p>\n  </div>\n  <div class=\"subright\">\n    <p class=\"stats\"><b>30</b> new products · <b>22</b> tracked updates · <b>33</b> insights</p>\n    <button id=\"expand-all\" type=\"button\">expand all</button>\n  </div>\n</div>\n\n<main id=\"main\" class=\"wrap columns\">\n\n  <!-- ==================== NEW PRODUCTS ==================== -->\n  <section id=\"new-products\" class=\"col col-products\" aria-labelledby=\"h-products\">\n    <h2 id=\"h-products\">New Products <span class=\"count\">30</span></h2>\n    <p class=\"col-note\">Fresh tools &amp; products surfaced in the agentic coding space, ranked by community attention.</p>\n    <ol class=\"items\">\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">1.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://cursor.com/changelog/origin-code-hosting\" target=\"_blank\" rel=\"noopener noreferrer\">Cursor Origin</a> <span class=\"host\">(cursor.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-17\">2026-08-17</time> · Cursor changelog · VentureBeat · YourStory</p>\n          <p class=\"tagrow\"><span class=\"tag\">agent-native code hosting</span><span class=\"tag\">dev workflow platform</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Agent-native code hosting platform built into Cursor: cloud Git repositories, pull requests, code review and GitHub sync designed for high-volume AI coding agent workflows. Early beta began rolling out to all paid plans in mid-August 2026, debuting during a major GitHub outage which amplified attention.</p>\n          <div class=\"quotes\">\n            <p class=\"quote\">“Commentators highlighted the launch landing the same week as a major GitHub outage, exposing the risk of centralized code hosting” <span class=\"qsrc\">— community</span></p>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">2.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://github.com/proliferate-ai/proliferate\" target=\"_blank\" rel=\"noopener noreferrer\">Proliferate</a> <span class=\"host\">(github.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-21\">2026-08-21</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">self-hosted AI IDE</span><span class=\"tag\">multi-agent harness</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Open-source (AGPL-3.0), self-hostable AI IDE from a YC S25 founder that runs multiple coding agents (Claude Code, Codex, OpenCode, Cursor, Grok) in one interface, with parent agents spawning subagents and reusable Workflows with human approval gates. Uses each agent's own harness, subscriptions and auth.</p>\n          <div class=\"quotes\">\n            <p class=\"quote\">“The open-source route makes a lot of sense here. So excited!” <span class=\"qsrc\">— HN</span></p>\n            <p class=\"quote\">“ooo, nice Workflows feature you got there.” <span class=\"qsrc\">— HN</span></p>\n            <p class=\"quote\">“It was frustrating to set up and the docs confusing” <span class=\"qsrc\">— HN</span></p>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">3.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://github.com/harnessrouter/harnessrouter\" target=\"_blank\" rel=\"noopener noreferrer\">HarnessRouter</a> <span class=\"host\">(github.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-17\">2026-08-17</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">AI coding CLI infra</span><span class=\"tag\">harness router</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Unified API layer for running coding-agent harnesses (Codex, Claude Code, Hermes) as a product backend — “LiteLLM for harnesses rather than models”. Ships as a Docker image and proposes a Unified Harness Protocol for task execution, event streaming and session management.</p>\n          <div class=\"quotes\">\n            <p class=\"quote\">“Think of it as OpenRouter, but for different agent harnesses, not models” <span class=\"qsrc\">— HN</span></p>\n            <p class=\"quote\">“I'm still unclear why I need to route across multiple agent harnesses vs just sticking with one” <span class=\"qsrc\">— HN</span></p>\n            <p class=\"quote\">“How does this handle harness-specific features without becoming a lowest-common-denominator API?” <span class=\"qsrc\">— HN</span></p>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">4.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49378768\" target=\"_blank\" rel=\"noopener noreferrer\">Huzzah</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-20\">2026-08-20</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">AI IDE</span><span class=\"tag\">experimental editor</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Experimental code editor by Daniel Vaughn offering a new paradigm for AI-assisted coding: developers write brief declarative pseudocode that stays as the persistent source of truth, and Huzzah generates and maintains the real code from it, acting as both prompt and documentation.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">5.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://code.visualstudio.com/blogs/2026/08/26/agent-host-architecture\" target=\"_blank\" rel=\"noopener noreferrer\">VS Code Agent Host</a> <span class=\"host\">(vscode.blog)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-26\">2026-08-26</time> · VS Code blog</p>\n          <p class=\"tagrow\"><span class=\"tag\">IDE-integrated agent runtime</span><span class=\"tag\">VS Code</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">New VS Code Agent Host architecture for persistent, portable agent sessions inside the editor, with full MCP spec support and the ability to command GitHub's coding agent directly from VS Code.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">6.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49466704\" target=\"_blank\" rel=\"noopener noreferrer\">Opslane</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-27\">2026-08-27</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">AI debugging agent</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Agent that watches real user sessions, finds the bugs that matter, and fixes them — an autonomous debugging agent wired directly into production session data.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">7.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://github.com/apvcode/Termux-Dev\" target=\"_blank\" rel=\"noopener noreferrer\">Devx</a> <span class=\"host\">(github.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-26\">2026-08-26</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">code agent</span><span class=\"tag\">mobile/terminal</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Autonomous AI coding agent built to run on Android Termux and desktop, letting developers run a repo-aware coding agent directly from their phone.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">8.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://zuse.sh\" target=\"_blank\" rel=\"noopener noreferrer\">Zuse</a> <span class=\"host\">(zuse.sh)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-23\">2026-08-23</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">agent orchestration</span><span class=\"tag\">desktop app</span><span class=\"tag\">open source</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Open-source desktop workspace for running and managing coding agents (Claude Code, Codex, Cursor, Gemini, Grok, OpenCode, Kiro) across real Git repositories. Tasks run in isolated Git worktrees with persistent sessions, diff inspection and PR review before merging, using your existing agent subscriptions.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">9.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49450816\" target=\"_blank\" rel=\"noopener noreferrer\">Polign</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-26\">2026-08-26</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">agent memory infra</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Lightweight, stateless agent-memory database combining vector search and BM25 over the user's own S3/GCS storage, with typed facts, structured queries and cold-storage caching for long-lived agent memory across sessions.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">10.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49465138\" target=\"_blank\" rel=\"noopener noreferrer\">Knowl</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-27\">2026-08-27</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">coding-agent project memory</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Agent memory with write-time supersession: automatically prunes and supersedes stale project memory (built after the author's CLAUDE.md hit 1000 lines), scoring 0.90 on the MAB memory benchmark.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">11.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://github.com/seoes/proval\" target=\"_blank\" rel=\"noopener noreferrer\">Proval</a> <span class=\"host\">(github.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-27\">2026-08-27</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">self-hosted</span><span class=\"tag\">code review agent</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Self-hosted AI code review agent that reviews pull requests on GitLab, Forgejo and GitHub from your own infrastructure.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">12.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49460693\" target=\"_blank\" rel=\"noopener noreferrer\">Contextual</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-27\">2026-08-27</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">coding-agent project memory</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Local codebase memory for AI coding agents: indexes and remembers project context so agents recall it across sessions without sending code to the cloud.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">13.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://neoswarm.dev/\" target=\"_blank\" rel=\"noopener noreferrer\">Neoswarm</a> <span class=\"host\">(neoswarm.dev)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-26\">2026-08-26</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">IDE-integrated agent control</span><span class=\"tag\">Neovim</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Neovim-based environment for controlling AI coding agents from inside the editor: agent sessions, orchestration and review without leaving Neovim.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">14.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://thegit.ai\" target=\"_blank\" rel=\"noopener noreferrer\">TheGitAI</a> <span class=\"host\">(thegit.ai)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-25\">2026-08-25</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">AI coding CLI</span></p>\n          <p class=\"desc clamp c2\" title=\"Click to expand\">Model-agnostic coding agent for your terminal that works with any LLM provider.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">15.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://oynix.dev\" target=\"_blank\" rel=\"noopener noreferrer\">Oynix</a> <span class=\"host\">(oynix.dev)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-25\">2026-08-25</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">context/memory tooling</span></p>\n          <p class=\"desc clamp c2\" title=\"Click to expand\">Local tool that makes your coding agent aware of your whole codebase by indexing it on-device, no cloud needed.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">16.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://github.com/otsaloma/sloppie\" target=\"_blank\" rel=\"noopener noreferrer\">Sloppie</a> <span class=\"host\">(github.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-24\">2026-08-24</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">AI coding CLI</span><span class=\"tag\">agentic dev environment</span></p>\n          <p class=\"desc clamp c2\" title=\"Click to expand\">Agentic development environment for Linux: a terminal-based environment where AI agents write and run code.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">17.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://github.com/RudderCode/Rudder\" target=\"_blank\" rel=\"noopener noreferrer\">Rudder</a> <span class=\"host\">(github.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-26\">2026-08-26</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">AI testing</span><span class=\"tag\">TDD workflow</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Red-Green TDD workflow tool that drives coding agents to produce verifiably comprehensive specs: tests are written first and the agent must make them pass.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">18.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://github.com/CaydenChik/doover\" target=\"_blank\" rel=\"noopener noreferrer\">Do-over</a> <span class=\"host\">(github.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-20\">2026-08-20</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">agent debugging</span><span class=\"tag\">safety tool</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Undo for AI agent shell commands: lets developers roll back machine state after a bad command run by a coding agent, aimed at recovering from agent mistakes.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">19.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49352394\" target=\"_blank\" rel=\"noopener noreferrer\">ChatOSS</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-18\">2026-08-18</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">open-source coding agent</span></p>\n          <p class=\"desc clamp c2\" title=\"Click to expand\">Codex-style coding agent for fully open-source AI stacks, built on Ollama so it runs locally with open-weight models.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">20.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://www.npmjs.com/package/faberwright\" target=\"_blank\" rel=\"noopener noreferrer\">Faber</a> <span class=\"host\">(npmjs.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-22\">2026-08-22</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">code agent</span><span class=\"tag\">open source</span></p>\n          <p class=\"desc clamp c2\" title=\"Click to expand\">Cost-efficient open-source coding agent that builds and uses a code graph of the repo to plan edits and reduce token usage.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">21.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49464154\" target=\"_blank\" rel=\"noopener noreferrer\">Open Session</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-27\">2026-08-27</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">agent orchestration</span><span class=\"tag\">open source</span></p>\n          <p class=\"desc clamp c2\" title=\"Click to expand\">Open-source cloud agent-orchestrator for running and managing AI coding agent sessions in the cloud.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">22.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49353724\" target=\"_blank\" rel=\"noopener noreferrer\">Clinch</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-18\">2026-08-18</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">terminal for coding agents</span></p>\n          <p class=\"desc clamp c2\" title=\"Click to expand\">Local-first fork of the Warp terminal built specifically for managing multiple AI agent sessions in the terminal.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">23.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49363778\" target=\"_blank\" rel=\"noopener noreferrer\">Naeos</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-19\">2026-08-19</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">agent workflow system</span></p>\n          <p class=\"desc clamp c2\" title=\"Click to expand\">Engineering system for AI coding agents: structures specs, tasks and workflow around coding agents.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">24.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49364088\" target=\"_blank\" rel=\"noopener noreferrer\">CrewCode</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-19\">2026-08-19</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">agent orchestration</span><span class=\"tag\">open source</span></p>\n          <p class=\"desc clamp c2\" title=\"Click to expand\">Open-source mission control for AI coding agents: dashboard to launch, monitor and manage multiple coding-agent runs.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">25.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49356637\" target=\"_blank\" rel=\"noopener noreferrer\">CommitLore</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-19\">2026-08-19</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">coding-agent project memory</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Git memory tool that preserves the decisions and rationale coding agents keep forgetting, attaching them back to project history across sessions.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">26.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://github.com/kungfu-systems/kungfu\" target=\"_blank\" rel=\"noopener noreferrer\">Kungfu</a> <span class=\"host\">(github.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-16\">2026-08-16</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">agent memory</span><span class=\"tag\">handoff</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Keeps coding-agent work alive across sessions and handoffs: persists task state so agents (or teammates) can resume exactly where they left off.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">27.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://github.com/agent6-dev/agent6\" target=\"_blank\" rel=\"noopener noreferrer\">Agent6</a> <span class=\"host\">(github.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-16\">2026-08-16</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">code agent</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Coding agent with jailed (sandboxed) commands and editable state machines for controlled, auditable autonomous coding.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">28.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49307927\" target=\"_blank\" rel=\"noopener noreferrer\">NexusMem</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-15\">2026-08-15</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">coding-agent project memory</span></p>\n          <p class=\"desc clamp c2\" title=\"Click to expand\">Local memory layer for coding agents that captures project knowledge beyond Git history, persisting context across sessions.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">29.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49363138\" target=\"_blank\" rel=\"noopener noreferrer\">Flow</a> <span class=\"host\">(hn)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-19\">2026-08-19</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">AI coding CLI</span><span class=\"tag\">workflow</span></p>\n          <p class=\"desc clamp c2\" title=\"Click to expand\">CLI wrapper around Claude Code that enforces a structured feature workflow: planning, then review/testing, then merge.</p>\n        </div>\n      </li>\n\n      <li class=\"item product\">\n        <span class=\"rank\" aria-hidden=\"true\">30.</span>\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://github.com/mupt-ai/self-bench\" target=\"_blank\" rel=\"noopener noreferrer\">Self-bench</a> <span class=\"host\">(github.com)</span></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-14\">2026-08-14</time> · Show HN</p>\n          <p class=\"tagrow\"><span class=\"tag\">agent evals</span><span class=\"tag\">testing workflow</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Builds SWE-bench style evaluations from your own private repos so teams can score coding agents against their real codebase.</p>\n        </div>\n      </li>\n\n    </ol>\n  </section>\n\n  <!-- ==================== WHITELIST UPDATES ==================== -->\n  <section id=\"whitelist-updates\" class=\"col col-updates\" aria-labelledby=\"h-updates\">\n    <h2 id=\"h-updates\">Whitelist Updates <span class=\"count\">22</span></h2>\n    <p class=\"col-note\">Changelog watch: notable releases &amp; features from the major agentic coding platforms.</p>\n    <ol class=\"items\">\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Claude Code</span> <code class=\"ver\">v2.1.248</code> <span class=\"badge release\">release</span></p>\n          <h3 class=\"ttl\"><a href=\"https://github.com/anthropics/claude-code/releases/tag/v2.1.248\" target=\"_blank\" rel=\"noopener noreferrer\">--restricted sandbox mode, cross-session messaging on Bedrock/Vertex/Foundry, /usage-credits</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-27\">2026-08-27</time> · <a href=\"https://github.com/anthropics/claude-code/releases/tag/v2.1.248\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Adds a <code>--restricted</code> mode that removes command/code-execution tools and WebFetch, keeps file tools sandboxed to the working directory, and ignores local settings files; expands cross-session messaging (SendMessage/ListAgents) to Bedrock, Vertex, and Foundry; adds <code>/usage-credits</code> for Enterprise orgs to request higher limits; and adds experimental per-agent prompt-cache TTL (<code>cacheTtl</code>).</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Cursor</span> <span class=\"badge feature\">feature</span></p>\n          <h3 class=\"ttl\"><a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">Cloud Agents: Start from scratch without a repo, live preview, Vercel publishing</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-27\">2026-08-27</time> · <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">changelog ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Cloud Agents no longer need a connected GitHub or other SCM provider to start work — “Start from scratch” creates an Origin repo behind the scenes, with a Create repo button to save agent work. Live preview port-forwards the agent's environment to the browser, and agents can publish to a live URL via a connected Vercel account.</p>\n          <div class=\"quotes\">\n            <p class=\"quote sent-pos\">“[I] wish [they] keep the Cursor brand and vision of an E2E Developer platform from Origin to Cloud Agents intact.” <span class=\"qsrc\">— Reddit</span></p>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">GitHub Copilot</span> <span class=\"badge feature\">feature</span></p>\n          <h3 class=\"ttl\"><a href=\"https://github.blog/changelog/2026-08-27-copilot-code-review-resolution-reasons-and-expanded-capabilities\" target=\"_blank\" rel=\"noopener noreferrer\">Copilot code review: Resolution reasons and expanded capabilities</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-27\">2026-08-27</time> · <a href=\"https://github.blog/changelog/2026-08-27-copilot-code-review-resolution-reasons-and-expanded-capabilities\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Copilot code review now reports resolution reasons and gains expanded capabilities, helping developers understand why suggested changes were or weren't applied when Copilot reviews pull requests.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">GitHub Copilot</span> <span class=\"badge feature\">feature</span></p>\n          <h3 class=\"ttl\"><a href=\"https://github.blog/changelog/2026-08-26-global-model-policy-generally-available\" target=\"_blank\" rel=\"noopener noreferrer\">Global model policy generally available</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-26\">2026-08-26</time> · <a href=\"https://github.blog/changelog/2026-08-26-global-model-policy-generally-available\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">GitHub's global model policy for Copilot is now generally available, giving administrators a single policy to govern which AI models are available across their organization.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Devin</span> <span class=\"badge feature\">feature</span></p>\n          <h3 class=\"ttl\"><a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener noreferrer\">Automations and Slack upgrades: queued messages, multi-channel triggers, batch security remediation</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-26\">2026-08-26</time> · <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Adds queued message delivery during long waits, smarter @mention routing to subscribed sessions, automation triggers across multiple Slack channels, an “Improve with Devin” action for iterating on automations, Jira status_changed triggers, batch remediation of security findings via new v3 API routes, and an org setting allowing sessions to open PRs as validated collaborators.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Codex CLI</span> <code class=\"ver\">0.150.0</code> <span class=\"badge release\">release</span></p>\n          <h3 class=\"ttl\"><a href=\"https://github.com/openai/codex/releases/tag/rust-v0.150.0\" target=\"_blank\" rel=\"noopener noreferrer\">@-mention other Codex tasks, /copy picker, Interrupt hooks</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-26\">2026-08-26</time> · <a href=\"https://github.com/openai/codex/releases/tag/rust-v0.150.0\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Lets users reference other Codex tasks with @ mentions and ask agents to read, create, or message tasks from the terminal; <code>/copy</code> gains a picker for full responses, code blocks, and blockquotes; task titles are auto-generated with <code>/rename</code> suggestions; new Interrupt hooks were added. Security fixes ensure untrusted projects no longer inject project-level AGENTS.md instructions. Patch 0.150.1 (Aug 27) fixes remote compaction image token budgets.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">GitHub Copilot</span> <span class=\"badge release\">release</span></p>\n          <h3 class=\"ttl\"><a href=\"https://github.blog/changelog/2026-08-25-github-copilot-app-customize-tab-is-generally-available\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub Copilot app Customize tab is generally available</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-25\">2026-08-25</time> · <a href=\"https://github.blog/changelog/2026-08-25-github-copilot-app-customize-tab-is-generally-available\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">The Customize tab in the GitHub Copilot app reached general availability, letting users tailor Copilot's behavior, instructions, and tooling from a dedicated UI surface.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Codex CLI</span> <span class=\"badge feature\">feature</span></p>\n          <h3 class=\"ttl\"><a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">Event-triggered scheduled tasks for Codex (Gmail, Slack, GitHub events)</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-25\">2026-08-25</time> · <a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">changelog ↗</a></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Scheduled tasks can now run on Gmail, Slack, or GitHub events — e.g. filtered Gmail messages, watched Slack channels, or PR activity like reviews and merges — available on web and mobile for eligible plans, complementing time-based schedules.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Gemini CLI</span> <code class=\"ver\">v0.57.0</code> <span class=\"badge release\">release</span></p>\n          <h3 class=\"ttl\"><a href=\"https://github.com/google-gemini/gemini-cli/releases/tag/v0.57.0\" target=\"_blank\" rel=\"noopener noreferrer\">OAuth fixes for Cloud Workstations, capacity-aware retries, IDE connection fixes</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-25\">2026-08-25</time> · <a href=\"https://github.com/google-gemini/gemini-cli/releases/tag/v0.57.0\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Weekly stable release dynamically resolves Cloud Workstations proxy redirect URIs for OAuth flows, fixes swallowed directory mismatches in IDE connections, adds context-aware silent retries with availability TTL for capacity errors, rolls back entire multi-turn requests on cancellation, prevents indefinite TUI hangs via execution timeouts, and improves evals with tool-call formatting and failure summaries.</p>\n          <div class=\"quotes\">\n            <p class=\"quote sent-neg\">“lost my context. I had good context, this is what was the most important thing. Now it's trashed.” <span class=\"qsrc\">— Forum</span></p>\n            <p class=\"quote sent-neg\">“Since the latter product has been discontinued, I think I'm entitled to a refund.” <span class=\"qsrc\">— Forum</span></p>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Codex CLI</span> <span class=\"badge announcement\">announcement</span></p>\n          <h3 class=\"ttl\"><a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener noreferrer\"><code>codex mcp-server</code> deprecated in favor of Codex app server</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-24\">2026-08-24</time> · <a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">changelog ↗</a></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">OpenAI deprecated the <code>codex mcp-server</code> command in favor of the Codex app server, pointing Claude Code users to the Codex plugin for integration.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">GitHub Copilot</span> <span class=\"badge release\">release</span></p>\n          <h3 class=\"ttl\"><a href=\"https://github.blog/changelog/2026-08-21-the-new-github-copilot-experience-in-slack\" target=\"_blank\" rel=\"noopener noreferrer\">The new GitHub Copilot experience in Slack</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://github.blog/changelog/2026-08-21-the-new-github-copilot-experience-in-slack\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">A refreshed GitHub Copilot experience for Slack shipped as a release, letting users invoke Copilot and its agents directly from Slack conversations as part of GitHub's collaboration tools refresh.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">GitHub Copilot</span> <span class=\"badge release\">release</span></p>\n          <h3 class=\"ttl\"><a href=\"https://github.blog/changelog/2026-08-21-shared-agentic-work-with-github-copilot-in-microsoft-teams\" target=\"_blank\" rel=\"noopener noreferrer\">Shared agentic work with GitHub Copilot in Microsoft Teams</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://github.blog/changelog/2026-08-21-shared-agentic-work-with-github-copilot-in-microsoft-teams\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">GitHub Copilot brings shared agentic work to Microsoft Teams, enabling teams to collaborate with Copilot agents inside Teams channels — part of GitHub's push to embed agentic coding in workplace collaboration tools.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Windsurf / Devin Desktop</span> <code class=\"ver\">v3.8.20</code> <span class=\"badge release\">release</span></p>\n          <h3 class=\"ttl\"><a href=\"https://docs.devin.ai/desktop/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">Multi-window Agent Command Center, Devin Local plan mode</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://docs.devin.ai/desktop/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">changelog ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Windsurf (now Devin Desktop under Cognition) v3.8.20 ships Agent Command Center improvements (follows selected space, in-place conversion, side-by-side agent windows, optional separate window via <code>devin.agentWindow.location</code>), faster Agent/Editor mode switching (Ctrl/Cmd+G), untrusted-workspace trust prompts, and a Devin CLI shim. Devin Local adds multi-root workspaces, plan mode producing a Markdown plan file with an Implement button, individually stoppable subagents, and post_setup_worktree hooks. Devin Cloud improves session filtering and live shell output streaming.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Devin</span> <span class=\"badge feature\">feature</span></p>\n          <h3 class=\"ttl\"><a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener noreferrer\">Session experience redesign: nested sub-Devin trees, session subscribers, custom sidebar tabs</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-21\">2026-08-21</time> · <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Devin redesigned the session page with a compact header with built-in tags, a redesigned sessions sidebar with custom nav tabs/grouping/filtering, sub-Devin sessions displayed as a nested tree, session subscribers (follow and view others' sessions), bearer-token auth for automation webhooks, and expanded security-scan controls (change scan profiles, effort levels, incremental scan v3 endpoints).</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Codex CLI</span> <code class=\"ver\">0.149.0</code> <span class=\"badge release\">release</span></p>\n          <h3 class=\"ttl\"><a href=\"https://developers.openai.com/codex/changelog/\" target=\"_blank\" rel=\"noopener noreferrer\">Interactive <code>codex agents</code> dashboard, <code>codex queue</code>, /cd commands</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-20\">2026-08-20</time> · <a href=\"https://developers.openai.com/codex/changelog/\" target=\"_blank\" rel=\"noopener noreferrer\">changelog ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Adds an interactive <code>codex agents</code> dashboard for managing sessions, <code>/cd</code>, <code>/pwd</code> and <code>/cwd</code> commands, <code>codex queue</code> for messaging existing sessions, expanded Vim motions, broader <code>codex doctor</code> diagnostics, and SDK support for exact config overrides plus max/ultra reasoning effort. Fixes include queued-message wake-ups, permission-profile restoration on resume, and Windows Terminal scrollback history.</p>\n          <div class=\"quotes\">\n            <p class=\"quote sent-pos\">“Codex won five of the six open-ended design rounds... Codex used nine agents and finished in ~5 hours; Claude Code used 25.” <span class=\"qsrc\">— X</span></p>\n            <p class=\"quote sent-neu\">“Impressions two weeks after moving from Claude Code to [Codex]: Claude Code has a more mature plugin system and richer skills frontmatter.” <span class=\"qsrc\">— Reddit</span></p>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Cursor</span> <span class=\"badge feature\">feature</span></p>\n          <h3 class=\"ttl\"><a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">Cloud Agents and Cursor Harness improvements: subscriptions, isolated subagents, /goal</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-19\">2026-08-19</time> · <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">changelog ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Cursor's agent harness update adds Subscriptions (cloud agents monitor PRs, watch Slack threads, or run scheduled tasks and wake on events, auto-subscribing to PRs they create), custom modes pinnable in chat, subagents running on isolated VMs with clean project copies, <code>/goal</code> for long-lived objectives (e.g. fixing flaky tests until CI is green), and steering improvements where follow-ups wait for the next tool call.</p>\n          <div class=\"quotes\">\n            <p class=\"quote sent-neg\">“Cursor is evolving so quickly that it's becoming difficult to keep track of all the updates.” <span class=\"qsrc\">— Forum</span></p>\n            <p class=\"quote sent-pos\">“The update experience is being actively improved right now.” <span class=\"qsrc\">— Forum</span></p>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Devin</span> <span class=\"badge announcement\">announcement</span></p>\n          <h3 class=\"ttl\"><a href=\"https://devin.ai/blog\" target=\"_blank\" rel=\"noopener noreferrer\">GPT-5.6 Sol available at 70% discount on Devin Desktop and CLI</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-18\">2026-08-18</time> · <a href=\"https://devin.ai/blog\" target=\"_blank\" rel=\"noopener noreferrer\">announcement ↗</a></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Cognition announced that GPT-5.6 Sol is available at a 70% discount on Devin Desktop and Devin CLI through October 3, 2026, lowering the cost of running OpenAI's model on Devin's platform.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Claude Code</span> <span class=\"badge feature\">feature</span></p>\n          <h3 class=\"ttl\"><a href=\"https://code.claude.com/docs/en/whats-new/2026-w34\" target=\"_blank\" rel=\"noopener noreferrer\">/design research preview, Concise output style, and device cards (Week 34 updates)</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-17\">2026-08-17</time> · <a href=\"https://code.claude.com/docs/en/whats-new/2026-w34\" target=\"_blank\" rel=\"noopener noreferrer\">what's new ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Introduced a <code>/design</code> research preview bringing an artboard workflow to CLI and Desktop (Claude drafts editable artboards and builds the chosen one), a built-in Concise output style that leads with results, device cards via <code>claude remote-control</code> for starting sessions from a phone, and an <code>ANTHROPIC_DEFAULT_MODEL</code> env var for setting the default starting model. Shipped across v2.1.234–v2.1.239.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Cursor</span> <span class=\"badge feature\">feature</span></p>\n          <h3 class=\"ttl\"><a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">Origin Code Hosting: Cursor now hosts your code</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-17\">2026-08-17</time> · <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">changelog ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Cursor launched Origin code hosting in early beta on all paid plans: Origin Repos managed via a new Codebase tab, GitHub repo sync for browsing/searching (GitHub remains source of truth), PR views with timelines/checks/diffs and two-way comment sync, agents in every repo, and app extensions (Vercel preview deployments, Depot, Buildkite CI).</p>\n          <div class=\"quotes\">\n            <p class=\"quote sent-pos\">“Why not evaluate them on the merits? ... GitHub has so many outages, but dammit, that other one has a terrible name, it's practically unusable” <span class=\"qsrc\">— HN</span></p>\n            <p class=\"quote sent-neg\">“How about an original and distinguishable name? ... A word that is already used in computer is a bad name.” <span class=\"qsrc\">— HN</span></p>\n            <p class=\"quote sent-neg\">“Cursor is launching a GitHub competitor. Is this a land grab?” <span class=\"qsrc\">— Reddit</span></p>\n            <p class=\"quote sent-pos\">“You can now host your repos in Cursor Origin and deploy to Vercel via Cursor Origin, which is itself hosted on Vercel” <span class=\"qsrc\">— X</span></p>\n            <p class=\"quote sent-neg\">“Cursor Origin Has 7 Traps, And One of Them Is Permanent” <span class=\"qsrc\">— Blog comments</span></p>\n            <p class=\"quote sent-neg\">“Cursor Origin + Buildkite problem: repos synced to Origin don't appear in Buildkite — mirrors reportedly block CI apps” <span class=\"qsrc\">— Forum</span></p>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">GitHub Copilot</span> <span class=\"badge release\">release</span></p>\n          <h3 class=\"ttl\"><a href=\"https://github.blog/changelog/2026-08-14-grok-4-6-is-now-available-in-github-copilot\" target=\"_blank\" rel=\"noopener noreferrer\">Grok 4.6 is now available in GitHub Copilot</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-14\">2026-08-14</time> · <a href=\"https://github.blog/changelog/2026-08-14-grok-4-6-is-now-available-in-github-copilot\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">xAI's Grok 4.6 model is now selectable in GitHub Copilot's model picker, continuing GitHub's multi-model strategy alongside Claude, GPT, and Gemini options.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Devin</span> <span class=\"badge feature\">feature</span></p>\n          <h3 class=\"ttl\"><a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener noreferrer\">Devin Coach and August 14 release: prompt suggestions, Devin Review skip logic, Devin Local default for enterprise</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-14\">2026-08-14</time> · <a href=\"https://docs.devin.ai/release-notes/2026\" target=\"_blank\" rel=\"noopener noreferrer\">release notes ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Devin shipped Devin Coach (suggestions in the input box to improve prompts before sending), Devin Review skipping re-review of PRs with unchanged diffs, session auto-subscription to Slack threads, teams chat polish, and Devin Local enabled by default for enterprise customers.</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <p class=\"updhead\"><span class=\"prod\">Claude Code</span> <span class=\"badge feature\">feature</span></p>\n          <h3 class=\"ttl\"><a href=\"https://code.claude.com/docs/en/whats-new/2026-w32\" target=\"_blank\" rel=\"noopener noreferrer\">Auto mode becomes the default permission mode for new sessions (effective Aug 14)</a></h3>\n          <p class=\"meta\"><time datetime=\"2026-08-14\">2026-08-14</time> · <a href=\"https://code.claude.com/docs/en/whats-new/2026-w32\" target=\"_blank\" rel=\"noopener noreferrer\">what's new ↗</a></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">As of August 14, 2026, auto mode is the default permission mode for new Claude Code sessions on Pro, Max, and Team plans, with transcript protections that block dangerous operations while reducing permission prompts. Announced in the Week 32 notes; community discussion was extensive.</p>\n          <div class=\"quotes\">\n            <p class=\"quote sent-neu\">“Anthropic Flips Claude Code to Auto Mode by Default Aug 14, after finding AI blocks 80%+ dangerous queries while humans only 14%” <span class=\"qsrc\">— Reddit</span></p>\n            <p class=\"quote sent-neg\">“there's plenty of ‘optimization’ around rubberbanding usage limits as well as routing to a different model in the backend. The incentives are too strong.” <span class=\"qsrc\">— HN</span></p>\n            <p class=\"quote sent-neu\">“Effort level is actually controlled entirely by system prompt... so actually this is a valid way to check I think” <span class=\"qsrc\">— HN</span></p>\n          </div>\n        </div>\n      </li>\n\n    </ol>\n  </section>\n\n  <!-- ==================== TECHNICAL INSIGHTS ==================== -->\n  <section id=\"technical-insights\" class=\"col col-insights\" aria-labelledby=\"h-insights\">\n    <h2 id=\"h-insights\">Technical Insights <span class=\"count\">33</span></h2>\n    <p class=\"col-note\">Papers, posts, podcasts &amp; discussions shaping the week — 2026-08-21 → 2026-08-27.</p>\n    <ol class=\"items\">\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://simonwillison.net/2026/Aug/27/breaking-claude-code-opus-5-auto-mode/\" target=\"_blank\" rel=\"noopener noreferrer\">Breaking Claude Code Opus 5 Auto Mode — prompt injection at ~80% success</a></h3>\n          <p class=\"meta\">Johann Rehberger (via Simon Willison) · Blog · <time datetime=\"2026-08-27\">2026-08-27</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">A crafted zip archive causes importing base64 to execute a malicious local struct.py, with ~80% success rate. Willison notes “Auto Mode blocks its cleanup command” and argues unattended coding agents should be run in sandboxed environments with restricted network egress.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Autonomous coding agents remain highly exposed to prompt injection via their own tool use.</p>\n          <p class=\"tags\">#ai-coding #prompt-injection #claude-code</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://www.youtube.com/watch?v=UuqSy1jPSUw\" target=\"_blank\" rel=\"noopener noreferrer\">Fireship revisits Knight Capital — the most expensive software bug in history</a></h3>\n          <p class=\"meta\">Jeff Delaney (Fireship) · YouTube · <time datetime=\"2026-08-27\">2026-08-27</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Fireship's “code report” style video recounts the 2012 Knight Capital collapse: ~$440M lost in 45 minutes after a reused feature flag reactivated dead test code on 1 of 8 servers during a botched deployment.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> As AI agents accelerate code changes and deployments, classic deployment hygiene (feature flags, dead-code removal, rollout consistency) becomes more important, not less.</p>\n          <p class=\"tags\">#software-engineering #deployment #feature-flags</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://softwareengineeringdaily.com/podcasts/typescript-7-and-what-comes-next/\" target=\"_blank\" rel=\"noopener noreferrer\">Software Engineering Daily: TypeScript 7 and what comes next</a></h3>\n          <p class=\"meta\">Daniel Rosenwasser with Josh Goldberg · Podcast · <time datetime=\"2026-08-27\">2026-08-27</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Daniel Rosenwasser (Principal PM for TypeScript at Microsoft) joins host Josh Goldberg to discuss TypeScript 7 — described as one of the biggest changes in the language's history.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> The compiler rewrite moment (native-speed tsc) is the kind of high-stakes migration where AI coding agents are increasingly used for mechanical refactors, while design decisions stay human.</p>\n          <p class=\"tags\">#typescript #compilers #refactoring</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://towardsdatascience.com/stop-giving-your-ai-agent-a-search-box-and-start-giving-it-typed-tools-hard-bounds-and-a-gate-it-cannot-talk-past/\" target=\"_blank\" rel=\"noopener noreferrer\">Stop giving your AI agent a search box — typed tools, hard bounds, and a gate</a></h3>\n          <p class=\"meta\">Miodrag Cekikj (Towards Data Science) · Platform · <time datetime=\"2026-08-27\">2026-08-27</time><span class=\"badge opinion\">opinion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Argues agents should get typed tools with hard bounds and a gate they cannot talk past, instead of open-ended search/control surfaces.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Agent reliability comes from interface design — constrained, typed, auditable tool contracts beat giving the model a generic “search box” and hoping prompting holds the line; complements this week's prompt-injection findings.</p>\n          <p class=\"tags\">#agent-design #tool-interfaces #guardrails</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://simonwillison.net/2026/Aug/26/qwen38-flash-next/\" target=\"_blank\" rel=\"noopener noreferrer\">Qwen3.8-Flash-Next: open-weights MoE previewing Qwen4's architecture</a></h3>\n          <p class=\"meta\">Simon Willison · Blog · <time datetime=\"2026-08-26\">2026-08-26</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Willison covers Qwen's new open-weights multimodal MoE model (125B total, ~6B active) that previews the Qwen4 architecture. He ran Unsloth quantizations on a DGX Spark and tested it by generating pelican SVGs.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> The open-weights frontier keeps closing the gap with proprietary models, and small-activation MoE models are increasingly runnable on developer desks.</p>\n          <p class=\"tags\">#open-weights #llm #moe</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://simonwillison.net/2026/Aug/26/paul-dix/\" target=\"_blank\" rel=\"noopener noreferrer\">Paul Dix: “The end of programming” — 1M lines of AI-maintained software</a></h3>\n          <p class=\"meta\">Paul Dix (via Simon Willison) · Blog · <time datetime=\"2026-08-26\">2026-08-26</time><span class=\"badge opinion\">opinion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Paul Dix marvels that AI can now produce and iteratively refine roughly a million lines of reliable software when given a verification system and proper direction.</p>\n          <p class=\"takeaway clamp c2\" title=\"Click to expand\"><b>Takeaway</b> Verification infrastructure — not code writing — is the scarce input for large-scale AI-generated codebases.</p>\n          <p class=\"tags\">#ai-coding #verification #agents</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://lexfridman.com/dhh-2/\" target=\"_blank\" rel=\"noopener noreferrer\">Lex Fridman #501: DHH declares “the end of manual programming” and embraces agentic engineering</a></h3>\n          <p class=\"meta\">Lex Fridman with DHH · Podcast · <time datetime=\"2026-08-26\">2026-08-26</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">In a 5+ hour conversation, DHH (creator of Ruby on Rails, CTO of 37signals) — who in his 2025 appearance typed all his code without AI — now argues agents have turned programming into “agentic engineering.” Segments contrast “vibe coding vs agentic engineering,” cover the best AI coding models and harnesses, agent-optimized programming setups, AI's impact on open source, and advice for programmers. He also claims “Linux will win the desktop” via his Omarchy distro.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> One of the most famous AI-coding skeptics converted to disciplined agent-first workflows — a bellwether for mainstream developer adoption.</p>\n          <p class=\"tags\">#agentic-engineering #vibe-coding #future-of-programming</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://www.youtube.com/watch?v=L9mMfAFwbl4\" target=\"_blank\" rel=\"noopener noreferrer\">Two Minute Papers: DeepSeek's new open agent system “shouldn't be possible”</a></h3>\n          <p class=\"meta\">Károly Zsolnai-Fehér (Two Minute Papers) · YouTube · <time datetime=\"2026-08-26\">2026-08-26</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Covers DeepSeek Harness, DeepSeek's new open agent system, arguing its capabilities outpace what open-weight systems were expected to deliver.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Open-weight labs are now shipping frontier-grade agent harnesses, intensifying pressure on closed labs and expanding options for self-hosted coding agents.</p>\n          <p class=\"tags\">#deepseek #open-weights #harness</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://arxiv.org/abs/2608.26218\" target=\"_blank\" rel=\"noopener noreferrer\">Same Model, Different Harness: harness changes alone swing SWE-bench results</a></h3>\n          <p class=\"meta\">Sydney Lewis · arXiv 2608.26218 · Paper · <time datetime=\"2026-08-26\">2026-08-26</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">For a fixed model, harness modifications alone change coding-agent outcomes dramatically: a context-shortening treatment lifted mean per-task fail-to-pass fraction from 28% to 49% on a 169-task SWE-bench Verified cohort. Argues evaluations must treat model-plus-harness as the tested solver.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Empirical confirmation of the week's loudest theme — “most agent systems die not from a weak model but from a weak harness.”</p>\n          <p class=\"tags\">#coding-agents #harness #swe-bench</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://arxiv.org/abs/2608.25776\" target=\"_blank\" rel=\"noopener noreferrer\">Self-poisoning in self-evolving coding agents: malicious skills spread like a worm</a></h3>\n          <p class=\"meta\">Xiaodong Wu, Yu Shi, Qi Li, et al. · arXiv 2608.25776 · Paper · <time datetime=\"2026-08-26\">2026-08-26</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Identifies “self-poisoning”: self-evolving agents imitate malicious skills from shared libraries and author copies that propagate like a worm. Poisoning rates span 20.3–41.8% across six models on SWE-bench Verified tasks; a proposed “counter-prompt” defense cuts the attack rate to at most 6.7%.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> As agents share skills/libraries, supply-chain-style threats become an agentic-native risk class.</p>\n          <p class=\"tags\">#coding-agents #security #skill-libraries</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://arxiv.org/abs/2608.25399\" target=\"_blank\" rel=\"noopener noreferrer\">Can your AI agent be cheaper? Under-specified tasks burn 29.7% more tokens</a></h3>\n          <p class=\"meta\">Jakub Smékal · arXiv 2608.25399 · Paper · <time datetime=\"2026-08-26\">2026-08-26</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Across 2,700 runs with Kimi K3, shrinking a full specification to a bare user story increased token spend by 29.7%, with prompt sensitivity ranging 13–115% by task; a lightweight predictor prices task configurations within 36% using a single cheap probe.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Specification quality is a direct cost lever in agentic coding — vague prompts are a hidden tax, quantified.</p>\n          <p class=\"tags\">#token-economics #task-specification #cost-optimization</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://arxiv.org/abs/2608.25241\" target=\"_blank\" rel=\"noopener noreferrer\">A Few Pages of Markdown: committed AI config predicts codebase health after agent adoption</a></h3>\n          <p class=\"meta\">Yegor Denisov-Blanch, Shyam Agarwal, et al. · Stanford · arXiv 2608.25241 · <time datetime=\"2026-08-26\">2026-08-26</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Proposes RAMP, a four-level maturity model based on version-controlled AI configuration (e.g., CLAUDE.md-style files). Across 441 repositories, agents speed development (28–38% more commits) at all maturity levels, but agent-first repos lacking committed configuration saw roughly double the growth in cognitive complexity (+53% vs +27%).</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Committing agent guidance/config to version control is emerging as a measurable quality practice.</p>\n          <p class=\"tags\">#ai-configuration #claude-md #code-quality</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://towardsdatascience.com/how-to-effectively-solve-100-tasks-with-claude-code/\" target=\"_blank\" rel=\"noopener noreferrer\">How to effectively solve 100+ tasks a day with Claude Code sub-agents</a></h3>\n          <p class=\"meta\">Eivind Kjosbakken (Towards Data Science) · Platform · <time datetime=\"2026-08-26\">2026-08-26</time><span class=\"badge tutorial\">tutorial</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">A practical pipeline for handling 50–100 small coding tasks daily: explicitly instruct Claude Code to spin up sub-agents so each task is completed individually, from issue triage through execution.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Practitioner workflows are standardizing around orchestrator-plus-subagent patterns for parallelizable task queues.</p>\n          <p class=\"tags\">#claude-code #sub-agents #orchestration</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://changelog.com/podcast/684\" target=\"_blank\" rel=\"noopener noreferrer\">Changelog #684: Postgres at PlanetScale — agents shipping schema changes</a></h3>\n          <p class=\"meta\">Sam Lambert with Adam Stacoviak · Podcast · <time datetime=\"2026-08-25\">2026-08-25</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Sam Lambert discusses PlanetScale's $5 Postgres, the Neki Vitess “do-over,” and notably “agents shipping schema changes through deploy requests” — plus rolling back a 500TB table quickly.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Database platforms are adapting their guardrails (deploy requests, rollbacks) for a world where AI agents, not just humans, propose schema migrations.</p>\n          <p class=\"tags\">#postgres #database-tooling #schema-migrations</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://softwareengineeringdaily.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Software Engineering Daily: the gap between AI spending and AI value</a></h3>\n          <p class=\"meta\">Kevin Ball · Podcast · <time datetime=\"2026-08-25\">2026-08-25</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Host Kevin Ball examines the disconnect between massive enterprise AI investment and realized value.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> In coding specifically, the value gap shows up as agent subscriptions that don't translate into shipped software without workflow redesign, verification infrastructure, and organizational change.</p>\n          <p class=\"tags\">#ai-economics #roi #enterprise-ai</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://stackoverflow.blog/2026/08/25/inside-linkedin-s-cognitive-memory-agent/\" target=\"_blank\" rel=\"noopener noreferrer\">Inside LinkedIn's cognitive memory agent</a></h3>\n          <p class=\"meta\">Praveen Bodigutla · Stack Overflow Podcast · <time datetime=\"2026-08-25\">2026-08-25</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">LinkedIn Principal AI Researcher Praveen Bodigutla details a four-layer memory system giving LinkedIn's hiring assistant persistent, personalized state.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Production agent systems are converging on layered memory architectures — a pattern directly transferable to coding agents that must recall project conventions, past failures, and user intent across sessions.</p>\n          <p class=\"tags\">#ai-agents #memory-systems #production-ai</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49428303\" target=\"_blank\" rel=\"noopener noreferrer\">80% of developers find AI coding “more addictive than helpful”</a></h3>\n          <p class=\"meta\">ZDNet (via Hacker News) · HN · <time datetime=\"2026-08-25\">2026-08-25</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Survey data shows most developers find AI coding more addictive than helpful — dopamine-loop usage patterns outpacing measured productivity gains.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Adoption metrics conflate engagement with value; the “feels faster” effect keeps complicating AI coding ROI measurement, echoing the week's spending-vs-value debate.</p>\n          <p class=\"tags\">#developer-survey #ai-coding #productivity</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49429028\" target=\"_blank\" rel=\"noopener noreferrer\">“Code maintainability plummets in the AI coding era”</a></h3>\n          <p class=\"meta\">LeadDev (via Hacker News) · HN · <time datetime=\"2026-08-25\">2026-08-25</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">LeadDev argues AI-generated code is degrading maintainability: more commits, more complexity, thinner review.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Velocity gains from agents are being paid for in long-term maintainability debt — converging with the arXiv finding that agent-first repos without committed AI config saw double the cognitive-complexity growth.</p>\n          <p class=\"tags\">#maintainability #code-quality #tech-debt</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://techcrunch.com/2026/08/24/amjad-masad-ceo-and-co-founder-of-replit-joins-the-disrupt-stage-at-techcrunch-disrupt-2026/\" target=\"_blank\" rel=\"noopener noreferrer\">Amjad Masad to take TechCrunch Disrupt 2026 stage on “the future of programming”</a></h3>\n          <p class=\"meta\">TechCrunch (re: Amjad Masad) · TechMedia · <time datetime=\"2026-08-24\">2026-08-24</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Replit's co-founder/CEO joins the Disrupt Stage (October 13–15, San Francisco) off the company's agent pivot: Masad argues engineers are moving away from keyboard-centric work toward review, direction, and design while agents write most code — and predicts a “SaaS apocalypse” as users build their own software.</p>\n          <p class=\"tags\">#replit #future-of-programming #conference</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://www.youtube.com/watch?v=wMl6c_r0ubw\" target=\"_blank\" rel=\"noopener noreferrer\">Two Minute Papers: Qwen3.8-27B — “this small AI will change everything”</a></h3>\n          <p class=\"meta\">Károly Zsolnai-Fehér · YouTube · <time datetime=\"2026-08-24\">2026-08-24</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Highlights Qwen3.8-27B, a 27B open model small enough to run on consumer hardware that punches far above its weight on coding and reasoning benchmarks.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Capable small open models running locally are becoming “more capable, more accessible, and increasingly difficult to ignore” — reshaping who can build with frontier-adjacent AI.</p>\n          <p class=\"tags\">#qwen #small-language-models #local-inference</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://techcrunch.com/2026/08/24/openai-is-building-an-ai-agent-for-everything-will-everyone-use-them/\" target=\"_blank\" rel=\"noopener noreferrer\">OpenAI is building AI agents for everything — but will everyone use them?</a></h3>\n          <p class=\"meta\">Tim Fernholz (TechCrunch) · TechMedia · <time datetime=\"2026-08-24\">2026-08-24</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Inside OpenAI's push to bring agents from software engineers to the masses (white-collar workers in accounting, HR, etc.). Key stat: an OpenAI-backed study found 98% of OpenAI employees used Codex in June, but only 17% of organizational subscribers and under 1% of others did.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Coding agents are the proven beachhead; general-purpose agent adoption outside engineering faces a steep usage cliff.</p>\n          <p class=\"tags\">#openai #codex #adoption</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://arxiv.org/abs/2608.23564\" target=\"_blank\" rel=\"noopener noreferrer\">SWE Refactor Bench: coding agents fail long-horizon whole-repo migrations (5.4% pass)</a></h3>\n          <p class=\"meta\">Deyao Hong, Yizhe Chi, et al. · arXiv 2608.23564 · Paper · <time datetime=\"2026-08-24\">2026-08-24</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">A benchmark of 20 whole-repository stack migrations with three evaluation stages (migration audit, behavioral tests, agentic verification). Only 5.4% of 520 runs passed all stages; best model scored 47.0/100. Agents did far better on build toolchain rewrites (31.4) than language rewrites (5.6).</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Long-horizon, whole-repo transformation remains the frontier failure mode for coding agents — automation excels at local edits, not sustained architectural change.</p>\n          <p class=\"tags\">#coding-agents #benchmark #refactoring</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://huggingface.co/papers/trending\" target=\"_blank\" rel=\"noopener noreferrer\">Trending papers converge on agent harness engineering: Prime Agent, AutoSaddler, Graph Engineering</a></h3>\n          <p class=\"meta\">Prime Intellect, Microsoft, et al. · HF Papers trending · <time datetime=\"2026-08-24\">2026-08-24</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">This week's trending research spotlights the harness/system layer: Prime Agent (Prime Intellect) is a self-improving RLM harness with recursive subagents and agent-to-agent coordination (18.8k GitHub stars); Microsoft's AutoSaddler optimizes agent harnesses offline from execution traces with durable updates; and “Graph Engineering in the Era of LLM Agents” organizes multi-agent systems as dynamic graphs.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> The field's center of gravity is shifting from model upgrades to engineering the scaffolding around models — matching the week's “harness” and “graph engineering” discourse.</p>\n          <p class=\"tags\">#agent-harness #multi-agent-systems #graph-engineering</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://news.ycombinator.com/item?id=49421554\" target=\"_blank\" rel=\"noopener noreferrer\">“Coding expertise is going to collapse from AI reliance”</a></h3>\n          <p class=\"meta\">Lars Faye · HN · ▲ 558 · 544 comments · <time datetime=\"2026-08-24\">2026-08-24</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">The week's dominant Hacker News debate: as agents write most code, developers lose the deliberate practice that builds expertise — producing a generation fluent in directing agents but unable to debug, design, or verify without them. The 544-comment thread splits between “this is how calculators felt” optimism and warnings that programming's verification skills cannot be learned vicariously.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> The expertise-pipeline problem (what happens to juniors?) is now the community's central anxiety.</p>\n          <p class=\"tags\">#ai-coding #expertise-collapse #junior-developers</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://simonwillison.net/2026/Aug/23/anthropics-best-ai-model-struggles-to-attract-users-as-cheaper-t/\" target=\"_blank\" rel=\"noopener noreferrer\">Anthropic's best model struggles to attract users as cheaper tools thrive</a></h3>\n          <p class=\"meta\">Simon Willison (linking FT) · Blog · <time datetime=\"2026-08-23\">2026-08-23</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Anthropic's July annualized revenue hit $65bn and OpenAI's exceeded $40bn, but Ramp's AI index shows pricey “Fable 5” at only 8.0% of Anthropic model spend versus Opus 4.8's 28.0%.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Buyers are actively rationing premium model usage in favor of cheaper tiers — pricing pressure is reshaping model choice for coding workloads.</p>\n          <p class=\"tags\">#anthropic #model-economics #ai-coding</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://simonwillison.net/2026/Aug/23/drew-breunig/\" target=\"_blank\" rel=\"noopener noreferrer\">Drew Breunig: “Fable &amp; The End of the Free Lunch” — rationing work across models</a></h3>\n          <p class=\"meta\">Drew Breunig (via Simon Willison) · Blog · <time datetime=\"2026-08-23\">2026-08-23</time><span class=\"badge opinion\">opinion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Breunig argues the high cost of top-tier models ended the era when teams let new models “paper over” inefficiencies: “So we started to think about what work went where.”</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Sophisticated multi-model routing — matching task difficulty to model cost — is becoming a core engineering discipline for AI coding teams.</p>\n          <p class=\"tags\">#model-routing #cost-optimization #llm-economics</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://towardsdatascience.com/bug-detection-blind-spots-in-ai-coding-harnesses-gstack-and-beyond/\" target=\"_blank\" rel=\"noopener noreferrer\">Bug detection blind spots in AI coding harnesses — 28 debugging experiments</a></h3>\n          <p class=\"meta\">Nhu Hoang (Towards Data Science) · Platform · <time datetime=\"2026-08-23\">2026-08-23</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Based on 28 debugging experiments, maps systematic blind spots in how AI coding harnesses detect bugs — harnesses struggle less with raw complexity than with specific failure geometries.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Debugging is where harness design choices (context assembly, tool access, observation format) most visibly break; treat bug detection as a harness problem, not a model problem.</p>\n          <p class=\"tags\">#debugging #ai-coding-harnesses #bug-detection</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://simonwillison.net/2026/Aug/22/linus-torvalds/\" target=\"_blank\" rel=\"noopener noreferrer\">Linus Torvalds credits AI as his “tireless helper” in grueling kernel debug</a></h3>\n          <p class=\"meta\">Linus Torvalds (via Simon Willison) · Blog · <time datetime=\"2026-08-22\">2026-08-22</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">In a Linux drm/xe commit, Torvalds describes an AI assistant that repeatedly declared the debugging problem impossible but faithfully added and analyzed debug code when pushed, ultimately helping crack a grueling issue.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Even famously skeptical systems programmers are incorporating LLMs as persistent debugging partners, while still overriding their pessimistic judgments.</p>\n          <p class=\"tags\">#linux-kernel #ai-debugging #linus-torvalds</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://simonwillison.net/2026/Aug/22/more-than-just-code-review/\" target=\"_blank\" rel=\"noopener noreferrer\">Simon Willison: coding agents require “more than just code review”</a></h3>\n          <p class=\"meta\">Simon Willison · Blog · <time datetime=\"2026-08-22\">2026-08-22</time><span class=\"badge opinion\">opinion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">The core skill for working with coding agents is confidently instructing changes and then verifying them — by means beyond eyeballing every line of generated code.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Verification techniques (tests, logs, behavioral checks) must scale up because line-by-line review doesn't scale to agent-written codebases.</p>\n          <p class=\"tags\">#coding-agents #verification #code-review</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://simonwillison.net/2026/Aug/22/llm/\" target=\"_blank\" rel=\"noopener noreferrer\">llm 0.33 released: OpenAI library 3.x, httpx2, reasoning summaries</a></h3>\n          <p class=\"meta\">Simon Willison · Blog · <time datetime=\"2026-08-22\">2026-08-22</time><span class=\"badge tech\">technical</span></p>\n          <p class=\"desc clamp c4\" title=\"Click to expand\">Willison ships llm 0.33 switching to OpenAI library 3.x with the httpx→httpx2 migration, per-call <code>--key</code> for embeddings, repeatable <code>-t</code>/<code>--template</code> combination, and a reasoning_summary option for Responses API models — days after an emergency 0.32.1 pin when OpenAI dropped httpx support.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> Rapid upstream SDK churn keeps breaking local AI tooling, and plugin ecosystems must absorb migrations fast.</p>\n          <p class=\"tags\">#llm-tooling #open-source #release-engineering</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://simonwillison.net/2026/Aug/21/stop-making-tuis/\" target=\"_blank\" rel=\"noopener noreferrer\">Thomas Ptacek: “Stop Making TUIs” — agents make native GUIs nearly free</a></h3>\n          <p class=\"meta\">Thomas Ptacek (via Simon Willison) · Blog · <time datetime=\"2026-08-21\">2026-08-21</time><span class=\"badge opinion\">opinion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">AI coding agents have made building native GUIs so cheap that even small personal tools deserve real interfaces: “Go build a native UI.”</p>\n          <p class=\"takeaway clamp c2\" title=\"Click to expand\"><b>Takeaway</b> Agents invert a longstanding cost assumption in tool-building — interface polish is no longer the expensive part.</p>\n          <p class=\"tags\">#ai-coding #gui-tooling #developer-tools</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://simonwillison.net/2026/Aug/21/matt-webb/\" target=\"_blank\" rel=\"noopener noreferrer\">Matt Webb: outsourcing thinking to AI pushed him to learn more, not less</a></h3>\n          <p class=\"meta\">Matt Webb (via Simon Willison) · Blog · <time datetime=\"2026-08-21\">2026-08-21</time><span class=\"badge opinion\">opinion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Webb describes using ChatGPT as a patient tutor to finally learn quaternions while adding an augmented-reality mode to Galactic Compass, concluding that AI-assisted learning increased rather than decreased his understanding.</p>\n          <p class=\"takeaway clamp c2\" title=\"Click to expand\"><b>Takeaway</b> AI as tutor can complement rather than erode human learning — a counterpoint to cognitive-atrophy worries.</p>\n          <p class=\"tags\">#ai-assisted-learning #cognition #chatgpt</p>\n        </div>\n      </li>\n\n      <li class=\"item\">\n        <div class=\"itembody\">\n          <h3 class=\"ttl\"><a href=\"https://stackoverflow.blog/podcast/\" target=\"_blank\" rel=\"noopener noreferrer\">Stack Overflow Podcast: “get rid of your CAPTCHA” — a web built for bots</a></h3>\n          <p class=\"meta\">Brian Alvey (CTO, WordPress VIP) · Podcast · <time datetime=\"2026-08-21\">2026-08-21</time><span class=\"badge discussion\">discussion</span></p>\n          <p class=\"desc clamp c3\" title=\"Click to expand\">Brian Alvey argues AI agents are becoming the web's primary users and sites should stop blocking them: CAPTCHAs should go, and structured content will persist because agents consume it.</p>\n          <p class=\"takeaway clamp c3\" title=\"Click to expand\"><b>Takeaway</b> As coding/browsing agents proliferate, the web's economics and access norms (paywalls, bot policies, llms.txt-style discovery) are being renegotiated.</p>\n          <p class=\"tags\">#ai-agents #web-economics #bots</p>\n        </div>\n      </li>\n\n    </ol>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap foot-in\">\n    <span><strong>Agentic Coding Daily</strong> · compiled 2026-08-28 · 85 items from Hacker News, GitHub, arXiv, vendor changelogs &amp; podcasts</span>\n    <nav class=\"foot-nav\" aria-label=\"Footer navigation\">\n      <a href=\"#new-products\">New Products</a><span class=\"sep\">|</span>\n      <a href=\"#whitelist-updates\">Updates</a><span class=\"sep\">|</span>\n      <a href=\"#technical-insights\">Insights</a><span class=\"sep\">|</span>\n      <a href=\"#top\">Top ↑</a>\n    </nav>\n    <span>Descriptions condensed from public sources — click through for full details.</span>\n  </div>\n</footer>\n\n<script>\n(function(){\n  // Click any truncated (clamped) text to expand/collapse it.\n  document.addEventListener('click', function(e){\n    if (e.target.closest('a') || e.target.closest('button')) return;\n    var p = e.target.closest('.clamp');\n    if (p) p.classList.toggle('open');\n  });\n  // Expand / collapse all control.\n  var eb = document.getElementById('expand-all');\n  if (eb) {\n    eb.addEventListener('click', function(){\n      var expand = document.body.classList.toggle('all-expanded');\n      document.querySelectorAll('.clamp').forEach(function(c){\n        c.classList.toggle('open', expand);\n      });\n      eb.textContent = expand ? 'collapse all' : 'expand all';\n    });\n  }\n})();\n</script>\n</body>\n</html>\n"
