      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Agentic Coding Research Report - 2026-06-29</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: Verdana, Geneva, sans-serif;\n            font-size: 10pt;\n            background-color: #f6f6ef;\n            color: #000000;\n            line-height: 1.4;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 10px;\n        }\n\n        header {\n            background-color: #ff6600;\n            padding: 5px 10px;\n            margin-bottom: 15px;\n        }\n\n        header h1 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 14pt;\n            font-weight: bold;\n            color: #000000;\n        }\n\n        header .date {\n            font-size: 9pt;\n            color: #000000;\n            margin-top: 3px;\n        }\n\n        .three-column-layout {\n            display: grid;\n            grid-template-columns: 40% 35% 25%;\n            gap: 15px;\n            margin-bottom: 20px;\n        }\n\n        @media (max-width: 1024px) {\n            .three-column-layout {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        .column {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            padding: 10px;\n        }\n\n        .column h2 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 12pt;\n            font-weight: bold;\n            color: #000000;\n            border-bottom: 2px solid #ff6600;\n            padding-bottom: 5px;\n            margin-bottom: 10px;\n        }\n\n        .item {\n            margin-bottom: 15px;\n            padding-bottom: 15px;\n            border-bottom: 1px dotted #d4d4d4;\n        }\n\n        .item:last-child {\n            border-bottom: none;\n            margin-bottom: 0;\n            padding-bottom: 0;\n        }\n\n        .item-title {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 10pt;\n            font-weight: bold;\n            margin-bottom: 5px;\n        }\n\n        .item-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .item-title a:visited {\n            color: #828282;\n        }\n\n        .item-title a:hover {\n            text-decoration: underline;\n        }\n\n        .item-description {\n            font-size: 9pt;\n            color: #000000;\n            margin-bottom: 5px;\n            line-height: 1.4;\n        }\n\n        .item-meta {\n            font-size: 8pt;\n            color: #828282;\n        }\n\n        .item-meta a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        .item-meta a:hover {\n            text-decoration: underline;\n        }\n\n        .tag {\n            display: inline-block;\n            background-color: #f6f6ef;\n            padding: 2px 5px;\n            margin: 2px;\n            font-size: 8pt;\n            color: #828282;\n            border: 1px solid #d4d4d4;\n        }\n\n        .update-type {\n            display: inline-block;\n            padding: 2px 5px;\n            margin: 2px;\n            font-size: 8pt;\n            font-weight: bold;\n            border-radius: 2px;\n        }\n\n        .update-type.release {\n            background-color: #e6f7ff;\n            color: #0050b3;\n            border: 1px solid #91d5ff;\n        }\n\n        .update-type.feature {\n            background-color: #f6ffed;\n            color: #389e0d;\n            border: 1px solid #b7eb8f;\n        }\n\n        .update-type.announcement {\n            background-color: #fff7e6;\n            color: #d46b08;\n            border: 1px solid #ffd591;\n        }\n\n        .feedback {\n            margin-top: 8px;\n            padding: 5px;\n            background-color: #f6f6ef;\n            border-left: 3px solid #ff6600;\n        }\n\n        .feedback-positive {\n            border-left-color: #389e0d;\n        }\n\n        .feedback-negative {\n            border-left-color: #cf1322;\n        }\n\n        .feedback-neutral {\n            border-left-color: #8c8c8c;\n        }\n\n        .feedback-quote {\n            font-size: 8pt;\n            font-style: italic;\n            color: #000000;\n            margin-bottom: 3px;\n        }\n\n        .feedback-source {\n            font-size: 8pt;\n            color: #828282;\n        }\n\n        .empty-state {\n            text-align: center;\n            padding: 30px;\n            color: #828282;\n            font-style: italic;\n        }\n\n        footer {\n            text-align: center;\n            padding: 15px;\n            border-top: 1px solid #d4d4d4;\n            margin-top: 20px;\n            color: #828282;\n            font-size: 9pt;\n        }\n\n        footer a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n        }\n\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            .column {\n                border: 1px solid #000000;\n                page-break-inside: avoid;\n            }\n\n            header {\n                background-color: #ffffff;\n                border-bottom: 2px solid #000000;\n            }\n\n            header h1 {\n                color: #000000;\n            }\n        }\n\n        .topics {\n            margin-top: 5px;\n        }\n\n        .source-badge {\n            display: inline-block;\n            background-color: #ff6600;\n            color: #000000;\n            padding: 1px 4px;\n            font-size: 7pt;\n            font-weight: bold;\n            margin-right: 5px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agentic Coding Research Report</h1>\n            <div class=\"date\">2026-06-29</div>\n        </header>\n\n        <main class=\"three-column-layout\">\n            <!-- New Products Section -->\n            <section class=\"column new-products\">\n                <h2>New Products</h2>\n                <div class=\"empty-state\">\n                    No new products detected for this date.\n                </div>\n            </section>\n\n            <!-- Whitelist Updates Section -->\n            <section class=\"column whitelist-updates\">\n                <h2>Whitelist Updates</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://releasebot.io/updates/anthropic/claude\" target=\"_blank\">Claude Code: Trusted Devices Feature</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Added Trusted Devices feature for Remote Control Admins on Team and Enterprise plans to verify devices before remote Claude Code sessions. Earlier June updates also included stronger auto-mode controls, better shell and MCP handling, richer background agent behavior, and improved debugging capabilities.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span>2026-06-25</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://developers.openai.com/codex/changelog\" target=\"_blank\">Codex CLI: Codex Remote General Availability</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Codex Remote reached general availability for connected Mac systems. June 25 update brought Codex CLI 0.x release with improved MCP tool search capabilities and stronger macOS proxy support. Broader ecosystem changes include GPT-5.5 integration, stable goal mode, and Chrome extension support.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type release\">Release</span>\n                        <span>2026-06-25</span>\n                    </div>\n                    <div class=\"feedback feedback-positive\">\n                        <div class=\"feedback-quote\">\"Codex CLI was rewritten from TypeScript to Rust in 2025-2026\"</div>\n                        <div class=\"feedback-source\">— Digital Applied blog (positive)</div>\n                    </div>\n                    <div class=\"feedback feedback-negative\">\n                        <div class=\"feedback-quote\">\"Interactive /review follow-up crashes in codex-cli 0.118.0\"</div>\n                        <div class=\"feedback-source\">— GitHub Issue (negative)</div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://changelog.continue.dev/\" target=\"_blank\">Continue: Acquired by Cursor</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Continue.dev was acquired by Cursor in June 2026. Version 2.0.0 (June 19) is the final release of the open-source VS Code extension, CLI, and JetBrains plugin. The GitHub repository is now read-only. Final release removed telemetry, CLI banner, and Generate Rule feature.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type announcement\">Announcement</span>\n                        <span>2026-06-19</span>\n                    </div>\n                    <div class=\"feedback feedback-neutral\">\n                        <div class=\"feedback-quote\">\"Woke up to an email saying continue.dev has been acquired by Cursor\"</div>\n                        <div class=\"feedback-source\">— Hacker News (neutral)</div>\n                    </div>\n                    <div class=\"feedback feedback-positive\">\n                        <div class=\"feedback-quote\">\"Continue.Dev has taken some serious notes from Cursor\"</div>\n                        <div class=\"feedback-source\">— Reddit (positive)</div>\n                    </div>\n                    <div class=\"feedback feedback-negative\">\n                        <div class=\"feedback-quote\">\"Why the Cursor Acquisition Should Concern Every Software Developer\"</div>\n                        <div class=\"feedback-source\">— Reddit (negative)</div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://devin.ai/desktop/\" target=\"_blank\">Devin: Devin Desktop Launch</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Cognition introduced Devin Desktop in June 2026, transforming the Windsurf interface into an agent command center. The AI-assisted automation input now shows incremental generating steps as it builds automation workflows. Users can manage fleets of local and cloud agents from one surface.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type release\">Release</span>\n                        <span>2026-06-15</span>\n                    </div>\n                    <div class=\"feedback feedback-positive\">\n                        <div class=\"feedback-quote\">\"Devin Desktop allows users to plan, delegate, review, and ship without leaving your editor\"</div>\n                        <div class=\"feedback-source\">— Product description (positive)</div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://cursor.com/changelog\" target=\"_blank\">Cursor: Cloud Agent Handoff and SDK</a>\n                    </div>\n                    <div class=\"item-description\">\n                        June 10 update enabled pulling cloud agents back to local for testing with handoff between local and cloud. June 4 update introduced Custom stores, Custom tools, and Auto-review for the Cursor SDK.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span>2026-06-10</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.developersdigest.tech/blog/aider-vs-claude-code-2026-update\" target=\"_blank\">Aider: Market Position Update</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Aider maintains v0.86.2 as stable release with continued development. Recognized as best open-source CLI coding agent with 44k+ GitHub stars, git-first approach, and backend-agnostic flexibility supporting any LLM including local models via Ollama.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type announcement\">Announcement</span>\n                        <span>2026-06-11</span>\n                    </div>\n                    <div class=\"feedback feedback-positive\">\n                        <div class=\"feedback-quote\">\"The latest release works GREAT with gpt-5.3-codex\"</div>\n                        <div class=\"feedback-source\">— GitHub (positive)</div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.youtube.com/watch?v=dCcchCYJ5no\" target=\"_blank\">Windsurf: Rebranded to Devin Desktop</a>\n                    </div>\n                    <div class=\"item-description\">\n                        On June 2, 2026, Cognition rebranded Windsurf to Devin Desktop. Existing users received an over-the-air update. Windsurf was kept available through July 1, 2026. After July 1, 2026, Devin Local became the only local agent option.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type announcement\">Announcement</span>\n                        <span>2026-06-02</span>\n                    </div>\n                    <div class=\"feedback feedback-positive\">\n                        <div class=\"feedback-quote\">\"As of February 2026, Windsurf ranked #1 in LogRocket's AI Dev Tool Power Rankings\"</div>\n                        <div class=\"feedback-source\">— LogRocket (positive)</div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/news-insights/company-news/github-copilot-is-moving-to-usage-based-billing/\" target=\"_blank\">GitHub Copilot: Usage-Based Billing</a>\n                    </div>\n                    <div class=\"item-description\">\n                        GitHub Copilot moved from flat-rate/request-based billing to usage-based billing using GitHub AI Credits. All plans now charge based on actual token consumption depending on the model used. Also introduced MAI-Code-1-Flash model, Copilot Max plan, pooled organization credits, and budget controls.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type announcement\">Announcement</span>\n                        <span>2026-06-01</span>\n                    </div>\n                    <div class=\"feedback feedback-negative\">\n                        <div class=\"feedback-quote\">\"Usage paying for AI is 1000x crazier 4.6 each dollar spent is 27 dollars in copilot AI Credits\"</div>\n                        <div class=\"feedback-source\">— Hacker News (negative)</div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://geminicli.com/docs/changelogs/\" target=\"_blank\">Gemini CLI: v0.45.0 Release</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Released v0.45.0 on June 3, 2026 with safer auto-updates, improved terminal and WSL handling, faster and more reliable core behavior, and new user actions.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type release\">Release</span>\n                        <span>2026-06-03</span>\n                    </div>\n                    <div class=\"feedback feedback-negative\">\n                        <div class=\"feedback-quote\">\"Gemini CLI stopping work from June 18, 2026\"</div>\n                        <div class=\"feedback-source\">— Hacker News (negative)</div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Technical Insights Section -->\n            <section class=\"column technical-insights\">\n                <h2>Technical Insights</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/#entry-20260626-1833\" target=\"_blank\">AI Assistant Security Challenge</a>\n                    </div>\n                    <div class=\"item-description\">\n                        After 2,000 people tried to hack an OpenClaw test instance with 6,000 attempts and $500 in token spend, nobody managed to leak the secret using Opus 4.6.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-badge\">Blog</span>\n                        <a href=\"https://simonwillison.net/#entry-20260626-1833\">Simon Willison</a>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"tag\">security</span>\n                        <span class=\"tag\">ai</span>\n                        <span class=\"tag\">prompt-injection</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/#entry-20260626-1758\" target=\"_blank\">AI Review Agent Disagreement Loop</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Hypothetical incident report: two AI review agents entered a disagreement loop over a malicious package, costing $41,255 in inference spend before Finance revoked API keys.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-badge\">Blog</span>\n                        <a href=\"https://simonwillison.net/#entry-20260626-1758\">Simon Willison</a>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"tag\">security</span>\n                        <span class=\"tag\">supply-chain</span>\n                        <span class=\"tag\">ai-security</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/#entry-20260626-1710\" target=\"_blank\">OpenAI GPT-5.6 Series Announced</a>\n                    </div>\n                    <div class=\"item-description\">\n                        GPT-5.6 introduces three model sizes: Sol, Terra, and Luna with predictable prompt caching and 30-minute minimum cache life.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-badge\">Blog</span>\n                        <a href=\"https://simonwillison.net/#entry-20260626-1710\">OpenAI</a>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"tag\">gpt</span>\n                        <span class=\"tag\">openai</span>\n                        <span class=\"tag\">llm-release</span>\n                        <span class=\"tag\">pricing</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/#entry-20260625-2228\" target=\"_blank\">AI Liability Ruling in Germany</a>\n                    </div>\n                    <div class=\"item-description\">\n                        German ruling holds Google liable for errors in AI overviews. AI agents should be treated as agents of the deploying organization.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-badge\">Blog</span>\n                        <a href=\"https://simonwillison.net/#entry-20260625-2228\">Bruce Schneier</a>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"tag\">google</span>\n                        <span class=\"tag\">law</span>\n                        <span class=\"tag\">ai-ethics</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/#entry-20260624-2359\" target=\"_blank\">Browser Compatibility Database in SQLite</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Converting MDN browser compatibility data to SQLite with Claude Code assistance. 66MB database available via GitHub CDN.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-badge\">Blog</span>\n                        <a href=\"https://simonwillison.net/#entry-20260624-2359\">Simon Willison</a>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"tag\">github</span>\n                        <span class=\"tag\">mozilla</span>\n                        <span class=\"tag\">datasette</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/#entry-20260624-1813\" target=\"_blank\">LLM-Generated Job Applications</a>\n                    </div>\n                    <div class=\"item-description\">\n                        LLM-generated job applications are generic and impersonal, telling nothing about the person other than tool usage.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-badge\">Blog</span>\n                        <a href=\"https://simonwillison.net/#entry-20260624-1813\">Tom MacWright</a>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"tag\">careers</span>\n                        <span class=\"tag\">ai-misuse</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/#entry-20260622-2359\" target=\"_blank\">Prompt Injection as Role Confusion</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Research shows models take text style more seriously than content. 'Destyling' reduces attack success from 61% to 10%.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-badge\">Blog</span>\n                        <a href=\"https://simonwillison.net/#entry-20260622-2359\">Simon Willison</a>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"tag\">jailbreaking</span>\n                        <span class=\"tag\">prompt-injection</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/#entry-20260622-2343\" target=\"_blank\">Moebius Image Inpainting in Browser</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Ported Moebius 0.2B image inpainting model to run using WebGPU in the browser with Claude Code assistance.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source-badge\">Blog</span>\n                        <a href=\"https://simonwillison.net/#entry-20260622-2343\">Simon Willison</a>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"tag\">browsers</span>\n                        <span class=\"tag\">webgl</span>\n                        <span class=\"tag\">claude-code</span>\n                    </div>\n                </div>\n            </section>\n        </main>\n\n        <footer>\n            <p>Generated by Agentic Coding Research Report • <a href=\"#\">Archive</a> • <a href=\"#\">About</a></p>\n        </footer>\n    </div>\n</body>\n</html>",
