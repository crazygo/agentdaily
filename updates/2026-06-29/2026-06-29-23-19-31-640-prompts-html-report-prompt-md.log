d4;\n    63→            padding: 10px;\n    64→        }\n    65→\n    66→        .column h2 {\n    67→            font-family: Arial, Helvetica, sans-serif;\n    68→            font-size: 12pt;\n    69→            font-weight: bold;\n    70→            color: #000000;\n    71→            border-bottom: 2px solid #ff6600;\n    72→            padding-bottom: 5px;\n    73→            margin-bottom: 10px;\n    74→        }\n    75→\n    76→        .item {\n    77→            margin-bottom: 15px;\n    78→            padding-bottom: 15px;\n    79→            border-bottom: 1px dotted #d4d4d4;\n    80→        }\n    81→\n    82→        .item:last-child {\n    83→            border-bottom: none;\n    84→            margin-bottom: 0;\n    85→            padding-bottom: 0;\n    86→        }\n    87→\n    88→        .item-title {\n    89→            font-family: Arial, Helvetica, sans-serif;\n    90→            font-size: 10pt;\n    91→            font-weight: bold;\n    92→            margin-bottom: 5px;\n    93→        }\n    94→\n    95→        .item-title a {\n    96→            color: #000000;\n    97→            text-decoration: none;\n    98→        }\n    99→\n   100→        .item-title a:visited {\n   101→            color: #828282;\n   102→        }\n   103→\n   104→        .item-title a:hover {\n   105→            text-decoration: underline;\n   106→        }\n   107→\n   108→        .item-description {\n   109→            font-size: 9pt;\n   110→            color: #000000;\n   111→            margin-bottom: 5px;\n   112→            line-height: 1.4;\n   113→        }\n   114→\n   115→        .item-meta {\n   116→            font-size: 8pt;\n   117→            color: #828282;\n   118→        }\n   119→\n   120→        .item-meta a {\n   121→            color: #828282;\n   122→            text-decoration: none;\n   123→        }\n   124→\n   125→        .item-meta a:hover {\n   126→            text-decoration: underline;\n   127→        }\n   128→\n   129→        .tag {\n   130→            display: inline-block;\n   131→            background-color: #f6f6ef;\n   132→            padding: 2px 5px;\n   133→            margin: 2px;\n   134→            font-size: 8pt;\n   135→            color: #828282;\n   136→            border: 1px solid #d4d4d4;\n   137→        }\n   138→\n   139→        .update-type {\n   140→            display: inline-block;\n   141→            padding: 2px 5px;\n   142→            margin: 2px;\n   143→            font-size: 8pt;\n   144→            font-weight: bold;\n   145→            border-radius: 2px;\n   146→        }\n   147→\n   148→        .update-type.release {\n   149→            background-color: #e6f7ff;\n   150→            color: #0050b3;\n   151→            border: 1px solid #91d5ff;\n   152→        }\n   153→\n   154→        .update-type.feature {\n   155→            background-color: #f6ffed;\n   156→            color: #389e0d;\n   157→            border: 1px solid #b7eb8f;\n   158→        }\n   159→\n   160→        .update-type.announcement {\n   161→            background-color: #fff7e6;\n   162→            color: #d46b08;\n   163→            border: 1px solid #ffd591;\n   164→        }\n   165→\n   166→        .feedback {\n   167→            margin-top: 8px;\n   168→            padding: 5px;\n   169→            background-color: #f6f6ef;\n   170→            border-left: 3px solid #ff6600;\n   171→        }\n   172→\n   173→        .feedback-positive {\n   174→            border-left-color: #389e0d;\n   175→        }\n   176→\n   177→        .feedback-negative {\n   178→            border-left-color: #cf1322;\n   179→        }\n   180→\n   181→        .feedback-neutral {\n   182→            border-left-color: #8c8c8c;\n   183→        }\n   184→\n   185→        .feedback-quote {\n   186→            font-size: 8pt;\n   187→            font-style: italic;\n   188→            color: #000000;\n   189→            margin-bottom: 3px;\n   190→        }\n   191→\n   192→        .feedback-source {\n   193→            font-size: 8pt;\n   194→            color: #828282;\n   195→        }\n   196→\n   197→        .empty-state {\n   198→            text-align: center;\n   199→            padding: 30px;\n   200→            color: #828282;\n   201→            font-style: italic;\n   202→        }\n   203→\n   204→        footer {\n   205→            text-align: center;\n   206→            padding: 15px;\n   207→            border-top: 1px solid #d4d4d4;\n   208→            margin-top: 20px;\n   209→            color: #828282;\n   210→            font-size: 9pt;\n   211→        }\n   212→\n   213→        footer a {\n   214→            color: #828282;\n   215→            text-decoration: none;\n   216→        }\n   217→\n   218→        footer a:hover {\n   219→            text-decoration: underline;\n   220→        }\n   221→\n   222→        @media print {\n   223→            body {\n   224→                background-color: #ffffff;\n   225→            }\n   226→\n   227→            .column {\n   228→                border: 1px solid #000000;\n   229→                page-break-inside: avoid;\n   230→            }\n   231→\n   232→            header {\n   233→                background-color: #ffffff;\n   234→                border-bottom: 2px solid #000000;\n   235→            }\n   236→\n   237→            header h1 {\n   238→                color: #000000;\n   239→            }\n   240→        }\n   241→\n   242→        .topics {\n   243→            margin-top: 5px;\n   244→        }\n   245→\n   246→        .source-badge {\n   247→            display: inline-block;\n   248→            background-color: #ff6600;\n   249→            color: #000000;\n   250→            padding: 1px 4px;\n   251→            font-size: 7pt;\n   252→            font-weight: bold;\n   253→            margin-right: 5px;\n   254→        }\n   255→    </style>\n   256→</head>\n   257→<body>\n   258→    <div class=\"container\">\n   259→        <header>\n   260→            <h1>Agentic Coding Research Report</h1>\n   261→            <div class=\"date\">2026-06-29</div>\n   262→        </header>\n   263→\n   264→        <main class=\"three-column-layout\">\n   265→            <!-- New Products Section -->\n   266→            <section class=\"column new-products\">\n   267→                <h2>New Products</h2>\n   268→                <div class=\"empty-state\">\n   269→                    No new products detected for this date.\n   270→                </div>\n   271→            </section>\n   272→\n   273→            <!-- Whitelist Updates Section -->\n   274→            <section class=\"column whitelist-updates\">\n   275→                <h2>Whitelist Updates</h2>\n   276→\n   277→                <div class=\"item\">\n   278→                    <div class=\"item-title\">\n   279→                        <a href=\"https://releasebot.io/updates/anthropic/claude\" target=\"_blank\">Claude Code: Trusted Devices Feature</a>\n   280→                    </div>\n   281→                    <div class=\"item-description\">\n   282→                        Added Trusted Devices feature for Remote Control Admins on Team and Enterprise plans to verify devices before remote Claude Code sessions. Earlier June updates also included stronger auto-mode controls, better shell and MCP handling, richer background agent behavior, and improved debugging capabilities.\n   283→                    </div>\n   284→                    <div class=\"item-meta\">\n   285→                        <span class=\"update-type feature\">Feature</span>\n   286→                        <span>2026-06-25</span>\n   287→                    </div>\n   288→                </div>\n   289→\n   290→                <div class=\"item\">\n   291→                    <div class=\"item-title\">\n   292→                        <a href=\"https://developers.openai.com/codex/changelog\" target=\"_blank\">Codex CLI: Codex Remote General Availability</a>\n   293→                    </div>\n   294→                    <div class=\"item-description\">\n   295→                        Codex Remote reached general availability for connected Mac systems. June 25 update brought Codex CLI 0.x release with improved MCP tool search capabilities and stronger macOS proxy support. Broader ecosystem changes include GPT-5.5 integration, stable goal mode, and Chrome extension support.\n   296→                    </div>\n   297→                    <div class=\"item-meta\">\n   298→                        <span class=\"update-type release\">Release</span>\n   299→                        <span>2026-06-25</span>\n   300→                    </div>\n   301→                    <div class=\"feedback feedback-positive\">\n   302→                        <div class=\"feedback-quote\">\"Codex CLI was rewritten from TypeScript to Rust in 2025-2026\"</div>\n   303→                        <div class=\"feedback-source\">— Digital Applied blog (positive)</div>\n   304→                    </div>\n   305→                    <div class=\"feedback feedback-negative\">\n   306→                        <div class=\"feedback-quote\">\"Interactive /review follow-up crashes in codex-cli 0.118.0\"</div>\n   307→                        <div class=\"feedback-source\">— GitHub Issue (negative)</div>\n   308→                    </div>\n   309→                </div>\n   310→\n   311→                <div class=\"item\">\n   312→                    <div class=\"item-title\">\n   313→                        <a href=\"https://changelog.continue.dev/\" target=\"_blank\">Continue: Acquired by Cursor</a>\n   314→                    </div>\n   315→                    <div class=\"item-description\">\n   316→                        Continue.dev was acquired by Cursor in June 2026. Version 2.0.0 (June 19) is the final release of the open-source VS Code extension, CLI, and JetBrains plugin. The GitHub repository is now read-only. Final release removed telemetry, CLI banner, and Generate Rule feature.\n   317→                    </div>\n   318→                    <div class=\"item-meta\">\n   319→                        <span class=\"update-type announcement\">Announcement</span>\n   320→                        <span>2026-06-19</span>\n   321→                    </div>\n   322→                    <div class=\"feedback feedback-neutral\">\n   323→                        <div class=\"feedback-quote\">\"Woke up to an email saying continue.dev has been acquired by Cursor\"</div>\n   324→                        <div class=\"feedback-source\">— Hacker News (neutral)</div>\n   325→                    </div>\n   326→                    <div class=\"feedback feedback-positive\">\n   327→                        <div class=\"feedback-quote\">\"Continue.Dev has taken some serious notes from Cursor\"</div>\n   328→                        <div class=\"feedback-source\">— Reddit (positive)</div>\n   329→                    </div>\n   330→                    <div class=\"feedback feedback-negative\">\n   331→                        <div class=\"feedback-quote\">\"Why the Cursor Acquisition Should Concern Every Software Developer\"</div>\n   332→                        <div class=\"feedback-source\">— Reddit (negative)</div>\n   333→                    </div>\n   334→                </div>\n   335→\n   336→                <div class=\"item\">\n   337→                    <div class=\"item-title\">\n   338→                        <a href=\"https://devin.ai/desktop/\" target=\"_blank\">Devin: Devin Desktop Launch</a>\n   339→                    </div>\n   340→                    <div class=\"item-description\">\n   341→                        Cognition introduced Devin Desktop in June 2026, transforming the Windsurf interface into an agent command center. The AI-assisted automation input now shows incremental generating steps as it builds automation workflows. Users can manage fleets of local and cloud agents from one surface.\n   342→                    </div>\n   343→                    <div class=\"item-meta\">\n   344→                        <span class=\"update-type release\">Release</span>\n   345→                        <span>2026-06-15</span>\n   346→                    </div>\n   347→                    <div class=\"feedback feedback-positive\">\n   348→                        <div class=\"feedback-quote\">\"Devin Desktop allows users to plan, delegate, review, and ship without leaving your editor\"</div>\n   349→                        <div class=\"feedback-source\">— Product description (positive)</div>\n   350→                    </div>\n   351→                </div>\n   352→\n   353→                <div class=\"item\">\n   354→                    <div class=\"item-title\">\n   355→                        <a href=\"https://cursor.com/changelog\" target=\"_blank\">Cursor: Cloud Agent Handoff and SDK</a>\n   356→                    </div>\n   357→                    <div class=\"item-description\">\n   358→                        June 10 update enabled pulling cloud agents back to local for testing with handoff between local and cloud. June 4 update introduced Custom stores, Custom tools, and Auto-review for the Cursor SDK.\n   359→                    </div>\n   360→                    <div class=\"item-meta\">\n   361→                        <span class=\"update-type feature\">Feature</span>\n   362→                        <span>2026-06-10</span>\n   363→                    </div>\n   364→                </div>\n   365→\n   366→                <div class=\"item\">\n   367→                    <div class=\"item-title\">\n   368→                        <a href=\"https://www.developersdigest.tech/blog/aider-vs-claude-code-2026-update\" target=\"_blank\">Aider: Market Position Update</a>\n   369→                    </div>\n   370→                    <div class=\"item-description\">\n   371→                        Aider maintains v0.86.2 as stable release with continued development. Recognized as best open-source CLI coding agent with 44k+ GitHub stars, git-first approach, and backend-agnostic flexibility supporting any LLM including local models via Ollama.\n   372→                    </div>\n   373→                    <div class=\"item-meta\">\n   374→                        <span class=\"update-type announcement\">Announcement</span>\n   375→                        <span>2026-06-11</span>\n   376→                    </div>\n   377→                    <div class=\"feedback feedback-positive\">\n   378→                        <div class=\"feedback-quote\">\"The latest release works GREAT with gpt-5.3-codex\"</div>\n   379→                        <div class=\"feedback-source\">— GitHub (positive)</div>\n   380→                    </div>\n   381→                </div>\n   382→\n   383→                <div class=\"item\">\n   384→                    <div class=\"item-title\">\n   385→                        <a href=\"https://www.youtube.com/watch?v=dCcchCYJ5no\" target=\"_blank\">Windsurf: Rebranded to Devin Desktop</a>\n   386→                    </div>\n   387→                    <div class=\"item-description\">\n   388→                        On June 2, 2026, Cognition rebranded Windsurf to Devin Desktop. Existing users received an over-the-air update. Windsurf was kept available through July 1, 2026. After July 1, 2026, Devin Local became the only local agent option.\n   389→                    </div>\n   390→                    <div class=\"item-meta\">\n   391→                        <span class=\"update-type announcement\">Announcement</span>\n   392→                        <span>2026-06-02</span>\n   393→                    </div>\n   394→                    <div class=\"feedback feedback-positive\">\n   395→                        <div class=\"feedback-quote\">\"As of February 2026, Windsurf ranked #1 in LogRocket's AI Dev Tool Power Rankings\"</div>\n   396→                        <div class=\"feedback-source\">— LogRocket (positive)</div>\n   397→                    </div>\n   398→                </div>\n   399→\n   400→                <div class=\"item\">\n   401→                    <div class=\"item-title\">\n   402→                        <a href=\"https://github.blog/news-insights/company-news/github-copilot-is-moving-to-usage-based-billing/\" target=\"_blank\">GitHub Copilot: Usage-Based Billing</a>\n   403→                    </div>\n   404→                    <div class=\"item-description\">\n   405→                        GitHub Copilot moved from flat-rate/request-based billing to usage-based billing using GitHub AI Credits. All plans now charge based on actual token consumption depending on the model used. Also introduced MAI-Code-1-Flash model, Copilot Max plan, pooled organization credits, and budget controls.\n   406→                    </div>\n   407→                    <div class=\"item-meta\">\n   408→                        <span class=\"update-type announcement\">Announcement</span>\n   409→                        <span>2026-06-01</span>\n   410→                    </div>\n   411→                    <div class=\"feedback feedback-negative\">\n   412→                        <div class=\"feedback-quote\">\"Usage paying for AI is 1000x crazier 4.6 each dollar spent is 27 dollars in copilot AI Credits\"</div>\n   413→                        <div class=\"feedback-source\">— Hacker News (negative)</div>\n   414→                    </div>\n   415→                </div>\n   416→\n   417→                <div class=\"item\">\n   418→                    <div class=\"item-title\">\n   419→                        <a href=\"https://geminicli.com/docs/changelogs/\" target=\"_blank\">Gemini CLI: v0.45.0 Release</a>\n   420→                    </div>\n   421→                    <div class=\"item-description\">\n   422→                        Released v0.45.0 on June 3, 2026 with safer auto-updates, improved terminal and WSL handling, faster and more reliable core behavior, and new user actions.\n   423→                    </div>\n   424→                    <div class=\"item-meta\">\n   425→                        <span class=\"update-type release\">Release</span>\n   426→                        <span>2026-06-03</span>\n   427→                    </div>\n   428→                    <div class=\"feedback feedback-negative\">\n   429→                        <div class=\"feedback-quote\">\"Gemini CLI stopping work from June 18, 2026\"</div>\n   430→                        <div class=\"feedback-source\">— Hacker News (negative)</div>\n   431→                    </div>\n   432→                </div>\n   433→            </section>\n   434→\n   435→            <!-- Technical Insights Section -->\n   436→            <section class=\"column technical-insights\">\n   437→                <h2>Technical Insights</h2>\n   438→\n   439→                <div class=\"item\">\n   440→                    <div class=\"item-title\">\n   441→                        <a href=\"https://simonwillison.net/#entry-20260626-1833\" target=\"_blank\">AI Assistant Security Challenge</a>\n   442→                    </div>\n   443→                    <div class=\"item-description\">\n   444→                        After 2,000 people tried to hack an OpenClaw test instance with 6,000 attempts and $500 in token spend, nobody managed to leak the secret using Opus 4.6.\n   445→                    </div>\n   446→                    <div class=\"item-meta\">\n   447→                        <span class=\"source-badge\">Blog</span>\n   448→                        <a href=\"https://simonwillison.net/#entry-20260626-1833\">Simon Willison</a>\n   449→                    </div>\n   450→                    <div class=\"topics\">\n   451→                        <span class=\"tag\">security</span>\n   452→                        <span class=\"tag\">ai</span>\n   453→                        <span class=\"tag\">prompt-injection</span>\n   454→                    </div>\n   455→                </div>\n   456→\n   457→                <div class=\"item\">\n   458→                    <div class=\"item-title\">\n   459→                        <a href=\"https://simonwillison.net/#entry-20260626-1758\" target=\"_blank\">AI Review Agent Disagreement Loop</a>\n   460→                    </div>\n   461→                    <div class=\"item-description\">\n   462→                        Hypothetical incident report: two AI review agents entered a disagreement loop over a malicious package, costing $41,255 in inference spend before Finance revoked API keys.\n   463→                    </div>\n   464→                    <div class=\"item-meta\">\n   465→                        <span class=\"source-badge\">Blog</span>\n   466→                        <a href=\"https://simonwillison.net/#entry-20260626-1758\">Simon Willison</a>\n   467→                    </div>\n   468→                    <div class=\"topics\">\n   469→                        <span class=\"tag\">security</span>\n   470→                        <span class=\"tag\">supply-chain</span>\n   471→                        <span class=\"tag\">ai-security</span>\n   472→                    </div>\n   473→                </div>\n   474→\n   475→                <div class=\"item\">\n   476→                    <div class=\"item-title\">\n   477→                        <a href=\"https://simonwillison.net/#entry-20260626-1710\" target=\"_blank\">OpenAI GPT-5.6 Series Announced</a>\n   478→                    </div>\n   479→                    <div class=\"item-description\">\n   480→                        GPT-5.6 introduces three model sizes: Sol, Terra, and Luna with predictable prompt caching and 30-minute minimum cache life.\n   481→                    </div>\n   482→                    <div class=\"item-meta\">\n   483→                        <span class=\"source-badge\">Blog</span>\n   484→                        <a href=\"https://simonwillison.net/#entry-20260626-1710\">OpenAI</a>\n   485→                    </div>\n   486→                    <div class=\"topics\">\n   487→                        <span class=\"tag\">gpt</span>\n   488→                        <span class=\"tag\">openai</span>\n   489→                        <span class=\"tag\">llm-release</span>\n   490→                        <span class=\"tag\">pricing</span>\n   491→                    </div>\n   492→                </div>\n   493→\n   494→                <div class=\"item\">\n   495→                    <div class=\"item-title\">\n   496→                        <a href=\"https://simonwillison.net/#entry-20260625-2228\" target=\"_blank\">AI Liability Ruling in Germany</a>\n   497→                    </div>\n   498→                    <div class=\"item-description\">\n   499→                        German ruling holds Google liable for errors in AI overviews. AI agents should be treated as agents of the deploying organization.\n   500→                    </div>\n   501→                    <div class=\"item-meta\">\n   502→                        <span class=\"source-badge\">Blog</span>\n   503→                        <a href=\"https://simonwillison.net/#entry-20260625-2228\">Bruce Schneier</a>\n   504→                    </div>\n   505→                    <div class=\"topics\">\n   506→                        <span class=\"tag\">google</span>\n   507→                        <span class=\"tag\">law</span>\n   508→                        <span class=\"tag\">ai-ethics</span>\n   509→                    </div>\n   510→                </div>\n   511→\n   512→                <div class=\"item\">\n   513→                    <div class=\"item-title\">\n   514→                        <a href=\"https://simonwillison.net/#entry-20260624-2359\" target=\"_blank\">Browser Compatibility Database in SQLite</a>\n   515→                    </div>\n   516→                    <div class=\"item-description\">\n   517→                        Converting MDN browser compatibility data to SQLite with Claude Code assistance. 66MB database available via GitHub CDN.\n   518→                    </div>\n   519→                    <div class=\"item-meta\">\n   520→                        <span class=\"source-badge\">Blog</span>\n   521→                        <a href=\"https://simonwillison.net/#entry-20260624-2359\">Simon Willison</a>\n   522→                    </div>\n   523→                    <div class=\"topics\">\n   524→                        <span class=\"tag\">github</span>\n   525→                        <span class=\"tag\">mozilla</span>\n   526→                        <span class=\"tag\">datasette</span>\n   527→                    </div>\n   528→                </div>\n   529→\n   530→                <div class=\"item\">\n   531→                    <div class=\"item-title\">\n   532→                        <a href=\"https://simonwillison.net/#entry-20260624-1813\" target=\"_blank\">LLM-Generated Job Applications</a>\n   533→                    </div>\n   534→                    <div class=\"item-description\">\n   535→                        LLM-generated job applications are generic and impersonal, telling nothing about the person other than tool usage.\n   536→                    </div>\n   537→                    <div class=\"item-meta\">\n   538→                        <span class=\"source-badge\">Blog</span>\n   539→                        <a href=\"https://simonwillison.net/#entry-20260624-1813\">Tom MacWright</a>\n   540→                    </div>\n   541→                    <div class=\"topics\">\n   542→                        <span class=\"tag\">careers</span>\n   543→                        <span class=\"tag\">ai-misuse</span>\n   544→                    </div>\n   545→                </div>\n   546→\n   547→                <div class=\"item\">\n   548→                    <div class=\"item-title\">\n   549→                        <a href=\"https://simonwillison.net/#entry-20260622-2359\" target=\"_blank\">Prompt Injection as Role Confusion</a>\n   550→                    </div>\n   551→                    <div class=\"item-description\">\n   552→                        Research shows models take text style more seriously than content. 'Destyling' reduces attack success from 61% to 10%.\n   553→                    </div>\n   554→                    <div class=\"item-meta\">\n   555→                        <span class=\"source-badge\">Blog</span>\n   556→                        <a href=\"https://simonwillison.net/#entry-20260622-2359\">Simon Willison</a>\n   557→                    </div>\n   558→                    <div class=\"topics\">\n   559→                        <span class=\"tag\">jailbreaking</span>\n   560→                        <span class=\"tag\">prompt-injection</span>\n   561→                    </div>\n   562→                </div>\n   563→\n   564→                <div class=\"item\">\n   565→                    <div class=\"item-title\">\n   566→                        <a href=\"https://simonwillison.net/#entry-20260622-2343\" target=\"_blank\">Moebius Image Inpainting in Browser</a>\n   567→                    </div>\n   568→                    <div class=\"item-description\">\n   569→                        Ported Moebius 0.2B image inpainting model to run using WebGPU in the browser with Claude Code assistance.\n   570→                    </div>\n   571→                    <div class=\"item-meta\">\n   572→                        <span class=\"source-badge\">Blog</span>\n   573→                        <a href=\"https://simonwillison.net/#entry-20260622-2343\">Simon Willison</a>\n   574→                    </div>\n   575→                    <div class=\"topics\">\n   576→                        <span class=\"tag\">browsers</span>\n   577→                        <span class=\"tag\">webgl</span>\n   578→                        <span class=\"tag\">claude-code</span>\n   579→                    </div>\n   580→                </div>\n   581→            </section>\n   582→        </main>\n   583→\n   584→        <footer>\n   585→            <p>Generated by Agentic Coding Research Report • <a href=\"#\">Archive</a> • <a href=\"#\">About</a></p>\n   586→        </footer>\n   587→    </div>\n   588→</body>\n   589→</html>\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
