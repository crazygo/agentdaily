11px;\n            color: #828282;\n            border-top: 1px solid #d4d4d4;\n        }\n\n        footer a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n        }\n\n        .footer-links {\n            display: flex;\n            justify-content: center;\n            gap: 15px;\n            margin-bottom: 10px;\n        }\n\n        /* Print Styles */\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            .three-column-layout {\n                grid-template-columns: 1fr;\n            }\n\n            section {\n                page-break-inside: avoid;\n                margin-bottom: 20px;\n            }\n        }\n\n        /* Utility Classes */\n        .badge {\n            display: inline-block;\n            padding: 2px 6px;\n            border-radius: 2px;\n            font-size: 10px;\n            font-weight: bold;\n        }\n\n        .badge-security {\n            background-color: #ffebee;\n            color: #c62828;\n            border: 1px solid #ef9a9a;\n        }\n\n        .badge-feature {\n            background-color: #e3f2fd;\n            color: #1565c0;\n            border: 1px solid #90caf9;\n        }\n\n        .badge-release {\n            background-color: #e8f5e9;\n            color: #2e7d32;\n            border: 1px solid #a5d6a7;\n        }\n\n        .badge-bugfix {\n            background-color: #fff3e0;\n            color: #ef6c00;\n            border: 1px solid #ffb74d;\n        }\n\n        .badge-opinion {\n            background-color: #f3e5f5;\n            color: #7b1fa2;\n            border: 1px solid #ce93d8;\n        }\n\n        .badge-technical {\n            background-color: #e0f2f1;\n            color: #00695c;\n            border: 1px solid #80cbc4;\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <div class=\"header-content\">\n            <div class=\"header-left\">\n                <div class=\"logo\">\n                    <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <rect width=\"14\" height=\"14\" fill=\"#ff6600\"/>\n                    </svg>\n                </div>\n                <h1>Agentic Coding Research Report</h1>\n            </div>\n            <div class=\"header-nav\">\n                <a href=\"#new-products\">New</a>\n                <a href=\"#updates\">Updates</a>\n                <a href=\"#insights\">Insights</a>\n                <a href=\"#\">About</a>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"container\">\n        <div class=\"three-column-layout\">\n            <!-- Left Column: New Products -->\n            <section class=\"new-products\" id=\"new-products\">\n                <div class=\"section-header\">\n                    <h2>New Products (1)</h2>\n                </div>\n                <div class=\"section-content\">\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://termiprotocol.com/\" target=\"_blank\">Termi Protocol</a>\n                        </div>\n                        <div class=\"item-description\">\n                            A 3D simulation environment that visualizes AI coding agent workflows in real-time. Instead of watching scrolling terminal output, developers can see their AI agents (Claude Code, Codex, Gemini, etc.) working as robots in an immersive 3D workspace with desks, file locks, and collaboration features. The tool provides multi-agent sync mode, checkpoints for time-travel debugging, on-device memory, and one-tap approval for risky actions.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"meta-tag\">AI coding agent visualization</span>\n                            <span class=\"meta-source\">Product Hunt</span>\n                            <span class=\"meta-date\">2026-07-03</span>\n                        </div>\n                        <div class=\"community-quotes\">\n                            \"Giving CLI agents a literal body in a 3D room is a clever way to make what Claude Code / Codex are actually doing legible instead of scrolling terminal logs.\"\n                            <div class=\"quote-source\">— Community Feedback</div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Middle Column: Whitelist Updates -->\n            <section class=\"whitelist-updates\" id=\"updates\">\n                <div class=\"section-header\">\n                    <h2>Product Updates (8)</h2>\n                </div>\n                <div class=\"section-content\">\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://github.blog/changelog/2025-08-07-github-copilot-in-vs-code-july-release-v1-103/\" target=\"_blank\">GitHub Copilot - July 2025 Release (v1.103)</a>\n                        </div>\n                        <div class=\"item-description\">\n                            July 2025 update to GitHub Copilot in VS Code (v1.103) focusing on making chat and agent workflows more reliable and easier to manage. Features include chat checkpoints, improved UI, better terminal interactions, and experimental features like task lists in agent mode.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"meta-type\">release</span>\n                            <span class=\"meta-date\">2025-07-31</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://docs.devin.ai/release-notes/2025\" target=\"_blank\">Devin - Performance Optimizations</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Released updates on July 31, 2025, including performance optimizations with better database query optimization, more reliable codebase information retrieval retry mechanisms, and organization switcher search for superusers.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"meta-type\">release</span>\n                            <span class=\"meta-date\">2025-07-31</span>\n                        </div>\n                        <div class=\"community-quotes\">\n                            \"Cursor is kicking Devin's butt and is not even close.\"\n                            <div class=\"quote-source sentiment-negative\">— Answer.AI</div>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://cursor.com/changelog\" target=\"_blank\">Cursor - Critical Security Fix (CVE-2025-54135)</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Critical security vulnerability addressed in Cursor version 1.3. CVE-2025-54135 (CVSS 8.6 HIGH) allowed attackers to run malicious code. Required immediate installation.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"badge badge-security\">SECURITY</span>\n                            <span class=\"meta-type\">bugfix</span>\n                            <span class=\"meta-date\">2025-07-29</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://medium.com/@lmpo/the-evolution-of-claude-code-in-2025-a7355dcb7f70\" target=\"_blank\">Claude Code - Subagents Feature Launch</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Claude Code launched subagents feature, allowing the system to delegate tasks to specialized subagents instead of a single Claude handling everything. This marked a major evolution in capabilities, described as the point when 'Claude Code became truly powerful'.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"badge badge-feature\">FEATURE</span>\n                            <span class=\"meta-type\">feature</span>\n                            <span class=\"meta-date\">2025-07-24</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://ai.google.dev/gemini-api/docs/changelog\" target=\"_blank\">Gemini CLI - Gemini 2.5 Flash Lite Model</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Released gemini-2.5-flash-lite on July 22, 2025, a fast, low-cost, high-performance addition to the Gemini 2.5 model family.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"meta-type\">release</span>\n                            <span class=\"meta-date\">2025-07-22</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://github.blog/changelog/2025-08-07-github-copilot-in-vs-code-july-release-v1-103/\" target=\"_blank\">GitHub Copilot - New Chat Features GA</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Several new Copilot chat features became generally available on July 9, 2025, including instant previews, flexible editing, issue management, improved attachments, and model selection capabilities.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"badge badge-feature\">FEATURE</span>\n                            <span class=\"meta-type\">feature</span>\n                            <span class=\"meta-date\">2025-07-09</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://github.blog/changelog/2025-08-07-github-copilot-in-vs-code-july-release-v1-103/\" target=\"_blank\">GitHub Copilot - Agent Mode Expansion</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Agent mode reached general availability across multiple IDEs including JetBrains, Eclipse, and Xcode (previously available in VS Code). Agent mode is an autonomous AI agent that can research repositories, create plans, make code changes, and allow review of diffs.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"badge badge-feature\">FEATURE</span>\n                            <span class=\"meta-type\">feature</span>\n                            <span class=\"meta-date\">2025-07-09</span>\n                        </div>\n                        <div class=\"community-quotes\">\n                            \"GitHub Copilot's new agent mode is capable of iterating on its own code, recognizing errors, and fixing them automatically.\"\n                            <div class=\"quote-source sentiment-positive\">— Hacker News</div>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://www.claudelog.com/claude-code-changelog/\" target=\"_blank\">Claude Code - Version 0.39 Release</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Released Claude Code v0.39 with new Active Time metric in OpenTelemetry logging and Claude Code hooks for custom automation workflows.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"meta-type\">release</span>\n                            <span class=\"meta-date\">2025-07-02</span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Right Column: Technical Insights -->\n            <section class=\"technical-insights\" id=\"insights\">\n                <div class=\"section-header\">\n                    <h2>Technical Insights (5)</h2>\n                </div>\n                <div class=\"section-content\">\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://llm-stats.com/ai-news\" target=\"_blank\">Loop Engineering: Designing When AI Must Stop</a>\n                        </div>\n                        <div class=\"item-description\">\n                            A new engineering discipline emerged in July 2026 called 'Loop Engineering' — focused on 'designing when AI must stop' and managing hidden work around coding agents.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"badge badge-opinion\">OPINION</span>\n                            <span class=\"meta-date\">2026-07-10</span>\n                        </div>\n                        <div class=\"topics\">\n                            <span class=\"topic-tag\">Loop Engineering</span>\n                            <span class=\"topic-tag\">AI constraints</span>\n                            <span class=\"topic-tag\">agent management</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://openai.com/index/gpt-5-6/\" target=\"_blank\">OpenAI Launches GPT-5.6: Sol, Terra, and Luna Models</a>\n                        </div>\n                        <div class=\"item-description\">\n                            OpenAI released the GPT-5.6 model family in three sizes on July 9, 2026: Sol (flagship), Terra (balanced/agents), and Luna (efficient). GPT-5.6 Sol achieved state-of-the-art results with 92.2% on BrowseComp and 62.6% on OSWorld 2.0.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"badge badge-technical\">TECHNICAL</span>\n                            <span class=\"meta-date\">2026-07-09</span>\n                        </div>\n                        <div class=\"topics\">\n                            <span class=\"topic-tag\">GPT-5.6</span>\n                            <span class=\"topic-tag\">model release</span>\n                            <span class=\"topic-tag\">OpenAI</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://simonwillison.net/\" target=\"_blank\">Rewriting Bun in Rust using Agentic Engineering</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Jarred Sumner published a detailed account of rewriting Bun from Zig to Rust using modern coding agents. The rewrite took 11 days and cost $165,000 in API tokens (5.9B input, 690M output, 72B cached).\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"badge badge-technical\">TECHNICAL</span>\n                            <span class=\"meta-date\">2026-07-08</span>\n                        </div>\n                        <div class=\"topics\">\n                            <span class=\"topic-tag\">agentic engineering</span>\n                            <span class=\"topic-tag\">code rewriting</span>\n                            <span class=\"topic-tag\">Bun</span>\n                            <span class=\"topic-tag\">Rust</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://simonwillison.net/\" target=\"_blank\">Kenton Varda's Moratorium on AI-Written Change Descriptions</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Kenton Varda declared a moratorium against AI-written change descriptions (PR/commit messages, issues/tickets) from his team, stating that 'AI was writing change descriptions that were worse than useless to me as I tried to review PRs.'\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"badge badge-opinion\">OPINION</span>\n                            <span class=\"meta-date\">2026-07-08</span>\n                        </div>\n                        <div class=\"topics\">\n                            <span class=\"topic-tag\">AI limitations</span>\n                            <span class=\"topic-tag\">PR descriptions</span>\n                            <span class=\"topic-tag\">code review</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://simonwillison.net/\" target=\"_blank\">sqlite-utils 4.0rc2: Mostly Written by Claude Fable for $149.25</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Simon Willison used Claude Fable 5 to help get sqlite-utils 4.0 to a stable release, with Fable writing most of the code. The cost was approximately $149.25 for the work.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"badge badge-technical\">TECHNICAL</span>\n                            <span class=\"meta-date\">2026-07-05</span>\n                        </div>\n                        <div class=\"topics\">\n                            <span class=\"topic-tag\">Claude Fable</span>\n                            <span class=\"topic-tag\">cost analysis</span>\n                            <span class=\"topic-tag\">software maintenance</span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </main>\n\n    <footer>\n        <div class=\"footer-links\">\n            <a href=\"#\">Guidelines</a>\n            <a href=\"#\">FAQ</a>\n            <a href=\"#\">API</a>\n            <a href=\"#\">Legal</a>\n            <a href=\"#\">Contact</a>\n        </div>\n        <div>Agentic Coding Research Report - Compiled on 2026-07-12</div>\n        <div style=\"margin-top: 5px;\">Tracking the evolution of AI-powered development tools</div>\n    </footer>\n</body>\n</html>\n",
