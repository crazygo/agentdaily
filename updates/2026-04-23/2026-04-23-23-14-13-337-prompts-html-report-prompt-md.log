: 2px;\n        }\n\n        .author {\n            font-weight: bold;\n            color: #000000;\n        }\n\n        .source-link {\n            color: #828282;\n            font-size: 11px;\n        }\n\n        .section-count {\n            float: right;\n            font-size: 11px;\n            font-weight: normal;\n            color: #828282;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agentic Coding Research Report</h1>\n            <div class=\"subtitle\">April 23, 2026 | Daily updates on AI coding agents, tools, and insights</div>\n        </header>\n\n        <main class=\"three-column-layout\">\n            <!-- Left Column: New Products -->\n            <section class=\"new-products\">\n                <h2>New Products <span class=\"section-count\">7 items</span></h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.kimi.com/en\" target=\"_blank\">Kimi K2.6</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Open-source AI coding model with state-of-the-art coding, long-horizon execution (up to 13 hours), and agent swarm capabilities. Features include 4,000+ tool calls, multi-language support, and proactive agents.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-20</span>\n                        <span class=\"badge\">Open-source AI coding model</span>\n                        <span class=\"item-source\">Product Hunt, Official Blog</span>\n                    </div>\n                    <div class=\"community-quote\">\n                        \"K2.6 sets a new level for open-sourced models, especially in long-horizon, agent-style coding workflows\"\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/leaderboard/daily/2026/4/21\" target=\"_blank\">Chronicle</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Build Codex memories from recent screen context for AI agents.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-21</span>\n                        <span class=\"badge\">AI memory tool</span>\n                        <span class=\"item-source\">Product Hunt</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/leaderboard/daily/2026/4/21\" target=\"_blank\">Cosine Swarm</a>\n                    </div>\n                    <div class=\"item-description\">\n                        AI coding swarm agent (details limited due to access restrictions).\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-21</span>\n                        <span class=\"badge\">Code agent</span>\n                        <span class=\"item-source\">Product Hunt</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/dezgit2025/auto-memory\" target=\"_blank\">auto-memory</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Your AI coding agent never forgets — progressive session recall CLI that maintains context across sessions.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-21</span>\n                        <span class=\"badge\">AI memory tool</span>\n                        <span class=\"item-source\">GitHub</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/fdhhhdjd/Class-Production-AI-App\" target=\"_blank\">Class-Production-AI-App</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Production-ready AI app structure with RAG pipeline, hybrid search, self-correcting agents, 3-layer security, evaluation, observability & CI/CD.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-21</span>\n                        <span class=\"badge\">Workflow orchestration</span>\n                        <span class=\"item-source\">GitHub</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/cdervis/vscode-pi\" target=\"_blank\">vscode-pi</a>\n                    </div>\n                    <div class=\"item-description\">\n                        VS Code extension for the pi agent.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-14</span>\n                        <span class=\"badge\">IDE-integrated AI tool</span>\n                        <span class=\"item-source\">GitHub</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/hardness1020/Leeway\" target=\"_blank\">Leeway</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Agent workflow automation tool.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-10</span>\n                        <span class=\"badge\">Workflow automation</span>\n                        <span class=\"item-source\">GitHub</span>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Middle Column: Whitelist Updates -->\n            <section class=\"whitelist-updates\">\n                <h2>Whitelist Updates <span class=\"section-count\">18 items</span></h2>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">RELEASE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">C++ Code Intelligence for Copilot CLI in Public Preview</a>\n                    </div>\n                    <div class=\"item-description\">\n                        GitHub Copilot CLI now supports C++ code intelligence in public preview, expanding language support for command-line development workflows.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-22</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">FEATURE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">Bring Your Own Language Model Key in VS Code</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Users can now bring their own language model keys in VS Code, providing flexibility in model selection and usage.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-22</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">FEATURE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">Copilot Code Review User Counts in Usage Metrics API</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Copilot code review user counts now aggregate in usage metrics API, providing better telemetry for organizations.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-22</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">FEATURE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">CodeQL Supports Sanitizers and Validators in Models-as-Data</a>\n                    </div>\n                    <div class=\"item-description\">\n                        CodeQL now supports sanitizers and validators in models-as-data approach, enhancing security analysis capabilities.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-21</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">FEATURE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">Copilot CLI Now Supports Copilot Auto Model Selection</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Copilot CLI now supports automatic model selection, optimizing model choice based on the task context.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-17</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">FEATURE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">Manage Agent Skills with GitHub CLI</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Users can now manage agent skills using GitHub CLI, providing programmatic control over Copilot agent capabilities.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-16</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">RELEASE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">Claude Opus 4.7 Generally Available</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Claude Opus 4.7 is now generally available in GitHub Copilot, expanding model options for users.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-16</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">FEATURE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">Enable Copilot Cloud Agent via Custom Properties</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Organizations can now enable Copilot cloud agent via custom properties, providing more granular control over agent deployment.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-15</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">FEATURE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://cursor.com/changelog\" target=\"_blank\">Canvases - Interactive Visualizations</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Cursor can now respond by creating interactive canvases with dashboards and custom interfaces built using first-party components like tables, boxes, diagrams, and charts.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-15</span>\n                        <span class=\"item-source\">Cursor</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">FEATURE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://cursor.com/changelog\" target=\"_blank\">CLI Debug Mode and /btw Support</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Quality-of-life improvements to Cursor CLI including /debug for root cause analysis, /btw for side questions without derailing tasks, and /config for interactive settings panel.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-14</span>\n                        <span class=\"item-source\">Cursor</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">FEATURE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">Model Selection for Claude and Codex Agents on GitHub.com</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Model selection improvements for Claude and Codex agents on github.com, giving users more control over AI model choices.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-14</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">FEATURE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">Deployment Context in Repository Properties and Alerts</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Deployment context is now available in repository properties and alerts, improving security visibility for production deployments.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-14</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">FEATURE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">Link Code Scanning Alerts to GitHub Issues</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Code scanning alerts can now be linked to GitHub Issues, streamlining security vulnerability tracking and remediation.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-14</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">RELEASE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">Copilot Data Residency in US + EU and FedRAMP Compliance</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Copilot now offers data residency in US + EU and FedRAMP compliance, addressing enterprise data governance requirements.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-13</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">RELEASE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/\" target=\"_blank\">Remote Control CLI Sessions on Web and Mobile in Public Preview</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Remote control CLI sessions are now available in public preview on web and mobile, enabling flexible terminal access.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-13</span>\n                        <span class=\"item-source\">GitHub Copilot</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">RELEASE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://geminicli.com/docs/changelogs/\" target=\"_blank\">Version 0.38.0 - Chapters Narrative Flow and Context Compression</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Released April 14, 2026 featuring Chapters Narrative Flow for intent-based grouping, Context Compression Service, UI Flicker fixes with Terminal Buffer mode, and Persistent Policy Approvals.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-14</span>\n                        <span class=\"item-source\">Gemini CLI</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"update-type\">RELEASE</div>\n                    <div class=\"item-title\">\n                        <a href=\"https://geminicli.com/docs/changelogs/\" target=\"_blank\">Version 0.37.0 - Dynamic Sandbox Expansion and Advanced Browser Capabilities</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Released April 8, 2026 featuring dynamic sandbox expansion and worktree support, Chapters Narrative Flow for better session structure, and enhanced browser agent with persistent sessions.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-08</span>\n                        <span class=\"item-source\">Gemini CLI</span>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Right Column: Technical Insights -->\n            <section class=\"technical-insights\">\n                <h2>Technical Insights <span class=\"section-count\">12 items</span></h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" target=\"_blank\">Qwen3.6-27B: Flagship-Level Coding</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Alibaba's Qwen3.6-27B delivers flagship-level agentic coding performance, surpassing the previous-generation open-source flagship Qwen3.5-397B-A17B across all major coding benchmarks.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-22</span>\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"source-link\">Simon Willison</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">open-source LLMs</span>\n                        <span class=\"topic-tag\">local models</span>\n                        <span class=\"topic-tag\">Qwen</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" target=\"_blank\">Firefox 150 includes 271 vulnerability fixes found by Claude Mythos Preview</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Mozilla's CTO Bobby Holley shares their experience applying an early version of Claude Mythos Preview to Firefox, resulting in 271 vulnerability fixes.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-22</span>\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"source-link\">Bobby Holley</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">AI security</span>\n                        <span class=\"topic-tag\">Claude Mythos</span>\n                        <span class=\"topic-tag\">Firefox</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" target=\"_blank\">Changes to GitHub Copilot Individual plans</a>\n                    </div>\n                    <div class=\"item-description\">\n                        GitHub tightened Copilot usage limits, paused individual plan signups, and restricted Claude Opus 4.7 to the Pro+ plan.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-22</span>\n                        <span class=\"badge opinion\">Opinion</span>\n                        <span class=\"source-link\">Simon Willison</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">GitHub Copilot</span>\n                        <span class=\"topic-tag\">pricing</span>\n                        <span class=\"topic-tag\">compute costs</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" target=\"_blank\">Is Claude Code going to cost $100/month?</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Anthropic quietly updated their pricing page to add a $100/month Claude Code option, then reverted it. Analyzing the confusing state of Claude Code pricing.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-22</span>\n                        <span class=\"badge opinion\">Opinion</span>\n                        <span class=\"source-link\">Simon Willison</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">Claude Code</span>\n                        <span class=\"topic-tag\">pricing</span>\n                        <span class=\"topic-tag\">coding agents</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" target=\"_blank\">ChatGPT Images 2.0 released</a>\n                    </div>\n                    <div class=\"item-description\">\n                        OpenAI released ChatGPT Images 2.0, their latest image generation model. Sam Altman said the leap from gpt-image-1 to gpt-image-2 was equivalent to jumping from GPT-3 to GPT-5.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-21</span>\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"source-link\">Simon Willison</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">OpenAI</span>\n                        <span class=\"topic-tag\">image generation</span>\n                        <span class=\"topic-tag\">GPT-image-2</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" target=\"_blank\">llm-openrouter 0.6 released with model refresh</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Simon released llm-openrouter 0.6 with a new `llm openrouter refresh` command for refreshing the list of available models without waiting for cache to expire.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-20</span>\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"source-link\">Simon Willison</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">LLM tools</span>\n                        <span class=\"topic-tag\">OpenRouter</span>\n                        <span class=\"topic-tag\">Kimi</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" target=\"_blank\">Claude Token Counter upgraded with model comparisons</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Simon upgraded his Claude Token Counter tool to compare token counts between different models. Claude Opus 4.7's new tokenizer uses 1.46x the number of tokens as Opus 4.6.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-20</span>\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"source-link\">Simon Willison</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">Claude</span>\n                        <span class=\"topic-tag\">tokenization</span>\n                        <span class=\"topic-tag\">pricing</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" target=\"_blank\">Headless everything for personal AI</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Matt Webb and Marc Benioff discuss the rise of 'headless' services designed for AI agents rather than human GUI interaction. This trend could disrupt per-head SaaS pricing schemes.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-19</span>\n                        <span class=\"badge opinion\">Opinion</span>\n                        <span class=\"source-link\">Simon Willison</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">AI agents</span>\n                        <span class=\"topic-tag\">APIs</span>\n                        <span class=\"topic-tag\">SaaS pricing</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" target=\"_blank\">Changes in the system prompt between Claude Opus 4.6 and 4.7</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Anthropic published their system prompts for Claude chat, enabling analysis of how the system prompt evolves. Simon examines the differences between Opus 4.6 and 4.7.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-18</span>\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"source-link\">Simon Willison</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">Claude</span>\n                        <span class=\"topic-tag\">system prompts</span>\n                        <span class=\"topic-tag\">Anthropic</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" target=\"_blank\">PyCon US 2026 in Long Beach with new AI and security tracks</a>\n                    </div>\n                    <div class=\"item-description\">\n                        PyCon US 2026 is coming May 13-19 in Long Beach, California, featuring new AI and security tracks this year.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-17</span>\n                        <span class=\"badge announcement\">Announcement</span>\n                        <span class=\"source-link\">Simon Willison</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">PyCon</span>\n                        <span class=\"topic-tag\">Python</span>\n                        <span class=\"topic-tag\">AI</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\" target=\"_blank\">Qwen3.6-35B-A3B vs Claude Opus 4.7 - Pelican benchmark</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Simon compared pelican-drawing capabilities between Alibaba's Qwen3.6-35B-A3B and Anthropic's Claude Opus 4.7, finding that the local Qwen model drew a better pelican.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-16</span>\n                        <span class=\"badge technical\">Technical</span>\n                        <span class=\"source-link\">Simon Willison</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">Qwen</span>\n                        <span class=\"topic-tag\">Claude</span>\n                        <span class=\"topic-tag\">local LLMs</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://x.com/karpathy\" target=\"_blank\">Claude Code and LLM Agents - Practical Coding Experience</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Andrej Karpathy discusses Claude Code as 'the first convincing demonstration of what an LLM Agent looks like' that lives on your computer.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"item-date\">2026-04-16</span>\n                        <span class=\"badge opinion\">Opinion</span>\n                        <span class=\"source-link\">Andrej Karpathy</span>\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic-tag\">LLM agents</span>\n                        <span class=\"topic-tag\">Claude Code</span>\n                        <span class=\"topic-tag\">AI-assisted coding</span>\n                    </div>\n                </div>\n            </section>\n        </main>\n\n        <footer>\n            <p>\n                <strong>Agent Code Daily</strong> — Powered by <a href=\"https://claude.com/claude-code\" target=\"_blank\">Claude Agent SDK</a> |\n                <a href=\"https://github.com/agentdaily\" target=\"_blank\">GitHub</a> |\n                Generated: 2026-04-23\n            </p>\n            <p style=\"margin-top: 5px; font-size: 10px;\">\n                Curated daily updates on agentic coding tools, AI development platforms, and technical insights from industry leaders\n            </p>\n        </footer>\n    </div>\n</body>\n</html>",
