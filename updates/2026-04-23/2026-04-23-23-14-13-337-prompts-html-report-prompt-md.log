        }\n\n        section h2 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 14px;\n            font-weight: bold;\n            color: #000000;\n            margin-bottom: 12px;\n            padding-bottom: 6px;\n            border-bottom: 1px solid #ff6600;\n        }\n\n        .item {\n            margin-bottom: 12px;\n            padding-bottom: 10px;\n            border-bottom: 1px dotted #d4d4d4;\n        }\n\n        .item:last-child {\n            border-bottom: none;\n            margin-bottom: 0;\n            padding-bottom: 0;\n        }\n\n        .item-title {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 13px;\n            font-weight: bold;\n            margin-bottom: 4px;\n        }\n\n        .item-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .item-title a:visited {\n            color: #828282;\n        }\n\n        .item-title a:hover {\n            text-decoration: underline;\n        }\n\n        .item-description {\n            font-size: 12px;\n            color: #000000;\n            margin-bottom: 4px;\n            line-height: 1.4;\n        }\n\n        .item-meta {\n            font-size: 11px;\n            color: #828282;\n        }\n\n        .item-date {\n            display: inline-block;\n            margin-right: 10px;\n        }\n\n        .item-source {\n            display: inline-block;\n        }\n\n        .badge {\n            display: inline-block;\n            padding: 2px 6px;\n            font-size: 10px;\n            font-weight: bold;\n            color: #ffffff;\n            background-color: #ff6600;\n            border-radius: 2px;\n            margin-right: 4px;\n        }\n\n        .badge.release {\n            background-color: #006600;\n        }\n\n        .badge.feature {\n            background-color: #0066cc;\n        }\n\n        .badge.opinion {\n            background-color: #9900cc;\n 