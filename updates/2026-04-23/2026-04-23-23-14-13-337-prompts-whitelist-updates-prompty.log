ame\": \"Gemini CLI\",\n    \"title\": \"Version 0.37.0 - Dynamic Sandbox Expansion and Advanced Browser Capabilities\",\n    \"description\": \"Released April 8, 2026 featuring dynamic sandbox expansion and worktree support, Chapters Narrative Flow for better session structure, and enhanced browser agent with persistent sessions.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-04-08\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot CLI Now Supports BYOK and Local Models\",\n    \"description\": \"Copilot CLI now supports Bring Your Own Key (BYOK) and local models, giving developers flexibility in model deployment and cost management.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-04-07\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Organization Runner Controls for Copilot Cloud Agent\",\n    \"description\": \"Organizations can now control runners for Copilot cloud agent, providing better resource management and security controls.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-04-03\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot SDK in Public Preview\",\n    \"description\": \"GitHub Copilot SDK is now in public preview, enabling developers to build custom integrations and extensions.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-04-02\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GPT-5.4 Mini in Copilot Student Auto Model Selection\",\n    \"description\": \"GPT-5.4 mini is now available in Copilot Student auto model selection, providing more efficient model options for educational users.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-04-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Research, Plan, and Code with Copilot Cloud Agent\",\n    \"description\": \"Copilot cloud agent can now research, plan, and code with improved capabilities. Remote control CLI sessions available in public preview on web and mobile.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-04-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Canvases - Interactive Visualizations\",\n    \"description\": \"Cursor can now respond by creating interactive canvases with dashboards and custom interfaces built using first-party components like tables, boxes, diagrams, and charts. Canvases are durable artifacts in the Agents Window side panel.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"CLI Debug Mode and /btw Support\",\n    \"description\": \"Quality-of-life improvements to Cursor CLI including /debug for root cause analysis, /btw for side questions without derailing tasks, and /config for interactive settings panel.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-14\",\n    \"community_feedback\": []\n  }\n]"
