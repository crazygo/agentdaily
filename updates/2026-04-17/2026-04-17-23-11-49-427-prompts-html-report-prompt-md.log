  382→            a {\n   383→                text-decoration: underline;\n   384→            }\n   385→        }\n   386→    </style>\n   387→</head>\n   388→<body>\n   389→    <header>\n   390→        <div class=\"header-content\">\n   391→            <div class=\"header-title\">AgentDaily - Agentic Coding Research Report</div>\n   392→            <div class=\"header-date\">2026-04-17</div>\n   393→            <nav class=\"header-nav\">\n   394→                <a href=\"#new-products\">New Products</a>\n   395→                <a href=\"#whitelist-updates\">Updates</a>\n   396→                <a href=\"#technical-insights\">Insights</a>\n   397→            </nav>\n   398→        </div>\n   399→    </header>\n   400→\n   401→    <main>\n   402→        <div class=\"three-column-layout\">\n   403→            <section class=\"new-products\" id=\"new-products\">\n   404→                <div class=\"section-header\">New Products (2)</div>\n   405→\n   406→                <div class=\"item\">\n   407→                    <div class=\"item-title\">\n   408→                        <a href=\"https://github.com/microsoft/agent-governance-toolkit\" target=\"_blank\" rel=\"noopener\">Microsoft Agent Governance Toolkit</a>\n   409→                        <span class=\"source-badge\">GitHub</span>\n   410→                    </div>\n   411→                    <div class=\"item-description\">\n   412→                        Open-source seven-package governance system for autonomous AI agents. Provides sub-millisecond policy engine, cryptographic agent identities, runtime isolation, and compliance automation mapped to EU AI Act, HIPAA, and SOC2.\n   413→                    </div>\n   414→                    <div class=\"item-meta\">\n   415→                        Released: 2026-04-03 | Category: Open-source AI coding agent\n   416→                    </div>\n   417→                    <div class=\"quotes\">\n   418→                        <ul>\n   419→                            <l