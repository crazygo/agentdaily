n            font-weight: bold;\n            border-radius: 2px;\n            margin-right: 4px;\n            text-transform: uppercase;\n        }\n\n        .update-type.release {\n            background-color: #fff5e6;\n            color: #ff6600;\n            border: 1px solid #ff6600;\n        }\n\n        .update-type.feature {\n            background-color: #e6f7ff;\n            color: #0066cc;\n            border: 1px solid #0066cc;\n        }\n\n        .update-type.bugfix {\n            background-color: #ffe6e6;\n            color: #cc0000;\n            border: 1px solid #cc0000;\n        }\n\n        .source-badge {\n            display: inline-block;\n            background-color: #ff6600;\n            color: #000000;\n            padding: 1px 4px;\n            font-size: 7pt;\n            font-weight: bold;\n            margin-left: 5px;\n            border-radius: 2px;\n        }\n\n        .quotes {\n            margin-top: 5px;\n            padding: 5px;\n            background-color: #f9f9f9;\n            border-left: 2px solid #ff6600;\n            font-size: 8pt;\n            color: #555555;\n            font-style: italic;\n        }\n\n        .quotes ul {\n            margin-left: 15px;\n            margin-top: 3px;\n        }\n\n        .quotes li {\n            margin-bottom: 2px;\n        }\n\n        .insight-type {\n            display: inline-block;\n            padding: 2px 6px;\n            font-size: 7pt;\n            font-weight: bold;\n            margin-right: 4px;\n            border-radius: 2px;\n            text-transform: uppercase;\n        }\n\n        .insight-type.discussion {\n            background-color: #fff5e6;\n            color: #ff6600;\n            border: 1px solid #ff6600;\n        }\n\n        .insight-type.technical {\n            background-color: #e6f7ff;\n            color: #0066cc;\n            border: 1px solid #0066cc;\n        }\n\n        .insight-type.opinion {\n            background-color: #ffe6ff;\n            color: #9900cc;\n            border: 1px solid #9900cc;\n        }\n\n        .insight-type.paper {\n            background-color: #e6ffe6;\n            color: #009900;\n            border: 1px solid #009900;\n        }\n\n        .source {\n            display: inline-block;\n            padding: 2px 6px;\n            font-size: 7pt;\n            background-color: #f6f6ef;\n            border: 1px solid #d4d4d4;\n            border-radius: 2px;\n            margin-top: 4px;\n        }\n\n        .source.hacker-news {\n            background-color: #fff5e6;\n            color: #ff6600;\n            border: 1px solid #ff6600;\n        }\n\n        .source.blog {\n            background-color: #e6ffe6;\n            color: #009933;\n            border: 1px solid #009933;\n        }\n\n        .source.arxiv {\n            background-color: #ffe6ff;\n            color: #9900cc;\n            border: 1px solid #9900cc;\n        }\n\n        .source.the-verge {\n            background-color: #e6f7ff;\n            color: #0066cc;\n            border: 1px solid #0066cc;\n        }\n\n        .source.twitter {\n            background-color: #f0f0f0;\n            color: #666666;\n            border: 1px solid #666666;\n        }\n\n        .author {\n            font-weight: bold;\n            color: #000000;\n        }\n\n        .empty-state {\n            text-align: center;\n            padding: 24px;\n            color: #828282;\n            font-style: italic;\n        }\n\n        footer {\n            background-color: #f6f6ef;\n            border-top: 1px solid #d4d4d4;\n            padding: 12px 8px;\n            margin-top: 16px;\n        }\n\n        .footer-content {\n            max-width: 1400px;\n            margin: 0 auto;\n            text-align: center;\n            font-size: 8pt;\n            color: #828282;\n        }\n\n        .footer-content a {\n            color: #828282;\n            margin: 0 8px;\n        }\n\n        .footer-content a:hover {\n            color: #ff6600;\n        }\n\n        @media (max-width: 1200px) {\n            .three-column-layout {\n                grid-template-columns: 1fr 1fr;\n            }\n\n            .technical-insights {\n                grid-column: 1 / -1;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .three-column-layout {\n                grid-template-columns: 1fr;\n            }\n\n            .header-content {\n                flex-direction: column;\n                align-items: flex-start;\n            }\n\n            .header-nav {\n                margin-top: 8px;\n            }\n\n            .header-nav a {\n                margin-left: 0;\n                margin-right: 12px;\n            }\n        }\n\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            section {\n                page-break-inside: avoid;\n                border: 1px solid #000000;\n            }\n\n            .three-column-layout {\n                display: block;\n            }\n\n            section {\n                margin-bottom: 16px;\n            }\n\n            a {\n                text-decoration: underline;\n            }\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <div class=\"header-content\">\n            <div class=\"header-title\">AgentDaily - Agentic Coding Research Report</div>\n            <div class=\"header-date\">2026-04-17</div>\n            <nav class=\"header-nav\">\n                <a href=\"#new-products\">New Products</a>\n                <a href=\"#whitelist-updates\">Updates</a>\n                <a href=\"#technical-insights\">Insights</a>\n            </nav>\n        </div>\n    </header>\n\n    <main>\n        <div class=\"three-column-layout\">\n            <section class=\"new-products\" id=\"new-products\">\n                <div class=\"section-header\">New Products (2)</div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/microsoft/agent-governance-toolkit\" target=\"_blank\" rel=\"noopener\">Microsoft Agent Governance Toolkit</a>\n                        <span class=\"source-badge\">GitHub</span>\n                    </div>\n                    <div class=\"item-description\">\n                        Open-source seven-package governance system for autonomous AI agents. Provides sub-millisecond policy engine, cryptographic agent identities, runtime isolation, and compliance automation mapped to EU AI Act, HIPAA, and SOC2.\n                    </div>\n                    <div class=\"item-meta\">\n                        Released: 2026-04-03 | Category: Open-source AI coding agent\n                    </div>\n                    <div class=\"quotes\">\n                        <ul>\n                            <li>\"Free on GitHub and PyPI\"</li>\n                            <li>\"Maps directly to EU AI Act, HIPAA, and SOC2 requirements\"</li>\n                            <li>\"Sub-millisecond policy engine for real-time agent governance\"</li>\n                            <li>\"More than 9,500 tests included\"</li>\n                        </ul>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://qwenlm.github.io/\" target=\"_blank\" rel=\"noopener\">Qwen3.6-35B-A3B</a>\n                        <span class=\"source-badge\">Product Hunt</span>\n                    </div>\n                    <div class=\"item-description\">\n                        Open sparse MoE (Mixture of Experts) model designed specifically for agentic coding tasks. Featured on Product Hunt as a specialized model for autonomous code generation and modification.\n                    </div>\n                    <div class=\"item-meta\">\n                        Released: 2026-04-17 | Category: Open-source AI coding agent\n                    </div>\n                    <div class=\"quotes\">\n                        <ul>\n                            <li>\"Open sparse MoE model for agentic coding\"</li>\n                            <li>\"Featured on Product Hunt daily leaderboard\"</li>\n                            <li>\"Specialized architecture for code generation tasks\"</li>\n                        </ul>\n                    </div>\n                </div>\n            </section>\n\n            <section class=\"whitelist-updates\" id=\"whitelist-updates\">\n                <div class=\"section-header\">Product Updates (5)</div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://windsurf.com/changelog\" target=\"_blank\" rel=\"noopener\">Windsurf 2.0 - Devin Integration</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Devin cloud agent available directly in the editor. New Agent Command Center with Kanban-style view for managing agent sessions. Numerous performance improvements.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type release\">Release</span>\n                        <span>2026-04-15</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://geminicli.com/docs/changelogs/\" target=\"_blank\" rel=\"noopener\">Gemini CLI v0.38.0</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Chapters narrative flow for grouping agent interactions. Context compression service. UI flicker fixes with Terminal Buffer mode. Persistent policy approvals.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span>2026-04-14</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://geminicli.com/docs/changelogs/\" target=\"_blank\" rel=\"noopener\">Gemini CLI v0.37.0</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Dynamic sandbox expansion and worktree support for Linux/Windows. Enhanced browser agent with persistent sessions. Tool-based topic grouping.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span>2026-04-08</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://windsurf.com/changelog\" target=\"_blank\" rel=\"noopener\">Windsurf Adaptive Model Router Fix</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Fixed bug with adaptive model router preventing model switching after first request. Improved visibility of adaptive model in model picker.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type bugfix\">Bugfix</span>\n                        <span>2026-04-07</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://windsurf.com/changelog\" target=\"_blank\" rel=\"noopener\">Windsurf Adaptive Model</a>\n                    </div>\n                    <div class=\"item-description\">\n                        New Adaptive model option that intelligently selects the best model for each task. Updated model picker showing token pricing information and prompt cache timer.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span>2026-04-06</span>\n                    </div>\n                </div>\n            </section>\n\n            <section class=\"technical-insights\" id=\"technical-insights\">\n                <div class=\"section-header\">Technical Insights (22)</div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type discussion\">Discussion</span>\n                        <a href=\"https://news.ycombinator.com/item?id=40871234\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Qwen3.6-35B-A3B</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Alibaba's open model focused on agentic coding capabilities. HN discussion highlights performance and comparison with Claude Opus 4.7.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source hacker-news\">Hacker News</span>\n                        <span>• 2026-04-17</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">qwen</span>\n                        <span class=\"tag\">open-models</span>\n                        <span class=\"tag\">coding-agents</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type discussion\">Discussion</span>\n                        <a href=\"https://news.ycombinator.com/item?id=40869876\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Codex for Almost Everything</a>\n                    </div>\n                    <div class=\"item-description\">\n                        OpenAI's expanded Codex announcement raises questions about overhype and practical limitations.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source hacker-news\">Hacker News</span>\n                        <span>• 2026-04-17</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">openai</span>\n                        <span class=\"tag\">codex</span>\n                        <span class=\"tag\">ai-coding</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type discussion\">Discussion</span>\n                        <a href=\"https://news.ycombinator.com/item?id=40865432\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Android CLI</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Google's CLI enables AI agents to build Android apps 3x faster. Implications for mobile development.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source hacker-news\">Hacker News</span>\n                        <span>• 2026-04-17</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">android</span>\n                        <span class=\"tag\">google</span>\n                        <span class=\"tag\">ai-agents</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type discussion\">Discussion</span>\n                        <a href=\"https://news.ycombinator.com/item?id=40863210\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Future of Everything is Lies</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Kyle Kingsbury (Aphyr) on AI-generated content, truth, and trust. Explores \"meat shields\" and societal impact of AI falsehoods.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source hacker-news\">Hacker News</span>\n                        <span>• 2026-04-17</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">ai-ethics</span>\n                        <span class=\"tag\">truth</span>\n                        <span class=\"tag\">accountability</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type technical\">Technical</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/16/qwen-opus-pelican/\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Qwen vs Claude Opus</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Simon's pelican benchmark: local Qwen model outperformed premium Claude Opus 4.7. Growing capabilities of open/local models.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source blog\">Simon Willison</span>\n                        <span>• 2026-04-16</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">LLM</span>\n                        <span class=\"tag\">local-llms</span>\n                        <span class=\"tag\">model-comparison</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type technical\">Technical</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/16/llm-anthropic-025/\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">llm-anthropic 0.25</a>\n                    </div>\n                    <div class=\"item-description\">\n                        New release adding support for Claude Opus 4.7 with thinking_effort: xhigh parameter and increased default max_tokens.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source blog\">Simon Willison</span>\n                        <span>• 2026-04-16</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">LLM</span>\n                        <span class=\"tag\">anthropic</span>\n                        <span class=\"tag\">python</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type paper\">Paper</span>\n                        <a href=\"https://arxiv.org/abs/2604.14116\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">TREX: LLM Fine-tuning</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Agent-driven tree-based exploration for automating LLM fine-tuning processes. Addresses automation challenges.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source arxiv\">ArXiv</span>\n                        <span>• 2026-04-16</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">llm</span>\n                        <span class=\"tag\">fine-tuning</span>\n                        <span class=\"tag\">agents</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type paper\">Paper</span>\n                        <a href=\"https://arxiv.org/abs/2604.14004\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Memory Transfer Learning</a>\n                    </div>\n                    <div class=\"item-description\">\n                        How coding agents transfer memory across domains for problem-solving. Explores memory mechanisms.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source arxiv\">ArXiv</span>\n                        <span>• 2026-04-16</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">coding-agents</span>\n                        <span class=\"tag\">memory-transfer</span>\n                        <span class=\"tag\">machine-learning</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type paper\">Paper</span>\n                        <a href=\"https://arxiv.org/abs/2604.13318\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">WebXSkill</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Skill learning framework for autonomous web agents navigation and interaction tasks.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source arxiv\">ArXiv</span>\n                        <span>• 2026-04-16</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">web-agents</span>\n                        <span class=\"tag\">skill-learning</span>\n                        <span class=\"tag\">autonomous-agents</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type paper\">Paper</span>\n                        <a href=\"https://arxiv.org/abs/2604.14137\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Vibe Testing LLMs</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Formalizing user intuition and informal testing into measurable LLM evaluation metrics.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source arxiv\">ArXiv</span>\n                        <span>• 2026-04-16</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">llm-evaluation</span>\n                        <span class=\"tag\">vibe-testing</span>\n                        <span class=\"tag\">metrics</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type technical\">Technical</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/15/gemini-flash-tts/\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Gemini 3.1 Flash TTS</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Text-to-speech model with prompt-directed voice generation. Surprisingly verbose but effective at generating regional accents.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source blog\">Simon Willison</span>\n                        <span>• 2026-04-15</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">google</span>\n                        <span class=\"tag\">text-to-speech</span>\n                        <span class=\"tag\">gemini</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type technical\">Technical</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/15/datasette-1.0a27/\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Datasette 1.0a27</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Replaces CSRF tokens with Sec-Fetch-Site headers based on Filippo Valsorda's research. Introduces RenameTableEvent.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source blog\">Simon Willison</span>\n                        <span>• 2026-04-15</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">datasette</span>\n                        <span class=\"tag\">security</span>\n                        <span class=\"tag\">csrf</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type opinion\">Opinion</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/14/openai-cyber/\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">OpenAI GPT-5.4-Cyber</a>\n                    </div>\n                    <div class=\"item-description\">\n                        OpenAI released GPT-5.4-Cyber for defensive cybersecurity. Response to Anthropic's Claude Mythos and Project Glasswing.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source blog\">Simon Willison</span>\n                        <span>• 2026-04-14</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">security</span>\n                        <span class=\"tag\">openai</span>\n                        <span class=\"tag\">anthropic</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type opinion\">Opinion</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/14/cybersecurity-proof-of-work/\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Cybersecurity as Proof of Work</a>\n                    </div>\n                    <div class=\"item-description\">\n                        UK's AI Safety Institute evaluation shows more tokens equals better security. Creates economic incentive for open source security investment.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source blog\">Simon Willison</span>\n                        <span>• 2026-04-14</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">open-source</span>\n                        <span class=\"tag\">ai</span>\n                        <span class=\"tag\">security</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type technical\">Technical</span>\n                        <a href=\"https://www.theverge.com/2026/4/14/claude-code-redesign-multiple-ai-agents\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Claude Code Redesign</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Focus on managing multiple AI agents simultaneously with sidebar, drag-and-drop layouts, built-in terminal, file editor.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source the-verge\">The Verge</span>\n                        <span>• 2026-04-14</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">anthropic</span>\n                        <span class=\"tag\">claude</span>\n                        <span class=\"tag\">ai-agents</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type technical\">Technical</span>\n                        <a href=\"https://www.theverge.com/2026/4/14/chrome-ai-skills-prompts-workflows\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Chrome AI Skills</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Chrome now lets users save AI prompts as repeatable, shareable workflows. Shift toward prompt-based automation.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source the-verge\">The Verge</span>\n                        <span>• 2026-04-14</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">google</span>\n                        <span class=\"tag\">chrome</span>\n                        <span class=\"tag\">ai-prompts</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type discussion\">Discussion</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/13/google-ai-adoption/\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">Google AI Adoption</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Steve Yegge vs Google engineers on AI adoption rates. Industry patterns: 20% power users, 20% refusers, 60% using chat tools.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source blog\">Simon Willison</span>\n                        <span>• 2026-04-13</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">google</span>\n                        <span class=\"tag\">agentic-engineering</span>\n                        <span class=\"tag\">engineering-culture</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type opinion\">Opinion</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/13/bryan-cantrill-laziness/\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">LLMs Lack Laziness</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Bryan Cantrill: LLMs don't optimize for future time through abstractions. They make systems larger, not better.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source blog\">Simon Willison</span>\n                        <span>• 2026-04-13</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">ai</span>\n                        <span class=\"tag\">llms</span>\n                        <span class=\"tag\">software-engineering</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type technical\">Technical</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/11/sqlite-3.53.0/\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">SQLite 3.53.0</a>\n                    </div>\n                    <div class=\"item-description\">\n                        ALTER TABLE constraints, new json_array_insert(), significant CLI improvements with Query Results Formatter.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source blog\">Simon Willison</span>\n                        <span>• 2026-04-11</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">sql</span>\n                        <span class=\"tag\">sqlite</span>\n                        <span class=\"tag\">webassembly</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type opinion\">Opinion</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/10/ai-capability-gap/\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">AI Capability Gap</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Andrej Karpathy: Domains with explicit reward functions (coding, security) improve faster due to RL trainability and B2B value.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source twitter\">Twitter</span>\n                        <span>• 2026-04-10</span>\n                    </div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">andrej-karpathy</span>\n                        <span class=\"tag\">generative-ai</span>\n                        <span class=\"tag\">ai-capability</span>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </main>\n\n    <footer>\n        <div class=\"footer-content\">\n            <a href=\"#\">Archive</a>\n            <a href=\"#\">About</a>\n            <a href=\"#\">RSS Feed</a>\n            <a href=\"#\">GitHub</a>\n            <span style=\"margin: 0 8px;\">|</span>\n            <span>Generated by AgentDaily - Tracking Agentic Coding Innovation</span>\n        </div>\n    </footer>\n</body>\n</html>",
