;\n            font-weight: bold;\n            border-radius: 2px;\n            margin-right: 4px;\n            text-transform: uppercase;\n        }\n\n        .update-type.release {\n            background-color: #fff5e6;\n            color: #ff6600;\n            border: 1px solid #ff6600;\n        }\n\n        .update-type.feature {\n            background-color: #e6f7ff;\n            color: #0066cc;\n            border: 1px solid #0066cc;\n        }\n\n        .update-type.bugfix {\n            background-color: #ffe6e6;\n            color: #cc0000;\n            border: 1px solid #cc0000;\n        }\n\n        .source {\n            display: inline-block;\n            padding: 2px 6px;\n            font-size: 7pt;\n            background-color: #f6f6ef;\n            border: 1px solid #d4d4d4;\n            border-radius: 2px;\n            margin-top: 4px;\n        }\n\n        .source.hacker-news {\n            background-color: #fff5e6;\n            color: #ff6600;\n            border: 1px solid #ff6600;\n        }\n\n        .source.blog {\n            background-color: #e6ffe6;\n            color: #009933;\n            border: 1px solid #009933;\n        }\n\n        .source.arxiv {\n            background-color: #ffe6ff;\n            color: #9900cc;\n            border: 1px solid #9900cc;\n        }\n\n        .source.the-verge {\n            background-color: #e6f7ff;\n            color: #0066cc;\n            border: 1px solid #0066cc;\n        }\n\n        .source.twitter {\n            background-color: #f0f0f0;\n            color: #666666;\n            border: 1px solid #666666;\n        }\n\n        .empty-state {\n            text-align: center;\n            padding: 24px;\n            color: #828282;\n            font-style: italic;\n        }\n\n        footer {\n            background-color: #f6f6ef;\n            border-top: 1px solid #d4d4d4;\n            padding: 12px 8px;\n            margin-top: 16px;\n        }\n\n        .footer-content {\n    