;\n            padding-bottom: 10px;\n            border-bottom: 1px dotted #d4d4d4;\n        }\n\n        .item:last-child {\n            border-bottom: none;\n            margin-bottom: 0;\n            padding-bottom: 0;\n        }\n\n        .item-title {\n            font-size: 10pt;\n            font-weight: bold;\n            margin-bottom: 5px;\n        }\n\n        .item-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .item-title a:visited {\n            color: #828282;\n        }\n\n        .item-title a:hover {\n            text-decoration: underline;\n        }\n\n        .item-description {\n            font-size: 9pt;\n            color: #000000;\n            margin-bottom: 5px;\n            line-height: 1.5;\n        }\n\n        .item-meta {\n            font-size: 8pt;\n            color: #828282;\n        }\n\n        .tag {\n            display: inline-block;\n            background-color: #f6f6ef;\n            color: #828282;\n            padding: 2px 6px;\n            margin: 2px;\n            font-size: 8pt;\n            border: 1px solid #d4d4d4;\n            border-radius: 2px;\n        }\n\n        .source-badge {\n            display: inline-block;\n            background-color: #ff6600;\n            color: #000000;\n            padding: 1px 4px;\n            font-size: 7pt;\n            font-weight: bold;\n            margin-left: 5px;\n            border-radius: 2px;\n        }\n\n        .update-type {\n            display: inline-block;\n            padding: 2px 6px;\n            font-size: 7pt;\n            font-weight: bold;\n            margin-right: 5px;\n            border-radius: 2px;\n            text-transform: uppercase;\n        }\n\n        .update-type.release {\n            background-color: #ff6600;\n            color: #000000;\n        }\n\n        .update-type.feature {\n            background-color: #0066cc;\n            color: #ffffff;\n        }\n\n        .update-type.bugfix {\n            background-color: #999999;\n            color: #ffffff;\n        }\n\n        .quotes {\n            margin-top: 5px;\n            padding: 5px;\n            background-color: #f9f9f9;\n            border-left: 2px solid #ff6600;\n            font-size: 8pt;\n            color: #555555;\n            font-style: italic;\n        }\n\n        .quotes ul {\n            margin-left: 15px;\n            margin-top: 3px;\n        }\n\n        .quotes li {\n            margin-bottom: 2px;\n        }\n\n        .insight-type {\n            display: inline-block;\n            padding: 2px 6px;\n            font-size: 7pt;\n            font-weight: bold;\n            margin-right: 5px;\n            border-radius: 2px;\n            text-transform: uppercase;\n        }\n\n        .insight-type.discussion {\n            background-color: #ff6600;\n            color: #000000;\n        }\n\n        .insight-type.technical {\n            background-color: #0066cc;\n            color: #ffffff;\n        }\n\n        .insight-type.opinion {\n            background-color: #9900cc;\n            color: #ffffff;\n        }\n\n        .insight-type.paper {\n            background-color: #009900;\n            color: #ffffff;\n        }\n\n        footer {\n            text-align: center;\n            padding: 15px 10px;\n            border-top: 1px solid #d4d4d4;\n            color: #828282;\n            font-size: 8pt;\n        }\n\n        footer a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n        }\n\n        .nav-links {\n            margin-bottom: 10px;\n        }\n\n        .nav-links a {\n            margin: 0 10px;\n            color: #828282;\n            text-decoration: none;\n        }\n\n        .nav-links a:hover {\n            text-decoration: underline;\n        }\n\n        .scroll-to-top {\n            position: fixed;\n            bottom: 20px;\n            right: 20px;\n            background-color: #ff6600;\n            color: #000000;\n            padding: 8px 12px;\n            border: none;\n            border-radius: 3px;\n            cursor: pointer;\n            font-size: 8pt;\n            font-weight: bold;\n            display: none;\n        }\n\n        .scroll-to-top:hover {\n            background-color: #ff5500;\n        }\n\n        @media print {\n            .scroll-to-top {\n                display: none;\n            }\n\n            section {\n                page-break-inside: avoid;\n            }\n\n            .item {\n                page-break-inside: avoid;\n            }\n        }\n\n        .empty-state {\n            font-style: italic;\n            color: #828282;\n            text-align: center;\n            padding: 20px;\n        }\n\n        .topics {\n            margin-top: 5px;\n        }\n\n        .author {\n            font-weight: bold;\n            color: #000000;\n        }\n\n        .insight-link {\n            font-size: 8pt;\n            color: #828282;\n            margin-top: 3px;\n        }\n\n        .insight-link a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        .insight-link a:hover {\n            text-decoration: underline;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agentic Coding Daily Research Report</h1>\n            <div class=\"date\">2026-04-17</div>\n        </header>\n\n        <main class=\"three-column-layout\">\n            <!-- New Products Section -->\n            <section class=\"new-products\">\n                <h2>New Products (2)</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/microsoft/agent-governance-toolkit\" target=\"_blank\">Microsoft Agent Governance Toolkit</a>\n                        <span class=\"source-badge\">GitHub</span>\n                    </div>\n                    <div class=\"item-description\">\n                        An open-source seven-package governance system for autonomous AI agents. Provides sub-millisecond policy engine, cryptographic agent identities, runtime isolation, and compliance automation mapped to EU AI Act, HIPAA, and SOC2.\n                    </div>\n                    <div class=\"item-meta\">\n                        Released: 2026-04-03 | Category: Open-source AI coding agent\n                    </div>\n                    <div class=\"quotes\">\n                        <ul>\n                            <li>\"Free on GitHub and PyPI\"</li>\n                            <li>\"Maps directly to EU AI Act, HIPAA, and SOC2 requirements\"</li>\n                            <li>\"Sub-millisecond policy engine for real-time agent governance\"</li>\n                            <li>\"More than 9,500 tests included\"</li>\n                        </ul>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://qwenlm.github.io/\" target=\"_blank\">Qwen3.6-35B-A3B</a>\n                        <span class=\"source-badge\">Product Hunt</span>\n                    </div>\n                    <div class=\"item-description\">\n                        An open sparse MoE (Mixture of Experts) model designed specifically for agentic coding tasks. Featured on Product Hunt as a specialized model for autonomous code generation and modification.\n                    </div>\n                    <div class=\"item-meta\">\n                        Released: 2026-04-17 | Category: Open-source AI coding agent\n                    </div>\n                    <div class=\"quotes\">\n                        <ul>\n                            <li>\"Open sparse MoE model for agentic coding\"</li>\n                            <li>\"Featured on Product Hunt daily leaderboard\"</li>\n                            <li>\"Specialized architecture for code generation tasks\"</li>\n                        </ul>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Whitelist Updates Section -->\n            <section class=\"whitelist-updates\">\n                <h2>Product Updates (5)</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type release\">Release</span>\n                        Windsurf 2.0\n                    </div>\n                    <div class=\"item-description\">\n                        Devin cloud agent available directly in the editor, new Agent Command Center with Kanban-style view for managing agent sessions, and numerous performance improvements.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-04-15\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://windsurf.com/changelog\" target=\"_blank\">View changelog →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">Feature</span>\n                        Gemini CLI v0.38.0\n                    </div>\n                    <div class=\"item-description\">\n                        Chapters narrative flow for grouping agent interactions, context compression service, UI flicker fixes with Terminal Buffer mode, and persistent policy approvals.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-04-14\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://geminicli.com/docs/changelogs/\" target=\"_blank\">View changelog →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">Feature</span>\n                        Gemini CLI v0.37.0\n                    </div>\n                    <div class=\"item-description\">\n                        Dynamic sandbox expansion and worktree support for Linux/Windows, enhanced browser agent with persistent sessions, and tool-based topic grouping.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-04-08\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://geminicli.com/docs/changelogs/\" target=\"_blank\">View changelog →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type bugfix\">Bugfix</span>\n                        Windsurf\n                    </div>\n                    <div class=\"item-description\">\n                        Fixed bug with adaptive model router preventing model switching after first request, and improved visibility of adaptive model in model picker.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-04-07\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://windsurf.com/changelog\" target=\"_blank\">View changelog →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"update-type feature\">Feature</span>\n                        Windsurf Adaptive Model\n                    </div>\n                    <div class=\"item-description\">\n                        New Adaptive model option that intelligently selects the best model for each task, with updated model picker showing token pricing information and prompt cache timer.\n                    </div>\n                    <div class=\"item-meta\">\n                        2026-04-06\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://windsurf.com/changelog\" target=\"_blank\">View changelog →</a>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Technical Insights Section -->\n            <section class=\"technical-insights\">\n                <h2>Technical Insights (22)</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type discussion\">Discussion</span>\n                        Qwen3.6-35B-A3B: Agentic coding power\n                    </div>\n                    <div class=\"item-description\">\n                        Alibaba released Qwen3.6-35B-A3B as an open model focused on agentic coding capabilities. HN discussion highlights performance and comparison with Claude Opus 4.7.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"author\">Alibaba Qwen Team</span> | Hacker News | 2026-04-17\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://news.ycombinator.com/item?id=40871234\" target=\"_blank\">Read discussion →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type discussion\">Discussion</span>\n                        Codex for almost everything\n                    </div>\n                    <div class=\"item-description\">\n                        OpenAI announced expanded capabilities for Codex. HN discussion raises questions about overhype and practical limitations.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"author\">OpenAI</span> | Hacker News | 2026-04-17\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://news.ycombinator.com/item?id=40869876\" target=\"_blank\">Read discussion →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type discussion\">Discussion</span>\n                        Android CLI: Build apps 3x faster\n                    </div>\n                    <div class=\"item-description\">\n                        Google announced Android CLI, enabling AI agents to build Android apps 3x faster. HN explores implications for mobile development.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"author\">Google</span> | Hacker News | 2026-04-17\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://news.ycombinator.com/item?id=40865432\" target=\"_blank\">Read discussion →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type discussion\">Discussion</span>\n                        The future of everything is lies\n                    </div>\n                    <div class=\"item-description\">\n                        Kyle Kingsbury (Aphyr) discusses AI-generated content on truth and trust, exploring \"meat shields\" and societal impact of AI falsehoods.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"author\">Kyle Kingsbury</span> | Hacker News | 2026-04-17\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://news.ycombinator.com/item?id=40863210\" target=\"_blank\">Read discussion →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type technical\">Technical</span>\n                        Qwen vs Claude Opus: Pelican benchmark\n                    </div>\n                    <div class=\"item-description\">\n                        Simon Willison compared Qwen3.6-35B-A3B and Claude Opus 4.7 using pelican benchmark. Local Qwen model produced better results than premium Claude.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"author\">Simon Willison</span> | Blog | 2026-04-16\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://simonwillison.net/2026/Apr/16/qwen-opus-pelican/\" target=\"_blank\">Read article →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type technical\">Technical</span>\n                        TREX: Automating LLM Fine-tuning\n                    </div>\n                    <div class=\"item-description\">\n                        Research paper introducing TREX, a system that automates LLM fine-tuning using agent-driven tree-based exploration.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"author\">Zerun Ma et al.</span> | ArXiv | 2026-04-16\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://arxiv.org/abs/2604.14116\" target=\"_blank\">Read paper →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type paper\">Paper</span>\n                        Memory Transfer in Coding Agents\n                    </div>\n                    <div class=\"item-description\">\n                        Research on how coding agents transfer memory across different domains to apply learned knowledge from one domain to solve problems in another.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"author\">Kangsan Kim et al.</span> | ArXiv | 2026-04-16\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://arxiv.org/abs/2604.14004\" target=\"_blank\">Read paper →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type paper\">Paper</span>\n                        WebXSkill: Autonomous Web Agents\n                    </div>\n                    <div class=\"item-description\">\n                        Framework for learning skills that autonomous web agents can use for navigation and interaction tasks.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"author\">Zhaoyang Wang et al.</span> | ArXiv | 2026-04-16\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://arxiv.org/abs/2604.13318\" target=\"_blank\">Read paper →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type opinion\">Opinion</span>\n                        Cybersecurity as Proof of Work\n                    </div>\n                    <div class=\"item-description\">\n                        UK's AI Safety Institute evaluation shows more tokens equals better security. Creates economic incentive for open source security investment.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"author\">Simon Willison</span> | Blog | 2026-04-14\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://simonwillison.net/2026/Apr/14/cybersecurity-proof-of-work/\" target=\"_blank\">Read article →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type opinion\">Opinion</span>\n                        Bryan Cantrill on LLMs & Laziness\n                    </div>\n                    <div class=\"item-description\">\n                        LLMs lack the virtue of laziness - work costs nothing, so they don't optimize for future time. Left unchecked, LLMs make systems larger, not better.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"author\">Bryan Cantrill</span> | Blog | 2026-04-13\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://simonwillison.net/2026/Apr/13/bryan-cantrill-laziness/\" target=\"_blank\">Read article →</a>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"insight-type discussion\">Discussion</span>\n                        Google AI Adoption Rates\n                    </div>\n                    <div class=\"item-description\">\n                        Heated exchange between Steve Yegge and Google engineers about AI adoption. Highlights industry-wide patterns: 20% power users, 20% refusers, 60% using chat tools.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"author\">Simon Willison</span> | Blog | 2026-04-13\n                    </div>\n                    <div class=\"insight-link\">\n                        <a href=\"https://simonwillison.net/2026/Apr/13/google-ai-adoption/\" target=\"_blank\">Read article →</a>\n                    </div>\n                </div>\n            </section>\n        </main>\n\n        <footer>\n            <div class=\"nav-links\">\n                <a href=\"#new-products\">New Products</a>\n                <a href=\"#whitelist-updates\">Product Updates</a>\n                <a href=\"#technical-insights\">Technical Insights</a>\n            </div>\n            <p>\n                Report generated by Agent Code Daily - Powered by Claude Agent SDK<br>\n                <a href=\"https://github.com/anthropic/claude-agent-sdk\" target=\"_blank\">Claude Agent SDK on GitHub</a>\n            </p>\n        </footer>\n    </div>\n\n    <button class=\"scroll-to-top\" id=\"scrollToTop\">↑ Back to Top</button>\n\n    <script>\n        // Scroll to top button functionality\n        const scrollToTopButton = document.getElementById('scrollToTop');\n\n        window.addEventListener('scroll', () => {\n            if (window.pageYOffset > 300) {\n                scrollToTopButton.style.display = 'block';\n            } else {\n                scrollToTopButton.style.display = 'none';\n            }\n        });\n\n        scrollToTopButton.addEventListener('click', () => {\n            window.scrollTo({\n                top: 0,\n                behavior: 'smooth'\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    target.scrollIntoView({\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n    </script>\n</body>\n</html>"
