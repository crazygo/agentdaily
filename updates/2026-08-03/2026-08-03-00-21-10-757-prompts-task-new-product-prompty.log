    "originalFile": "[\n  {\n    \"name\": \"open-kritt\",\n    \"url\": \"https://github.com/Kritt-ai/open-kritt\",\n    \"description\": \"Open-source, self-hosted security research platform that orchestrates AI agents to find real vulnerabilities in code. Breaks security research into small tasks, runs them across AI agents in parallel, and validates findings with proof of concepts.\",\n    \"release_date\": \"2026-07-20\",\n    \"category\": \"AI security agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"bbarit-agent-oss\",\n    \"url\": \"https://github.com/bbarit/bbarit-agent-oss\",\n    \"description\": \"Open-source AI coding agent CLI tool written in Rust, shipping as a single static binary. Supports 15+ LLM providers with 1,000+ models, semantic code search, 295 curated personas, project wiki, and auto-memory system.\",\n    \"release_date\": \"2026-07-21\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"waku-agent\",\n    \"url\": \"https://github.com/ShenSeanChen/waku-agent\",\n    \"description\": \"Local-first personal AI assistant framework emphasizing code readability. Built on four pillars: Harness, Loop, Memory, and Eval/LLM-Ops. Features plain Python loop, semantic facts and episodic memory, built-in evaluation, and multiple interfaces.\",\n    \"release_date\": \"2026-07-18\",\n    \"category\": \"AI coding agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"memmy-agent\",\n    \"url\": \"https://github.com/MemTensor/memmy-agent\",\n    \"description\": \"Personal AI agent and local memory hub enabling shared memory across multiple AI agents including Cursor, Claude Code, Codex, OpenClaw, and Hermes Agent. Features MemOS-powered memory engine, local-first architecture, and tool integration via MCP.\",\n    \"release_date\": \"2026-07-16\",\n    \"category\": \"AI memory hub\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"VulnHunter\",\n    \"url\": \"https://github.com/capitalone/VulnHunter\",\n    \"description\": \"Agentic AI security tool from Capital One that applies attacker-first analysis to source code. Uses forward analysis from entry points with a multi-stage falsification pipeline to reduce false positives. Includes fix and verify stages.\",\n    \"release_date\": \"2026-07-07\",\n    \"category\": \"AI security agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"KlaatCode\",\n    \"url\": \"https://github.com/KlaatAI/klaatcode\",\n    \"description\": \"Open-source terminal-native AI coding agent with smart model routing across five cost tiers. Features code knowledge graph with semantic search, unlimited tool rounds, real-time cost monitoring, and multi-agent workflows.\",\n    \"release_date\": \"2026-07-19\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"BossConsole\",\n    \"url\": \"https://github.com/risa-labs-inc/BossConsole\",\n    \"description\": \"Multi-platform harness for AI agents built with Kotlin running on JVM. Provides Claude Code, Codex, Gemini, and OpenCode with real tools including embedded browser, terminal, code editor, secrets management, and MCP automation.\",\n    \"release_date\": \"2026-07-21\",\n    \"category\": \"AI agent harness\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"openhub\",\n    \"url\": \"https://github.com/24KaratAu/openhub\",\n    \"description\": \"Keyboard-first terminal UI discovery hub and package installer for AI coding tools, skills, and agents. Features fuzzy search, curated collections, and universal skill export compatible with multiple AI coding environments.\",\n    \"release_date\": \"2026-07-23\",\n    \"category\": \"AI tools package manager\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"DarkPs-Agent-CLI\",\n    \"url\": \"https://github.com/dark-ps/DarkPs-Agent-CLI\",\n    \"description\": \"Extensible local-first AI agent framework for project workspaces, developer tooling, and MCP integration. Features automatic workspace interpretation, self-registering tools, persistent memory, and support for both cloud and local models.\",\n    \"release_date\": \"2026-07-22\",\n    \"category\": \"AI coding agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"ZoroCoding\",\n    \"url\": \"https://github.com/vionzoro/ZoroCoding\",\n    \"description\": \"Local-first macOS AI coding desktop app with model routing, project tools, real progress tracking, and removable-drive storage. Designed for Apple Silicon Macs running from portable hard drive with encrypted API key storage.\",\n    \"release_date\": \"2026-08-02\",\n    \"category\": \"AI desktop app\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Sixwhyo\",\n    \"url\": \"https://6yo.dev\",\n    \"description\": \"AI code review agent that catches over-engineering, confusing names, and unnecessary complexity. Acts as a six-year-old reviewer asking 'why?' about everything to promote simplicity and readability.\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"AI code reviewer\",\n    \"sources\": [\"Hacker News\"],\n    \"community_quotes\": []\n  }\n]",
