  "new_string": "  {\n    \"name\": \"Sixwhyo\",\n    \"url\": \"https://6yo.dev\",\n    \"description\": \"AI code review agent that catches over-engineering, confusing names, and unnecessary complexity. Acts as a six-year-old reviewer asking 'why?' about everything to promote simplicity and readability.\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"AI code reviewer\",\n    \"sources\": [\"Hacker News\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"agentacct\",\n    \"url\": \"https://github.com/mikehasa/agentacct\",\n    \"description\": \"Local-first agent work intelligence dashboard that monitors coding agent activity. Reads session logs from Claude Code, Codex, and OpenCode, displaying token usage, costs, work steps, and file changes with privacy-focused localhost architecture.\",\n    \"release_date\": \"2026-07-24\",\n    \"category\": \"AI monitoring tool\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"AgentDoctor\",\n    \"url\": \"https://github.com/pranee54/AgentDoctor\",\n    \"description\": \"Local CLI tool that audits AI coding agent configurations for security vulnerabilities, exposed environment files, private keys, MCP filesystem scopes, and context waste. Works with Cursor, Claude Code, and Codex environments without API keys.\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"AI security tool\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"sigbound\",\n    \"url\": \"https://github.com/surya-koritala/sigbound\",\n    \"description\": \"Tool for running multiple AI coding agents on one repository in parallel with automatic merging. Lands only changes that build and pass tests, addressing the 30-50% time developers spend on conflict resolution with parallel agents.\",\n    \"release_date\": \"2026-07-21\",\n    \"category\": \"AI workflow automation\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"CleanSlate\",\n    \"url\": \"https://github.com/TheWariend/CleanSlate\",\n    \"description\": \"Open-source coding agent for IDE, CLI, and SDK environments. VS Code-based agent fork with Execution mode for building and Plan mode for read-only analysis, supporting multiple AI providers with 59 built-in tools.\",\n    \"release_date\": \"2026-07-27\",\n    \"category\": \"AI coding agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"agent-manager\",\n    \"url\": \"https://github.com/YoanWai/agent-manager\",\n    \"description\": \"Terminal UI for managing AI coding-agent sessions within tmux, supporting Claude Code, OpenCode, Codex, Grok, and Gemini CLI. Provides live status, group tree, quick prompts, diff review, and git worktree support.\",\n    \"release_date\": \"2026-07-15\",\n    \"category\": \"Agent management tool\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"chartr\",\n    \"url\": \"https://github.com/rengwu/chartr\",\n    \"description\": \"Agent multiplexer combining terminal multiplexing with visual work mapping. Renders plans as star-maps and enables launching planning agents, spawning sessions from tickets, and automatic detection of agent CLIs.\",\n    \"release_date\": \"2026-07-21\",\n    \"category\": \"Agent multiplexer\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"PaiCLI-Python\",\n    \"url\": \"https://github.com/itwanger/PaiCLI-Python\",\n    \"description\": \"Python terminal AI agent CLI with ReAct tools, MCP client, memory systems, web search, and image input. Features Plan-and-Execute mode with DAG generation, multi-agent collaboration, and HITL confirmation for dangerous operations.\",\n    \"release_date\": \"2026-07-08\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  }\n]"
