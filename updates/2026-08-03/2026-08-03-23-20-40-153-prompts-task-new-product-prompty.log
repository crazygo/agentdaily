ration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"ForeverVM\",\n    \"url\": \"https://github.com/jamsocket/forevervm\",\n    \"description\": \"Secure sandbox environment for executing AI-generated code with persistent state. Sandboxes maintain context between sessions rather than being ephemeral, enabling continuous long-running code execution.\",\n    \"release_date\": \"2025-01-18\",\n    \"category\": \"AI workflow tool\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"wikipedia-ai-agent\",\n    \"url\": \"https://github.com/BurnyCoder/wikipedia-ai-agent\",\n    \"description\": \"AI-powered research assistant leveraging Wikipedia as knowledge base. Uses LangChain's LangGraph ReAct agent architecture, multiple LLM providers, Wikipedia API, FAISS vector database for RAG, semantic chunking, and GraphRAG.\",\n    \"release_date\": \"2025-01-15\",\n    \"category\": \"AI research agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"TevVark-Terminal\",\n    \"url\": \"https://github.com/OMNOMNOM0808/TevVark-Terminal\",\n    \"description\": \"Open-source desktop agent framework enabling AI to perceive and control computers through computer vision and system-level interactions. Python-based MIT-licensed tool.\",\n    \"release_date\": \"2025-01-17\",\n    \"category\": \"AI agent framework\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"ai_agents\",\n    \"url\": \"https://github.com/thisguypranav/ai_agents\",\n    \"description\": \"Terminal task agent CLI for developers powered by NLP & AI. Helps organize and manage tasks through terminal with natural language processing.\",\n    \"release_date\": \"2025-01-11\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"ai.nvim\",\n    \"url\": \"https://github.com/