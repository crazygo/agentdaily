ents\"]\n  },\n  {\n    \"name\": \"Trajex\",\n    \"url\": \"https://github.com/wutongyuonce/Trajex\",\n    \"description\": \"Indexes thousands of Claude Code, Codex, and Pi JSONL sessions into SQLite for millisecond queries. Coding agents can query past sessions while users browse through an app interface.\",\n    \"release_date\": \"2026-07-27\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\"Query past Claude Code, Codex sessions by your agent\", \"Browsable by you through an app\"]\n  },\n  {\n    \"name\": \"SkillForge\",\n    \"url\": \"https://github.com/HaddenHunter/SkillForge\",\n    \"description\": \"A skill package manager (like npm) for AI Coding Agents including Claude Code, Cursor, Codex, and Gemini CLI. Local-first, model-agnostic, and MCP-native.\",\n    \"release_date\": \"2026-07-26\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\"Skill package manager for AI coding agents\", \"Local-first, model-agnostic, MCP-native\"]\n  },\n  {\n    \"name\": \"LongHorizon Harness\",\n    \"url\": \"https://github.com/AMAP-ML/LongHorizon-Harness\",\n    \"description\": \"A framework for running AI agents across desktop apps and CLI for extended periods with task state preservation. Integrates with Claude Code, Codex, and OpenClaw.\",\n    \"release_date\": \"2026-07-25\",\n    \"category\": \"workflow orchestration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\"Run AI agents across desktop apps and the CLI for extended periods\", \"Fresh-context execution, durable verified state\"]\n  }\n]\n",
