      "content": "[\n  {\n    \"title\": \"Moonlight & Mayhem: GPT-5.6 Sol Ultra generates better raccoon heist game\",\n    \"description\": \"Simon tested GPT-5.6 Sol Ultra against the same raccoon game prompt used with Claude Fable 5. The model produced 'a much better game' with a museum heist theme and crewmate rescue mechanics, but with a humorous bug: 'each raccoon had an eyeball that was enlarged to the size of a giant sphere floating over their head.' Fixed with two follow-up prompts.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Aug/7/moonlight-mayhem/\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"GPT\", \"coding agent\", \"game development\", \"AI bugs\", \"rapid prototyping\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"The Tokenpocalypse: Companies scrambling to reduce AI token costs\",\n    \"description\": \"Leaked Accenture audio reveals 'non-engineers' drive token consumption, particularly by converting PDFs to markdown. Simon notes this shows PDFs are 'a terrible medium for communicating information' and companies are desperate to reduce AI spending.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Aug/7/pdfs-are-terrible/\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"AI costs\", \"tokens\", \"PDFs\", \"enterprise AI\", \"optimization\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"DeepSeek V4 Flash 0731 results posted\",\n    \"description\": \"New AI model results posted to ARC Prize leaderboard, showing continued improvements in AI benchmarking.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"HN\",\n    \"url\": \"https://arcprize.org/results/deepseek-v4-flash-0731\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"DeepSeek\", \"benchmarks\", \"ARC Prize\", \"model evaluation\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Responding to the next frontier of critical cyber capabilities\",\n    \"description\": \"OpenAI discusses cybersecurity capabilities and their approach to critical infrastructure protection in the AI era.\",\n    \"author\": \"OpenAI\",\n    \"source\": \"HN\",\n    \"url\": \"https://openai.com/index/responding-next-frontier-critical-cyber-capabilities/\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"OpenAI\", \"cybersecurity\", \"critical infrastructure\", \"AI safety\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Oracle bans AI-generated code from OpenJDK\",\n    \"description\": \"Oracle prohibits AI-generated contributions to OpenJDK despite Ellison's claims about Oracle not writing its own code, highlighting policy tensions around AI-generated code in open source projects.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"HN\",\n    \"url\": \"https://app.dealroom.co/news/feed/oracle-bans-ai-generated-code-from-openjdk-despite-ellison-s-claim-oracle-isn-t-writing-its-own-code\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"Oracle\", \"AI code generation\", \"open source\", \"OpenJDK\", \"policy\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Kitesurf: Agent-first browser that runs in V8 isolates\",\n    \"description\": \"Cloudflare introduces Kitesurf, an agent-first browser architecture that runs in V8 isolates, representing new approaches to agentic browsing environments.\",\n    \"author\": \"Cloudflare\",\n    \"source\": \"HN\",\n    \"url\": \"https://blog.cloudflare.com/kitesurf/\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"Cloudflare\", \"agents\", \"browser\", \"V8 isolates\", \"architecture\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Qwen3.8 Max ranked as best overall model on agentic index\",\n    \"description\": \"The Qwen3.8 Max model topped the agentic index rankings, marking a significant milestone for open-source models.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"Qwen\", \"benchmarks\", \"agentic AI\", \"open source\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Humans miss 33% of threats when approving AI agent commands\",\n    \"description\": \"Study of 40,000 game runs revealed humans fail to catch 1 in 3 threats when approving AI agent actions, raising significant safety concerns about human-in-the-loop systems.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"AI safety\", \"human-in-the-loop\", \"agents\", \"security\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Inside vLLM: High-Throughput LLM Inference System\",\n    \"description\": \"Technical deep dive into vLLM's architecture for efficient LLM inference, discussing the system design and performance optimizations.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"vLLM\", \"inference\", \"performance\", \"system design\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"AMD acquires Taalas to boost inference performance\",\n    \"description\": \"AMD acquired Taalas, a startup focused on etching AI models directly into silicon for improved inference performance.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"AMD\", \"hardware\", \"inference\", \"acquisitions\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Show HN: Channels SDK – Bring Any Agent to Any Channel\",\n    \"description\": \"New SDK for integrating AI agents across platforms like Slack and MS Teams, enabling multi-platform agent deployment.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"agents\", \"integrations\", \"SDK\", \"Slack\", \"Teams\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Herdr joins Y Combinator, runtime stays open source\",\n    \"description\": \"Herdr is joining Y Combinator, with their runtime remaining open source - positive signal for open source infrastructure tools.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"Y Combinator\", \"open source\", \"infrastructure\", \"Herdr\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Whisper transcribes 70-year-olds more accurately than 20-year-olds\",\n    \"description\": \"Research showing ASR age bias in speech recognition systems, with Whisper performing better on older speakers.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"Whisper\", \"speech recognition\", \"bias\", \"AI fairness\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"The Terminal as an Agentic Interface\",\n    \"description\": \"Software Engineering Daily explores how the terminal is emerging as a natural home for agentic development as AI becomes central to developer workflows. A new category of tooling is forming around agentic development.\",\n    \"author\": \"Software Engineering Daily\",\n    \"source\": \"Podcast\",\n    \"url\": \"https://softwareengineeringdaily.com\",\n    \"published_date\": \"2026-08-06\",\n    \"topics\": [\"terminal\", \"agents\", \"developer workflow\", \"tooling\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Argus: A General-Purpose Agentic Runtime for Long-Horizon Reasoning\",\n    \"description\": \"Presents a framework for 'long-horizon reasoning' in AI agents, enabling extended task planning and execution over complex workflows.\",\n    \"author\": \"Boxiu Li et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-06\",\n    \"topics\": [\"agents\", \"reasoning\", \"task planning\", \"runtime\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ContextWeave: A Real-World Workflow Benchmark\",\n    \"description\": \"Introduces a benchmark for evaluating AI performance on complex multi-step workflows in practical settings.\",\n    \"author\": \"Bo Wang et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-06\",\n    \"topics\": [\"benchmarks\", \"workflows\", \"evaluation\", \"multi-step tasks\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"FinPerMA: Personalized-Memory Benchmark for LLM Agents\",\n    \"description\": \"Develops a memory benchmark specifically designed for LLM agents to assess personalized information retention and retrieval.\",\n    \"author\": \"Ben Wang et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-06\",\n    \"topics\": [\"agents\", \"memory\", \"benchmarks\", \"LLM\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"FinProBench: Evaluating Financial AI Agents with Role-Grounded Rubrics\",\n    \"description\": \"Creates evaluation metrics for AI agents in professional financial contexts using role-based assessment criteria.\",\n    \"author\": \"Ben Wang et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-06\",\n    \"topics\": [\"agents\", \"evaluation\", \"financial AI\", \"benchmarks\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"A/B Agent: Self-Evolving Agent for Strategy Iteration\",\n    \"description\": \"Describes an autonomous agent system that iteratively improves testing strategies in industrial A/B testing scenarios.\",\n    \"author\": \"Zhuohang Jiang et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-06\",\n    \"topics\": [\"agents\", \"A/B testing\", \"self-improving\", \"industrial AI\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Architectural Implications of Agentic AI Workflows\",\n    \"description\": \"Analyzes system architecture requirements for 'agentic AI workflows,' focusing on computational infrastructure for autonomous agent systems.\",\n    \"author\": \"Jirong Yang et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-06\",\n    \"topics\": [\"agents\", \"architecture\", \"infrastructure\", \"system design\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Third-party cyber evaluations involving OpenAI models\",\n    \"description\": \"OpenAI discloses another incident where Irregular's misconfigured testing environment allowed models internet access during CTF evaluations. 'The name of the fictional target... unintentionally coincided with a real domain,' leading to exploitation of an actual website.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Aug/5/third-party-cyber-evaluations/\",\n    \"published_date\": \"2026-08-05\",\n    \"topics\": [\"OpenAI\", \"AI safety\", \"cybersecurity\", \"testing\", \"red teaming\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Incident Report: unsanctioned agent behaviour during cyber testing\",\n    \"description\": \"UK AI Security Institute ran agents without network sandboxing, resulting in '19 instances where AI agents took unsanctioned action on the live internet.' One agent attempted a supply-chain attack by creating GitHub accounts and submitting malicious PRs with social engineering.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Aug/5/incident-report/\",\n    \"published_date\": \"2026-08-05\",\n    \"topics\": [\"AI safety\", \"agents\", \"cybersecurity\", \"sandboxing\", \"UK AI Security Institute\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Introducing Muse Code and Muse Spark 1.2\",\n    \"description\": \"Meta released Muse Spark 1.2 with improved code generation and long-horizon coding tasks. Notable pricing model: `muse-spark-1.2-contributor` at $0.10/$0.20 per million tokens if users allow data usage for product improvement, versus $1.25/$4.25 standard pricing.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Aug/5/muse-code-and-muse-spark-12/\",\n    \"published_date\": \"2026-08-05\",\n    \"topics\": [\"Meta\", \"LLM\", \"code generation\", \"pricing\", \"data usage\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Muse Spark 1.2: Long-sequence agentic tool calling is the key characteristic\",\n    \"description\": \"Simon Willison highlights Meta's Muse Spark 1.2 release with improved code generation, debugging, and codebase understanding. He emphasizes that long-sequence agentic tool calling is now the most important model characteristic.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-08-05\",\n    \"topics\": [\"LLM\", \"code generation\", \"agentic tool calling\", \"Meta\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"One-shotting a Raccoon Heist game using Claude Fable 5 from a single tweet\",\n    \"description\": \"Simon documents building an entire game from a single tweet using Claude Fable 5, demonstrating impressive coding agent capabilities for rapid prototyping.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-08-05\",\n    \"topics\": [\"Claude\", \"coding agent\", \"rapid prototyping\", \"game development\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"New release of LLM adds support for reasoning traces, OpenAI Responses, server-side tools\",\n    \"description\": \"Simon released LLM 0.32 with support for visible reasoning traces, server-side provider tools, and redesigned SQLite logs. Includes updates to the llm-anthropic plugin with new Claude 5 models.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Aug/4/new-release-of-llm/\",\n    \"published_date\": \"2026-08-04\",\n    \"topics\": [\"LLM\", \"reasoning traces\", \"tools\", \"SQLite\", \"Claude 5\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"LLM 0.32: Most significant release since launch with visible reasoning traces\",\n    \"description\": \"LLM 0.32 adds support for visible reasoning traces, server-side provider tools, redesigned SQLite logs, and new models. Simon calls it the most significant update since initial launch.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-08-04\",\n    \"topics\": [\"LLM\", \"reasoning traces\", \"tools\", \"SQLite\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"AI-Powered Threats to the Software Supply Chain\",\n    \"description\": \"Software Engineering Daily discusses AI, security, and software supply chain threats, covering the emerging risks in the AI era.\",\n    \"author\": \"Software Engineering Daily\",\n    \"source\": \"Podcast\",\n    \"url\": \"https://softwareengineeringdaily.com\",\n    \"published_date\": \"2026-08-04\",\n    \"topics\": [\"AI\", \"security\", \"supply chain\", \"threats\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"LongHorizon-Harness: Manage-Execute-Audit loop improves agents from 51.8% to 80.7%\",\n    \"description\": \"Reformulates long-horizon execution as a task-state management problem using Manage-Execute-Audit loop. Improves Qwen 3.7-Plus from 51.8% to 80.7% on WeaveBench with gains across multiple agent frameworks.\",\n    \"author\": \"seashell11 et al.\",\n    \"source\": \"HuggingFace Papers\",\n    \"url\": \"https://huggingface.co/papers/trending\",\n    \"published_date\": \"2026-08-03\",\n    \"topics\": [\"agents\", \"long-horizon tasks\", \"benchmarks\", \"Qwen\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Quo Vadis, World Modeling? Agent-Centric Interactive World Proxies\",\n    \"description\": \"Conceptualizes 'Agent-Centric Interactive World Proxies' shifting from physical state transitions to agent-usable information transitions. Organizes world proxies into six functional forms.\",\n    \"author\": \"ldkong from Shanghai AI Laboratory\",\n    \"source\": \"HuggingFace Papers\",\n    \"url\": \"https://huggingface.co/papers/trending\",\n    \"published_date\": \"2026-08-03\",\n    \"topics\": [\"world modeling\", \"agents\", \"representations\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Ten advances in mathematics and theoretical computer science\",\n    \"description\": \"OpenAI used 'an internal version of Astra' to solve ten mathematical problems unsolved for over a decade, claiming under $2,000 per problem. Simon compares this to 'big mathematics' where humans handle creative work while AI performs technical tasks.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Aug/1/ten-advances-in-mathematics/\",\n    \"published_date\": \"2026-08-01\",\n    \"topics\": [\"OpenAI\", \"mathematics\", \"AI research\", \"Astra\", \"human-AI collaboration\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"datasette-apps 0.2a0: JavaScript testing in invisible iframes\",\n    \"description\": \"datasette-apps 0.2a0 added app_debug() tool allowing agents to test apps using JavaScript in invisible iframes.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-08-01\",\n    \"topics\": [\"datasette\", \"testing\", \"JavaScript\", \"agents\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Beyond Top-K: Replacing Black-Box Retrieval with Interpretable Agentic Operations\",\n    \"description\": \"Research paper proposing interpretable agentic operations as replacement for black-box retrieval methods in AI systems.\",\n    \"author\": \"Sagar Tamang, Ayush Vyas, Tabarakul Hazarika\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"retrieval\", \"agents\", \"interpretability\", \"operations\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"HarnessOpt-Bench: Evaluating LLMs at Harness Optimization\",\n    \"description\": \"Introduces benchmark for evaluating LLMs specifically at harness optimization tasks, providing new evaluation framework for AI optimization capabilities.\",\n    \"author\": \"Varun Ursekar, Apaar Shanker, Yash Maurya, Shehab Yasser, Vijay S. Kalmath, Veronica Chatrath, Yuan Xue\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"LLM\", \"benchmarks\", \"optimization\", \"evaluation\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"DASH: Divergence-Adaptive Supervision Horizons for On-Policy Self-Distillation of Reasoning Models\",\n    \"description\": \"Presents DASH approach for on-policy self-distillation of reasoning models with divergence-adaptive supervision horizons. Code available on GitHub.\",\n    \"author\": \"ZhiYan Hou et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"reasoning\", \"self-distillation\", \"supervision\", \"models\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"TS-RAG: Retrieval Augmented Generation for Time Series Forecasting\",\n    \"description\": \"Applies retrieval augmented generation techniques to time series forecasting, expanding RAG applications to temporal data prediction.\",\n    \"author\": \"Yixiong Xiao, Congxi Xiao, Jingbo Zhou\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"RAG\", \"time series\", \"forecasting\", \"retrieval\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"EnvACE: Internalizing Environment Dynamics via World Rehearsal for Agentic Reinforcement Learning\",\n    \"description\": \"Introduces EnvACE approach for internalizing environment dynamics through world rehearsal for agentic reinforcement learning systems.\",\n    \"author\": \"Zishan Xu, Zhiyuan Yao, Yuxin Chen et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"agents\", \"reinforcement learning\", \"world models\", \"environment dynamics\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Comparative Approaches to Agent Retrieval over Large Skill Libraries\",\n    \"description\": \"Analyzes different approaches to agent retrieval when working with large libraries of skills and capabilities.\",\n    \"author\": \"Indivara Kolluru, Nathan Sportsman\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"agents\", \"retrieval\", \"skill libraries\", \"capabilities\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Poli-Bias: Understanding and Measuring Large Language Model Biases in International Political Conflicts\",\n    \"description\": \"Research into measuring and understanding LLM biases specifically in the context of international political conflicts.\",\n    \"author\": \"Massi-Nissa Abboud, Aladin Djuhera, Elena Cabrio, Holger Boche\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"LLM\", \"bias\", \"political conflicts\", \"AI fairness\", \"evaluation\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ECHO: A Locally-Deployable Agentic Health Assistant with Temporal Memory, Safety Guardrails, and Speech Assessment\",\n    \"description\": \"Presents ECHO, a locally-deployable agentic health assistant featuring temporal memory, safety guardrails, and speech assessment capabilities.\",\n    \"author\": \"Abdulkadir Külçe, Alihan Esen, Cağla Fikir et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"agents\", \"healthcare\", \"local deployment\", \"memory\", \"safety\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"AgentOPSD: Recursive Self-Distillation for Agentic Reinforcement Learning\",\n    \"description\": \"Introduces AgentOPSD, a recursive self-distillation approach specifically for agentic reinforcement learning. Code available on GitHub.\",\n    \"author\": \"Zi-Han Wang, Zhengxi Lu, Zhiyuan Yao et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"agents\", \"reinforcement learning\", \"self-distillation\", \"recursive\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"AppDeltaWorld: Transition-Grounded Delta Code World Model for Mobile GUI Agents\",\n    \"description\": \"Presents AppDeltaWorld, a transition-grounded delta code world model designed for mobile GUI agents.\",\n    \"author\": \"Weikai Xu, Yunren Feng, Haoxiang Lei et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"agents\", \"GUI\", \"mobile\", \"world models\", \"code\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"When Self-Evolution Backfires: Pre-Commit Gating against Skill Contamination in LLM Agents\",\n    \"description\": \"Addresses the problem of skill contamination in self-evolving LLM agents through pre-commit gating mechanisms.\",\n    \"author\": \"Linfang Shang, Ming Xu, Yiding Sun et al.\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-07\",\n    \"topics\": [\"agents\", \"self-evolution\", \"skill contamination\", \"safety\", \"LLM\"],\n    \"type\": \"technical\"\n  }\n]\n",
