  "content": "[\n  {\n    \"name\": \"Pi Coding Agent\",\n    \"url\": \"https://pi.dev\",\n    \"description\": \"A minimal, hackable terminal harness for building custom AI coding agent workflows. Pi lets you customize the agent with extensions, skills, prompt templates, and themes, with npm-based package distribution.\",\n    \"release_date\": \"2026-05-26\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Pi is such a joy to use! It's easy, customizable, and fits my workflow perfectly.\",\n      \"The customizable harness angle is interesting. Coding agents get much more useful when teams can shape the workflow around their own review habits.\",\n      \"The npm-based package distribution is the right architectural call.\",\n      \"We're entering the era where coding agents become teammates instead of tools.\"\n    ]\n  },\n  {\n    \"name\": \"MashuPack\",\n    \"url\": \"https://mashupack.com\",\n    \"description\": \"A tool that turns codebases into clean text files for ChatGPT, Claude, and Gemini. It selects exact parts of a repository and compiles them into one file, solving file-count limits and upload friction in browser-based AI workflows.\",\n    \"release_date\": \"2026-05-26\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"This solves a very real Claude/ChatGPT workflow pain. Simple idea, high utility.\",\n      \"I've been using tree for this, but Mashupack is a nice visual way to solve the same problem.\",\n      \"MashuPack preserves file paths and structure, and the tree/report can be copied along with the full contents.\"\n    ]\n  },\n  {\n    \"name\": \"Unabyss\",\n    \"url\": \"https://unabyss.com\",\n    \"description\": \"An MCP-native self-updating context layer for AI. Provides context management for AI tools with Model Context Protocol integration.\",\n    \"release_date\": \"2026-05-26\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"ModelHub\",\n    \"url\": \"https://modelhub.app\",\n    \"description\": \"The missing menu bar app for local LLMs on Mac. Provides a convenient interface for managing and using local language models.\",\n    \"release_date\": \"2026-05-25\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Edgee\",\n    \"url\": \"https://edgee.dev\",\n    \"description\": \"Claude Code fallback that never stops. Provides continuous operation for Claude Code workflows.\",\n    \"release_date\": \"2026-05-25\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Freu\",\n    \"url\": \"https://freu.ai\",\n    \"description\": \"Automate any Mac app with $0 recurring run cost. An AI automation tool for Mac workflows.\",\n    \"release_date\": \"2026-05-25\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"CodeGraph\",\n    \"url\": \"https://github.com/colbymchenry/codegraph\",\n    \"description\": \"Pre-indexed code knowledge graph for AI coding agents. Provides semantic code intelligence with 35% cost reduction, 70% fewer tool calls, and 100% local operation. Works with Claude Code, Codex, Cursor, OpenCode, and Hermes Agent.\",\n    \"release_date\": \"2026-05-21\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  }\n]\n"
