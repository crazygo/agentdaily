ory\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"ModelHub\",\n    \"url\": \"https://modelhub.app\",\n    \"description\": \"The missing menu bar app for local LLMs on Mac. Provides a convenient interface for managing and using local language models.\",\n    \"release_date\": \"2026-05-25\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Edgee\",\n    \"url\": \"https://edgee.dev\",\n    \"description\": \"Claude Code fallback that never stops. Provides continuous operation for Claude Code workflows.\",\n    \"release_date\": \"2026-05-25\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Freu\",\n    \"url\": \"https://freu.ai\",\n    \"description\": \"Automate any Mac app with $0 recurring run cost. An AI automation tool for Mac workflows.\",\n    \"release_date\": \"2026-05-25\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"CodeGraph\",\n    \"url\": \"https://github.com/colbymchenry/codegraph\",\n    \"description\": \"Pre-indexed code knowledge graph for AI coding agents. Provides semantic code intelligence with 35% cost reduction, 70% fewer tool calls, and 100% local operation. Works with Claude Code, Codex, Cursor, OpenCode, and Hermes Agent.\",\n    \"release_date\": \"2026-05-21\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  }\n]\n"
