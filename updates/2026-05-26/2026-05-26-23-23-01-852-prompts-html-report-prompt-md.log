lor: #f9f9f9;\n            border-left: 3px solid #ff6600;\n            padding: 8px 10px;\n            margin: 8px 0;\n            font-style: italic;\n            color: #555;\n            font-size: 9pt;\n        }\n\n        .topic {\n            display: inline-block;\n            color: #666;\n            font-size: 8pt;\n            margin-right: 6px;\n        }\n\n        footer {\n            text-align: center;\n            padding: 15px;\n            color: #828282;\n            font-size: 9pt;\n            border-top: 1px solid #d4d4d4;\n            margin-top: 20px;\n        }\n\n        footer a {\n            color: #ff6600;\n            text-decoration: none;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n        }\n\n        .empty-state {\n            color: #999;\n            font-style: italic;\n            text-align: center;\n            padding: 20px;\n        }\n\n        @media print {\n            body {\n                background-color: #fff;\n            }\n\n            section {\n                border: 1px solid #ccc;\n                page-break-inside: avoid;\n            }\n        }\n\n        .score {\n            color: #ff6600;\n            font-weight: bold;\n            font-size: 9pt;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agentic Coding Daily Report</h1>\n            <div class=\"date\">2026-05-26</div>\n        </header>\n\n        <main class=\"three-column-layout\">\n            <!-- New Products Section -->\n            <section class=\"new-products\">\n                <h2>New Products (4)</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://pi.dev\" target=\"_blank\">Pi Coding Agent</a>\n                        <span class=\"source-badge\">Product Hunt</span>\n                    </div>\n                    <div class=\"item-description\