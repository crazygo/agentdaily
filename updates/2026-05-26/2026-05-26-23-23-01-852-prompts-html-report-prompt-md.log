n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/May/21/datasette-agent/\",\n    \"published_date\": \"2026-05-21\",\n    \"topics\": [\"llm\", \"ai-agents\", \"datasette\", \"sqlite\", \"coding-agents\", \"developer-tools\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"My LLM coding workflow going into 2026\",\n    \"description\": \"Addy Osmani shares comprehensive best practices for AI-assisted coding workflows, emphasizing detailed specifications, iterative development, using MCPs (Model Context Protocols), and treating AI as a powerful pair programmer rather than an autonomous agent.\",\n    \"author\": \"Addy Osmani\",\n    \"source\": \"Medium\",\n    \"url\": \"https://medium.com/@addyosmani/my-llm-coding-workflow-going-into-2026-52fe1681325e\",\n    \"published_date\": \"2026-05-20\",\n    \"topics\": [\"AI coding\", \"LLM workflow\", \"developer tools\", \"best practices\"],\n    \"type\": \"tutorial\"\n  },\n  {\n    \"title\": \"Gemini 3.5 Flash: more expensive, but Google plan to use it for everything\",\n    \"description\": \"Analysis of Google's Gemini 3.5 Flash release at Google I/O 2026. The model went straight to general availability (skipping preview) and Google is using it across key products. Discusses pricing implications and Google's strategy.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/May/19/gemini-3-5-flash/\",\n    \"published_date\": \"2026-05-19\",\n    \"topics\": [\"google\", \"gemini\", \"llm-pricing\", \"llm-release\", \"google-io\", \"ai-strategy\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"The last six months in LLMs in five minutes\",\n    \"description\": \"Annotated slides from Simon's five-minute lightning talk at PyCon US 2026, covering major developments in LLMs over the previous six months. Created using his annotated presentation tool.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/May/19/llm-lightning-talk/\",\n    \"published_date\": \"2026-05-19\",\n    \"topics\": [\"llm\", \"pycon\", \"lightning-talks\", \"ai-trends\", \"local-llms\", \"coding-agents\"],\n    \"type\": \"tutorial\"\n  },\n  {\n    \"title\": \"Stack Overflow users don't trust AI. They're using it anyway\",\n    \"description\": \"The Verge podcast featuring Stack Overflow CEO Prashanth Chandrasekar discussing the paradox where more than 80% of users want to use AI tools despite only 46% actively trusting AI tool accuracy, with users compensating by double-checking AI output.\",\n    \"author\": \"The Verge Podcast Team\",\n    \"source\": \"Podcast\",\n    \"url\": \"https://www.theverge.com/podcast/844073/stack-overflow-ceo-ai-coding-chatgpt-code-red-interview\",\n    \"published_date\": \"2026-05-19\",\n    \"topics\": [\"AI coding\", \"developer trust\", \"LLM adoption\"],\n    \"type\": \"technical\"\n  }\n]\n",
