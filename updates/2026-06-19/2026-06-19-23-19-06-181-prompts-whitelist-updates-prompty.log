    "originalFile": "[\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor Automations Improvements and BugBot Performance Boost\",\n    \"description\": \"Cursor released significant improvements to Cursor Automations including a new /automate skill for creating automations in local agent sessions, new GitHub and Slack triggers, and cloud agent computer use support. BugBot received major performance upgrades: now 3x faster (~90 seconds average review time), 22% cheaper, and finds 10% more bugs per review, powered by Composer 2.5.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-06-18\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"BugBot switched from $40/seat/month subscription to usage-based billing for Teams and Individual plans after June 8th, 2026, sparking discussion about impacts on iterative workflows\",\n        \"source\": \"Cursor Blog\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Devin Desktop v3.2.16 with Devin Local Plugin System\",\n    \"description\": \"Devin Desktop (formerly Windsurf) released v3.2.16 with a new Devin plugin system for extending Devin Local (in preview for enterprises), subagents can now call MCP tools directly, and teams can enforce terminal allow/deny lists through CLI permission scopes. Also enabled Cmd+.) mode-toggle shortcut from the empty editor welcome panel.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-06-16\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Users on Reddit mentioned that the update resulted in 'a shiny looking IDE with bright colors' and overall positive reception\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"VS Code v1.102 June 2026 Update with Autopilot\",\n    \"description\": \"Microsoft's June 2026 VS Code update turns on Autopilot by default and adds background sending for agent sessions. The update continues to enhance GitHub Copilot integration with agent mode workflows and Model Context Protocol (MCP) support improvements.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://visualstudiomagazine.com/articles/2025/07/14/vs-code-v1-102-doubles-down-on-github-copilot-and-ai-enhanced-development.aspx\",\n    \"date\": \"2026-06-14\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Reddit discussion mentions custom agent mode features and terminal execution capabilities\",\n        \"source\": \"Reddit r/GithubCopilot\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Devin Desktop v3.1.7 with Agent/Editor Mode Smoothing\",\n    \"description\": \"Devin Desktop v3.1.7 brings smoother Agent/Editor experience with the switch added to collapsed-sidebar titlebar, unified search icon to open agent search, and improved switching so auxiliary windows no longer close and restore. Renamed 'Devin CLI' settings to 'Devin Local' and added notification for agent sign-in failures.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-06-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Devin Desktop v3.0.28 Migration and Performance Fixes\",\n    \"description\": \"Release v3.0.28 hardened migration from Windsurf on Windows to preserve shortcut icon, improved file context handling in Devin Local agent, increased proxy authentication timeout, and fixed issues with stdio MCP servers on Windows. Enterprise customers received simplified model picker pricing view.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-06-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Devin Desktop v3.0.21 Reset Migration Command\",\n    \"description\": \"Added a new 'Reset migration from Windsurf' command in the command palette that resets Devin Desktop settings and gives a second chance to import extensions and settings from Windsurf, addressing login issues users experienced after initial migration.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-06-04\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Windsurf Rebranded to Devin Desktop\",\n    \"description\": \"Major rebranding event: Windsurf is now Devin Desktop. The over-the-air update transitioned the AI code editor name while preserving all user plans, pricing, extensions, and settings automatically with no action required from users.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-06-02\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The rebrand from Windsurf to Devin Desktop was seamless for users\",\n        \"source\": \"Releasebot.io\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot in VS Code May Release v1.101\",\n    \"description\": \"The May 2026 release (v1.101) of GitHub Copilot in Visual Studio Code delivers significant improvements to agent mode workflows and enhanced Model Context Protocol (MCP) support, continuing the evolution of AI-assisted development features.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2025-06-13-github-copilot-in-vs-code-may-release-v1-101\",\n    \"date\": \"2026-06-13\",\n    \"community_feedback\": []\n  }\n]\n"
