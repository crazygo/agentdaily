n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Devin Desktop v3.1.7 Agent/Editor Mode Smoothing\",\n    \"description\": \"Devin Desktop v3.1.7 brings smoother Agent/Editor experience with the switch added to collapsed-sidebar titlebar, unified search icon to open agent search, and improved switching so auxiliary windows no longer close and restore. Renamed 'Devin CLI' settings to 'Devin Local' and added notification for agent sign-in failures.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-06-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Devin Desktop v3.0.28 Migration and Performance Fixes\",\n    \"description\": \"Release v3.0.28 hardened migration from Windsurf on Windows to preserve shortcut icon, improved file context handling in Devin Local agent, increased proxy authentication timeout, and fixed issues with stdio MCP servers on Windows. Enterprise customers received simplified model picker pricing view.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-06-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Devin Desktop v3.0.21 Reset Migration Command\",\n    \"description\": \"Added a new 'Reset migration from Windsurf' command in the command palette that resets Devin Desktop settings and gives a second chance to import extensions and settings from Windsurf, addressing login issues users experienced after initial migration.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-06-04\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Windsurf Rebranded to Devin Desktop\",\n    \"description\": \"Major rebranding event: Windsurf is now Devin Desktop. The over-the-air update transitioned the AI code editor name while preserving all user plans, pricing, extensions, and settings automatically with no action required from users.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-06-02\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The rebrand from Windsurf to Devin Desktop was seamless for users\",\n        \"source\": \"Releasebot.io\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Gemini CLI Sunset - Transition to Antigravity CLI\",\n    \"description\": \"Google announced that Gemini CLI is being sunsetted on June 18, 2026, and is transitioning users to 'Antigravity CLI'. The change affects free Google accounts, Google AI Pro subscribers, and Google AI Ultra users, though enterprise customers may retain access.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://developers.googleblog.com/an-important-update-transitioning-gemini-cli-to-antigravity-cli/\",\n    \"date\": \"2026-06-18\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Users discussed the transition on Hacker News and Reddit, with mixed reactions about moving from an open-source solution to a proprietary one\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Aider Main Branch Updates with New Model Support\",\n    \"description\": \"Aider's main branch added support for Claude 4.5/4.6 models and updated model aliases, expanded Gemini model support with 2.5 Flash and Flash-Lite, added Gemini 3 preview models, and added DeepSeek Reasoner model support.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://aider.chat/HISTORY.html\",\n    \"date\": \"2026-06-15\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Aider v0.86.2 remains the latest stable release since February 12, 2026, with continuous improvements on main branch\",\n        \"source\": \"Developers Digest\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  }\n]\n",
