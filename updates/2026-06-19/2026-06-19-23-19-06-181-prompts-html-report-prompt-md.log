      "content": "[\n  {\n    \"title\": \"Datasette Apps: Host custom HTML applications inside Datasette\",\n    \"description\": \"Simon Willison launched a new plugin for Datasette (datasette-apps) that allows hosting custom HTML applications inside Datasette. The plugin focuses on sandboxing with strict Content Security Policy and iframe permissions, enabling users to build and share interactive applications while maintaining security boundaries.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jun/18/datasette-apps/\",\n    \"published_date\": \"2026-06-18\",\n    \"topics\": [\"datasette\", \"web-development\", \"sandboxing\", \"html-applications\", \"content-security-policy\", \"iframes\", \"javascript\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"GLM-5.2 is probably the most powerful text-only open weights LLM\",\n    \"description\": \"Chinese AI lab Z.ai released GLM-5.2, a 753B parameter Mixture-of-Experts model with 40 active parameters, under MIT license. Key features: 1 million token context window (up from 200k), text-only input, and 1.51TB model size. Simon notes this as likely the most powerful text-only open weights model available.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jun/17/glm-52/\",\n    \"published_date\": \"2026-06-17\",\n    \"topics\": [\"llms\", \"open-weights\", \"glm\", \"ai-in-china\", \"mixture-of-experts\", \"context-window\", \"ai-research\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Datasette 1.0a34: Tools to insert, edit and delete rows\",\n    \"description\": \"Datasette alpha release adds long-overdue UI tools for inserting, editing, and deleting rows directly within the Datasette interface. The feature was inspired by Datasette Agent, which already had these capabilities via chat - highlighting the absurdity of having features in AI chat but not the main UI.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jun/16/datasette-103a34/\",\n    \"published_date\": \"2026-06-16\",\n    \"topics\": [\"datasette\", \"ui-design\", \"database-tools\", \"sql\", \"ai-assisted-programming\", \"datasette-agent\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Why AI hasn't replaced software engineers, and won't\",\n    \"description\": \"Arvind Narayanan and Sayash Kapoor argue there's enough evidence to reject the narrative that AI will cause mass layoffs in software engineering. Key findings: (1) In the first year of NY's AI disclosure requirement, zero companies checked the AI box on WARN notices; (2) Real bottlenecks are deciding/specifying what to build, verifying/accountability for delivery, and deep human understanding - not typing code; (3) AI helps with deciding and verifying steps, but deep human understanding remains key.\",\n    \"author\": \"Simon Willison (quoting Arvind Narayanan and Sayash Kapoor)\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jun/14/why-ai-hasnt-replaced-software-engineers/\",\n    \"published_date\": \"2026-06-14\",\n    \"topics\": [\"ai-ethics\", \"careers\", \"software-engineering\", \"ai-impact\", \"job-automation\", \"arvind-narayanan\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"The Fable 5 Export Controls: US Government Bans Claude Fable 5\",\n    \"description\": \"The US government issued an export control directive to suspend all access to Fable 5 and Mythos 5 for foreign nationals, citing national security concerns about a potential jailbreak. Anthropic states the jailbreak involves asking the model to 'read a specific codebase and fix any software flaws' - which they note is a defensive security task used daily by security professionals. Simon tracked his access being cut off at 6:59pm Pacific on June 12, 2026.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jun/13/statement-on-fable-mythos-access/\",\n    \"published_date\": \"2026-06-13\",\n    \"topics\": [\"ai-policy\", \"anthropic\", \"claude-fable\", \"claude-mythos\", \"export-controls\", \"ai-security\", \"jailbreaking\", \"government-regulation\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Publishing WASM wheels to PyPI for use with Pyodide\",\n    \"description\": \"Simon built a tool to publish WebAssembly (WASM) wheels to PyPI for use with Pyodide (Python in the browser). The Pyodide 314.0 release announcement included news about proper WASM wheel support, enabling Python packages to run directly in the browser through WebAssembly.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jun/13/wasm-wheels-pypi-pyodide/\",\n    \"published_date\": \"2026-06-13\",\n    \"topics\": [\"python\", \"webassembly\", \"wasm\", \"pyodide\", \"pypi\", \"browser-python\", \"packaging\"],\n    \"type\": \"technical\"\n  }\n]\n",
