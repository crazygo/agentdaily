meta\">\n                        <span class=\"source\">2026-06-02</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <span class=\"update-type feature\">Feature</span>\n                    <div class=\"item-title\"><a href=\"https://support.claude.com/en/articles/12138966-release-notes\" target=\"_blank\">Claude Fable 5 Launch</a></div>\n                    <div class=\"item-description\">Anthropic launched Claude Fable 5, a Mythos-class model made safe for general use</div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">2026-06-09</span>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Technical Insights Column -->\n            <section class=\"column technical-insights\">\n                <div class=\"column-header\">Technical Insights (6)</div>\n\n                <div class=\"item\">\n                    <span class=\"insight-type technical\">Technical</span>\n                    <div class=\"item-title\"><a href=\"https://simonwillison.net/2026/Jun/18/datasette-apps/\" target=\"_blank\">Datasette Apps: Host custom HTML applications inside Datasette</a></div>\n                    <div class=\"insight-author\">Simon Willison</div>\n                    <div class=\"item-description\">New plugin allows hosting custom HTML applications with strict Content Security Policy and iframe permissions</div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">datasette</span>\n                        <span class=\"tag\">sandboxing</span>\n                        <span class=\"tag\">html-applications</span>\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"source\">2026-06-18</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <span class=\"