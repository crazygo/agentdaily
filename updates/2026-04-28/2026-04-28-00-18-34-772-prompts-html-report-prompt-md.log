roductName\": \"Windsurf\",\n    \"title\": \"OAuth Authentication Fixes\",\n    \"description\": \"Fixed OAuth authentication issues for some MCP servers in version 2.0.67.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-04-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Devin Cloud Connection Improvements\",\n    \"description\": \"Improved reliability of Devin Cloud connections in Windsurf and fixed OAuth integration regression for some MCP servers.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-04-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"April 2026 Update\",\n    \"description\": \"Claude Code released major updates including the /powerup onboarding system, expanded MCP with 500K tool limits, improved subagent capabilities, and Agent SDK rewrite.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://blog.mean.ceo/claude-code-news-april-2026/\",\n    \"date\": \"2026-04-16\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Claude Opus 4.7 Integration\",\n    \"description\": \"Claude Opus 4.7 is now available in Windsurf, bringing Anthropic's latest model to the editor.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-04-16\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Canvases Feature\",\n    \"description\": \"Cursor introduced interactive canvases that can include visualizations, dashboards, and custom interfaces built using first-party components.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Async Multitasking in Agents Window\",\n    \"description\": \"New async multitasking capabilities allow AI agents to work on multiple tasks simultaneously with /multitask command.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Multi-root Workspaces\",\n    \"description\": \"Agents Window now supports multi-root workspaces for making cross-repo changes spanning frontend, backend, and shared libraries.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  }\n]\n",
