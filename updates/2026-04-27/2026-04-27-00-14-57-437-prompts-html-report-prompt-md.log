      "content": "[\n  {\n    \"title\": \"SWE-bench Verified No Longer Measures Frontier Coding Capabilities\",\n    \"description\": \"Discussion on Hacker News about why the SWE-bench Verified benchmark no longer effectively measures frontier AI coding capabilities. Suggests benchmarks need updating as AI coding agents improve.\",\n    \"author\": \"OpenAI / Hacker News\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-04-27\",\n    \"topics\": [\n      \"benchmarks\",\n      \"AI-coding\",\n      \"evaluation\",\n      \"SWE-bench\"\n    ],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"The West Forgot How to Make Things, Now It's Forgetting How to Code\",\n    \"description\": \"Highly-discussed article (784 points on HN) about declining software engineering skills and the implications of increased reliance on AI coding tools. Community debate about whether AI is accelerating skill atrophy or transforming software development.\",\n    \"author\": \"Tech Trenches / Hacker News\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-04-27\",\n    \"topics\": [\n      \"AI-coding\",\n      \"software-engineering\",\n      \"education\",\n      \"skill-decline\"\n    ],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Using Coding Assistance Tools to Revive Abandoned Projects\",\n    \"description\": \"Popular Hacker News discussion (306 points) about using AI coding assistants to revive and finish projects that were never going to be completed. Community sharing experiences of using AI tools to tackle old codebases and unfinished work.\",\n    \"author\": \"Matthew Brunelle / Hacker News\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-04-26\",\n    \"topics\": [\n      \"AI-coding\",\n      \"productivity\",\n      \"developer-tools\",\n      \"codebase-maintenance\"\n    ],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Amateur Armed with ChatGPT Solves Erd\\u0151s Problem\",\n    \"description\": \"Viral story (554 points on HN) about an amateur mathematician using ChatGPT to solve an Erd\\u0151s conjecture problem. Demonstrates how AI tools are enabling non-experts to make contributions to specialized fields.\",\n    \"author\": \"Scientific American / Hacker News\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-04-26\",\n    \"topics\": [\n      \"ChatGPT\",\n      \"mathematics\",\n      \"AI-research\",\n      \"democratization\"\n    ],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"OpenAI Privacy Filter Released\",\n    \"description\": \"OpenAI released a privacy filter (255 points on HN), likely addressing concerns about data handling and privacy in AI systems. Community interest in privacy-preserving AI technologies.\",\n    \"author\": \"OpenAI / Hacker News\",\n    \"source\": \"HN\",\n    \"url\": \"https://news.ycombinator.com\",\n    \"published_date\": \"2026-04-26\",\n    \"topics\": [\n      \"OpenAI\",\n      \"privacy\",\n      \"AI-safety\",\n      \"data-protection\"\n    ],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Google to Invest Up to $40B in Anthropic\",\n    \"description\": \"Google will invest $10B initially in Anthropic, with potential for up to $30B more if performance targets are met. Amazon also invested $5B on Monday and could commit up to an additional $20B. Massive capital inflows into AI safety-focused lab.\",\n    \"author\": \"Rebecca Bellan / TechCrunch\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://techcrunch.com\",\n    \"published_date\": \"2026-04-25\",\n    \"topics\": [\n      \"Anthropic\",\n      \"Google\",\n      \"Amazon\",\n      \"investment\",\n      \"funding\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"OpenAI Releases GPT-5.5\",\n    \"description\": \"OpenAI released GPT-5.5, described as the company's 'smartest and most intuitive' model yet. Said to be better at coding and more efficient, bringing company closer to an AI 'super app'.\",\n    \"author\": \"Lucas Ropek / TechCrunch\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://techcrunch.com\",\n    \"published_date\": \"2026-04-25\",\n    \"topics\": [\n      \"OpenAI\",\n      \"GPT-5.5\",\n      \"LLM\",\n      \"coding\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ComfyUI Hits $500M Valuation\",\n    \"description\": \"ComfyUI reached $500M valuation as creators seek more control over AI-generated media. Node-based UI for AI image generation gaining traction as users want greater control and customization.\",\n    \"author\": \"Marina Temkin / TechCrunch\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://techcrunch.com\",\n    \"published_date\": \"2026-04-25\",\n    \"topics\": [\n      \"ComfyUI\",\n      \"AI-tools\",\n      \"generative-AI\",\n      \"image-generation\",\n      \"funding\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"DeepSeek V4\\u2014almost on the frontier, a fraction of the price\",\n    \"description\": \"Chinese AI lab DeepSeek released V4 preview models (V4-Pro and V4-Flash), positioning them as competitive with frontier models at significantly lower pricing points. This follows their V3.2 release from last December.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\n      \"LLM\",\n      \"AI models\",\n      \"DeepSeek\",\n      \"Chinese AI\",\n      \"pricing\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Claude Code Quality Issues: Postmortem Analysis\",\n    \"description\": \"Anthropic released a postmortem explaining why Claude Code was providing worse quality results over the past two months. Three separate bugs in the Claude Code harness caused issues, including a bug that kept clearing thinking from idle sessions every turn instead of just once, making Claude seem forgetful and repetitive.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\n      \"Claude\",\n      \"Anthropic\",\n      \"coding-agents\",\n      \"bugs\",\n      \"postmortem\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Serving the Bluesky For You Feed: SQLite at Scale\",\n    \"description\": \"The Bluesky 'For You' feed serves ~72,000 users from a single Go process using SQLite on a gaming PC with 16 cores, 96GB RAM and 4TB NVMe. Total cost is $30/month. Shows how far SQLite can scale for real-time recommendation engines.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\n      \"SQLite\",\n      \"scaling\",\n      \"Bluesky\",\n      \"Go\",\n      \"software-architecture\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"SpaceX Working with Cursor, $60B Acquisition Option\",\n    \"description\": \"SpaceX is working with AI coding startup Cursor and has an option to buy the company for $60 billion. Shows the strategic value of AI coding tools in major technology companies.\",\n    \"author\": \"Tim Fernholz / TechCrunch\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://techcrunch.com\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\n      \"SpaceX\",\n      \"Cursor\",\n      \"AI-coding\",\n      \"acquisition\",\n      \"M&A\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ArXiv Papers: Tool Attention Is All You Need for Scalable Agentic Workflows\",\n    \"description\": \"Paper introducing 'Tool Attention Is All You Need: Dynamic Tool Gating and Lazy Schema Loading for Eliminating the MCP/Tools Tax in Scalable Agentic Workflows' - addresses efficiency challenges in AI agent tool use.\",\n    \"author\": \"Anuj Sadani, Deepak Kumar / ArXiv\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2604.21816\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\n      \"AI-agents\",\n      \"tool-use\",\n      \"MCP\",\n      \"efficiency\",\n      \"scaling\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ArXiv Papers: Multi-Agent Empowerment and Emergence of Complex Behavior\",\n    \"description\": \"Research on 'Multi-Agent Empowerment and Emergence of Complex Behavior in Groups' exploring how complex behaviors emerge in multi-agent systems through empowerment mechanisms.\",\n    \"author\": \"Tristan Shah et al. / ArXiv\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2604.21155\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\n      \"multi-agent-systems\",\n      \"emergence\",\n      \"AI-research\",\n      \"complexity\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ArXiv Papers: Thinking with Reasoning Skills\",\n    \"description\": \"Paper on 'Thinking with Reasoning Skills: Fewer Tokens, More Accuracy' presents techniques to improve LLM reasoning efficiency by using explicit reasoning skills, achieving better accuracy with fewer tokens.\",\n    \"author\": \"Guangxiang Zhao et al. / ArXiv\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2604.21764\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\n      \"LLM\",\n      \"reasoning\",\n      \"efficiency\",\n      \"tokens\",\n      \"AI-research\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ArXiv Papers: Agentic AI for Science Automation\",\n    \"description\": \"Research on 'From Research Question to Scientific Workflow: Leveraging Agentic AI for Science Automation' explores how AI agents can automate scientific research workflows from hypothesis to results.\",\n    \"author\": \"Bartosz Balis et al. / ArXiv\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2604.21910\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\n      \"AI-agents\",\n      \"scientific-research\",\n      \"automation\",\n      \"workflows\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ArXiv Papers: Probabilistic Verification of Neural Networks\",\n    \"description\": \"Paper on 'Probabilistic Verification of Neural Networks via Efficient Probabilistic Hull Generation' presents methods for verifying neural network behavior using probabilistic techniques.\",\n    \"author\": \"Jingyang Li et al. / ArXiv\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2604.21556\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\n      \"neural-networks\",\n      \"verification\",\n      \"AI-safety\",\n      \"formal-methods\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ArXiv Papers: Separable Expert Architecture for Privacy-Preserving LLM Personalization\",\n    \"description\": \"Research on 'Separable Expert Architecture: Toward Privacy-Preserving LLM Personalization via Composable Adapters and Deletable User Proxies' presents techniques for personalizing LLMs while preserving user privacy.\",\n    \"author\": \"Chris Schneider et al. / ArXiv\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2604.21571\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\n      \"LLM\",\n      \"personalization\",\n      \"privacy\",\n      \"adapters\",\n      \"architecture\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Claude Connecting Directly to Personal Apps\",\n    \"description\": \"Anthropic announced Claude is connecting directly to personal apps like Spotify, Uber Eats, and TurboTax. This represents a move towards deeper integration of AI assistants into daily workflows and services.\",\n    \"author\": \"The Verge\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://www.theverge.com\",\n    \"published_date\": \"2026-04-23\",\n    \"topics\": [\n      \"Anthropic\",\n      \"Claude\",\n      \"AI-agents\",\n      \"integration\",\n      \"apps\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"AI Threatens to Widen Inequality Gap\",\n    \"description\": \"MIT professor Daron Acemoglu warns that AI will increase inequality between labor and capital. 'You require a certain degree of education, abstract and quantitative skills, familiarity with computers and coding in order to be using the models.' AI could help the rich get richer rather than democratize access.\",\n    \"author\": \"Stevie Bonifield / The Verge\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://www.theverge.com\",\n    \"published_date\": \"2026-04-23\",\n    \"topics\": [\n      \"AI\",\n      \"inequality\",\n      \"economics\",\n      \"labor\",\n      \"education\"\n    ],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Extract PDF Text in Browser with LiteParse\",\n    \"description\": \"Browser-based version of LlamaIndex's LiteParse tool for extracting text from PDFs entirely in the browser using the same libraries that run in Node.js. Shows the trend toward client-side AI processing.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-23\",\n    \"topics\": [\n      \"PDF\",\n      \"browser\",\n      \"LLM\",\n      \"LlamaIndex\",\n      \"client-side\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"GPT-5.5 via Codex Backdoor API\",\n    \"description\": \"Simon tested GPT-5.5 available in OpenAI Codex and rolling out to paid ChatGPT subscribers. Found it to be fast, effective and highly capable. 'It's hard to put into words what's good about it\\u2014I ask it to build things and it builds exactly what I ask for!'\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-23\",\n    \"topics\": [\n      \"OpenAI\",\n      \"GPT-5.5\",\n      \"coding\",\n      \"LLM\"\n    ],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Qwen3.6-27B: Flagship-Level Coding in 27B Dense Model\",\n    \"description\": \"Qwen claims their new 27B model delivers flagship-level agentic coding performance, surpassing their previous 397B MoE model. Available as a 16.8GB GGUF quantized version that runs locally with excellent results on code generation tasks.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-22\",\n    \"topics\": [\n      \"Qwen\",\n      \"local-llms\",\n      \"coding\",\n      \"quantization\",\n      \"AI-in-china\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Firefox 150: Claude Mythos Found 271 Vulnerabilities\",\n    \"description\": \"Mozilla's CTO Bobby Holley announced that Firefox 150 includes fixes for 271 vulnerabilities identified by Claude Mythos Preview. Called it a hopeful experience showing defenders have a chance to win decisively. Mythos is 'every bit as capable' as top security researchers.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-22\",\n    \"topics\": [\n      \"Anthropic\",\n      \"Claude\",\n      \"Mythos\",\n      \"Firefox\",\n      \"Mozilla\",\n      \"security\",\n      \"AI-security-research\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"GitHub Copilot Individual Plans: Major Pricing Changes\",\n    \"description\": \"GitHub updated Copilot pricing: tightening usage limits, pausing signups for individual plans, restricting Claude Opus 4.7 to $39/month 'Pro+' plan, and dropping previous Opus models. Reason: Agentic workflows fundamentally changed compute demands - long-running parallelized sessions consume far more resources than original plan structure supported.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-22\",\n    \"topics\": [\n      \"GitHub\",\n      \"Microsoft\",\n      \"GitHub-Copilot\",\n      \"LLM\",\n      \"pricing\",\n      \"coding-agents\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Google: 75% of All New Code is AI-Generated\",\n    \"description\": \"Google CEO Sundar Pichai revealed that 75% of all Google's new code is AI-generated, up from 50% last fall. Google created a 'strike team' to improve AI models' coding capabilities and catch up to Anthropic, which writes 70-90% of its code with Claude Code as of February.\",\n    \"author\": \"Stevie Bonifield / The Verge\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://www.theverge.com\",\n    \"published_date\": \"2026-04-22\",\n    \"topics\": [\n      \"Google\",\n      \"AI-coding\",\n      \"Anthropic\",\n      \"Claude\",\n      \"software-engineering\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Anthropic's Mythos Breach: Unauthorized Access\",\n    \"description\": \"Unauthorized group gained access to Anthropic's exclusive cyber tool Mythos. The breach was described as 'humiliating' for the company. Mythos is Anthropic's most powerful cybersecurity-focused AI model.\",\n    \"author\": \"Lucas Ropek / The Verge\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://www.theverge.com\",\n    \"published_date\": \"2026-04-22\",\n    \"topics\": [\n      \"Anthropic\",\n      \"Mythos\",\n      \"security\",\n      \"breach\",\n      \"AI-safety\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ChatGPT Images 2.0: Where's the Raccoon with the Ham Radio?\",\n    \"description\": \"Review of OpenAI's ChatGPT Images 2.0. Sam Altman said the leap from gpt-image-1 to gpt-image-2 was equivalent to jumping from GPT-3 to GPT-5. Simon tested it with increasingly absurd prompts including a raccoon with a ham radio hiding in crowds.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-21\",\n    \"topics\": [\n      \"OpenAI\",\n      \"image-generation\",\n      \"GPT-Image-2\",\n      \"AI-art\"\n    ],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Claude Opus 4.7 Token Count Analysis: 1.46x Increase\",\n    \"description\": \"Analysis of Claude Opus 4.7's new tokenizer shows it uses 1.46x more tokens than 4.6 for the same content, effectively making it ~40% more expensive despite same pricing. For images, can be up to 3.01x more tokens due to higher resolution support (up to 2,576 pixels on long edge).\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-20\",\n    \"topics\": [\n      \"Anthropic\",\n      \"Claude\",\n      \"tokenization\",\n      \"LLM\",\n      \"pricing\"\n    ],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Headless Services: The Future of Personal AI\",\n    \"description\": \"Discussion about 'headless' services becoming more common as personal AIs provide better user experiences than direct service interaction. Salesforce announced 'Salesforce Headless 360' exposing everything as APIs, MCP, & CLI. This trend could disrupt per-head SaaS pricing.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-19\",\n    \"topics\": [\n      \"APIs\",\n      \"AI-agents\",\n      \"Salesforce\",\n      \"SaaS\",\n      \"pricing\"\n    ],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Changes in System Prompt Between Claude Opus 4.6 and 4.7\",\n    \"description\": \"Analysis of how Anthropic's system prompt evolved between Claude Opus 4.6 and 4.7. Anthropic is the only major AI lab to publish system prompts for their user-facing chat systems, providing transparency into how models are configured.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net\",\n    \"published_date\": \"2026-04-18\",\n    \"topics\": [\n      \"Anthropic\",\n      \"Claude\",\n      \"system-prompts\",\n      \"transparency\",\n      \"LLM\"\n    ],\n    \"type\": \"technical\"\n  }\n]",
