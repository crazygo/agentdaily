      "filePath": "/home/runner/work/agentdaily/agentdaily/updates/2026-04-18/whitelist-updates.json",
      "content": "[\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot CLI Auto Model Selection\",\n    \"description\": \"GitHub Copilot CLI now supports Copilot auto model selection, automatically choosing the most appropriate model for the task based on performance, speed, and availability.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-04-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Claude Opus 4.7 Generally Available\",\n    \"description\": \"Anthropic's latest Opus model, Claude Opus 4.7, is now rolling out on GitHub Copilot. The model delivers stronger multi-step task performance and more reliable agentic execution based on early testing.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-04-16-claude-opus-4-7-is-generally-available/\",\n    \"date\": \"2026-04-16\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Manage Agent Skills with GitHub CLI\",\n    \"description\": \"New 'gh skill' command in GitHub CLI makes it easy to discover, install, and manage agent skills, which are reshaping how developers work with AI coding agents.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-04-16-manage-agent-skills-with-github-cli/\",\n    \"date\": \"2026-04-16\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Background Agents in Slack Integration\",\n    \"description\": \"You can now launch Background Agents directly from Slack by mentioning @Cursor. Agents can read the thread, understand context, and create PRs in GitHub without leaving the conversation. Agents run remotely in secure environments with updates directly in Slack.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Cloud Agent Policy via Custom Properties\",\n    \"description\": \"Organizations can now selectively enable GitHub Copilot cloud agent (CCA) access on a per-organization basis using custom properties, replacing the previous all-or-nothing approach for enterprise admins and AI managers.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-04-15-enable-copilot-cloud-agent-via-custom-properties/\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Close PR or Convert to Draft in Review UI\",\n    \"description\": \"The PR review merge bar now includes options to close a PR or convert it to a draft directly from the review page. Additional improvements include inline session rename, smart table column sizing, faster sidebar session loading, and multiple MCP server integrations.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/2026\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Model Selection for Claude and Codex Agents on GitHub.com\",\n    \"description\": \"Model selection is now available for Claude and Codex third-party coding agents on github.com. Users can select a model when initiating agent work, similar to Copilot cloud agent functionality.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-04-14-model-selection-for-claude-and-codex-agents-on-github-com/\",\n    \"date\": \"2026-04-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Fix Merge Conflicts with Copilot Cloud Agent\",\n    \"description\": \"New 'Fix with Copilot' button on github.com allows fixing merge conflicts in three clicks powered by Copilot cloud agent. Clicking the button triggers a comment from the agent to resolve conflicts automatically.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-04-13-fix-merge-conflicts-in-three-clicks-with-copilot-cloud-agent/\",\n    \"date\": \"2026-04-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Data Residency in US + EU and FedRAMP Compliance\",\n    \"description\": \"GitHub Copilot now supports data residency for US and EU regions, ensuring all inference processing and associated data stay within designated geography. For US government customers, all model hosts achieved FedRAMP compliance.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-04-13-copilot-data-residency-in-us-eu-and-fedramp-compliance-now-available/\",\n    \"date\": \"2026-04-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Remote Control CLI Sessions on Web and Mobile in Public Preview\",\n    \"description\": \"Remote control for CLI sessions is now in public preview, allowing users to control CLI sessions from web and mobile interfaces. This enables development workflow continuity across devices.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-04-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Claude Code Version 2.1.69-2.1.101 Release Wave\",\n    \"description\": \"Claude Code underwent intensive iteration from v2.1.69 to v2.1.101 between March and April 2026. Key updates include Remote Control for browser/mobile access, Multi-Repository Context Window for working across multiple repos, Enhanced Collaborative Tools (announced April 11), MCP (Model Context Protocol) enhancements, improved VS Code integration, and enhanced autonomous coding features achieving 80.8% on SWE-bench and 72.5% on OSWorld.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://www.getaiperks.com/en/articles/claude-code-updates\",\n    \"date\": \"2026-04-11\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor 1.0 Release with BugBot, GA Background Agent, and MCP One-Click Install\",\n    \"description\": \"Cursor 1.0 introduces BugBot for automatic code review and bug detection, Background Agent now available to all users, Agent support for Jupyter Notebooks, Memories beta feature, MCP one-click install with OAuth support, richer chat responses with visualizations, and new Dashboard with usage analytics.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-04-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Auto-merge from Devin Review\",\n    \"description\": \"You can now enable or disable GitHub auto-merge directly from the Devin Review merge button, so approved pull requests land as soon as checks pass without an extra trip to GitHub. Enterprise review consumption now grouped by repository with search and CSV export.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/2026\",\n    \"date\": \"2026-04-08\",\n    \"community_feedback\": []\n  }\n]\n",
