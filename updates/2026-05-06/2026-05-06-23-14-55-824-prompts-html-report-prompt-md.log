      "content": "[\n  {\n    \"title\": \"SAP Bets $1.16B on 18-Month-Old German AI Lab Prior Labs\",\n    \"description\": \"SAP announced plans to acquire German AI startup Prior Labs for an undisclosed amount and invest €1 billion (approximately $1.16 billion) over four years. Prior Labs, founded just 18 months ago, focuses on tabular foundation models (TFMs) for structured data. The startup's TabPFN models have been downloaded over 3 million times. SAP also announced strict AI agent policies, prohibiting unauthorized agents like OpenClaw while allowing SAP-endorsed architectures including Nvidia's NemoClaw.\",\n    \"author\": \"Anna Heim\",\n    \"source\": \"TechCrunch\",\n    \"url\": \"https://techcrunch.com/2026/05/05/sap-bets-1-16b-on-18-month-old-german-ai-lab-and-says-yes-to-nemoclaw/\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"ai\", \"mergers-and-acquisitions\", \"agentic-ai\", \"tabular-data\", \"prior-labs\", \"sap\", \"nvidia\", \"nemoclaw\"],\n    \"type\": \"news\"\n  },\n  {\n    \"title\": \"Y Combinator's Stake in OpenAI: 0.6% Worth Over $5 Billion\",\n    \"description\": \"John Gruber reveals that Y Combinator owns approximately 0.6% of OpenAI, worth over $5 billion at OpenAI's current $852 billion valuation. This information was notably difficult to obtain despite being known to some investors.\",\n    \"author\": \"John Gruber (via Simon Willison)\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/May/5/y-combinator-openai-stake/\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"openai\", \"y-combinator\", \"ai\", \"investment\", \"valuation\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Image AI Models Now Drive App Growth, Beating Chatbot Upgrades\",\n    \"description\": \"Appfigures report finds that image model releases generate 6.5x more downloads than traditional model updates. Gemini's Nano Banana drove 22+ million downloads in 28 days (4x lift), while ChatGPT added 12M+ installs after GPT-4o image model. However, download spikes don't always convert to revenue - only ChatGPT successfully converted image model attention to $70M in consumer spending, while Gemini generated only $181K and Meta AI's Vibes saw no meaningful revenue.\",\n    \"author\": \"Sarah Perez\",\n    \"source\": \"TechCrunch\",\n    \"url\": \"https://techcrunch.com/2026/05/04/image-ai-models-now-drive-app-growth-beating-chatbot-upgrades/\",\n    \"published_date\": \"2026-05-04\",\n    \"topics\": [\"ai\", \"mobile-apps\", \"image-models\", \"chatgpt\", \"gemini\", \"meta-ai\", \"revenue\", \"user-growth\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"IBM Releases Granite 4.1 Family of Apache 2.0 LLMs\",\n    \"description\": \"IBM released Granite 4.1 LLMs in 3B, 8B, and 30B sizes, all Apache 2.0 licensed. Simon Willison tested SVG generation capabilities of quantized variants using 'pelican riding a bicycle' prompts, finding that smaller models didn't necessarily perform worse than larger ones for this task.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/May/4/granite-4-1/\",\n    \"published_date\": \"2026-05-04\",\n    \"topics\": [\"ibm\", \"llms\", \"open-source\", \"generative-ai\", \"model-release\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Claude Code Helps Build Python Bindings and Test Regular Expression Security\",\n    \"description\": \"Simon Willison used Claude Code to build experimental Python bindings for Ville Laurikari's TRE regular expression engine using ctypes, then tested malicious regex attacks. TRE handled attacks better than Python's standard library due to lack of backtracking support.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/May/4/redis-tre-regex/\",\n    \"published_date\": \"2026-05-04\",\n    \"topics\": [\"ai\", \"claude-code\", \"regex\", \"security\", \"python\", \"redis\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Salvatore Sanfilippo Adds Array Data Type to Redis with AI Assistance\",\n    \"description\": \"Redis creator Salvatore Sanfilippo submitted a PR adding a new array data type to Redis with 17 new commands (ARCOUNT, ARDEL, ARGET, etc.). The most interesting is ARGREP for server-side grep using the TRE regex library. Simon built an interactive playground for testing the new commands using Claude Code.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/May/4/redis-arrays/\",\n    \"published_date\": \"2026-05-04\",\n    \"topics\": [\"redis\", \"ai-assisted-programming\", \"databases\", \"claude-code\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"'This is Fine' Creator Says AI Startup Artisan Stole His Art\",\n    \"description\": \"KC Green, creator of the 'This is fine' meme, says AI startup Artisan used his art in subway ads without permission. The ads feature the smiling dog surrounded by flames saying 'my pipeline is on fire' and urge passersby to 'Hire Ava the AI BDR.' Green told followers to 'please vandalize it if and when you see it' and said 'it's been stolen like AI steals.' Artisan previously courted controversy with billboards urging businesses to 'Stop hiring humans.'\",\n    \"author\": \"Anthony Ha\",\n    \"source\": \"TechCrunch\",\n    \"url\": \"https://techcrunch.com/2026/05/03/this-is-fine-creator-says-ai-startup-stole-his-art/\",\n    \"published_date\": \"2026-05-03\",\n    \"topics\": [\"ai\", \"copyright\", \"artisan\", \"memes\", \"intellectual-property\", \"ai-ethics\"],\n    \"type\": \"news\"\n  },\n  {\n    \"title\": \"Anthropic Research: Claude Shows Sycophancy in 38% of Spirituality Conversations\",\n    \"description\": \"Anthropic's research on sycophancy found that while Claude showed sycophantic behavior in only 9% of conversations overall, this jumped to 38% for spirit