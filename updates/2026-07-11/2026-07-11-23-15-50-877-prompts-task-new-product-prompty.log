 [\"The agent-native way to ship software\"]\n  },\n  {\n    \"name\": \"Termi Protocol\",\n    \"url\": \"https://www.producthunt.com/products/termi-protocol\",\n    \"description\": \"Watch your AI coding agents build, live in 3D. A productivity tool that provides 3D visualization of AI coding agents in action.\",\n    \"release_date\": \"2026-07-04\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"Watch your AI coding agents build, live in 3D\"]\n  },\n  {\n    \"name\": \"Tamamon\",\n    \"url\": \"https://www.producthunt.com/products/tamamon\",\n    \"description\": \"A desktop pet that grows as you code with Claude Code. A Mac productivity tool and developer companion that gamifies the coding experience with Claude Code.\",\n    \"release_date\": \"2026-07-03\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"A desktop pet that grows as you code with Claude Code\"]\n  },\n  {\n    \"name\": \"Vox\",\n    \"url\": \"https://www.producthunt.com/products/vox\",\n    \"description\": \"Voice in, voice out — with GitHub Copilot. A developer tool that provides voice input and output capabilities integrated with GitHub Copilot.\",\n    \"release_date\": \"2026-07-03\",\n    \"category\": \"IDE-integrated AI tool\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"Voice in, voice out — with GitHub Copilot\"]\n  },\n  {\n    \"name\": \"Glaze by Raycast\",\n    \"url\": \"https://www.producthunt.com/products/glaze\",\n    \"description\": \"Create your own Mac apps by chatting with AI. A Mac productivity tool that enables creating Mac applications through conversational AI interaction.\",\n    \"release_date\": \"2026-07-03\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"Create your own Mac apps by chatting with AI\"]\n  },\n  {\n    \"name\": \"Archify\",\n    \"url\": \"