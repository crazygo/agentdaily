      "content": "[\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Continue v1.3.38 - Config and Filtering Enhancements\",\n    \"description\": \"Added .continue/configs support for configuration management, filter session history by workspace directory, and multiple fixes including ensuring config.yaml exists when accessed. Includes dependency updates and various improvements.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/continuedev/continue/releases\",\n    \"date\": \"2026-04-18\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Claude Opus 4.7 and Claude Design Launch\",\n    \"description\": \"Anthropic launched Claude Opus 4.7, their latest model with improvements in software engineering, complex coding tasks, and better vision capabilities. Alongside this, they introduced Claude Design, an Anthropic Labs product for collaborating on visual outputs like designs, prototypes, and slides.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://support.claude.com/en/articles/12138966-release-notes\",\n    \"date\": \"2026-04-16\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Claude Opus 4.7 is a serious regression, not an upgrade\",\n        \"source\": \"Reddit (r/ClaudeAI)\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"horrible at writing, sloppy, unprecise, very empty sentences\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"4.7 seems pretty good about clarifying things compared to 4.6\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"4.7 seems better primarily because 4.6 had degraded in quality before the update\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Canvases - Interactive Visualizations\",\n    \"description\": \"Cursor can now respond by creating interactive canvases with visualizations including dashboards and custom interfaces. These are built using first-party components like tables, boxes, diagrams, and charts, and live as durable artifacts in the side panel.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Aider v0.86.0 - GPT-5 Support and New Models\",\n    \"description\": \"Added support for all GPT-5 models, Grok-4 via xAI and OpenRouter, Gemini 2.5 Flash Lite, and MoonshotAI Kimi K2. Enhanced /clear and /undo commands, and improved model settings handling. Aider wrote 88% of the code in this release.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/Aider-AI/aider/releases\",\n    \"date\": \"2026-04-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Continue v1.3.36 - JetBrains Fixes and ClawRouter Provider\",\n    \"description\": \"Resolved critical security vulnerabilities, fixed JetBrains remote config sync to prevent IDE freezes, added ClawRouter as a provider for cost-optimized model routing. Includes multiple crash fixes and memory leak prevention.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://github.com/continuedev/continue/releases\",\n    \"date\": \"2026-04-12\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Bugbot Learned Rules and MCP Support\",\n    \"description\": \"Bugbot can now learn from feedback on pull requests and turn those signals into learned rules that improve future reviews. Also added MCP support, allowing Bugbot to access MCP servers for additional context during code reviews.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Claude Cowork Generally Available\",\n    \"description\": \"Claude Cowork is now generally available on macOS and Windows with new capabilities including role-based access controls for Enterprise plans. Admins can organize users into groups and assign custom roles defining which Claude capabilities members can use.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://support.claude.com/en/articles/12138966-release-notes\",\n    \"date\": \"2026-04-09\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Aider v0.85.0 - Gemini 2.5 and Responses API\",\n    \"description\": \"Added support for Gemini 2.5 Pro, Flash, and preview models with thinking tokens. Support for Responses API models like o1-pro and o3-pro. Enhanced thinking tokens support, commit language options, and added MATLAB and Clojure repository map support.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/Aider-AI/aider/releases\",\n    \"date\": \"2026-04-07\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Continue v1.3.35 - Model Provider Improvements\",\n    \"description\": \"Added useResponsesApi option, improved OpenRouter integration with Gemini 3 tool support, enhanced vLLM provider to respect user-configured settings, and fixed Ollama tool call parsing errors with actionable error messages.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.com/continuedev/continue/releases\",\n    \"date\": \"2026-04-08\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"New Cursor Interface with Agents Window\",\n    \"description\": \"Cursor 3 introduced a new interface centered around agents with the Agents Window allowing users to run many agents in parallel across repos and environments. Includes Design Mode for annotating UI elements directly in the browser and self-hosted cloud agents support.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-05\",\n    \"community_feedback\": []\n  }\n]\n",
