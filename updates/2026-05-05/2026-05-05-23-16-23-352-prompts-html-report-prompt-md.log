      "content": "[\n  {\n    \"name\": \"Mindra\",\n    \"url\": \"https://www.producthunt.com/posts/mindra\",\n    \"description\": \"Agent teams you can actually delegate to - AI agent system for task delegation and workflow automation targeting developer workflows.\",\n    \"release_date\": \"2026-05-05\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Agent Teams You Can Actually Delegate To\",\n      \"32 upvotes on Product Hunt launch day\"\n    ]\n  },\n  {\n    \"name\": \"Manex\",\n    \"url\": \"https://www.producthunt.com/posts/manex\",\n    \"description\": \"Memory management system for AI workflows with persistent workspace context - preserves useful answers, corrections, and context across sessions.\",\n    \"release_date\": \"2026-05-05\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Preserve useful answers, corrections, and context as memory\",\n      \"Project-long memory for AI workflows\"\n    ]\n  },\n  {\n    \"name\": \"Flowly\",\n    \"url\": \"https://www.producthunt.com/posts/flowly\",\n    \"description\": \"Desktop-based AI assistant for developers - a personal AI assistant native to your desktop that integrates with developer workflows.\",\n    \"release_date\": \"2026-05-05\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Your personal AI assistant, native to your desktop\",\n      \"Designed for developer workflows\"\n    ]\n  },\n  {\n    \"name\": \"cocoindex\",\n    \"url\": \"https://github.com/cocoindex-io/cocoindex\",\n    \"description\": \"An incremental engine for long-horizon AI agents with memory and context management capabilities for long-running coding tasks.\",\n    \"release_date\": \"2026-05-03\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub Trending\"],\n    \"community_quotes\": [\n      \"Incremental engine for long horizon agents\",\n      \"Specializes in long-running agent tasks\",\n      \"Project-long memory across sessions\"\n    ]\n  },\n  {\n    \"name\": \"n8n-mcp\",\n    \"url\": \"https://github.com/czlonkowski/n8n-mcp\",\n    \"description\": \"An MCP (Model Context Protocol) server for Claude Desktop, Claude Code, Windsurf, and Cursor to build n8n automation workflows directly in IDEs.\",\n    \"release_date\": \"2026-05-02\",\n    \"category\": \"IDE integration\",\n    \"sources\": [\"GitHub Trending\"],\n    \"community_quotes\": [\n      \"A MCP for Claude Desktop / Claude Code / Windsurf / Cursor\",\n      \"Build n8n workflows for you\"\n    ]\n  },\n  {\n    \"name\": \"ruflo\",\n    \"url\": \"https://github.com/ruvnet/ruflo\",\n    \"description\": \"Agent orchestration platform for Claude with multi-agent swarms, autonomous workflows, and conversational AI systems. Features RAG integration and native Claude Code/Codex integration.\",\n    \"release_date\": \"2026-05-01\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub Trending\"],\n    \"community_quotes\": [\n      \"The leading agent orchestration platform for Claude\",\n      \"Deploy intelligent multi-agent swarms\",\n      \"Native Claude Code / Codex Integration\"\n    ]\n  },\n  {\n    \"name\": \"jcode\",\n    \"url\": \"https://github.com/1jehuang/jcode\",\n    \"description\": \"A Coding Agent Harness built in Rust for managing AI coding workflows and agents - provides infrastructure for running coding agents.\",\n    \"release_date\": \"2026-05-01\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub Trending\"],\n    \"community_quotes\": [\n      \"Coding Agent Harness\",\n      \"548 stars in one day\"\n    ]\n  },\n  {\n    \"name\": \"browserbase/skills\",\n    \"url\": \"https://github.com/browserbase/skills\",\n    \"description\": \"A Claude Agent SDK with web browsing capabilities, enabling agents to navigate and interact with web pages