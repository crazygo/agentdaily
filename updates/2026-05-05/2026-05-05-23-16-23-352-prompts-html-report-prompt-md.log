      "content": "[\n  {\n    \"title\": \"Standing on the Shoulders of Giants: Stabilized Knowledge Distillation for Cross-Language Code Clone Detection\",\n    \"description\": \"Research on stabilized knowledge distillation for cross-language code clone detection, addressing challenges in detecting similar code across different programming languages. 38 pages.\",\n    \"author\": \"Mohamad Khajezade, Fatemeh H. Fard, Mohamed Sami Shehata\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02860\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"code-clone-detection\", \"cross-language\", \"knowledge-distillation\", \"machine-learning\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"HAAS: A Policy-Aware Framework for Adaptive Task Allocation Between Humans and AI Systems\",\n    \"description\": \"Framework for adaptive task allocation between humans and AI systems with policy awareness. Addresses human-AI collaboration and task distribution challenges.\",\n    \"author\": \"Vicente Pelechano, Antoni Mestre, Manoli Albert, Miriam Gil\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02832\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"human-ai-collaboration\", \"task-allocation\", \"policy-aware\", \"adaptive-systems\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"U-Define: Designing User Workflows for Hard and Soft Constraints in LLM-Based Planning\",\n    \"description\": \"Research on designing user workflows for handling hard and soft constraints in LLM-based planning systems. Explores human-computer interaction challenges with LLM planning agents.\",\n    \"author\": \"Christine P Lee, Xinyu Jessica Wang, Aws Albarghouthi, David Porfirio, Bilge Mutlu\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02765\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"llm-planning\", \"human-computer-interaction\", \"constraints\", \"user-workflows\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Foundation-Model-Based Agents in Industrial Automation: Purposes, Capabilities, and Open Challenges\",\n    \"description\": \"Comprehensive analysis of foundation-model-based agents in industrial automation, comparing classical agent applications with modern foundation models. 35 pages, 8 figures. Discusses purposes, capabilities, and open challenges.\",\n    \"author\": \"Vincent Henkel, Felix Gehlhoff, David Kube, et al.\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02592\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"industrial-automation\", \"foundation-models\", \"ai-agents\", \"manufacturing\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"On Training Large Language Models for Long-Horizon Tasks: An Empirical Study of Horizon Length\",\n    \"description\": \"Empirical study accepted at ICML 2026 on training LLMs for long-horizon tasks, examining how horizon length affects model performance. Research addresses challenges in multi-step reasoning and planning.\",\n    \"author\": \"Sunghwan Kim, Junhee Cho, Beong-woo Kwak, et al.\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02572\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"llms\", \"long-horizon-tasks\", \"training\", \"icml-2026\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Strategy-Aware Optimization Modeling with Reasoning LLMs\",\n    \"description\": \"Research on strategy-aware optimization modeling using reasoning LLMs. Explores how language models can handle optimization problems with strategic considerations.\",\n    \"author\": \"Ruiqing Zhao, Fengzhi Li, Yuan Zuo, et al.\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02545\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"optimization\", \"reasoning-llms\", \"strategy-aware\", \"modeling\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"DataClaw: A Process-Oriented Agent Benchmark for Exploratory Real-World Data Analysis\",\n    \"description\": \"Introduction of DataClaw, a process-oriented agent benchmark designed for exploratory real-world data analysis. Provides framework for evaluating AI agents on complex data analysis tasks.\",\n    \"author\": \"Qiaohong Zhang, Weihao Ye, Jialong Chen, et al.\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02503\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"agent-benchmark\", \"data-analysis\", \"evaluation\", \"real-world-tasks\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Shadow-Loom: Causal Reasoning over Graphical World Model of Narratives\",\n    \"description\": \"Shadow-Loom system for causal reasoning over graphical world models of narratives. 7 pages (28 pages total). Addresses challenge of understanding causality in narrative contexts.\",\n    \"author\": \"David Wilmot\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02475\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"causal-reasoning\", \"narratives\", \"world-models\", \"graphical-reasoning\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Position: How can Graphs Help Large Language Models?\",\n    \"description\": \"Position paper examining how graph structures can enhance large language models. Accepted by Frontiers of Computer Science. Explores synergies between graph-based reasoning and LLMs.\",\n    \"author\": \"Xiyuan Wang, Yi Hu, Yanbo Wang, Chuan Shi, Muhan Zhang\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02452\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"graphs\", \"llms\", \"reasoning\", \"knowledge-graphs\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"FitText: Evolving Agent Tool Ecologies via Memetic Retrieval\",\n    \"description\": \"Research on FitText, a system for evolving agent tool ecologies through memetic retrieval. Explores how AI agents can dynamically develop and refine their tool capabilities.\",\n    \"author\": \"Kyle Zheng, Han Zhang, Renliang Sun, et al.\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02411\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"agent-tools\", \"memetic-retrieval\", \"tool-ecology\", \"evolutionary-systems\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"The Compliance Trap: How Structural Constraints Degrade Frontier AI Metacognition Under Adversarial Pressure\",\n    \"description\": \"Analysis of how structural constraints and compliance requirements can degrade frontier AI metacognitive capabilities under adversarial pressure. 9 pages, includes code and dataset.\",\n    \"author\": \"Rahul Kumar\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02398\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"ai-safety\", \"metacognition\", \"adversarial-pressure\", \"compliance\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"HeavySkill: Heavy Thinking as the Inner Skill in Agentic Harness\",\n    \"description\": \"HeavySkill framework treating heavy thinking as an inner skill in agentic harness systems. 18 pages, 10 figures. Explores how to effectively harness and control deep reasoning capabilities in AI agents.\",\n    \"author\": \"Jianing Wang, Linsen Guo, Zhengyu Chen, et al.\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02396\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"agentic-systems\", \"heavy-thinking\", \"inner-skills\", \"reasoning\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"A Compound AI Agent for Conversational Grant Discovery\",\n    \"description\": \"Introduction of a compound AI agent designed for conversational grant discovery. Accepted as demo submission to ACM CAIS. Explores multi-agent systems for information discovery tasks.\",\n    \"author\": \"Zhisheng Tang, Mayank Kejriwal\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02366\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"compound-agents\", \"grant-discovery\", \"conversational-ai\", \"information-retrieval\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"EngiAgent: Fully Connected Coordination of LLM Agents for Solving Open-ended Engineering Problems with Feasible Solutions\",\n    \"description\": \"EngiAgent system for fully connected coordination of LLM agents to solve open-ended engineering problems with feasible solutions. Accepted at ICML 2026. Explores multi-agent coordination for complex engineering challenges.\",\n    \"author\": \"Xiyuan Zhou, Ruixi Zou, Xinlei Wang, et al.\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02289\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"multi-agent\", \"engineering-problems\", \"llm-coordination\", \"icml-2026\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Towards Understanding Specification Gaming in Reasoning Models\",\n    \"description\": \"Research towards understanding specification gaming in reasoning models. Explores how AI models might game specifications rather than truly solving intended problems.\",\n    \"author\": \"Kei Nishimura-Gasparian, Robert McCarthy, David Lindner\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2605.02269\",\n    \"published_date\": \"2026-05-05\",\n    \"topics\": [\"specification-gaming\", \"reasoning-models\", \"ai-safety\", \"alignment\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Granite 4.1 3B SVG Pelican Gallery - Testing AI Model Quality\",\n    \"description\": \"Simon Willison tested IBM's Granite 4.1 family of LLMs (Apache 2.0 licensed) by prompting 'Generate an SVG of a pelican riding a bicycle' against different sized quantized variants. Found that results were less interesting than expected with no distinguishable pattern relating quality to size - all were pretty terrible at the task. The 3B model has 21 different GGUF encoded variants ranging from 1.2GB to 6.34GB.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-05-04\",\n    \"topics\": [\"llms\", \"ibm\", \"granite\", \"model-evaluation\", \"quantization\", \"svg-generation\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Zig's Strict Anti-LLM Policy and Contributor Poker Philosophy\",\n    \"description\": \"Zig has one of the most stringent anti-LLM policies: No LLMs for issues, pull requests, or comments. Loris Cro, Zig Software Foundation VP of Community, explains the philosophy as 'contributor poker' - they bet on the contributor, not the contents of their first PR. The goal is to grow new contributors who become trusted over time. LLM assistance breaks this because even perfect PRs don't help add new, confident, trustworthy contributors. Bun (acquired by Anthropic) achieved 4x performance improvement but can't upstream to Zig due to this policy.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-04-30\",\n    \"topics\": [\"llms\", \"open-source\", \"zig\", \"ai-ethics\", \"bun\", \"anthropic\", \"contributor-model\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Codex CLI 0.128.0 Adds /goal - Agentic Coding Loop\",\n    \"description\": \"OpenAI's Codex CLI version 0.128.0 adds a /goal feature implementing the Ralph loop: you can set a goal and Codex will keep looping until it evaluates completion or exhausts the token budget. Feature mainly implemented through goals/continuation.md and goals/budget_limit.md prompts that are automatically injected at the end of a turn.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-04-30\",\n    \"topics\": [\"openai\", \"codex-cli\", \"coding-agents\", \"agentic-engineering\", \"system-prompts\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"UK AI Security Institute Evaluates GPT-5.5 Cyber Capabilities\",\n    \"description\": \"The UK's AI Security Institute evaluated GPT-5.5 for finding security vulnerabilities and found it comparable to Claude Mythos. Unlike Mythos, GPT-5.5 is generally available right now. Previously they had evaluated Claude Mythos for cyber capabilities.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-04-30\",\n    \"topics\": [\"ai-security\", \"gpt\", \"openai\", \"anthropic\", \"claude\", \"cybersecurity\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Andrew Kelley on Detecting LLM Code: 'Digital Smell'\",\n    \"description\": \"Andrew Kelley, creator of Zig, on detecting LLM-assisted code: 'The kind of mistakes humans make are fundamentally different than LLM hallucinations, making them easy to spot. Furthermore, people who come from the world of agentic coding have a certain digital smell that is not obvious to them but is obvious to those who abstain. It's like when a smoker walks into the room, everybody who doesn't smoke instantly knows it.' Zig maintains strict ban on LLM-authored contributions.\",\n    \"author\": \"Andrew Kelley (via Simon Willison)\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-04-30\",\n    \"topics\": [\"zig\", \"llms\", \"ai\", \"code-quality\", \"detection\", \"ai-ethics\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"LLM 0.32a0 Major Backwards-Compatible Refactor\",\n    \"description\": \"Simon Willison released LLM 0.32a0, an alpha release of his LLM Python library and CLI tool for accessing LLMs, with consequential changes he's