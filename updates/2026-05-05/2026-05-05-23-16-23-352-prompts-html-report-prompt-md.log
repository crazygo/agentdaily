",\n    \"url\": \"https://news.ycombinator.com/item?id=47520220\",\n    \"description\": \"Orchestrates AI coding agents in Kubernetes to automate from ticket to PR with CI/CD feedback loops for DevOps workflows.\",\n    \"release_date\": \"2026-04-24\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": [\n      \"Orchestrates AI coding agents in Kubernetes\",\n      \"Automates from ticket to PR with CI/CD feedback\"\n    ]\n  },\n  {\n    \"name\": \"Struct\",\n    \"url\": \"https://www.producthunt.com/products/struct-2\",\n    \"description\": \"AI agent that root-causes engineering alerts using logs, metrics, traces, and code with composable architecture for debugging workflows.\",\n    \"release_date\": \"2026-04-23\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Root-causes engineering alerts\",\n      \"Uses logs, metrics, traces, and code\",\n      \"Workflow-specific for debugging\"\n    ]\n  },\n  {\n    \"name\": \"Superset\",\n    \"url\": \"https://news.ycombinator.com/item?id=46368739\",\n    \"description\": \"Open-source terminal designed for managing multiple coding agents (Claude Code, Codex, etc.) in parallel. Can run up to 10 coding agents simultaneously.\",\n    \"release_date\": \"2026-04-22\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Show HN\"],\n    \"community_quotes\": [\n      \"Terminal to run 10 parallel coding agents\",\n      \"Manage multiple AI coding agents simultaneously\",\n      \"Open-source\"\n    ]\n  }\n]\n",
