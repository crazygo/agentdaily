{
  "file_path": "/home/runner/work/agentdaily/agentdaily/updates/2026-07-10/new-product.json",
  "content": "[\n  {\n    \"name\": \"Cursor iOS App\",\n    \"url\": \"https://cursor.com/ios\",\n    \"description\": \"A mobile companion app for Cursor's AI coding platform that allows developers to launch and supervise AI coding agents from their iPhone. Users can start cloud-hosted Composer 2.5 agent runs via voice or text, receive push notifications on agent progress, review generated code diffs and UI screenshots, and merge pull requests remotely. The app requires iOS 26.0+ and a paid Cursor subscription.\",\n    \"release_date\": \"2026-06-29\",\n    \"category\": \"AI coding mobile app\",\n    \"sources\": [\"FAQ\", \"Instagram Announcement\"],\n    \"community_quotes\": [\n      \"The workflow enables starting a long-running agent task before a meeting, commute, or gym session, and checking back on progress remotely rather than sitting in front of a screen for the duration.\",\n      \"This is the first major product move that Cursor has made since becoming part of the Musk empire, and it arrives at a moment when AI-native development tools are moving toward ambient, always-on architectures.\",\n      \"The investment in the iOS experience suggests that Cursor—under SpaceX ownership—is still being built as a product that competes for developer mindshare in the open market.\",\n      \"For developers who can launch ten parallel agents from their phone during a Monday morning standup, monitor their progress via push notifications through the day, and approve or redirect them during breaks has a meaningfully different productivity profile.\"\n    ]\n  }\n]"
}

