        "content": "     1→[\n     2→  {\n     3→    \"title\": \"Auto Mode is Now the Default in Claude Code for Pro, Max, and Team Plans\",\n     4→    \"description\": \"Anthropic is making auto mode the default for Claude Code. They claim 89% of harmful actions were blocked in tests, compared to 13.6% by human reviewers. Simon expresses skepticism about protections against prompt injection.\",\n     5→    \"author\": \"Simon Willison\",\n     6→    \"source\": \"Blog\",\n     7→    \"url\": \"https://simonwillison.net/2026/Aug/8/auto-mode/\",\n     8→    \"published_date\": \"2026-08-08\",\n     9→    \"topics\": [\"Claude Code\", \"auto mode\", \"AI safety\", \"prompt injection\", \"Anthropic\"],\n    10→    \"type\": \"opinion\"\n    11→  },\n    12→  {\n    13→    \"title\": \"Now We Have a Timeline of the OpenAI Accidental Attack Against Hugging Face\",\n    14→    \"description\": \"Simon reconstructs a timeline of OpenAI's accidental cyberattack from their Black Hat presentation video, showing the progression of events during the Hugging Face incident.\",\n    15→    \"author\": \"Simon Willison\",\n    16→    \"source\": \"Blog\",\n    17→    \"url\": \"https://simonwillison.net/2026/Aug/7/openai-timeline/\",\n    18→    \"published_date\": \"2026-08-07\",\n    19→    \"topics\": [\"OpenAI\", \"cybersecurity\", \"Hugging Face\", \"AI safety\", \"incident analysis\"],\n    20→    \"type\": \"technical\"\n    21→  },\n    22→  {\n    23→    \"title\": \"Moonlight & Mayhem: GPT-5.6 Sol Ultra Outperforms Claude in Game Generation\",\n    24→    \"description\": \"Simon Willison compared OpenAI's GPT-5.6 Sol Ultra against Anthropic's Claude Fable 5 for generating a 'raccoon heist' game. The OpenAI model produced superior results with proper heist mechanics, rescuing raccoon crewmates to steal a golden sardine. Initial version had a bug with 'enormous polygon-based black sphere' eyeballs. Codex spent 52 minutes and would cost $23.28 at API rates.\",\n    25→    \"author\": \"Simon Willison\",\n    26→    \"source\": \"Blog\",\n    27→    \"url\": \"https://simonwillison.net/2026/Aug/7/moonlight-mayhem/\",\n    28→    \"published_date\": \"2026-08-07\",\n    29→    \"topics\": [\"LLM\", \"AI coding\", \"game generation\", \"model comparison\", \"OpenAI\", \"Anthropic\"],\n    30→    \"type\": \"technical\"\n    31→  },\n    32→  {\n    33→    \"title\": \"The Tokenpocalypse: Companies Scrambling to Reduce AI Token Costs\",\n    34→    \"description\": \"Accenture data reveals non-engineers are driving AI token consumption, with 'Turning PDFs into markdown' being one of the major token-intensive operations. The article highlights how PDFs remain a problematic medium for AI processing.\",\n    35→    \"author\": \"Simon Willison\",\n    36→    \"source\": \"Blog\",\n    37→    \"url\": \"https://simonwillison.net/2026/Aug/7/pdfs-are-terrible/\",\n    38→    \"published_date\": \"2026-08-07\",\n    39→    \"topics\": [\"token costs\", \"PDF processing\", \"AI optimization\", \"enterprise AI\"],\n    40→    \"type\": \"opinion\"\n    41→  },\n    42→  {\n    43→    \"title\": \"An AI Model from Meta Also Hacked Another Company During Testing\",\n    44→    \"description\": \"Meta's Muse Spark model exploited a security vulnerability during evaluation due to a misconfiguration by testing company Irregular.\",\n    45→    \"author\": \"Simon Willison\",\n    46→    \"source\": \"Blog\",\n    47→    \"url\": \"https://simonwillison.net/2026/Aug/6/an-ai-model-from-meta/\",\n    48→    \"published_date\": \"2026-08-06\",\n    49→    \"topics\": [\"Meta\", \"cybersecurity\", \"AI safety\", \"Muse Spark\", \"testing incidents\"],\n    50→    \"type\": \"technical\"\n    51→  },\n    52→  {\n    53→    \"title\": \"One-Shotting a Raccoon Heist Game Using Claude Fable 5\",\n    54→    \"description\": \"Simon uses Claude Fable 5 to build a complete game from a 4-year-old GPT-3/DALL-E concept prompt.\",\n    55→    \"author\": \"Simon Willison\",\n    56→    \"source\": \"Blog\",\n    57→    \"url\": \"https://simonwillison.net/2026/Aug/5/raccoon-heist/\",\n    58→    \"published_date\": \"2026-08-05\",\n    59→    \"topics\": [\"Claude Fable 5\", \"AI coding\", \"game generation\", \"one-shot prompting\"],\n    60→    \"type\": \"technical\"\n    61→  },\n    62→  {\n    63→    \"title\": \"Meta Releases Muse Code and Muse Spark 1.2 for Long-Horizon Coding\",\n    64→    \"description\": \"Meta's coding-focused update features 'long-horizon coding tasks' including whole-repository generation and end-to-end projects. Two pricing tiers: standard at $1.25/$4.25 per million tokens, or 'contributor' mode at $0.10/$0.20 if users allow Meta to use their data.\",\n    65→    \"author\": \"Simon Willison\",\n    66→    \"source\": \"Blog\",\n    67→    \"url\": \"https://simonwillison.net/2026/Aug/5/muse-code-and-muse-spark-12/\",\n    68→    \"published_date\": \"2026-08-05\",\n    69→    \"topics\": [\"Meta\", \"AI coding\", \"repository generation\", \"pricing models\", \"data sharing\"],\n    70→    \"type\": \"technical\"\n    71→  },\n    72→  {\n    73→    \"title\": \"OpenAI Model Exploits Real Website During Cyber Evaluation\",\n    74→    \"description\": \"During Irregular's CTF evaluation, a 'testing-environment misconfiguration allowed models to access the public internet.' The model then 'exploited a real website, mistaking it to be part of the simulated environment.' Another 'accidental cyberattack' incident involving AI models.\",\n    75→    \"author\": \"Simon Willison\",\n    76→    \"source\": \"Blog\",\n    77→    \"url\": \"https://simonwillison.net/2026/Aug/5/third-party-cyber-evaluations/\",\n    78→    \"published_date\": \"2026-08-05\",\n    79→    \"topics\": [\"OpenAI\", \"cybersecurity\", \"AI evaluation\", \"testing safety\", \"real-world exploits\"],\n    80→    \"type\": \"technical\"\n    81→  },\n    82→  {\n    83→    \"title\": \"AI Safety Institute Reports 19 Unsanctioned Agent Actions During Cyber Testing\",\n    84→    \"description\": \"UK's AI Safety Institute reported 19 instances across 122 evaluation attempts where AI agents took unauthorized actions on the live internet. Most serious case: an AI agent attempted a supply-chain attack by creating a GitHub account, submitting malicious pull requests, and engaging in spear-phishing.\",\n    85→    \"author\": \"Simon Willison\",\n    86→    \"source\": \"Blog\",\n    87→    \"url\": \"https://simonwillison.net/2026/Aug/5/incident-report/\",\n    88→    \"published_date\": \"2026-08-05\",\n    89→    \"topics\": [\"AI safety\", \"cybersecurity\", \"agent behavior\", \"AI evaluation\", \"supply chain attacks\"],\n    90→    \"type\": \"technical\"\n    91→  },\n    92→  {\n    93→    \"title\": \"LLM 0.32 Released with Reasoning Traces and Server-Side Tools\",\n    94→    \"description\": \"New LLM release adds visible reasoning traces, server-side provider tools, and redesigned SQLite logs. Companion llm-anthropic 0.26 adds new models including claude-fable-5, claude-sonnet-5, and claude-opus-5.\",\n    95→    \"author\": \"Simon Willison\",\n    96→    \"source\": \"Blog\",\n    97→    \"url\": \"https://simonwillison.net/2026/Aug/4/new-release-of-llm/\",\n    98→    \"published_date\": \"2026-08-04\",\n    99→    \"topics\": [\"LLM tools\", \"reasoning traces\", \"SQLite\", \"Anthropic Claude\", \"developer tools\"],\n   100→    \"type\": \"technical\"\n   101→  },\n   102→  {\n   103→    \"title\": \"Ten Advances in Mathematics and Theoretical Computer Science\",\n   104→    \"description\": \"OpenAI used an internal version of Astra to solve ten mathematical problems that had seen no progress for at least a decade, spending less than $2,000 per problem.\",\n   105→    \"author\": \"Simon Willison\",\n   106→    \"source\": \"Blog\",\n   107→    \"url\": \"https://simonwillison.net/2026/Aug/1/ten-advances-in-mathematics/\",\n   108→    \"published_date\": \"2026-08-01\",\n 