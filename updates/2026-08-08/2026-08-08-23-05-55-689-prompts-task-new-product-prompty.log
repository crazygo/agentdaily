    "content": "[\n  {\n    \"name\": \"Nepali-IDE\",\n    \"url\": \"https://github.com/DiwasKhatri07/Nepali-IDE\",\n    \"description\": \"AI-native mobile IDE and code editor for Android built with Kotlin and Jetpack Compose. Features Google Gemini AI code completion, code analysis, unit test generation, AI assistant panel, built-in Python interpreter with REPL, HTML live preview, project workspace with version history, Git integration, SQLite database browser, and multi-tab editing with syntax highlighting. Demonstrates world-class developer tools can be built locally by a Nepali developer.\",\n    \"release_date\": \"2026-08-08\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"AI-native mobile IDE and code editor for Android\",\n      \"Built with Kotlin and Jetpack Compose with Material 3 design\",\n      \"Gemini AI code completion, code analysis, and unit test generation\",\n      \"Brings desktop-class coding to Android devices\"\n    ]\n  },\n  {\n    \"name\": \"codeguard-ai\",\n    \"url\": \"https://github.com/OutDuke/codeguard-ai\",\n    \"description\": \"AI-powered developer productivity tool for intelligent GitHub pull request review and automated test generation. Integrates directly with GitHub workflows to analyze code changes in PRs and automatically generate tests. Features a web interface available at codeguard-ai-six.vercel.app with backend/frontend architecture and comprehensive agent documentation.\",\n    \"release_date\": \"2026-08-08\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"AI-powered developer productivity tool for intelligent GitHub pull request review\",\n      \"Automated test generation\",\n      \"Integrates directly with GitHub workflow systems\"\n    ]\n  },\n  {\n    \"name\": \"Kimi K3 Code Free Desktop AI\",\n    \"url\": \"https://github.com/kimi-k3code/Kimi-K3-Code-Free-Desktop-AI\",\n    \"description\": \"Free GitHub Copilot alternative desktop application providing access to Kimi K3 from Moonshot AI with 2.8T parameters and 1M token context window. Features terminal-based coding agent for autonomous tasks, multi-file upload (up to 50 files), IDE integration with file read/write and shell execution, extended reasoning mode, and Delta Attention mechanism for accurate recall. Supports Windows, macOS, and Linux with optional local execution via Ollama.\",\n    \"release_date\": \"2026-08-07\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"Free GitHub Copilot alternative with 1M token context window\",\n      \"2.8T parameter model with Delta Attention mechanism\",\n      \"Terminal coding agent with autonomous task execution\",\n      \"Significantly lower pricing than OpenAI and Anthropic\"\n    ]\n  },\n  {\n    \"name\": \"LongHorizon-Harness\",\n    \"url\": \"https://github.com/AMAP-ML/LongHorizon-Harness\",\n    \"description\": \"Long-horizon computer-use harness that enables AI agents to operate autonomously across desktop applications and CLI for extended periods while preserving task state. Uses three-role architecture (Manager/Executor/Auditor) with fresh-context execution, durable verified state, independent auditing, and recoverable progress. Integrates with Claude Code, Codex, and OpenClaw. Benchmarks show 50%→80% WeaveBench completion, 3× OSWorld improvement, and 69.7%→77.2% Terminal-Bench success. Recognized #1 on Hugging Face Daily Papers August 6, 2026.\",\n    \"release_date\": \"2026-08-04\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\", \"Hugging Face\"],\n    \"community_quotes\": [\n      \"Run AI agents across desktop apps and CLI for extended periods\",\n      \"Three-role architecture: Manager/Executor/Auditor\",\n      \"#1 on Hugging Face Daily Papers weekly ranking\",\n      \"50%→80% WeaveBench GUI+CLI completion improvement\"\n    ]\n  },\n  {\n    \"