      "content": "[\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Bug Fixes and Performance Improvements\",\n    \"description\": \"Multiple updates in March 2026 including fixes for Apple M5 (March 12), Jupyter Notebook performance improvements, Cascade UI rendering enhancements, and Mac x64 build fix (March 19).\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-03-19\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Persistent Agent Thread Feature\",\n    \"description\": \"Anthropic released a persistent agent thread feature for Pro and Max plans on March 17, 2026, allowing users to manage tasks in Cowork from both mobile and desktop devices with enhanced control capabilities.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://claude.ai/code\",\n    \"date\": \"2026-03-17\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Reports of code's death are greatly exaggerated - Chris Lattner reviewed a compiler written entirely by Claude AI\",\n        \"source\": \"HN\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"GPT-5.4 Mini and GPT-5.4 Models\",\n    \"description\": \"Windsurf added GPT-5.4 Mini on March 17, 2026, starting at 1x credits (promo). GPT-5.4 was released on March 5, 2026, with promotional pricing across different reasoning levels (No/Low/Medium/High/Extra High Reasoning at 1x/1x/2x/3x/8x credits).\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-03-17\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"GPT-5.4 is much better at not duplicating code unnecessarily. It'll take the time to refactor, to search for pre-existing code\",\n        \"source\": \"HN\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"GPT-5.4 is really, really good after a week of use, found issues in my project that Opus 4.6 couldn't find\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Going above Medium reasoning causes GPT-5.4 to confuse itself and simply doesn't work well\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Horrified as the new system destroyed my credits in just a few queries with GPT 5.4 with no warning\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Codex CLI 0.114.0\",\n    \"description\": \"March 11, 2026 release introduced experimental code mode for more isolated coding workflows, hooks engine improvements, plugin mentions in chat functionality, refreshed model-picker surface, and merged sandbox policies for safer tool execution.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://developers.openai.com/codex/changelog/\",\n    \"date\": \"2026-03-11\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The hooks feature was long-requested and well-received\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"CLI hanging on prompts, particularly during /review commands on Ubuntu 22.04\",\n        \"source\": \"GitHub Issues\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Critical issue with unexpected file deletions on Windows 11\",\n        \"source\": \"GitHub Issues\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Bug Fixes and Platform Improvements\",\n    \"description\": \"March 7, 2026 update included minor bug fixes, performance improvements, and visual polish across the platform. Users can now install Devin as an App.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-03-07\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Devin has now merged hundreds of thousands of pull requests and receives performance evaluations similar to human engineers\",\n        \"source\": \"X/Twitter\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Cursor is preferred for exploratory work, debugging, and UI-heavy iterations due to its tight feedback loop\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Questions raised about whether the makers exaggerated Devin's capabilities - glamorous intro videos have gaps\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"v0.32.0 - Generalist Agent and Model Steering\",\n    \"description\": \"March 3, 2026 release enabled the Generalist Agent for improved task delegation and routing, added Model Steering in Workspace, new shortcuts, run-event notifications for macOS, and bug fixes. Gemini 3 is now default with faster Flash and smarter Pro models.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-03-03\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"NEW Gemini CLI Update is INSANE!\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Feels like a new feature or improvement drops every other day\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Is Gemini-CLI or Gemini-2.5 Pro totally broken?\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Gemini CLI feels like a huge downgrade after trying Claude\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Version 2.7 - JetBrains IDE Integration and Composer 2\",\n    \"description\": \"Cursor v2.7 released on March 4, 2026, enabling usage within JetBrains IDEs through the Agent Client Protocol (ACP). The update also introduced Composer 2, a 'frontier-level coding assistant' with new pricing at $0.50/input tokens and $2.50/output tokens, plus 30+ new partner plugins.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-03-04\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Composer 2 finally gave me the precision I have been missing - blew my mind\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Price to performance is a beast - does 80-90% of the job at a tenth of the cost\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Cursor prices are out of control - spending $300 out of $400 limit\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Controversy around Composer 2 being a reskinned Kimi-2.5 (Moonshot AI model)\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  }\n]\n",
