//github.blog/news-insights/company-news/changes-to-github-copilot-individual-plans/\",\n    \"date\": \"2026-04-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Windsurf 2.0 with Devin Cloud Integration\",\n    \"description\": \"Major Windsurf 2.0 release featuring Devin cloud agent directly inside Windsurf, Agent Command Center with Kanban-style view, and refined Windsurf Browser. Devin Cloud sessions run on dedicated VMs with testing and video recordings.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  }\n]",
