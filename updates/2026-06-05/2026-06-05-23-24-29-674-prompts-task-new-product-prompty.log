\"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"AI governance, guardrails, audit & .rules language support\",\n      \"Works with Claude Code, Cursor, Copilot, Gemini & MCP assistants\"\n    ]\n  },\n  {\n    \"name\": \"alethia-clients\",\n    \"url\": \"https://github.com/MagWizD/alethia-clients\",\n    \"description\": \"VSCode extension and JetBrains plugin for Aletheia that passively detects and attributes AI-generated code contributions by serializing flagged metadata as git notes on each commit.\",\n    \"release_date\": \"2026-05-25\",\n    \"category\": \"AI attribution tool\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"Passively detects and attributes AI-generated code contributions\",\n      \"Serializes flagged metadata as git notes on each commit\"\n    ]\n  },\n  {\n    \"name\": \"inline\",\n    \"url\": \"https://github.com/kavishsathia/inline\",\n    \"description\": \"Inline comments from an AI coding agent to your IDE. Designed for developers who prefer IDE integration over terminal-based AI coding agents or desktop apps.\",\n    \"release_date\": \"2026-06-02\",\n    \"category\": \"IDE integration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"Inline comments from an AI coding agent to your IDE\",\n      \"For those who can't read off a terminal\"\n    ]\n  },\n  {\n    \"name\": \"agentic-workspace-core\",\n    \"url\": \"https://github.com/Daaaaave/agentic-workspace-core\",\n    \"description\": \"A portable repository-native foundation for agent memory, skills, handoffs, and knowledge workflows. Provides project-long memory and workspace management across AI coding sessions.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"Project memory framework\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"Portable repository-native foundation for agent memory, skills, handoffs\",\n      \"Knowledge workflows for AI agents\"\n    ]\n  },\n  {\n    \"name\": \"review-forge\",\n    \"url\": \"https://github.com/vikingmute/review-forge\",\n    \"description\": \"An Agent Skill for structured, auditable code review workflows. Provides workflow-specific code review capabilities for AI coding agents.\",\n    \"release_date\": \"2026-05-29\",\n    \"category\": \"Code review workflow\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"Agent Skill for structured, auditable code review workflows\"\n    ]\n  },\n  {\n    \"name\": \"openclaw-devops-copilot\",\n    \"url\": \"https://github.com/m-aboud/openclaw-devops-copilot\",\n    \"description\": \"DevOps Copilot: an AI-powered assistant for DevOps workflows, infrastructure as code generation, and SRE tasks. Helps orchestrate complex development operations workflows.\",\n    \"release_date\": \"2026-06-01\",\n    \"category\": \"DevOps workflow agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"AI-powered assistant for DevOps workflows\",\n      \"Infrastructure as code generation and SRE tasks\"\n    ]\n  },\n  {\n    \"name\": \"baton\",\n    \"url\": \"https://github.com/kzoldyk/baton\",\n    \"description\": \"Desktop app for cross-agent AI handoffs. Pass project context, git diffs, and task states seamlessly between Codex, Claude Code, Gemini CLI, and other AI coding agents.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"Agent orchestration\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"Desktop app for cross-agent AI handoffs\",\n      \"Pass project context, git diffs, and task states between different AI coding agents\"\n    ]\n  },\n  {\n    \"name\": \"plumb-mcp\",\n    \"url\": \"https://github.com/tathagat22/plumb-mcp\",\n    \"description\": \"A local Figma MCP server with no REST rate limits, no metered tool-call quotas, and a verification loop. A drop-in alternative to Figma's Dev Mode MCP and Framelink for Claude Code, Cursor, and Windsurf that works on every plan including Free.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"MCP server\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"Local Figma MCP server - no REST rate limits, no metered tool-call quotas\",\n      \"Drop-in alternative to Figma's Dev Mode MCP\",\n      \"Works on every plan including Free\"\n    ]\n  },\n  {\n    \"name\": \"MimoAgent\",\n    \"url\": \"https://github.com/XWJDream/MimoAgent\",\n    \"description\": \"AI-powered coding assistant desktop app based on Xiaomi MiMo. Supports code generation, debugging, refactoring, project analysis, MCP tools, and TTS. A desktop application providing comprehensive AI coding assistance.\",\n    \"release_date\": \"2026-05-30\",\n    \"category\": \"Desktop AI coding assistant\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"AI-powered coding assistant desktop app based on Xiaomi MiMo\",\n      \"Supports code generation, debugging, refactoring, project analysis\"\n    ]\n  },\n  {\n    \"name\": \"agentpet\",\n    \"url\": \"https://github.com/ntd4996/agentpet\",\n    \"description\": \"A native macOS menu bar app with a desktop pet that monitors your AI coding agents (Claude Code, Codex, Gemini CLI) in real time. Provides visual feedback and monitoring for terminal-based AI coding workflows.\",\n    \"release_date\": \"2026-05-31\",\n    \"category\": \"Desktop monitoring tool\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"A desktop pet that monitors your AI coding agents in real time\",\n      \"Native macOS menu bar app for monitoring Claude Code, Codex, and Gemini CLI\"\n    ]\n  }\n]\n",
