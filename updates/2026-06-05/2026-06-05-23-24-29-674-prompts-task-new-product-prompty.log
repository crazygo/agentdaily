    "originalFile": "[\n  {\n    \"name\": \"Cantus\",\n    \"url\": \"https://github.com/manan45/Cantus\",\n    \"description\": \"A Claude-first, local-first desktop coding environment for macOS (Apple Silicon). A native Tauri 2 app that pairs a Monaco editor with an integrated terminal running the Claude Code CLI, per-hunk and per-line git staging, resumable Claude sessions, a .claude workflow task runner, and a local SQLite-backed learned-memory store. Built as a full IDE alternative to Claude's desktop app.\",\n    \"release_date\": \"2026-05-28\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"The open-source IDE and GUI for Claude Code on macOS\",\n      \"Local-first, private, and free. Built with Tauri 2, Rust, and React — no Electron, no subscription\",\n      \"A real IDE and GUI built around the Claude Code CLI\"\n    ]\n  },\n  {\n    \"name\": \"roach-code\",\n    \"url\": \"https://github.com/tmdgusya/roach-code\",\n    \"description\": \"A config- and plugin-driven terminal AI coding agent supporting multiple models (DeepSeek, Codex/OpenAI, MiniMax, GLM). A multi-model rewrite of deepseek-reasonix, distributed as a single static Go binary with prefix caching for low token costs across long sessions.\",\n    \"release_date\": \"2026-06-02\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"An AI coding agent for your terminal\",\n      \"Multi-model & composable - any OpenAI-compatible endpoint is a config entry\",\n      \"Plugin-driven with external tools running as subprocesses over stdio JSON-RPC (MCP-compatible)\"\n    ]\n  },\n  {\n    \"name\": \"Ultracode\",\n    \"url\": \"https://github.com/KangarooKi/Ultracode\",\n    \"description\": \"A local AI-assisted coding CLI inspired by Claude Code. Runs agentic coding workflows in your workspace with OpenAI-compatible models, function-calling tools, task planning, memory, permissions, hooks, background commands, MCP integration, and subagent support. Features interactive REPL sessions and one-shot run modes.\",\n    \"release_date\": \"2026-05-31\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"Terminal-first coding agent for developers\",\n      \"Built for the part of AI coding that happens inside a real repository\",\n      \"Follows the core Claude Code experience while backing into any OpenAI-compatible model\"\n    ]\n  },\n  {\n    \"name\": \"plumb-mcp\",\n    \"url\": \"https://github.com/tathagat22/plumb-mcp\",\n    \"description\": \"A local Figma MCP server with no REST rate limits, no metered tool-call quotas, and a verification loop. A drop-in alternative to Figma's Dev Mode MCP and Framelink for Claude Code, Cursor, and Windsurf that works on every plan including Free.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"MCP server\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"Local Figma MCP server - no REST rate limits, no metered tool-call quotas\",\n      \"Drop-in alternative to Figma's Dev Mode MCP\",\n      \"Works on every plan including Free\"\n    ]\n  },\n  {\n    \"name\": \"agentpet\",\n    \"url\": \"https://github.com/ntd4996/agentpet\",\n    \"description\": \"A native macOS menu bar app with a desktop pet that monitors your AI coding agents (Claude Code, Codex, Gemini CLI) in real time. Provides visual feedback and monitoring for terminal-based AI coding workflows.\",\n    \"release_date\": \"2026-05-31\",\n    \"category\": \"Desktop monitoring tool\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\n      \"A desktop pet that monitors your AI coding agents in real time\",\n      \"Native macOS menu bar app for monitoring Claude Code, Codex, and Gemini CLI\"\n    ]\n  },\n  {\n    \"name\": \"MimoAgent\",\n    \"url\": \"https://github.com/XWJDream/MimoAgent\",\n    \"description\": \"AI-powered coding as