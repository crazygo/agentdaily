: 10px;\n            color: #828282;\n            margin-left: 5px;\n        }\n\n        .quote {\n            font-style: italic;\n            color: #828282;\n            font-size: 11px;\n            margin-top: 3px;\n        }\n\n        .topics {\n            margin-top: 5px;\n        }\n\n        .topic {\n            display: inline-block;\n            background-color: #f6f6ef;\n            color: #828282;\n            padding: 2px 5px;\n            font-size: 10px;\n            margin-right: 4px;\n            border-radius: 3px;\n        }\n\n        footer {\n            text-align: center;\n            padding: 20px 10px;\n            color: #828282;\n            font-size: 11px;\n            border-top: 1px solid #d4d4d4;\n            margin-top: 20px;\n        }\n\n        footer a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n        }\n\n        .section-count {\n            display: inline-block;\n            background-color: #ff6600;\n            color: #000000;\n            padding: 2px 6px;\n            font-size: 11px;\n            font-weight: bold;\n            margin-left: 8px;\n            border-radius: 2px;\n        }\n\n        code {\n            font-family: Monaco, Consolas, monospace;\n            font-size: 11px;\n            background-color: #f6f6ef;\n            padding: 1px 4px;\n            border-radius: 2px;\n        }\n\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            section {\n                break-inside: avoid;\n            }\n\n            .three-column-layout {\n                display: block;\n            }\n\n            section {\n                margin-bottom: 20px;\n                page-break-inside: avoid;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agentic Coding Res