  "content": "[\n  {\n    \"name\": \"Aura\",\n    \"url\": \"https://www.producthunt.com/products/aura-28\",\n    \"description\": \"Open-source Git-native IDE designed specifically for controlling AI coding agents with built-in loops. Run multiple AI coding agents from one desktop application, manage tasks, review AI-written code, and track changes at function and class level. Local-first approach with deep Git integration.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Git-native IDE for working with AI coding agents\",\n      \"Track their changes at the function and class level\",\n      \"Open-source alternative to proprietary AI IDEs\"\n    ]\n  },\n  {\n    \"name\": \"Tabstack Browser Automation\",\n    \"url\": \"https://www.producthunt.com/products/tabstack\",\n    \"description\": \"Browser automation API built specifically for AI agents. Send plain language tasks plus a URL, get finished output in one streaming API call. Reads the page's accessibility tree instead of screenshots, using 60-80% fewer tokens than screenshot-based agents. Backed by Mozilla.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"AI workflow automation\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Reads accessibility tree instead of screenshots (60-80% fewer tokens)\",\n      \"Send a task in plain language plus a URL, get finished output\",\n      \"Mozilla-backed browser automation for agents\"\n    ]\n  },\n  {\n    \"name\": \"Opper AI\",\n    \"url\": \"https://www.producthunt.com/products/opper-ai\",\n    \"description\": \"European AI gateway built specifically for agent workloads with compliant EU-hosted infrastructure. Single API key provides access to 300+ models including OpenAI, Anthropic, and Google. Drop-in compatible with major SDKs, requiring only a base URL change. Agent-native features with routing controls.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"AI infrastructure\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"European AI gateway for agent workloads\",\n      \"One API key for 300+ models\",\n      \"EU-hosted, privacy-first infrastructure\"\n    ]\n  },\n  {\n    \"name\": \"Termi Protocol\",\n    \"url\": \"https://www.producthunt.com/products/termi-protocol\",\n    \"description\": \"3D visualization and simulation platform for AI coding agent workflows. Gives your AI agents a face, desk, and living room so you can watch them read, write, and run code in real-time 3D. Addresses the 'black box' problem of AI development with visual feedback. Local-first with pay-once pricing.\",\n    \"release_date\": \"2026-07-04\",\n    \"category\": \"AI coding visualization\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"3D simulation of AI agent workflows\",\n      \"Watch your AI coding agents build in real-time\",\n      \"Gamified view of agent coding processes\"\n    ]\n  },\n  {\n    \"name\": \"scritty\",\n    \"url\": \"https://www.producthunt.com/products/scritty\",\n    \"description\": \"Terminal emulator that captures every CLI AI agent's conversation (Claude, Codex, Copilot, Antigravity, Ollama), indexes it into one searchable corpus you control, and serves it back to your agents over MCP and to you over CLI. Privacy-first with local storage. Addresses the lack of persistent memory across AI coding agents.\",\n    \"release_date\": \"2026-07-02\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Shared, searchable memory for every AI coding agent\",\n      \"Captures conversations from Claude, Codex, Copilot, and more\",\n      \"Your captures stay on your machine - privacy-first\"\n    ]\n  },\n  {\n    \"name\": \"Context.dev\",\n    \"url\": \"https://www.producthunt.com/products/context-dev\",\n    \"description\": \"Web context API designed specifically for AI products and agents. Scrape any URL, crawl sites, turn pages into LLM-ready Markdown, extract structured data into your own schema, capture screenshots, and retrieve logos, colors, fonts, and company data through one unified API. Y Combinator-backed with no credit card required.\",\n    \"release_date\": \"2026-07-02\",\n    \"category\": \"AI infrastructure\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"One API to scrape, enrich, and extract the internet\",\n      \"Turn pages into LLM-ready Markdown\",\n      \"YC-backed, no card required for developers\"\n    ]\n  }\n]"
}

