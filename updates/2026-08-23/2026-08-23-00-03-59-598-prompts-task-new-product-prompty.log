    "content": "[\n  {\n    \"name\": \"Qoder\",\n    \"url\": \"https://qoder.com/\",\n    \"description\": \"Next-generation AI programming platform and agentic IDE by Alibaba, featuring multi-agent collaboration, long-term delegation execution, memory and knowledge engine mechanisms, deep codebase integration, intelligent code completion, AI conversational programming, and automatic code generation.\",\n    \"release_date\": \"2025-08-22\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"Product Hunt\", \"Alibaba Cloud\"],\n    \"community_quotes\": [\"Agentic IDE for real software development\", \"Autonomous Development Desktop with Agent teams\", \"Memory and knowledge engine mechanisms\"]\n  },\n  {\n    \"name\": \"Google Jules\",\n    \"url\": \"https://cloud.google.com/blog/products/ai-machine-learning/what-google-cloud-announced-in-ai-this-month-2025\",\n    \"description\": \"Autonomous AI coding agent introduced by Google in August 2025, designed to help developers with complex tasks like bug fixing.\",\n    \"release_date\": \"2025-08-14\",\n    \"category\": \"code agent\",\n    \"sources\": [\"Google Cloud Blog\"],\n    \"community_quotes\": [\"Autonomous AI coding agent for complex tasks\"]\n  },\n  {\n    \"name\": \"Qwen Code\",\n    \"url\": \"https://tongyi.aliyun.com/\",\n    \"description\": \"AI programming agent launched by Alibaba Cloud's Tongyi Qianwen team, providing programming assistance and coding capabilities.\",\n    \"release_date\": \"2025-08-01\",\n    \"category\": \"code agent\",\n    \"sources\": [\"Web Search\"],\n    \"community_quotes\": [\"AI programming agent for coding assistance\"]\n  },\n  {\n    \"name\": \"Knowns CLI\",\n    \"url\": \"https://www.producthunt.com/products/knowns-cli\",\n    \"description\": \"AI-first CLI for task management and documentation that links docs in tasks and automatically reads context to help stop repeating patterns every session.\",\n    \"release_date\": \"2025-08-08\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"AI-first CLI for task management and documentation\", \"Links docs in tasks, AI reads context automatically\"]\n  },\n  {\n    \"name\": \"Visual Studio 2022 August Update\",\n    \"url\": \"https://devblogs.microsoft.com/visualstudio/the-visual-studio-august-update-is-here-smarter-ai-better-debugging-and-more-control/\",\n    \"description\": \"August 2025 update (v17.14) for Visual Studio 2022 adds smarter AI debugging capabilities with GPT-5 support, enhanced Copilot Chat features, and improved debugging tools.\",\n    \"release_date\": \"2025-08-20\",\n    \"category\": \"AI debugging tool\",\n    \"sources\": [\"Microsoft DevBlogs\"],\n    \"community_quotes\": [\"Smarter AI debugging with GPT-5 support\", \"Enhanced Copilot Chat features\"]\n  },\n  {\n    \"name\": \"Lightrun GenAI Debugging\",\n    \"url\": \"https://devops.com/lightrun-adds-generative-ai-tool-to-debug-code-in-runtime-environments/\",\n    \"description\": \"Runtime debugging tool that leverages generative AI to identify root causes of issues in runtime environments, added in August 2025.\",\n    \"release_date\": \"2025-08-15\",\n    \"category\": \"AI debugging tool\",\n    \"sources\": [\"DevOps.com\"],\n    \"community_quotes\": [\"Leverages generative AI to identify root causes\", \"Debug code in runtime environments\"]\n  },\n  {\n    \"name\": \"Stagewise\",\n    \"url\": \"https://www.producthunt.com/products/stagewise\",\n    \"description\": \"Open-source frontend coding agent for existing codebases that runs in your browser, featured in Best Product Hunt posts of August 2025.\",\n    \"release_date\": \"2025-08-25\",\n    \"category\": \"code agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"Open-source frontend coding agent for existing codebases\", \"Runs in your browser\"]\n  },\n  {\n    \"name\": \"TraceRoot AI\",\n    \"url\": \"https://www.producthunt.com