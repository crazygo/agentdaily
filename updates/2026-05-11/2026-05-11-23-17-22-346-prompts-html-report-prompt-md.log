    "originalFile": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Agentic Coding Research Report - 2026-05-11</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: Verdana, Geneva, sans-serif;\n            font-size: 14px;\n            line-height: 1.6;\n            background-color: #f6f6ef;\n            color: #000000;\n        }\n\n        .container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 0 20px;\n        }\n\n        header {\n            background-color: #ff6600;\n            padding: 8px 0;\n            border-bottom: 1px solid #d4d4d4;\n        }\n\n        header .container {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .logo {\n            font-family: Arial, Helvetica, sans-serif;\n            font-weight: bold;\n            font-size: 16px;\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .date-badge {\n            font-size: 12px;\n            color: #000000;\n        }\n\n        .page-title {\n            padding: 20px 0;\n            border-bottom: 1px solid #d4d4d4;\n        }\n\n        .page-title h1 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 24px;\n            font-weight: bold;\n            color: #000000;\n        }\n\n        .three-column-layout {\n            display: grid;\n            grid-template-columns: 40% 35% 25%;\n            gap: 20px;\n            padding: 20px 0;\n        }\n\n        section {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            border-radius: 3px;\n            overflow: hidden;\n        }\n\n        .section-header {\n            background-color: #ff6600;\n            padding: 10px 12px;\n            border-bottom: 1px solid #d4d4d4;\n        }\n\n        .section-header h2 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 14px;\n            font-weight: bold;\n            color: #000000;\n            margin: 0;\n        }\n\n        .section-content {\n            padding: 12px;\n        }\n\n        .item {\n            padding: 10px 0;\n            border-bottom: 1px solid #eeeeee;\n        }\n\n        .item:last-child {\n            border-bottom: none;\n        }\n\n        .item-title {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 14px;\n            font-weight: bold;\n            margin-bottom: 6px;\n        }\n\n        .item-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .item-title a:hover {\n            text-decoration: underline;\n        }\n\n        .item-title a:visited {\n            color: #828282;\n        }\n\n        .item-description {\n            font-size: 13px;\n            color: #000000;\n            margin-bottom: 6px;\n            line-height: 1.5;\n        }\n\n        .item-meta {\n            font-size: 11px;\n            color: #828282;\n            display: flex;\n            flex-wrap: wrap;\n            gap: 8px;\n            align-items: center;\n        }\n\n        .meta-tag {\n            display: inline-block;\n            padding: 2px 6px;\n            background-color: #f0f0f0;\n            border-radius: 2px;\n            font-size: 10px;\n            color: #828282;\n        }\n\n        .meta-source {\n            color: #828282;\n        }\n\n        .meta-date {\n            color: #828282;\n        }\n\n        .update-badge {\n            display: inline-block;\n            padding: 2px 6px;\n            border-radius: 2px;\n            font-size: 10px;\n            font-weight: bold;\n            margin-right: 6px;\n        }