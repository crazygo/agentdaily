  "old_string": "  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Rate Limits Doubled for Pro, Max, Team, and Enterprise Plans\",\n    \"description\": \"On May 6, 2026, Claude Code five-hour rate limits were doubled for Pro, Max, Team, and seat-based Enterprise plans, with peak-hours throttling also addressed.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://blakecrosley.com/blog/code-with-claude-sf-2026-recap\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Looks like Elon's finally giving up on XAI and just selling the compute\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"xAI is a deeply unserious lab\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"This also comes hours after several still recent Grok models were deprecated at short notice\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Billions in revenue just before your IPO isn't a bad deal either\",\n        \"source\": \"HN\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Version 3.3 Bug Fixes\",\n    \"description\": \"May 6, 2026 update (v3.3) fixed various cloud agent timing and hydration edge cases affecting reliability, plus performance improvements.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://cursor.com/cn/changelog\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Code Review Billing Changes (Effective June 1, 2026)\",\n    \"description\": \"GitHub announced changes to Copilot code review billing where each review will be billed as AI usage and start consuming GitHub Actions minutes.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-15\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Seems like a strong signal the money burning party is coming to a close. Nearly all AI companies have tightened their belts in the past month.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"This was my first thought too. 'The Porsche you rented at $200/mo is now a Honda. But the price hasn't changed!'\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Plan prices aren't changing - just the value you get from those plans has plummeted. It's classic deceptive sales language.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"27x multiplier on Opus is the tell. That is not a pricing model designed for broad adoption, it's a price signal that says 'use the cheaper model.'\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"I will not be renewing/switching over, either. I had copilot mainly so I could write issues and throw agents at it.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Enterprise gets pooled credits and will like having everything go through one place so I think it still works.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Version 0.41.0 with Real-Time Voice Mode\",\n    \"description\": \"Release v0.41.0 adds real-time voice mode support, secure .env loading with workspace trust in headless mode, and stronger shell command capabilities.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-05-15\",\n    \"community_feedback\": []\n  },",
  "new_string": "  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Rate Limits Doubled for Pro, Max, Team, and Enterprise Plans\",\n    \"description\": \"On May 6, 2026, Claude Code five-hour rate limits were doubled for Pro, Max, Team, and seat-based Enterprise plans, with peak-hours throttling also addressed.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://blakecrosley.com/blog/code-with-claude-sf-2026-recap\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Looks like Elon's finally giving up on XAI and just selling the compute\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"xAI is a deeply unserious lab\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"This also comes hours after several still recent Grok models were deprecated at short notice\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Billions in revenue just before your IPO isn't a bad deal either\",\n        \"source\": \"HN\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Version 3.3 Bug Fixes\",\n    \"description\": \"May 6, 2026 update (v3.3) fixed various cloud agent timing and hydration edge cases affecting reliability, plus performance improvements.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://cursor.com/cn/changelog\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },"
