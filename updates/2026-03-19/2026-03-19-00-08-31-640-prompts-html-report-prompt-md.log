    display: flex;\n            flex-wrap: wrap;\n            gap: 3px;\n            margin-top: 5px;\n        }\n\n        .topic-tag {\n            background-color: #f0f0f0;\n            color: #666;\n            padding: 2px 6px;\n            border-radius: 2px;\n            font-size: 9px;\n            font-size: 9px;\n        }\n\n        .topic-tag:hover {\n            background-color: #ff6600;\n            color: #ffffff;\n        }\n\n        .insight-type {\n            display: inline-block;\n            padding: 1px 5px;\n            border-radius: 2px;\n            font-size: 9px;\n            margin-left: 5px;\n            text-transform: uppercase;\n            font-weight: bold;\n        }\n\n        .insight-type.opinion {\n            background-color: #e6f3ff;\n            color: #004499;\n        }\n\n        .insight-type.technical {\n            background-color: #fff4e6;\n            color: #996600;\n        }\n\n        .insight-type.discussion {\n            background-color: #e6ffe6;\n            color: #006600;\n        }\n\n        /* Footer Styles */\n        footer {\n            background-color: #ffffff;\n            border-top: 1px solid #ff6600;\n            padding: 15px 10px;\n            margin-top: 20px;\n            font-size: 11px;\n            color: #828282;\n        }\n\n        footer .container {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .footer-links {\n            display: flex;\n            gap: 15px;\n        }\n\n        .footer-links a {\n            color: #828282;\n        }\n\n        .footer-links a:hover {\n            color: #000000;\n        }\n\n        .footer-info {\n            color: #828282;\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1200px) {\n            .three-column-layout {\n                grid-template-columns: 1fr 1fr;\n            }\n\n            .technical-insights {\n       