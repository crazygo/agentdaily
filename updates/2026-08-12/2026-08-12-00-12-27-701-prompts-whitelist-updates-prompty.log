    "originalFile": "[\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Cross-session messaging\",\n    \"description\": \"Claude Code sessions can now message each other on macOS and Linux, enabling Claude to pass findings and decisions between sessions instead of requiring re-explanation.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Self-hosted environments in public beta\",\n    \"description\": \"Self-hosted environments run Claude Code cloud sessions on infrastructure your organization operates, now in public beta on Team and Enterprise plans.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Auto mode becomes default\",\n    \"description\": \"Auto mode becomes the default permission mode for new sessions on Pro, Max, and Team plans starting August 14.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor Start plan for India\",\n    \"description\": \"New ₹649 monthly plan for developers in India with local pricing and UPI payment, including Grok 4.5 models and cloud agents.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-07-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Google Workspace Plugins\",\n    \"description\": \"Cursor can now read, write, and act across your Google Workspace with plugins for Gmail, Google Drive, and Google Calendar.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor Router with optimization modes\",\n    \"description\": \"Cursor Router is an intelligent model router that analyzes requests and sends them to the right model with Intelligence, Balance, and Cost optimization modes.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"v0.54.0 stable release - Enhanced Authentication & Security\",\n    \"description\": \"Latest stable release with enhanced authentication and security features, core functionality updates, sandbox improvements, and Vertex updates.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-08-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"v0.55.0-preview.1 with experimental features\",\n    \"description\": \"Preview release including latest new and experimental features for early adopters.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-08-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Portable Agent Plugins and conversation organization\",\n    \"description\": \"New features including portable Agent Plugins, plugin catalogs, and conversation organization improvements.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.com/openai/codex/releases\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"MCP support and Amazon Bedrock integration\",\n    \"description\": \"Added MCP support from July 28 and Amazon Bedrock integration for expanded connectivity.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://releasebot.io/updates/openai/codex\",\n    \"date\": \"2026-07-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot memory and JetBrains features\",\n    \"description\": \"New Copilot memory features and Ollama integration in GitHub Copilot for JetBrains.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.com/changelog\",\n    \"date\": \"2026-08-11\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot enterprise management tools\",\n    \"description\": \"New enterprise management tools and administration capabilities for Copilot.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.com/changelog\",\n    \"date\": \"2026-08-11\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Claude 4.5/4.6 and Gemini 2.5 Flash support\",\n    \"description\": \"Added support for Claude 4.5/4.6 models with updated aliases, expanded Gemini model support including 2.5 Flash and Flash-Lite.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://aider.chat/HISTORY.html\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"DeepSeek Reasoner and language support\",\n    \"description\": \"Added DeepSeek Reasoner model, repo map now supports Fortran, Haskell, Julia, and Zig languages.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://aider.chat/HISTORY.html\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"August 2026 updates\",\n    \"description\": \"Recent Windsurf updates for August 2026 available on Releasebot with detailed changelog.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://releasebot.io/updates/windsurf\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": []\n  }\n]"
