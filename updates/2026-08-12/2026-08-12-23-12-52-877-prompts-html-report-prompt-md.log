      "content": "[\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot memory and JetBrains features\",\n    \"description\": \"New Copilot memory features and Ollama integration in GitHub Copilot for JetBrains. Copilot Memory helps the assistant become more effective by remembering facts about repositories and personal coding preferences across workflows.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.github.com/en/copilot/concepts/agents/copilot-memory\",\n    \"date\": \"2026-08-11\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"GitHub Copilot now remembers what it learns across your workflow. Copilot coding agent, CLI, and code review share knowledge automatically.\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Copilot is worse than useless - consistently ignores highest level instructions\",\n        \"source\": \"GitHub Community\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Developers appreciate that Copilot can now retain context instead of starting from zero each time\",\n        \"source\": \"Community feedback\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot enterprise management tools\",\n    \"description\": \"New enterprise management tools and administration capabilities for Copilot.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.com/changelog\",\n    \"date\": \"2026-08-11\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Cross-session messaging\",\n    \"description\": \"Claude Code sessions can now message each other on macOS and Linux, enabling Claude to pass findings and decisions between sessions instead of requiring re-explanation. Introduces ListAgents and SendMessage tools for coordinating work across terminals and worktrees.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"463 upvotes on Reddit with users praising it as cool and useful for avoiding repeated context explanations\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Called a game-changer for developer workflow and productivity\",\n        \"source\": \"Community discussion\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"It's Claude code talking to another Claude code. With tmux, a memory tree, and handoff files and an orchestrator, agents can talk cross harness.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Particularly useful when changes in one session impact work in another session\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Self-hosted environments in public beta\",\n    \"description\": \"Self-hosted environments run Claude Code cloud sessions on infrastructure your organization operates, now in public beta on Team and Enterprise plans.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Auto mode becomes default\",\n    \"description\": \"Auto mode becomes the default permission mode for new sessions on Pro, Max, and Team plans starting August 14.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"v0.54.0 stable release - Enhanced Authentication & Security\",\n    \"description\": \"Latest stable release with enhanced authentication and security features, core functionality updates, sandbox improvements, and Vertex updates including Cloud Run webhook ingestion, path and symlink features.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-08-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"v0.55.0-preview.1 with experimental features\",\n    \"description\": \"Preview release including latest new and experimental features for early adopters.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-08-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Google Workspace Plugins\",\n    \"description\": \"Cursor can now read, write, and act across your Google Workspace with plugins for Gmail, Google Drive, and Google Calendar. Enables coding agents to pull context, draft and update files, and manage inbox and calendar without leaving Cursor.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Described as a bigger deal than the changelog makes it sound - a significant shift in capabilities\",\n        \"source\": \"Blog analysis\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Developers discuss Cursor's seamless results when combined with AI capabilities\",\n        \"source\": \"Community discussion\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor Router with optimization modes\",\n    \"description\": \"Cursor Router is an intelligent model router that analyzes requests and sends them to the right model with Intelligence, Balance, and Cost optimization modes. Frontier models handle demanding work while price-efficient models handle the rest.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor Start plan for India\",\n    \"description\": \"New ₹649 monthly plan for developers in India with local pricing and UPI payment, including Grok 4.5 models, cloud agents, Cursor for iOS with remote control, and plugins/MCP/skills support.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-07-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Portable Agent Plugins and conversation organization\",\n    \"description\": \"New features including portable Agent Plugins, plugin catalogs searchable across local and personal workspace, and conversation organization into persistent sessions.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.com/openai/codex/releases\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"MCP support and Amazon Bedrock integration\",\n    \"description\": \"Added MCP support from July 28 and Amazon Bedrock integration for expanded connectivity.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://releasebot.io/updates/openai/codex\",\n    \"date\": \"2026-07-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Claude 4.5/4.6 and Gemini 2.5 Flash support\",\n    \"description\": \"Added support for Claude 4.5/4.6 models with updated sonnet/haiku/opus aliases, expanded Gemini model support including 2.5 Flash and Flash-Lite, and added Gemini 3 preview models.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://aider.chat/HISTORY.html\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"DeepSeek Reasoner and language support\",\n    \"description\": \"Added DeepSeek Reasoner model with updated metadata and costs, repo map now supports Fortran, Haskell, Julia, and Zig languages, and is compatible with newer tree-sitter Python APIs.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://aider.chat/HISTORY.html\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"August 2026 updates\",\n    \"description\": \"Recent Windsurf updates for August 2026 including Cascade agent improvements, enhanced AI integration, and feature updates.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://releasebot.io/updates/windsurf\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Final 2.0.0 Release - Project End of Life\",\n    \"description\": \"Continue.dev reached end of life with final 2.0.0 release removing anonymous telemetry and other polish work. The project was acquired by Cursor.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/continuedev/continue/releases\",\n    \"date\": \"2026-06-19\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The continuedev/continue project is dead as stated in the README\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  }\n]",
