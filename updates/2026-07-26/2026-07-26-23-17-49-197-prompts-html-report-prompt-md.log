      "filePath": "/home/runner/work/agentdaily/agentdaily/updates/2026-07-26/whitelist-updates.json",
      "content": "[\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Claude Code v2.1.220: Opus 5 default, background agents, security hardening, accessibility milestone\",\n    \"description\": \"Over 10 releases (v2.1.207-v2.1.220) in the period integrated Claude Opus 5 as the new default Opus model (1M context, 128K output, fast mode at $10/$50 per million tokens). Major features include background /code-review as a subagent, /fork creating background sessions, nested subagents up to depth 3, sandbox.network.strictAllowlist, concurrent subagent caps, and a dedicated screen reader mode (--ax-screen-reader). Critical fixes addressed a Windows path corruption bug, quadratic slowdown in long sessions, and prompt-caching billing regression on Bedrock/Vertex.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-07-25\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Claude Opus 5 delivers near Fable 5 intelligence at Opus speed and cost.\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"It's a strict upgrade over Opus 4.8, and the gains are biggest exactly where it matters: the harder, vaguer tasks.\",\n        \"source\": \"Blog comments\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"It's literally the BEST at long-horizon tasks.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Users discovered a hidden 'heron_brook' system prompt in v2.1.219+ instructing Opus 5 not to call the AgentTool unless explicitly requested.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Claude Opus 5 released as new flagship model\",\n    \"description\": \"Anthropic released Claude Opus 5 with 1M token context window, 128K max output, and adaptive thinking with configurable effort parameter. Opus 5 more than doubled Opus 4.8's Frontier-Bench v0.1 score and achieved 3x the ARC-AGI 3 score of the next-best model. Priced at $5/M input, $25/M output (same as Opus 4.8).\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://www.anthropic.com/news/claude-opus-5\",\n    \"date\": \"2026-07-24\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"It's the clearest jump in problem-solving we've seen from one Claude model to the next.\",\n        \"source\": \"Blog comments\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Claude Opus 5: Fable-level performance at Opus price (half Fable) ain't bad.\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"On FrontierCode 1.1, Claude Opus 5 approaches Fable-level performance at half the cost.\",\n        \"source\": \"Blog comments\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Claude Opus 5 added to GitHub Copilot model picker\",\n    \"description\": \"Anthropic's Claude Opus 5 was added to Copilot for complex, long-running agentic coding tasks including autonomous code changes and regression verification. Available for Copilot Pro+, Max, Business, and Enterprise across 11 environments including VS Code, Visual Studio, JetBrains, Xcode, and CLI. Billed at provider API list price under usage-based billing.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-07-24-claude-opus-5-is-now-available-in-github-copilot/\",\n    \"date\": \"2026-07-24\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Excitement around the rapid expansion of available models -- Claude Opus 5, Gemini 3.6 Flash, GPT-5.6 variants all within the same month.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"7x for Opus... what's the point of Copilot now?\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot cloud agent for Linear reaches GA\",\n    \"description\": \"The Copilot cloud agent for Linear transitioned from preview to GA. When a Linear issue is assigned to Copilot, it works independently in an ephemeral GitHub Actions environment, streams progress to the Linear timeline, and opens draft PRs. GA adds model selection, custom agent support, branch control, and mid-session steering via comments.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-07-23-copilot-cloud-agent-for-linear-is-now-generally-available/\",\n    \"date\": \"2026-07-23\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Using GitHub Copilot is a game changer. I don't think it'll really be a low code thing.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Copilot code review will start consuming GitHub Actions minutes [which is a concern].\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Agent automation controls in GitHub Issues (Public Preview)\",\n    \"description\": \"GitHub introduced agent automation controls for Issues: Approvals (suggest rather than directly apply), Confidence Ratings (high/medium/low that auto-apply or hold for review), and Rationale (audit trail of reasoning). Supports labels, fields, type, close, and assignees with configurable thresholds.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-07-23-agent-automation-controls-in-github-issues-in-public-preview/\",\n    \"date\": \"2026-07-23\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"GitHub Issues introduces agent automation controls in public preview, allowing users to approve or decline automated changes with confidence.\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub MCP Server supports next MCP specification (2026-07-28)\",\n    \"description\": \"The GitHub MCP Server now supports the next MCP specification ahead of its official July 28 release. The new spec goes stateless, removing sessions and the initialize handshake for easier scaling. GitHub removed Redis sessions, eliminated deep packet inspection, and upgraded elicitation flows.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-07-23-github-mcp-server-supports-the-next-mcp-specification\",\n    \"date\": \"2026-07-23\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The 2026-07-28 specification is the largest revision since MCP's launch.\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"ChatGPT desktop app v26.715: Voice mode, multi-folder local projects\",\n    \"description\": \"ChatGPT desktop app update introducing Voice mode (powered by GPT-Live) to talk through work and coordinate tasks across Chat, Work, and Codex, with macOS Screen context sharing. Also adds multi-folder local project support with a designated primary folder driving new chats, Git operations, and auto-discovery of AGENTS.md and skills.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://learn.chatgpt.com/docs/changelog\",\n    \"date\": \"2026-07-23\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"15 legacy model snapshots retired including all Codex-branded API models\",\n    \"description\": \"OpenAI shut down 15 model snapshots on July 23, including gpt-5-codex, gpt-5.1-codex, gpt-5.1-codex-max, gpt-5.1-codex-mini, gpt-5.2-codex, o3-deep-research, and o4-mini-deep-research. Users must migrate to GPT-5.5 or GPT-5.6 family (Sol/Terra/Luna). Requests to retired endpoints now fail outright.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://developers.openai.com/api/docs/deprecations\",\n    \"date\": \"2026-07-23\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"If your production code calls any of these endpoints, requests now fail outright.\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Some users report needing to migrate quickly from retired codex models to GPT-5.6 variants.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"v0.53.0-preview.0: LLM triage orchestrator, sandbox hardening, A2A RCE prevention\",\n    \"description\": \"Preview release adding a Caretaker LLM triage orchestrator for automated issue/PR triage with container build configuration. Major security hardening includes macOS Seatbelt profile alignment with deny-default model, workspace trust and task isolation to prevent A2A Remote Code Execution, infinite ReAct loop mitigation, and credential verification fixes.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/preview/\",\n    \"date\": \"2026-07-22\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The Gemini CLI RCE advisory illustrates the exact failure mode security teams should expect from AI coding agents in CI/CD.\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"v0.52.0 stable: Caretaker triage worker, robust file editing, plan mode improvements\",\n    \"description\": \"Stable release introducing a new caretaker triage worker with Cloud Run webhook ingestion and egress services, bypassing LLM corrections for JSON/IPYNB file edits to ensure accuracy, simplified plan mode write policies for relative paths, and improved account visibility messages for users without a Code Assist tier.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/latest/\",\n    \"date\": \"2026-07-22\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Gemini CLI was good in that you could read the changes and if it was botching something, stop it. Gemini CLI was great, despite some of its shortfalls.\",\n        \"source\": \"GitHub Discussions\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"tool wise i like gemini cli.\",\n        \"source\": \"GitHub Discussions\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"I am still bitter from the significantly reduced quotas, even on Ultra, their highest tier.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor Router: intelligent model routing for Auto mode\",\n    \"description\": \"Cursor launched Router, an intelligent request-level classifier that analyzes each coding request and routes it to the optimal model. Three modes (Intelligence, Balance, Cost) with admin controls including per-team enablement, mode restrictions, and model allow/block lists (Enterprise-only). Claims 30-60% cost savings at frontier quality. Available across desktop, web, iOS, CLI, and SDK for Teams and Enterprise plans.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/blog/router\",\n    \"date\": \"2026-07-22\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Auto previously meant a predictable flat rate. After the update, Auto migrated to Auto Balance, which started billing at frontier model rates without clear notification.\",\n        \"source\": \"Forum\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Individual plan users frustrated that Router is Teams/Enterprise-only with no clear prior communication.\",\n        \"source\": \"Forum\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Praise for engineering quality and excitement about potential cost savings.\",\n        \"source\": \"Forum\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"New Copilot usage metrics impact dashboard\",\n    \"description\": \"A new impact dashboard for enterprise admins transforms API-based adoption data into a visual dashboard. Groups users into adoption cohorts (Code-first, Agent-first, Multi-agent, Passive), shows metrics like average PRs merged per user and median PR merge velocity, provides adoption multipliers, and includes 6-month trend charts.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-07-22-new-copilot-usage-metrics-impact-dashboard\",\n    \"date\": \"2026-07-22\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"This dashboard helps you tell a deeper Copilot impact story by sharing not just who is active, but how they're using Copilot.\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"v0.145.0: Multi-Agent V2 stable, Bedrock support, audio inputs, cross-tool import\",\n    \"description\": \"Major release featuring Multi-Agent V2 going stable with configurable sub-agents (independent model, reasoning level, concurrency limit, sandbox profile). /import now migrates settings from Cursor and Claude Code including MCP servers, plugins, and sessions. Added experimental Amazon Bedrock login with GPT-5.6 Sol as default, audio inputs with realtime V3 conversations, and paginated thread history with search and memory integration.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/openai/codex/releases/tag/rust-v0.145.0\",\n    \"date\": \"2026-07-21\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Not easily impressed, but holy wow -- the recent Codex improvements are remarkable.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"The /import feature from Cursor and Claude Code is seen as a significant switching-cost reduction.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Multi-agent V2's ability to parallelize across model tiers is highlighted as a standout feature.\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Encrypted inter-agent communication in Multi-Agent V2 reduces observability -- developers can no longer see what task was delegated to child agents.\",\n        \"source\": \"GitHub Issue #28058\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Devin release notes (July 24): Redesigned model picker, slash commands, OIDC tokens, Windows sessions from Slack\",\n    \"description\": \"Devin shipped a redesigned unified model picker, discoverable slash commands in the message box (/btw, /queue, /ask), playbook previews on hover, the ability to start Windows sessions from Slack via !windows, approve/deny network access from Slack, clickable finding counts in Devin Review, required approvals visibility, OIDC identity tokens for cloud auth, and API additions for unarchiving sessions and creating ingestion-mode code scans.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-07-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Gemini 3.6 Flash added to GitHub Copilot\",\n    \"description\": \"Google's Gemini 3.6 Flash was added to Copilot for web/app development, coding, and longer-horizon agentic tasks with configurable reasoning effort and parallel tool use. Available for Copilot Pro and higher across 8 environments. This follows the deprecation of Gemini 2.5 Pro and Gemini 3 Flash.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-07-21-gemini-3-6-flash-is-now-available-in-github-copilot/\",\n    \"date\": \"2026-07-21\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"3.6 Flash is a really really good model for code implementations.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Flash 3.6 is a tiny bit worse than 3.5 sometimes but mostly the same, however the thinking time is literally half with high thinking.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Devin release notes (July 22): Devin Outposts, Linear thread handling, automations consumption visibility\",\n    \"description\": \"Devin introduced Outposts for running workloads in your own environment, smarter Linear thread handling (replies route to the correct session), a new Consumption tab showing ACUs used by each automation, Slack channel improvements for automations, safer MCP access changes with warning steps, and performance improvements including faster webapp loading and better large diff handling.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-07-22\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Agent Swarms blog: AI agents autonomously rebuild SQLite from spec\",\n    \"description\": \"Cursor published a research blog documenting a swarm of AI agents autonomously rebuilding SQLite from its 835-page specification into a Rust replica that passed 100% of a held-out test suite. The hierarchical architecture reached ~1,000 commits/hour and reduced costs ~8x from ~$10,565 to ~$1,339 per run using Opus 4.8 planner + Composer 2.5 workers.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://cursor.com/blog/agent-swarm-model-economics\",\n    \"date\": \"2026-07-20\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Generated significant discussion on Hacker News and Reddit, with excitement about scalability implications and debate about agent swarm economics.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"AI credit pools for cost centers in billing UI + per-cycle credit visibility\",\n    \"description\": \"Enterprise admins can now manage a cost center's AI credit pool through the billing UI (previously API-only). GitHub auto-calculates pool limits from assigned licenses. Additionally, users can now see AI credits consumed per billing cycle. Addresses ongoing community complaints about opaque usage-based billing.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-07-20-ai-credit-pools-for-cost-centers-in-the-billing-ui\",\n    \"date\": \"2026-07-20\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"GitHub Copilot AI Credit billing is speedrunning a trust crisis.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Credits are consumed too quickly, especially when using agent mode, code review, debugging, or repository-related tasks.\",\n        \"source\": \"Forum\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Devin Desktop v3.5.17: Cloud session performance, Fast Context, hooks migration\",\n    \"description\": \"The latest Devin Desktop (formerly Windsurf) stable release brings faster rendering for long cloud sessions, inline network policy configuration, Fast Context support in Devin Local, a hooks tab in Devin Local Customizations, instant worktree-backed sessions, and a command to migrate Windsurf hooks into Devin hooks. Status bar is now hidden by default in the Agent Command Center.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-07-19\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"RIP Windsurf -- Devin is the most cringy thing I've seen in the last 10 years.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Users question whether development has stalled post-acquisition by Cognition.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"The new system forces you to work like a 9-to-5 clerk with equal daily limits, locking out devs who hit limits on weekends.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"v0.144.6: Fixes bundled instructions for GPT-5.6 Sol/Terra/Luna context windows\",\n    \"description\": \"Refreshed bundled instructions for GPT-5.6 Sol, Terra, and Luna models, and corrected their context windows to 272,000 tokens. Ensures proper model behavior and accurate context handling.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://github.com/openai/codex/releases/tag/rust-v0.144.6\",\n    \"date\": \"2026-07-18\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Repository-level usage metrics GA + Copilot code review customization improvements\",\n    \"description\": \"Repository-level granularity for Copilot usage metrics moved to GA. Copilot code review gained four improvements: custom instructions read from head branch, expanded file support (REVIEW.md, GEMINI.md, CLAUDE.md), new copilot-code-review.yml workflow file, and firewall support enabled by default.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-07-17-repository-level-github-copilot-usage-metrics-generally-available\",\n    \"date\": \"2026-07-17\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Copilot code review now supports firewall use [and] custom setup steps.\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor in Slack improvements: multi-repo, cross-channel workflows\",\n    \"description\": \"Cursor upgraded its Slack integration with plan-first behavior (sharing a plan before starting work), multi-repo environment support, cross-channel workflows (reading from and posting to other channels), and UI refinements including compact footers and cleaner rendering of tables and PRs.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-07-17\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Multi-repo and cross-channel support well-received.\",\n        \"source\": \"Forum\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Release notes (July 17): Centralized plugin management, multi-repo code scans, chained attack paths\",\n    \"description\": \"Major Devin update introducing centralized skill management via plugins (installable across Cloud, CLI, and Desktop), enterprise-grade plugin governance, multi-repository code scans with per-repo details, chained attack paths linking related security findings, a new Tasks tab, inline link previews, sortable chat tables, and revamped automations pages with GitHub Enterprise Server support.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-07-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Introducing Devin Outposts: Run Devin Cloud sessions on any machine you operate\",\n    \"description\": \"Cognition announced Devin Outposts, enabling Devin Cloud sessions to run on any user-operated machine -- GPU boxes, VMs in private networks, Kubernetes clusters, or local hardware. Outposts are named queues with workers that only dial out (no inbound connectivity required). Partners include Namespace, Cloudflare, Modal, NVIDIA Brev, Daytona, and E2B.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://devin.ai/blog/introducing-devin-outposts\",\n    \"date\": \"2026-07-21\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"89% of all code committed at Cognition is now written by Devin, up from 13% in December 2025.\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Partner endorsements from Namespace, Cloudflare, Modal, NVIDIA, Daytona, and E2B.\",\n        \"source\": \"Blog comments\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Community fork 'cecli' (aider-ce) ships v0.100.14 with MCP retry and config support\",\n    \"description\": \"The community-driven fork of Aider, rebranded as 'cecli', shipped three releases in July 2026 (v0.100.11, v0.100.12, v0.100.14). Latest adds --spinner/--no-spinner option, MCP connection retry logic, global config file support at ~/.cecli/conf.yml, syntax validation pre-edit, and --model-providers for OpenAI-compatible providers. The original Aider project remains stalled with no PyPI release since February 2026.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/dwash96/aider-ce/releases\",\n    \"date\": \"2026-07-15\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Aider-CE is the new Aider. It adds all the unmerged contributions and is the easiest way to learn how a barebones AI coding CLI works.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"The most active fork of the project is dwash96/aider-ce, where Dustin is doing substantial work.\",\n        \"source\": \"GitHub\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Aider blows Claude Code completely out of the water in actually getting serious work done. But you have to be more hands-on.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"All cloud user data permanently deleted as product wind-down completes\",\n    \"description\": \"Following Continue's acquisition by Cursor (Anysphere) in mid-June 2026, all remaining cloud user data was permanently deleted on July 15, 2026. The GitHub repository (35.1k stars) remains read-only with no new commits. The final release was v2.0.0-vscode (June 19, 2026). Community fork efforts remain nascent with no viable successor. Users are migrating to Cline, Roo Code, GitHub Copilot, and Claude Code.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.com/continuedev/continue\",\n    \"date\": \"2026-07-15\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"There was no press release, no migration wizard, and no warning beyond a homepage FAQ.\",\n        \"source\": \"Blog comments\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Buying and shutting down open source projects that I'm using is a great way to make sure I NEVER use any of your offerings.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"This did prompt me to install Cline and swap out my old self-hosted model for Qwen 3.6 and it's leagues better.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"v0.144.5: Improved dangerous-command detection with clearer rejection reasons\",\n    \"description\": \"Improved dangerous-command detection, including more forced rm forms. Provides clearer rejection reasons when commands are denied, strengthening safety and approval handling.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://github.com/openai/codex/releases/tag/rust-v0.144.5\",\n    \"date\": \"2026-07-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Cascade agent officially end-of-life; Devin Local is sole local agent\",\n    \"description\": \"Following the July 1 hard cutover, the Cascade agent that powered Windsurf since inception is fully end-of-life. Devin Local (a Rust-based rewrite up to 30% more token-efficient) is the only supported local agent. July releases added migration tooling including a guided 'Migrate off Cascade' wizard. Community remains divided on the transition.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://docs.devin.ai/desktop/changelog\",\n    \"date\": \"2026-07-15\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Adieu Windsurf (now Devin), it's been a good run. Been using Windsurf since Aug 2025.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"The Windsurf -> Devin migration didn't carry over the Cascade memories.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Visual Studio June Update: Copilot usage tracking, MCP trust validation, C++ modernization agent GA\",\n    \"description\": \"Major Visual Studio 2026 update adding real-time Copilot usage tracking with limit notifications, trust validation for MCP servers comparing against a trusted baseline, GA of the C++ Modernization Agent (MSVC upgrade scenarios), long-distance next edit suggestions spanning entire files, and in-IDE pull request review.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-07-14-github-copilot-in-visual-studio-june-update/\",\n    \"date\": \"2026-07-14\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The preview C++ Copilot feature was auto-enabled, causing time loss and needless work.\",\n        \"source\": \"Forum\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"JetBrains BYOK expansion + AI security detections on PRs + security reviews in Copilot app\",\n    \"description\": \"Major expansion of bring-your-own-key for JetBrains IDEs: OpenAI-compatible custom endpoint support, Claude agent provider customizations (preview), local sandboxing (preview), and built-in debugger skill. Also added AI-powered code scanning detections directly on pull requests and /security-review slash command in the Copilot app (public preview).\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-07-14-github-copilot-for-jetbrains-expands-byok-capabilities\",\n    \"date\": \"2026-07-14\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"BYOK updates make Copilot more customizable, controllable, and enterprise-ready.\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"v0.144.2: Guardian auto-review prompting regression rollback\",\n    \"description\": \"Rolls back a regression in Guardian automatic-review prompting that affected how risk is interpreted, what context the reviewer receives, and whether approval behavior remains consistent. Teams relying on automatic approval reviews should prefer the patched release.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://github.com/openai/codex/releases/tag/rust-v0.144.2\",\n    \"date\": \"2026-07-13\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Users may not interact with Guardian directly. It can operate behind approval flows. This means the patch may matter even when users did not notice an obvious CLI or TUI regression.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Agentic Autofix for Code Scanning Alerts (Public Preview)\",\n    \"description\": \"A fully agentic version of Autofix powered by the Copilot cloud agent that autonomously creates fixes for CodeQL-generated code scanning alerts. Supports multi-file remediation, validates fixes by rerunning analysis, and can auto-generate PRs with verified fixes. Typically takes 2-4 minutes per fix.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-07-10-agentic-autofix-for-code-scanning-alerts-in-public-preview/\",\n    \"date\": \"2026-07-10\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Agentic Autofix moves beyond single-line patches and rewrites connected code across multiple files.\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  }\n]\n",
