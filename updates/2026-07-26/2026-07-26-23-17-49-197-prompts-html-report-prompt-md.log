          "+            <span class=\"product-label\">GitHub Copilot</span>",
          "+            <span class=\"update-type feature\">Feature</span>",
          "+            <div class=\"item-title\"><a href=\"https://github.blog/changelog/2026-07-20-ai-credit-pools-for-cost-centers-in-the-billing-ui\" target=\"_blank\" rel=\"noopener\">AI credit pools for cost centers in billing UI</a></div>",
          "+            <p class=\"item-desc\">Enterprise admins can now manage cost center AI credit pools through the billing UI (previously API-only). Users can see AI credits consumed per billing cycle. Addresses ongoing complaints about opaque usage-based billing.</p>",
          "+            <div class=\"item-meta\"><span class=\"date\">2026-07-20</span></div>",
