  "old_string": "[\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Queueing Support for Automations\",\n    \"description\": \"Devin introduced queueing support for automations, AI-generated review comments, and many smaller fixes and improvements.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-08-07\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"improvements in reliability and consistency, though noting Devin AI can sometimes get stuck in loops or make incorrect assumptions\",\n        \"source\": \"Gartner Peer Insights\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Weekly Releases - CLI, VS Code Enhancements\",\n    \"description\": \"GitHub Copilot released weekly updates including improvements for CLI resume and organization, VS Code review capabilities, side chats, shared sessions, and worktree workflows.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-08-07-github-copilot-weekly-releases-august-3/\",\n    \"date\": \"2026-08-07\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Google Workspace Plugins\",\n    \"description\": \"Cursor can now read, write, and act across Google Workspace with new plugins for enhanced connectivity.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Self-Hosted Environments Public Beta\",\n    \"description\": \"Claude Code added public beta self-hosted environments, allowing teams to run sessions on their own infrastructure with internal network access.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://releasebot.io/updates/anthropic/claude\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"I've been using Claude to work on a medium-sized (100+kLoc) codebase, and it's a great productivity multiplier.\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Claude Code sessions were starting at ~35K tokens\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"8 New Features Released\",\n    \"description\": \"Claude Code released 8 new features including deeper agent integration and new safe mode.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://blog.mean.ceo/claude-code-news-august-2026/\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"GPT-5.5 Default Model and GPT-5.6 Integration\",\n    \"description\": \"Codex CLI updated to use GPT-5.5 as the default model and began integrating GPT-5.6 Sol Ultra. Current version v0.144.0.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://blakecrosley.com/blog/codex-vs-claude-code-2026\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Final Preview Update Before Shutdown\",\n    \"description\": \"Gemini CLI shipped a preview update with core reliability fixes, security improvements, enhanced context handling, and caretaker/triage improvements. The tool was officially shut down on June 18, 2026, replaced by Antigravity CLI.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-08-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Upcoming Model Deprecations\",\n    \"description\": \"GitHub announced that several Copilot models will be deprecated starting September 1, 2026, affecting Copilot Chat, inline edits, Ask mode, and Agent modes.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/2026-07-31-upcoming-august-2026-model-deprecations-in-github-copilot/\",\n    \"date\": \"2026-07-31\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"End of an Era... Copilot is DEAD\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Users are complaining about significant price increases (Opus model reportedly ~2x the price)\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Discussions about switching to cheaper models for lower-level tasks\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Users noting that new Opus 4.7 model has 7.5x requests in Pro+ but costs 4x more\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  }\n]",
