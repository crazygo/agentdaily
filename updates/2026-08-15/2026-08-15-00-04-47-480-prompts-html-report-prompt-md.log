ductName\": \"Codex CLI\",\n    \"title\": \"Agent Import functionality and Linux Desktop Preview\",\n    \"description\": \"Support for importing from Claude Code, Claude Cowork, and Cursor including instructions, settings, skills, plugins, projects, and recent work. ChatGPT desktop app for Linux available for Ubuntu, Debian, and Fedora on x64 and ARM64 processors.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://learn.chatgpt.com/docs/changelog\",\n    \"date\": \"2026-08-11\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Computer History for macOS\",\n    \"description\": \"Feature in macOS desktop app that converts activity across applications and websites into memories and timeline that ChatGPT and Codex can use. Users can control which apps and websites contribute, pause collection, and review or delete history. Limited to Pro, Business, and Enterprise users.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://learn.chatgpt.com/docs/changelog\",\n    \"date\": \"2026-08-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"v0.54.0 - PR Automation and security enhancements\",\n    \"description\": \"Integrated Antigravity agent runner with dual-locking Firestore concurrency controls for PR generator. Enhanced caretaker triage to post comments prior to auto-closing issues. Prevented cleartext credential leakage by enforcing HTTPS, rotated session IDs on model fallbacks, and skipped merged function-response turns.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-08-06\",\n    \"community_feedback\": []\n  }\n]",
