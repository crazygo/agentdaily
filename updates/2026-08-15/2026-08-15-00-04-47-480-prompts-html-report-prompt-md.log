      "content": "[\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Cross-session messaging and self-hosted environments\",\n    \"description\": \"Claude Code sessions can now message each other on macOS and Linux, enabling Claude to pass findings between sessions. Self-hosted runner support launched in public beta for Team/Enterprise plans, allowing organizations to run Claude Code cloud sessions on their own infrastructure.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w32\",\n    \"date\": \"2026-08-03\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Auto mode becomes default for new sessions\",\n    \"description\": \"Auto mode is now the default permission mode for new sessions on Pro, Max, and Team plans, streamlining the workflow by reducing manual approval prompts.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w32\",\n    \"date\": \"2026-08-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"VS Code Focus view and subagent forking default\",\n    \"description\": \"VS Code extension receives new Focus view for better workspace management. Major subagent forking is now enabled by default, improving task distribution and parallel processing capabilities.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-08-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Cross-session SendMessage and GitLab integration\",\n    \"description\": \"SendMessage tool now supports cross-machine communication. GitLab integration enhanced with merge request URL support and token redaction. Remote Control reconnection resilience improved.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-08-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Security fixes and credential masking\",\n    \"description\": \"Critical security fixes including Windows NTLM credential-leak closure, Bash permission bypass hardening, and sandbox credential masking. MCP v2 connection improvements and PowerShell/Cygwin permission fixes.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-08-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Gateway spend-limit support and workspace trust\",\n    \"description\": \"Added gateway spend-limit support, workspace trust prompts, and OAuth 401 transient error fixes. Remote Control now supports photo attachments.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-08-08\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Plugin marketplace and self-hosted runner hooks\",\n    \"description\": \"Self-hosted environments (`claude self-hosted-runner`) with hook support, plugin marketplace command sources, and archive plugin source capability. SSE keepalive for streaming improved.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-08-07\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cloud Agents start 3x faster with Builds\",\n    \"description\": \"Cursor introduced 'builds'—ready-to-use development environments prepared in the background. Agents boot 10x faster with 3x faster time to first token. Build history dashboard allows inspection of build status, logs, and commit SHAs.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/blog/builds\"