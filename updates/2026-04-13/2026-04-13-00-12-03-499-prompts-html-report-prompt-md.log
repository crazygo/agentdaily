→    \"description\": \"GitHub Copilot CLI now supports Bring Your Own Key (BYOK) and local model configurations, giving enterprises more control over their AI deployments.\",\n   138→    \"updateType\": \"feature\",\n   139→    \"url\": \"https://github.blog/changelog\",\n   140→    \"date\": \"2026-04-07\",\n   141→    \"community_feedback\": []\n   142→  },\n   143→  {\n   144→    \"productName\": \"GitHub Copilot\",\n   145→    \"title\": \"Copilot Cloud Agent Validation Tools 20% Faster\",\n   146→    \"description\": \"Validation tools in Copilot's cloud agent have been optimized to run 20% faster, improving response times for code review and validation tasks.\",\n   147→    \"updateType\": \"feature\",\n   148→    \"url\": \"https://github.blog/changelog\",\n   149→    \"date\": \"2026-04-08\",\n   150→    \"community_feedback\": []\n   151→  },\n   152→  {\n   153→    \"productName\": \"GitHub Copilot\",\n   154→    \"title\": \"Copilot CLI Activity in Usage Metrics\",\n   155→    \"description\": \"Copilot CLI usage is now included in organization usage metrics, providing better visibility into CLI-based AI assistant usage.\",\n   156→    \"updateType\": \"feature\",\n   157→    \"url\": \"https://github.blog/changelog\",\n   158→    \"date\": \"2026-04-10\",\n   159→    \"community_feedback\": []\n   160→  },\n   161→  {\n   162→    \"productName\": \"Codex CLI\",\n   163→    \"title\": \"Version 0.120.0: Realtime V2 Background Agent Streaming\",\n   164→    \"description\": \"Codex CLI v0.120.0 (April 11, 2026) introduces Realtime V2 background agent streaming, custom TUI status lines, and code-mode tool declarations with MCP outputSchema support.\",\n   165→    \"updateType\": \"release\",\n   166→    \"url\": \"https://developers.openai.com/codex/changelog\",\n   167→    \"date\": \"2026-04-11\",\n   168→    \"community_feedback\": []\n   169→  },\n   170→  {\n   171→    \"productName\": \"Windsurf\",\n   172→    \"title\": \"Version 1.9600.38: Adaptive