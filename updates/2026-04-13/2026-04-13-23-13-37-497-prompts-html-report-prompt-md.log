      "content": "[\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Version 0.120.0: Realtime V2 Background Agent Streaming\",\n    \"description\": \"Codex CLI v0.120.0 (April 11, 2026) introduces Realtime V2 background agent streaming, custom TUI status lines, and code-mode tool declarations with MCP outputSchema support.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-04-11\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Version 0.37.1: Latest Stable Release\",\n    \"description\": \"Gemini CLI v0.37.1 (April 9, 2026) is the latest stable release with performance improvements and enhanced multimodal capabilities.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-04-09\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot CLI Activity in Usage Metrics\",\n    \"description\": \"Copilot CLI usage is now included in organization usage metrics, providing better visibility into CLI-based AI assistant usage.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-04-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Cloud Agent Validation Tools 20% Faster\",\n    \"description\": \"Validation tools in Copilot's cloud agent have been optimized to run 20% faster, improving response times for code review and validation tasks.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-04-08\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 1.9600.41: Adaptive Model Router\",\n    \"description\": \"Windsurf 1.9600.41 introduces adaptive model router for intelligent task routing to optimal models, plus GPT-5.4 mini integration and various model updates.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-04-07\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot CLI BYOK and Local Model Support\",\n    \"description\": \"GitHub Copilot CLI now supports Bring Your Own Key (BYOK) and local model configurations, giving enterprises more control over their AI deployments.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-04-07\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 1.9600.40: GPT-5.4 Mini Integration\",\n    \"description\": \"Added GPT-5.4 mini model support for faster, more efficient code completion and generation tasks.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-04-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 1.9600.38: Adaptive Model for Dynamic Selection\",\n    \"description\": \"Introduced Adaptive Model feature that dynamically selects the most appropriate AI model based on task complexity and context.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-04-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Version 0.56.0: Prompt Caching and Report Command\",\n    \"description\": \"Aider v0.56.0 introduces prompt caching for Sonnet via OpenRouter for improved performance, new /report command for session summaries, and --chat-language switch for multi-language support.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/paul-gauthier/aider/releases\",\n    \"date\": \"2026-04-05\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Version 1.3.38-vscode: Config Fixes and Workspace Filtering\",\n    \"description\": \"Continue v1.3.38-vscode includes config.yaml fixes, workspace directory filtering capabilities, and support for .continue/configs directory structure.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/continuedev/continue/releases\",\n    \"date\": \"2026-04-04\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot SDK Public Preview\",\n    \"description\": \"GitHub Copilot SDK entered public preview, allowing developers to build custom integrations and extend Copilot capabilities.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-04-02\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor 3: Background Agents in Slack Integration\",\n    \"description\": \"Cursor 3 now supports launching Background Agents directly from Slack by mentioning @Cursor, enabling AI-powered workflows within team communication channels. Also includes BugBot for automatic PR review, one-click MCP server installation, Jupyter notebook support, Memories feature for context persistence, and unified request-based pricing.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-04-01\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Thirty minutes after the Cursor 3 announcement hit Hacker News, the top comment wasn't about a feature. It was a plea. 'I wish they'd keep the old philosophy of letting the developer drive and the agent assist,' one user wrote. 'I still want to _code_, not vibe my way through tickets.'\",\n        \"source\": \"Medium\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Week 14 Updates: Computer Use in CLI, Interactive Lessons\",\n    \"description\": \"Claude Code Week 14 (March 30 - April 3, 2026) introduces computer use capabilities to the CLI, allowing Claude to open native apps, click through UI, test its own changes, and fix issues from the terminal. Also includes interactive lessons (/powerup), flicker-free rendering, MCP result-size overrides (up to 500K characters), and plugin executables added to PATH.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w14\",\n    \"date\": \"2026-03-30\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The timing is hard to ignore: just ten days ago, Anthropic sent legal threats to OpenCode, forcing them to remove built-in Claude authentication because third-party tools were using Claude Code's internal APIs to access Opus at subscription rates instead of pay-per-token pricing.\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"accidentally shipping your source map to npm is the kind of mistake that sounds impossible until you remember that a lot of the codebase was probably written by the AI you are shipping\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  }\n]\n",
