      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Agentic Coding Research Report - 2026-04-13</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: Verdana, Geneva, sans-serif;\n            font-size: 10pt;\n            background-color: #f6f6ef;\n            color: #000000;\n            line-height: 1.4;\n        }\n\n        a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        a:hover {\n            text-decoration: underline;\n        }\n\n        .accent-link {\n            color: #ff6600;\n        }\n\n        .accent-link:hover {\n            color: #ff6600;\n            text-decoration: underline;\n        }\n\n        header {\n            background-color: #ff6600;\n            padding: 2px 4px;\n            border-bottom: 1px solid #d4d4d4;\n        }\n\n        .header-content {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n        }\n\n        .header-title {\n            font-family: Arial, Helvetica, sans-serif;\n            font-weight: bold;\n            font-size: 14pt;\n            color: #000000;\n        }\n\n        .header-nav {\n            font-size: 9pt;\n        }\n\n        .header-nav a {\n            color: #000000;\n            margin-left: 10px;\n        }\n\n        .sub-header {\n            background-color: #f6f6ef;\n            padding: 8px 4px;\n            border-bottom: 1px solid #ff6600;\n            max-width: 1400px;\n            margin: 0 auto;\n        }\n\n        .report-date {\n            font-size: 9pt;\n            color: #828282;\n        }\n\n        main {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 10px 4px;\n        }\n\n        .three-column-layout {\n            display: grid;\n            grid-template-columns: 40% 35% 25%;\n            gap: 10px;\n            margin-top: 10px;\n        }\n\n        @media (max-width: 1200px) {\n            .three-column-layout {\n                grid-template-columns: 1fr 1fr;\n            }\n\n            .technical-insights {\n                grid-column: 1 / -1;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .three-column-layout {\n                grid-template-columns: 1fr;\n            }\n\n            .technical-insights {\n                grid-column: 1;\n            }\n        }\n\n        .section {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            padding: 10px;\n            border-radius: 2px;\n        }\n\n        .section-header {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 12pt;\n            font-weight: bold;\n            margin-bottom: 12px;\n            padding-bottom: 6px;\n            border-bottom: 1px solid #ff6600;\n            color: #000000;\n        }\n\n        .item {\n            margin-bottom: 14px;\n            padding-bottom: 12px;\n            border-bottom: 1px dotted #d4d4d4;\n        }\n\n        .item:last-child {\n            border-bottom: none;\n            margin-bottom: 0;\n            padding-bottom: 0;\n        }\n\n        .item-title {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 10pt;\n            font-weight: bold;\n            margin-bottom: 4px;\n            line-height: 1.3;\n        }\n\n        .item-title a {\n            color: #000000;\n        }\n\n        .item-description {\n            font-size: 9pt;\n            color: #000000;\n            margin-bottom: 4px;\n            line-height: 1.4;\n        }\n\n        .item-meta {\n            font-size: 8pt;\n            color: #828282;\n            margin-top: 4px;\n        }\n\n        .meta-row {\n            margin-bottom: 2px;\n        }\n\n        .tags {\n            display: inline-block;\n            margin-top: 4px;\n        }\n\n        .tag {\n            display: inline-block;\n            background-color: #f6f6ef;\n            border: 1px solid #d4d4d4;\n            padding: 1px 5px;\n            font-size: 7pt;\n            margin-right: 4px;\n            margin-bottom: 2px;\n            border-radius: 2px;\n            color: #828282;\n        }\n\n        .type-badge {\n            display: inline-block;\n            padding: 1px 5px;\n            font-size: 7pt;\n            font-weight: bold;\n            border-radius: 2px;\n            margin-right: 5px;\n            text-transform: uppercase;\n        }\n\n        .type-technical {\n            background-color: #e8f4f8;\n            color: #0066cc;\n        }\n\n        .type-opinion {\n            background-color: #fff4e8;\n            color: #cc6600;\n        }\n\n        .type-discussion {\n            background-color: #f0e8ff;\n            color: #6600cc;\n        }\n\n        .update-type {\n            display: inline-block;\n            padding: 1px 5px;\n            font-size: 7pt;\n            background-color: #f0f0f0;\n            border: 1px solid #cccccc;\n            border-radius: 2px;\n            margin-right: 5px;\n            color: #666666;\n            text-transform: capitalize;\n        }\n\n        .product-name {\n            font-weight: bold;\n            color: #000000;\n        }\n\n        .empty-section {\n            font-style: italic;\n            color: #828282;\n            font-size: 9pt;\n            text-align: center;\n            padding: 20px;\n        }\n\n        .feedback-section {\n            margin-top: 8px;\n            padding: 6px;\n            background-color: #fafafa;\n            border-left: 2px solid #ff6600;\n            font-size: 8pt;\n        }\n\n        .feedback-quote {\n            font-style: italic;\n            color: #555555;\n            margin-bottom: 4px;\n        }\n\n        .feedback-source {\n            color: #828282;\n            font-size: 7pt;\n        }\n\n        .feedback-sentiment {\n            display: inline-block;\n            padding: 1px 4px;\n            font-size: 7pt;\n            border-radius: 2px;\n            margin-left: 5px;\n            text-transform: capitalize;\n        }\n\n        .sentiment-positive {\n            background-color: #e8f5e9;\n            color: #2e7d32;\n        }\n\n        .sentiment-negative {\n            background-color: #ffebee;\n            color: #c62828;\n        }\n\n        .sentiment-neutral {\n            background-color: #f5f5f5;\n            color: #616161;\n        }\n\n        footer {\n            max-width: 1400px;\n            margin: 20px auto 0;\n            padding: 10px 4px;\n            border-top: 1px solid #d4d4d4;\n            text-align: center;\n            font-size: 8pt;\n            color: #828282;\n        }\n\n        footer a {\n            color: #828282;\n        }\n\n        footer a:hover {\n            color: #ff6600;\n        }\n\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            .section {\n                break-inside: avoid;\n            }\n\n            .three-column-layout {\n                display: block;\n            }\n\n            .section {\n                margin-bottom: 20px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <div class=\"header-content\">\n            <div class=\"header-title\">Agentic Coding Research Report</div>\n            <nav class=\"header-nav\">\n                <a href=\"#new-products\">New</a>\n                <a href=\"#updates\">Updates</a>\n                <a href=\"#insights\">Insights</a>\n            </nav>\n        </div>\n    </header>\n\n    <div class=\"sub-header\">\n        <div class=\"report-date\">\n            <strong>Date:</strong> April 13, 2026 |\n            <strong>Sections:</strong> 0 New Products, 17 Whitelist Updates, 12 Technical Insights\n        </div>\n    </div>\n\n    <main>\n        <div class=\"three-column-layout\">\n            <!-- New Products Section -->\n            <section class=\"section\" id=\"new-products\">\n                <div class=\"section-header\">New Products & Tools</div>\n                <div class=\"empty-section\">\n                    No new products discovered for this date. Check back tomorrow for the latest tools in agentic coding!\n                </div>\n            </section>\n\n            <!-- Whitelist Updates Section -->\n            <section class=\"section\" id=\"updates\">\n                <div class=\"section-header\">Whitelist Updates</div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Codex CLI</span> — Version 0.120.0\n                    </div>\n                    <div class=\"item-description\">\n                        Realtime V2 background agent streaming, custom TUI status lines, and code-mode tool declarations with MCP outputSchema support.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Release</span> <span class=\"accent-link\">2026-04-11</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">GitHub Copilot</span> — Copilot CLI Activity in Usage Metrics\n                    </div>\n                    <div class=\"item-description\">\n                        Copilot CLI usage now included in organization usage metrics, providing better visibility into CLI-based AI assistant usage.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Feature</span> <span class=\"accent-link\">2026-04-10</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">GitHub Copilot</span> — Cloud Agent Validation Tools 20% Faster\n                    </div>\n                    <div class=\"item-description\">\n                        Validation tools in Copilot's cloud agent have been optimized to run 20% faster, improving response times for code review and validation tasks.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Feature</span> <span class=\"accent-link\">2026-04-08</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">GitHub Copilot</span> — Copilot CLI BYOK and Local Model Support\n                    </div>\n                    <div class=\"item-description\">\n                        GitHub Copilot CLI now supports Bring Your Own Key (BYOK) and local model configurations, giving enterprises more control over their AI deployments.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Feature</span> <span class=\"accent-link\">2026-04-07</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Aider</span> — Version 0.56.0\n                    </div>\n                    <div class=\"item-description\">\n                        Introduces prompt caching for Sonnet via OpenRouter for improved performance, new /report command for session summaries, and --chat-language switch for multi-language support.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Release</span> <span class=\"accent-link\">2026-04-05</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Continue</span> — Version 1.3.38-vscode\n                    </div>\n                    <div class=\"item-description\">\n                        Config.yaml fixes, workspace directory filtering capabilities, and support for .continue/configs directory structure.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Release</span> <span class=\"accent-link\">2026-04-04</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">GitHub Copilot</span> — Copilot SDK Public Preview\n                    </div>\n                    <div class=\"item-description\">\n                        GitHub Copilot SDK entered public preview, allowing developers to build custom integrations and extend Copilot capabilities.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Announcement</span> <span class=\"accent-link\">2026-04-02</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Windsurf</span> — Version 1.9600.41: Adaptive Model Router\n                    </div>\n                    <div class=\"item-description\">\n                        Adaptive model router for intelligent task routing to optimal models, plus GPT-5.4 mini integration and various model updates.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Release</span> <span class=\"accent-link\">2026-04-07</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Windsurf</span> — Version 1.9600.40: GPT-5.4 Mini Integration\n                    </div>\n                    <div class=\"item-description\">\n                        Added GPT-5.4 mini model support for faster, more efficient code completion and generation tasks.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Release</span> <span class=\"accent-link\">2026-04-06</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Windsurf</span> — Version 1.9600.38: Adaptive Model\n                    </div>\n                    <div class=\"item-description\">\n                        Introduced Adaptive Model feature that dynamically selects the most appropriate AI model based on task complexity and context.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Feature</span> <span class=\"accent-link\">2026-04-06</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Cursor</span> — Unified Request-Based Pricing Model\n                    </div>\n                    <div class=\"item-description\">\n                        Cursor simplified pricing to a unified request-based model, replacing previous complex tier structures.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Announcement</span> <span class=\"accent-link\">2026-04-01</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Cursor</span> — Memories Feature: Context Persistence\n                    </div>\n                    <div class=\"item-description\">\n                        Memories feature allows Cursor to remember important project context and user preferences across sessions for more personalized assistance.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Feature</span> <span class=\"accent-link\">2026-04-01</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Cursor</span> — Jupyter Notebook Support\n                    </div>\n                    <div class=\"item-description\">\n                        Added support for Jupyter Notebook files with enhanced editing and AI assistance capabilities for data science workflows.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Feature</span> <span class=\"accent-link\">2026-04-01</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Cursor</span> — One-Click MCP Server Installation\n                    </div>\n                    <div class=\"item-description\">\n                        Simplified installation process for MCP (Model Context Protocol) servers with a single click, reducing setup complexity for external tool integrations.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Feature</span> <span class=\"accent-link\">2026-04-01</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Cursor</span> — BugBot: Automatic PR Review Agent\n                    </div>\n                    <div class=\"item-description\">\n                        BugBot provides automated pull request review capabilities, identifying issues and suggesting fixes before merge.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Feature</span> <span class=\"accent-link\">2026-04-01</span></div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"product-name\">Cursor</span> — Background Agents in Slack Integration\n                    </div>\n                    <div class=\"item-description\">\n                        Cursor now supports launching Background Agents directly from Slack by mentioning @Cursor, enabling AI-powered workflows within team communication channels.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\"><span class=\"update-type\">Feature</span> <span class=\"accent-link\">2026-04-01</span></div>\n                    </div>\n                    <div class=\"feedback-section\">\n                        <div class=\"feedback-quote\">\"I wish they'd keep the old philosophy of letting the developer drive and the agent assist. I still want to _code_, not vibe my way through tickets.\"</div>\n                        <div class=\"feedback-source\">\n                            — Medium <span class=\"feedback-sentiment sentiment-negative\">Negative</span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Technical Insights Section -->\n            <section class=\"section\" id=\"insights\">\n                <div class=\"section-header\">Technical Insights</div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"type-badge type-discussion\">Discussion</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/2/lenny-podcast-highlights/\" class=\"accent-link\" target=\"_blank\">Agentic Engineering Conversation Highlights</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Simon Willison on Lenny's Podcast covering agentic engineering, coding agents, and the state of AI in 2026.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\">Simon Willison / Lenny Rachitsky</div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">agentic-engineering</span>\n                            <span class=\"tag\">coding-agents</span>\n                            <span class=\"tag\">automation</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"type-badge type-technical\">Technical</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/2/gemma-4/\" class=\"accent-link\" target=\"_blank\">Gemma 4: Most Capable Open Models</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Google released four new vision-capable Apache 2.0 licensed reasoning LLMs (2B, 4B, 31B, plus 26B-A4B MoE). Native video, images, and audio processing.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\">Simon Willison | 2026-04-02</div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">gemma-4</span>\n                            <span class=\"tag\">open-models</span>\n                            <span class=\"tag\">vision-llms</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"type-badge type-opinion\">Opinion</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/3/\" class=\"accent-link\" target=\"_blank\">AI-Generated Security Reports: From Slop to Real Research</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Linux kernel security list went from 2-3 reports/week to 5-10/day with most being correct. Different AI tools finding same bugs.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\">Greg Kroah-Hartman, Daniel Stenberg, Willy Tarreau | 2026-04-03</div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">ai-security-research</span>\n                            <span class=\"tag\">vulnerability-research</span>\n                            <span class=\"tag\">linux-kernel</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"type-badge type-opinion\">Opinion</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/3/vulnerability-research-cooked/\" class=\"accent-link\" target=\"_blank\">Vulnerability Research Transformed by AI</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Thomas Ptacek: Within months, agents will find zero-days by pointing at source trees. LLMs uniquely suited for pattern-matching and constraint-solving.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\">Thomas Ptacek | 2026-04-03</div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">ai-security-research</span>\n                            <span class=\"tag\">vulnerability-research</span>\n                            <span class=\"tag\">coding-agents</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"type-badge type-opinion\">Opinion</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/4/github-growth/\" class=\"accent-link\" target=\"_blank\">GitHub Activity Surging: 275M Commits/Week</a>\n                    </div>\n                    <div class=\"item-description\">\n                        GitHub COO: 275M commits/week, on pace for 14B in 2026. GitHub Actions grew from 500M minutes/week (2023) to 2.1B minutes in one week.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\">Kyle Daigle (GitHub COO) | 2026-04-04</div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">github</span>\n                            <span class=\"tag\">github-actions</span>\n                            <span class=\"tag\">platform-metrics</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"type-badge type-technical\">Technical</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/5/research-llm-apis/\" class=\"accent-link\" target=\"_blank\">LLM Provider HTTP APIs Research</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Simon Willison researching new abstraction layer for LLM library. Scripts and outputs for Anthropic, OpenAI, Gemini, and Mistral raw JSON APIs.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\">Simon Willison | 2026-04-05</div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">llm</span>\n                            <span class=\"tag\">apis</span>\n                            <span class=\"tag\">claude-code</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"type-badge type-technical\">Technical</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/5/scan-for-secrets/\" class=\"accent-link\" target=\"_blank\">scan-for-secrets: Tool to Scan Files Before Sharing</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Python tool v0.1 to scan files for secrets before publishing. Built with Claude Code using README-driven-development. CLI and Python API.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\">Simon Willison | 2026-04-05</div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">security</span>\n                            <span class=\"tag\">agentic-engineering</span>\n                            <span class=\"tag\">claude-code</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"type-badge type-technical\">Technical</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/5/syntaqlite-playground/\" class=\"accent-link\" target=\"_blank\">Syntaqlite Playground: SQLite Validation in Browser</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Web-based playground for syntaqlite SQLite linting tool. UI for formatting, parsing AST, validating, tokenizing queries using WebAssembly/Pyodide.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\">Simon Willison / Lalit Maganti | 2026-04-05</div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">sqlite</span>\n                            <span class=\"tag\">sql</span>\n                            <span class=\"tag\">tools</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"type-badge type-opinion\">Opinion</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/5/eight-years-three-months/\" class=\"accent-link\" target=\"_blank\">Eight Years Wanting, Three Months Building with AI</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Lalit Maganti built syntaqlite SQLite parser in 3 months with Claude Code after procrastinating 8 years. AI excels at concrete problems but struggles with design decisions.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\">Lalit Maganti | 2026-04-05</div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">sqlite</span>\n                            <span class=\"tag\">ai</span>\n                            <span class=\"tag\">vibe-coding</span>\n                            <span class=\"tag\">architecture</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <span class=\"type-badge type-opinion\">Opinion</span>\n                        <a href=\"https://simonwillison.net/2026/Apr/5/chatgpt-healthcare/\" class=\"accent-link\" target=\"_blank\">ChatGPT Healthcare Usage Insights from OpenAI</a>\n                    </div>\n                    <div class=\"item-description\">\n                        ~2M weekly messages on health insurance, ~600K from people in 'hospital deserts' (30 min drive to nearest hospital). 7/10 messages outside clinic hours.\n                    </div>\n                    <div class=\"item-meta\">\n                        <div class=\"meta-row\">Chengpeng Mou (OpenAI) | 2026-04-05</div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">openai</span>\n                            <span class=\"tag\">chatgpt</span>\n                            <span class=\"tag\">healthcare</span>\n                            <span class=\"tag\">llms</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <