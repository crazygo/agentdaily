    \"name\": \"Ruflo\",\n    \"url\": \"https://github.com/ruvnet/ruflo\",\n    \"description\": \"Multi-agent AI orchestration platform for Claude Code that coordinates 100+ specialized agents across machines and trust boundaries. Features self-learning swarm intelligence, HNSW-indexed vector memory (AgentDB), zero-trust federation for cross-machine agent collaboration, 32 Claude Code plugins, web UI at flo.ruv.io, and GOAP goal planner at goal.ruv.io. Agents self-organize, learn from tasks, and remember across sessions.\",\n    \"release_date\": \"2026-04-25\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub Trending\"],\n    \"community_quotes\": [\n      \"1,840 stars today with 38,941 total stars\",\n      \"The leading agent orchestration platform for Claude\",\n      \"Orchestrate 100+ specialized AI agents across machines, teams, and trust boundaries\",\n      \"Features enterprise-grade architecture, self-learning swarm intelligence, RAG integration\"\n    ]\n  },\n  {\n    \"name\": \"DeepSeek TUI\",\n    \"url\": \"https://github.com/Hmbown/DeepSeek-TUI\",\n    \"description\": \"A terminal-native coding agent built around DeepSeek V4's 1M-token context and prefix cache. Features native RLM (Recursive Language Model) for parallel reasoning, thinking-mode streaming, full tool suite (file ops, shell, git, web search), three interaction modes (Plan/Agent/YOLO), session save/resume, workspace rollback, and MCP protocol support. Ships as a single binary with no Node/Python runtime required.\",\n    \"release_date\": \"2026-05-03\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub Trending\"],\n    \"community_quotes\": [\n      \"343 stars today with 2,131 total stars\",\n      \"Coding agent for DeepSeek models that runs in your terminal\",\n      \"Built for DeepSeek V4 with 1M-token context windows and native thinking-mode streaming\",\n      \"Single binary, no Node/Python runtime required\"\n    ]\n  }\n]\n"
