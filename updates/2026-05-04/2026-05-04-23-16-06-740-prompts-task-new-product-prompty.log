},\n  {\n    \"name\": \"n8n-mcp\",\n    \"url\": \"https://github.com/czlonkowski/n8n-mcp\",\n    \"description\": \"A Model Context Protocol (MCP) server that gives AI assistants comprehensive access to n8n's workflow automation platform. Provides structured access to 1,650+ n8n nodes (820 core + 830 community), node properties, operations, and documentation. Enables Claude Code, Cursor, Windsurf, and other AI IDEs to build, validate, and deploy n8n workflows with 99% property coverage and 2,352 searchable templates.\",\n    \"release_date\": \"2026-04-22\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub Trending\"],\n    \"community_quotes\": [\n      \"282 stars today with 19,511 total stars\",\n      \"A bridge between n8n's workflow automation platform and AI models\",\n      \"Supports 1,650 n8n nodes with 99% property coverage\",\n      \"Works with Claude Code, VS Code, Cursor, Windsurf, and Codex\"\n    ]\n  },\n  {\n    \"name\": \"jcode\",\n    \"url\": \"https://github.com/1jehuang/jcode\",\n    \"description\": \"A next-generation coding agent harness built for multi-session workflows with infinite customizability. Features semantic memory embeddings for project-long recall, swarm collaboration across multiple agents, browser automation via Firefox Agent Bridge, and exceptional performance (14ms to first frame, 167MB RAM). Supports OAuth providers (Claude, OpenAI, Gemini, Copilot, etc.) and self-dev mode where agents modify their own source code.\",\n    \"release_date\": \"2026-04-20\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub Trending\"],\n    \"community_quotes\": [\n      \"591 stars today with 3,418 total stars\",\n      \"Built for multi-session workflows, infinite customizability, and performance\",\n      \"6.0× more RAM efficient than alternatives in active sessions\",\n      \"Swarm mode enables native collaboration between multiple agents with conflict resolution\"\n    ]\n  }\n]\n"
