      "content": "[\n  {\n    \"title\": \"A Jagged Frontier: Evaluating Robustness of Code Agents to Semantics-Preserving Transformations\",\n    \"description\": \"Research evaluating code agent robustness when code undergoes semantics-preserving transformations (e.g., renaming variables, refactoring). Findings show that code agents exhibit a 'jagged frontier' - robust in some areas but fragile in others when facing transformed code that maintains the same functionality.\",\n    \"author\": \"Hasan Najib Mahmud, Shreya Gupta, Isha Chaudhary, Nathaniel Enis, Ravi Mangal, Gagandeep Singh, Corina Pasareanu\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2608.18389\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"code agents\", \"LLM robustness\", \"software engineering\", \"AI testing\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ComponentBench: Diagnosing Component-Level Failures in Computer-Use Agents\",\n    \"description\": \"New benchmark for diagnosing component-level failures in computer-use agents. Addresses the challenge of identifying which specific components (perception, planning, execution) fail when AI agents attempt computer tasks. Accepted at COLM 2026.\",\n    \"author\": \"Tianchen Guan, Xinlei Lin, Royce Cheng-Yue, Xiangjun Wang, Shuyan Zhou\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2608.18307\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"AI agents\", \"benchmarking\", \"computer-use agents\", \"evaluation\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Adversarial Review: Structured Disagreement for Grounded Agentic Code Review\",\n    \"description\": \"Novel approach for AI-powered code review using structured adversarial review processes. The method introduces controlled disagreement between AI reviewers to ground code review feedback and improve reliability. Accepted to ICML 2026 Workshop on DL4C.\",\n    \"author\": \"Eric S. Qiu, Joyce Gill\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2608.18167\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"code review\", \"AI agents\", \"software engineering\", \"adversarial methods\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Looped Language Models Improve Compositional Tool Calling\",\n    \"description\": \"Research demonstrating that looped language models significantly improve compositional tool calling capabilities. Shows that iterative processing enables better tool selection and composition for AI agents.\",\n    \"author\": \"Andrei Cristian Popescu, Haitz Sáez de Ocáriz Borde, Pietro Liò\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2608.18171\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"tool calling\", \"LLM architecture\", \"AI agents\", \"function calling\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"FACET: Preserving Source Intent and Executable State in Terminal Task Synthesis\",\n    \"description\": \"New method for AI terminal task synthesis that preserves both source intent and executable state. Addresses the challenge of maintaining semantic meaning when AI agents automate terminal commands and system operations.\",\n    \"author\": \"Kou Shi, Zun Wang, Qisheng Su, Shiting Huang, Ziao Zhang, Zhen Fang, Qingnan Ren, Jin Liu, Yu Zeng, Yiming Zhao, Lin Chen, Zehui Chen, Feng Zhao\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2608.18580\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"terminal automation\", \"AI agents\", \"task synthesis\", \"system operations\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Training-Free Inference-Time Self-Reflection and Cost-Bounded Early Stopping for Large Language Models\",\n    \"description\": \"Novel approach for LLM self-reflection during inference without additional training. Introduces cost-bounded early stopping mechanisms to optimize the trade-off between computation time and response quality.\",\n    \"author\": \"Wei Yu, Suxing Liu, Minjie Yu, Jiahao Wang, Zhijian Zheng, Haocheng Deng, Bing Li\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2608.18884\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"LLM optimization\", \"self-reflection\", \"inference optimization\", \"cost management\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Metrics That Write Themselves: Evolving an Evaluator from Its Own Blind Spots\",\n    \"description\": \"Novel meta-evaluation approach where metrics evolve and improve based on their own blind spots. Addresses the challenge of automated evaluation systems becoming stale or gaming the metrics they're supposed to measure.\",\n    \"author\": \"Xing Zhang, Yanwei Cui, Guanghui Wang, Zhihao Lin, Peiyang He\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2608.18744\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"AI evaluation\", \"meta-learning\", \"metric evolution\", \"automated assessment\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Eureka: Task-Conditioned Meta-Agent Orchestration for Scientific Discovery\",\n    \"description\": \"New meta-agent orchestration system for AI-driven scientific discovery. Uses task-conditioned approaches to coordinate multiple AI agents for complex research tasks, demonstrating advances in agentic AI for scientific applications.\",\n    \"author\": \"Alizer Wong, Heng Cui, Yi Tan, Xiongchao Zhan, Liang Lin, Yuxiang Guo, Zhaorong Dai, Zixin Zeng, Wenyuan Li\",\n    \"source\": \"Paper\",\n    \"url\": \"https://arxiv.org/abs/2608.19047\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"AI agents\", \"scientific discovery\", \"meta-agent orchestration\", \"multi-agent systems\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"DentAgent: Evidence-Centric Multi-Agent Coordination for Multimodal Dental Reasoning