\n        .footer-content a:hover {\n            text-decoration: underline;\n        }\n\n        /* Utility Classes */\n        .hidden {\n            display: none;\n        }\n\n        /* Print Styles */\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            .section {\n                break-inside: avoid;\n            }\n\n            header, footer {\n                background-color: #ffffff;\n            }\n        }\n\n        /* Hover Effects */\n        .item:hover {\n            background-color: #fafafa;\n        }\n\n        a {\n            transition: color 0.2s ease;\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <div class=\"container header-content\">\n            <div class=\"logo\">Agentic Coding Daily</div>\n            <div class=\"date\">2026-08-20</div>\n        </div>\n    </header>\n\n    <div class=\"container\">\n        <nav class=\"nav-bar\">\n            <a href=\"#new-products\">New Products</a>\n            <a href=\"#whitelist-updates\">Whitelist Updates</a>\n            <a href=\"#technical-insights\">Technical Insights</a>\n        </nav>\n\n        <main>\n            <!-- New Products Section (40%) -->\n            <section class=\"section\" id=\"new-products\">\n                <div class=\"section-header\">New Products</div>\n                <div class=\"section-content\">\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://blog.google/innovation-and-ai/models-and-research/gemini-models/introducing-gemini-3-7-flash/\" target=\"_blank\" rel=\"noopener\">Google Gemini 3.7 Flash</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Google's Flash model optimized specifically for coding and AI agent workflows, launched August 13, 2026. Features enhanced debugging, code generation, verification, testing, and multi-step autonomous agent capabilities with a 1M token context window at low cost.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"product-category\">AI coding model</span>\n                            <span class=\"date-tag\">2026-08-13</span>\n                        </div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">Google Blog</span>\n                            <span class=\"tag\">Google DeepMind</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://github.blog/changelog/2026-08-11-mai-code-1-1-flash-available-in-github-copilot/\" target=\"_blank\" rel=\"noopener\">Microsoft MAI-Code-1.1-Flash</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Microsoft's multimodal coding AI model launched August 11, 2026, rolling out in GitHub Copilot with native vision support for images. Features 25% better token efficiency and costs a quarter of its predecessor while writing better code.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"product-category\">AI coding model</span>\n                            <span class=\"date-tag\">2026-08-11</span>\n                        </div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">GitHub Blog</span>\n                            <span class=\"tag\">The Decoder</span>\n                            <span class=\"tag\">Neowin</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://www.liquid.ai/blog/lfm2-5-2-6b\" target=\"_blank\" rel=\"noopener\">Liquid AI LFM2.5-2.6B</a>\n                        </div>\n                        <div class=\"item-description\">\n                            Open-source on-device agentic coding model released August 4, 2026. Runs at 220 tokens/second in under 2.5 GB memory, targeting agentic workloads and local deployment on devices as small as Raspberry Pi. Features 128K token context window with open weights.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"product-category\">open-source AI model</span>\n                            <span class=\"date-tag\">2026-08-04</span>\n                        </div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">Liquid AI Blog</span>\n                            <span class=\"tag\">Hugging Face</span>\n                            <span class=\"tag\">VentureBeat</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"item-title\">\n                            <a href=\"https://sinch.com/ai/agent-tools/\" target=\"_blank\" rel=\"noopener\">Sinch Agent Tools</a>\n                        </div>\n                        <div class=\"item-description\">\n                            A suite of developer tools launched August 4, 2026 that helps developers and AI coding assistants build, test, and deploy applications with Sinch's communications APIs integrated directly into AI-assisted coding workflows.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"product-category\">workflow agent</span>\n                            <span class=\"date-tag\">2026-08-04</span>\n                        </div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">PR Newswire</span>\n                            <span class=\"tag\">Cision</span>\n                            <span class=\"tag\">Sinch Group</span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Whitelist Updates Section (35%) -->\n            <section class=\"section\" id=\"whitelist-updates\">\n                <div class=\"section-header\">Whitelist Updates</div>\n                <div class=\"section-content\">\n                    <div class=\"item\">\n                        <div class=\"product-name\">Claude Code</div>\n                        <div class=\"update-title\">Auto Mode Becomes Default for Pro, Max, and Team Plans</div>\n                        <div class=\"update-description\">\n                            Starting August 14, 2026, Claude Code made auto mode the default permission mode for new sessions on Pro, Max, and Team plans. Anthropic reports auto mode's AI safety review caught 89% of dangerous commands while humans only caught 13.6%.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"date-tag\">2026-08-06</span>\n                        </div>\n                        <div class=\"feedback-item negative\">\n                            \"Auto mode will also happily do stuff like write into your user's SSH config and leave you with permanently broken SSH.\"\n                            <span class=\"feedback-source\"> - HN</span>\n                        </div>\n                        <div class=\"feedback-item negative\">\n                            \"If you go full auto, there will be collateral damage. Users trust Claude Code because it asks before doing anything.\"\n                            <span class=\"feedback-source\"> - HN</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"product-name\">Claude Code</div>\n                        <div class=\"update-title\">Session-to-Session Messaging</div>\n                        <div class=\"update-description\">\n                            Claude Code sessions can now message each other using the ListAgents tool and SendMessage. Claude can communicate between sessions without re-explaining context when a change in one session affects what another is working on.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"date-tag\">2026-08-03</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"product-name\">Claude Code</div>\n                        <div class=\"update-title\">Self-Hosted Environments (Public Beta)</div>\n                        <div class=\"update-description\">\n                            Team and Enterprise plans can now run Claude Code cloud sessions on their organization's own infrastructure. Run `claude self-hosted-runner` on machines or containers to turn them into runners.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"date-tag\">2026-08-03</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"product-name\">Claude Code</div>\n                        <div class=\"update-title\">Weekly Limits Promotion Extended Through August 31</div>\n                        <div class=\"update-description\">\n                            Claude Code extended its 50% higher weekly limits promotion through August 31, 2026 for Pro, Max, Team, and seat-based Enterprise users. Originally set to end August 19, the extension comes as users reported frustration with rapid usage depletion.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"date-tag\">2026-08-19</span>\n                        </div>\n                        <div class=\"feedback-item negative\">\n                            \"Between the outages and just overall crap utility of Opus/Fable lately, I was considering canceling my subscription.\"\n                            <span class=\"feedback-source\"> - HN</span>\n                        </div>\n                        <div class=\"feedback-item negative\">\n                            \"OpenAI weekly limits feel infinite compared to Anthropic's.\"\n                            <span class=\"feedback-source\"> - HN</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"product-name\">Cursor</div>\n                        <div class=\"update-title\">Origin Code Hosting Platform Launch</div>\n                        <div class=\"update-description\">\n                            Cursor launched Origin, a new Git hosting platform in early beta for paid plans. Features include hosted codebases with GitHub repo syncing, pull requests with two-way sync, agent integration for code analysis.\n                        </div>\n                        <div class=\"item-meta\">\n                            <span class=\"date-tag\">2026-08-17</span>\n                        </div>\n                        <div class=\"feedback-item negative\">\n                            \"They are doing the easiest part of git hosting and don't even support GitHub Actions yet.\"\n                            <span class=\"feedback-source\"> - HN</span>\n                        </div>\n                    </div>\n\n                    <div class=\"item\">\n                        <div class=\"product-name\">Cursor</div>\n                        <div class=\"update-title\">Cloud Agents with Subscriptions and Custom Modes</div>\n                        <div class=\"update-description\">\n       