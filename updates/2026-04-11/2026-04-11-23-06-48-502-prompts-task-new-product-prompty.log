  "old_string": "[\n  {\n    \"name\": \"Claude Code Voice Mode\",\n    \"url\": \"https://www.producthunt.com/products/claude-code-voice-mode\",\n    \"description\": \"Voice mode for Claude Code that allows developers to speak their prompts instead of typing them. Reached #1 Product of the Day on April 2, 2026.\",\n    \"release_date\": \"2026-04-02\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"#1 Product on Product Hunt on April 2, 2026\", \"Allows users to speak their prompts into Claude Code\"]\n  },\n  {\n    \"name\": \"ZooClaw\",\n    \"url\": \"https://www.producthunt.com/products/zooclaw\",\n    \"description\": \"A proactive team of AI specialists in one place. Acts as a single entry point to multiple AI agents with structured domain expertise, automatically routing tasks to the right agent with natural language input.\",\n    \"release_date\": \"2026-04-03\",\n    \"category\": \"code agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"Your proactive team of AI specialists in one place\", \"Zero token anxiety\"]\n  },\n  {\n    \"name\": \"Cursor 3\",\n    \"url\": \"https://www.producthunt.com/products/cursor-3\",\n    \"description\": \"Unified workspace for parallel local/cloud agents and MCPs (Model Context Protocol). A major update to the Cursor AI IDE enhancing it with multi-agent capabilities and parallel execution.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"Unified workspace for parallel local/cloud agents and MCPs\"]\n  },\n  {\n    \"name\": \"Viktor\",\n    \"url\": \"https://getviktor.com\",\n    \"description\": \"An AI coworker that lives in Slack and automates workflows by observing team behavior. Proactively suggests automations and has context from tools and conversations, running autonomously without manual setup.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"An AI coworker that actually does the work\", \"Viktor doesn't just wait for you to ask. It observes how your team works and chimes in\"]\n  },\n  {\n    \"name\": \"traceAI\",\n    \"url\": \"https://github.com/future-agi/traceAI\",\n    \"description\": \"Open-source LLM tracing framework designed specifically for GenAI applications. Captures every LLM call, prompt, token count, retrieval step, and agent decision as structured traces.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\", \"GitHub\"],\n    \"community_quotes\": [\"Open-source LLM tracing that speaks GenAI, not HTTP\"]\n  },\n  {\n    \"name\": \"Baton\",\n    \"url\": \"https://www.producthunt.com/products/baton-2\",\n    \"description\": \"A desktop app for developing with AI coding agents. Run multiple agents in parallel, each in their own git-isolated workspace. Provides PR-ready code review capabilities with parallel agent execution.\",\n    \"release_date\": \"2026-03-30\",\n    \"category\": \"code agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"Run multiple agents in parallel\", \"Each agent operates in its own isolated git workspace\"]\n  }\n]",
  "new_string": "[\n  {\n    \"name\": \"dbg\",\n    \"url\": \"https://github.com/redknightlois/dbg\",\n    \"description\": \"A universal CLI debugger interface that gives AI agents direct visibility into runtime state across multiple debugging protocols. Enables agents to inspect variables, set breakpoints, and analyze execution flow instead of guessing from source code.\",\n    \"release_date\": \"2026-04-11\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\"Give your AI agent eyes into runtime state instead of guessing from source code\", \"One CLI. Every debugger\"]\n  },\n  {\n    \"name\": \"SenWeaverCoding\",\n    \"url\": \"https://github.com/senweaver/SenWeaverCoding\",\n    \"description\": \"A Rust-first autonomous AI agent runtime and CLI code editor built on SenAgentOS. Applies Harness Engineering to code engineering with autonomous exploration, refactoring, testing, and debugging capabilities.\",\n    \"release_date\": \"2026-04-07\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\"Performance, stability, security – fully harnessed\", \"Orchestrate LLM agents for autonomous exploration, refactoring, testing, and debugging\"]\n  },\n  {\n    \"name\": \"ZooClaw\",\n    \"url\": \"https://www.producthunt.com/products/zooclaw\",\n    \"description\": \"A proactive team of AI specialists in one place. Acts as a single entry point to multiple AI agents with structured domain expertise, automatically routing tasks to the right agent with natural language input.\",\n    \"release_date\": \"2026-04-03\",\n    \"category\": \"code agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"Your proactive team of AI specialists in one place\", \"Zero token anxiety\"]\n  },\n  {\n    \"name\": \"RunawayContext\",\n    \"url\": \"https://github.com/sms021/RunawayContext\",\n    \"description\": \"A universal framework for giving AI coding assistants persistent memory and project intelligence across sessions. Provides workspace-scoped memory that survives chat sessions and enables context-aware decision making.\",\n    \"release_date\": \"2026-04-04\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\"Universal framework for giving AI coding assistants persistent memory and project intelligence across sessions\"]\n  },\n  {\n    \"name\": \"Claude Code Voice Mode\",\n    \"url\": \"https://www.producthunt.com/products/claude-code-voice-mode\",\n    \"description\": \"Voice mode for Claude Code that allows developers to speak their prompts instead of typing them. Reached #1 Product of the Day on April 2, 2026.\",\n    \"release_date\": \"2026-04-02\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"#1 Product on Product Hunt on April 2, 2026\", \"Allows users to speak their prompts into Claude Code\"]\n  },\n  {\n    \"name\": \"cheetahclaws\",\n    \"url\": \"https://github.com/SafeRL-Lab/cheetahclaws\",\n    \"description\": \"CheetahClaws (Nano Claude Code) is a fast, easy-to-use, Python-native personal AI assistant for any model. Inspired by OpenClaw and Claude Code, it's built to work autonomously 24/7 with minimal resource requirements.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\"Nano Claude Code: A Fast, Easy-to-Use, Python-Native Personal AI Assistant\", \"Built to Work for You Autonomously 24/7\"]\n  },\n  {\n    \"name\": \"CoreCoder\",\n    \"url\": \"https://github.com/he-yufeng/CoreCoder\",\n    \"description\": \"Minimal AI coding agent (~950 LoC Python) inspired by Claude Code. Works with any LLM and provides a clean, readable implementation of the core coding agent architecture. Think NanoGPT for coding agents.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"open-source AI coding agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\"Think NanoGPT for coding agent\", \"Minimal AI coding agent (~950 LoC Python) inspired by Claude Code\"]\n  },\n  {\n    \"name\": \"nanocode\",\n    \"url\": \"https://github.com/nanocode-project/nanocode\",\n    \"description\": \"A lightweight AI coding assistant built in Python (~1.9k lines). Provides a minimal but functional implementation of an AI coding assistant with tool use and agentic workflows.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"open-source AI coding agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\"Lightweight AI coding assistant built in Python\"]\n  },\n  {\n    \"name\": \"Cursor 3\",\n    \"url\": \"https://www.producthunt.com/products/cursor-3\",\n    \"description\": \"Unified workspace for parallel local/cloud agents and MCPs (Model Context Protocol). A major update to the Cursor AI IDE enhancing it with multi-agent capabilities and parallel execution.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"Unified workspace for parallel local/cloud agents and MCPs\"]\n  },\n  {\n    \"name\": \"Viktor\",\n    \"url\": \"https://getviktor.com\",\n    \"description\": \"An AI coworker that lives in Slack and automates workflows by observing team behavior. Proactively suggests automations and has context from tools and conversations, running autonomously without manual setup.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"An AI coworker that actually does the work\", \"Viktor doesn't just wait for you to ask. It observes how your team works and chimes in\"]\n  },\n  {\n    \"name\": \"traceAI\",\n    \"url\": \"https://github.com/future-agi/traceAI\",\n    \"description\": \"Open-source LLM tracing framework designed specifically for GenAI applications. Captures every LLM call, prompt, token count, retrieval step, and agent decision as structured traces.\",\n    \"release_date\": \"2026-04-01\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\", \"GitHub\"],\n    \"community_quotes\": [\"Open-source LLM tracing that speaks GenAI, not HTTP\"]\n  },\n  {\n    \"name\": \"CCX-RS\",\n    \"url\": \"https://github.com/anton-abyzov/ccx-rs\",\n    \"description\": \"Community Claude Code eXtended — a free, open-source AI coding assistant implemented in Rust. Features 19 tools, multi-model support (Claude/OpenRouter/Ollama), and a Claude Code-style TUI interface.\",\n    \"release_date\": \"2026-03-31\",\n    \"category\": \"open-source AI coding agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\"Community Claude Code eXtended — free, open-source AI coding assistant in Rust\", \"19 tools, multi-model (Claude/OpenRouter/Ollama), Claude Code-style TUI\"]\n  },\n  {\n    \"name\": \"Baton\",\n    \"url\": \"https://www.producthunt.com/products/baton-2\",\n    \"description\": \"A desktop app for developing with AI coding agents. Run multiple agents in parallel, each in their own git-isolated workspace. Provides PR-ready code review capabilities with parallel agent execution.\",\n    \"release_date\": \"2026-03-30\",\n    \"category\": \"code agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"Run multiple agents in parallel\", \"Each agent operates in its own isolated git workspace\"]\n  },\n  {\n    \"name\": \"ToFu\",\n    \"url\": \"https://github.com/NiuTrans/ToFu\",\n    \"description\": \"Self-hosted AI assistant with tool use, multi-agent orchestration, coding copilot and a lightweight Flask + vanilla JS stack. Provides a complete self-hosted solution for teams wanting to control their AI infrastructure.\",\n    \"release_date\": \"2026-03-30\",\n    \"category\": \"open-source AI coding agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": [\"Self-hosted AI assistant with tool use, multi-agent orchestration, coding copilot\"]\n  }\n]"
