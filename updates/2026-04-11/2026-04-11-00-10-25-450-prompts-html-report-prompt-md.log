      "content": "[\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.101 - Team Onboarding & Performance Improvements\",\n    \"description\": \"Added /team-onboarding command for generating teammate ramp-up guides, OS CA certificate trust by default, interactive Google Vertex AI setup wizard, and numerous performance improvements including faster diff computation and reduced memory usage.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/changelog\",\n    \"date\": \"2026-04-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.98 - Enhanced Security & Permissions\",\n    \"description\": \"Fixed command injection vulnerability in POSIX which fallback, added Monitor tool for streaming events, subprocess sandboxing with PID namespace isolation, and improved permission checks.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/changelog\",\n    \"date\": \"2026-04-09\",\n    \"community_feedback\": [\n      {\n        \"source\": \"HackerNews\",\n        \"quote\": \"Claude Code limits are starting to feel like a psychological trick\",\n        \"sentiment\": \"negative\",\n        \"url\": \"https://news.ycombinator.com/item?id=47668813\"\n      },\n      {\n        \"source\": \"HackerNews\",\n        \"quote\": \"Claude Code Found a Linux Vulnerability Hidden for 23 Years\",\n        \"sentiment\": \"positive\",\n        \"url\": \"https://news.ycombinator.com/item?id=47633855\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Version 0.37.1 - Latest Stable Release\",\n    \"description\": \"Dynamic sandbox expansion and worktree support for Linux and Windows, broad nightly update featuring UI polish, core fixes, and new tools.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-04-09\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Main Branch - Claude 4.5/4.6 and GPT-5.3/5.4 Support\",\n    \"description\": \"Added support for Claude 4.5/4.6 models and updated model aliases, expanded Gemini model support with 2.5 Flash and Flash-Lite, added Gemini 3 preview models, added DeepSeek Reasoner model, and added support for GPT-5.3/5.4 model variants across OpenAI, Azure, and OpenRouter.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://aider.chat/HISTORY.html\",\n    \"date\": \"2026-04-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Bugbot Learned Rules and MCP Support\",\n    \"description\": \"Bugbot can now learn from feedback on pull requests and turn those signals into learned rules, added MCP support for additional context during code reviews, and introduced new Cursor 3 interface with Agents Window.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-08\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Version 0.37.0 - Dynamic Sandbox Expansion\",\n    \"description\": \"Implemented dynamic sandbox expansion and worktree support for Linux and Windows, added chat resume footer on session, and broad nightly update with UI polish.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-04-08\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot CLI BYOK and Local Models Support\",\n    \"description\": \"Copilot CLI now supports Bring Your Own Key (BYOK) and local model configurations for enhanced flexibility.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-04-07\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Model Availability Update (April 7, 2026)\",\n    \"description\": \"Updating model availability for ChatGPT sign-in users - removing gpt-5.2-codex, gpt-5.1-codex-mini, gpt-5.1-codex-max, gpt-5.1-codex, gpt-5.1, and gpt-5 from model picker.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-04-07\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot SDK in Public Preview\",\n    \"description\": \"Copilot SDK now available in public preview, enabling developers to build custom integrations and extensions.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-04-02\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor 3.0 Launch - New Interface\",\n    \"description\": \"Major interface overhaul with multi-repo layout, seamless agent handoff, agent switching options, faster and cleaner performance. Includes Design Mode for browser UI element annotation.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.com/blog/cursor-3\",\n    \"date\": \"2026-04-02\",\n    \"community_feedback\": [\n      {\n        \"source\": \"HackerNews\",\n        \"quote\": \"With this launch of Cursor 3, I'll probably get off Cursor for good...\",\n        \"sentiment\": \"negative\",\n        \"url\": \"https://news.ycombinator.com/item?id=47618084\"\n      },\n      {\n        \"source\": \"HackerNews\",\n        \"quote\": \"The main reason we pay for cursor is for bugbot, that alone pays for...\",\n        \"sentiment\": \"positive\",\n        \"url\": \"https://news.ycombinator.com/item?id=47618084\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Cloud Agent Research, Plan, and Code\",\n    \"description\": \"Research, plan, and code with Copilot cloud agent - new agentic capabilities for comprehensive development workflows.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-04-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Version 0.118.0 - Enhanced Networking & Device Code Login\",\n    \"description\": \"Added Windows sandbox OS-level networking enforcement, ChatGPT device code login flow, support for prompt-plus-stdin workflow in codex exec, and dynamic bearer token fetching for custom model providers.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-03-31\",\n    \"community_feedback\": []\n  }\n]\n",
