    "content": "[\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.142 Release\",\n    \"description\": \"Added new `claude agents` flags for configuring dispatched background sessions, fast mode now uses Opus 4.7 by default, plugins with root-level SKILL.md surfaced as skills, multiple bug fixes for MCP tool timeout, background sessions, daemon lifecycle, and various UI improvements.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/changelog\",\n    \"date\": \"2026-05-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.141 Release\",\n    \"description\": \"Added terminalSequence field to hook JSON output, CLAUDE_CODE_PLUGIN_PREFER_HTTPS env var, ANTHROPIC_WORKSPACE_ID for workload identity federation, claude agents --cwd flag, /feedback can now include recent sessions. Improved spinner feedback during long thinking periods. Fixed numerous bugs related to background side-queries, daemon status, agent type list, and permission modes.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/changelog\",\n    \"date\": \"2026-05-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.140 Release\",\n    \"description\": \"Improved Agent tool subagent_type matching to accept case- and separator-insensitive values, updated agent color palette. Fixed /goal hanging, settings hot-reload regression, claude --bg connection issues, remote managed settings retry logic, and Read tool validation with offset parameter.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/changelog\",\n    \"date\": \"2026-05-12\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Agent View and /goal Command (v2.1.139)\",\n    \"description\": \"Added agent view (Research Preview) as a single list of every Claude Code session, /goal command to set completion conditions, /scroll-speed command, claude plugin details command, transcript view navigation improvements, hook args field for exec form spawning, MCP stdio servers now receive CLAUDE_PROJECT_DIR. Fixed numerous bugs including deadlock with expired credentials, autoAllowBashIfSandboxed issues, and memory growth problems.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/changelog\",\n    \"date\": \"2026-05-11\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Background Agents in Slack\",\n    \"description\": \"You can now launch Background Agents directly from Slack by mentioning @Cursor. Agents can read the thread, understand context, and create PRs in GitHub without leaving the conversation. Includes search in settings, MCP progress notifications, dynamic tool registration, and roots support.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-05-09\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor 1.0 - BugBot, Background Agent GA, and MCP One-Click Install\",\n    \"description\": \"Cursor 1.0 release featuring BugBot for automatic code review, Background Agent general availability for all users, Agent support for Jupyter Notebooks (Sonnet models), Memories beta for conversation context, MCP one-click install with OAuth support, richer chat responses with Mermaid diagrams and Markdown tables, new Dashboard with usage analytics.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-05-08\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Simplified Pricing and Max Mode for All Models\",\n    \"description\": \"Unified request-based pricing model, Max Mode now available for all state-of-the-art models with token-based pricing, new Tab model for multi-file suggestions, Background Agent preview with remote parallel execution, @folders support for entire codebase context, refreshed Inline Edit with full file edits and send-to-agent options, multi-root workspace support.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Rules Generation and Improved Agent Terminal\",\n    \"description\": \"Generate rules directly from conversations with /Generate Cursor Rules command, auto-attached rules with path patterns, chat history moved to command palette, built-in diff view for reviewing agent code, images support in MCP servers, improved agent terminal control with editable commands, global ignore files, new models (Gemini 2.5 Pro/Flash, Grok 3/Mini, GPT-4.1, o3/o4-mini), project structure in context beta.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-05-04\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Team-level Copilot Usage Metrics via API\",\n    \"description\": \"Team-level Copilot usage metrics now available via API, allowing enterprises to track and manage Copilot adoption across teams.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-05-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot App Technical Preview\",\n    \"description\": \"GitHub Copilot app is now available in technical preview, providing a new way to interact with Copilot features.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-05-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Cloud Agent Auto Model Selection\",\n    \"description\": \"Copilot cloud agent now supports automatic model selection, optimizing the choice of model for each task.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-05-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot CLI Agent and Unified Sessions in JetBrains\",\n    \"description\": \"Introducing Copilot CLI agent and unified sessions view in GitHub Copilot for JetBrains IDEs, improving workflow integration.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-05-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Start Copilot Cloud Agent Tasks via REST API\",\n    \"description\": \"Can now start Copilot cloud agent tasks via the REST API, enabling programmatic control and automation.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-05-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Memory Supports User Preferences\",\n    \"description\": \"Copilot Memory now supports user preferences for Pro and Pro+ users, allowing personalized AI assistance.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-05-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Code Review Comment Experience Improvements\",\n    \"description\": \"Improved Copilot code review comment experience with better UI and interaction patterns.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-05-12\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"More Flexible Secrets and Variables for Copilot Cloud Agent\",\n    \"description\": \"More flexible secrets and variables management for Copilot cloud agent, enhancing security and configuration options.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-05-08\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Rubber Duck in Copilot CLI Supports More Models\",\n    \"description\": \"Rubber Duck feature in GitHub Copilot CLI now supports more models, expanding debugging and explanation capabilities.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-05-07\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Enterprise-Managed Plugins in Copilot CLI Public Preview\",\n    \"description\": \"Enterprise-managed plugins in GitHub Copilot CLI are now in public preview, allowing organizations to manage CLI plugins at scale.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Devin Review & Quick Review (v2.2.17)\",\n    \"description\": \"All Windsurf IDE users now have access to Devin Review and Quick Review with existing subscription. Devin Review available for self-serve users with 2 week free trial. Agent Command Center improvements with list display, improved sorting and filtering. Fixed Windows update bugs, MCP server issues, and improved Devin Local agent reliability.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Version 0.86.0 - GPT-5 and Gemini 2.5 Flash Lite Support\",\n    \"description\": \"Added support for all GPT-5 models, Grok-4, Gemini 2.5 Flash Lite Preview, and OpenRouter Kimi K2 model. Improved /clear and /undo commands, model announcements display, and settings handling. Aider wrote 88% of the code in this release.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/aider-ai/aider/releases\",\n    \"date\": \"2026-05-02\",\n    \"community_feedback\": []\n  }\n]\n",
