 24→    \"updateType\": \"release\",\n    25→    \"url\": \"https://code.claude.com/docs/en/changelog\",\n    26→    \"date\": \"2026-05-12\",\n    27→    \"community_feedback\": []\n    28→  },\n    29→  {\n    30→    \"productName\": \"Claude Code\",\n    31→    \"title\": \"Agent View and /goal Command (v2.1.139)\",\n    32→    \"description\": \"Added agent view (Research Preview) as a single list of every Claude Code session, /goal command to set completion conditions, /scroll-speed command, claude plugin details command, transcript view navigation improvements, hook args field for exec form spawning, MCP stdio servers now receive CLAUDE_PROJECT_DIR. Fixed numerous bugs including deadlock with expired credentials, autoAllowBashIfSandboxed issues, and memory growth problems.\",\n    33→    \"updateType\": \"feature\",\n    34→    \"url\": \"https://code.claude.com/docs/en/changelog\",\n    35→    \"date\": \"2026-05-11\",\n    36→    \"community_feedback\": []\n    37→  },\n    38→  {\n    39→    \"productName\": \"Cursor\",\n    40→    \"title\": \"Background Agents in Slack\",\n    41→    \"description\": \"You can now launch Background Agents directly from Slack by mentioning @Cursor. Agents can read the thread, understand context, and create PRs in GitHub without leaving the conversation. Includes search in settings, MCP progress notifications, dynamic tool registration, and roots support.\",\n    42→    \"updateType\": \"feature\",\n    43→    \"url\": \"https://cursor.sh/changelog\",\n    44→    \"date\": \"2026-05-09\",\n    45→    \"community_feedback\": []\n    46→  },\n    47→  {\n    48→    \"productName\": \"Cursor\",\n    49→    \"title\": \"Cursor 1.0 - BugBot, Background Agent GA, and MCP One-Click Install\",\n    50→    \"description\": \"Cursor 1.0 release featuring BugBot for automatic code review, Background Agent general availability for all users, Agent support for Jupyter Notebooks (Sonnet models), Memories beta for conversation context, MCP one-click install with OAuth support, richer chat responses with Mermaid diagrams and Markdown tables, new Dashboard with usage analytics.\",\n    51→    \"updateType\": \"release\",\n    52→    \"url\": \"https://cursor.sh/changelog\",\n    53→    \"date\": \"2026-05-08\",\n    54→    \"community_feedback\": []\n    55→  },\n    56→  {\n    57→    \"productName\": \"Cursor\",\n    58→    \"title\": \"Simplified Pricing and Max Mode for All Models\",\n    59→    \"description\": \"Unified request-based pricing model, Max Mode now available for all state-of-the-art models with token-based pricing, new Tab model for multi-file suggestions, Background Agent preview with remote parallel execution, @folders support for entire codebase context, refreshed Inline Edit with full file edits and send-to-agent options, multi-root workspace support.\",\n    60→    \"updateType\": \"feature\",\n    61→    \"url\": \"https://cursor.sh/changelog\",\n    62→    \"date\": \"2026-05-06\",\n    63→    \"community_feedback\": []\n    64→  },\n    65→  {\n    66→    \"productName\": \"Cursor\",\n    67→    \"title\": \"Rules Generation and Improved Agent Terminal\",\n    68→    \"description\": \"Generate rules directly from conversations with /Generate Cursor Rules command, auto-attached rules with path patterns, chat history moved to command palette, built-in diff view for reviewing agent code, images support in MCP servers, improved agent terminal control with editable commands, global ignore files, new models (Gemini 2.5 Pro/Flash, Grok 3/Mini, GPT-4.1, o3/o4-mini), project structure in context beta.\",\n    69→    \"updateType\": \"feature\",\n    70→    \"url\": \"https://cursor.sh/changelog\",\n    71→    \"date\": \"2026-05-04\",\n    72→    \"community_feedback\": []\n    73→  },\n    74→  {\n    75→    \"productName\": \"GitHub Copilot\",\n    76→    \"title\": \"Team-level Copilot Usage Metrics via API\",\n    77→    \"description\": \"Team-level Copilot usage metrics now available via API, allowing enterprises to track and manage Copilot adoption across teams.\",\n    78→    \"updateType\": \"release\",\n    79→    \"url\": \"https://github.blog/changelog\",\n    80→    \"date\": \"2026-05-14\",\n    81→    \"community_feedback\": []\n    82→  },\n    83→  {\n    84→    \"productName\": \"GitHub Copilot\",\n    85→    \"title\": \"GitHub Copilot App Technical Preview\",\n    86→    \"description\": \"GitHub Copilot app is now available in technical preview, providing a new way to interact with Copilot features.\",\n    87→    \"updateType\": \"release\",\n    88→    \"url\": \"https://github.blog/changelog\",\n    89→    \"date\": \"2026-05-14\",\n    90→    \"community_feedback\": []\n    91→  },\n    92→  {\n    93→    \"productName\": \"GitHub Copilot\",\n    94→    \"title\": \"Copilot Cloud Agent Auto Model Selection\",\n    95→    \"description\": \"Copilot cloud agent now supports automatic model selection, optimizing the choice of model for each task.\",\n    96→    \"updateType\": \"feature\",\n    97→    \"url\": \"https://github.blog/changelog\",\n    98→    \"date\": \"2026-05-14\",\n    99→    \"community_feedback\": []\n   100→  },\n   101→  {\n   102→    \"productName\": \"GitHub Copilot\",\n   103→    \"title\": \"Copilot CLI Agent and Unified Sessions in JetBrains\",\n   104→    \"description\": \"Introducing Copilot CLI agent and unified sessions view in GitHub Copilot for JetBrains IDEs, improving workflow integration.\",\n   105→    \"updateType\": \"feature\",\n   106→    \"url\": \"https://github.blog/changelog\",\n   107→    \"date\": \"2026-05-13\",\n   108→    \"community_feedback\": []\n   109→  },\n   110→  {\n   111→    \"productName\": \"GitHub Copilot\",\n   112→    \"title\": \"Start Copilot Cloud Agent Tasks via REST API\",\n   113→    \"description\": \"Can now start Copilot cloud agent tasks via the REST API, enabling programmatic control and automation.\",\n   114→    \"updateType\": \"release\",\n  