]\n   154→  },\n   155→  {\n   156→    \"productName\": \"GitHub Copilot\",\n   157→    \"title\": \"Enterprise-Managed Plugins in Copilot CLI Public Preview\",\n   158→    \"description\": \"Enterprise-managed plugins in GitHub Copilot CLI are now in public preview, allowing organizations to manage CLI plugins at scale.\",\n   159→    \"updateType\": \"release\",\n   160→    \"url\": \"https://github.blog/changelog\",\n   161→    \"date\": \"2026-05-06\",\n   162→    \"community_feedback\": []\n   163→  },\n   164→  {\n   165→    \"productName\": \"Windsurf\",\n   166→    \"title\": \"Devin Review & Quick Review (v2.2.17)\",\n   167→    \"description\": \"All Windsurf IDE users now have access to Devin Review and Quick Review with existing subscription. Devin Review available for self-serve users with 2 week free trial. Agent Command Center improvements with list display, improved sorting and filtering. Fixed Windows update bugs, MCP server issues, and improved Devin Local agent reliability.\",\n   168→    \"updateType\": \"feature\",\n   169→    \"url\": \"https://windsurf.com/changelog\",\n   170→    \"date\": \"2026-05-06\",\n   171→    \"community_feedback\": []\n   172→  },\n   173→  {\n   174→    \"productName\": \"Aider\",\n   175→    \"title\": \"Version 0.86.0 - GPT-5 and Gemini 2.5 Flash Lite Support\",\n   176→    \"description\": \"Added support for all GPT-5 models, Grok-4, Gemini 2.5 Flash Lite Preview, and OpenRouter Kimi K2 model. Improved /clear and /undo commands, model announcements display, and settings handling. Aider wrote 88% of the code in this release.\",\n   177→    \"updateType\": \"release\",\n   178→    \"url\": \"https://github.com/aider-ai/aider/releases\",\n   179→    \"date\": \"2026-05-02\",\n   180→    \"community_feedback\": []\n   181→  },\n   182→  {\n   183→    \"productName\": \"Devin\",\n   184→    \"title\": \"March 2026 Release - No May Updates Found\",\n   185→    \"description\": \"Based on official release notes from De