\"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Axern\",\n    \"url\": \"https://github.com/cofy-x/axern\",\n    \"description\": \"Open-source sandbox platform for AI agents and untrusted code execution. Uses runsc (gVisor) for secure isolation of agent-generated code while running trusted services with runc. Includes CLI and SDKs in Go, Python, TypeScript.\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Debroid\",\n    \"url\": \"https://github.com/PatilShreyas/debroid\",\n    \"description\": \"Autonomous headless Android debugger designed for AI coding agents. Communicates via JDWP with deterministic JSON output for machine parsing. Enables agents to debug live Android apps without GUI, supporting breakpoints, watchpoints, variable inspection, and expression evaluation.\",\n    \"release_date\": \"2026-08-02\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Phi\",\n    \"url\": \"https://github.com/pulseaiclub/phi\",\n    \"description\": \"A minimal terminal coding agent harness in Go with model loop, tools, and TUI with Markdown rendering. Supports sub-agents for parallel tasks, hashline edits, permission gates, and skills system. Works with OpenAI-compatible or Anthropic models.\",\n    \"release_date\": \"2026-08-03\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Diri\",\n    \"url\": \"https://github.com/cristicretu/diri\",\n    \"description\": \"Native macOS orchestrator for coding agents that runs Claude Code, Codex, Cursor, Gemini and shells in parallel across git worktrees and remote hosts. Provides live status tracking, persistent sessions via background daemon, and MCP server integration.\",\n    \"release_date\": \"2026-08-04\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Agent Vision Toolkit\",\n    \"url\": \"https://github.com/Anionex/agent-vision-toolkit\",\n    \"description\": \"Vision toolkit enabling text-only LLMs to see and understand images with multi-image understanding and GUI automation. Includes CLI tools for image Q&A, OCR, UI restoration, and seamless integration for Codex, Claude Code, Pi, and OpenCode.\",\n    \"release_date\": \"2026-08-01\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"SkillForge\",\n    \"url\": \"https://github.com/HaddenHunter/SkillForge\",\n    \"description\": \"Local-first skill runtime for AI Coding Agents that defines skills as verifiable, composable, MCP-exposable independent units. Includes Rust CLI with run/serve/validate commands, whitelist-based sandboxing, and TypeScript Registry CLI for search/publish/install.\",\n    \"release_date\": \"2026-08-04\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Wife\",\n    \"url\": \"https://github.com/ma-nucho-pro/wife\",\n    \"description\": \"Local, persistent, and auditable memory layer for Claude Code, Codex, Cursor, and Gemini CLI. Remembers everything across sessions with hard token ceilings, content-addressed storage, guard enforcement, and cross-repo intelligence that promotes facts appearing in three repos.\",\n    \"release_date\": \"2026-07-30\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"AgentDoctor\",\n    \"url\": \"https://github.com/pranee54/AgentDoctor\",\n    \"description\": \"Local CLI that audits coding-agent configuration for security, instructions, context, and MCP. Scans repositories to detect sensitive environment files, private keys, broad filesystem scopes, stale path references, and oversized context files without API keys or code uploads.\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"LiteCoder\",\n    \"url\": \"https://github.com/ikooky/LiteCoder\",\n    \"description\": \"Practical cross-platform coding agent for terminal workflows with streaming terminal interface, built-in development tools, persistent sessions, context management, token budget tracking, Markdown-based workspace memory, multi-agent collaboration, and MCP server integrations.\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  }\n]\n",
