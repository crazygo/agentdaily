  "content": "[\n  {\n    \"name\": \"Faaah\",\n    \"url\": \"https://github.com/sebastiancarlos/faaah\",\n    \"description\": \"An OpenAI-compatible LLM proxy server that lets you reuse AI Agent subscriptions through a text-file protocol. Dumps requests to .txt files that AI coding agents read and respond to, then packages responses back into OpenAI-compatible JSON. Featured on Hacker News.\",\n    \"release_date\": \"2026-08-07\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Hacker News\", \"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"LongHorizon-Harness\",\n    \"url\": \"https://github.com/AMAP-ML/LongHorizon-Harness\",\n    \"description\": \"A long-horizon computer-use harness that runs AI agents across desktop apps and CLI for extended periods while preserving task state. Uses manager/executor/auditor roles to maintain verified progress across context refreshes and failures. Reached #1 on Hugging Face Daily Papers weekly ranking.\",\n    \"release_date\": \"2026-08-06\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\", \"Hugging Face\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Shuohao Skills\",\n    \"url\": \"https://github.com/eternityspring/shuohao-skills\",\n    \"description\": \"Skills for AI coding agents compatible with Claude Code and codex. Primary skill transforms novels into character bibles, generating profiles, design prompts, voice prompts, and turnaround sheets with 270 GitHub stars.\",\n    \"release_date\": \"2026-08-06\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Diri\",\n    \"url\": \"https://github.com/cristicretu/diri\",\n    \"description\": \"Native macOS orchestrator for coding agents that runs Claude Code, Codex, Cursor, Gemini and shells in parallel across git worktrees and remote hosts. Provides live status tracking, persistent sessions via background daemon, and MCP server integration with 226 GitHub stars.\",\n    \"release_date\": \"2026-08-04\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"SkillForge\",\n    \"url\": \"https://github.com/HaddenHunter/SkillForge\",\n    \"description\": \"Local-first skill runtime for AI Coding Agents that defines skills as verifiable, composable, MCP-exposable independent units. Includes Rust CLI with run/serve/validate commands, whitelist-based sandboxing, and TypeScript Registry CLI for search/publish/install with 106 GitHub stars.\",\n    \"release_date\": \"2026-08-04\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Phi\",\n    \"url\": \"https://github.com/pulseaiclub/phi\",\n    \"description\": \"A minimal terminal coding agent harness in Go with model loop, tools, and TUI with Markdown rendering. Supports sub-agents for parallel tasks, hashline edits, permission gates, and skills system. Works with OpenAI-compatible or Anthropic models.\",\n    \"release_date\": \"2026-08-03\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Debroid\",\n    \"url\": \"https://github.com/PatilShreyas/debroid\",\n    \"description\": \"Autonomous headless Android debugger designed for AI coding agents. Communicates via JDWP with deterministic JSON output for machine parsing. Enables agents to debug live Android apps without GUI, supporting breakpoints, watchpoints, variable inspection, and expression evaluation with 98 GitHub stars.\",\n    \"release_date\": \"2026-08-02\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Agent Vision Toolkit\",\n    \"url\": \"https://github.com/Anionex/agent-vision-toolkit\",\n    \"description\": \"Vision toolkit enabling text-only LLMs to see and understand images with multi-image understanding and GUI automation. Includes CLI tools for image Q&A, OCR, UI restoration, and seamless integration for Codex, Claude Code, Pi, and OpenCode with 361 GitHub stars.\",\n    \"release_date\": \"2026-08-01\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Wife\",\n    \"url\": \"https://github.com/ma-nucho-pro/wife\",\n    \"description\": \"Local, persistent, and auditable memory layer for Claude Code, Codex, Cursor, and Gemini CLI. Remembers everything across sessions with hard token ceilings, content-addressed storage, guard enforcement, and cross-repo intelligence that promotes facts appearing in three repos.\",\n    \"release_date\": \"2026-07-30\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Ponytail Improved\",\n    \"url\": \"https://github.com/0xwilliamortiz/ponytail-improved\",\n    \"description\": \"An agent skill that prevents AI assistants from over-engineering code by following a simplification ladder: check if feature needed, reuse existing code, use standard library, or write minimal solution. Reports 54% less code, 20% cheaper, 27% faster with 599 GitHub stars.\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\", \"npm\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Axern\",\n    \"url\": \"https://github.com/cofy-x/axern\",\n    \"description\": \"Open-source sandbox platform for AI agents and untrusted code execution. Uses runsc (gVisor) for secure isolation of agent-generated code while running trusted services with runc. Includes CLI and SDKs in Go, Python, TypeScript with 159 GitHub stars.\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"code agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"AgentDoctor\",\n    \"url\": \"https://github.com/pranee54/AgentDoctor\",\n    \"description\": \"Local CLI that audits coding-agent configuration for security, instructions, context, and MCP. Scans repositories to detect sensitive environment files, private keys, broad filesystem scopes, stale path references, and oversized context files without API keys or code uploads.\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"LiteCoder\",\n    \"url\": \"https://github.com/ikooky/LiteCoder\",\n    \"description\": \"Practical cross-platform coding agent for terminal workflows with streaming terminal interface, built-in development tools, persistent sessions, context management, token budget tracking, Markdown-based workspace memory, multi-agent collaboration, and MCP server integrations.\",\n    \"release_date\": \"2026-07-28\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"GitHub\"],\n    \"community_quotes\": []\n  }\n]\n"
}

