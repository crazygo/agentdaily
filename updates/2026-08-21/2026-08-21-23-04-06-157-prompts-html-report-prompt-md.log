      "content": "[\n  {\n    \"title\": \"Stop Making TUIs - Native UIs for AI Coding Era\",\n    \"description\": \"Thomas Ptacek advocates for building real native user interfaces for even the smallest of personal tools, because coding agents have reduced the cost of getting a usable-enough GUI up and running to almost nothing. Simon notes he's still using his vibe-coded bandwidth and GPU monitoring macOS task bar apps built in March.\",\n    \"author\": \"Simon Willison (citing Thomas Ptacek)\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-21\",\n    \"topics\": [\"vibe-coding\", \"coding-agents\", \"native UIs\", \"generative-ai\", \"llms\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"ChatGPT search now uses the site: operator at scale\",\n    \"description\": \"Promptwatch tracking shows ChatGPT Search usage of site: operator jumped from 0.3-0.5% to 16-17% around August 8, correlating with GPT-5.6 Sol rollout. On August 18th, Promptwatch reported ChatGPT appeared to have greatly reduced the likelihood of Reddit being used in those searches.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"chatgpt\", \"search\", \"site:operator\", \"openai\", \"seo\", \"system-prompts\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Bun 1.4 adds Bun.WebView for browser automation\",\n    \"description\": \"Bun 1.4 release adds Bun.WebView for first-class browser automation support using either macOS WebKit or control of a local Chromium process via CDP. Simon prototyped a web API with Claude Code for web that loads pages and executes JavaScript, inspired by shot-scraper.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"bun\", \"javascript\", \"rust\", \"browsers\", \"coding-agents\", \"typescript\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"smolmachines / smolvm as a sandbox for untrusted Python & JavaScript\",\n    \"description\": \"Research task testing smolmachines.com as a fast secure sandbox for running untrusted Python and JavaScript code with limits on RAM, CPU time, no network access, and controlled filesystem access. Claude Fable 5 creatively worked around Claude Code for web environment limits by running tests via GitHub Actions.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-19\",\n    \"topics\": [\"research\", \"sandboxing\", \"claude-mythos-fable\", \"generative-ai\", \"github-actions\", \"coding-agents\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Mojo🔥 is now open source\",\n    \"description\": \"Mojo programming language released compiler and toolchain under Apache 2 license. Originally planned as Python superset, that plan changed around August 2025. Today Mojo is its own language optimized for GPU programming with Python-inspired syntax.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-18\",\n    \"topics\": [\"mojo\", \"open-source\", \"python\", \"gpu-programming\", \"ai-assisted-coding\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Qwen 3.8 27B scores 52 on Artificial Analysis Intelligence Index\",\n    \"description\": \"Qwen 3.8 27B matches GPT-5.6 Luna performance (score 52), just one point behind GLM-5.2 (753B) and DeepSeek V4 Pro 0813 (1.7T). Qwen is a truly astonishing 27B parameter Apache 2 licensed model.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-17\",\n    \"topics\": [\"qwen\", \"llm\", \"local-llms\", \"artificial-analysis\", \"ai-in-china\", \"open-source\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"We Tracked a Shipment of Rare Books. It Ended at an Amazon AI Training Facility\",\n    \"description\": \"404 Media investigated with an AirTag where large-volume book orders from anonymous suspected AI training customers actually go. The book ended at Amazon's LAS8 facility in Las Vegas, confirmed by worker discussions to destructively scan large volumes of books for AI training.\",\n    \"author\": \"Simon Willison (citing 404 Media)\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-17\",\n    \"topics\": [\"amazon\", \"journalism\", \"ai\", \"training-data\", \"ai-ethics\", \"404-media\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Qwen 3.8 27B is excellent, but it defaults to wildly overthinking things\",\n    \"description\": \"Friday's big release Qwen 3.8 27B is an Apache 2 licensed 27B parameter vision-capable LLM from Alibaba. While impressive, it tends to 'wildly overthink' things by default. 27B is an excellent size for running on reasonably specced laptops.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-16\",\n    \"topics\": [\"qwen\", \"llm\", \"local-llms\", \"llm-reasoning\", \"llama-cpp\", \"lm-studio\", \"ai-in-china\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"CORS Chat tool for testing local models\",\n    \"description\": \"Built with GPT-5.6-Sol xhigh to test Qwen 3.8 27B running in LM Studio on both M5 MacBook Pro and NVIDIA DGX Spark. Provides web UI for OpenAI-Responses-compatible chat endpoints, supports SVG progressive rendering, exports conversations as JSON.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-15\",\n    \"topics\": [\"cors\", \"llms\", \"svg\", \"generative-ai\", \"openrouter\", \"lm-studio\", \"ai\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Don't classify. Hallucinate!\",\n    \"description\": \"Doug Turnbull's neat solution for tagging content with large tag vocabularies: tell the model to output tags without details of existing vocabulary, then use vector embeddings against existing corpus to find closest concrete tags to the ones the model imagined.\",\n    \"author\": \"Simon Willison (citing Doug Turnbull)\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-14\",\n    \"topics\": [\"search\", \"ai\", \"generative-ai\", \"llms\", \"embeddings\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"DeepSeek V4 Pro 0813 (on OpenRouter)\",\n    \"description\": \"Latest DeepSeek Pro model now available via API only. Got very different looking outputs for three different reasoning levels (low, medium, high) - a difference not noticed from other models. Weights now available on Hugging Face, 1.7T parameters, 893 GB.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-12\",\n    \"topics\": [\"deepseek\", \"llm\", \"pelican-riding-a-bicycle\", \"llm-release\", \"ai-in-china\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"alchemy-utils: database-agnostic sqlite-utils alternative\",\n    \"description\": \"Morning shower project that tasked Codex and GPT-5.6 Sol Ultra with building a library with same core API as SQLite-utils but backed by SQLAlchemy for multiple database engines. Uses red/green TDD and pytest. Can import SF's tree dataset into DuckDB in 35 seconds after optimization.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-12\",\n    \"topics\": [\"sqlite-utils\", \"sql\", \"sqlalchemy\", \"sqlite\", \"duckdb\", \"postgresql\", \"python\", \"projects\", \"databases\", \"codex\", \"coding-agents\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"There are no lossless transformations of natural-language text\",\n    \"description\": \"Sophie Alpert's internal policy on acceptable use of AI writing by engineers. Key rule: You must stand behind every idea and every sentence in your docs. Every rewrite and rephrase changes meaning, and if done by entity without detailed mental representation, information will be lost.\",\n    \"author\": \"Simon Willison (citing Sophie Alpert)\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-11\",\n    \"topics\": [\"writing\", \"ai\", \"generative-ai\", \"llms\", \"ai-misuse\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Stealing Reasoning Traces from Proprietary LLM APIs\",\n    \"description\": \"Paper finds Anthropic, OpenAI, and Google return encrypted chain-of-thought blocks that can be replayed across sessions. Every model under same family used same encryption key, so feeding encrypted blocks into weaker sibling and jailbreaking could recover stronger model's hidden reasoning in plaintext. Now fixed.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-11\",\n    \"topics\": [\"jailbreaking\", \"ai\", \"openai\", \"prompt-injection\", \"generative-ai\", \"llms\", \"anthropic\", \"gemini\", \"llm-reasoning\", \"paper-review\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Introducing Muse Glimmer\",\n    \"description\": \"Meta back in open weights game with Muse Glimmer, a brand new 30B model under clean Apache 2.0 license. Claims optimization for end-to-end agentic task completion, reliable tool use, and multi-step reasoning. Tested with llm-coding-agent plugin to explore codebase.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-08-10\",\n    \"topics\": [\"meta\", \"llama\", \"local-llms\", \"llms\", \"llm\", \"vision-llms\", \"llm-release\", \"agents\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Show HN: Huzzah – Novel AI Coding Approach\",\n    \"description\": \"New method for programming with AI assistance. Community discussion with 196 points and 110 comments.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://news.ycombinator.com/\",\n    \"published_date\": \"2026-08-19\",\n    \"topics\": [\"AI coding\", \"Show HN\", \"programming tools\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Stop Anthropomorphizing Intermediate Tokens\",\n    \"description\": \"Paper argues against interpreting middle tokens as reasoning. 189 points, 105 comments on Hacker News.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://news.ycombinator.com/\",\n    \"published_date\": \"2026-08-18\",\n    \"topics\": [\"LLM\", \"interpretation\", \"tokens\", \"reasoning\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Vomit: Cleaning Claude 5 Token Output\",\n    \"description\": \"Uses separate LLM to refine another model's output. 169 points, 184 comments discussing the technique.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://news.ycombinator.com/\",\n    \"published_date\": \"2026-08-17\",\n    \"topics\": [\"Claude\", \"LLM\", \"output refinement\", \"token processing\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Every Model Cheats\",\n    \"description\": \"Research on prompt-level mitigation of model cheating behaviors. 75 points, 56 comments discussing the findings.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://news.ycombinator.com/\",\n    \"published_date\": \"2026-08-16\",\n    \"topics\": [\"LLM\", \"safety\", \"adversarial\", \"model behavior\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"DiffusionGemma Technical Report\",\n    \"description\": \"New arXiv publication on diffusion models. 130 points, 34 comments on Hacker News.\",\n    \"author\": \"Hacker News Community\",\n    \"source\": \"Hacker News\",\n    \"url\": \"https://news.ycombinator.com/\",\n    \"published_date\": \"2026-08-16\",\n    \"topics\": [\"diffusion models\", \"Gemma\", \"generative AI\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"A Jagged Frontier: Evaluating Robustness of Code Agents to Semantics-Preserving Transformations\",\n    \"description\": \"Evaluates code agents against transformations that preserve semantics. Authors from Colorado State University, Microsoft, UIUC, and Carnegie Mellon.\",\n    \"author\": \"Researchers from CSU, Microsoft, UIUC, CMU\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"code agents\", \"robustness\", \"evaluation\", \"semantics\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Adversarial Review: Structured Disagreement for Grounded Agentic Code Review\",\n    \"description\": \"Accepted to ICML 2026 Workshop on DL4C. Focuses on automated code review methodologies using structured disagreement.\",\n    \"author\": \"Researchers\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"code review\", \"agents\", \"ICML 2026\", \"automated review\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Looped Language Models Improve Compositional Tool Calling\",\n    \"description\": \"Examines how looped architectures enhance tool use capabilities, relevant for code generation and function calling.\",\n    \"author\": \"Researchers\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"LLM\", \"tool calling\", \"code generation\", \"function calling\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"SESSE: LLM-as-Judge Evaluation via Structured Decomposition\",\n    \"description\": \"Framework for improving LLM evaluation through decomposition: Sketch, Expand, Sort, Summarize, Evaluate.\",\n    \"author\": \"Researchers\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"LLM evaluation\", \"LLM-as-judge\", \"evaluation framework\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Eureka: Task-Conditioned Meta-Agent Orchestration for Scientific Discovery\",\n    \"description\": \"62-page paper on coordinating multiple agents, combining AI with number theory applications.\",\n    \"author\": \"Researchers\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"agents\", \"multi-agent systems\", \"orchestration\", \"scientific discovery\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"ComponentBench: Diagnosing Component-Level Failures in Computer-Use Agents\",\n    \"description\": \"Accepted at COLM 2026. Benchmark for testing agent components at the component level.\",\n    \"author\": \"Researchers\",\n    \"source\": \"ArXiv\",\n    \"url\": \"https://arxiv.org/list/cs.AI/recent\",\n    \"published_date\": \"2026-08-20\",\n    \"topics\": [\"agents\", \"benchmarks\", \"COLM 2026\", \"computer-use agents\"],\n    \"type\": \"technical\"\n  }\n]",
