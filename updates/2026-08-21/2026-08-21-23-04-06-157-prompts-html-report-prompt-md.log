ta\">\n                                <span class=\"item-source\">ArXiv</span>\n                                <span class=\"item-date\">2026-08-20</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">agents</span>\n                                <span class=\"topic-tag\">benchmarks</span>\n                                <span class=\"topic-tag\">COLM 2026</span>\n                            </div>\n                        </div>\n\n                        <!-- Every Model Cheats -->\n                        <div class=\"item\">\n                            <div class=\"item-title\">\n                                <a href=\"https://news.ycombinator.com/\" target=\"_blank\">Every Model Cheats</a>\n                            </div>\n                            <div class=\"item-description\">\n                                Research on prompt-level mitigation of model cheating behaviors. 75 points, 56 comments discussing the findings.\n                            </div>\n                            <div class=\"item-meta\">\n                                <span class=\"item-source\">Hacker News</span>\n                                <span class=\"item-date\">2026-08-16</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">LLM</span>\n                                <span class=\"topic-tag\">safety</span>\n                                <span class=\"topic-tag\">adversarial</span>\n                            </div>\n                        </div>\n\n                        <!-- ChatGPT Search Site Operator -->\n                        <div class=\"item\">\n                            <div class=\"item-title\">\n                                <a href=\"https://simonwillison.net/\" target=\"_blank\">ChatGPT Search site: operator usage surge</a>\n               