dge {\n            color: #ff6600;\n            font-size: 11px;\n            font-weight: normal;\n        }\n\n        .release-date {\n            color: #828282;\n            font-size: 11px;\n        }\n\n        .quote {\n            background-color: #f6f6ef;\n            padding: 8px;\n            margin: 6px 0;\n            font-style: italic;\n            font-size: 11px;\n            color: #444444;\n            border-left: 2px solid #ff6600;\n        }\n\n        .quote-source {\n            font-size: 10px;\n            color: #828282;\n            margin-top: 4px;\n            font-style: normal;\n        }\n\n        .sentiment-positive {\n            color: #228822;\n        }\n\n        .sentiment-negative {\n            color: #cc2222;\n        }\n\n        .sentiment-neutral {\n            color: #828282;\n        }\n\n        .topics {\n            margin-top: 6px;\n        }\n\n        .topic-tag {\n            display: inline-block;\n            background-color: #f0f0f0;\n            padding: 2px 6px;\n            margin: 2px 2px 2px 0;\n            border-radius: 2px;\n            font-size: 10px;\n            color: #666666;\n        }\n\n        .version-badge {\n            background-color: #ff6600;\n            color: #ffffff;\n            padding: 2px 6px;\n            border-radius: 2px;\n            font-size: 10px;\n            margin-right: 5px;\n        }\n\n        footer {\n            background-color: #f6f6ef;\n            padding: 15px 0;\n            border-top: 1px solid #d4d4d4;\n            margin-top: 20px;\n            text-align: center;\n        }\n\n        footer a {\n            color: #828282;\n            font-size: 11px;\n            margin: 0 10px;\n        }\n\n        footer a:hover {\n            color: #000000;\n        }\n\n        .footer-text {\n            color: #828282;\n            font-size: 11px;\n            margin-top: 10px;\n        }\n\n        .highlight-link {\n            color: #ff6600;\n  