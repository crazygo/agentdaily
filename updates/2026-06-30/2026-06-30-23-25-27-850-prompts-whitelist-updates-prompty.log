    "originalFile": "[\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Week 26 Updates: MCP Login, Shell Mode Improvements, and Rewind\",\n    \"description\": \"Added claude mcp login/logout commands for shell-based MCP authentication, shell mode now responds to command output automatically, /rewind can resume conversations from before /clear, and background subagents surface permission prompts in main session.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-06-26\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"I can no longer in good conscience recommend Claude Code\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Claude Code and Opus quality regressions - serious performance degradation in Claude Code on MacOS since 22 June 2026\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"2026 Is Where It Gets Very Real Because Of Claude Code\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Week 25: Artifacts Beta and Enhanced Auto Mode\",\n    \"description\": \"Artifacts feature in beta on Team/Enterprise plans turns session output into live shareable pages. Enhanced deny/ask rules match tool parameters, /config sets settings from prompt, and auto mode blocks destructive git commands.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-06-19\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Week 24: /cd Command, Subagent Spawning, and Safe Mode\",\n    \"description\": \"New /cd command moves sessions to new directories mid-conversation, subagents can now spawn their own subagents, --safe-mode starts with customizations disabled, and fallbackModel configures up to three fallback models.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-06-12\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Version 3.9: Custom Plugins, Skills, and MCP Integration\",\n    \"description\": \"Released June 22, 2026. Added custom Cursor plugins, custom skills, and custom MCP (Model Context Protocol) integration. New 'Customization' page allows users to customize Cursor according to workflow needs.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-06-22\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Usage-Based Billing Now Live for All Plans\",\n    \"description\": \"GitHub Copilot moved to usage-based billing on June 1, 2026. All plans now bill based on GitHub AI Credits consumed. Added user-level budget controls, Copilot Max upgrade for power users, and Copilot code review now consumes Actions minutes.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-06-01-updates-to-github-copilot-billing-and-plans/\",\n    \"date\": \"2026-06-01\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"End of an Era - GitHub Copilot became unusable for individual devs after the usage-based billing change\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"One developer reported their April 2026 usage would cost $14,064.55 more under usage-based billing compared to their current $910.98 bill\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"A user was charged $0.51 (51 AI credits) just to write a simple commit message and git push\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"I don't understand all the hate on the new usage-based billing\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Service Discontinuation and Transition to Antigravity CLI\",\n    \"description\": \"Google announced Gemini CLI will stop working from June 18, 2026, with a transition to Antigravity CLI. The June 2026 release included safer auto-updates, improved terminal and WSL handling, and faster core behavior.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://news.ycombinator.com/item?id=48196867\",\n    \"date\": \"2026-06-18\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Gemini CLI was positioned as a direct competitor to Claude Code, a CLI-based coding agent\",\n        \"source\": \"Hacker News\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Wave 13 Update with Enhanced Memory System\",\n    \"description\": \"Windsurf Wave 13 (2026) includes improved Cascade Memory System that remembers codebase structure and preferences. Windsurf is the rebranded name for Codeium, positioned as a free alternative to paid tools.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://weavai.app/blog/en/2026/05/26/2026-windsurf-ai-guide-master-the-best-ai-code-editor/\",\n    \"date\": \"2026-06-01\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Codeium was the free alternative. The tool you recommended to junior developers, students, or anyone who didn't want to pay $20/month\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"June 2026: Enterprise Features and MCP Expansion\",\n    \"description\": \"Added session folders, !ultra and !fast Slack commands, enterprise snapshot build schedules, and 48+ new MCP connectors including Miro, Mixpanel, Honeycomb, Postman. Classic environment setup deprecated on June 30, 2026 in favor of declarative configuration.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/2026\",\n    \"date\": \"2026-06-30\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Major Business Milestone: $492M ARR and $1B Funding\",\n    \"description\": \"Devin hit $492M ARR in June 2026 (up from $73M in June 2025), and Cognition raised $1B at $26B valuation led by Lux Capital, General Catalyst, and 8VC. Introduced the 'Devin Guarantee' challenging traditional SaaS models. Devin now writes 89% of its own code.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://www.linkedin.com/posts/whatsupai_news-break-june-06-2026-the-devin-activity-7468965622798856192--RR5\",\n    \"date\": \"2026-06-06\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The third week of June 2026 was cited as completely rewriting the playbook for AI startups\",\n        \"source\": \"LinkedIn/Startup analysis\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"AI coding is a $260B business opportunity and no longer experimental\",\n        \"source\": \"Startup research\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"June 2026: Performance Improvements and Enhanced Features\",\n    \"description\": \"OpenAI Codex CLI released updates including usage views for token activity, richer /goal handling for large text and images, safer session deletion, and new /import command for bringing in Claude Code. Additional performance improvements and bug fixes released June 16, 2026.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-06-16\",\n    \"community_feedback\": []\n  }\n]\n",
