Arial, Helvetica, sans-serif;\n            font-size: 16px;\n            font-weight: bold;\n            color: #000000;\n            margin-bottom: 12px;\n            padding-bottom: 8px;\n            border-bottom: 1px solid #ff6600;\n        }\n\n        .item {\n            margin-bottom: 15px;\n            padding-bottom: 12px;\n            border-bottom: 1px dotted #d4d4d4;\n        }\n\n        .item:last-child {\n            border-bottom: none;\n            margin-bottom: 0;\n            padding-bottom: 0;\n        }\n\n        .item-title {\n            font-size: 14px;\n            font-weight: bold;\n            margin-bottom: 4px;\n        }\n\n        .item-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .item-title a:hover {\n            text-decoration: underline;\n        }\n\n        .item-description {\n            font-size: 13px;\n            color: #000000;\n            margin-bottom: 6px;\n            line-height: 1.4;\n        }\n\n        .item-meta {\n            font-size: 11px;\n            color: #828282;\n        }\n\n        .item-meta a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        .item-meta a:hover {\n            text-decoration: underline;\n        }\n\n        .tag {\n            display: inline-block;\n            background-color: #f6f6ef;\n            color: #000000;\n            padding: 2px 6px;\n            font-size: 11px;\n            border: 1px solid #d4d4d4;\n            border-radius: 2px;\n            margin-right: 4px;\n            margin-bottom: 4px;\n        }\n\n        .category {\n            display: inline-block;\n            background-color: #ff6600;\n            color: #000000;\n            padding: 2px 6px;\n            font-size: 11px;\n            font-weight: bold;\n            border-radius: 2px;\n            margin-right: 4px;\n            margin-bottom: 4px;\n        }\n\n        .quote {\n            background-color: #f6f6ef;\n            padding: 8px;\n            margin: 6px 0;\n            font-style: italic;\n            font-size: 12px;\n            border-left: 3px solid #ff6600;\n        }\n\n        .quote-source {\n            color: #828282;\n            font-size: 11px;\n            margin-top: 4px;\n        }\n\n        .update-type {\n            display: inline-block;\n            font-size: 10px;\n            font-weight: bold;\n            padding: 2px 5px;\n            border-radius: 2px;\n            margin-right: 5px;\n            text-transform: uppercase;\n        }\n\n        .update-type.feature {\n            background-color: #ff6600;\n            color: #000000;\n        }\n\n        .update-type.release {\n            background-color: #00ff00;\n            color: #000000;\n        }\n\n        .update-type.announcement {\n            background-color: #0066ff;\n            color: #ffffff;\n        }\n\n        .insight-topics {\n            margin-top: 6px;\n        }\n\n        .insight-topics span {\n            display: inline-block;\n            background-color: #f0f0f0;\n            color: #828282;\n            padding: 2px 6px;\n            font-size: 10px;\n            border-radius: 2px;\n            margin-right: 3px;\n            margin-bottom: 3px;\n        }\n\n        footer {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            padding: 10px;\n            text-align: center;\n            font-size: 12px;\n            color: #828282;\n        }\n\n        footer a {\n            color: #828282;\n            text-decoration: none;\n            margin: 0 10px;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n        }\n\n        code {\n            font-family: Monaco, Consolas, monospace;\n            background-color: #f6f6ef;\n            padding: 2px 4px;\n            font-size: 12px;\n            border-radius: 2px;\n        }\n\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            section {\n                page-break-inside: avoid;\n            }\n\n            .three-column-layout {\n                display: block;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agentic Coding Research Report</h1>\n            <div class=\"date\">2026-06-30 | Week 26 Update</div>\n        </header>\n\n        <main class=\"three-column-layout\">\n            <section class=\"new-products\">\n                <h2>New Products & Tools</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/products/agent-arena\">Agent Arena</a>\n                    </div>\n                    <div class=\"item-description\">\n                        An open competition network where autonomous AI agents compete in real-world challenges, earn rewards, and build reputation.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"category\">Code agent</span>\n                        <span class=\"tag\">Product Hunt</span>\n                        <span class=\"tag\">Twitter/X</span>\n                        <span>Released: 2026-06-26</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://deep-reinforce.com/ornith_1_0.html\">Ornith-1.0</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Family of self-improving open-source agentic coding models from DeepReinforce. Spans 9B to 397B parameters, MIT-licensed, uses reinforcement learning-based optimization.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"category\">Open-source AI coding agent</span>\n                        <span class=\"tag\">DeepReinforce</span>\n                        <span class=\"tag\">Hacker News</span>\n                        <span>Released: 2026-06-25</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.devopsdigest.com/typemock-launches-test-review\">TypeMock Test Review</a>\n                    </div>\n                    <div class=\"item-description\">\n                        AI-powered testing solution that helps software development teams evaluate test quality and trustworthiness. Identifies duplicate, fragile, and ineffective unit tests.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"category\">Workflow-specific AI tool (testing)</span>\n                        <span class=\"tag\">DevOps Digest</span>\n                        <span class=\"tag\">SD Times</span>\n                        <span>Released: 2026-06-22</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.com/OpenHands/OpenHands/releases\">OpenHands v1.8.0</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Major release of the open-source autonomous AI development platform (formerly OpenDevin). Features new Agent Canvas for self-hosted engineering team control center.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"category\">Open-source AI coding agent</span>\n                        <span class=\"tag\">GitHub</span>\n                        <span class=\"tag\">54K+ stars</span>\n                        <span>Released: 2026-06-18</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.microsoft.com/en-us/microsoft-365/blog/2026/06/02/announcing-the-new-work-iq-apis/\">Microsoft Work IQ APIs</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Microsoft's enterprise-grade API that provides AI agents with programmatic access to Microsoft 365 intelligence layer and context. Enables development of governed enterprise agents.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"category\">Workflow orchestration AI agent (enterprise)</span>\n                        <span class=\"tag\">Microsoft 365</span>\n                        <span class=\"tag\">GA</span>\n                        <span>Released: 2026-06-16</span>\n                    </div>\n                </div>\n            </section>\n\n            <section class=\"whitelist-updates\">\n                <h2>Product Updates</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://code.claude.com/docs/en/whats-new\">Claude Code: Week 26 Updates</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Added MCP login/logout commands, shell mode improvements, /rewind to resume conversations, and background subagent permission prompts.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span>2026-06-26</span>\n                    </div>\n                    <div class=\"quote\">\"I can no longer in good conscience recommend Claude Code\"<div class=\"quote-source\">Reddit (negative feedback)</div></div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://code.claude.com/docs/en/whats-new\">Claude Code: Week 25</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Artifacts feature in beta on Team/Enterprise plans. Enhanced deny/ask rules and auto mode blocks destructive git commands.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span>2026-06-19</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://cursor.com/changelog\">Cursor v3.9</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Added custom Cursor plugins, custom skills, and custom MCP integration. New 'Customization' page for workflow needs.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span>2026-06-22</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://github.blog/changelog/2026-06-01-updates-to-github-copilot-billing-and-plans/\">GitHub Copilot: Usage-Based Billing</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Moved to usage-based billing June 1, 2026. All plans now bill based on GitHub AI Credits consumed with user-level budget controls.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type release\">Release</span>\n                        <span>2026-06-01</span>\n                    </div>\n                    <div class=\"quote\">\"End of an Era - GitHub Copilot became unusable for individual devs\"<div class=\"quote-source\">Reddit</div></div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://docs.devin.ai/release-notes/2026\">Devin: $492M ARR & $1B Funding</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Devin hit $492M ARR in June 2026 (up from $73M in June 2025). Cognition raised $1B at $26B valuation. Devin now writes 89% of its own code.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type announcement\">Announcement</span>\n                        <span>2026-06-06</span>\n                    </div>\n                    <div class=\"quote\">\"AI coding is a $260B business opportunity and no longer experimental\"<div class=\"quote-source\">Startup research</div></div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://docs.devin.ai/release-notes/2026\">Devin: Enterprise Features</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Added session folders, Slack commands, enterprise snapshot build schedules, and 48+ new MCP connectors.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span>2026-06-30</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://weavai.app/blog/en/2026/05/26/2026-windsurf-ai-guide-master-the-best-ai-code-editor/\">Windsurf Wave 13</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Improved Cascade Memory System that remembers codebase structure and preferences. Free alternative to paid tools.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type feature\">Feature</span>\n                        <span>2026-06-01</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://news.ycombinator.com/item?id=48196867\">Gemini CLI: Service Discontinuation</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Google announced Gemini CLI will stop working from June 18, 2026, with transition to Antigravity CLI.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span class=\"update-type announcement\">Announcement</span>\n                        <span>2026-06-18</span>\n                    </div>\n                </div>\n            </section>\n\n            <section class=\"technical-insights\">\n                <h2>Technical Insights</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\">Agent in the loop: Flipping the narrative</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Jon Udell argues against \"human in the loop\" phrasing. We should view agents as joining our team, not as authorities we serve.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span>Jon Udell</span>\n                        <span>2026-06-28</span>\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span>ai</span>\n                        <span>coding-agents</span>\n                        <span>agentic-engineering</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\">AI infrastructure and frontier model economics</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Dean W. Ball analyzes: Frontier models cost enormous amounts to train, with narrow post-release windows to recoup costs before competition emerges.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span>Dean W. Ball</span>\n                        <span>2026-06-26</span>\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span>ai</span>\n                        <span>llms</span>\n                        <span>economics</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\">LLMs have a learning curve</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Timothy B. Lee: \"LLMs absolutely have learning curves and require developed skills to use effectively.\"\n                    </div>\n                    <div class=\"item-meta\">\n                        <span>Timothy B. Lee</span>\n                        <span>2026-06-26</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\">OpenAI announces GPT-5.6 series</a>\n                    </div>\n                    <div class=\"item-description\">\n                        GPT-5.6 with three models: Sol (flagship), Terra (balanced), and Luna (fast/affordable). New predictable prompt caching with 30-min minimum cache life.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span>OpenAI</span>\n                        <span>2026-06-26</span>\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span>gpt</span>\n                        <span>openai</span>\n                        <span>llm-release</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\">AI security: 2,000 failed hack attempts</a>\n                    </div>\n                    <div class=\"item-description\">\n                        6,000 attempts and $500 in token spend failed to leak secrets from OpenClaw test instance. Frontier models' training against injection appears effective.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span>Fernando Irarrázaval</span>\n                        <span>2026-06-26</span>\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span>security</span>\n                        <span>prompt-injection</span>\n                        <span>ai-security-research</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\">CVE-2026-LGTM: AI review agent conflicts</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Satirical incident report: Two competing AI review agents entered disagreement loop over package safety. After 340 comments and $41,255 in inference spend, API keys were revoked.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span>Andrew Nesbitt</span>\n                        <span>2026-06-26</span>\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span>security</span>\n                        <span>ai</span>\n                        <span>supply-chain</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\">AI and Liability: German ruling on Google</a>\n                    </div>\n                    <div class=\"item-description\">\n                        German ruling holds Google liable for AI errors. AI agents are agents of deploying organization and should be treated as such by law.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span>Bruce Schneier</span>\n                        <span>2026-06-25</span>\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span>google</span>\n                        <span>law</span>\n                        <span>ai-ethics</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\">Converting MDN data to SQLite</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Simon converted Mozilla's mdn/browser-compat-data into 66MB SQLite database using Claude Code (Opus 4.8). Hosted on GitHub CDN with open CORS.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span>Simon Willison</span>\n                        <span>2026-06-24</span>\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span>github</span>\n                        <span>mozilla</span>\n                        <span>ai-assisted-programming</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://simonwillison.net/\">LLM-generated job applications</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Tom MacWright: \"I don't know anything about these people. They haven't put themselves out there.\" LLM-generated resumes are generic and impersonal.\n                    </div>\n                    <div class=\"item-meta\">\n                        <span>Tom MacWright</span>\n                        <span>2026-06-24</span>\n                    </div>\n                </div>\n            </section>\n        </main>\n\n        <footer>\n            <a href=\"#\">Archive</a>\n            <a href=\"#\">About</a>\n            <a href=\"#\">Subscribe</a>\n            <a href=\"#\">GitHub</a>\n            <span style=\"margin-left: 20px;\">Generated with Claude Code</span>\n        </footer>\n    </div>\n</body>\n</html>"
