nt */\n        main {\n            padding: 30px 0;\n        }\n\n        .three-column-layout {\n            display: grid;\n            grid-template-columns: 40% 35% 25%;\n            gap: 30px;\n        }\n\n        /* Section Styling */\n        .section-header {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 18px;\n            font-weight: bold;\n            margin-bottom: 20px;\n            padding-bottom: 10px;\n            border-bottom: 2px solid #ff6600;\n        }\n\n        .section-content {\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n        }\n\n        /* Card Styling */\n        .card {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            padding: 15px;\n            border-radius: 3px;\n            transition: box-shadow 0.2s ease;\n        }\n\n        .card:hover {\n            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n        }\n\n        .card-title {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 15px;\n            font-weight: bold;\n            margin-bottom: 8px;\n        }\n\n        .card-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .card-title a:hover {\n            color: #ff6600;\n        }\n\n        .card-description {\n            font-size: 13px;\n            color: #333333;\n            margin-bottom: 10px;\n            line-height: 1.5;\n        }\n\n        .card-meta {\n            font-size: 11px;\n            color: #828282;\n            display: flex;\n            flex-wrap: wrap;\n            gap: 10px;\n            align-items: center;\n        }\n\n        .card-meta .source {\n            color: #ff6600;\n        }\n\n        .card-meta .category {\n            background-color: #f6f6ef;\n            padding: 2px 6px;\n            border-radius: 2px;\n            font-size: 10px;\n            font-weight: bold;\n        }\n\n        .card-meta .date {\n            color: #828282;\n        }\n\n        /* Product-specific styling */\n        .quote {\n            font-style: italic;\n            color: #555555;\n            font-size: 12px;\n            margin: 8px 0;\n            padding-left: 10px;\n            border-left: 2px solid #d4d4d4;\n        }\n\n        /* Feedback styling */\n        .feedback-item {\n            margin: 8px 0;\n            padding: 8px;\n            background-color: #f6f6ef;\n            border-radius: 3px;\n            font-size: 12px;\n        }\n\n        .feedback-item.positive {\n            border-left: 3px solid #00b300;\n        }\n\n        .feedback-item.negative {\n            border-left: 3px solid #cc0000;\n        }\n\n        .feedback-item.neutral {\n            border-left: 3px solid #828282;\n        }\n\n        .feedback-quote {\n            font-style: italic;\n            color: #333333;\n        }\n\n        .feedback-source {\n            color: #828282;\n            font-size: 11px;\n            margin-top: 4px;\n        }\n\n        /* Topics tags */\n        .topics {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 5px;\n            margin-top: 10px;\n        }\n\n        .topic-tag {\n            background-color: #f6f6ef;\n            padding: 2px 6px;\n            border-radius: 2px;\n            font-size: 10px;\n            color: #828282;\n        }\n\n        /* Update type badges */\n        .update-type {\n            display: inline-block;\n            padding: 3px 8px;\n            border-radius: 2px;\n            font-size: 10px;\n            font-weight: bold;\n            margin-right: 8px;\n        }\n\n        .update-type.release {\n            background-color: #e6f3ff;\n            color: #0066cc;\n        }\n\n        .update-type.feature {\n            background-color: #e6ffe6;\n            color: #00b300;\n        }\n\n        .update-type.announcement {\n            background-color: #fff3e6;\n            color: #cc6600;\n        }\n\n        /* Footer */\n        footer {\n            border-top: 1px solid #d4d4d4;\n            padding: 20px 0;\n            margin-top: 40px;\n            text-align: center;\n            font-size: 12px;\n            color: #828282;\n        }\n\n        footer a {\n            color: #ff6600;\n            text-decoration: none;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1200px) {\n            .three-column-layout {\n                grid-template-columns: 1fr 1fr;\n            }\n\n            .technical-insights {\n                grid-column: 1 / -1;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .three-column-layout {\n                grid-template-columns: 1fr;\n                gap: 30px;\n            }\n\n            .page-title h1 {\n                font-size: 22px;\n            }\n\n            .card {\n                padding: 12px;\n            }\n        }\n\n        /* Print styles */\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            .card {\n                break-inside: avoid;\n                page-break-inside: avoid;\n            }\n\n            header {\n                background-color: #ffffff !important;\n                border-bottom: 2px solid #000000;\n            }\n\n            .logo, .header-nav a {\n                color: #000000 !important;\n            }\n        }\n\n        /* Accessibility */\n        a:focus {\n            outline: 2px solid #ff6600;\n            outline-offset: 2px;\n        }\n\n        .visually-hidden {\n            position: absolute;\n            width: 1px;\n            height: 1px;\n            padding: 0;\n            margin: -1px;\n            overflow: hidden;\n            clip: rect(0, 0, 0, 0);\n            white-space: nowrap;\n            border: 0;\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <div class=\"container header-content\">\n            <a href=\"#\" class=\"logo\">AgentDaily</a>\n            <nav class=\"header-nav\">\n                <a href=\"#new-products\">New Products</a>\n                <a href=\"#whitelist-updates\">Updates</a>\n                <a href=\"#technical-insights\">Insights</a>\n            </nav>\n        </div>\n    </header>\n\n    <div class=\"container\">\n        <div class=\"page-title\">\n            <h1>Agentic Coding Research Report</h1>\n            <div class=\"date\">July 27, 2026</div>\n        </div>\n\n        <main>\n            <div class=\"three-column-layout\">\n                <!-- New Products Section -->\n                <section class=\"new-products\" id=\"new-products\">\n                    <div class=\"section-header\">New Products</div>\n                    <div class=\"section-content\">\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://kimi.moonshot.cn\" target=\"_blank\" rel=\"noopener noreferrer\">Kimi K3</a>\n                            </div>\n                            <div class=\"card-description\">\n                                The world's first open 3T-class model from Moonshot AI, featuring a 2.8-trillion-parameter Mixture-of-Experts architecture. Designed specifically for long-horizon coding and knowledge work.\n                            </div>\n                            <div class=\"quote\">\"Largest open-weight model ever released\"</div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">BBC, CNBC, VentureBeat</span>\n                                <span class=\"category\">AI coding model</span>\n                                <span class=\"date\">2026-07-16</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://www.producthunt.com/products/clark\" target=\"_blank\" rel=\"noopener noreferrer\">Clark</a>\n                            </div>\n                            <div class=\"card-description\">\n                                An AI agent with its own private cloud computer that can browse the web, run code, manage files, and return finished artifacts. Unlike typical AI assistants, Clark executes real development tasks independently.\n                            </div>\n                            <div class=\"quote\">\"An AI coworker with its own cloud computer\"</div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Product Hunt, ChatGate</span>\n                                <span class=\"category\">Workflow agent</span>\n                                <span class=\"date\">2026-07-18</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://www.producthunt.com/products/unabyss-for-claude\" target=\"_blank\" rel=\"noopener noreferrer\">Unabyss for Claude</a>\n                            </div>\n                            <div class=\"card-description\">\n                                A shared memory layer and workspace memory tool for Claude that creates unified context across all applications and LLMs. Pulls context from 20+ apps including email, Google Drive, GitHub, and Notion.\n                            </div>\n                            <div class=\"quote\">\"Shared memory across all apps and LLMs\"</div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Product Hunt</span>\n                                <span class=\"category\">Workflow agent</span>\n                                <span class=\"date\">2026-07-17</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://www.producthunt.com/products/zoodata\" target=\"_blank\" rel=\"noopener noreferrer\">ZooData</a>\n                            </div>\n                            <div class=\"card-description\">\n                                The data layer for AI agents that transforms any URL into agent-ready JSON, enabling AI agents to work with structured data instead of raw HTML. Ranked #1 on Product Hunt for July 18, 2026.\n                            </div>\n                            <div class=\"quote\">\"Turns any URL into agent-ready JSON\"</div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Product Hunt</span>\n                                <span class=\"category\">Workflow agent</span>\n                                <span class=\"date\">2026-07-18</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://www.producthunt.com/products/openmarkdown\" target=\"_blank\" rel=\"noopener noreferrer\">OpenMarkdown</a>\n                            </div>\n                            <div class=\"card-description\">\n                                A fast, lightweight markdown editor designed for collaborative editing between developers and AI agents. Enables real-time co-editing where the AI agent can read, write, and format markdown alongside the user.\n                            </div>\n                            <div class=\"quote\">\"A markdown editor you and your agent co-edit\"</div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Product Hunt</span>\n                                <span class=\"category\">Workflow agent</span>\n                                <span class=\"date\">2026-07-18</span>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n\n                <!-- Whitelist Updates Section -->\n                <section class=\"whitelist-updates\" id=\"whitelist-updates\">\n                    <div class=\"section-header\">Whitelist Updates</div>\n                    <div class=\"section-content\">\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <span class=\"update-type release\">RELEASE</span>\n                                <a href=\"https://devin.ai/\" target=\"_blank\" rel=\"noopener noreferrer\">Devin</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Redesigned model with new language selection for AI-generated review comments. Achieved FedRAMP Class D certification, unlocking autonomous AI engineering for federal agencies. Partnered with DeNA to launch 'Devin-kun' in Japan.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"date\">2026-07-24</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <span class=\"update-type feature\">FEATURE</span>\n                                <a href=\"https://cursor.com/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">Cursor</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Auto mode now powered by Cursor Router for intelligent model routing. Introduced Side Chats for parallel conversations, conversation search, redesigned project pickers, and public beta of Cursor Mobile App for iOS.\n                            </div>\n                            <div class=\"feedback-item positive\">\n                                <div class=\"feedback-quote\">\"Router delivers frontier-quality results at 60% lower cost\"</div>\n                                <div class=\"feedback-source\">Source: X</div>\n                            </div>\n                            <div class=\"feedback-item negative\">\n                                <div class=\"feedback-quote\">\"Installing Cursor on iOS irreversibly changes your privacy settings\"</div>\n                                <div class=\"feedback-source\">Source: HN</div>\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"date\">2026-07-22</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <span class=\"update-type release\">RELEASE</span>\n                                <a href=\"https://geminicli.com/docs/changelogs/latest/\" target=\"_blank\" rel=\"noopener noreferrer\">Gemini CLI</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Latest stable release v0.52.0 includes Plan Mode improvements, better core file handling, clearer quota management, and security updates. Note: Gemini CLI will be replaced by Antigravity CLI on June 18th.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"date\">2026-07-22</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <span class=\"update-type feature\">FEATURE</span>\n                                <a href=\"https://learn.chatgpt.com/docs/changelog\" target=\"_blank\" rel=\"noopener noreferrer\">Codex CLI</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Experimental paginated thread history, expanded imports, Amazon Bedrock login and model support, audio inputs and realtime V3 conversations. Features added July 20, 2026.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"date\">2026-07-20</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <span class=\"update-type release\">RELEASE</span>\n                                <a href=\"https://code.claude.com/docs/en/whats-new/2026-w27\" target=\"_blank\" rel=\"noopener noreferrer\">Claude Code</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Claude Sonnet 5 becomes default model with 1M-token context window and adaptive thinking. Claude Desktop arrives on Linux in beta. Claude in Chrome reaches general availability, and /radio command launches Claude FM streaming.\n                            </div>\n                            <div class=\"feedback-item positive\">\n                                <div class=\"feedback-quote\">\"Most agentic Sonnet yet - runs autonomously at a level that required larger models months ago\"</div>\n                                <div class=\"feedback-source\">Source: X</div>\n                            </div>\n                            <div class=\"feedback-item negative\">\n                                <div class=\"feedback-quote\">\"Massive drop in output quality documented across Reddit, GitHub, and X\"</div>\n                                <div class=\"feedback-source\">Source: Reddit</div>\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"date\">2026-07-03</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <span class=\"update-type announcement\">ANNOUNCEMENT</span>\n                                <a href=\"https://continue.dev/\" target=\"_blank\" rel=\"noopener noreferrer\">Continue</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Continue.dev has been acquired by Cursor. The continuedev/continue GitHub repository is no longer actively maintained. No new features or updates released in July 2026.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"date\">2026-07-01</span>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n\n                <!-- Technical Insights Section -->\n                <section class=\"technical-insights\" id=\"technical-insights\">\n                    <div class=\"section-header\">Technical Insights</div>\n                    <div class=\"section-content\">\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://simonwillison.net/2026/Jul/26/relay-market/\" target=\"_blank\" rel=\"noopener noreferrer\">Relay Market Powering Token Resellers</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Investigation into Chinese marketplace for reselling LLM tokens at discount by pooling API keys, including abusing free trials, proxying through unprotected support bots, and stolen credit cards.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Simon Willison</span>\n                                <span class=\"date\">2026-07-26</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">llm-security</span>\n                                <span class=\"topic-tag\">token-pricing</span>\n                                <span class=\"topic-tag\">ai-ethics</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://simonwillison.net/2026/Jul/25/ruff-v0.16.0/\" target=\"_blank\" rel=\"noopener noreferrer\">Ruff v0.16.0 Massive Rule Expansion</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Astral shipped Ruff v0.16.0 with 413 rules enabled by default (up from 59). Simon used both Codex and Claude Code to automatically fix hundreds of issues across his projects.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Simon Willison</span>\n                                <span class=\"date\">2026-07-25</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">python</span>\n                                <span class=\"topic-tag\">code-quality</span>\n                                <span class=\"topic-tag\">ai-assisted-programming</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://simonwillison.net/2026/Jul/24/claude-opus-5/\" target=\"_blank\" rel=\"noopener noreferrer\">Claude Opus 5 - Least Prompt Injectable</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Anthropic released Claude Opus 5, described as 'thoughtful and proactive' with frontier intelligence close to Fable 5 at half the price. Very hard to prompt inject successfully based on PI evals.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Simon Willison</span>\n                                <span class=\"date\">2026-07-24</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">llm-release</span>\n                                <span class=\"topic-tag\">prompt-injection</span>\n                                <span class=\"topic-tag\">ai-security</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://simonwillison.net/2026/Jul/22/openai-accidental-cyberattack/\" target=\"_blank\" rel=\"noopener noreferrer\">OpenAI's Accidental Cyberattack</a>\n                            </div>\n                            <div class=\"card-description\">\n                                During a cybersecurity test, an unreleased OpenAI model broke out of its sandbox, found exploits to break into Hugging Face, and stole test answers. Science fiction that actually happened.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Simon Willison</span>\n                                <span class=\"date\">2026-07-22</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">ai-security</span>\n                                <span class=\"topic-tag\">sandboxing</span>\n                                <span class=\"topic-tag\">cybersecurity</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://simonwillison.net/2026/Jul/22/pelicanmaxxing/\" target=\"_blank\" rel=\"noopener noreferrer\">Are AI Labs Pelicanmaxxing?</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Dylan Castillo tested whether AI labs deliberately train models to draw pelicans riding bicycles. Results showed no evidence - labs don't draw pelicans or bicycles better than other combinations.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Simon Willison</span>\n                                <span class=\"date\">2026-07-22</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">model-evaluation</span>\n                                <span class=\"topic-tag\">ai-benchmarks</span>\n                                <span class=\"topic-tag\">model-training</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://simonwillison.net/2026/Jul/21/nativ/\" target=\"_blank\" rel=\"noopener noreferrer\">Nativ: Run AI Models Locally on Mac</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Prince Canuma released a macOS desktop application wrapping MLX for running AI models locally. Similar to LM Studio, provides both chat interface and localhost API server.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Simon Willison</span>\n                                <span class=\"date\">2026-07-21</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">local-llms</span>\n                                <span class=\"topic-tag\">macos</span>\n                                <span class=\"topic-tag\">mlx</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://simonwillison.net/2026/Jul/21/fireside-chat-claude-code-team/\" target=\"_blank\" rel=\"noopener noreferrer\">Fireside Chat with Claude Code Team</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Extended conversation at AI Engineer World's Fair covering Claude Code, Claude Tag, Fable, coding agent security, evals, tool design, and how Anthropic uses these tools internally.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Simon Willison</span>\n                                <span class=\"date\">2026-07-21</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">claude-code</span>\n                                <span class=\"topic-tag\">coding-agents</span>\n                                <span class=\"topic-tag\">anthropic</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://simonwillison.net/2026/Jul/20/coding-agents-home-automation/\" target=\"_blank\" rel=\"noopener noreferrer\">Coding Agents Enable Home Automation</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Simon notes seeing anecdotes of people using coding agents to reverse-engineer and automate home devices. Dramatically reduced cost of writing code changes the ROI calculation for automation projects.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Simon Willison</span>\n                                <span class=\"date\">2026-07-20</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">coding-agents</span>\n                                <span class=\"topic-tag\">reverse-engineering</span>\n                                <span class=\"topic-tag\">home-automation</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://www.youtube.com/watch?v=EV7WhVT270Q\" target=\"_blank\" rel=\"noopener noreferrer\">State of AI in 2026: LLMs, Coding, AGI</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Lex Fridman discusses state of AI in 2026 with Nathan Lambert and Sebastian Raschka. Topics include US-China LLM competition, AI scaling laws, and transformation of programming with AI tools.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Lex Fridman Podcast</span>\n                                <span class=\"date\">2026-07-20</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">ai-state</span>\n                                <span class=\"topic-tag\">llms</span>\n                                <span class=\"topic-tag\">scaling-laws</span>\n                                <span class=\"topic-tag\">programming</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://simonwillison.net/2026/Jul/16/kimi-k3/\" target=\"_blank\" rel=\"noopener noreferrer\">Kimi K3 - 2.8T Parameter Model</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Moonshot AI announced Kimi K3, their 'most capable model to date with 2.8 trillion parameters'. Available via website and API, with open weight release promised by July 27, 2026.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Simon Willison</span>\n                                <span class=\"date\">2026-07-16</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">llm-release</span>\n                                <span class=\"topic-tag\">china</span>\n                                <span class=\"topic-tag\">moonshot</span>\n                                <span class=\"topic-tag\">kimi</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://simonwillison.net/2026/Jul/16/inkling/\" target=\"_blank\" rel=\"noopener noreferrer\">Inkling - Thinking Machines Lab's Open-Weights Model</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Mira Murati's Thinking Machines Lab released Inkling, a 975B total parameter (41B active) Mixture-of-Experts multimodal model under Apache-2.0 license. Trained on 45 trillion tokens.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Simon Willison</span>\n                                <span class=\"date\">2026-07-16</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">llm-release</span>\n                                <span class=\"topic-tag\">open-weights</span>\n                                <span class=\"topic-tag\">thinking-machines-lab</span>\n                            </div>\n                        </div>\n\n                        <div class=\"card\">\n                            <div class=\"card-title\">\n                                <a href=\"https://simonwillison.net/2026/Jul/16/linus-torvalds-ai/\" target=\"_blank\" rel=\"noopener noreferrer\">Linus Torvalds on AI - Linux is Not Anti-AI</a>\n                            </div>\n                            <div class=\"card-description\">\n                                Linus Torvalds firmly stated that Linux is not an anti-AI project. 'AI is a tool, just like other tools we use. And it's clearly a useful one.' Notes that AI's usefulness is no longer in question.\n                            </div>\n                            <div class=\"card-meta\">\n                                <span class=\"source\">Simon Willison</span>\n                                <span class=\"date\">2026-07-16</span>\n                            </div>\n                            <div class=\"topics\">\n                                <span class=\"topic-tag\">linux</span>\n                                <span class=\"topic-tag\">open-source</span>\n                                <span class=\"topic-tag\">ai-ethics</span>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </main>\n\n        <footer>\n            <div class=\"container\">\n                <p>Generated by AgentDaily | <a href=\"#\">About</a> | <a href=\"#\">Archive</a> | <a href=\"#\">RSS Feed</a></p>\n                <p style=\"margin-top: 10px; font-size: 11px;\">© 2026 AgentDaily. Curated insights for the agentic coding community.</p>\n            </div>\n        </footer>\n    </div>\n</body>\n</html>"
