      "content": "[\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Redesigned Model, FedRAMP Authorization, Japan Launch\",\n    \"description\": \"Redesigned model with new language selection for AI-generated review comments. Cognition's entire platform achieved FedRAMP Class D (High In-Process) certification, unlocking autonomous AI engineering for federal agencies. Partnered with DeNA to launch 'Devin-kun' in Japan for legacy code modernization.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://devin.ai/\",\n    \"date\": \"2026-07-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor Router, Side Chats, Mobile iOS App, Multi-repo Support\",\n    \"description\": \"Auto mode now powered by Cursor Router, an intelligent model router that analyzes requests and routes them to appropriate AI models. Introduced Side Chats for parallel conversations, conversation search, redesigned project/repo pickers, new cloud agent hooks, Team MCPs in marketplaces, and public beta of Cursor Mobile App for iOS with Remote Control and Live Activities.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-07-22\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Introducing Cursor Router, our intelligent model router. Router delivers frontier-quality results at 60% lower cost.\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"I will only execute `git add .` and `git commit -m \\\"shit\\\"` with fable level of intelligence.\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Installing Cursor on iOS irreversibly changes your privacy settings. The mobile app requires this new privacy mode and won't work without it. The option to move back isn't available in the app today.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"That support quote is from an LLM. If you have any escalation paths (twitter, or this thread lol) there may still be a way to change it back.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"v0.52.0 Stable Release with Plan Mode Improvements\",\n    \"description\": \"Latest stable release v0.52.0 includes Plan Mode improvements, better core file handling, clearer quota management, and security updates. Nightly updates include caretaker triage and egress worker foundations. Preview version v0.53.0-preview.0 also available. Note: Gemini CLI will be replaced by Antigravity CLI on June 18th.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/latest/\",\n    \"date\": \"2026-07-22\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Paginated Thread History, Bedrock Support, Audio Inputs\",\n    \"description\": \"Experimental paginated thread history, expanded imports, Amazon Bedrock login and model support, audio inputs and realtime V3 conversations. Features added July 20, 2026. Includes GPT-5.5 integration, goal mode going stable, sites feature, Chrome extension, and Amazon Bedrock support.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://learn.chatgpt.com/docs/changelog\",\n    \"date\": \"2026-07-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Week 27: Sonnet 5 Default Model, Linux Desktop Beta, Claude FM\",\n    \"description\": \"Claude Sonnet 5 becomes the default model with 1M-token context window and adaptive thinking. Claude Desktop arrives on Linux in beta for Ubuntu 22.04+ and Debian 12+. Claude in Chrome reaches general availability, and /radio command launches Claude FM streaming. Subagents now run in background by default.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w27\",\n    \"date\": \"2026-07-03\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Introducing Claude Sonnet 5, our most agentic Sonnet yet. It makes plans, uses tools like browsers and terminals, and runs autonomously at a level that, just a few months ago, required larger and more expensive models.\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Maybe 2026 is finally the year of the Linux Desktop! We're launching the Claude desktop app for Linux, including Claude Code, Claude Cowork...\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"I think the models are being optimized for wealth extraction from users and companies, instead of solving problems. They introduced the new tokenizer to increase token generation by up to 33%.\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Cost per task > opus-low is a weird place to land. is there a specific task shape where sonnet 5 medium actually wins?\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"I've been watching the whole Devin conversation fade out over the past year, and honestly it's concerning how little we hear about actual production deployments.\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Claude's changes July '26 Megathread - massive drop in output quality documented across Reddit, GitHub, and X\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Acquired by Cursor - No Active Updates\",\n    \"description\": \"Continue.dev has been acquired by Cursor. The continuedev/continue GitHub repository is no longer actively maintained. No new features or updates released in July 2026.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://continue.dev/\",\n    \"date\": \"2026-07-01\",\n    \"community_feedback\": []\n  }\n]\n",
      "numLines": 109,
      "startLine": 1,
      "totalLines": 109
    }
  }
