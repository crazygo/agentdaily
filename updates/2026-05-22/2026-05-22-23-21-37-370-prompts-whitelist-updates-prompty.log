  "old_string": "[\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.146\",\n    \"description\": \"Renamed /simplify to /code-review with optional effort level, auto mode no longer suppresses AskUserQuestion, fixed Windows PowerShell tool issues, improved auto-updater reliability with network failure retries, and improved diff rendering performance for large files.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-05-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.145\",\n    \"description\": \"Added claude agents --json for scripting, agent_id tracking in OTEL spans, plugin discover screens show commands/agents/skills before installation, and fixed various issues with MCP prompts, spinner freezes, and cross-project resume hints.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-05-19\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.144\",\n    \"description\": \"Added /resume support for background sessions, elapsed duration to subagent completion notifications, and plugin browse panes now show last update time. Fixed startup hanging when api.anthropic.com is unreachable, improved terminal rendering glitches in VS Code, and numerous bug fixes.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-05-19\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.143\",\n    \"description\": \"Added plugin dependency enforcement with disable-chain hints, projected context cost to plugin browse pane, and worktree.bgIsolation setting. PowerShell tool now passes -ExecutionPolicy Bypass on Windows. Fixed multiple issues with background sessions and macOS Full Disk Access.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-05-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.142\",\n    \"description\": \"Added new claude agents flags for configuring dispatched sessions. Fast mode now uses Opus 4.7 by default. Fixed MCP_TOOL_TIMEOUT for remote HTTP/SSE servers, background session worktree recognition, and daemon reconnection after macOS sleep/wake.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-05-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.141\",\n    \"description\": \"Added terminalSequence field to hooks for desktop notifications, CLAUDE_CODE_PLUGIN_PREFER_HTTPS for GitHub plugin cloning, and claude agents --cwd flag. Improved spinner feedback during long thinking periods and plugin menu navigation. Fixed numerous issues with background side-queries, model selection, and permission prompts.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-05-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.140\",\n    \"description\": \"Improved Agent tool subagent_type matching to accept case- and separator-insensitive values, updated agent color palette, and fixed issues with /goal hanging silently and settings hot-reload with symlinked files.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-05-12\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Version 2.1.139\",\n    \"description\": \"Added agent view (Research Preview), /goal command for completion conditions, /scroll-speed command, and claude plugin details. Added transcript view navigation shortcuts. Fixed deadlock with expired credentials and numerous other issues.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/anthropics/claude-code/releases\",\n    \"date\": \"2026-05-11\",\n    \"community_feedback\": []\n  }\n]",
  "new_string": "[\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 2.3.9 - Bug Fixes and Improvements\",\n    \"description\": \"Fixed availability issues with swe-check model for some users, improved terminal processing performance, restored conversation sharing, and repaired path resolution for the Devin local agent on WSL.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-05-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Claude Opus 4.7 (fast mode) Now Available\",\n    \"description\": \"Claude Opus 4.7 (fast mode) is now available in Windsurf, offering the full intelligence of Opus 4.7 but with approximately 2.5x higher output speeds.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-05-12\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot for Eclipse is Open Source\",\n    \"description\": \"GitHub Copilot for Eclipse is now open source, allowing community contributions and transparency.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Semantic Issue Search in Copilot Chat\",\n    \"description\": \"Copilot Chat now supports semantic issue search, enabling more intelligent and context-aware issue searching capabilities.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Gemini 3.5 Flash Generally Available\",\n    \"description\": \"Gemini 3.5 Flash is now generally available for GitHub Copilot, bringing Google's latest AI model to Copilot users.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-19\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Cloud Agent: Fast, Cost-Efficient Models\",\n    \"description\": \"Introduced Copilot cloud agent with fast, cost-efficient models optimized for simple tasks, helping reduce costs for routine operations.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-18\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Ask Questions in Context with Copilot on Web\",\n    \"description\": \"Enhanced Copilot on web to support contextual question asking, improving the web-based AI assistance experience.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-18\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Spaces API Now Generally Available\",\n    \"description\": \"The Copilot Spaces API is now generally available, enabling developers to programmatically manage and interact with Copilot Spaces.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-18\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GPT-5.3-Codex Now Base Model for Copilot Business and Enterprise\",\n    \"description\": \"GPT-5.3-Codex is now the base model for Copilot Business and Enterprise tiers, providing upgraded AI capabilities to business users.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot App Technical Preview\",\n    \"description\": \"GitHub Copilot app is