lor: #fafafa;\n        }\n\n        .update-item:hover {\n            background-color: #fafafa;\n        }\n\n        /* Counter Badges */\n        .counter {\n            display: inline-block;\n            background-color: #ff6600;\n            color: #000000;\n            padding: 2px 6px;\n            font-size: 11px;\n            font-weight: bold;\n            border-radius: 2px;\n            margin-left: 5px;\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <div class=\"container\">\n            <div class=\"header-content\">\n                <a href=\"#\" class=\"logo\">AgentDaily</a>\n                <nav class=\"header-nav\">\n                    <a href=\"#new-products\">New</a>\n                    <a href=\"#updates\">Updates</a>\n                    <a href=\"#insights\">Insights</a>\n                    <a href=\"#about\">About</a>\n                </nav>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"container\">\n        <h1 class=\"page-title\">\n            Agentic Coding Research Report\n            <span class=\"date-badge\">2026-05-22</span>\n        </h1>\n\n        <div class=\"three-column-layout\">\n            <!-- New Products Section -->\n            <section class=\"new-products\" id=\"new-products\">\n                <h2 class=\"section-title\">New Products <span class=\"counter\">3</span></h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://www.producthunt.com/posts/agentrail\" target=\"_blank\" rel=\"noopener\">\n                            AgentRail\n                        </a>\n                        <span class=\"source-badge\">Product Hunt</span>\n                    </div>\n                    <p class=\"item-description\">\n                        A local control plane for AI coding agents. Focuses on routing, supervising, and auditing multi-agent work across repos, CI, and self-hosted environments.\n 