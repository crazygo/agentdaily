  "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Agentic Coding Research Report - 2026-05-22</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: Verdana, Geneva, sans-serif;\n            background-color: #f6f6ef;\n            color: #000000;\n            line-height: 1.4;\n            font-size: 13px;\n        }\n\n        .container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 10px;\n        }\n\n        header {\n            background-color: #ff6600;\n            padding: 5px 10px;\n            margin-bottom: 15px;\n        }\n\n        header h1 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 16px;\n            font-weight: bold;\n            color: #000000;\n        }\n\n        header .date {\n            font-size: 11px;\n            color: #000000;\n            margin-top: 3px;\n        }\n\n        .three-column-layout {\n            display: grid;\n            grid-template-columns: 40% 35% 25%;\n            gap: 15px;\n            margin-bottom: 20px;\n        }\n\n        @media (max-width: 1024px) {\n            .three-column-layout {\n                grid-template-columns: 1fr 1fr;\n            }\n            .technical-insights {\n                grid-column: 1 / -1;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .three-column-layout {\n                grid-template-columns: 1fr;\n            }\n            .technical-insights {\n                grid-column: auto;\n            }\n        }\n\n        section {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            padding: 12px;\n            border-radius: 2px;\n        }\n\n        section h2 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 14px;\n            font-weight: bold;\n            color: #000000;\n            border-bottom: 1px solid #ff6600;\n            padding-bottom: 5px;\n            margin-bottom: 12px;\n        }\n\n        .item {\n            margin-bottom: 15px;\n            padding-bottom: 12px;\n            border-bottom: 1px solid #eeeeee;\n        }\n\n        .item:last-child {\n            margin-bottom: 0;\n            padding-bottom: 0;\n            border-bottom: none;\n        }\n\n        .item-title {\n            font-size: 13px;\n            font-weight: bold;\n            margin-bottom: 4px;\n        }\n\n        .item-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .item-title a:visited {\n            color: #828282;\n        }\n\n        .item-title a:hover {\n            text-decoration: underline;\n        }\n\n        .item-description {\n            color: #828282;\n            font-size: 12px;\n            margin-bottom: 4px;\n            line-height: 1.4;\n        }\n\n        .item-meta {\n            font-size: 11px;\n            color: #828282;\n        }\n\n        .tag {\n            display: inline-block;\n            background-color: #f0f0f0;\n            padding: 2px 6px;\n            margin-right: 4px;\n            margin-top: 4px;\n            border-radius: 2px;\n            font-size: 10px;\n            font-family: Monaco, Consolas, monospace;\n        }\n\n        .source {\n            color: #828282;\n            font-size: 10px;\n        }\n\n        .update-item {\n            margin-bottom: 12px;\n            padding-bottom: 10px;\n            border-bottom: 1px solid #f0f0f0;\n        }\n\n        .update-item:last-child {\n            margin-bottom: 0;\n            padding-bottom: 0;\n            border-bottom: none;\n        }\n\n        .product-name {\n            font-weight: bold;\n            color: #000000;\n            font-size: 12px;\n        }\n\n        .update-title {\n            color: #000000;\n            font-size: 12px;\n            margin: 3px 0;\n        }\n\n        .update-description {\n            color: #828282;\n            font-size: 11px;\n            line-height: 1.4;\n            margin: 3px 0;\n        }\n\n        .update-date {\n            font-size: 10px;\n            color: #999999;\n            font-family: Monaco, Consolas, monospace;\n        }\n\n        .insight-item {\n            margin-bottom: 12px;\n            padding-bottom: 10px;\n            border-bottom: 1px solid #f0f0f0;\n        }\n\n        .insight-item:last-child {\n            margin-bottom: 0;\n            padding-bottom: 0;\n            border-bottom: none;\n        }\n\n        .insight-title {\n            font-weight: bold;\n            color: #000000;\n            font-size: 12px;\n            margin-bottom: 3px;\n        }\n\n        .insight-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .insight-title a:hover {\n            text-decoration: underline;\n        }\n\n        .insight-description {\n            color: #828282;\n            font-size: 11px;\n            line-height: 1.4;\n            margin-bottom: 4px;\n        }\n\n        .insight-meta {\n            font-size: 10px;\n            color: #999999;\n        }\n\n        .insight-author {\n            color: #828282;\n        }\n\n        .insight-topics {\n            margin-top: 4px;\n        }\n\n        footer {\n            text-align: center;\n            padding: 15px 10px;\n            border-top: 1px solid #d4d4d4;\n            background-color: #ffffff;\n            margin-top: 20px;\n        }\n\n        footer a {\n            color: #828282;\n            text-decoration: none;\n            font-size: 11px;\n            margin: 0 10px;\n        }\n\n        footer a:hover {\n            color: #000000;\n        }\n\n        .footer-text {\n            color: #828282;\n            font-size: 11px;\n            margin-top: 10px;\n        }\n\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            .three-column-layout {\n                display: block;\n            }\n\n            section {\n                page-break-inside: avoid;\n                margin-bottom: 20px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Agentic Coding Research Report</h1>\n            <div class=\"date\">2026-05-22 | Daily Updates in AI-Powered Development Tools</div>\n        </header>\n\n        <main class=\"three-column-layout\">\n            <section class=\"new-products\">\n                <h2>New Products (10)</h2>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/posts/testsprite\" target=\"_blank\">TestSprite 3.0</a></div>\n                    <div class=\"item-description\">Let a fleet of parallel agents test your app in minutes. Automated testing using multiple AI agents in parallel.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">code agent</span>\n                        <span class=\"source\">Product Hunt</span>\n                        <span class=\"source\">2026-05-22</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/posts/buildpipe\" target=\"_blank\">buildpipe</a></div>\n                    <div class=\"item-description\">Compose, run and automate multi-step AI developer workflows with GitHub integration.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">workflow agent</span>\n                        <span class=\"source\">Product Hunt</span>\n                        <span class=\"source\">2026-05-22</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/posts/shuffle-design-cli\" target=\"_blank\">Shuffle Design CLI</a></div>\n                    <div class=\"item-description\">Multi-AI CLI for building and redesigning websites from the command line.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI coding CLI</span>\n                        <span class=\"source\">Product Hunt</span>\n                        <span class=\"source\">2026-05-22</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/posts/mintlify-workflows\" target=\"_blank\">Mintlify Workflows</a></div>\n                    <div class=\"item-description\">Self-updating knowledge bases with AI. Automatically maintain documentation using AI agents.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">workflow agent</span>\n                        <span class=\"source\">Product Hunt</span>\n                        <span class=\"source\">2026-05-21</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/posts/google-antigravity\" target=\"_blank\">Google Antigravity 2.0</a></div>\n                    <div class=\"item-description\">Orchestrate multi-agent workflows from a desktop app. Coordinate complex workflows across tools.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">workflow agent</span>\n                        <span class=\"source\">Product Hunt</span>\n                        <span class=\"source\">2026-05-21</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/posts/drizz\" target=\"_blank\">Drizz</a></div>\n                    <div class=\"item-description\">Mobile tests that write, run, and fix themselves. AI-powered automated mobile testing with self-repair.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">code agent</span>\n                        <span class=\"source\">Product Hunt</span>\n                        <span class=\"source\">2026-05-19</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/posts/composer\" target=\"_blank\">Composer 2.5</a></div>\n                    <div class=\"item-description\">Cursor's most powerful model yet. Enhanced AI model for improved coding capabilities in Cursor IDE.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI IDE</span>\n                        <span class=\"source\">Product Hunt</span>\n                        <span class=\"source\">2026-05-19</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/posts/ctrlops\" target=\"_blank\">CtrlOps</a></div>\n                    <div class=\"item-description\">Deploy, Debug & Manage Linux Servers with AI. Infrastructure management and orchestration agent.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">workflow agent</span>\n                        <span class=\"source\">Product Hunt</span>\n                        <span class=\"source\">2026-05-19</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/posts/haystack\" target=\"_blank\">Haystack</a></div>\n                    <div class=\"item-description\">Review the pull requests that actually need human attention. AI-powered code review filtering.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">code agent</span>\n                        <span class=\"source\">Product Hunt</span>\n                        <span class=\"source\">2026-05-19</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/posts/shioricode\" target=\"_blank\">ShioriCode</a></div>\n                    <div class=\"item-description\">Open-source alternative to Codex & Claude Code. Self-hosted AI coding assistant for local development.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI coding CLI</span>\n                        <span class=\"source\">Product Hunt</span>\n                        <span class=\"source\">2026-05-19</span>\n                    </div>\n                </div>\n            </section>\n\n            <section class=\"whitelist-updates\">\n                <h2>Product Updates (18)</h2>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">GitHub Copilot</div>\n                    <div class=\"update-title\">GitHub Copilot for Eclipse is Open Source</div>\n                    <div class=\"update-description\">GitHub Copilot for Eclipse is now open source, allowing community contributions and transparency.</div>\n                    <div class=\"update-date\">2026-05-21</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Cursor</div>\n                    <div class=\"update-title\">Improvements to Cursor Automations</div>\n                    <div class=\"update-description\">Cursor Automations brought to Agents Window with multi-repo support, five new templates including Slack digest and product analytics agents, plus Composer 2.5 intelligence improvements.</div>\n                    <div class=\"update-date\">2026-05-21</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Claude Code</div>\n                    <div class=\"update-title\">Version 2.1.146</div>\n                    <div class=\"update-description\">Renamed /simplify to /code-review with optional effort level, auto mode no longer suppresses AskUserQuestion, fixed Windows PowerShell issues, improved auto-updater reliability, and enhanced diff rendering performance.</div>\n                    <div class=\"update-date\">2026-05-21</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">GitHub Copilot</div>\n                    <div class=\"update-title\">Semantic Issue Search in Copilot Chat</div>\n                    <div class=\"update-description\">Copilot Chat now supports semantic issue search, enabling more intelligent and context-aware issue searching capabilities.</div>\n                    <div class=\"update-date\">2026-05-20</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">GitHub Copilot</div>\n                    <div class=\"update-title\">Gemini 3.5 Flash Generally Available</div>\n                    <div class=\"update-description\">Gemini 3.5 Flash is now generally available for GitHub Copilot, bringing Google's latest AI model to Copilot users.</div>\n                    <div class=\"update-date\">2026-05-19</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Claude Code</div>\n                    <div class=\"update-title\">Version 2.1.145</div>\n                    <div class=\"update-description\">Added claude agents --json for scripting, agent_id tracking in OTEL spans, plugin discover screens show commands/agents/skills before installation. Fixed MCP prompts, spinner freezes, and cross-project resume hints.</div>\n                    <div class=\"update-date\">2026-05-19</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Claude Code</div>\n                    <div class=\"update-title\">Version 2.1.144</div>\n                    <div class=\"update-description\">Added /resume support for background sessions, elapsed duration to subagent completion notifications, and plugin browse panes now show last update time. Fixed startup hanging and improved terminal rendering.</div>\n                    <div class=\"update-date\">2026-05-19</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">GitHub Copilot</div>\n                    <div class=\"update-title\">Copilot Cloud Agent: Fast, Cost-Efficient Models</div>\n                    <div class=\"update-description\">Introduced Copilot cloud agent with fast, cost-efficient models optimized for simple tasks, helping reduce costs for routine operations.</div>\n                    <div class=\"update-date\">2026-05-18</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">GitHub Copilot</div>\n                    <div class=\"update-title\">Ask Questions in Context with Copilot on Web</div>\n                    <div class=\"update-description\">Enhanced Copilot on web to support contextual question asking, improving the web-based AI assistance experience.</div>\n                    <div class=\"update-date\">2026-05-18</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">GitHub Copilot</div>\n                    <div class=\"update-title\">Copilot Spaces API Now Generally Available</div>\n                    <div class=\"update-description\">The Copilot Spaces API is now generally available, enabling developers to programmatically manage and interact with Copilot Spaces.</div>\n                    <div class=\"update-date\">2026-05-18</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Windsurf</div>\n                    <div class=\"update-title\">Version 2.3.9 - Bug Fixes and Improvements</div>\n                    <div class=\"update-description\">Fixed swe-check model availability, improved terminal processing performance, restored conversation sharing, and repaired path resolution for Devin local agent on WSL.</div>\n                    <div class=\"update-date\">2026-05-17</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">GitHub Copilot</div>\n                    <div class=\"update-title\">GPT-5.3-Codex Now Base Model for Business and Enterprise</div>\n                    <div class=\"update-description\">GPT-5.3-Codex is now the base model for Copilot Business and Enterprise tiers, providing upgraded AI capabilities to business users.</div>\n                    <div class=\"update-date\">2026-05-17</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Aider</div>\n                    <div class=\"update-title\">Version 0.86.0 - GPT-5 and Grok-4 Support</div>\n                    <div class=\"update-description\">Added support for all GPT-5 models and Grok-4. Enhanced /clear and /undo commands, added support for gemini-2.5-flash-lite-preview-06-17 and kimi-k2 models.</div>\n                    <div class=\"update-date\">2026-05-17</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Claude Code</div>\n                    <div class=\"update-title\">Version 2.1.143</div>\n                    <div class=\"update-description\">Added plugin dependency enforcement, projected context cost to plugin browse pane, and worktree.bgIsolation setting. PowerShell tool now passes -ExecutionPolicy Bypass on Windows.</div>\n                    <div class=\"update-date\">2026-05-15</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">GitHub Copilot</div>\n                    <div class=\"update-title\">GitHub Copilot App Technical Preview</div>\n                    <div class=\"update-description\">GitHub Copilot app is now available in technical preview, offering a new way to interact with Copilot capabilities.</div>\n                    <div class=\"update-date\">2026-05-14</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Claude Code</div>\n                    <div class=\"update-title\">Version 2.1.142</div>\n                    <div class=\"update-description\">Added new claude agents flags for configuring dispatched sessions. Fast mode now uses Opus 4.7 by default. Fixed MCP_TOOL_TIMEOUT and background session issues.</div>\n                    <div class=\"update-date\">2026-05-14</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Claude Code</div>\n                    <div class=\"update-title\">Version 2.1.141</div>\n                    <div class=\"update-description\">Added terminalSequence field to hooks, CLAUDE_CODE_PLUGIN_PREFER_HTTPS, and claude agents --cwd flag. Improved spinner feedback and plugin menu navigation.</div>\n                    <div class=\"update-date\">2026-05-13</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Claude Code</div>\n                    <div class=\"update-title\">Version 2.1.140</div>\n                    <div class=\"update-description\">Improved Agent tool subagent_type matching, updated agent color palette, and fixed issues with /goal hanging silently and settings hot-reload with symlinked files.</div>\n                    <div class=\"update-date\">2026-05-12</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Claude Code</div>\n                    <div class=\"update-title\">Version 2.1.139</div>\n                    <div class=\"update-description\">Added agent view (Research Preview), /goal command for completion conditions, /scroll-speed command, and claude plugin details. Fixed deadlock with expired credentials.</div>\n                    <div class=\"update-date\">2026-05-11</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"product-name\">Windsurf</div>\n                    <div class=\"update-title\">Claude Opus 4.7 (fast mode) Now Available</div>\n                    <div class=\"update-description\">Claude Opus 4.7 (fast mode) is now available in Windsurf, offering full intelligence with approximately 2.5x higher output speeds.</div>\n                    <div class=\"update-date\">2026-05-12</div>\n                </div>\n            </section>\n\n            <section class=\"technical-insights\">\n                <h2>Technical Insights (12)</h2>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://news.ycombinator.com/item?id=40894321\" target=\"_blank\">Runtime - Sandboxed Coding Agents</a></div>\n                    <div class=\"insight-description\">Launch HN: Runtime (YC P26) - Sandboxed coding agents for everyone on a team. Discussion focuses on team-based AI coding assistants.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"insight-author\">Hacker News</span> • 2026-05-22\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">coding agents</span>\n                        <span class=\"tag\">YC</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://news.ycombinator.com/item?id=40894187\" target=\"_blank\">Google's Antigravity Bait and Switch</a></div>\n                    <div class=\"insight-description\">Discussion with 654 points about Google's transition from open source Gemini CLI to closed source Antigravity CLI.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"insight-author\">Hacker News</span> • 2026-05-22\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">Google</span>\n                        <span class=\"tag\">open source</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/May/22/ftc-cox-media/\" target=\"_blank\">FTC Settles with Cox Media Group</a></div>\n                    <div class=\"insight-description\">FTC requires Cox Media Group to pay nearly $1M to settle charges about deceptive 'Active Listening' AI marketing claims. Service didn't actually listen to conversations.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"insight-author\">Simon Willison</span> • 2026-05-22\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">privacy</span>\n                        <span class=\"tag\">AI ethics</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://news.ycombinator.com/item?id=40893897\" target=\"_blank\">Multi-Stream LLMs Research</a></div>\n                    <div class=\"insight-description\">New arXiv paper on Multi-Stream LLMs exploring parallelizing prompts, thinking, and I/O operations for improved performance.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"insight-author\">Hacker News</span> • 2026-05-22\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">LLM</span>\n                        <span class=\"tag\">research</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://news.ycombinator.com/item?id=40894125\" target=\"_blank\">KVBoost - KV Cache Reuse</a></div>\n                    <div class=\"insight-description\">Release of KVBoost for HuggingFace models, achieving 5-48x faster Time To First Token (TTFT) through chunk-level KV cache reuse.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"insight-author\">Hacker News</span> • 2026-05-22\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">LLM</span>\n                        <span class=\"tag\">optimization</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://arxiv.org/abs/2605.08871\" target=\"_blank\">CODA: Transformer Block Optimization</a></div>\n                    <div class=\"insight-description\">arXiv paper about rewriting transformer blocks as GEMM-epilogue programs for systems-level optimization.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"insight-author\">Hacker News</span> • 2026-05-22\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">transformers</span>\n                        <span class=\"tag\">optimization</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/May/21/datasette-agent/\" target=\"_blank\">Datasette Agent Release</a></div>\n                    <div class=\"insight-description\">First release of Datasette Agent, an extensible AI assistant integrating 3 years of LLM Python library development with Datasette.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"insight-author\">Simon Willison</span> • 2026-05-21\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">AI</span>\n                        <span class=\"tag\">Python</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/May/20/anthropic-spacex/\" target=\"_blank\">Anthropic-SpaceX Compute Deal</a></div>\n                    <div class=\"insight-description\">SpaceX S-1 filing reveals $1.25B/month compute deal between Anthropic and SpaceX through May 2029 for COLOSSUS access.</div>\n                    <div class=\"insight-meta\">\n                        <span class=\"insight-author\">Simon Willison</span> • 2026-05-20\n                    </div>\n                    <div class=\"insight-topics\">\n                        <span class=\"tag\">AI</span>\n                        <span class=\"tag\">infrastructure</span>\n                    </div>\n                </div>\n\n                <div class=\"insight-item\">\n 