    "originalFile": "[\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot for Eclipse Open Source\",\n    \"description\": \"GitHub Copilot for Eclipse is now open source, making the codebase available for community contribution and transparency.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Semantic Issue Search in Copilot Chat\",\n    \"description\": \"GitHub released semantic issue search functionality in Copilot Chat, enabling more intelligent code issue discovery and resolution.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Auto Model Selection Based on Task in VS Code\",\n    \"description\": \"Copilot now automatically routes to appropriate models based on the specific task being performed in VS Code, improving efficiency and accuracy.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Gemini 3.5 Flash Generally Available\",\n    \"description\": \"Google's Gemini 3.5 Flash model is now generally available for GitHub Copilot users, providing faster AI assistance.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-19\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GPT-5.3-Codex Base Model for Business and Enterprise\",\n    \"description\": \"GPT-5.3-Codex is now the base model for Copilot Business and Enterprise tiers, offering improved coding capabilities.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Team-level Usage Metrics via API\",\n    \"description\": \"Team-level Copilot usage metrics are now available via API, giving organizations better visibility into AI adoption and spending.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot App Technical Preview\",\n    \"description\": \"GitHub released a new Copilot app in technical preview, expanding Copilot's accessibility and integration options.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Platform Default Settings and Slack Improvements\",\n    \"description\": \"Devin added platform default settings (Linux/Windows) for sessions, Slack channel override functionality, and MCP OAuth resource parameter support for better authentication.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-05-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"GitLab Interactive PR Review\",\n    \"description\": \"GitLab repositories now support interactive PR review in Devin, with the ability to post review comments and resolve threads when read-write GitLab connection is enabled.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-05-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Deprecation Notice - Transitioning to Antigravity CLI\",\n    \"description\": \"Google announced Gemini CLI and Gemini Code Assist IDE extensions will stop serving requests on June 18, 2026, transitioning users to Antigravity CLI.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://developers.googleblog.com/an-important-update-transitioning-gemini-cli-to-antigravity-cli/\",\n    \"date\": \"2026-05-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"May 2026 Update - Command Line and UI Improvements\",\n    \"description\": \"Gemini CLI shipped a broad update in May 2026 with command line improvements, core and UI improvements, new session deletion options, commands listing options, and voice mode upgrades.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://releasebot.io/updates/google/gemini-cli\",\n    \"date\": \"2026-05-08\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Background Agents in Slack Integration\",\n    \"description\": \"Cursor now supports launching Background Agents directly from Slack by mentioning @Cursor. Agents can read threads, understand context, and create PRs in GitHub without leaving Slack conversations.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-05-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"BugBot Automatic Code Review\",\n    \"description\": \"Cursor 1.0 introduced BugBot for automatic code review that catches potential bugs and issues in PRs, leaving comments directly on GitHub with 'Fix in Cursor' integration.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-05-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Background Agent General Availability\",\n    \"description\": \"Cursor's remote coding agent (Background Agent) is now available to all users, allowing parallel task execution with cloud icon in chat or Cmd/Ctrl+E shortcut.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-05-08\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Memories Feature Beta\",\n    \"description\": \"Cursor introduced Memories beta feature that allows the AI to remember facts from conversations and reference them in future sessions, stored per project at individual level.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-05-05\",\n    \"community_feedback\": []\n  }\n]",
