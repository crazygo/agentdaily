    "originalFile": "[\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Bug Fixes and Improvements (v2.3.9)\",\n    \"description\": \"Fixed availability issues with swe-check model for some users, improved terminal processing performance, restored conversation sharing, and repaired path resolution for the Devin local agent on WSL.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-05-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Claude Opus 4.7 (fast mode)\",\n    \"description\": \"Claude Opus 4.7 (fast mode) is now available in Windsurf, with full intelligence of Opus 4.7 but ~2.5x higher output speeds.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-05-12\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Devin Review & Quick Review\",\n    \"description\": \"All Windsurf IDE users now have access to Devin Review and Quick Review with existing subscription. Devin Review is available for all self-serve users with a 2 week free trial.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Agent View Feature (v2.1.139–v2.1.142)\",\n    \"description\": \"Week 20 (May 11–15, 2026): Introduced Agent view with `claude agents` command that opens one screen for every Claude Code session, showing what's running, what's blocked, and what's done.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-05-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Goal Command and Fast Mode (v2.1.128–v2.1.136)\",\n    \"description\": \"Week 19 (May 4–8, 2026): Introduced `/goal` command that keeps Claude working across turns until completion condition holds. Fast mode now runs on Opus 4.7 by default. Rewind menu can compress earlier context.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-05-08\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot for Eclipse Open Source\",\n    \"description\": \"GitHub Copilot for Eclipse is now open source, making the codebase available for community contribution and transparency.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Semantic Issue Search in Copilot Chat\",\n    \"description\": \"GitHub released semantic issue search functionality in Copilot Chat, enabling more intelligent code issue discovery and resolution.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Auto Model Selection Based on Task in VS Code\",\n    \"description\": \"Copilot now automatically routes to appropriate models based on the specific task being performed in VS Code, improving efficiency and accuracy.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Gemini 3.5 Flash Generally Available\",\n    \"description\": \"Google's Gemini 3.5 Flash model is now generally available for GitHub Copilot users, providing faster AI assistance.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-19\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GPT-5.3-Codex Base Model for Business and Enterprise\",\n    \"description\": \"GPT-5.3-Codex is now the base model for Copilot Business and Enterprise tiers, offering improved coding capabilities.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Team-level Usage Metrics via API\",\n    \"description\": \"Team-level Copilot usage metrics are now available via API, giving organizations better visibility into AI adoption and spending.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot App Technical Preview\",\n    \"description\": \"GitHub released a new Copilot app in technical preview, expanding Copilot's accessibility and integration options.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Platform Default Settings and Slack Improvements\",\n    \"description\": \"Devin added platform default settings (Linux/Windows) for sessions, Slack channel override functionality, and MCP OAuth resource parameter support for better authentication.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-05-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"GitLab Interactive PR Review\",\n    \"description\": \"GitLab repositories now support interactive PR review in Devin, with the ability to post review comments and resolve threads when read-write GitLab connection is enabled.\",\n    \"upd