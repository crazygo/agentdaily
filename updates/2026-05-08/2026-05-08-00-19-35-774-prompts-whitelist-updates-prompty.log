  "content": "[\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Week 17 Update: /ultrareview Research Preview\",\n    \"description\": \"Claude Code v2.1.114–v2.1.119 released with /ultrareview research preview (cloud-based multi-agent code review), automatic session recaps, custom color themes, redesigned web experience, vim visual mode, native macOS/Linux builds with embedded bfs/ugrep, and /usage command (merged /cost and /stats).\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w17\",\n    \"date\": \"2026-04-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor SDK Public Beta\",\n    \"description\": \"Cursor SDK launched in public beta, allowing developers to build programmatic agents using TypeScript. SDK uses the same runtime, harness, and models as Cursor, with support for local or cloud execution. Standard token usage pricing applies.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-29\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Multi-tasking, Worktrees, and Multi-root Workspaces\",\n    \"description\": \"Version 3.2 added /multitask for parallel async sub-agents, improved worktrees experience for background isolated tasks, and multi-root workspaces for cross-repository modifications without re-targeting.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Canvas Feature\",\n    \"description\": \"Cursor 3.1 added interactive canvas feature for visual dashboards and custom interfaces with tables, boxes, diagrams, charts, plus existing components like diff views and todo lists. Canvases persist in the agent window sidebar.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor 3.0 Major Release\",\n    \"description\": \"Cursor 3.0 launched as a unified workspace for building software with agents. Features include multi-repository layout, seamless handoff between local and cloud agents, centralized agent management, parallel execution support, and new interface built from scratch around agent workflows.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.com/blog/cursor-3\",\n    \"date\": \"2026-04-02\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Visual Studio April Update: Agentic Workflows\",\n    \"description\": \"April 2026 Visual Studio update centers on agentic workflows with cloud agent sessions that launch directly from the IDE, plus enhanced custom agents capabilities.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-04-30-github-copilot-in-visual-studio-april-update/\",\n    \"date\": \"2026-04-30\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Code Review Billing Changes (Starting June 1)\",\n    \"description\": \"GitHub announced that starting June 1, 2026, Copilot code review will consume GitHub Actions minutes. All Copilot usage including code reviews will be billed as AI usage.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/2026-04-27-github-copilot-code-review-will-start-consuming-github-actions-minutes-on-june-1-2026/\",\n    \"date\": \"2026-04-27\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Windsurf 2.0 with Agent Command Center\",\n    \"description\": \"Major update introducing Agent Command Center showing all agents in unified Kanban-style view, Devin integration as built-in autonomous cloud agent, and new Spaces feature for shared context management.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://windsurf.com/blog/windsurf-2-0\",\n    \"date\": \"2026-05-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Claude Opus 4.7 Available\",\n    \"description\": \"Claude Opus 4.7 model made available in Windsurf IDE as part of April 2026 updates.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  }\n]"
}

