  \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor 3.0 Major Release\",\n    \"description\": \"Cursor 3.0 launched as a unified workspace for building software with agents. Features include multi-repository layout, seamless handoff between local and cloud agents, centralized agent management, parallel execution support, and new interface built from scratch around agent workflows.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.com/blog/cursor-3\",\n    \"date\": \"2026-04-02\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Visual Studio April Update: Agentic Workflows\",\n    \"description\": \"April 2026 Visual Studio update centers on agentic workflows with cloud agent sessions that launch directly from the IDE, plus enhanced custom agents capabilities.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-04-30-github-copilot-in-visual-studio-april-update/\",\n    \"date\": \"2026-04-30\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Code Review Billing Changes (Starting June 1)\",\n    \"description\": \"GitHub announced that starting June 1, 2026, Copilot code review will consume GitHub Actions minutes. All Copilot usage including code reviews will be billed as AI usage.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/2026-04-27-github-copilot-code-review-will-start-consuming-github-actions-minutes-on-june-1-2026/\",\n    \"date\": \"2026-04-27\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Windsurf 2.0 with Agent Command Center\",\n    \"description\": \"Major update introducing Agent Command Center showing all agents in unified Kanban-style view, Devin integration as built-in 