    "originalFile": "[\n  {\n    \"name\": \"Aura\",\n    \"url\": \"https://www.producthunt.com/products/aura\",\n    \"description\": \"Open Source OSS IDE for controlling AI coding agents with built-in loops. Provides Agents + Git + Intent workflow for managing coding agents.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Termi Protocol\",\n    \"url\": \"https://www.producthunt.com/products/termi-protocol\",\n    \"description\": \"3D simulation environment for visualizing AI agent workflows. Gives coding agents a face, desk, and living room for monitoring agent activity.\",\n    \"release_date\": \"2026-07-04\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"agents-cli\",\n    \"url\": \"https://www.producthunt.com/products/agents-cli\",\n    \"description\": \"The CLI your coding agent uses to ship agents. Google's open-source command-line interface for creating AI agents from scaffolding to production deployment.\",\n    \"release_date\": \"2026-07-08\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Android CLI\",\n    \"url\": \"https://www.producthunt.com/products/android-cli\",\n    \"description\": \"Agent-first toolkit for building Android apps directly from the terminal. Enables AI agents to create, build, and manage Android projects 3x faster with less guesswork.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Brickken CLI\",\n    \"url\": \"https://www.brickken.com/post/brickken-cli-agentic\",\n    \"description\": \"Terminal tool that enables AI agents to run on-chain blockchain workflows autonomously. Agents can register identities, pay via x402 in USDC, and deploy ERC-20 tokens directly from CLI.\",\n    \"release_date\": \"2026-07-07\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Brickken\", \"OurCryptoTalk\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Grok Build\",\n    \"url\": \"https://x.ai/news/grok-build-open-source\",\n    \"description\": \"xAI's terminal-based AI coding agent CLI, open-sourced under Apache 2.0. Features 8 parallel subagents, plan-first workflow, Arena Mode, MCP support, and TUI interface written in Rust.\",\n    \"release_date\": \"2026-07-14\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"xAI News\", \"GitHub\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Zro\",\n    \"url\": \"https://www.producthunt.com/leaderboard/daily/2026/7/16\",\n    \"description\": \"Private inference for coding agents. Ranked #2 on Product Hunt July 16, 2026. Addresses privacy and security concerns in AI-powered coding workflows.\",\n    \"release_date\": \"2026-07-16\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"TryCase\",\n    \"url\": \"https://www.producthunt.com/products/trycase\",\n    \"description\": \"Disposable Linux test environments for AI coding agents. Enables agents to run applications, test changes end-to-end, capture screenshots/recordings, and return verified code safely.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"AI testing\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Perfai Security\",\n    \"url\": \"https://www.producthunt.com/leaderboard/daily/2026/7/9\",\n    \"description\": \"Autonomous security platform for AI-built apps (vibe-coded). Finds and fixes live vulnerabilities with a single prompt. Ranked #3 on Product Hunt July 9, 2026.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"AI security\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Constellation Gate\",\n    \"url\": \"https://www.producthunt.com/products/constellation-gate-ai\",\n    \"description\": \"Security and audit gateway for AI applications with prompt injection defense (97.4% F1), token savings (20-40%), and on-chain audit trails. Ranked #1 in security benchmarks.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"AI security\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Coasty\",\n    \"url\": \"https://www.producthunt.com/products/coasty\",\n    \"description\": \"Computer-Use-Agent that runs legacy software like a human. Enables AI agents to interact with legacy applications via secure cloud VMs without modernization.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"AI automation\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Compendium\",\n    \"url\": \"https://www.producthunt.com/products/compendium-2\",\n    \"description\": \"Company brain for teams working with AI agents. Centralized knowledge management where all agents share memory, knowledge, and context. Ranked #16 on Product Hunt July 8, 2026.\",\n    \"release_date\": \"2026-07-08\",\n    \"category\": \"AI knowledge management\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  }\n]\n"
  }
