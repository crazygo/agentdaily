    "originalFile": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Agentic Coding Research Report - 2026-07-23</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: Verdana, Geneva, sans-serif;\n            background-color: #f6f6ef;\n            color: #000000;\n            line-height: 1.4;\n            font-size: 13px;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 10px;\n        }\n\n        header {\n            background-color: #ff6600;\n            padding: 8px 10px;\n            border-bottom: 1px solid #d4d4d4;\n        }\n\n        header h1 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 16px;\n            font-weight: bold;\n            color: #000000;\n        }\n\n        header .date {\n            font-size: 12px;\n            color: #000000;\n            margin-top: 4px;\n        }\n\n        nav {\n            background-color: #f6f6ef;\n            padding: 10px;\n            border-bottom: 1px solid #d4d4d4;\n        }\n\n        nav a {\n            color: #000000;\n            text-decoration: none;\n            margin-right: 15px;\n            font-size: 12px;\n        }\n\n        nav a:hover {\n            text-decoration: underline;\n        }\n\n        .three-column-layout {\n            display: grid;\n            grid-template-columns: 40% 35% 25%;\n            gap: 10px;\n            padding: 15px 10px;\n        }\n\n        @media (max-width: 900px) {\n            .three-column-layout {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        section {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            border-radius: 2px;\n            padding: 12px;\n        }\n\n        section h2 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 14px;\n            font-weight: bold;\n            color: #000000;\n            margin-bottom: 12px;\n            padding-bottom: 8px;\n            border-bottom: 2px solid #ff6600;\n        }\n\n        .item {\n            margin-bottom: 12px;\n            padding-bottom: 12px;\n            border-bottom: 1px solid #eeeeee;\n        }\n\n        .item:last-child {\n            margin-bottom: 0;\n            padding-bottom: 0;\n            border-bottom: none;\n        }\n\n        .item-title {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 13px;\n            font-weight: bold;\n            margin-bottom: 4px;\n        }\n\n        .item-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .item-title a:hover {\n            text-decoration: underline;\n        }\n\n        .item-title a:visited {\n            color: #828282;\n        }\n\n        .item-description {\n            font-size: 12px;\n            color: #000000;\n            margin-bottom: 4px;\n            line-height: 1.4;\n        }\n\n        .item-meta {\n            font-size: 11px;\n            color: #828282;\n        }\n\n        .item-meta a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        .item-meta a:hover {\n            text-decoration: underline;\n        }\n\n        .tag {\n            display: inline-block;\n            background-color: #eeeeee;\n            color: #000000;\n            padding: 2px 6px;\n            font-size: 10px;\n            border-radius: 2px;\n            margin-right: 4px;\n            margin-bottom: 4px;\n        }\n\n        .source-badge {\n            display: inline-block;\n            background-color: #ff6600;\n            color: #000000;\n            padding: 1px 4px;\n            font-size: 10px;\n            border-radius: 2px;\n            font-weight: bold;\n        }\n\n        .author {\n            color: #828282;\n            font-size: 11px;\n            margin-bottom: 2px;\n        }\n\n        .published-date {\n            color: #828282;\n            font-size: 11px;\n        }\n\n        .type-badge {\n            display: inline-block;\n            padding: 2px 6px;\n            font-size: 10px;\n            border-radius: 2px;\n            margin-right: 4px;\n            font-weight: bold;\n        }\n\n        .type-opinion {\n            background-color: #fff3cd;\n            color: #856404;\n        }\n\n        .type-discussion {\n            background-color: #d1ecf1;\n            color: #0c5460;\n        }\n\n        .type-technical {\n            background-color: #d4edda;\n            color: #155724;\n        }\n\n        .type-tool {\n            background-color: #e2e3e5;\n            color: #383d41;\n        }\n\n        footer {\n            background-color: #f6f6ef;\n            padding: 15px 10px;\n            border-top: 1px solid #d4d4d4;\n            text-align: center;\n            color: #828282;\n            font-size: 11px;\n        }\n\n        footer a {\n            color: #828282;\n            text-decoration: none;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n        }\n\n        .empty-section {\n            color: #828282;\n            font-style: italic;\n            padding: 20px;\n            text-align: center;\n        }\n\n        .count-badge {\n            display: inline-block;\n            background-color: #ff6600;\n            color: #000000;\n            padding: 2px 6px;\n            font-size: 11px;\n            border-radius: 2px;\n            margin-left: 8px;\n            font-weight: bold;\n        }\n\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            section {\n                page-break-inside: avoid;\n            }\n\n            .three-column-layout {\n                display: block;\n            }\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <div class=\"container\">\n            <h1>Agentic Coding Research Report</h1>\n            <div class=\"date\">July 23, 2026</div>\n        </div>\n    </header>\n\n    <nav>\n        <div class=\"container\">\n            <a href=\"#new-products\">New Products</a>\n            <a href=\"#whitelist-updates\">Whitelist Updates</a>\n            <a href=\"#technical-insights\">Technical Insights</a>\n        </div>\n    </nav>\n\n    <main class=\"three-column-layout\">\n        <!-- New Products Section -->\n        <section class=\"new-products\" id=\"new-products\">\n            <h2>New Products <span class=\"count-badge\">12</span></h2>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://www.producthunt.com/leaderboard/daily/2026/7/16\">Zro</a>\n                </div>\n                <div class=\"item-description\">\n                    Private inference for coding agents. Addresses privacy and security concerns in AI-powered coding workflows.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"source-badge\">#2 Product Hunt</span>\n                    <span class=\"tag\">AI coding CLI</span>\n                    <span class=\"tag\">2026-07-16</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://x.ai/news/grok-build-open-source\">Grok Build</a>\n                </div>\n                <div class=\"item-description\">\n                    xAI's terminal-based AI coding agent CLI, open-sourced under Apache 2.0. Features 8 parallel subagents, plan-first workflow, Arena Mode, MCP support, and TUI interface written in Rust.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"source-badge\">Open Source</span>\n                    <span class=\"tag\">AI coding CLI</span>\n                    <span class=\"tag\">Rust</span>\n                    <span class=\"tag\">2026-07-14</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://www.producthunt.com/products/aura\">Aura</a>\n                </div>\n                <div class=\"item-description\">\n                    Open Source OSS IDE for controlling AI coding agents with built-in loops. Provides Agents + Git + Intent workflow for managing coding agents.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"tag\">AI IDE</span>\n                    <span class=\"tag\">Open Source</span>\n                    <span class=\"tag\">2026-07-09</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://www.producthunt.com/products/android-cli\">Android CLI</a>\n                </div>\n                <div class=\"item-description\">\n                    Agent-first toolkit for building Android apps directly from the terminal. Enables AI agents to create, build, and manage Android projects 3x faster with less guesswork.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"tag\">AI coding CLI</span>\n                    <span class=\"tag\">Android</span>\n                    <span class=\"tag\">2026-07-09</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://www.producthunt.com/products/trycase\">TryCase</a>\n                </div>\n                <div class=\"item-description\">\n                    Disposable Linux test environments for AI coding agents. Enables agents to run applications, test changes end-to-end, capture screenshots/recordings, and return verified code safely.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"tag\">AI testing</span>\n                    <span class=\"tag\">Linux</span>\n                    <span class=\"tag\">2026-07-09</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://www.producthunt.com/leaderboard/daily/2026/7/9\">Perfai Security</a>\n                </div>\n                <div class=\"item-description\">\n                    Autonomous security platform for AI-built apps (vibe-coded). Finds and fixes live vulnerabilities with a single prompt.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"source-badge\">#3 Product Hunt</span>\n                    <span class=\"tag\">AI security</span>\n                    <span class=\"tag\">2026-07-09</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://www.producthunt.com/products/constellation-gate-ai\">Constellation Gate</a>\n                </div>\n                <div class=\"item-description\">\n                    Security and audit gateway for AI applications with prompt injection defense (97.4% F1), token savings (20-40%), and on-chain audit trails.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"source-badge\">#1 Security</span>\n                    <span class=\"tag\">AI security</span>\n                    <span class=\"tag\">2026-07-09</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://www.producthunt.com/products/coasty\">Coasty</a>\n                </div>\n                <div class=\"item-description\">\n                    Computer-Use-Agent that runs legacy software like a human. Enables AI agents to interact with legacy applications via secure cloud VMs without modernization.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"tag\">AI automation</span>\n                    <span class=\"tag\">Legacy software</span>\n                    <span class=\"tag\">2026-07-09</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://www.producthunt.com/products/compendium-2\">Compendium</a>\n                </div>\n                <div class=\"item-description\">\n                    Company brain for teams working with AI agents. Centralized knowledge management where all agents share memory, knowledge, and context.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"source-badge\">#16 Product Hunt</span>\n                    <span class=\"tag\">AI knowledge management</span>\n                    <span class=\"tag\">2026-07-08</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://www.producthunt.com/products/agents-cli\">agents-cli</a>\n                </div>\n                <div class=\"item-description\">\n                    The CLI your coding agent uses to ship agents. Google's open-source command-line interface for creating AI agents from scaffolding to production deployment.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"source-badge\">Google</span>\n                    <span class=\"tag\">AI coding CLI</span>\n                    <span class=\"tag\">Open Source</span>\n                    <span class=\"tag\">2026-07-08</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://www.brickken.com/post/brickken-cli-agentic\">Brickken CLI</a>\n                </div>\n                <div class=\"item-description\">\n                    Terminal tool that enables AI agents to run on-chain blockchain workflows autonomously. Agents can register identities, pay via x402 in USDC, and deploy ERC-20 tokens directly from CLI.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"tag\">AI coding CLI</span>\n                    <span class=\"tag\">Blockchain</span>\n                    <span class=\"tag\">2026-07-07</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://www.producthunt.com/products/termi-protocol\">Termi Protocol</a>\n                </div>\n                <div class=\"item-description\">\n                    3D simulation environment for visualizing AI agent workflows. Gives coding agents a face, desk, and living room for monitoring agent activity.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"tag\">AI IDE</span>\n                    <span class=\"tag\">3D visualization</span>\n                    <span class=\"tag\">2026-07-04</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- Whitelist Updates Section -->\n        <section class=\"whitelist-updates\" id=\"whitelist-updates\">\n            <h2>Whitelist Updates <span class=\"count-badge\">0</span></h2>\n            <div class=\"empty-section\">\n                No whitelist updates to display for this period.\n            </div>\n        </section>\n\n        <!-- Technical Insights Section -->\n        <section class=\"technical-insights\" id=\"technical-insights\">\n            <h2>Technical Insights <span class=\"count-badge\">14</span></h2>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">Coding agents changing the economics of reverse-engineering home devices</a>\n                </div>\n                <div class=\"author\">Simon Willison</div>\n                <div class=\"item-description\">\n                    People are using coding agents to reverse-engineer and automate home devices. The reduced cost of writing code has changed the ROI equation.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-opinion\">Opinion</span>\n                    <span class=\"published-date\">2026-07-20</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">coding-agents</span>\n                    <span class=\"tag\">reverse-engineering</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">Who's Afraid of Chinese Models?</a>\n                </div>\n                <div class=\"author\">Simon Willison (citing Ben Thompson)</div>\n                <div class=\"item-description\">\n                    Proposal for AI data fair use and distillation rights. Discusses Alibaba's Qwen 3.8 Max release and Xi Jinping's speech on open source collaboration.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-discussion\">Discussion</span>\n                    <span class=\"published-date\">2026-07-20</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">ai-ethics</span>\n                    <span class=\"tag\">qwen</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">Sam Altman's 2022 email about discouraging open models revealed</a>\n                </div>\n                <div class=\"author\">Simon Willison</div>\n                <div class=\"item-description\">\n                    Revelations from Musk v. Altman lawsuit show Sam Altman's 2022 strategy to release a GPT-3 class model to discourage competition.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-discussion\">Discussion</span>\n                    <span class=\"published-date\">2026-07-20</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">ai-ethics</span>\n                    <span class=\"tag\">openai</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">AI Mania Is Eviscerating Global Decision-Making</a>\n                </div>\n                <div class=\"author\">Simon Willison (citing Nik Suresh)</div>\n                <div class=\"item-description\">\n                    Reports on AI mania overwhelming large companies, including executives with no AI experience creating strategies and engineers gaming token leaderboards.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-discussion\">Discussion</span>\n                    <span class=\"published-date\">2026-07-19</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">ai-ethics</span>\n                    <span class=\"tag\">ai-misuse</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">Claude Code now using Bun written in Rust</a>\n                </div>\n                <div class=\"author\">Simon Willison</div>\n                <div class=\"item-description\">\n                    Investigation confirming Claude Code v2.1.181+ uses the Rust port of Bun (Bun v1.4.0), with 563 Rust source files found in the binary.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-technical\">Technical</span>\n                    <span class=\"published-date\">2026-07-19</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">bun</span>\n                    <span class=\"tag\">rust</span>\n                    <span class=\"tag\">claude-code</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">SQLite Query Explainer tool built with Claude</a>\n                </div>\n                <div class=\"author\">Simon Willison</div>\n                <div class=\"item-description\">\n                    Built an interactive SQLite EXPLAIN and EXPLAIN QUERY PLAN explainer tool using Claude/Fable, running SQLite in Python via Pyodide WebAssembly.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-tool\">Tool</span>\n                    <span class=\"published-date\">2026-07-18</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">sql</span>\n                    <span class=\"tag\">sqlite</span>\n                    <span class=\"tag\">tools</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">Claude makes Fable 5 permanent in Max and Team Premium plans</a>\n                </div>\n                <div class=\"author\">Simon Willison</div>\n                <div class=\"item-description\">\n                    Anthropic reversed course on removing Fable 5 from subscription plans due to competition from GPT-5.6 Sol and Kimi 3.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-opinion\">Opinion</span>\n                    <span class=\"published-date\">2026-07-18</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">anthropic</span>\n                    <span class=\"tag\">claude</span>\n                    <span class=\"tag\">llm-pricing</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">Kimi K3 refuses to leak its system prompt</a>\n                </div>\n                <div class=\"author\">Simon Willison</div>\n                <div class=\"item-description\">\n                    Chinese Moonshot AI's Kimi K3 model (2.8T parameters) refused a prompt injection attempt to leak its system prompt.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-discussion\">Discussion</span>\n                    <span class=\"published-date\">2026-07-17</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">kimi</span>\n                    <span class=\"tag\">ai-personality</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">LLM cliché highlighter tool</a>\n                </div>\n                <div class=\"author\">Simon Willison</div>\n                <div class=\"item-description\">\n                    Built a tool to highlight common LLM-generated writing clichés like 'no fluff, no filler, no jargon' patterns, using Fable 5 vibe coding.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-tool\">Tool</span>\n                    <span class=\"published-date\">2026-07-17</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">llms</span>\n                    <span class=\"tag\">tools</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">Firefox compiled to WebAssembly runs in browser</a>\n                </div>\n                <div class=\"author\">Simon Willison</div>\n                <div class=\"item-description\">\n                    Puter compiled Firefox/Gecko to WebAssembly (233MB gecko.wasm), allowing Firefox to run inside another browser. Used ~$25,000 worth of Claude Opus and Fable tokens.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-technical\">Technical</span>\n                    <span class=\"published-date\">2026-07-16</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">firefox</span>\n                    <span class=\"tag\">webassembly</span>\n                    <span class=\"tag\">claude</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">Kimi K3 analysis and pelican benchmark learnings</a>\n                </div>\n                <div class=\"author\">Simon Willison</div>\n                <div class=\"item-description\">\n                    Moonshot AI announced Kimi K3 (2.8T parameters), promising open weights release by July 27, 2026. Analysis compares it to other models.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-technical\">Technical</span>\n                    <span class=\"published-date\">2026-07-16</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">kimi</span>\n                    <span class=\"tag\">moonshot</span>\n                    <span class=\"tag\">llm-release</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">GPT-5.6 file deletion bug in Codex</a>\n                </div>\n                <div class=\"author\">Simon Willison (citing Thibault Sottiaux)</div>\n                <div class=\"item-description\">\n                    Describes a bug where GPT-5.6 in full access mode attempts to override the $HOME env var and mistakenly deletes $HOME instead of a temporary directory.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-technical\">Technical</span>\n                    <span class=\"published-date\">2026-07-16</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">codex</span>\n                    <span class=\"tag\">coding-agents</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">Thinking Machines Lab releases Inkling open-weights model</a>\n                </div>\n                <div class=\"author\">Simon Willison</div>\n                <div class=\"item-description\">\n                    Mira Murati's Thinking Machines Lab released Inkling, a 975B parameter (41B active) Mixture-of-Experts multimodal model with Apache-2.0 license.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-technical\">Technical</span>\n                    <span class=\"published-date\">2026-07-16</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">llms</span>\n                    <span class=\"tag\">llm-release</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">Mermaid to ASCII and Unicode box art tools</a>\n                </div>\n                <div class=\"author\">Simon Willison</div>\n                <div class=\"item-description\">\n                    Built two tools converting Mermaid diagrams to ASCII art - one from Grok Build's Rust code and another from AlexanderGrooff's Go library, both compiled to WebAssembly.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-tool\">Tool</span>\n                    <span class=\"published-date\">2026-07-16</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">mermaid</span>\n                    <span class=\"tag\">webassembly</span>\n                    <span class=\"tag\">tools</span>\n                </div>\n            </div>\n\n            <div class=\"item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/\">Linus Torvalds: Linux is not anti-AI, forking is always an option</a>\n                </div>\n                <div class=\"author\">Simon Willison (citing Linus Torvalds)</div>\n                <div class=\"item-description\">\n                    Linus Torvalds stated on the Linux Media Mailing List that Linux is not an anti-AI project, and critics can fork it if they disagree.\n                </div>\n                <div class=\"item-meta\">\n                    <span class=\"type-badge type-opinion\">Opinion</span>\n                    <span class=\"published-date\">2026-07-16</span>\n                </div>\n                <div class=\"item-meta\" style=\"margin-top: 4px;\">\n                    <span class=\"tag\">open-source</span>\n                    <span class=\"tag\">linux</span>\n                    <span class=\"tag\">linus-torvalds</span>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <footer>\n        <div class=\"container\">\n            <p>Agentic Coding Research Report | Generated on July 23, 2026</p>\n            <p>\n                <a href=\"#\">About</a> |\n                <a href=\"#\">Archive</a> |\n                <a href=\"#\">Subscribe</a> |\n                <a href=\"#\">Contact</a>\n            </p>\n        </div>\n    </footer>\n</body>\n</html>"
