    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Agentic Coding Research Report - 2026-04-25</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: Verdana, Geneva, sans-serif;\n            background-color: #f6f6ef;\n            color: #000000;\n            line-height: 1.5;\n            font-size: 13px;\n        }\n\n        .container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 10px;\n        }\n\n        header {\n            background-color: #ff6600;\n            color: #ffffff;\n            padding: 8px 12px;\n            margin-bottom: 15px;\n        }\n\n        header h1 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 16px;\n            font-weight: bold;\n            color: #000000;\n        }\n\n        header .date {\n            font-size: 12px;\n            color: #000000;\n            margin-top: 3px;\n        }\n\n        .three-column-layout {\n            display: grid;\n            grid-template-columns: 40% 35% 25%;\n            gap: 15px;\n            margin-bottom: 20px;\n        }\n\n        section {\n            background-color: #ffffff;\n            border: 1px solid #d4d4d4;\n            padding: 12px;\n        }\n\n        section h2 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 14px;\n            font-weight: bold;\n            color: #000000;\n            margin-bottom: 12px;\n            padding-bottom: 8px;\n            border-bottom: 2px solid #ff6600;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .count {\n            background-color: #ff6600;\n            color: #ffffff;\n            paddin