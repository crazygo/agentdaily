      "content": "[\n  {\n    \"title\": \"DeepSeek V4—almost on the frontier, a fraction of the price\",\n    \"description\": \"Chinese AI lab DeepSeek released two preview models, DeepSeek-V4-Pro and DeepSeek-V4-Flash. Simon Willison provides analysis of these new models that offer frontier-level performance at a lower price point.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Apr/24/deepseek-v4/\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"LLM\", \"AI models\", \"open source\", \"China AI\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"OpenAI releases GPT-5.5, bringing company one step closer to an AI 'super app'\",\n    \"description\": \"OpenAI released GPT-5.5, described as their 'smartest and most intuitive' model yet. The release continues OpenAI's push toward an all-encompassing AI application.\",\n    \"author\": \"Lucas Ropek\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://techcrunch.com/2026/04/24/openai-gpt-5-5-release/\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"OpenAI\", \"GPT-5.5\", \"LLM\", \"AI models\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Google is investing billions in Anthropic\",\n    \"description\": \"Google is investing $10 billion in Anthropic initially, with potential for up to $30 billion more if performance targets are met. Amazon also invested $5 billion with potential for $20 billion more. This shows massive cloud provider competition for AI partnerships.\",\n    \"author\": \"Jay Peters\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://www.theverge.com/2026/4/24/google-anthropic-investment\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"Anthropic\", \"Google\", \"Amazon\", \"AI investment\", \"LLM\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Claude Code quality postmortem reveals harness bugs\",\n    \"description\": \"Anthropic published a postmortem explaining that recent Claude Code quality issues were caused by three separate bugs in the Claude Code harness, not the models themselves. One key bug caused older thinking to be cleared from idle sessions repeatedly, making Claude seem forgetful.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Apr/23/claude-code-quality/\",\n    \"published_date\": \"2026-04-23\",\n    \"topics\": [\"Claude Code\", \"AI agents\", \"bugs\", \"Anthropic\", \"coding-agents\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Claude Design documentation published\",\n    \"description\": \"Anthropic published comprehensive Claude Design documentation, covering prompt engineering best practices, workflow patterns, and practical examples for building applications with Claude. The documentation quickly became popular on Hacker News with 1170 points.\",\n    \"author\": \"Anthropic\",\n    \"source\": \"HN\",\n    \"url\": \"https://anthropic.com/design\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"Claude\", \"Anthropic\", \"documentation\", \"prompt engineering\", \"AI design\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Measuring Claude 4.7's tokenizer costs\",\n    \"description\": \"Analysis of Claude Opus 4.7's new tokenizer that increases token counts by 1.0-1.35x compared to 4.6. For system prompts, the increase is 1.46x, making Opus 4.7 roughly 40% more expensive despite identical pricing per token.\",\n    \"author\": \"Claude Code Camp\",\n    \"source\": \"HN\",\n    \"url\": \"https://claudecodecamp.com/measuring-claude-4-7s-tokenizer-costs\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"Claude\", \"tokenization\", \"pricing\", \"Anthropic\", \"LLM\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Claude Code pricing confusion and discussion\",\n    \"description\": \"Discussion on Hacker News about Claude Code potentially being removed from Anthropic's Pro plan. The community discusses pricing changes, plan structures, and the future of Claude Code availability.\",\n    \"author\": \"Hacker News community\",\n    \"source\": \"HN\",\n    \"url\": \"https://bsky.app/post/3krgqkjnfvk2n\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"Claude Code\", \"pricing\", \"Anthropic\", \"AI agents\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"Qwen3.6-27B: Flagship-Level Coding in 27B Dense Model\",\n    \"description\": \"Qwen3.6-27B delivers flagship-level agentic coding performance that surpasses their previous 397B MoE model. The model is 55.6GB (vs 807GB) and performs well on local benchmarks including generating SVG images.\",\n    \"author\": \"Qwen team\",\n    \"source\": \"HN\",\n    \"url\": \"https://qwen.ai/qwen3-6-27b\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"LLM\", \"open source\", \"coding\", \"local models\", \"Qwen\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Anthropic allows OpenClaw-style Claude CLI usage again\",\n    \"description\": \"Anthropic reversed course and now allows OpenClaw-style CLI usage for Claude models. This change gives developers more flexibility in how they interact with Claude through command-line interfaces.\",\n    \"author\": \"OpenClaw team\",\n    \"source\": \"HN\",\n    \"url\": \"https://openclaw.ai\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"Claude\", \"Anthropic\", \"CLI\", \"developer tools\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Google TPUs: two chips for the agentic era\",\n    \"description\": \"Google announced their eighth generation TPUs designed specifically for the 'agentic era' of AI. These two chips are optimized for AI agents that perform multi-step reasoning and autonomous tasks.\",\n    \"author\": \"Google\",\n    \"source\": \"HN\",\n    \"url\": \"https://blog.google/technology/infrastructure/eighth-generation-tpus-agentic-era\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"Google\", \"TPU\", \"AI hardware\", \"AI agents\", \"infrastructure\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Anthropic takes $5B from Amazon with $100B cloud spending pledge\",\n    \"description\": \"Amazon invested $5 billion in Anthropic, with a potential for $20 billion more. Anthropic pledged $100 billion in cloud spending on Amazon Web Services in return. This shows the intense competition among cloud providers for AI partnerships.\",\n    \"author\": \"Rebecca Bellan\",\n    \"source\": \"HN\",\n    \"url\": \"https://techcrunch.com/2026/04/24/anthropic-amazon-investment\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"Anthropic\", \"Amazon\", \"AI investment\", \"cloud computing\", \"LLM\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Meta to capture employee mouse movements, keystrokes for AI training\",\n    \"description\": \"Meta announced plans to capture employee mouse movements and keystrokes to train AI systems. This decision raises privacy and surveillance concerns among employees and the broader tech community.\",\n    \"author\": \"Reuters\",\n    \"source\": \"HN\",\n    \"url\": \"https://reuters.com/technology/meta-employee-ai-training\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"Meta\", \"AI training\", \"privacy\", \"employee monitoring\", \"data collection\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"SPICE simulation verification with Claude Code\",\n    \"description\": \"Show HN project demonstrating SPICE circuit simulation connected to oscilloscope verification using Claude Code. The project showcases AI-assisted electronics design and testing workflows.\",\n    \"author\": \"Lucas Gerads\",\n    \"source\": \"HN\",\n    \"url\": \"https://lucasgerads.com/spice-oscilloscope-claude-code\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"Claude Code\", \"electronics\", \"SPICE\", \"circuit simulation\", \"AI workflows\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Qwen3.6-27B delivers flagship-level coding in 27B model\",\n    \"description\": \"Qwen released Qwen3.6-27B, claiming flagship-level agentic coding performance that surpasses their previous 397B MoE model. The model is 55.6GB (vs 807GB for the previous) and performs well on local benchmarks including generating SVG images of pelicans on bicycles.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Apr/22/qwen3-6-27b/\",\n    \"published_date\": \"2026-04-22\",\n    \"topics\": [\"LLM\", \"open source\", \"coding\", \"local models\", \"Qwen\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Firefox 150 includes 271 vulnerability fixes from Claude Mythos Preview\",\n    \"description\": \"Mozilla CTO Bobby Holley announced that Firefox 150 includes fixes for 271 vulnerabilities identified during evaluation with Claude Mythos Preview. He called it 'every bit as capable' as top security researchers and noted defenders finally have a chance to win decisively.\",\n    \"author\": \"Simon Willison (citing Bobby Holley)\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Apr/22/firefox-mythos/\",\n    \"published_date\": \"2026-04-22\",\n    \"topics\": [\"Claude\", \"Anthropic\", \"security\", \"Firefox\", \"AI safety\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"GitHub Copilot changes pricing due to agentic compute demands\",\n    \"description\": \"GitHub changed Copilot Individual plans, tightening usage limits and pausing signups. The announcement notes that agentic workflows have fundamentally changed compute demands, with long-running parallelized sessions consuming far more resources than the original plan structure supported.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Apr/22/github-copilot-pricing/\",\n    \"published_date\": \"2026-04-22\",\n    \"topics\": [\"GitHub Copilot\", \"pricing\", \"AI agents\", \"coding tools\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Google says 75 percent of all its new code is AI-generated\",\n    \"description\": \"Google CEO Sundar Pichai announced that 75% of all new code at Google is AI-generated, up from 50% last fall. Google created a 'strike team' to improve AI coding capabilities to catch up to Anthropic, which writes 70-90% of its code with Claude Code.\",\n    \"author\": \"Stevie Bonifield\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://www.theverge.com/2026/4/22/google-ai-generated-code\",\n    \"published_date\": \"2026-04-22\",\n    \"topics\": [\"Google\", \"AI coding\", \"Claude Code\", \"software development\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Anthropic's most dangerous AI model just fell into the wrong hands\",\n    \"description\": \"Unauthorized group gained access to Anthropic's exclusive cyber tool Mythos. The breach is described as 'humiliating' and raises serious security concerns about powerful AI models being accessed outside authorized channels.\",\n    \"author\": \"The Verge staff\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://www.theverge.com/2026/4/22/anthropic-mythos-breach\",\n    \"published_date\": \"2026-04-22\",\n    \"topics\": [\"Anthropic\", \"Claude Mythos\", \"security\", \"AI safety\", \"breach\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"SpaceX cuts deal to possibly buy Cursor for $60 billion\",\n    \"description\": \"SpaceX is working with Cursor and has an option to buy the AI coding startup for $60B. This shows the massive valuations and strategic importance being placed on AI coding tools.\",\n    \"author\": \"Elizabeth Lopatto\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://www.theverge.com/2026/4/21/spacex-cursor-acquisition\",\n    \"published_date\": \"2026-04-21\",\n    \"topics\": [\"SpaceX\", \"Cursor\", \"AI coding\", \"acquisition\", \"startups\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Claude Token Counter adds model comparisons\",\n    \"description\": \"Simon Willison upgraded his Claude Token Counter tool to compare token counts between models. Claude Opus 4.7 uses a new tokenizer that increases tokens by 1.0-1.35x compared to 4.6. For system prompts, he found a 1.46x increase, making Opus 4.7 roughly 40% more expensive despite identical pricing.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Apr/20/claude-token-counter/\",\n    \"published_date\": \"2026-04-20\",\n    \"topics\": [\"Claude\", \"tokenization\", \"pricing\", \"Anthropic\", \"LLM\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Headless services and the future of personal AI\",\n    \"description\": \"Discussion about how 'headless' services (API-first, no browser required) are becoming more common as personal AIs prefer APIs over GUIs. Salesforce announced Salesforce Headless 360, and Brandur Leach predicts APIs are ready for a comeback as agents need direct access to services.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Apr/19/headless-everything/\",\n    \"published_date\": \"2026-04-19\",\n    \"topics\": [\"APIs\", \"AI agents\", \"SaaS\", \"personal AI\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Changes in Claude Opus 4.6 to 4.7 system prompts\",\n    \"description\": \"Simon Willison analyzes the differences between Claude Opus 4.6 and 4.7 system prompts. Anthropic is the only major AI lab to publish system prompts, and this evolution shows how they're refining the model's behavior and safety guidelines.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Apr/18/claude-opus-system-prompts/\",\n    \"published_date\": \"2026-04-18\",\n    \"topics\": [\"Claude\", \"Anthropic\", \"system prompts\", \"LLM\"],\n    \"type\": \"technical\"\n  }\n]\n",
