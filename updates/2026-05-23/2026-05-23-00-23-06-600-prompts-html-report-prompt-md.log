      "content": "[\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot for Eclipse is now open source\",\n    \"description\": \"GitHub announced that Copilot for Eclipse is now open source under the MIT license, allowing community contributions and transparency. The code is now hosted publicly on GitHub.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/2026-05-21-github-copilot-for-eclipse-is-open-source/\",\n    \"date\": \"2026-05-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Semantic issue search in Copilot Chat\",\n    \"description\": \"New semantic search capability allows Copilot Chat to understand and find issues based on meaning rather than just keywords, improving the accuracy of code-related queries.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Gemini 3.5 Flash is generally available for GitHub Copilot\",\n    \"description\": \"Google's Gemini 3.5 Flash model is now generally available for GitHub Copilot users. Early testing shows it delivers near-Pro coding quality at Flash-tier speed with 42% better performance on multi-turn cyber benchmarks and 72% reduction in token use.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-05-19-gemini-3-5-flash-is-generally-available-for-github-copilot/\",\n    \"date\": \"2026-05-19\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"I agree, 2.5 Pro was an absolute nightmare for coding via GitHub Copilot\",\n        \"source\": \"Reddit r/GithubCopilot\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Do you really need a smarter model than Gemini 3 Flash? - Active debate about model selection\",\n        \"source\": \"Reddit r/GithubCopilot\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Early testing shows strong tool use, fast response times, and near-Pro coding quality at Flash-tier speed and cost\",\n        \"source\": \"X (Twitter) - @github\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot cloud agent: Fast, cost-efficient models for simple tasks\",\n    \"description\": \"New cloud agent can automatically route simple tasks to faster, more cost-efficient models while reserving premium models for complex work. Uses flat-rate pricing at approximately $0.04 per premium request.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-18\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The agent can become quite expensive due to premium request limits\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"The biggest benefit is the flat-rate pricing model versus per-token pricing\",\n        \"source\": \"GitHub Community\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"$10/month is efficient compared to raw GPT-4 API costs ($0.03-0.06 per 1K tokens)\",\n        \"source\": \"GitHub Community\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Ask questions in context with Copilot on web\",\n    \"description\": \"New web interface feature allows users to ask questions with repository context directly in the browser, enabling AI-assisted code exploration without leaving the web interface.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-18\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Spaces API now generally available\",\n    \"description\": \"The Copilot Spaces API is now generally available, enabling developers to programmatically manage and interact with Copilot Spaces for collaborative AI coding environments.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-18\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Remote control for Copilot CLI sessions now generally available\",\n    \"description\": \"Remote control functionality for Copilot CLI sessions is now available across mobile, web, and VS Code platforms, allowing developers to control CLI sessions from anywhere.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-18\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GPT-5.3-Codex is now the base model for Copilot Business and Enterprise\",\n    \"description\": \"OpenAI's GPT-5.3-Codex model is now the default base model for Copilot Business and Enterprise tiers, providing improved code generation capabilities.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot app now available in technical preview\",\n    \"description\": \"A new standalone GitHub Copilot application is now available in technical preview, offering an alternative to IDE-specific installations.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Team-level Copilot usage metrics now available via API\",\n    \"description\": \"New API endpoints provide team-level usage metrics for Copilot, helping organizations track adoption and usage patterns across teams.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Start Copilot cloud agent tasks via REST API\",\n    \"description\": \"Developers can now initiate Copilot cloud agent tasks programmatically through REST API endpoints, enabling automation and integration into CI/CD pipelines.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-05-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Claude Code and Opus API limits expanded with Managed Agents\",\n    \"description\": \"Anthropic expanded developer platform capabilities with higher API limits for Claude Code and Opus, plus new Managed Agent features including dreaming, multi-agent systems, and remote session persistence. SWE-bench Verified score improved to 74.5%.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://releasebot.io/updates/anthropic/claude\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Fast and Comprehensive Code Review Features\",\n    \"description\": \"Windsurf (formerly Codeium) introduced Devin Review and Quick Review features, bringing advanced code review verification directly into the development workspace. Features include deep PR review and fast local bug detection.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://codeium.com/windsurf\",\n    \"date\": \"2026-05-06\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"#1 Windsurf Codeium - Just works, even if you don't use any of the additional features and you just use Cascade its a seamless experience\",\n        \"source\": \"X (Twitter) - @andrewbrown\",\n        \"sentiment\": \"positive\"\n      },\n     