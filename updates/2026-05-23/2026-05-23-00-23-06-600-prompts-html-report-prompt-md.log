      "content": "[\n  {\n    \"title\": \"FTC Settlement Over 'Active Listening' AI Marketing Claims\",\n    \"description\": \"The FTC required Cox Media Group and two other firms to pay nearly $1 million for deceiving customers about 'Active Listening' AI-powered marketing. The service didn't actually listen to conversations but resold email lists from data brokers at a markup. Simon Willison's previous analysis that this was just a metaphor for standard ad targeting was confirmed.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-05-22\",\n    \"topics\": [\"AI ethics\", \"privacy\", \"FTC\", \"marketing\", \"AI hype\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Datasette Agent: Extensible AI Assistant for Datasette\",\n    \"description\": \"Simon Willison announced the first release of Datasette Agent, a new extensible AI assistant for Datasette that represents the integration of his LLM Python library (3+ years in development) with Datasette. The tool includes per-user spending limits, SQL execution permissions, and Fly Sprites sandbox command execution.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-05-21\",\n    \"topics\": [\"LLM\", \"AI assistants\", \"Datasette\", \"Python\", \"agent development\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"SpaceX-Anthropic $1.25B/Month Compute Agreement\",\n    \"description\": \"SpaceX S-1 filing revealed Cloud Services Agreements with Anthropic for access to compute capacity across COLOSSUS and COLOSSUS II. Anthropic agreed to pay $1.25 billion per month through May 2029, with capacity ramping in May-June 2026 at reduced fees. 90-day termination notice allowed.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-05-20\",\n    \"topics\": [\"Anthropic\", \"SpaceX\", \"compute infrastructure\", \"AI scaling\", \"Grok\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Gemini 3.5 Flash Release and Antigravity CLI Transition\",\n    \"description\": \"Google released Gemini 3.5 Flash at Google I/O, using it across key products. Announced Gemini Spark as an OpenClaw competitor, and revealed transition from open-source Gemini CLI (TypeScript, Apache 2.0) to closed-source Antigravity CLI (Go-based) starting June 18th. Security approach includes isolated VMs and Agent Gateway with DLP policies.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-05-19\",\n    \"topics\": [\"Google\", \"Gemini\", \"Antigravity\", \"CLI tools\", \"agent security\", \"open source\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"The Last Six Months in LLMs - PyCon US Lightning Talk\",\n    \"description\": \"Simon Willison delivered a five-minute lightning talk at PyCon US 2026 summarizing the last six months of LLM developments. Used his annotated presentation tool to create slides covering key recent advances in AI and language models.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-05-19\",\n    \"topics\": [\"LLMs\", \"PyCon\", \"presentation\", \"AI trends\"],\n    \"type\": \"tutorial\"\n  },\n  {\n    \"title\": \"UK Government Digital Service Backs Open Source for AI Code\",\n    \"description\": \"Government Digital Service (GDS) published 'AI, open code and vulnerability risk in the public sector' recommending keeping open by default. This is seen as a major escalation in response to NHS closing open source repos after Project Glasshook vulnerabilities. Making everything private adds delivery costs and reduces scrutiny.\",\n    \"author\": \"Simon Willison (covering Terence Eden)\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-05-17\",\n    \"topics\": [\"open source\", \"government\", \"AI security\", \"NHS\", \"policy\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"OpenClaw's Name Evolution: Warelay to OpenClaw\",\n    \"description\": \"Analysis of OpenClaw's six-month name evolution since November 2025: Warelay → CLAWDIS → CLAWDBOT → Clawdbot → Moltbot → OpenClaw. Shows rapid iteration on AI assistant product identity and positioning.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-05-16\",\n    \"topics\": [\"OpenClaw\", \"AI agents\", \"product development\", \"Git history\"],\n    \"type\": \"discussion\"\n  },\n  {\n    \"title\": \"AI-Assisted Programming: Language Lock-In is Dead\",\n    \"description\": \"Discussion about how programming languages are increasingly fungible due to AI coding agents. Mitchell Hashimoto on Bun migrating from Zig to Rust: 'Programming languages used to be LOCK IN, and they're increasingly not so.' A medium tech company completed a coding-agent driven rewrite of iPhone and Android apps to React Native, reasoning that if wrong, they could just port back.\",\n    \"author\": \"Simon Willison, Mitchell Hashimoto\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/\",\n    \"published_date\": \"2026-05-14\",\n    \"topics\": [\"AI coding\", \"programming languages\", \"React Native\", \"Rust\", \"Zig\", \"Bun\"],\n    \"type\": \"opinion\"\n  }\n]\n",
