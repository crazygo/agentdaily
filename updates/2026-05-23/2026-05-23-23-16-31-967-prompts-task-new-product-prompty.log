nt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"buildpipe\",\n    \"url\": \"https://buildpipe.com\",\n    \"description\": \"Local-first pipeline automation app for developers that chains shell commands, AI calls, HTTP requests, and file operations into reusable pipelines. Trigger pipelines on schedule, file change, or webhook. Features AI Build to describe pipelines in plain English, 48 templates, encrypted API keys stored locally, and no telemetry or accounts required.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Vibedock\",\n    \"url\": \"https://www.producthunt.com\",\n    \"description\": \"Mac menu bar utility for toggling Claude Code MCP (Model Context Protocol) servers, providing quick access to Claude Code's extensibility system for developers.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"IDE integration\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Command A\",\n    \"url\": \"https://www.producthunt.com\",\n    \"description\": \"Cohere's open enterprise workhorse model for development tasks, positioned as an open-source AI coding assistant.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"open-source model\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Memdex\",\n    \"url\": \"https://www.producthunt.com\",\n    \"description\": \"Tool that turns every AI conversation into reusable local memory, addressing the session persistence problem for AI coding workflows.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"memory agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  }\n]\n"
