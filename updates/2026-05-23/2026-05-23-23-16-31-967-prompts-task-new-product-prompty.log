    "content": "[\n  {\n    \"name\": \"Google Antigravity CLI\",\n    \"url\": \"https://blog.google/innovation-and-ai/technology/developers-tools/google-io-2026-developer-highlights/\",\n    \"description\": \"CLI tool for running coding agents directly from terminal, part of Google Antigravity 2.0 ecosystem launched at Google I/O 2026. Features agent management, hooks, scheduled tasks, and voice support.\",\n    \"release_date\": \"2026-05-22\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Vibedock\",\n    \"url\": \"https://www.producthunt.com\",\n    \"description\": \"Mac menu bar utility for toggling Claude Code MCP (Model Context Protocol) servers, providing quick access to Claude Code's extensibility system.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"IDE integration\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Command A\",\n    \"url\": \"https://www.producthunt.com\",\n    \"description\": \"Cohere's open enterprise workhorse model for development tasks, positioned as an open-source AI coding assistant.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"open-source model\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"TestSprite 3.0\",\n    \"url\": \"https://www.producthunt.com\",\n    \"description\": \"Autonomous end-to-end testing agent using parallel AI agents to explore apps and generate comprehensive test suites. Features include parallel exploration fleet, complex integration testing with dynamic variables, and CLI integration for Claude Code/Codex users.\",\n    \"release_date\": \"2026-05-22\",\n    \"category\": \"workflow-specific\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"OpenHuman\",\n    \"url\": \"https://tinyhumans.ai/openhuman\",\n    \"description\": \"Open-source AI harness that is local-first, privacy-first, with persistent memory across sessions using a Memory Tree. Integrates with 118+ tools including Gmail, Slack, Telegram, Notion, and GitHub. Achieved 8000+ GitHub stars in first 7 days.\",\n    \"release_date\": \"2026-05-15\",\n    \"category\": \"open-source agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Spellar 3.0\",\n    \"url\": \"https://www.producthunt.com\",\n    \"description\": \"AI meeting companion with cross-meeting memory, allowing AI to remember context across multiple sessions.\",\n    \"release_date\": \"2026-05-18\",\n    \"category\": \"memory agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"buildpipe\",\n    \"url\": \"https://buildpipe.com\",\n    \"description\": \"Local-first pipeline automation app for developers that chains shell commands, AI calls, HTTP requests, and file operations into reusable pipelines. Trigger pipelines on schedule, file change, or webhook.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Forsy\",\n    \"url\": \"https://www.producthunt.com\",\n    \"description\": \"Platform to capture and sell AI agent workflow data, helping monetize AI agent interactions.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Memdex\",\n    \"url\": \"https://www.producthunt.com\",\n    \"description\": \"Tool that turns every AI conversation into reusable local memory, addressing the session persistence problem.\",\n    \"release_date\": \"2026-05-23\",\n    \"category\": \"memory agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Google Antigravity 2.0\",\n    \"url\": \"https://blog.google/innovation-and-ai/technology/developers-tools/google-io-2026-developer-highlights/\",\n    \"description\": \"Standalone desktop application for orchestrating multiple AI agents with scheduled background tasks, subagent workflows, and integrations with AI Studio, Firebase, and Android. Breaks the 'prompt, wait, respond' pattern by letting agents run in background on cron-like schedules.\",\n    \"release_date\": \"2026-05-22\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  }\n]\n",
