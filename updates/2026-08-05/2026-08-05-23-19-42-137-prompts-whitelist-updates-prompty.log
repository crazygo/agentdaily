ck\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Agentic Autofix for Code Scanning\",\n    \"description\": \"GitHub launched agentic autofix for code scanning alerts in public preview, combining security tools with Copilot AI to automatically fix security vulnerabilities.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Code Quality GA\",\n    \"description\": \"GitHub Code Quality became generally available, featuring organization-level targeting and license estimation capabilities.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot App Release\",\n    \"description\": \"GitHub released the Copilot App to all users, including new usage metrics dashboards, AI credit pools for cost centers, and managed settings for enterprises.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-07\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Vision GA\",\n    \"description\": \"Copilot Vision reached general availability, offering enhanced visual code understanding capabilities.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-01\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Kimi K2.7 Code Model Support\",\n    \"description\": \"GitHub Copilot added Kimi K2.7 Code model to its supported AI models lineup.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-01\",\n    \"community_feedback\