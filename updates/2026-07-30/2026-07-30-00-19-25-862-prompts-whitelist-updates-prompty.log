  "content": "[\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Agent skills and MCP generally available\",\n    \"description\": \"GitHub Copilot made agent skills and MCP (Model Context Protocol) generally available on July 29, 2026, enabling enhanced code review capabilities for developers.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-29\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Default model enablement for Copilot Business and Enterprise\",\n    \"description\": \"Default model enablement feature rolled out for Copilot Business and Enterprise customers on July 29, 2026.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-29\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Grok 4.5 added to Copilot\",\n    \"description\": \"GitHub added Grok 4.5 model support to Copilot on July 28, 2026, expanding AI model options for developers.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot app usage metrics expansion\",\n    \"description\": \"Copilot app usage metrics now expand across report rollups as of July 28, 2026, providing better analytics for organizations.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Claude Opus 5 availability\",\n    \"description\": \"Claude Opus 5 became available in GitHub Copilot on July 24, 2026, adding another powerful AI model option.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"New Copilot usage metrics impact dashboard\",\n    \"description\": \"GitHub introduced a new Copilot usage metrics impact dashboard on July 22, 2026, helping organizations track adoption and impact.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-22\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Repository-level usage metrics generally available\",\n    \"description\": \"Repository-level usage metrics reached general availability on July 17, 2026, providing granular insights into Copilot usage.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/\",\n    \"date\": \"2026-07-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor now on iPad\",\n    \"description\": \"Cursor announced availability on iPad on July 29, 2026, expanding its platform support beyond desktop to tablet devices.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/\",\n    \"date\": \"2026-07-29\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor Start\",\n    \"description\": \"Cursor introduced Cursor Start on July 28, 2026, a new feature or product enhancement.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/\",\n    \"date\": \"2026-07-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor Router\",\n    \"description\": \"Cursor announced Cursor Router on July 22, 2026, adding routing capabilities to the platform.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/\",\n    \"date\": \"2026-07-22\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Improvements to Cursor in Slack\",\n    \"description\": \"Cursor released improvements to its Slack integration on July 17, 2026, enhancing collaboration workflows.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/\",\n    \"date\": \"2026-07-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Windsurf rebranded to Devin Desktop\",\n    \"description\": \"Windsurf was rebranded to 'Devin Desktop' in late July 2026, described as 'the new name for Windsurf' with a command center for managing coding agents.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://devin.ai/desktop\",\n    \"date\": \"2026-07-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Gemini CLI v0.53.0 release\",\n    \"description\": \"Gemini CLI released v0.53.0 on July 28, 2026, featuring 'Caretaker Triage Orchestration' with an LLM triage orchestrator, new eval coverage reporting command, and security enhancements with workspace trust and task isolation.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-07-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Gemini CLI v0.52.0 release\",\n    \"description\": \"Gemini CLI released v0.52.0 on July 22, 2026, with core triage worker modules, enhanced file handling bypassing LLM correction for JSON and IPYNB files, and improved authentication error messaging.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-07-22\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Continue acquired by Cursor\",\n    \"description\": \"Continue was acquired by Cursor, with the announcement stating that their open-source codebase remains freely available. The exact date of the announcement is unclear from the content.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://continue.dev/\",\n    \"date\": \"2026-07-25\",\n    \"community_feedback\": []\n  }\n]"
}

