          color: #666666;\n        }\n\n        .badge.feature {\n            background-color: #fff3e0;\n            color: #e65100;\n        }\n\n        .badge.release {\n            background-color: #e8f5e9;\n            color: #2e7d32;\n        }\n\n        .badge.announcement {\n            background-color: #e3f2fd;\n            color: #1565c0;\n        }\n\n        .badge.technical {\n            background-color: #f3e5f5;\n            color: #7b1fa2;\n        }\n\n        .badge.opinion {\n            background-color: #fce4ec;\n            color: #c2185b;\n        }\n\n        .empty-state {\n            text-align: center;\n            padding: 40px 20px;\n            color: #828282;\n            font-style: italic;\n        }\n\n        .topic-tags {\n            margin-top: 8px;\n        }\n\n        .topic-tag {\n            display: inline-block;\n            font-size: 10px;\n            color: #666666;\n            background-color: #f5f5f5;\n            padding: 2px 5px;\n            margin-right: 4px;\n            margin-bottom: 4px;\n            border-radius: 2px;\n            font-family: Monaco, Consolas, monospace;\n        }\n\n        footer {\n            max-width: 1400px;\n            margin: 30px auto;\n            padding: 15px;\n            text-align: center;\n            border-top: 1px solid #d4d4d4;\n            color: #828282;\n            font-size: 12px;\n        }\n\n        footer a {\n            color: #ff6600;\n        }\n\n        /* Print styles */\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            header {\n                background-color: #ffffff;\n                border-bottom: 2px solid #000000;\n            }\n\n            .column-header {\n                background-color: #ffffff;\n                border-bottom: 2px solid #000000;\n            }\n\n            section {\n                border: 1px solid #cccccc;\n            }\n        }\n\n        /* Hover effects */\n        .content-item:hover {\n            background-color: #fafafa;\n            border-radius: 4px;\n            padding-left: 10px;\n            padding-right: 10px;\n            margin-left: -10px;\n            margin-right: -10px;\n            transition: background-color 0.2s ease;\n        }\n\n        .source-indicator {\n            font-family: Monaco, Consolas, monospace;\n            font-size: 10px;\n            color: #666666;\n            background-color: #f0f0f0;\n            padding: 2px 5px;\n            border-radius: 2px;\n            display: inline-block;\n            margin-left: 5px;\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <h1>Agentic Coding Research Report</h1>\n        <div class=\"date\">2026-07-30</div>\n    </header>\n\n    <main class=\"three-column-layout\">\n        <!-- New Products Section -->\n        <section class=\"new-products\">\n            <div class=\"column-header\">New Products</div>\n            <div class=\"empty-state\">\n                No new products discovered in the past 14 days that meet the criteria for agentic coding tools.\n            </div>\n        </section>\n\n        <!-- Whitelist Updates Section -->\n        <section class=\"whitelist-updates\">\n            <div class=\"column-header\">Whitelist Updates</div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://github.blog/changelog/\" target=\"_blank\" class=\"accent-link\">GitHub Copilot</a>\n                    <span class=\"badge feature\">Feature</span>\n                </div>\n                <div class=\"item-description\">\n                    Agent skills and MCP (Model Context Protocol) made generally available, enabling enhanced code review capabilities for developers.\n                </div>\n                <div class=\"item-meta\">\n                    2026-07-29 | <span class=\"source-indicator\">GitHub</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://cursor.com/\" target=\"_blank\" class=\"accent-link\">Cursor</a>\n                    <span class=\"badge feature\">Feature</span>\n                </div>\n                <div class=\"item-description\">\n                    Cursor announced availability on iPad, expanding its platform support beyond desktop to tablet devices.\n                </div>\n                <div class=\"item-meta\">\n                    2026-07-29 | <span class=\"source-indicator\">Cursor</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://devin.ai/desktop\" target=\"_blank\" class=\"accent-link\">Windsurf → Devin Desktop</a>\n                    <span class=\"badge announcement\">Rebrand</span>\n                </div>\n                <div class=\"item-description\">\n                    Windsurf was rebranded to \"Devin Desktop\", described as \"the new name for Windsurf\" with a command center for managing coding agents.\n                </div>\n                <div class=\"item-meta\">\n                    2026-07-28 | <span class=\"source-indicator\">Devin</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://geminicli.com/docs/changelogs/\" target=\"_blank\" class=\"accent-link\">Gemini CLI v0.53.0</a>\n                    <span class=\"badge release\">Release</span>\n                </div>\n                <div class=\"item-description\">\n                    Featuring \"Caretaker Triage Orchestration\" with an LLM triage orchestrator, new eval coverage reporting command, and security enhancements with workspace trust and task isolation.\n                </div>\n                <div class=\"item-meta\">\n                    2026-07-28 | <span class=\"source-indicator\">Gemini CLI</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://continue.dev/\" target=\"_blank\" class=\"accent-link\">Continue</a>\n                    <span class=\"badge announcement\">Acquisition</span>\n                </div>\n                <div class=\"item-description\">\n                    Continue was acquired by Cursor, with the announcement stating that their open-source codebase remains freely available.\n                </div>\n                <div class=\"item-meta\">\n                    2026-07-25 | <span class=\"source-indicator\">Continue</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://cursor.com/\" target=\"_blank\" class=\"accent-link\">Cursor Router</a>\n                    <span class=\"badge feature\">Feature</span>\n                </div>\n                <div class=\"item-description\">\n                    Cursor announced Cursor Router, adding routing capabilities to the platform.\n                </div>\n                <div class=\"item-meta\">\n                    2026-07-22 | <span class=\"source-indicator\">Cursor</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://geminicli.com/docs/changelogs/\" target=\"_blank\" class=\"accent-link\">Gemini CLI v0.52.0</a>\n                    <span class=\"badge release\">Release</span>\n                </div>\n                <div class=\"item-description\">\n                    With core triage worker modules, enhanced file handling bypassing LLM correction for JSON and IPYNB files, and improved authentication error messaging.\n                </div>\n                <div class=\"item-meta\">\n                    2026-07-22 | <span class=\"source-indicator\">Gemini CLI</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- Technical Insights Section -->\n        <section class=\"technical-insights\">\n            <div class=\"column-header\">Technical Insights</div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://github.com/karpathy/nanochat/pull/815\" target=\"_blank\" class=\"accent-link\">FP8 Performance Bug Fix</a>\n                    <span class=\"badge technical\">Technical</span>\n                </div>\n                <div class=\"item-description\">\n                    Critical bug fix in nanochat where FP8 training mode incorrectly calculated FLOPs/token and MFU by ~12x.\n                </div>\n                <div class=\"item-meta\">\n                    Andrej Karpathy | 2026-07-30\n                </div>\n                <div class=\"topic-tags\">\n                    <span class=\"topic-tag\">LLM training</span>\n                    <span class=\"topic-tag\">FP8</span>\n                    <span class=\"topic-tag\">PyTorch</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/2026/Jul/29/ai-worming-through-word/\" target=\"_blank\" class=\"accent-link\">AI Worming through Word</a>\n                    <span class=\"badge technical\">Security</span>\n                </div>\n                <div class=\"item-description\">\n                    Prompt injection variant where hidden instructions in Word documents self-replicate through Copilot.\n                </div>\n                <div class=\"item-meta\">\n                    Simon Willison | 2026-07-29\n                </div>\n                <div class=\"topic-tags\">\n                    <span class=\"topic-tag\">AI security</span>\n                    <span class=\"topic-tag\">prompt injection</span>\n                    <span class=\"topic-tag\">Copilot</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/2026/Jul/28/discovering-cryptographic-weaknesses-with-claude/\" target=\"_blank\" class=\"accent-link\">Crypto Analysis with Claude</a>\n                    <span class=\"badge technical\">Research</span>\n                </div>\n                <div class=\"item-description\">\n                    Claude Mythos used for 60 hours (~$100,000) to find mathematical flaws in HAWK and weaker AES version.\n                </div>\n                <div class=\"item-meta\">\n                    Simon Willison | 2026-07-28\n                </div>\n                <div class=\"topic-tags\">\n                    <span class=\"topic-tag\">cryptanalysis</span>\n                    <span class=\"topic-tag\">Claude</span>\n                    <span class=\"topic-tag\">HAWK</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/2026/Jul/28/anatomy-of-a-frontier-lab-agent-intrusion/\" target=\"_blank\" class=\"accent-link\">Frontier Lab Agent Intrusion</a>\n                    <span class=\"badge technical\">Security</span>\n                </div>\n                <div class=\"item-description\">\n                    OpenAI attack exploited zero-day in JFrog's Artifactory, used Jinja2 template injection and Tailscale for exfiltration.\n                </div>\n                <div class=\"item-meta\">\n                    Simon Willison | 2026-07-28\n                </div>\n                <div class=\"topic-tags\">\n                    <span class=\"topic-tag\">cybersecurity</span>\n                    <span class=\"topic-tag\">OpenAI</span>\n                    <span class=\"topic-tag\">zero-day</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/2026/Jul/27/kimi-k3/\" target=\"_blank\" class=\"accent-link\">Kimi K3 Released</a>\n                    <span class=\"badge opinion\">Opinion</span>\n                </div>\n                <div class=\"item-description\">\n                    Moonshot AI released Kimi K3's 1.56TB weights under modified license. Available on OpenRouter at $3/M input.\n                </div>\n                <div class=\"item-meta\">\n                    Simon Willison | 2026-07-27\n                </div>\n                <div class=\"topic-tags\">\n                    <span class=\"topic-tag\">AI models</span>\n                    <span class=\"topic-tag\">Kimi K3</span>\n                    <span class=\"topic-tag\">OpenRouter</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/2026/Jul/25/ruff/\" target=\"_blank\" class=\"accent-link\">Ruff v0.16.0</a>\n                    <span class=\"badge technical\">Tool</span>\n                </div>\n                <div class=\"item-description\">\n                    Python linter now enables 413 rules by default (up from 59), catching syntax errors and runtime issues.\n                </div>\n                <div class=\"item-meta\">\n                    Simon Willison | 2026-07-25\n                </div>\n                <div class=\"topic-tags\">\n                    <span class=\"topic-tag\">Python</span>\n                    <span class=\"topic-tag\">Ruff</span>\n                    <span class=\"topic-tag\">linting</span>\n                </div>\n            </div>\n\n            <div class=\"content-item\">\n                <div class=\"item-title\">\n                    <a href=\"https://simonwillison.net/2026/Jul/24/introducing-claude-opus-5/\" target=\"_blank\" class=\"accent-link\">Claude Opus 5</a>\n                    <span class=\"badge opinion\">Opinion</span>\n                </div>\n                <div class=\"item-description\">\n                    Anthropic released Opus 5, described as \"thoughtful and proactive model\" at half the price of frontier models.\n                </div>\n                <div class=\"item-meta\">\n                    Simon Willison | 2026-07-24\n                </div>\n                <div class=\"topic-tags\">\n                    <span class=\"topic-tag\">Claude</span>\n                    <span class=\"topic-tag\">Opus 5</span>\n                    <span class=\"topic-tag\">Anthropic</span>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <footer>\n        <p>\n            Generated with <a href=\"#\">Claude Code</a> |\n            <a href=\"#\">Archive</a> |\n            <a href=\"#\">Methodology</a> |\n            <a href=\"#\">About</a>\n        </p>\n        <p style=\"margin-top: 8px;\">\n            Covering agentic coding tools, AI IDEs, and developer productivity enhancements\n        </p>\n    </footer>\n</body>\n</html>"
