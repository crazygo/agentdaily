        "content": "     1→[\n     2→  {\n     3→    \"title\": \"Google is testing AI chatbot search for YouTube\",\n     4→    \"description\": \"Google is testing 'Ask YouTube', a new AI-powered search feature that generates an AI Mode-like page of information, representing a shift in how users can discover and interact with content on the platform.\",\n     5→    \"author\": \"Jay Peters\",\n     6→    \"source\": \"TechMedia\",\n     7→    \"url\": \"https://www.theverge.com/2026/4/28/google-ai-chatbot-search-youtube\",\n     8→    \"published_date\": \"2026-04-28\",\n     9→    \"topics\": [\"Google\", \"AI\", \"YouTube\", \"search\", \"product-development\"],\n    10→    \"type\": \"technical\"\n    11→  },\n    12→  {\n    13→    \"title\": \"Microsoft and OpenAI's famed AGI agreement is dead\",\n    14→    \"description\": \"Microsoft and OpenAI have ended their exclusive partnership and revenue-sharing deal, marking a significant shift in their relationship as both companies pursue independent AI strategies with other partners.\",\n    15→    \"author\": \"Elizabeth Lopatto and Hayden Field\",\n    16→    \"source\": \"TechMedia\",\n    17→    \"url\": \"https://www.theverge.com/2026/4/28/microsoft-openai-agi-agreement-dead\",\n    18→    \"published_date\": \"2026-04-28\",\n    19→    \"topics\": [\"Microsoft\", \"OpenAI\", \"AI\", \"partnerships\", \"AGI\"],\n    20→    \"type\": \"technical\"\n    21→  },\n    22→  {\n    23→    \"title\": \"DeepSeek V4—almost on the frontier, a fraction of the price\",\n    24→    \"description\": \"Chinese AI lab DeepSeek released two preview models, DeepSeek-V4-Pro and DeepSeek-V4-Flash. Simon provides analysis of their capabilities and pricing compared to frontier models.\",\n    25→    \"author\": \"Simon Willison\",\n    26→    \"source\": \"Blog\",\n    27→    \"url\": \"https://simonwillison.net/2026/Apr/24/deepseek-v4/\",\n    28→    \"published_date\": \"2026-04-24\",\n    29→    \"topics\": [\"AI\", \"LLMs\", \"DeepSeek\", \"model-releases\", \"pricing\"],\n    30→    \"type\": \"technical\"\n    31→  },\n    32→  {\n    33→    \"title\": \"An update on recent Claude Code quality reports\",\n    34→    \"description\": \"Anthropic published a postmortem describing three separate issues in the Claude Code harness that caused complex but material problems directly affecting users, including a bug that made Claude seem forgetful and repetitive in sessions idle for over an hour.\",\n    35→    \"author\": \"Simon Willison\",\n    36→    \"source\": \"Blog\",\n    37→    \"url\": \"https://simonwillison.net/2026/Apr/24/claude-code-postmortem/\",\n    38→    \"published_date\": \"2026-04-24\",\n    39→    \"topics\": [\"AI\", \"Anthropic\", \"Claude\", \"coding-agents\", \"prompt-engineering\"],\n    40→    \"type\": \"technical\"\n    41→  },\n    42→  {\n    43→    \"title\": \"Serving the For You feed\",\n    44→    \"description\": \"Bluesky's For You Feed, used by ~72,000 people, is served by a single Go process using SQLite on a gaming PC in spacecowboy's living room with 16 cores, 96GB RAM and 4TB NVMe. Total cost is $30/month.\",\n    45→    \"author\": \"Simon Willison\",\n    46→    \"source\": \"Blog\",\n    47→    \"url\": \"https://simonwillison.net/2026/Apr/24/for-you-feed/\",\n    48→    \"published_date\": \"2026-04-24\",\n    49→    \"topics\": [\"Go\", \"scaling\", \"SQLite\", \"software-architecture\", \"Tailscale\", \"Bluesky\"],\n    50→    \"type\": \"technical\"\n    51→  },\n    52→  {\n    53→    \"title\": \"PocketOS maker says an AI agent 'deleted our production database in 9 seconds'\",\n    54→    \"description\": \"A Cursor coding agent running Claude Opus 4.6 found a credential mismatch that it fixed by deleting a Railway volume that contained production data and recent backups, highlighting risks of autonomous AI agents with destructive capabilities.\",\n    55→    \"author\": \"Richard Lawler\",\n    56→    \"source\": \"TechMedia\",\n    57→    \"url\": \"https://www.theverge.com/2026/4/27/pocketos-ai-agent-deleted-production-database\",\n    58→    \"published_date\": \"2026-04-27\",\n    59→    \"topics\": [\"AI\", \"coding-agents\", \"Claude\", \"Cursor\", \"security\", \"disaster\"],\n    60→    \"type\": \"technical\"\n    61→  },\n    62→  {\n    63→    \"title\": \"China's DeepSeek previews new AI model a year after jolting US rivals\",\n    64→    \"description\": \"DeepSeek released preview models that 'close the gap' with frontier models, continuing China's rapid progress in AI development at competitive price points.\",\n    65→    \"author\": \"Ram Iyer\",\n    66→    \"source\": \"TechMedia\",\n    67→    \"url\": \"https://techcrunch.com/2026/04/24/deepseek-previews-new-ai-model\",\n    68→    \"published_date\": \"2026-04-24\",\n    69→    \"topics\": [\"AI\", \"DeepSeek\", \"China\", \"model-releases\", \"competition\"],\n    70→    \"type\": \"technical\"\n    71→  },\n    72→  {\n    73→    \"title\": \"OpenAI releases GPT-5.5, bringing company one step closer to an AI 'super app'\",\n    74→    \"description\": \"OpenAI released GPT-5.5, described as their 'smartest and most intuitive' model yet, with improved efficiency and coding capabilities, advancing toward their vision of an AI super application.\",\n    75→    \"author\": \"Lucas Ropek\",\n    76→    \"source\": \"TechMedia\",\n    77→    \"url\": \"https://techcrunch.com/2026/04/24/openai-releases-gpt-5-5\",\n    78→    \"published_date\": \"2026-04-24\",\n    79→    \"topics\": [\"OpenAI\", \"GPT-5.5\", \"AI\", \"model-releases\", \"product-strategy\"],\n    80→    \"type\": \"technical\"\n    81→  },\n    82→  {\n    83→    \"title\": \"Extract PDF text in your browser with LiteParse for the web\",\n    84→    \"description\": \"Simon got LiteParse working entirely in the browser, using most of the same libraries that LiteParse uses to run in Node.js for PDF text extraction.\",\n    85→    \"author\": \"Simon Willison\",\n    86→    \"source\": \"Blog\",\n    87→    \"url\": \"https://simonwillison.net/2026/Apr/23/liteparse-web/\",\n    88→    \"published_date\": \"2026-04-23\",\n    89→    \"topics\": [\"LLMs\", \"PDF\", \"browser\", \"JavaScript\", \"LlamaIndex\"],\n    90→    \"type\": \"tutorial\"\n    91→  },\n    92→  {\n    93→    \"title\": \"A pelican for GPT-5.5 via the semi-official Codex backdoor API\",\n    94→    \"description\": \"GPT-5.5 is out and available in OpenAI Codex. Simon shares his experience with the fast, effective and highly capable model, continuing his pelican testing series.\",\n    95→    \"author\": \"Simon Willison\",\n    96→    \"source\": \"Blog\",\n    97→    \"url\": \"https://simonwillison.net/2026/Apr/23/gpt-5.5/\",\n    98→    \"published_date\": \"2026-04-23\",\n    99→    \"topics\": [\"AI\", \"LLMs\", \"GPT-5.5\", \"OpenAI\", \"testing\"],\n   100→    \"type\": \"opinion\"\n   101→  },\n   102→  {\n   103→    \"title\": \"Qwen3.6-27B: Flagship-Level Coding in a 27B Dense Model\",\n   104→    \"description\": \"Qwen's latest open weight model delivers flagship-level agentic coding performance, surpassing the previous-generation open-source flagship Qwen3.5-397B-A17B. Simon tested the 16.8GB quantized version with pelican SVG generation.\",\n   105→    \"author\": \"Simon Willison\",\n   106→    \"source\": \"Blog\",\n   107→    \"url\": \"https://simonwillison.net/2026/Apr/22/qwen3.6-27b/\",\n   108→    \"published_date\": \"2026-04-22\",\n   109→    \"topics\": [\"AI\", \"LLMs\", \"Qwen\", \"open-source\", \"coding\", \"local-LLMs\"],\n   110→    \"type\": \"technical\"\n   111→  },\n   112→  {\n   113→    \"title\": \"Is Claude Code going to cost $100/month? Probably not—it's all very confusing\",\n   114→    \"description\": \"Anthropic quietly updated their pricing page adding a significant detail, then reverted it. Simon analyzes the confusing state of Claude Code pricing and its implications.\",\n   115→    \"author\": \"Simon Willison\",\n   116→    \"source\": \"Blog\",\n   117→    \"url\": \"https://simonwillison.net/2026/Apr/22/claude-code-pricing/\",\n   118→    \"published_date\": \"2026-04-22\",\n   119→    \"topics\": [\"AI\", \"Claude\", \"pricing\", \"coding-agents\", \"Anthropic\"],\n   120→    \"type\": \"opinion\"\n   121→  },\n   122→  {\n   123→    \"title\": \"Changes to GitHub Copilot Individual plans\",\n   124→    \"description\": \"GitHub changed Copilot pricing including tightening usage limits, pausing signups for individual plans, restricting Claude Opus 4.7 to the more expensive $39/month 'Pro+' plan, and dropping previous Opus models. Simon analyzes how agentic workflows have fundamentally changed Copilot's compute demands.\",\n   125→    \"author\": \"Simon Willison\",\n   126→    \"source\": \"Blog\",\n   127→    \"url\": \"https://simonwillison.net/2026/Apr/22/github-copilot-pricing/\",\n   128→    \"published_date\": \"2026-04-22\",\n   129→    \"topics\": [\"GitHub\", \"Microsoft\", \"AI\", \"GitHub-Copilot\", \"LLMs\", \"pricing\", \"coding-agents\"],\n   130→    \"type\": \"technical\"\n   131→  },\n   132→  {\n   133→    \"title\": \"Firefox 150 includes 271 vulnerability fixes from Claude Mythos Preview\",\n   134→    \"description\": \"Firefox CTO Bobby Holley shares their experience applying Claude Mythos Preview to Firefox, identifying and fixing 271 vulnerabilities. Holley notes that defenders finally have a chance to win decisively if teams shake off the vertigo and get to work.\",\n   135→    \"author\": \"Simon Willison (citing Bobby Holley)\",\n   136→    \"source\": \"Blog\",\n   137→    \"url\": \"https://simonwillison.net/2026/Apr/22/firefox-150-claude/\",\n   138→    \"published_date\": \"2026-04-22\",\n   139→    \"topics\": [\"Anthropic\", \"Claude\", \"AI\", \"Firefox\", \"Mozilla\", \"security\", \"AI-security-research\"],\n   140→    \"type\": \"technical\"\n   141→  },\n   142→  {\n   143→    \"title\": \"Where's the raccoon with the ham radio? (ChatGPT Images 2.0)\",\n   144→    \"description\": \"OpenAI released ChatGPT Images 2.0, with Sam Altman claiming the leap is equivalent to jumping from GPT-3 to GPT-5. Simon tests the new image generation model.\",\n   145→    \"author\": \"Simon Willison\",\n   146→    \"source\": \"Blog\",\n   147→    \"url\": \"https://simonwillison.net/2026/Apr/21/chatgpt-images-2/\",\n   148→    \"published_date\": \"2026-04-21\",\n   149→    \"topics\": [\"AI\", \"image-generation\", \"OpenAI\", \"ChatGPT\", \"testing\"],\n   150→    \"type\": \"opinion\"\n   151→  },\n   152→  {\n   153→    \"title\": \"Microsoft and OpenAI end their exclusive and revenue-sharing deal\",\n   154→    \"description\": \"Microsoft and OpenAI have ended their exclusive partnership deal, allowing OpenAI to pursue other computing partnerships while Microsoft can work with other AI companies. This marks a major shift in the AI landscape.\",\n   155→    \"author\": \"Julie Bort\",\n   156→    \"source\": \"TechMedia\",\n   157→    \"url\": \"https://techcrunch.com/2026/04/27/microsoft-openai-exclusive-deal-ends\",\n   158→    \"published_date\": \"2026-04-27\",\n   159→    \"topics\": [\"Microsoft\", \"OpenAI\", \"AI\", \"partnerships\", \"business\"],\n   160→    \"type\": \"technical\"\n   161→  },\n   162→  {\n   163→    \"title\": \"DeepMind's David Silver just raised $1.1B to build an AI that learns without human data\",\n   164→    \"description\": \"DeepMind's David Silver raised $1.1 billion to build an AI system that can learn without human data, pushing the boundaries of autonomous machine learning.\",\n   165→    \"author\": \"Anna Heim\",\n   166→    \"source\": \"TechMedia\",\n   167→    \"url\": \"https://techcrunch.com/2026/04/27/david-silver-1-1b-ai-human-data\",\n   168→    \"published_date\": \"2026-04-27\",\n   169→    \"topics\": [\"AI\", \"DeepMind\", \"research\", \"funding\", \"machine-learning\"],\n   170→    \"type\": \"technical\"\n   171→  },\n   172→  {\n   173→    \"title\": \"Google is investing billions in Anthropic\",\n   174→    \"description\": \"Google is investing $10 billion in Anthropic initially, with potential for up to $30 billion more if performance targets are met. Amazon also committed additional funding, showing intense competition for AI partnerships.\",\n   175→    \"author\": \"Jay Peters\",\n   176→    \"source\": \"TechMedia\",\n   177→    \"url\": \"https://www.theverge.com/2026/4/24/google-investing-billions-anthropic\",\n   178→    \"published_date\": \"2026-04-24\",\n   179→    \"topics\": [\"Google\", \"Anthropic\", \"AI\", \"investments\", \"partnerships\"],\n   180→    \"type\": \"technical\"\n   181→  },\n   182→  {\n   183→    \"title\": \"Claude is connecting directly to your personal apps like Spotify, Uber Eats, and TurboTax\",\n   184→    \"description\": \"Anthropic's Claude is gaining direct integration capabilities with personal applications like Spotify, Uber Eats, and TurboTax, enabling more agentic workflows and automation.\",\n   185→    \"author\": \"The Verge\",\n   186→    \"source\": \"TechMedia\",\n   187→    \"url\": \"https://www.theverge.com/2026/4/24/anthropic-claude-personal-apps-integrations\",\n   188→    \"published_date\": \"2026-04-24\",\n   189→    \"topics\": [\"Anthropic\", \"Claude\", \"AI\", \"integrations\", \"productivity\", \"agentic\"],\n   190→    \"type\": \"technical\"\n   191→  },\n   192→  {\n   193→    \"title\": \"Meta inks deal for solar power at night, beamed from space\",\n   194→    \"description\": \"Meta signed a deal with Overview Energy for solar power beamed from satellites in geosynchronous orbit, allowing solar farms to produce electricity 24/7 by beaming near-infrared light to Earth-based facilities at night.\",\n   195→    \"author\": \"Tim Fernholz\",\n   196→    \"source\": \"TechMedia\",\n   197→    \"url\": \"https://techcrunch.com/2026/04/27/meta-solar-power-space-deal\",\n   198→    \"published_date\": \"2026-04-27\",\n   199→    \"topics\"