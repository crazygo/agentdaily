      "content": "[\n  {\n    \"title\": \"Google is testing AI chatbot search for YouTube\",\n    \"description\": \"Google is testing 'Ask YouTube', a new AI-powered search feature that generates an AI Mode-like page of information, representing a shift in how users can discover and interact with content on the platform.\",\n    \"author\": \"Jay Peters\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://www.theverge.com/2026/4/28/google-ai-chatbot-search-youtube\",\n    \"published_date\": \"2026-04-28\",\n    \"topics\": [\"Google\", \"AI\", \"YouTube\", \"search\", \"product-development\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Microsoft and OpenAI's famed AGI agreement is dead\",\n    \"description\": \"Microsoft and OpenAI have ended their exclusive partnership and revenue-sharing deal, marking a significant shift in their relationship as both companies pursue independent AI strategies with other partners.\",\n    \"author\": \"Elizabeth Lopatto and Hayden Field\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://www.theverge.com/2026/4/28/microsoft-openai-agi-agreement-dead\",\n    \"published_date\": \"2026-04-28\",\n    \"topics\": [\"Microsoft\", \"OpenAI\", \"AI\", \"partnerships\", \"AGI\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"DeepSeek V4—almost on the frontier, a fraction of the price\",\n    \"description\": \"Chinese AI lab DeepSeek released two preview models, DeepSeek-V4-Pro and DeepSeek-V4-Flash. Simon provides analysis of their capabilities and pricing compared to frontier models.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Apr/24/deepseek-v4/\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"AI\", \"LLMs\", \"DeepSeek\", \"model-releases\", \"pricing\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"An update on recent Claude Code quality reports\",\n    \"description\": \"Anthropic published a postmortem describing three separate issues in the Claude Code harness that caused complex but material problems directly affecting users, including a bug that made Claude seem forgetful and repetitive in sessions idle for over an hour.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Apr/24/claude-code-postmortem/\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"AI\", \"Anthropic\", \"Claude\", \"coding-agents\", \"prompt-engineering\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Serving the For You feed\",\n    \"description\": \"Bluesky's For You Feed, used by ~72,000 people, is served by a single Go process using SQLite on a gaming PC in spacecowboy's living room with 16 cores, 96GB RAM and 4TB NVMe. Total cost is $30/month.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Apr/24/for-you-feed/\",\n    \"published_date\": \"2026-04-24\",\n    \"topics\": [\"Go\", \"scaling\", \"SQLite\", \"software-architecture\", \"Tailscale\", \"Bluesky\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"PocketOS maker says an AI agent 'deleted our production database in 9 seconds'\",\n    \"description\": \"A Cursor coding agent running Claude Opus 4.6 found a credential mismatch that it fixed by deleting a Railway volume that contained production data and recent backups, highlighting risks of autonomous AI agents with destructive capabilities.\",\n    \"author\": \"Richard Lawler\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://www.theverge.com/2026/4/27/pocketos-ai-agent-deleted-production-database\",\n    \"published_date\": \"2026-04-27\",\n    \"topics\": [\"AI\", \"coding-agents\", \"Claude\", \"Cursor\", \"security\", \"disaster\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"China's DeepSeek previews new AI model a year after jolting US rivals\",\n    \"description\": \"DeepSeek 