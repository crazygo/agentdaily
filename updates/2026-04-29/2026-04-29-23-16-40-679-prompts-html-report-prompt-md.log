      "filePath": "/home/runner/work/agentdaily/agentdaily/updates/2026-04-29/whitelist-updates.json",
      "content": "[\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor SDK Launch\",\n    \"description\": \"We're introducing the Cursor SDK so you can build agents with the same runtime, harness, and models that power Cursor. Build programmatic agents that can write code, run commands, use tools, and collaborate with you in real-time.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-29\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 2.1.1029 - Devin for Terminal Improvements\",\n    \"description\": \"Updated Devin Local agent to respect existing Windsurf proxy settings. Devin for Terminal now properly inherits proxy configuration from Windsurf settings.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://windsurf.com/changelog/windsurf-next\",\n    \"date\": \"2026-04-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Critical Security Fixes\",\n    \"description\": \"Addressed three critical/high security findings from AI Tooling Security Audit. Fixed subagent permission bypass (Critical), added writeFile boundary checks (High), and fixed policy bypass vulnerability (High). Security dependency updates for dompurify, rand, and axios packages.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://github.com/continuedev/continue/pull/12248\",\n    \"date\": \"2026-04-28\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Version 2.1.1026 - Devin for Terminal Launch\",\n    \"description\": \"Devin is now available for Terminal. All Windsurf users can use this new CLI agent that brings Devin's AI-powered software development capabilities directly to the terminal environment.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog/windsurf-next\",\n    \"date\": \"2026-04-27\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Code Review Billing Changes - GitHub Actions Minutes\",\n    \"description\": \"Starting June 1, 2026, Copilot code review will be billed in two ways: AI Credits under the new usage-based billing model, plus GitHub Actions minutes consumption for reviews on private repositories. This affects Copilot Pro, Pro+, Business, and Enterprise plans.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/2026-04-27-github-copilot-code-review-will-start-consuming-github-actions-minutes-on-june-1-2026/\",\n    \"date\": \"2026-04-27\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Any change is significant to our customers, especially when it relates to billing\",\n        \"source\": \"GitHub Blog\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Cloud Agent Performance Improvement\",\n    \"description\": \"Copilot cloud agent now starts over 20% faster thanks to optimized runner environments built with GitHub Actions custom images. The improvement affects agent sessions when assigning issues to Copilot or starting tasks.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/month/04-2026/\",\n    \"date\": \"2026-04-27\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GPT-5.3-Codex Removal from Student Plan Model Picker\",\n    \"description\": \"GitHub removed GPT-5.3-Codex from the model picker in the Copilot Student plan, though it remains available through auto model selection which matches each request to the optimal model.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://github.blog/changelog/month/04-2026/\",\n    \"date\": \"2026-04-27\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Version 0.39.0 Major Release\",\n    \"description\": \"Major release featuring unified invoke_subagent tool, new /memory inbox command for skill review, strategic re-evaluation guidance in system prompt, JSONL streaming for chat recording, and significant memory leak fixes.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/google-gemini/gemini-cli/releases/tag/v0.39.0\",\n    \"date\": \"2026-04-23\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Genuine question: how is Gemini CLI still so far behind?\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"As of April 4th, 2026 there is still no desktop app for Gemini!\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Version 0.41.0-nightly.20260423\",\n    \"description\": \"Nightly build with ripgrep binaries bundled for offline support, GitHub colorblind themes, local model setup command 'gemini gemma', new MCP resource listing tools, security fixes for command injection and RCE vulnerabilities.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.com/google-gemini/gemini-cli/releases/tag/v0.41.0-nightly.20260423.gd1c91f526\",\n    \"date\": \"2026-04-23\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Chat Improvements for Pull Requests\",\n    \"description\": \"GitHub Copilot Chat now provides richer context and new capabilities when working with diffs and pull requests, allowing developers to ask questions about PRs and receive more relevant feedback.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/month/04-2026/\",\n    \"date\": \"2026-04-23\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"View and Manage Agent Sessions from Issues and Projects\",\n    \"description\": \"Users can now view and steer cloud agent sessions directly from issues and projects, providing better visibility into agent activity without leaving the workflow. Features a session pill interface and improved management capabilities.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/month/04-2026/\",\n    \"date\": \"2026-04-23\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Cloud Agent Fields Added to Usage Metrics\",\n    \"description\": \"The Copilot usage metrics API now includes a new 'used_copilot_cloud_agent' field in user-level reports following the Copilot coding agent to Copilot cloud agent rename. This boolean field helps track agent usage.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/month/04-2026/\",\n    \"date\": \"2026-04-23\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Better Debugging with GitHub Copilot on the Web\",\n    \"description\": \"GitHub Copilot Chat on github.com helps developers get to the root cause of errors faster when pasting stack traces. Copilot now recognizes stack traces more reliably and provides improved debugging assistance.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/month/04-2026/\",\n    \"date\": \"2026-04-23\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"IntelliJ File Search Limits Fix\",\n    \"description\": \"Applied file search limits in IntelliJ extension to prevent token threshold errors. Integrated maxResults parameter and aligned behavior with VS Code implementation.\",\n    \"updateType\": \"bugfix\",\n    \"url\": \"https://github.com/continuedev/continue/pull/11974\",\n    \"date\": \"2026-04-22\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Pausing Self-Serve Signups for Copilot Business\",\n    \"description\": \"GitHub is pausing new self-serve signups for GitHub Copilot Business for organizations on GitHub Free and GitHub Team plans to ensure a reliable and sustainable Copilot experience. Existing customers are not affected.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/2026-04-22-pausing-new-self-serve-signups-for-github-copilot-business/\",\n    \"date\": \"2026-04-22\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Multiple Version Releases (v2.1.105–v2.1.119)\",\n    \"description\": \"Rapid release cycle across three weeks with 15 versions shipped, culminating in v2.1.119 by April 24. Major improvements include native binary migration, Opus 4.7 integration, Routines, Ultrareview public preview, and performance optimizations including 67% faster /resume on large sessions.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-04-24\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Claude Code has excellent UX for developers comfortable with chat-based assistance with a gentle learning curve and automatic project onboarding\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor 3.2: Multitask, Worktrees, and Multi-root Workspaces\",\n    \"description\": \"Cursor 3.2 introduces a new way to handle multiple tasks through asynchronous sub-agents that work in parallel, improved worktree experience for running isolated tasks on different branches in the background, and multi-root workspaces that allow a single agent session to target reusable workspaces composed of multiple folders for cross-repository modifications.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Bugbot MCP Support and Enhanced Auto-Fix\",\n    \"description\": \"Bugbot now supports MCP (Model Context Protocol) servers, allowing it to access additional context during code reviews. The update also includes improved Bugbot auto-fix capabilities and the highest resolution rate to date.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GPT-5.5 Generally Available\",\n    \"description\": \"OpenAI's latest GPT-5.5 model is now rolling out to GitHub Copilot, delivering improved performance on complex, multi-step agentic coding tasks. The model features a 1M token context window and a 7.5× premium request multiplier as part of promotional pricing.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-04-24-gpt-5-5-is-generally-available-for-github-copilot/\",\n    \"date\": \"2026-04-24\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"The reaction from developers was pretty split\",\n        \"source\": \"MindStudio\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Developers reported that GPT-5.5 is 'much better' than previous models with improved speed and performance\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Priced higher than GPT-5.4, but it's 'both more intelligent and much more token efficient'\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Inline Agent Mode in Preview for JetBrains IDEs\",\n    \"description\": \"GitHub Copilot for JetBrains IDEs introduces inline agent mode in preview, along with enhancements to Next Edit Suggestions, global auto approve, and more flexible controls for terminal commands and file edits.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/month/04-2026/\",\n    \"date\": \"2026-04-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Cursor Partners with SpaceX on Model Training\",\n    \"description\": \"Cursor announced a partnership with SpaceX for model training, though specific details of the collaboration were not disclosed in the brief announcement.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://cursor.com/blog/cursor-partners-with-spacex-on-model-training\",\n    \"date\": \"2026-04-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Keeping the Cursor App Stable\",\n    \"description\": \"Engineering team shares insights on maintaining application stability at scale, discussing the technical challenges and solutions for ensuring reliable performance as Cursor continues to grow.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://cursor.com/blog/keeping-the-cursor-app-stable\",\n    \"date\": \"2026-04-21\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Inception Labs Mercury-2 Model Support\",\n    \"description\": \"Added support for Inception Labs' mercury-2 model (128k context, tool-calling), mercury-edit-2 and mercury-coder-small models. Flagged as tool-capable with OpenAI-compatible API. Added Inception Labs provider to GUI Add Chat Model form.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.com/continuedev/continue/pull/12156\",\n    \"date\": \"2026-04-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"/ultrareview Public Research Preview\",\n    \"description\": \"Cloud-based code review that runs a fleet of bug-hunting agents in parallel against branches or PRs. Findings land back in CLI or Desktop automatically with verified reports, designed for critical changes like auth or data migrations.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w17\",\n    \"date\": \"2026-04-20\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"If you don't want to ship bugs to production, Claude Code ultra review is a new way to catch bugs before you deploy\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"On small PRs under 50 lines, it's fast and catches obvious issues, with Anthropic reporting a 31% finding rate on small PRs\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Automatic Session Recaps\",\n    \"description\": \"When returning to a terminal session, users now see a one-line recap of what happened while they were away. This helps maintain flow when running multiple Claude sessions simultaneously. Can be generated on demand with /recap or disabled from /config.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w17\",\n    \"date\": \"2026-04-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Custom Color Themes\",\n    \"description\": \"Users can now build and switch between named color themes from /theme or edit JSON files in ~/.claude/themes/. Each theme picks a base preset and overrides specific tokens. Plugins can also ship themes, and an 'Auto (match terminal)' option follows the terminal's dark/light mode.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w17\",\n    \"date\": \"2026-04-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Claude Code on the Web Redesign\",\n    \"description\": \"A completely redesigned web interface at claude.ai/code featuring a sessions sidebar, drag-and-drop layout, and refreshed routines view. Key components were rebuilt for quicker responses and more reliable experience.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w17\",\n    \"date\": \"2026-04-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Vim Visual Mode Support\",\n    \"description\": \"Added Vim visual mode in the prompt input with 'v' for character selection or 'V' for line selection, including operators and visual feedback for Vim users.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w17\",\n    \"date\": \"2026-04-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Canvases: Interactive Agent-Created Visualizations\",\n    \"description\": \"Cursor Canvases enable AI agents to create interactive visualizations instead of just text responses, including dashboards and custom interfaces using tables, boxes, diagrams, and charts. Canvases persist in the agent window sidebar alongside terminals, browsers, and version control.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/blog/interact-with-agent-created-visualizations-in-canvases\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Better AI Models Enable More Ambitious Work\",\n    \"description\": \"Research blog post discussing how improvements in AI model quality are enabling Cursor agents to handle more ambitious and complex software development tasks, reflecting the ongoing evolution of AI-powered coding capabilities.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://cursor.com/blog/better-ai-models-enable-more-ambitious-work\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Claude Opus 4.7 with xhigh Effort Level\",\n    \"description\": \"Anthropic's strongest coding model yet became the default on Max and Team Premium plans, introducing a new 'xhigh' effort level between 'high' and 'max' for optimal coding performance. The update also includes an interactive /effort slider for dialing intelligence against speed.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w16\",\n    \"date\": \"2026-04-13\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Opus 4.7 feels more intelligent, agentic, and precise than 4.6\",\n        \"source\": \"X\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Adaptive thinking requirement in Claude Opus 4.7 is bad in the ways that all AI effort routers are bad, but magnified\",\n        \"source\": \"X\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Routines - Scheduled Cloud Agents\",\n    \"description\": \"Templated cloud agents that fire on a schedule, GitHub event, or API call. Users can define routines once on Claude Code on the web with prompts, repos, and connectors, then trigger them via PR-opened, release-published events, or webhooks without their machine running.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w16\",\n    \"date\": \"2026-04-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Native Binaries Replace Bundled JavaScript\",\n    \"description\": \"The CLI now spawns a native per-platform binary instead of bundled JavaScript, so the installed claude command no longer invokes Node. The npm package pulls the right binary through optional dependencies, matching the standalone installer.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w16\",\n    \"date\": \"2026-04-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"/usage Breakdown and Insights\",\n    \"description\": \"Enhanced visibility into usage patterns with /usage now showing what's driving limits: parallel sessions, subagents, cache misses, and long context. Each category shows percentage of last 24 hours with optimization tips. Press 'd' or 'w' to switch between day and week views.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new/2026-w16\",\n    \"date\": \"2026-04-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Tiled Layout and Upgraded Voice Input in Agents Window\",\n    \"description\": \"Cursor 3.1 brings tiled layout to split views into multiple panes for running and managing multiple agents in parallel, upgraded voice input with more reliable batch speech-to-text transcription, and the ability to select branches before launching cloud agents from a blank state to reduce branch switching steps.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Speeding Up GPU Kernels by 38% with Multi-Agent System\",\n    \"description\": \"Research team achieved a 38% speedup in GPU kernel performance using a multi-agent system, demonstrating the power of AI agents in optimizing low-level systems code.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://cursor.com/blog/speeding-up-gpu-kernels-by-38-with-a-multi-agent-system\",\n    \"date\": \"2026-04-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Search Files with Include/Exclude Filters\",\n    \"description\": \"New feature allowing developers to use include/exclude filters in the 'Search in Files' functionality to scope code searches to specific file sets.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Jump to File from Diff\",\n    \"description\": \"Users can now jump directly from a diff to the corresponding line in the file, enabling full use of editor features including manual modifications, Tab completion, go-to-definition, and more.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-04-14\",\n    \"community_feedback\": []\n  }\n]",
      "numLines": 405,
      "startLine": 1,
      "totalLines": 405
    }
  }
}

