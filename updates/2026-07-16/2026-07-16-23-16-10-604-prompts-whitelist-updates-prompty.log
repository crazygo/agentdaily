  "new_string": "[\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Quote Text in Your Messages\",\n    \"description\": \"New feature allows selecting text from files, worklog, or Devin's messages and quoting it in conversations for better context.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-07-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot in Visual Studio — June Update\",\n    \"description\": \"Focus on visibility and trust with clearer view of GitHub Copilot usage, new trust layer for MCP. Released July 14, 2026.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog/2026-07-14-github-copilot-in-visual-studio-june-update/\",\n    \"date\": \"2026-07-14\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Github copilot being bugged garbage is specific for Visual... unstable\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Copilot Request Spike After Visual Studio Insiders Update - reported request usage issues\",\n        \"source\": \"GitHub Community\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot for JetBrains Improvements\",\n    \"description\": \"Expansion updates for JetBrains IDE users with new features and improvements.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/label/copilot/\",\n    \"date\": \"2026-07-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"In-app browser on Desktop\",\n    \"description\": \"Claude Code on desktop gets a built-in browser, so Claude can pull up docs, designs, or any other site. Also includes /doctor command for setup diagnosis and auto mode safety improvements.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-07-10\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Claude Code's reaction to GPT 5.6 competition - compared GPT-5.6 to Fable from cost perspective\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Side Chats, Conversation Search, and Automations\",\n    \"description\": \"New side chats for parallel conversations, conversation search across transcripts, improved automations with /automate skill, new GitHub and Slack triggers, iOS mobile app with remote control, and Team MCPs support.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-07-10\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Cursor v3.11 Side Chats: Developer Guide for Parallel Agent - Addresses parallel agent workflow requests\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Cursor Automations upgrades - moves Cursor from IDE copilot to more advanced functionality\",\n        \"source\": \"Blog\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"GPT-5.6 Release\",\n    \"description\": \"OpenAI released GPT-5.6 on July 9, 2026. The model is available across ChatGPT, Codex, and the OpenAI API with rollout to full availability. GPT-5.6 Sol became the default coding model in OpenAI Codex.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://openai.com/index/gpt-5-6/\",\n    \"date\": \"2026-07-09\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"GPT-5.6 Sol Ultra will be in Codex - discussion comparing Chinese lab models and relevance\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"GPT-5.6 Terra scoring worse than GPT-5.5 on benchmarks - Terra described as 'GPT-5.6-mini'\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Generally praised for complex coding tasks and long-running agent workflows\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"GPT-5.6 is available in ChatGPT through the web browser, also available in Codex\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Your experience using 5.6 - public release began around July 9, 2026\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Preview release v0.51.0-preview.0 and Stable v0.50.0\",\n    \"description\": \"Preview and stable releases both on July 8, 2026. Updates include CLI and core stability fixes, updated default auto routing, sequential tool execution, and usage metadata exposure.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://geminicli.com/docs/changelogs/\",\n    \"date\": \"2026-07-08\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Are there plans to make gemini cli good? - user expressed frustration with the CLI\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Gemini CLI was discontinued on June 18, 2026 for consumer users, replaced by Antigravity CLI\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Codex as agent provider in JetBrains IDEs\",\n    \"description\": \"On July 7, 2026, Codex became available as a new agent provider in public preview for JetBrains IDEs, expanding Customizations editor with Hooks support.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog/2026-07-07-codex-as-agent-provider-and-agentic-enhancements-in-jetbrains-ides/\",\n    \"date\": \"2026-07-07\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Diff Line feature and machine configuration updates\",\n    \"description\": \"July 3, 2026 update introduced Diff Line feature. Classic machine configurations stay available as read-only reference until July 31, 2026. Includes automatic bug fixes.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-07-03\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Diff Line Permalinks - useful for pointing teammates to exact code locations\",\n        \"source\": \"Official Docs\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Claude Sonnet 5 as default model\",\n    \"description\": \"Claude Sonnet 5 becomes the new default model for Pro, Team Standard, and Enterprise subscription seats, with top-tier coding and tool use at Sonnet pricing, native 1M-token context window, and adaptive thinking on by default.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://code.claude.com/docs/en/whats-new\",\n    \"date\": \"2026-07-03\",\n    \"community_feedback\": []\n  }\n]"
