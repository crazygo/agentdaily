  "content": "[\n  {\n    \"name\": \"Aura\",\n    \"url\": \"https://auravcs.com/\",\n    \"description\": \"Git-native semantic version control IDE for AI coding agents. Tracks code changes at the AST level rather than text, allowing surgical rewinds of broken functions, blocking undocumented AI commits, and orchestrating massive code generation while saving 95% on LLM tokens. 100% local, Apache 2.0 open-source.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"Full AI IDE\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"This is a really interesting direction — moving from text diffs to intent + AST-level tracking makes a lot of sense in an AI-first workflow\", \"The aura rewind for single functions is exactly what I need — reverting entire PRs because one AI-generated function broke things has been my biggest pain point with Claude Code\", \"The 93% token reduction on handover is wild if that holds up in practice\"]\n  },\n  {\n    \"name\": \"Agently\",\n    \"url\": \"https://agently.dev/\",\n    \"description\": \"AI Chief of Staff that holds your whole company context with persistent memory across 100+ tool connectors. Links Stripe events to Slack threads to Linear tickets automatically, routes work to specialized agents, and executes end-to-end workflows with temporal knowledge graph that understands state changes.\",\n    \"release_date\": \"2026-07-15\",\n    \"category\": \"Workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\"The underrated part is the compounding. Most AI tools are identical on day 1 and day 100. If the brain genuinely gets sharper the more it ingests and the more you correct it, that's a real moat\", \"The persistent context across tools - not just another AI assistant answering prompts, but a system that can connect events and move work forward automatically\", \"Honestly the linking between Stripe, Slack, and Linear without me setting anything up kind of freaked me out in a good way\"]\n  },\n  {\n    \"name\": \"AgentKey\",\n    \"url\": \"https://www.producthunt.com/products/agentkey\",\n    \"description\": \"One-stop live data marketplace plugin that connects AI agents to live external data (business, crypto, web, social) in one command. Ranked #1 on Product Hunt July 13, 2026 with 691 upvotes.\",\n    \"release_date\": \"2026-07-13\",\n    \"category\": \"Workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Osaurus\",\n    \"url\": \"https://www.producthunt.com/products/osaurus\",\n    \"description\": \"Open-source AI agent platform that runs 100% locally on Mac with no account or subscription needed. Native Swift app (not Electron) that provides persistent memory and autonomous agent capabilities for calendar, contacts, and messaging.\",\n    \"release_date\": \"2026-07-13\",\n    \"category\": \"Open-source AI coding agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Second Brain for AI v2\",\n    \"url\": \"https://www.producthunt.com/products/second-brain-for-ai\",\n    \"description\": \"AI memory system that connects information across every tool in a developer's workflow, providing persistent memory and knowledge retrieval across sessions.\",\n    \"release_date\": \"2026-07-12\",\n    \"category\": \"Workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"FetchSandbox\",\n    \"url\": \"https://www.producthunt.com/products/fetchsandbox\",\n    \"description\": \"API integration testing tool with memory capabilities that remembers what breaks in the testing process.\",\n    \"release_date\": \"2026-07-12\",\n    \"category\": \"Workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Tabstack\",\n    \"url\": \"https://www.producthunt.com/products/tabstack\",\n    \"description\": \"Browser automation tool for AI agents that reads accessibility trees instead of using screenshots, reducing token costs by 60-80%. Agents can automate web tasks like booking meetings or filling forms.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"DevOps workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Auriko\",\n    \"url\": \"https://www.producthunt.com/products/auriko\",\n    \"description\": \"Trading desk API for LLM calls, allowing developers to optimize and manage API calls to large language models.\",\n    \"release_date\": \"2026-07-09\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"agents-cli\",\n    \"url\": \"https://www.producthunt.com/products/agents-cli\",\n    \"description\": \"CLI tool specifically designed for AI coding agents to ship themselves from idea/demo to production. Provides scaffolding, evaluation, and deployment features tailored for AI agents like Gemini CLI, Claude Code, and Cursor.\",\n    \"release_date\": \"2026-07-08\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"NanoKVM-Go\",\n    \"url\": \"https://www.producthunt.com/products/nanokvm-go\",\n    \"description\": \"Hardware/software solution that gives AI agents physical control over any screen, extending agent capabilities beyond the terminal.\",\n    \"release_date\": \"2026-07-08\",\n    \"category\": \"DevOps workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"TryCase\",\n    \"url\": \"https://www.producthunt.com/products/trycase\",\n    \"description\": \"Disposable test environments specifically designed for AI coding agents. Provides isolated sandbox environments for testing AI-generated code.\",\n    \"release_date\": \"2026-07-05\",\n    \"category\": \"Workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Tamamon\",\n    \"url\": \"https://www.producthunt.com/products/tamamon\",\n    \"description\": \"Desktop companion pet that grows as you code with Claude Code, gamifying the coding experience.\",\n    \"release_date\": \"2026-07-03\",\n    \"category\": \"Workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  }\n]"
}

