    "content": "[\n  {\n    \"name\": \"Kilo Code v7\",\n    \"url\": \"https://kilo.ai\",\n    \"description\": \"Open-source AI coding agent for VS Code with parallel agents, diff reviewer, and multi-model comparisons. Completely rebuilt extension with subagent delegation and MIT-licensed portable runtime.\",\n    \"release_date\": \"2026-05-21\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"The line level review comments on agent diffs is a really smart UX call\",\n      \"Feels like the missing link between AI wrote this and I actually trust this going to prod\"\n    ]\n  },\n  {\n    \"name\": \"Emdash\",\n    \"url\": \"https://emdash.sh\",\n    \"description\": \"Open-source desktop app for running multiple coding agents in parallel with isolated worktrees. Provider-agnostic platform supporting 28+ coding agent providers with SSH support for remote machines.\",\n    \"release_date\": \"2026-05-21\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"One app, every coding agent. Emdash is a provider-agnostic desktop app to run agents in parallel and turn issues into PRs\",\n      \"Parallel agents with isolated worktrees is the part that catches my eye\",\n      \"Closing the development flow in app is the right call\"\n    ]\n  },\n  {\n    \"name\": \"Superset 2.0\",\n    \"url\": \"https://www.producthunt.com/posts/superset-2-0\",\n    \"description\": \"Run 100s of coding agents on any machine from anywhere. Platform for managing multiple coding agents across different machines.\",\n    \"release_date\": \"2026-05-21\",\n    \"category\": \"code agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Runtime\",\n    \"url\": \"https://www.producthunt.com/posts/runtime-sandboxed-coding-agents\",\n    \"description\": \"Sandboxed coding agents platform for teams. Provides isolated environments for running AI coding agents with team collaboration features via Slack integration.\",\n    \"release_date\": \"2026-05-21\",\n    \"category\": \"code agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Sandboxed coding agents for everyone on your team\"\n    ]\n  },\n  {\n    \"name\": \"Re_gent\",\n    \"url\": \"https://www.producthunt.com/products/re_gent\",\n    \"description\": \"Version control system for AI agent activity. Shows what coding agents changed, which prompts caused changes, and enables rollback across files and sessions.\",\n    \"release_date\": \"2026-05-21\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Git for AI Agents\",\n      \"Shows what your agent did and which prompt wrote each line of code\"\n    ]\n  },\n  {\n    \"name\": \"Glia\",\n    \"url\": \"https://www.producthunt.com/products/glia-2\",\n    \"description\": \"Local-first AI memory bridge between browser chats and IDEs. Chrome extension that auto-saves web-based Claude/ChatGPT conversations and serves them via MCP to IDEs for persistent context.\",\n    \"release_date\": \"2026-05-21\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Local-first AI memory bridge between browser chats and IDEs\",\n      \"100% offline and open-source memory bridge\"\n    ]\n  },\n  {\n    \"name\": \"Contextberg\",\n    \"url\": \"https://contextberg.com\",\n    \"description\": \"Local memory app for AI agents that watches screens, browser history, and agent conversations in the background, serving context to coding agents via MCP protocol.\",\n    \"release_date\": \"2026-05-21\",\n    \"category\": \"workflow agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Turn your work into AI agent memory, served over MCP\",\n      \"Local memory app for AI agents\"\n    ]\n  }\n]\n",
