r 1fr;\n            gap: 20px;\n            margin-bottom: 30px;\n        }\n\n        @media (max-width: 968px) {\n            .three-column-layout {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        section {\n            background: #ffffff;\n            border: 1px solid #d4d4d4;\n            border-radius: 3px;\n            padding: 10px;\n        }\n\n        section h2 {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 12pt;\n            font-weight: bold;\n            margin-bottom: 15px;\n            padding-bottom: 8px;\n            border-bottom: 1px solid #d4d4d4;\n            color: #000;\n        }\n\n        .item {\n            margin-bottom: 15px;\n            padding-bottom: 12px;\n            border-bottom: 1px solid #eeeeee;\n        }\n\n        .item:last-child {\n            border-bottom: none;\n            margin-bottom: 0;\n        }\n\n        .item-title {\n            font-size: 10pt;\n            font-weight: bold;\n            margin-bottom: 4px;\n        }\n\n        .item-title a {\n            color: #000;\n            text-decoration: none;\n        }\n\n        .item-title a:hover {\n            text-decoration: underline;\n        }\n\n        .item-title a:visited {\n            color: #828282;\n        }\n\n        .item-description {\n            font-size: 9pt;\n            color: #000;\n            margin-bottom: 4px;\n            line-height: 1.3;\n        }\n\n        .item-meta {\n            font-size: 8pt;\n            color: #828282;\n        }\n\n        .category {\n            display: inline-block;\n            background-color: #f6f6ef;\n            padding: 2px 6px;\n            border-radius: 2px;\n            font-size: 8pt;\n            margin-top: 4px;\n            color: #828282;\n        }\n\n        .update-badge {\n            display: inline-block;\n            background-color: #ff6600;\n            color: #000;\n            padding: 2px 6px