    "content": "[\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Background Agents in Slack Integration\",\n    \"description\": \"Cursor launched a Slack integration that allows users to launch Background Agents directly from Slack conversations by mentioning @Cursor. Agents can read the thread context, understand discussions, and create PRs in GitHub without leaving Slack.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-04-24\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Better Debugging with GitHub Copilot on the Web\",\n    \"description\": \"GitHub improved the web-based Copilot debugging experience, making it easier to debug code directly in the browser interface with enhanced tooling.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-04-23\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"View and Manage Agent Sessions from Issues and Projects\",\n    \"description\": \"GitHub added the ability to view and manage Copilot agent sessions directly from issues and project boards, improving workflow integration and visibility.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-04-23\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"C++ Code Intelligence for GitHub Copilot CLI in Public Preview\",\n    \"description\": \"GitHub added C++ code intelligence capabilities to Copilot CLI, now available in public preview for C++ developers with enhanced language support.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-04-22\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Aider\",\n    \"title\": \"Support for Latest LLMs Including Claude 3.7 Sonnet\",\n    \"description\": \"Aider continues to support the latest LLMs including Claude 3.7 Sonnet, DeepSeek R1 & Chat V3, OpenAI o1, o3-mini & GPT-4o, with compatibility for over 100 programming languages.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://aider.chat\",\n    \"date\": \"2026-04-20\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Copilot CLI Now Supports Copilot Auto Model Selection\",\n    \"description\": \"Copilot CLI gained support for automatic model selection, helping users choose the best model for their tasks without manual configuration.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-04-17\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Claude Opus 4.7 Now Generally Available\",\n    \"description\": \"GitHub announced that Claude Opus 4.7 is now generally available in Copilot, continuing the integration of Anthropic's most capable model into the Copilot ecosystem.\",\n    \"updateType\": \"release\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-04-16\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"BugBot Automatic Code Review\",\n    \"description\": \"Cursor 1.0 introduced BugBot, an automatic code review feature that reviews PRs and catches potential bugs. Issues found are commented directly on PRs with 'Fix in Cursor' links.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"MCP One-Click Install and OAuth Support\",\n    \"description\": \"Cursor added one-click MCP server installation and OAuth support, making it easier to connect to third-party tools and services with streamlined authentication.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Background Agent for All Users\",\n    \"description\": \"Cursor expanded Background Agent access from early preview to all users, allowing parallel task execution in remote environments. Users can access it via the cloud icon or Cmd/Ctrl+E.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Agent Support for Jupyter Notebooks\",\n    \"description\": \"Cursor's Agent can now implement changes directly in Jupyter Notebooks, creating and editing multiple cells. This feature is initially supported with Sonnet models for data science workflows.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Memories Feature Beta\",\n    \"description\": \"Cursor introduced Memories beta, allowing the AI to remember facts from conversations and reference them in future sessions. Memories are stored per project at an individual level.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Richer Chat Responses with Visualizations\",\n    \"description\": \"Cursor can now render visualizations directly in conversations, including Mermaid diagrams and Markdown tables for better understanding of complex concepts and data.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"New Settings and Dashboard with Usage Analytics\",\n    \"description\": \"Cursor released a new dashboard interface showing individual and team usage analytics, display name management, and detailed statistics broken down by tool or model.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.sh/changelog\",\n    \"date\": \"2026-04-15\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Model Selection for Claude and Codex Agents on github.com\",\n    \"description\": \"GitHub improved model selection capabilities for Claude and Codex agents directly on the github.com interface, giving users more control over which AI models they use.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-04-14\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"Copilot Data Residency in US + EU and FedRAMP Compliance Now Available\",\n    \"description\": \"GitHub announced new data residency options for Copilot with US and EU storage locations, along with FedRAMP compliance for government customers.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://github.blog/changelog\",\n    \"date\": \"2026-04-13\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Model Context Protocol (MCP) Integration\",\n    \"description\": \"Windsurf continues to feature MCP integration, allowing users to enhance AI workflows by connecting to custom tools and services for extended capabilities.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://codeium.com/windsurf\",\n    \"date\": \"2026-04-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Continue\",\n    \"title\": \"Continuous AI Code Quality Checks\",\n    \"description\": \"Continue.dev continues to offer source-controlled AI checks on every pull request, allowing teams to define standards as checks enforced by AI with human decision-making.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://continue.dev\",\n    \"date\": \"2026-04-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"Terminal-Based Agentic Coding Tool\",\n    \"description\": \"Claude Code continues to offer its terminal-based agentic coding tool that helps developers build features from descriptions, debug issues, navigate codebases, and automate tedious tasks directly from the terminal.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.anthropic.com/en/docs/claude-code/overview\",\n    \"date\": \"2026-04-10\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Nubank Case Study: 8-12x Engineering Efficiency Gains\",\n    \"description\": \"Devin published a case study showing how Nubank achieved 8-12x efficiency gains and over 20x cost savings on a major ETL migration project using Devin's AI agents.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://devin.ai\",\n    \"date\": \"2026-04-10\",\n    \"community_feedback\": []\n  }\n]\n",
