order-bottom: none;\n            margin-bottom: 0;\n        }\n\n        .item-title {\n            font-weight: bold;\n            margin-bottom: 3px;\n        }\n\n        .item-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .item-title a:hover {\n            color: #ff6600;\n        }\n\n        .item-title a:visited {\n            color: #828282;\n        }\n\n        .item-description {\n            color: #000000;\n            margin-bottom: 5px;\n            line-height: 1.4;\n        }\n\n        .item-meta {\n            font-size: 8pt;\n            color: #828282;\n        }\n\n        .tag {\n            display: inline-block;\n            background-color: #f0f0f0;\n            padding: 2px 6px;\n            margin-right: 5px;\n            margin-top: 3px;\n            font-size: 8pt;\n            border-radius: 2px;\n        }\n\n        .update-item {\n            margin-bottom: 12px;\n            padding-bottom: 10px;\n            border-bottom: 1px dotted #d4d4d4;\n        }\n\n        .update-item:last-child {\n            border-bottom: none;\n        }\n\n        .update-product {\n            font-weight: bold;\n            color: #ff6600;\n            margin-bottom: 2px;\n        }\n\n        .update-title {\n            font-size: 9pt;\n            font-weight: bold;\n            margin-bottom: 3px;\n        }\n\n        .update-description {\n            color: #000000;\n            margin-bottom: 4px;\n            font-size: 9pt;\n            line-height: 1.4;\n        }\n\n        .update-date {\n            font-size: 8pt;\n            color: #828282;\n        }\n\n        .insight-item {\n            margin-bottom: 12px;\n            padding-bottom: 10px;\n            border-bottom: 1px dotted #d4d4d4;\n        }\n\n        .insight-item:last-child {\n            border-bottom: none;\n        }\n\n        .insight-title {\n            font-weight: bold;\n            margin-bottom: 3px;\n            font-size: 9pt;\n        }\n\n        .insight-title a {\n            color: #000000;\n            text-decoration: none;\n        }\n\n        .insight-title a:hover {\n            color: #ff6600;\n        }\n\n        .insight-description {\n            color: #000000;\n            margin-bottom: 4px;\n            font-size: 9pt;\n            line-height: 1.4;\n        }\n\n        .insight-author {\n            font-size: 8pt;\n            color: #828282;\n            font-style: italic;\n        }\n\n        .insight-date {\n            font-size: 8pt;\n            color: #828282;\n        }\n\n        footer {\n            margin-top: 20px;\n            padding: 10px;\n            text-align: center;\n            font-size: 9pt;\n            color: #828282;\n            border-top: 1px solid #d4d4d4;\n        }\n\n        footer a {\n            color: #ff6600;\n            text-decoration: none;\n        }\n\n        footer a:hover {\n            text-decoration: underline;\n        }\n\n        .section-count {\n            font-size: 8pt;\n            color: #828282;\n            font-weight: normal;\n            margin-left: 5px;\n        }\n\n        code {\n            font-family: Monaco, Consolas, monospace;\n            background-color: #f0f0f0;\n            padding: 1px 4px;\n            font-size: 9pt;\n        }\n\n        @media print {\n            body {\n                background-color: #ffffff;\n            }\n\n            .column {\n                page-break-inside: avoid;\n            }\n        }\n\n        @media (max-width: 1200px) {\n            .three-column-layout {\n                grid-template-columns: 1fr;\n            }\n\n            .column {\n                margin-bottom: 15px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <h1>Agentic Coding Research Report</h1>\n        <div class=\"subtitle\">April 24, 2026 • Research Period: April 10-24, 2026</div>\n    </header>\n\n    <div class=\"container\">\n        <main class=\"three-column-layout\">\n            <!-- New Products Column -->\n            <section class=\"column\">\n                <div class=\"column-header\">\n                    New Products <span class=\"section-count\">(13)</span>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://github.com/Alishahryar1/free-claude-code\" target=\"_blank\">free-claude-code</a></div>\n                    <div class=\"item-description\">Open-source project enabling use of claude-code for free in terminal, VSCode extension, or via Discord similar to openclaw. Trending on GitHub with 7,777 stars.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI Coding Agent</span>\n                        <span class=\"tag\">Open Source</span>\n                        GitHub Trending\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://github.com/zilliztech/claude-context\" target=\"_blank\">claude-context</a></div>\n                    <div class=\"item-description\">Code search MCP (Model Context Protocol) server for Claude Code. Makes entire codebase available as context for any coding agent. 8,870 stars on GitHub.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">MCP Tool</span>\n                        <span class=\"tag\">Code Search</span>\n                        GitHub Trending\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://kosprotocol.dev\" target=\"_blank\">KOS Protocol</a></div>\n                    <div class=\"item-description\">A kos.json file standard for AI agents to read verified facts. Protocol for providing structured, verified information to AI agents.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">Developer Tool</span>\n                        <span class=\"tag\">Agent Infrastructure</span>\n                        Hacker News Show HN\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://starsinger.ai\" target=\"_blank\">StarSinger MCP</a></div>\n                    <div class=\"item-description\">\"The Spotify for AI Agents\" - an MCP (Model Context Protocol) tool for managing and integrating AI agents.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">Agent Infrastructure</span>\n                        <span class=\"tag\">MCP Tool</span>\n                        Hacker News Show HN\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/products/kimiflare\" target=\"_blank\">kimiflare</a></div>\n                    <div class=\"item-description\">Terminal-native coding agent running on Kimi K2.6 via Cloudflare Workers AI. Features multi-turn tool use, 262k context window, vision inputs support.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI Coding Agent</span>\n                        <span class=\"tag\">CLI</span>\n                        Product Hunt • Apr 21\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/products/vibearound\" target=\"_blank\">VibeAround</a></div>\n                    <div class=\"item-description\">Tauri desktop application that enables chatting with local AI coding agents (including Claude Code, Gemini CLI, Codex CLI) from any instant messaging app.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">Workflow Tool</span>\n                        <span class=\"tag\">Vibe Coding</span>\n                        Product Hunt • Apr 21\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/products/seeknal\" target=\"_blank\">Seeknal</a></div>\n                    <div class=\"item-description\">All-in-one CLI for data & AI/ML engineering. Define pipelines in YAML/Python, run safe workflows, materialize data to PostgreSQL and Iceberg.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">CLI</span>\n                        <span class=\"tag\">Data & AI/ML</span>\n                        Product Hunt • Apr 21\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/products/fusedframes\" target=\"_blank\">FusedFrames</a></div>\n                    <div class=\"item-description\">macOS application that captures team expertise to power AI agents. Uses AI to interpret actions in real-time and distills them into structured patterns.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI Workflow</span>\n                        <span class=\"tag\">Knowledge Management</span>\n                        Product Hunt • Apr 21\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/products/ml-intern\" target=\"_blank\">ml-intern</a></div>\n                    <div class=\"item-description\">Hugging Face's open-source AI agent that fully automates ML post-training. Reads arXiv papers, fixes datasets, runs training jobs, debugs failures.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI Coding Agent</span>\n                        <span class=\"tag\">ML Research</span>\n                        Product Hunt • Apr 21\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/products/story-copilot\" target=\"_blank\">Story Copilot</a></div>\n                    <div class=\"item-description\">Conversational AI interface to build intelligent workflows. Enables users to create and manage automated workflows through natural language.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI Workflow</span>\n                        <span class=\"tag\">Automation</span>\n                        Product Hunt • Apr 21\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/products/wrangle\" target=\"_blank\">Wrangle</a></div>\n                    <div class=\"item-description\">Markdown editor that specifically understands and supports CLAUDE.md documentation format. Helps developers work with Claude Code's documentation structure.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">AI Code Editor</span>\n                        <span class=\"tag\">Developer Tool</span>\n                        Product Hunt • Apr 21\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\"><a href=\"https://www.producthunt.com/products/eol-dataset\" target=\"_blank\">EOL Dataset</a></div>\n                    <div class=\"item-description\">Free tool to find every end-of-life dependency in your software stack in under 5 minutes. Tracks lifecycle status across 12M+ package versions.</div>\n                    <div class=\"item-meta\">\n                        <span class=\"tag\">Developer Tool</span>\n                        <span class=\"tag\">Security</span>\n                        Product Hunt • Apr 9\n                    </div>\n                </div>\n            </section>\n\n            <!-- Whitelist Updates Column -->\n            <section class=\"column\">\n                <div class=\"column-header\">\n                    Whitelist Updates <span class=\"section-count\">(19)</span>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Cursor</div>\n                    <div class=\"update-title\">Background Agents in Slack Integration</div>\n                    <div class=\"update-description\">Launch Background Agents directly from Slack by mentioning @Cursor. Agents read thread context and create PRs in GitHub.</div>\n                    <div class=\"update-date\">April 24, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">GitHub Copilot</div>\n                    <div class=\"update-title\">Better Debugging on the Web</div>\n                    <div class=\"update-description\">Improved web-based Copilot debugging experience with enhanced tooling for browser interface.</div>\n                    <div class=\"update-date\">April 23, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">GitHub Copilot</div>\n                    <div class=\"update-title\">View Agent Sessions from Issues</div>\n                    <div class=\"update-description\">View and manage Copilot agent sessions directly from issues and project boards.</div>\n                    <div class=\"update-date\">April 23, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">GitHub Copilot</div>\n                    <div class=\"update-title\">C++ Support for CLI in Public Preview</div>\n                    <div class=\"update-description\">Added C++ code intelligence capabilities to Copilot CLI, now in public preview.</div>\n                    <div class=\"update-date\">April 22, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Aider</div>\n                    <div class=\"update-title\">Latest LLM Support Including Claude 3.7</div>\n                    <div class=\"update-description\">Supports Claude 3.7 Sonnet, DeepSeek R1 & Chat V3, OpenAI o1, o3-mini & GPT-4o across 100+ languages.</div>\n                    <div class=\"update-date\">April 20, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">GitHub Copilot</div>\n                    <div class=\"update-title\">CLI Auto Model Selection</div>\n                    <div class=\"update-description\">Copilot CLI gained support for automatic model selection to choose best model for tasks.</div>\n                    <div class=\"update-date\">April 17, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">GitHub Copilot</div>\n                    <div class=\"update-title\">Claude Opus 4.7 Generally Available</div>\n                    <div class=\"update-description\">Claude Opus 4.7 now generally available in Copilot ecosystem.</div>\n                    <div class=\"update-date\">April 16, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Cursor</div>\n                    <div class=\"update-title\">BugBot Automatic Code Review</div>\n                    <div class=\"update-description\">Cursor 1.0 BugBot reviews PRs and catches bugs with 'Fix in Cursor' links.</div>\n                    <div class=\"update-date\">April 15, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Cursor</div>\n                    <div class=\"update-title\">MCP One-Click Install and OAuth</div>\n                    <div class=\"update-description\">One-click MCP server installation with OAuth support for streamlined authentication.</div>\n                    <div class=\"update-date\">April 15, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Cursor</div>\n                    <div class=\"update-title\">Background Agent for All Users</div>\n                    <div class=\"update-description\">Expanded Background Agent access to all users for parallel task execution via Cmd/Ctrl+E.</div>\n                    <div class=\"update-date\">April 15, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Cursor</div>\n                    <div class=\"update-title\">Jupyter Notebook Support</div>\n                    <div class=\"update-description\">Agent can now implement changes in Jupyter Notebooks with Sonnet models.</div>\n                    <div class=\"update-date\">April 15, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Cursor</div>\n                    <div class=\"update-title\">Memories Feature Beta</div>\n                    <div class=\"update-description\">AI remembers facts from conversations and references them in future sessions per project.</div>\n                    <div class=\"update-date\">April 15, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Cursor</div>\n                    <div class=\"update-title\">Richer Chat with Visualizations</div>\n                    <div class=\"update-description\">Render visualizations including Mermaid diagrams and Markdown tables in conversations.</div>\n                    <div class=\"update-date\">April 15, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Cursor</div>\n                    <div class=\"update-title\">New Settings Dashboard</div>\n                    <div class=\"update-description\">Usage analytics dashboard with individual and team statistics by tool or model.</div>\n                    <div class=\"update-date\">April 15, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">GitHub Copilot</div>\n                    <div class=\"update-title\">Model Selection on github.com</div>\n                    <div class=\"update-description\">Improved model selection for Claude and Codex agents directly on github.com interface.</div>\n                    <div class=\"update-date\">April 14, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">GitHub Copilot</div>\n                    <div class=\"update-title\">Data Residency & FedRAMP</div>\n                    <div class=\"update-description\">US and EU data residency options with FedRAMP compliance for government customers.</div>\n                    <div class=\"update-date\">April 13, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Windsurf</div>\n                    <div class=\"update-title\">MCP Integration</div>\n                    <div class=\"update-description\">Model Context Protocol integration to connect custom tools and services.</div>\n                    <div class=\"update-date\">April 10, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Continue</div>\n                    <div class=\"update-title\">Continuous AI Code Quality Checks</div>\n                    <div class=\"update-description\">Source-controlled AI checks on every PR with team-defined standards.</div>\n                    <div class=\"update-date\">April 10, 2026</div>\n                </div>\n\n                <div class=\"update-item\">\n                    <div class=\"update-product\">Devin</div>\n                    <div class=\"update-title\">Nubank Case Study Results</div>\n                    <div class=\"update-description\">8-12x efficiency gains and 20x cost savings on ETL migration project.</div>\n                    <div class=\"update-date\">April 10, 2026</div>\n                </div>\n            </section>\n\n            <!-- Technical Insights Column -->\n            <section class=\"column\">\n                <div class=\"column-header\">\n                    Technical Insights <span class=\"section-count\">(24)</span>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/24/deepseek-v4/\" target=\"_blank\">DeepSeek V4—almost on the frontier</a></div>\n                    <div class=\"insight-description\">DeepSeek-V4 with Mixture-of-Experts at fraction of price. 1M token context, MIT license. Extremely competitive pricing.</div>\n                    <div class=\"insight-author\">Simon Willison</div>\n                    <div class=\"insight-date\">Apr 24, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/24/#:~:text=Claude%20Code\" target=\"_blank\">Anthropic postmortem: Claude Code quality</a></div>\n                    <div class=\"insight-description\">Three harness bugs (not model issues) caused Claude Code quality degradation. Cleared thinking repeatedly due to bug.</div>\n                    <div class=\"insight-author\">Simon Willison</div>\n                    <div class=\"insight-date\">Apr 24, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/22/copilot-plans/\" target=\"_blank\">GitHub Copilot tightening limits</a></div>\n                    <div class=\"insight-description\">\"Agentic workflows have fundamentally changed Copilot's compute demands.\" Single agentic requests burn more tokens cutting into margins.</div>\n                    <div class=\"insight-author\">Simon Willison</div>\n                    <div class=\"insight-date\">Apr 22, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/22/claude-code-100/\" target=\"_blank\">Claude Code $100/month confusion</a></div>\n                    <div class=\"insight-description\">Anthropic quietly added $100/month tier to pricing page then reverted. Unclear if intentional leak or mistake.</div>\n                    <div class=\"insight-author\">Simon Willison</div>\n                    <div class=\"insight-date\">Apr 22, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/22/#:~:text=Firefox%20150\" target=\"_blank\">Firefox 150: 271 vulnerabilities fixed</a></div>\n                    <div class=\"insight-description\">Mozilla applied Claude Mythos Preview to Firefox, fixing 271 vulnerabilities. CTO: \"Defenders finally have a chance to win.\"</div>\n                    <div class=\"insight-author\">Bobby Holley</div>\n                    <div class=\"insight-date\">Apr 22, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://llm-stats.com/gpt-5-5-vs-claude-opus-4-7\" target=\"_blank\">GPT-5.5 vs Claude Opus 4.7</a></div>\n                    <div class=\"insight-description\">Claude Opus 4.7 leads on 6 of 10 benchmarks, GPT-5.5 on 4. Margins between 2-13 points.</div>\n                    <div class=\"insight-author\">Jonathan Chavez</div>\n                    <div class=\"insight-date\">Apr 23, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/19/headless/\" target=\"_blank\">Headless everything: APIs as the UI</a></div>\n                    <div class=\"insight-description\">\"Personal AIs better than services directly; headless services quicker than GUI with bot-controlled mouse.\" Will disrupt per-head SaaS pricing.</div>\n                    <div class=\"insight-author\">Matt Webb, Marc Benioff</div>\n                    <div class=\"insight-date\">Apr 19, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/21/#:~:text=Less%20human%20AI%20agents\" target=\"_blank\">Less human AI agents, please</a></div>\n                    <div class=\"insight-description\">\"AI agents too human in banal sense: lack stringency, patience, focus. Faced with awkward tasks, drift toward familiar.\"</div>\n                    <div class=\"insight-author\">Andreas Påhlsson-Notini</div>\n                    <div class=\"insight-date\">Apr 21, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/20/claude-token-counter/\" target=\"_blank\">Claude Token Counter comparison</a></div>\n                    <div class=\"insight-description\">Opus 4.7 tokenizer uses 1.46x tokens vs 4.6 for system prompt. Same pricing but ~40% more expensive due to token inflation.</div>\n                    <div class=\"insight-author\">Simon Willison</div>\n                    <div class=\"insight-date\">Apr 20, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/24/#:~:text=For%20You\" target=\"_blank\">Bluesky feed: Single Go process</a></div>\n                    <div class=\"insight-description\">Serves 72,000 users from single Go process using SQLite on gaming PC. Cost: $30/month total.</div>\n                    <div class=\"insight-author\">spacecowboy</div>\n                    <div class=\"insight-date\">Apr 24, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/24/#:~:text=honker\" target=\"_blank\">honker: Postgres NOTIFY for SQLite</a></div>\n                    <div class=\"insight-description\">Rust SQLite extension implementing Postgres-style NOTIFY/LISTEN. Queue and stream abstractions with transactional outbox.</div>\n                    <div class=\"insight-author\">Russell Romney</div>\n                    <div class=\"insight-date\">Apr 24, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://llm-stats.com/claude-opus-4-7-vs-opus-4-6\" target=\"_blank\">Claude Opus 4.7 vs Opus 4.6</a></div>\n                    <div class=\"insight-description\">Opus 4.7 wins on 12 of 14 benchmarks at same $5/$25 price. Includes migration checklist.</div>\n                    <div class=\"insight-author\">Jonathan Chavez</div>\n                    <div class=\"insight-date\">Apr 17, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/18/claude-opus-4-7-system-prompt/\" target=\"_blank\">Claude Opus 4.7 system prompt changes</a></div>\n                    <div class=\"insight-description\">Anthropic published system prompts for Opus 4.7 and 4.6 - only major AI lab to do so.</div>\n                    <div class=\"insight-author\">Simon Willison</div>\n                    <div class=\"insight-date\">Apr 18, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/22/qwen3-6-27b/\" target=\"_blank\">Qwen3.6-27B: Flagship-Level Coding</a></div>\n                    <div class=\"insight-description\">27B dense model claiming flagship-level agentic coding. 55.6GB vs 807GB for 397B-A17B.</div>\n                    <div class=\"insight-author\">Simon Willison</div>\n                    <div class=\"insight-date\">Apr 22, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/23/gpt-5-5-pelican/\" target=\"_blank\">Testing GPT-5.5 via Codex API</a></div>\n                    <div class=\"insight-description\">\"Fast, effective, highly capable—I ask it to build things and it builds exactly what I ask.\"</div>\n                    <div class=\"insight-author\">Simon Willison</div>\n                    <div class=\"insight-date\">Apr 23, 2026</div>\n                </div>\n\n                <div class=\"insight-item\">\n                    <div class=\"insight-title\"><a href=\"https://simonwillison.net/2026/Apr/23/extract-pdf-text-liteparse-web/\" target=\"_blank\">LiteParse for the web</a></div>\n                    <div class=\"insight-description\">Browser-based PDF text extraction using LlamaIndex libraries. Runs entirely client-side.</div>\n                    <div class=\"insight-author\">Simon Willison