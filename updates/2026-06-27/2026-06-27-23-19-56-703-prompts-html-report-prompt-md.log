\n                        <a href=\"https://arxiv.org/abs/2606.26918\" target=\"_blank\">Diagnosing Task Insensitivity in Language Agents</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Diagnostic approaches for task-insensitive behavior in language agents\n                    </div>\n                    <div class=\"item-meta\">\n                        Jingyu Liu et al. | 2026-06-26\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic\">task sensitivity</span>\n                        <span class=\"topic\">agent evaluation</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://arxiv.org/abs/2606.26836\" target=\"_blank\">The Capability Frontier: Benchmarks Miss 82%</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Argues benchmarks fail to capture 82% of model performance\n                    </div>\n                    <div class=\"item-meta\">\n                        Bradley Fowler et al. | 2026-06-26\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic\">benchmarks</span>\n                        <span class=\"topic\">model evaluation</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://arxiv.org/abs/2606.26686\" target=\"_blank\">LeanGuard: Fast and Light Moderation</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Questions whether safety guardrails need complex reasoning\n                    </div>\n                    <div class=\"item-meta\">\n                        Dongbin Na | 2026-06-26\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic\">AI safety</span>\n                        <span class=\"topic\">content moderation</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://arxiv.org/abs/2606.26669\" target=\"_blank\">SKILL-DISCO: Agent Traces to Reusable Skills</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Distilling and compiling agent traces into reusable procedural skills\n                    </div>\n                    <div class=\"item-meta\">\n                        Zhongxin Guo et al. | 2026-06-26\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic\">agent skills</span>\n                        <span class=\"topic\">knowledge distillation</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"https://arxiv.org/abs/2606.26722\" target=\"_blank\">Socratic Agents for Scientific Discovery</a>\n                    </div>\n                    <div class=\"item-description\">\n                        Question-driven approaches for autonomous discovery in physical systems\n                    </div>\n                    <div class=\"item-meta\">\n                        Xianrui Zeng et al. | 2026-06-26\n                    </div>\n                    <div class=\"topics\">\n                        <span class=\"topic\">scientific discovery</span>\n                        <span class=\"topic\">Socratic methods</span>\n                    </div>\n                </div>\n\n                <div class=\"item\">\n                    <div class=\"item-title\">\n                        <a href=\"