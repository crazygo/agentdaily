      "content": "[\n  {\n    \"title\": \"Microsoft's open source tools were hacked to steal passwords of AI developers\",\n    \"description\": \"Microsoft shut down dozens of GitHub code repositories for Azure and AI coding tools after a security breach. Raises concerns about security in the AI development ecosystem.\",\n    \"author\": \"TechCrunch\",\n    \"source\": \"TechMedia\",\n    \"url\": \"https://techcrunch.com/2026/06/08/microsofts-open-source-tools-were-hacked-to-steal-passwords-of-ai-developers/\",\n    \"published_date\": \"2026-06-08\",\n    \"topics\": [\"security\", \"microsoft\", \"ai\", \"github\", \"azure\", \"hacking\", \"ai-tools\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"OpenAI Help: Lockdown Mode\",\n    \"description\": \"OpenAI released Lockdown Mode to help prevent data exfiltration from prompt injection attacks by limiting outbound network requests. Simon notes this directly attacks the 'exfiltration vectors' leg of the Lethal Trifecta (private data + untrusted content + data transmission vectors), which is the easiest to restrict without making LLM systems less useful.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jun/5/openai-help-lockdown-mode/\",\n    \"published_date\": \"2026-06-05\",\n    \"topics\": [\"security\", \"prompt-injection\", \"llms\", \"openai\", \"lethal-trifecta\", \"data-exfiltration\"],\n    \"type\": \"technical\"\n  },\n  {\n    \"title\": \"Ladybird browser will no longer accept public pull requests\",\n    \"description\": \"Andreas Kling announced Ladybird will no longer accept public PRs because AI-generated patches no longer indicate substantial effort or good faith. Simon notes this as a sign of how AI is changing open source contribution models.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jun/5/ladybird-no-public-prs/\",\n    \"published_date\": \"2026-06-05\",\n    \"topics\": [\"ladybird\", \"ai-ethics\", \"open-source\", \"generative-ai\", \"ai\", \"llms\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"AI enthusiasts are in a race against time, AI skeptics are in a race against entropy\",\n    \"description\": \"Charity Majors captures the dynamic between AI enthusiasts and skeptics: Enthusiasts are seeing discontinuous leaps in capabilities and can't afford to wait, while skeptics are seeing reliability degrade and institutional knowledge evaporate when code ships faster than engineers can read it. The key insight: there is no natural feedback loop connecting these two groups.\",\n    \"author\": \"Simon Willison (quoting Charity Majors)\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jun/4/ai-enthusiists-race-against-time/\",\n    \"published_date\": \"2026-06-04\",\n    \"topics\": [\"ai\", \"agentic-engineering\", \"engineering-culture\", \"organizational-design\"],\n    \"type\": \"opinion\"\n  },\n  {\n    \"title\": \"Uber Caps Usage of AI Tools Like Claude Code to Manage Costs\",\n    \"description\": \"Uber is limiting all employees to $1,500 in monthly token spending per AI coding tool (Cursor, Claude Code, etc.), after reportedly blowing their 2026 AI budget in four months. Simon calculates this as ~11% of median engineer compensation ($330k), and notes his own usage would be ~$1k/month per provider without subsidized plans.\",\n    \"author\": \"Simon Willison\",\n    \"source\": \"Blog\",\n    \"url\": \"https://simonwillison.net/2026/Jun/3/uber-caps-ai-tools/\",\n    \"published_date\": \"2026-06-03\",\n    \"topics\": [\"ai\", \"generative-ai\", \"llms\", \"llm-pricing\", \"coding-agents\", \"uber\", \"cost-management\"],\n    \"type\": \"technical\"\n  }\n]",
