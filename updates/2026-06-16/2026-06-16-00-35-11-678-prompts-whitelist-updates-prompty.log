    "content": "[\n  {\n    \"productName\": \"Gemini CLI\",\n    \"title\": \"Shutdown Announcement and Migration Guide\",\n    \"description\": \"Google announced Gemini CLI will shut down for all users on June 18, 2026, affecting CI/CD pipelines, shell scripts, and automation tools. Migration guide provided for users moving to alternatives like Antigravity CLI.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.com/google-gemini/gemini-cli/releases\",\n    \"date\": \"2026-06-18\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"I think we will need to move to workarounds based on MCP going forwards\",\n        \"source\": \"HN\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"Skills, Hooks, Subagents — all preserved. Extensions are being carried over to the replacement\",\n        \"source\": \"Dev.to\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Claude Code\",\n    \"title\": \"New Cybersecurity Features and Managed Agents Beta\",\n    \"description\": \"Two new cybersecurity features were added to Claude Code, along with public beta support for Managed Agents that can run on schedules and securely use CLI tools and authenticated services. June 15 also marked the retirement of Claude Sonnet.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://support.claude.com/en/articles/12138966-release-notes\",\n    \"date\": \"2026-06-15\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"45% of AI-generated code contains security vulnerabilities (Veracode)\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Code duplication has quadrupled (GitClear)\",\n        \"source\": \"HN\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"perform a full security audit on my entire codebase and it fixed the critical vulnerabilities in about 5 minutes\",\n        \"source\": \"Facebook Group\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"Users questioning the constant introduction of new features, suggesting to focus on improving existing products instead\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Devin\",\n    \"title\": \"Session Folders and Platform Polish\",\n    \"description\": \"June 12 update introduced Session Folders Group feature along with various bug fixes, performance improvements, and visual polish across the platform.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://docs.devin.ai/release-notes/overview\",\n    \"date\": \"2026-06-12\",\n    \"community_feedback\": []\n  },\n  {\n    \"productName\": \"Codex CLI\",\n    \"title\": \"Profile Selector and Local Search Features\",\n    \"description\": \"June updates included local conversation search, --profile becoming the primary CLI and sandbox selector, along with MCP setup improvements and tool schema enhancements. Goal mode stabilized and Sites feature expanded.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://developers.openai.com/codex/changelog\",\n    \"date\": \"2026-06-09\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"automated code reviews and syncing work between cloud and local environments will really help developers focus on building, not managing\",\n        \"source\": \"LinkedIn\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Cursor\",\n    \"title\": \"Auto-review Agent Safety System and Enhanced Bugbot\",\n    \"description\": \"Bugbot is now 3x faster, 22% cheaper, and finds 10% more bugs with average review time of ~90 seconds. New Auto-review agent safety system uses contextual classifiers to balance autonomy with security. Design Mode now supports visual prompts for directing UI changes.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://cursor.com/changelog\",\n    \"date\": \"2026-06-10\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Cut review time from about five minutes to roughly 90 seconds\",\n        \"source\": \"DigitalApplied Blog\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"78% of issues found are resolved by the time the PR is merged\",\n        \"source\": \"Cursor Release Notes\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"Windsurf\",\n    \"title\": \"Chat Experience Improvements and Credit Fixes\",\n    \"description\": \"Recent update supercharged chat experience with better models, better context, and more control over code items. Fixed issues with partial credits when transitioning to flex credits in version 1.2.6 patch update.\",\n    \"updateType\": \"feature\",\n    \"url\": \"https://windsurf.com/changelog/vscode\",\n    \"date\": \"2026-06-02\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Windsurf is the best and most reliable for editing multiple files hands down. It just seems to know the context better\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"positive\"\n      },\n      {\n        \"quote\": \"But it needs some polish\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"neutral\"\n      },\n      {\n        \"quote\": \"I use the Flow mode for 90% of my work. It's powered by a fine-tuned Claude 3.7, with high coding IQ\",\n        \"source\": \"Medium\",\n        \"sentiment\": \"positive\"\n      }\n    ]\n  },\n  {\n    \"productName\": \"GitHub Copilot\",\n    \"title\": \"GitHub Actions Minutes Integration and VS Code Updates\",\n    \"description\": \"GitHub Copilot Code Review began consuming GitHub Actions minutes starting June 1, 2026, changing from Copilot quotas to Actions minutes for private repos on Pro, Pro+, Business, and Enterprise plans. VS Code extension updated through v1.120-v1.123 with enhanced Agents functionality.\",\n    \"updateType\": \"announcement\",\n    \"url\": \"https://github.blog/changelog/2026-04-27-github-copilot-code-review-will-start-consuming-github-actions-minutes-on-june-1-2026/\",\n    \"date\": \"2026-06-01\",\n    \"community_feedback\": [\n      {\n        \"quote\": \"Some reports indicate potential cost increases of up to 800% for certain use cases\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Developers expressed significant concern about the removal of predictable flat-rate pricing\",\n        \"source\": \"Reddit\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"Teams using Actions heavily for CI/CD pipelines face additional costs when code review features are enabled\",\n        \"source\": \"GitHub Community\",\n        \"sentiment\": \"negative\"\n      },\n      {\n        \"quote\": \"one example cited $1,298.42 for what previously cost much less\",\n        \"source\": \"LinkedIn\",\n        \"sentiment\": \"negative\"\n      }\n    ]\n  }\n]\n",
