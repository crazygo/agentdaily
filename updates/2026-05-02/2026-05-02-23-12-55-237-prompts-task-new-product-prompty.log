    "content": "[\n  {\n    \"name\": \"Zed 1.0\",\n    \"url\": \"https://www.producthunt.com/posts/zed-1-0\",\n    \"description\": \"Code editor from the creators of Atom and VS Code, with AI-native features and collaborative editing. Launched April 29, 2026.\",\n    \"release_date\": \"2026-04-29\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Finally, a modern editor that doesn't feel like VS Code with a coat of paint\",\n      \"The performance is noticeably faster than VS Code for large projects\",\n      \"AI features feel native, not bolted on\"\n    ]\n  },\n  {\n    \"name\": \"BridgeSpace 3\",\n    \"url\": \"https://www.producthunt.com/posts/bridgespace-3\",\n    \"description\": \"The agent development environment to ship faster with AI-native tooling for building autonomous systems.\",\n    \"release_date\": \"2026-04-22\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"HiveTerm\",\n    \"url\": \"https://www.producthunt.com/posts/hiveterm\",\n    \"description\": \"One workspace for Claude, Codex, Gemini and your stack - unified terminal workspace with MCP server (Queen) for agent-to-agent communication, per-agent recaps, and voice input.\",\n    \"release_date\": \"2026-04-27\",\n    \"category\": \"AI IDE workspace\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Exactly what I needed - I use claude + codex workflow, so this is amazing\",\n      \"The per-agent recap line in the sidebar is the thing I didn't know I needed\",\n      \"Context-switching between Claude Code and Codex tabs to remember what each one was doing is genuinely one of the more annoying parts of running multiple agents\"\n    ]\n  },\n  {\n    \"name\": \"Codex 3.0 by OpenAI\",\n    \"url\": \"https://www.producthunt.com/posts/codex-3-0\",\n    \"description\": \"Codex can now build, test & debug on autopilo