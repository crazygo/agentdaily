    "content": "[\n  {\n    \"name\": \"Zed 1.0\",\n    \"url\": \"https://www.producthunt.com/posts/zed-1-0\",\n    \"description\": \"Code editor from the creators of Atom and VS Code, with AI-native features and collaborative editing.\",\n    \"release_date\": \"2026-04-29\",\n    \"category\": \"AI IDE\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Finally, a modern editor that doesn't feel like VS Code with a coat of paint\",\n      \"The performance is noticeably faster than VS Code for large projects\",\n      \"AI features feel native, not bolted on\"\n    ]\n  },\n  {\n    \"name\": \"HiveTerm\",\n    \"url\": \"https://www.producthunt.com/posts/hiveterm\",\n    \"description\": \"One workspace for Claude, Codex, Gemini and your stack - a unified terminal workspace integrating multiple AI coding assistants with MCP server (Queen) for agent-to-agent communication.\",\n    \"release_date\": \"2026-04-27\",\n    \"category\": \"AI IDE workspace\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Exactly what I needed - I use claude + codex workflow, so this is amazing\",\n      \"The per-agent recap line in the sidebar is the thing I didn't know I needed\",\n      \"Context-switching between Claude Code and Codex tabs to remember what each one was doing is genuinely one of the more annoying parts of running multiple agents\"\n    ]\n  },\n  {\n    \"name\": \"CodeHealth MCP Server by CodeScene\",\n    \"url\": \"https://www.producthunt.com/posts/codehealth-mcp-server\",\n    \"description\": \"Keep AI-generated code healthy and maintainable - MCP server that exposes CodeScene's Code Health analysis as local AI-friendly tools.\",\n    \"release_date\": \"2026-04-29\",\n    \"category\": \"code review agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"noirdoc\",\n    \"url\": \"https://www.producthunt.com/posts/noirdoc\",\n    \"description\": \"PII guard for Claude Code to keep client data out of context - open-source plugin that redacts PII before AI reads it.\",\n    \"release_date\": \"2026-04-29\",\n    \"category\": \"AI coding CLI\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Jet AI Agents\",\n    \"url\": \"https://www.producthunt.com/posts/jet-ai-agents\",\n    \"description\": \"Build business AI agents in minutes - no-code agent builder with 200+ integrations that lets teams create AI agents that live in Slack, WhatsApp, and Telegram.\",\n    \"release_date\": \"2026-04-27\",\n    \"category\": \"AI development platform\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"Building agents that actually live inside Slack and WhatsApp instead of yet another dashboard tab is the right call\",\n      \"The 'relying on engineering for simple internal tools' line is the story of my life\",\n      \"AI agents your team will trust - because they built them themselves\"\n    ]\n  },\n  {\n    \"name\": \"ZeroClaw\",\n    \"url\": \"https://www.producthunt.com/posts/zeroclaw\",\n    \"description\": \"Rust autonomous agent runtime. ~5MB core, lightweight, security-first framework for building fast autonomous agents.\",\n    \"release_date\": \"2026-04-26\",\n    \"category\": \"open-source agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": [\n      \"A Rust-based framework for fast, secure autonomous agents hits a sweet spot for performance and safety\"\n    ]\n  },\n  {\n    \"name\": \"ZeroHuman\",\n    \"url\": \"https://www.producthunt.com/posts/zerohuman\",\n    \"description\": \"AI workflow automation agent with OpenClaw integration for business automation - launched April 25, 2026.\",\n    \"release_date\": \"2026-04-25\",\n    \"category\": \"code agent\",\n    \"sources\": [\"Product Hunt\"],\n    \"community_quotes\": []\n  },\n  {\n    \"name\": \"Logic\",\n    \"url\": \"https://www.producthunt.com/